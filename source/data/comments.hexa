/// Stores information about a comment in source code
class Comment {
	/// The actual text content of the comment
	var text: String
	/// Line number where the comment appears
	var line: Int
	/// Column number where the comment starts
	var column: Int

	new (text, line, column) {
		this.text = text
		this.line = line
		this.column = column
	}
}
