		r += 'void FatPair_hiddenReflect_(void* self_, HexaReflectOp_* op_) ' + lb + ' if (self_ == nullptr || op_ == nullptr) return; switch (op_->code_) ' + lb + ' case (int32_t)1: op_->resultInt_ = (int32_t)Hexa_ToBoolTrue_(self_); break; case (int32_t)2: op_->resultStr_ = Hexa_GenericToString_(self_); break; case (int32_t)3: op_->resultCStr_ = FatPair_hiddenClassName_(); break; case (int32_t)4: op_->result_ = FatPair_hiddenDynGet_(self_, op_->key_); break; case (int32_t)5: FatPair_hiddenDynSet_(self_, op_->key_, op_->value_); break; case (int32_t)6: op_->resultInt_ = (int32_t)FatPair_hiddenHas_(self_, op_->key_); break; case (int32_t)7: FatPair_hiddenDelete_(self_, op_->key_); break; case (int32_t)8: op_->resultStr_ = FatPair_hiddenKeyAt_(self_, op_->index_); break; case (int32_t)9: op_->resultInt_ = (int32_t)FatPair_hiddenKeyCount_(self_); break; case (int32_t)10: op_->result_ = FatPair_hiddenIndexGet_(self_, op_->index_); break; case (int32_t)11: FatPair_hiddenIndexSet_(self_, op_->index_, op_->value_); break; case (int32_t)12: op_->resultInt_ = (int32_t)FatPair_hiddenIndexCount_(self_); break; default: break; ' + rb + rb + nl
		r += 'struct FatPair_vt ' + lb + ' struct HexaReflect_ hidden; struct FatPair__ public_; ' + rb + ';' + nl
		r += 'const struct FatPair_vt FatPair_vt$ = ' + lb + ' ' + lb + 'nullptr, &Hexa_ToBoolTrue_, &Hexa_GenericToString_, &FatPair_hiddenClassName_, &FatPair_hiddenDynGet_, &FatPair_hiddenDynSet_, &FatPair_hiddenHas_, &FatPair_hiddenDelete_, &FatPair_hiddenKeyAt_, &FatPair_hiddenKeyCount_, &FatPair_hiddenIndexGet_, &FatPair_hiddenIndexSet_, &FatPair_hiddenIndexCount_, &FatPair_hiddenReflect_' + rb + ', ' + lb + '&Hexa_QI_, &Hexa_AddRef_, &Hexa_Release_' + rb + ' ' + rb + ';' + nl
