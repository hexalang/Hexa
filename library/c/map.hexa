// `Map` is a real (non-`declare`) generic class backed by two parallel arrays;
// instantiated per `<K, V>` by the template machinery (`Map_$K_$V_` in the C
// output). Nullability stays genuine: `get` really returns `V?`.
@final // TODO optimize into non-virtual calls
@asIs
class Map<K, V> {
	private var hasNull = false
	private var nullValue = null
	// Number of live entries (approximate — kept in sync by `set`/`delete`)
	var size: Int = 0
	// TODO `@rename('key_')` causes double-renaming
	// @rename('key')
	// TODO `private` parsed as a separate expression, consuming all the decorators
	let key: [K] = new Array<K>(0) // TODO = [] [K?]
	// @rename('value')
	// TODO private
	let value: [V] = new Array<V>(0) // TODO = [] [V?]

	new(/*TODO ...values: T*/) {} // TODO fix ... in parser

	fun get(k: K): V? {
		if k == null {
			if this.hasNull {
				return this.nullValue
			}

			return null
		}

		return this.value[this.key.indexOf(k)]
	}

	fun has(k: K): Bool {
		if k == null {
			return this.hasNull
		}

		return this.key.includes(k)
	}

	fun set(k: K, v: V): Void {
		if k == null {
			if not this.hasNull {
				size = size + 1
			}
			this.hasNull = true
			this.nullValue = v
			return
		}

		let index = this.key.indexOf(k)
		if index != -1 {
			this.value[index] = v
		} else {
			this.key.push(k)
			this.value[this.key.length - 1] = v
			size = size + 1
		}
	}

	fun delete(k: K): Bool {
		if k == null {
			let had = this.hasNull
			if had { size = size - 1 }
			this.hasNull = false
			this.nullValue = null
			return had
		}

		//this.key.indexOf(null) TODO defaults not filled
		//let index = this.key.indexOf(null)
		let index = this.key.indexOf(k)
		this.value[index] = null
		this.key[index] = null
		if index != -1 { size = size - 1 }
		// TODO remove key to avoid leak & has
		return index != -1
	}

	// fun keys(): [K] {return [null]} // TODO what with [null]?
	// TODO must be iterator, not array
	// TODO [K?]
	fun keys(): [K] {
		/*if (this.hasNull) {
			if ((this.key.length == 0) || (this.key[this.key.length - 1] != null)) {
				this.key.push(null)
				return this.key
			}
		}

		if (!this.hasNull) {
			if (this.key[this.key.length - 1] == null) {
				this.key.pop()
			}
		}
		*/
		let result = this.key.filter(k => k != null)
		if this.hasNull {
			result.push(null)
		}
		return result
		// TODO
		//return this.hasNull? [...this.key.filter(k => k != null), null] : this.key.filter(k => k != null)
	}

	// Values in key order (JS `Map.values()` counterpart, may contain nulls)
	fun values(): [V] {
		return this.value
	}

	/// Do not use other than in code generator
	/// Implies that length is known from instance
	private fun from(count: Int, payloadKeys: ArrayPointer<K>, payloadValues: ArrayPointer<V>) {
		for i in count {
			set(payloadKeys[i], payloadValues[i])
		}
		return this
	}
}
