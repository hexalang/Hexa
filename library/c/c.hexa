declare fun parseInt(text: String): Int
declare fun parseFloat(text: String): Float
// ASCII decimal/hex integer scan (wraps on overflow — checked numerics later)
fun parseInt(text: String, radix: Int? = null): Int {
	var r = 10
	if let q = radix { r = q }
	// Leading JS whitespace scan
	var start = 0
	while start < text.length {
		if let c = text.charCodeAt(start) {
			if c == 32 or c == 9 or c == 10 or c == 13 { start++ } else { break }
		} else { break }
	}
	var sign = 1
	if let c = text.charCodeAt(start) {
		if c == 43 { start++ } else if c == 45 {
			sign = 0 - 1
			start++
		}
	}
	if radix == null {
		if let c0 = text.charCodeAt(start) {
			if c0 == 48 {
				if let c1 = text.charCodeAt(start + 1) {
					if c1 == 88 or c1 == 120 {
						r = 16
						start = start + 2
					}
				}
			}
		}
	}
	if r < 2 or r > 36 { return 0 }
	var value = 0
	var any = false
	var k = start
	while k < text.length {
		if let c = text.charCodeAt(k) {
			var d = 0 - 1
			if c >= 48 and c <= 57 { d = c - 48 } else if c >= 65 and c <= 90 { d = c - 55 } else if c >= 97 and c <= 122 { d = c - 87 }
			if d < 0 or d >= r { break }
			value = value * r + d
			any = true
			k++
		} else { break }
	}
	if not any { return 0 }
	return value * sign
}

fun parseFloat(text: String): Float {
	var i = 0
	while i < text.length {
		if let c = text.charCodeAt(i) {
			if c == 32 or c == 9 or c == 10 or c == 13 { i++ } else { break }
		} else { break }
	}
	var sign = 1.0
	if let c = text.charCodeAt(i) {
		if c == 43 { i++ } else if c == 45 {
			sign = 0.0 - 1.0
			i++
		}
	}
	// Infinity literal (case-insensitive prefix match)
	if text.substring(i, i + 8).toLowerCase() == 'infinity' { return sign * infinity }
	var intPart = 0.0
	var any = false
	while i < text.length {
		if let c = text.charCodeAt(i) {
			if c >= 48 and c <= 57 {
				intPart = intPart * 10.0 + (c - 48)
				any = true
				i++
			} else { break }
		} else { break }
	}
	var fracPart = 0.0
	var fracScale = 1.0
	if let c = text.charCodeAt(i) {
		if c == 46 {
			i++
			while i < text.length {
				if let d = text.charCodeAt(i) {
					if d >= 48 and d <= 57 {
						fracPart = fracPart * 10.0 + (d - 48)
						fracScale = fracScale * 10.0
						any = true
						i++
					} else { break }
				} else { break }
			}
		}
	}
	var value = intPart + fracPart / fracScale
	if let c = text.charCodeAt(i) {
		if c == 69 or c == 101 {
			i++
			var expSign = 1
			if let s = text.charCodeAt(i) {
				if s == 43 { i++ } else if s == 45 {
					expSign = 0 - 1
					i++
				}
			}
			var expVal = 0
			var expAny = false
			while i < text.length {
				if let d = text.charCodeAt(i) {
					if d >= 48 and d <= 57 {
						expVal = expVal * 10 + (d - 48)
						expAny = true
						i++
					} else { break }
				} else { break }
			}
			if expAny {
				let mag = cPow(10.0, expVal as!Float)
				if expSign > 0 { value = value * mag } else { value = value / mag }
			}
		}
	}
	if not any { return 0.0 }
	return sign * value
}

fun btoa(text: String) {
	return Buffer.from(text, 'binary').toString('base64')
}

fun atob(base64: String) {
	return Buffer.from(base64, 'base64').toString('binary')
}

