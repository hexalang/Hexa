{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Hexa Project Configuration",
	"type": "object",
	"required": [
		"name",
		"version",
		"entry"
	],
	"properties": {
		"name": {
			"type": "string",
			"description": "The unique name of the project."
		},
		"version": {
			"type": "string",
			"description": "SemVer compatible version string."
		},
		"entry": {
			"type": "string",
			"description": "The root module/file to start compilation (omit .hexa extension)."
		},
		"description": {
			"type": "string"
		},
		"author": {
			"type": "string"
		},
		"license": {
			"type": "string"
		},
		"global": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "Modules included in every build regardless of the entry graph."
		},
		"roots": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": [
				"source"
			]
		},
		"targets": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"name",
					"generator",
					"output"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"generator": {
						"enum": [
							"js",
							"c",
							"cpp",
							"lua"
						]
					},
					"output": {
						"type": "string"
					},
					"options": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"generatePackageJson": {
						"type": "boolean"
					},
					"dependsTarget": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"alias": {
									"type": "string"
								},
								"target": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		},
		"define": {
			"type": "object",
			"additionalProperties": {
				"type": "boolean"
			},
			"description": "Global preprocessor toggles."
		},
		"defineForCodeEditor": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"profile": {
						"type": "string"
					},
					"define": {
						"type": "object",
						"additionalProperties": {
							"type": "boolean"
						}
					}
				}
			}
		},
		"addLicenseNoticeToOutput": {
			"type": "boolean"
		},
		"linesPerFileLimit": {
			"type": "integer"
		},
		"randomSeed": {
			"type": "integer"
		}
	}
}
