	static fun min(a: Float, b: Float): Float
	static fun pow(v: Float, exp: Float): Float
	static fun random(): Float
	// TODO static fun randomRange(Int, Int): Int
	static fun round(v: Float): Int
	static fun sin(v: Float): Float
	static fun sqrt(v: Float): Float
	static fun tan(v: Float): Float
	@rename('E') static let e: Float
	@rename('LN2') static let ln2: Float
	@rename('LN10') static let ln10: Float
	@rename('LOG2E') static let log2e: Float
	@rename('LOG10E') static let log10e: Float
	@rename('PI') static let pi: Float
	@rename('SQRT1_2') static let sqrt1_2: Float
	@rename('SQRT2') static let sqrt2: Float
	static fun trunc(v: Float): Float
	static fun sign(v: Float): Int
	static fun cbrt(v: Float): Float
	static fun hypot(...values: Float): Float
	static fun log2(v: Float): Float
	static fun log10(v: Float): Float
	static fun log1p(v: Float): Float
	static fun expm1(v: Float): Float
	static fun cosh(v: Float): Float
	static fun sinh(v: Float): Float
	static fun tanh(v: Float): Float
	static fun acosh(v: Float): Float
	static fun asinh(v: Float): Float
