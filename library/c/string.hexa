	// TODO `@to(ConstArrayPointer<ClangWideChar>)` so allows to call without `.wide`
	// ^ fix tofitaDebugLog calls in Tofita
	@to(ConstArrayPointer<ClangWideChar>)
	fun utf16(): ConstArrayPointer<ClangWideChar> {
		return bytes as!ConstArrayPointer<ClangWideChar>
	}
	// TODO `.ref` getter?

	fun utf8copy(): Buffer {
		let maxBytes = length * 3 + 4
		let result = Buffer.alloc(maxBytes)
		var o = 0
		var i = 0

		while i < length {
			let c: Int = bytes[i]

			if c < 128 {
				result.bytes[o] = c as!UInt8
				o++
				i++
			} else if c < 2048 {
				result.bytes[o] = (192 + (c \ 64)) as!UInt8
				result.bytes[o + 1] = (128 + (c % 64)) as!UInt8
				o += 2
				i++
			} else {
				var units = 1
				var cp = c

				if c >= 55296 and c <= 56319, i + 1 < length {
					let lo: Int = bytes[i + 1]

					if lo >= 56320 and lo <= 57343 {
						cp = 65536 + (c - 55296) * 1024 + (lo - 56320)
						units = 2
					}
				}

				if units == 2 {
					result.bytes[o] = (240 + (cp \ 262144)) as!UInt8
					result.bytes[o + 1] = (128 + ((cp \ 4096) % 64)) as!UInt8
					result.bytes[o + 2] = (128 + ((cp \ 64) % 64)) as!UInt8
					result.bytes[o + 3] = (128 + (cp % 64)) as!UInt8
					o += 4
				} else {
					result.bytes[o] = (224 + (cp \ 4096)) as!UInt8
					result.bytes[o + 1] = (128 + ((cp \ 64) % 64)) as!UInt8
					result.bytes[o + 2] = (128 + (cp % 64)) as!UInt8
					o += 3
				}

				i += units
			}
		}

		result.length = o
		return result
	}

	// TODO `@weak` for other fun
	fun indexOf(@weak str: String, startIndex: Int?): Int {return 0} // TODO
	// fun toUpperCase(): String TODO typer not errors here!
	// ASCII-only case mapping (full Unicode tables land with the locale runtime)
	fun toUpperCase(): String {
		if length == 0 { return this }

		// TODO stack alloc for small string
		let buf = bufferAlloc(length)

		for i in length {
			let c: Int = bytes[i]

			if c >= 97 and c <= 122 { buf[i] = (c - 32) as!UInt16 } else { buf[i] = c as!UInt16 }
		}

		return fromUTF16Own(buf, length)
	}
	fun toLowerCase(): String {
		if length == 0 { return this }

		// TODO stack alloc for small string (for every bufferAlloc out there)
		let buf = bufferAlloc(length)

		for i in length {
			let c: Int = bytes[i]

			if c >= 65 and c <= 90 { buf[i] = (c + 32) as!UInt16 } else { buf[i] = c as!UInt16 }
		}

		return fromUTF16Own(buf, length)
	}
	fun includes(str: String): Bool { return indexOf(str) >= 0 }
	fun charAt(index: Int): String {
		if let c = charCodeAt(index) { return String.fromCharCode(c) }
		return ''
		if index < 0 or index >= length { return '' }
		return String.fromCharCode(bytes[index])
	}
	// `s[i]` sugar lowers here on native (genC has no address-of-char form —
	// `&s[i]` was struct-pointer garbage). OOB → ''.
	static fun stringAt(s: String, i: Int): String { return s.charAt(i) }
	fun indexOf(@weak str: String, startIndex: Int? = 0): Int {
		var start = 0

		if let s = startIndex { start = s }

		if str.length == 0 {
			if start > length { return length }

			if start < 0 { return 0 }
			return start
		}

		if start < 0 { start = 0 }

		let n = str.length
		let first: UInt16 = str.bytes[0]
		var i = start

		while i + n <= length {
			if bytes[i] == first {
				var j = 1

				while j < n and bytes[i + j] == str.bytes[j] { j++ }

				if j == n { return i }
			}

			i++
		}
		return -1
	}
	// Last occurrence at or before start (default = from the end, JS default)
	fun lastIndexOf(str: String, startIndex: Int = 1073741824): Int {
		if str.length == 0 { return length }

		let n = str.length

		if n > length { return -1 }
		var start = length - n

		if startIndex < start { start = startIndex }

		if start < 0 { return -1 }
		var i = start

		while i >= 0 {
			var j = 0

			while j < n and bytes[i + j] == str.bytes[j] { j++ }

			if j == n { return i }
			i--
		}
		return -1
	}
	fun split(delimiter: String): [String] {
		var parts [String] = []

		if delimiter.length == 0 {
			for i in length {
				parts.push(String.fromCharCode(bytes[i]))
			}
			return parts
		}
		var start = 0
		var idx = indexOf(delimiter, start)

		while idx >= 0 {
			parts.push(fromUTF16Slice(this, start, idx - start))
			start = idx + delimiter.length
			idx = indexOf(delimiter, start)
		}
		parts.push(fromUTF16Slice(this, start, length - start))
		return parts
	}

	fun toString(): String {
		// TODO test case for ref equality and ARC
		return this
	}

	// JS substring: clamps, swaps when start > end (default = rest of string)
	fun substring(startIndex: Int, endIndex: Int = 1073741824): String {
		var end = endIndex
		var start = startIndex

		if start < 0 { start = 0 }

		if end < 0 { end = 0 }

		if start > length { start = length }

		if end > length { end = length }

		if start > end {
			let t = start
			start = end
			end = t
		}
		let n = end - start

		if n <= 0 { return '' }
		let buf = malloc((n * 2 + 2) as!UInt64) as!ArrayPointer<UInt16>
		for k in n {
			if let c = charCodeAt(start + k) { buf[k] = c as!UInt16 } else { buf[k] = 0 }
		}
		buf[n] = 0
		let s = String.fromUTF16z(buf as!ConstArrayPointer<UInt16>)
		free(buf as!RuntimeAllocated)
		return s
		return fromUTF16Slice(this, start, n)
	}

	// TODO Int or UInt16?
	static fun fromCharCode(code: Int): String {
		var bytes: ArrayByValue<UInt16, 2> = [code as! UInt16, 0] // TODO split Int to two shorts
		return fromUTF16z(bytes.ref as! ConstArrayPointer<UInt16>)
		// TODO `.constRef` of `ArrayByValue`
		let buf = malloc(4u64) as!ArrayPointer<UInt16>
		buf[0] = code
		buf[1] = 0
		let s = fromUTF16z(buf as!ConstArrayPointer<UInt16>)
		free(buf as!RuntimeAllocated)
		if code >= 0 and code < 256 {
			// TODO explicit `String?` — an inferred `let` from an ArrayByValue
			// index types as `Any` (dynamic unbox on every hit).
			let hit: String? = charCache[code]

			if not (hit == null) { return hit ! }
		}

		var scratch: ArrayByValue<UInt16, 2> = [0]
		scratch[0] = code as!UInt16
		scratch[1] = 0
		let s = fromUTF16(scratch.address as!ConstArrayPointer<UInt16>, 0, 1)

		if code >= 0 and code < 256 { charCache[code] = s }
		return s
	}

