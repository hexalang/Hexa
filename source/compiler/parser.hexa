// TODO `<fast Bool>` use `true` by default, and fallback to `false` for stuff like `enum A : B` ie `:` nice errors
@final
class Parser {
	// Parsing result
	var nodes: [Node]
	// Lexemes input directly from lexer
	private var lex: Tokens
	// The pointer
	private var i = 0
	private var endif = 0 // Nesting level of #end's
	private var lastTokenIndex = -1
	private var lastTokenChecks = 10
	var project: Project
	// TODO seems like `lint` is no longer in use
	var lint = false
	var fast = false // TODO move into `<T>` (or use `lint`/`full` as a better name? hmmm)
	// TODO ^ also make testParser to run both kinds
	// ^ or lint after macro, not while parsing (also drops malformed `a = b = c` AST stuff)
	// TODO mark static functions as non-mutation so they are thread-safe
	static fun toNode(nodes: [Node]): Node? {
		if nodes.length == 0 {
			return null
		}

		if nodes.length > 1 {
			return Node.Block(nodes)
		}
		return nodes[0]
	}
	static fun parseNodes(lexe: Tokens, project: Project, lint: Bool = false): [Node] {
		let parser = new Parser(lexe, project, lint)
		// TODO wrap this into try{}catch and when error like `;` or `:` happens,
		// show proper error message with more context

		if parser.hints.length > 0 {
			throw new CompilerErrors(parser.hints)
		}
		return parser.nodes
	}
	private new (lexe: Tokens, project: Project, lint: Bool) {
		lex = Preprocessor.process(lexe, project)
		this.lint = lint
		this.project = project
		nodes = []
		// TODO

		while i < lex.length and tok() != Token.Eof {
			nodes.push(parseExpr())
		}
		// Check for unattached documentation comments at end of file
		let remainingComments = collectDocumentationComments()

		if remainingComments.length > 0 {
			fail("Documentation comments must be attached to an expression")
		}
	}
	fun parseFields() {
		var fields = []

		while tok() != Token.BlockClose {
			// Collect documentation comments first (higher priority than decorators)
			var docComments = collectDocumentationComments()
			var atts: Array<Decorator> = []

			while tok() == Token.At {
				// NOTE: If decorator happens before /// or in between of comments it's a syntax error
				// We require comments to go together un-interrupted because they appear in doc gen
				// The code lines in-between the /// comments will not appear in the doc!
				atts.push(parseDecorator())
			}
			// TODO refactor
			let pos = { line: lex.line[i], column: lex.column[i] }
			let pos = new NodeData(pos.line, pos.column, lex.fileName)
			var _static = false
			if tok() == Token.KStatic {
				_static = true
				i++
			}
			var _readonly = false
			if tok() == Token.KReadonly {
				_readonly = true
				i++
			}

			switch tok() {
				case KPrivate:
					// TODO as project flag
					i++
				case KVar:
					var f = parseExpr()
					project.data.set(f, pos)

					if _static {
						project.mapStatic.set(f, true)
					}

					if _readonly {
						project.mapReadonly.set(f, true)
					}
					project.mapDecorators.set(f, atts)

					if docComments.length > 0 {
						project.leadingComments.set(f, docComments)
					}
					fields.push(f)
				case KAsync | KFun:
					var f = parseExpr()
					project.data.set(f, pos)

					if _static {
						project.mapStatic.set(f, true)
					}

					if _readonly {
						project.mapReadonly.set(f, true)
					}
					project.mapDecorators.set(f, atts)

					if docComments.length > 0 {
						project.leadingComments.set(f, docComments)
					}
					fields.push(f)
				case KLet:
					var f = parseExpr()
					project.data.set(f, pos)

					if _static {
						project.mapStatic.set(f, true)
					}

					if _readonly {
						project.mapReadonly.set(f, true)
					}
					project.mapDecorators.set(f, atts)

					if docComments.length > 0 {
						project.leadingComments.set(f, docComments)
					}
					fields.push(f)
					// TODO could be that dedicated fields parsing in non-needed when `new` is only for constructors (and slow parser)
				case KNew:
					i++
					// TODO `var expr = null` infer type
					var expr: Node? = null
					var positions: [NodeData] = []
					var vars: [String] = []
					var types = []
					var values = []
					step(Token.CallOpen)

					if tok() != Token.CallClose { while true {
							positions.push(new NodeData(lex.line[i], lex.column[i], lex.fileName))
							vars.push(getgo(Token.Identifier))
							var expr = null
							var t = null
							if tok() == Token.Colon {
								i++
								// TODO colon-less
								t = parseType()
							} else {
								let token = tok()

								if
									token == Token.IndexOpen or
									token == Token.BlockOpen or
									token == Token.Title or
									token == Token.CallOpen
								{
									t = parseType()
								}
							}

							if tok() == Token.Assign {
								i++
								expr = parseExpr()
							}
							types.push(t)
							values.push(expr)

							if tok() == Token.Comma {
								i++
							} else {
								break
							}
						} }
					step(Token.CallClose)
					// TODO Decorators parsing breaks this
					var tmp = i

					while tok() == Token.At {
						parseDecorator()
					}

					if
						tok() != Token.BlockClose,
						tok() != Token.KFun
						// && tok() != KStatic
					{
						i = tmp
						expr = parseExpr()
					} else {
						i = tmp
					}
					var v = []

					for i in vars.length {
						// TODO reuse function arguments parser, to check for duplicate argument names, arrow functions etc
						let argument = Node.Var(vars[i], types[i], values[i], true, false)
						// TODO decorators
						project.data.set(argument, positions[i])
						v.push(argument)
					}

					switch expr {
						case null:
						case Block(_):
						case _:
							i--
							fail('Constructor `new` should have a `\{ block \}` as a body')
					}
					let field = Node.Function('new', expr, v, null, false, variadic: false)
					project.data.set(field, pos)
					fields.push(field)
				case Identifier: // TODO deprecated
					let name = getgo(Token.Identifier)
					// JavaScript's `get field()` to property

					if name == 'get', tok() == Token.Identifier {
						let field = getgo(Token.Identifier)
						fail('Use property `var \(field) \{ get \{ return value \} \}` instead of `get \(field)()`')
					}
					// JavaScript's `set field(value)` to property

					if name == 'set', tok() == Token.Identifier {
						let field = getgo(Token.Identifier)
						step(Token.CallOpen)
						let value = getgo(Token.Identifier)
						fail('Use property `var \(field) \{ set(\(value)) \{ ... \} \}` instead of `set \(field)(\(value))`')
					}
					// JavaScript's `method()` to `function method()`

					if tok() == Token.CallOpen {
						if name == 'constructor' {
							fail('Use `new()` syntax instead of `constructor()`')
						}

						if _static {
							fail('Use `static fun ' + name + '()` syntax for static methods')
						} else {
							fail('Use `function ' + name + '()` syntax for methods')
						}
					}
					fail('Fields should start with `var ' + name + '` or `let ' + name + '`')
				case Title:
					// TODO toCamelCase
					fail('Fields cannot start with uppercase character `' + print() + '` -> `' + print().toLowerCase() + '`')
				case BlockOpen:
					let pos = { line: lex.line[i], column: lex.column[i] }
					let field: Node? = fields.pop()
					var v = null
					var t = null
					var n = null
					var onlyGet = false
					switch field {
						case Var(name, kind, expr, const):
							if expr != null {
								fail('Property should not have a `= value`')
							}
							v = field
							t = kind
							n = name
							onlyGet = const
						case _:
							fail('Only `var` and `let` fields may have a getter `let v: T \{ get() ... \}`')
					}
					i++
					// `get` is always first

					if print() == 'set' {
						fail('Expected `get` before `set`')
					}

					if print() != 'get' {
						fail('Expected `get`')
					}
					let kind = print()
					var getterExpr = null
					if kind == 'get' {
						i++
						getterExpr = parseExpr()
					}
					let kind = print()
					var setterExpr = null
					var setterVar = null
					if kind == 'set', onlyGet {
						fail('Constants `let` may have only getter `get`')
					}

					if kind == 'set' {
						i++
						step(Token.CallOpen)
						setterVar = getgo(Token.Identifier)
						step(Token.CallClose)
						setterExpr = parseExpr()
					}

					if setterExpr == null, not onlyGet {
						fail('Variables `var` should have both getter `get` and setter `set`')
					}
					step(Token.BlockClose)
					let getter: Node? = (getterExpr == null)? null : Node.Function('get_' + n, getterExpr, [], t, false, variadic: false)
					let setter: Node? = (setterExpr == null)? null : Node.Function('set_' + n, setterExpr, [
							Node.Var(setterVar, t, null, true, false)
						], null, false, variadic: false)
					let property = Node.Property(
						field,
						getter,
						setter
					)
					project.data.set(property, new NodeData(pos.line, pos.column, lex.fileName))
					project.data.set(getter, new NodeData(pos.line, pos.column, lex.fileName))
					project.data.set(setter, new NodeData(pos.line, pos.column, lex.fileName))
					fields.push(property)

					if let getter = getter {
						fields.push(getter)
					}

					if let setter = setter {
						fields.push(setter)
					}
				case _:
					fail('Fields cannot start with `' + print() + '`')
			}
		}
		return fields
	}
	// ------------------
	// HELPERS
	// ------------------
	// Current token
	fun tok(): Token {
		#if debug

			if i > lex.length {
				console.log("Parser is out of token space!")
				console.log("This should NOT happen.")
				console.log("Please, issue a developer (with a sample code).")
				fail(lex.fileName + ": Parser internal error: out of token space")
			}
			// var t = lex.token[i]

			if lastTokenIndex != i {
				// Process.stdout.write(lex.token[i].stringify(lex.value[i]))
				lastTokenIndex = i
				lastTokenChecks = 1000
			} else {
				lastTokenChecks--

				if lastTokenChecks < 0 {
					fail("Parser internal error: same token parsed too many times: " + '`\(print())`')
				}
			}
		#end
		// // Nested #end
		// if t == Token.Sharp, lex.value[i + 1] == 'end' { if endif > 0 {
		// i++ // #
		// i++ // end
		// endif--
		// //t = lex.token[i]
		// tok()
		// } else {
		// fail("Unexpected `#end`")
		// }}
		//
		// // #if
		// if t == Token.Sharp, offset(1) == Token.KIf {
		// i++ // #
		// i++ // if
		// let defName = getgo(Token.Identifier)
		// let def = project.defines[defName]
		// if def == null {
		// //if def == null, lint == false {
		// i-- // Cause `getgo`
		// fail(
		// "`#if` looks for the `" + defName + "` parameter which is *not* defined in project file." +
		// ' Add `"define": { "\(defName)": false }` to `hexa.json` or `--define \(defName)=false` to suppress this message.')
		// }
		//
		// if def == true {
		// endif++
		// }
		//
		// //if def == false || lint == true {
		// if def == false {
		// var endifs = 1
		// while (i < lex.length) {
		// if offset(0) == Token.Sharp, offset(1) == Token.KIf {
		// i++ // #
		// i++ // if
		// endifs++
		// continue
		// }
		// if offset(0) == Token.Sharp, lex.value[i + 1] == 'end' {
		// i++ // #
		// i++ // end
		// endifs--
		// if endifs == 0 {
		// break
		// }
		// continue
		// }
		// i++
		// }
		// }
		// tok()
		// }
		return lex.token[i] as!Token
	}
	fun print(): String {
		return Token.stringify(lex.token[i] as!Token, lex.value[i])
	}
	// TODO `, reason = "Case expects : at the end like..."`
	fun expect(t) {
		if t != tok() {
			expected(Token.stringify(t))
		}
	}
	// TODO `failAt(message, i)` where `i` saved token indes
	fun fail(message: String, line: Int? = null, column: Int? = null, filename: String? = null) {
		let line = line != null ? line : lex.line[i]
		let column = column != null ? column : lex.column[i]
		let filename = filename != null ? filename : lex.fileName
		// TODO multiple non-fatal errors (like no {} in `if`)
		hints.push(new CompilerError(Fail.ParserError, message, line, column, filename))
		throw new CompilerErrors(hints)
	}
	let hints: [CompilerError] = []
	fun failHint(message: String, line: Int? = null, column: Int? = null, filename: String? = null) {
		let line = line != null ? line : lex.line[i]
		let column = column != null ? column : lex.column[i]
		let filename = filename != null ? filename : lex.fileName
		hints.push(new CompilerError(Fail.ParserError, message, line, column, filename))
	}
	fun getgo(t): String {
		expect(t)
		return lex.value[i++]
	}
	fun step(t): Void {
		expect(t)
		i++
	}
	@inline fun next(): Void {
		i++
	}
	@inline fun offset(v): Token {
		return lex.token[i + v] as!Token
	}
	// ------------
	// ERRORS
	// ------------
	fun unexpected() {
		var token = Token.stringify(lex.token[i] as!Token, lex.value[i])
		var error = 'Unexpected `\(token)`'

		if tok() == Token.Semicolon {
			error += ' semicolon. Note: Hexa has no semicolons!'
		}

		if print() == 'public' {
			error += '. Note: Hexa has no `public` keyword!'
		}
		fail(error)
	}
	fun expected(str: String) {
		var token = Token.stringify(lex.token[i] as!Token, lex.value[i])
		fail('Expected `\(str)` before `\(token)`')
	}
	// -----------------
	// EXPRESSIONS
	// -----------------
	var classExternal = false
	fun parseExpr(): Node {
		// Collect documentation comments first (higher priority than decorators)
		var docComments = collectDocumentationComments()
		var atts: Array<Decorator> = []

		while tok() == Token.At {
			// NOTE: If decorator happens before /// or in between of comments it's a syntax error
			// We require comments to go together un-interrupted because they appear in doc gen
			let decorator = parseDecorator()
			atts.push(decorator)
		}
		var node = tok()
		// -------------
		// PREFIX STEP
		// -------------
		var nodePosition = { line: lex.line[i], column: lex.column[i] }
		var result: Node? = null
		switch node {
			// readonly expr
			case KReadonly:
				i++
				var expr = parseExpr() // TODO could be just a flag+i++ instead of parseExpr recursion?
				project.mapReadonly.set(expr, true)
				result = expr
				// declare class C {}
				// declare T = V
				// declare class
				// declare let
				// declare var
				// declare fun
			case KDeclare:
				i++

				switch tok() {
					case KFun:
						result = parseFunction(false, external: true)
					case KVar | KLet:
						let parsed = parseVar(external: true)

						if parsed.length > 1 {
							// TODO result = Node.Vars(parsed)
						} else {
							result = parsed[0]
						}
					case KClass | KInterface:
						result = parseClass(external: true, alias: null, kind: tok() == Token.KInterface ? ClassKind.Interface : ClassKind.Class)
					case Title:
						let alias = parseType()
						step(Token.Assign)
						let value = parseType()
						result = Node.TypeAlias(alias, value)
					case _:
						// TODO `declare enum`
						fail('Wrong `declare` format, got `\(Token.stringify(tok()))`')
				}

				/*
			i++
			var e = null
			switch tok() {
				case KFunction | KFun:
				e = parseFunction(false)
				case Title:
					var left = parseType()
					step(Token.Assign)
					let leftNode = Node.NodeTypeValue(left)
					project.data.set(leftNode, new NodeData(nodePosition.line, nodePosition.column, lex.fileName))
					let rightNode = Node.NodeTypeValue(parseType())
					project.data.set(rightNode, new NodeData(nodePosition.line, nodePosition.column, lex.fileName))
					e = Node.Binop(leftNode, Token.Assign, rightNode)
				case _:
					e = parseExpr()
					switch e {
						case Class(t, ext, impl, fields, _): e = Node.Class(t, ext, impl, fields, true)
						case _:
					}
			}
			var name: String? = null
			switch e {
				case Binop(a, op, b):
					if op != Token.Assign fail('declare =')
					switch a {
						case NodeTypeValue(t):
							switch t {
								case NodeType.Type(n): name = n
								case NodeType.ParametricType(n, _): name = n
							}
						case Ident(n): name = n
					}
				case Class(t, _):
				switch t {
					case NodeType.Type(n): name = n
					case NodeType.ParametricType(n, _): name = n
				}
				case Var(n, t, e, _):
					if t == null fail('Variable `\(n)` in `declare` should have a type')
					if e != null fail('Variable `\(n)` in `declare` should *not* have a value')
					name = n
				case Function(n, e, _, _):
					if n == null fail('Function in `declare` should have a name')
					if e != null fail('Functions in `declare` should *not* have a body')
					name = n
				// TODO binop assign
				// Types-to-types `T = T` or idents-to-idents `name = name` should be assigned
				// TODO require type for var and func args / retT?
				case Vars(_):
					fail('Place only one variable into `declare`')
				case _:
					fail('Incorrect `declare` syntax! Use `declare let name: T` or `declare fun name(): T`')
			}
			// Having name is ok here, coz we search by name in scopes
			result = Node.TDeclare(name, e)
*/
				// switch tok() {
				// case Title:
				// var name = getgo(Title)
				// step(Assign)
				// TDeclare(name, parseExpr())
				// // case Identifier:
				// // 	var name = getgo(Identifier)
				// // 	step(Assign)
				// // 	TDeclare(name, parseExpr())
				// case KClass:
				// classExternal = true
				// var f = parseExpr()
				// classExternal = false
				// f
				// case KFunction | KFun:
				// var name = lex.value[i+1]
				// TDeclare(name, parseExpr())
				// case KVar, KLet:
				// var name = lex.value[i+1]
				// if name == null throw new CompilerError(Fail.ParserError, 'TDeclare name null')
				// //	TDeclare(name, parseExpr())
				// case _: // ParseDeclareError?
				// throw new CompilerError(Fail.ParserError, "declare expects name or type")
				// }
				// {}
			case BlockOpen:
				// TODO handle EOF
				let startsAt = i
				i++

				if tok() == Token.BlockClose { // Empty block {}
					i++
					result = Node.Block([])
				} else if tok() == Token.Identifier and offset(1) == Token.Colon { // Object { k:v }
					var names: [String] = []
					var el: [Node] = []

					while true {
						names.push(getgo(Token.Identifier))
						step(Token.Colon)
						el.push(parseExpr())

						if tok() == Token.Comma { // Object { k:v, ... }
							i++

							if tok() == Token.BlockClose { // Object { k:v, }
								// Check if the comma was the last token on its line
								let commaLine = lex.line[i - 1] // Line of the comma we just consumed
								let nextTokenLine = lex.line[i] // Line of the next token (BlockClose)

								if commaLine == nextTokenLine {
									// Comma and } are on the same line - not allowed
									fail("Unexpected `\}`, remove trailing `,` comma")
								}
								// Comma was on a different line than } - allowed, break out of loop
								break
							}
							continue
						} else {
							break
						}
					}

					if tok() != Token.BlockClose {
						fail('Expected `}` or `,` before `\(print())`')
					}
					step(Token.BlockClose)
					result = Node.Object(names, el)
				} else { // Block { expr expr expr }
					var el = []

					while tok() != Token.BlockClose {
						if tok() == Token.Eof {
							i = startsAt
							fail('The block `\{` has got unclosed to the end of the file')
						}
						el.push(parseExpr())
					}
					step(Token.BlockClose)
					result = Node.Block(el)
				}
				// if econd { eif }
				// if econd { eif } else { eelse }
			case KIf:
				i++
				// console.log('pre')
				var econd = [parseExpr()]
				// console.log('post')

				while tok() == Token.Comma {
					next()
					econd.push(parseExpr())
				}
				var eif: Node? = null
				var eifAt = i

				if tok() != Token.Colon {
					eif = parseExpr()
				}
				var eelse: Node? = null
				var eelseAt = i

				if tok() == Token.KElse {
					i++

					switch tok() {
						case KIf: eelse = parseExpr()
						case _: eelse = parseBlock()
					}
				}

				if eif != null {
					switch eif {
						case Block(_):
						case _:
							let temp = i
							i = eifAt
							failHint('`if` body must be a `\{` block `\}`')

							switch eif {
								case Call(_, args):
									// TODO at args[0] if present
									// TODO same for `[`
									failHint('Seems like you have `()` after `\{` block `\}` like `\}(`')
							}
							i = temp
					}
				}

				if eelse != null {
					switch eelse {
						case Block(_):
						case If(_): // Allow `else if`
						case _:
							let temp = i
							i = eelseAt
							failHint('`else` body must be a `\{` block `\}`')
							i = temp
					}
				}
				result = Node.If(econd, eif, eelse, false)
				// while econd[0], ...econd[n] {}
			case KWhile:
				i++
				var econd = [parseExpr()]

				while tok() == Token.Comma {
					next()
					econd.push(parseExpr())
				}
				var eAt = i
				var e = parseExpr()

				switch e {
					case Block(_):
					case _:
						let temp = i
						i = eAt
						failHint('`while` body must be a `\{` block `\}`')
						i = temp
				}
				result = Node.While(econd, e, true)
				// do {} while econd[0], ...econd[n]
			case KDo:
				i++
				var eAt = i
				var e = parseExpr()

				switch e {
					case Block(_):
					case _:
						let temp = i
						i = eAt
						failHint('`do` body must be a `\{` block `\}`')
						i = temp
				}
				step(Token.KWhile)
				var econd = [parseExpr()]

				while tok() == Token.Comma {
					next()
					econd.push(parseExpr())
				}
				result = Node.While(econd, e, false)
				// (e) just parenthesis
				// (e) =>
				// () =>
			case CallOpen:
				let startsAt = i
				next()

				if
					// () =>
					(tok() == Token.CallClose and offset(1) == Token.RightArrow) or
					// (a, ...) =>
					(tok() == Token.Identifier and offset(1) == Token.Comma) or
					// (a: ...) =>
					// TODO colon-less
					(tok() == Token.Identifier and offset(1) == Token.Colon) or
					// (a T) =>
					(tok() == Token.Identifier and offset(1) == Token.Title) or
					// (a) =>
					(tok() == Token.Identifier and offset(1) == Token.CallClose and offset(2) == Token.RightArrow)
				{
					var vars: [String] = []
					var types = []
					var values = []

					while tok() != Token.CallClose {
						vars.push(getgo(Token.Identifier))

						if tok() == Token.Colon {
							// TODO colon-less
							i++
							types.push(parseType())
						}

						if tok() == Token.Title {
							types.push(parseType())
						}

						if tok() == Token.Assign {
							i++
							values.push(parseExpr())
						}

						if tok() == Token.Comma {
							i++
						}
					}
					step(Token.CallClose)
					step(Token.RightArrow)
					var v = []

					for i in vars.length {
						v.push(Node.Var(vars[i], types[i], values[i], true, false))
					}
					result = Node.Arrow(parseExpr(), v, null)
				} else {
					// TODO move into reusable function
					if tok() == Token.Eof {
						i = startsAt
						fail('The parenthesis `(` has got unclosed to the end of the file')
					}
					var expr = parseExpr()
					// TODO add same checks for other {} () []
					// ^ something like pushUbclosed('(') < saves i somewhere,
					// and `step` uses this var if Eof

					if tok() == Token.Eof {
						i = startsAt
						fail('The parenthesis `(` has got unclosed to the end of the file')
					}
					step(Token.CallClose)
					result = Node.Parenthesis(expr)
				}
				// return e
				// return
			case KReturn:
				i++
				// Check if the next token is on the next line - if so, treat as return with no value
				let returnLine = lex.line[i - 1]
				let nextTokenLine = lex.line[i]

				if nextTokenLine != returnLine {
					result = Node.Return(null)
				} else {
					switch tok() {
						// TODO `throw` etc?
						case BlockClose: result = Node.Return(null)
						case KVar: result = Node.Return(null)
						case KLet: result = Node.Return(null)
						case KCase: result = Node.Return(null)
						case KBreak: result = Node.Return(null)
						case KContinue: result = Node.Return(null)
							// TODO infer non-returning function right in parser
							// (so it is instantly guessed to be Void)
							// seems incompatible with macro
						case KReturn: result = Node.Return(null)
						case _: result = Node.Return(parseExpr())
					}
				}
			case KThrow:
				i++
				result = Node.Throw(parseExpr())
			case KContinue:
				i++
				result = Node.Continue
			case KBreak:
				i++
				result = Node.Break
			case Underscore:
				i++
				result = Node.Underscore
			case Interval:
				i++
				// Check if this is a spread operator `...value` or just interval `...`
				// Spread is followed by an expression, interval is standalone
				// We need to peek ahead to see if there's an expression after ...
				let nextTok = tok()
				// Spread can be followed by: Identifier, Title, CallOpen, BlockOpen, IndexOpen, etc.
				// But NOT by: Comma, BlockClose, IndexClose, CallClose, Eof, Semicolon

				if
					nextTok != Token.Comma and
					nextTok != Token.BlockClose and
					nextTok != Token.IndexClose and
					nextTok != Token.CallClose and
					nextTok != Token.Eof
				{
					result = Node.Spread(parseExpr())
				} else {
					result = Node.Interval
				}
				// ++i TODO deprecate (but detect in slow-parser)
				// --i
				// !i
				// ~i
				// -i
			case Increment | Decrement | Exclamation | KNot | BitwiseNot | Subtract: // TODO `!`/`not`
				let id = lex.token[i] as!Token
				i++
				// result = Node.Unop(id, false, parseExpr())
				let value = parseExpr()
				// result = Node.Unop(id, false, value)
				// fun fix() {
				// switch value {
				// case Binop(aa, op, bb):
				// result = Node.Binop(Node.Unop(id, false, aa), op, bb)
				// fix()
				// case _: result = Node.Unop(id, false, value)
				// }
				// }
				// All unops have larger priority than binops
				fun fix(value: Node) {
					switch value {
						case Binop(aa, op, bb):
							let out = Node.Binop(fix(aa), op, bb)
							project.data.set(out, project.data.get(value))
							return out
						case _: return Node.Unop(id, false, value)
					}
				}
				// result = fix(Node.Unop(id, false, value))
				result = fix(value)
			case KType:
				i++
				var alias = parseType()

				if tok() == Token.Assign {
					// Type alias: `type A = B`
					step(Token.Assign)
					var value = parseType()
					result = Node.TypeAlias(alias, value)
				} else {
					// Type declaration: `type A B C {}`
					// Consume decorators
					let att = atts
					atts = [] // Reset before parsing the fields and other confinements
					let me = parseClass(external: false, alias, kind: ClassKind.Type)
					project.mapDecorators.set(me, att)
					result = me
				}
			case KGuard:
				i++
				var econd = [parseExpr()]

				while tok() == Token.Comma {
					i++
					econd.push(parseExpr())
				}
				step(Token.KElse)
				var otherwise = parseBlock()
				result = Node.Guard(econd, otherwise)
			case FloatingPoint:
				// TODO handle Meta
				let kind = lex.kind[i]
				let fpValue = getgo(Token.FloatingPoint).split('_').join('') // TODO replaceAll / other parsing function (or fallback to replaceAll if builtin fails)
				result = Node.Float(parseFloat(fpValue), kind)
			case Complex:
				let kind = lex.kind[i]
				// Complex numbers are represented as Float with Complex meta
				// Lexer already strips the 'i' suffix
				let complexValue = getgo(Token.Complex).split('_').join('')
				result = Node.Float(parseFloat(complexValue), kind)
			case Integer:
				let kind = lex.kind[i]
				let value = getgo(Token.Integer).split('_').join('')

				switch kind {
					// TODO rename `Default` token to `Empty`
					case Default:
						let at = i
						// TODO encode 0b flag into Meta
						let v = value.startsWith('0b') ? parseInt(value.substr(2), 2) : parseInt(value)

						if v > 2147483647 or v < -2147483647 {
							i = at - 1
							fail('Integer `\(value)` is too large for *signed* 32 bit, use `\(value)u32` or `\(value)n`')
							// TODO recommend i64/u64 depending on value size
						}
						result = Node.Int(v)
					case UInt8:
						let at = i
						let v = parseBigInt(value)

						if v >= 256n or v < 0n {
							i = at - 1
							fail('Integer `\(value)` is negative or too large for *unsigned* 8 bit, use `\(value)u16` or `\(value)n`')
							// TODO shorter way to write all those checks for all type combinations
							// TODO separate message for negative numbers
						}
						result = Node.MetaInt(v, kind)
					case UInt16:
						let at = i
						let v = parseBigInt(value)

						if v >= 65536n or v < 0n {
							i = at - 1
							fail('Integer `\(value)` is negative or too large for *unsigned* 16 bit, use `\(value)u32` or `\(value)n`')
							// TODO shorter way to write all those checks for all type combinations
							// TODO separate message for negative numbers
							// TODO correctly propose uXX with XX large enough for provided number
						}
						result = Node.MetaInt(v, kind)
					case UInt32:
						let at = i
						let v = parseBigInt(value)

						if v >= 4294967296n or v < 0n {
							i = at - 1
							fail('Integer `\(value)` is negative or too large for *unsigned* 32 bit, use `\(value)u64` or `\(value)n`')
							// TODO shorter way to write all those checks for all type combinations
							// TODO separate message for negative numbers
						}
						result = Node.MetaInt(v, kind)
					case _:
						result = Node.MetaInt(parseBigInt(value), kind)
				}
				// `T`
				// `T?`
				// `T<T>`
			case Title:
				if offset(1) == Token.Less {
					let res = parseType()
					result = Node.NodeTypeValue(res)
				} else if offset(1) == Token.Question {
					let name = getgo(Token.Title)
					i++
					result = Node.NodeTypeValue(NodeType.Optional(NodeType.Type(name, null)))
				} else {
					let name = getgo(Token.Title)
					result = Node.NodeTypeValue(NodeType.Type(name, null))
				}
				// `varName`
				// `arrow => body`
				// `genericCall<A, B>(args)`
			case Identifier:
				let pos = lex.column[i]
				let name = getgo(Token.Identifier)

				if tok() == Token.RightArrow {
					next()
					result = Node.Arrow(parseExpr(), [Node.Var(name, null, null, true, false)], null)
				} else if tok() == Token.Less, lex.line[i] == lex.line[i - 1], lex.column[i] == pos + name.length {
					i++
					let params: [NodeType] = [parseType()]
					// TODO reusable code

					while tok() == Token.Comma {
						i++
						params.push(parseType())
					}
					step(Token.Greater)
					// TODO result = Node.ParametricIdent(name, params)
					result = Node.Ident(name, params)
				} else {
					result = Node.Ident(name, null)
				}
			case Regex:
				let pattern = getgo(Token.Regex)
				// Check if next token is an identifier immediately after the closing /
				if tok() == Token.Identifier
					and lex.line[i] == lex.line[i - 1]
					and lex.column[i] == lex.column[i - 1] + pattern.length + 2
				{
					let flags = getgo(Token.Identifier)
					result = Node.RegExp(pattern, flags)
				} else {
					result = Node.RegExp(pattern, null)
				}
			case Backtick:
				result = Node.String(getgo(Token.Backtick))
			case QuotedString:
				let str = getgo(Token.QuotedString)
				// TODO Check have interpolations in string

				if hasInterpolation(str) {
					result = Node.Parenthesis(parseInterpolations(str))
				} else {
					result = Node.String(str)
				}
			case KTrue:
				i++ result = Node.Bool(true)
			case KFalse:
				i++ result = Node.Bool(false)
				// `this`
			case KThis:
				i++ result = Node.This
			case KNull:
				i++ result = Node.Null
			case KAwait:
				i++
				let value = parseExpr()
				// All unops have larger priority than binops
				fun fix(value: Node) {
					switch value {
						case Binop(aa, op, bb):
							let out = Node.Binop(fix(aa), op, bb)
							project.data.set(out, project.data.get(value))
							return out
						case _: return Node.Await(value)
					}
				}
				result = fix(value)
			case KSuper:
				i++ result = Node.Super
			case KMeta:
				i++
				step(Token.Dot)
				let name = getgo(Token.Identifier)
				var args: [Node]? = null
				var argNames: [String]? = null
				if tok() == Token.CallOpen {
					i++
					args = []
					argNames = []

					if tok() != Token.CallClose { while true {
							if tok() == Token.Identifier and offset(1) == Token.Colon {
								if let argNames = argNames {
									argNames.push(getgo(Token.Identifier))
								}
								step(Token.Colon)
							} else {
								if let argNames = argNames {
									argNames.push(null)
								}
							}

							if let args = args {
								args.push(parseExpr())
							}

							if tok() == Token.Comma {
								i++
							} else {
								break
							}
						} }
					step(Token.CallClose)
				}
				result = Node.Meta(name, args, argNames)
			case KVar:
				var parsed = parseVar()

				if parsed.length > 1 {
					// TODO old code `result = Node.Vars(parsed)`
					// ^ make just single-var parser
				} else {
					result = parsed[0]
				}
			case KLet:
				var parsed = parseVar()

				if parsed.length > 1 {
					// TODO old code `result = Node.Vars(parsed)`
				} else {
					result = parsed[0]
				}
				// `try { } catch e : T { } catch e : T { }`
				// `try { } catch e Error if cond, let x = expr, cond { }`
			case KTry:
				i++
				let exprAt = i
				let expr = parseExpr()

				switch expr {
					case Block(_):
					case _:
						let temp = i
						i = exprAt
						failHint('`try` body must be a `\{` block `\}`')
						i = temp
				}
				var t = []
				var v = []
				var catches = []

				while tok() == Token.KCatch {
					step(Token.KCatch)
					// TODO slow parser
					// if tok() == Token.CallOpen {
					// step(Token.CallOpen)
					// }
					let name = getgo(Token.Identifier)
					var dataType: NodeType? = null
					// Support both `catch e: T` (old) and `catch e T` (new) syntax
					if tok() == Token.Colon {
						// TODO colon-less
						i++
						dataType = parseType()
					} else if tok() == Token.Title {
						dataType = parseType()
					} else {
						fail('Expected type after catch variable, use `catch e: Error` or `catch e Error` syntax')
					}
					t.push(dataType)
					// Start the values array with the catch variable
					var catchValues: [Node] = [Node.Var(name, dataType, null, true, false)]
					// Parse optional `if` condition and additional `let` bindings
					// Format: catch e Error if cond, let x = expr, cond, cond { block }

					if tok() == Token.KIf {
						i++
						// Parse condition after `if`
						catchValues.push(parseExpr())
					}
					// Parse additional let bindings and conditions separated by commas

					while tok() == Token.Comma {
						i++
						// Check for `let x = expr` binding

						if tok() == Token.KLet {
							i++
							let letName = getgo(Token.Identifier)
							step(Token.Assign)
							let letExpr = parseExpr()
							catchValues.push(Node.Var(letName, null, letExpr, true, false))
						} else {
							// Regular condition expression
							catchValues.push(parseExpr())
						}
					}
					v.push(catchValues)
					let blockAt = i
					let blockExpr = parseExpr()

					switch blockExpr {
						case Block(_):
						case _:
							let temp = i
							i = blockAt
							failHint('`catch` body must be a `\{` block `\}`')
							i = temp
					}
					catches.push(blockExpr)
				}

				if catches.length == 0 {
					failHint('`try` must have at least one `catch` block')
				}
				result = Node.Try(expr, t, v, catches)
			case KImport:
				i++

				if tok() == Token.QuotedString {
					result = Node.Import([], getgo(Token.QuotedString))
					project.data.set(result, new NodeData(nodePosition.line, nodePosition.column, lex.fileName))
					return result
				}
				var el: [ImportNode] = []
				// var path: String = []

				while true {
					// TODO pos
					if tok() == Token.Identifier {
						el.push(ImportNode.Lower(getgo(Token.Identifier)))
					} else if tok() == Token.Title {
						el.push(ImportNode.Upper(getgo(Token.Title)))
					} else if tok() == Token.Multiply {
						// el.push(ImportNode.AllTheThings)
						i++
						step(Token.KAs)
						el.push(ImportNode.As(ImportNode.AllTheThings, ImportNode.Lower(getgo(Token.Identifier))))
					} else {
						fail('Incorrect `import` syntax')
					}

					if tok() == Token.KAs {
						i++

						if tok() == Token.Identifier {
							el.push(ImportNode.As(el.pop(), ImportNode.Lower(getgo(Token.Identifier))))
						} else if tok() == Token.Title {
							el.push(ImportNode.As(el.pop(), ImportNode.Upper(getgo(Token.Title))))
						} else {
							fail('Incorrect `import x as y` syntax')
						}
					}

					if tok() == Token.Comma {
						i++
					} else {
						break
					}
				}
				step(Token.KIn)
				// var offset = lex.column[i]
				// while (true) {
				// if tok() == Token.Eof {
				// break
				// }
				// let value = print()
				// path.push(value)
				// i++
				// if lex.column[i] != offset + value.length {
				// break
				// }
				// offset += value.length
				// //if tok() == Token.Identifier path.push(getgo(Token.Identifier))
				// //else if tok() == Token.Title path.push(getgo(Token.Title))
				// //else if tok() == Token.Dot { path.push('.') i++ }
				// //else if tok() == Token.Divide { path.push('/') i++ }
				// //else if tok() > 1 && tok() < 60 { path.push(print()) i++ }
				// //else break
				// }
				// if path.length == 0 {
				// fail('Path to file expected, found nothing')
				// }
				// console.log(path)
				// console.log(el)
				result = Node.Import(el, getgo(Token.QuotedString))
				// result = Node.Import(path.join(''), el)
				project.data.set(result, new NodeData(nodePosition.line, nodePosition.column, lex.fileName))
				return result
			case KEnum:
				// Consume decorators
				let att = atts
				atts = []
				i++
				var t = parseType()
				var valuesType = null
				if tok() == Token.Colon {
					i++
					// TODO colon-less
					valuesType = parseType()
				}
				var extend = null
				if tok() == Token.KExtends {
					i++
					extend = parseType()
				}
				step(Token.BlockOpen)
				var names = []

				while tok() != Token.BlockClose {
					// Collect documentation comments for enum tags
					var docComments = collectDocumentationComments()

					while tok() == Token.At {
						atts.push(parseDecorator())
					}
					// TODO implement decorators transfer
					atts = []

					switch tok() {
						case Title:
							let pos = new NodeData(lex.line[i], lex.column[i], lex.fileName)
							var tag = Node.NodeTypeValue(NodeType.Type(getgo(Token.Title), null))

							if tok() == Token.CallOpen {
								i++
								// TODO `let args [] = []` causes no error and `let args [test] = []` too
								let args: [Node] = []
								let argNames: [String] = []

								while true {
									argNames.push(getgo(Token.Identifier))
									// TODO drop

									if tok() == Token.Colon {
										i++
									}
									args.push(
										Node.NodeTypeValue(parseType())
									)

									if tok() == Token.Comma {
										i++
									} else {
										break
									}
								}
								step(Token.CallClose)
								project.data.set(tag, pos)
								tag = Node.Call(tag, args, argNames)
							} else if tok() == Token.Assign {
								i++
								project.data.set(tag, pos)
								tag = Node.Binop(tag, Token.Assign, parseExpr())
							}
							project.data.set(tag, pos)

							if docComments.length > 0 {
								project.leadingComments.set(tag, docComments)
							}
							names.push(tag)
						case _:
							let expr = parseExpr()

							if docComments.length > 0 {
								project.leadingComments.set(expr, docComments)
							}
							names.push(expr)
					}
				}
				// Check for unattached documentation comments at end of enum block
				let remainingComments = collectDocumentationComments()

				if remainingComments.length > 0 {
					fail("Documentation comments must be attached to an enum tag")
				}
				step(Token.BlockClose)
				result = Node.Enum(t, names, valuesType, extend)
				project.mapDecorators.set(result, att)
			case KClass | KInterface:
				// Consume decorators
				let att = atts
				atts = [] // Reset before parsing the fields and other confinements
				let me = parseClass(external: false, alias: null, kind: (tok() == Token.KInterface) ? ClassKind.Interface : ClassKind.Class)
				project.mapDecorators.set(me, att)
				result = me
			case KFun:
				// TODO decorators? seems no need
				result = parseFunction()
			case IndexOpen: // [a, b, c]
				i++
				var el = []
				var values = []
				var isMap = false
				if tok() != Token.IndexClose { while true {
						if tok() == Token.Colon { // [:]
							isMap = true
							next()
							break
						}
						el.push(parseExpr())

						if tok() == Token.Colon { // [k:v]
							i++
							values.push(parseExpr())
							isMap = true
						}

						if tok() == Token.Comma {
							i++
							// Trailing comma [a,] - only allow if it's the last token on the line

							if tok() == Token.IndexClose {
								// Check if the comma was the last token on its line
								let commaLine = lex.line[i - 1] // Line of the comma we just consumed
								let nextTokenLine = lex.line[i] // Line of the next token (IndexClose)

								if commaLine == nextTokenLine {
									// Comma and ] are on the same line - not allowed
									// TODO better message
									fail('Unexpected `]`, remove trailing comma `,` before `]` or add a value after `,` if required')
								}
								// Comma was on a different line than ] - allowed, break out of loop
								break
							}
						} else {
							break
						}
					} }
				step(Token.IndexClose)

				if isMap {
					result = Node.Map(el, values)
				} else {
					result = Node.Array(el)
				}
			case KNew:
				i++
				var t = parseType()
				var names: [String] = []
				var values: [Node] = []

				if tok() == Token.BlockOpen { // {}
					i++

					if tok() == Token.BlockClose { // Empty {}
						step(Token.BlockClose)
					} else if tok() == Token.Identifier and offset(1) == Token.Colon { // Object { k:v }
						while tok() != Token.BlockClose {
							names.push(getgo(Token.Identifier))
							step(Token.Colon) // TODO support same-name-copy syntax `Object { name }`
							values.push(parseExpr())

							if tok() == Token.Comma {
								i++
							}
						}
						step(Token.BlockClose)
					}
				}
				step(Token.CallOpen)
				var args = []
				var argNames: [String] = []

				if tok() != Token.CallClose { while true {
						switch tok() {
							case CallClose:
								fail("Unexpected `)`, remove trailing `,` comma")
							case Title:
								argNames.push(null)
								args.push(parseExpr())

								if tok() == Token.Colon {
									step(Token.Colon)
									parseType()
								}
							case _:
								if offset(1) == Token.Colon {
									argNames.push(getgo(Token.Identifier))
									step(Token.Colon)
								}
								else {
									argNames.push(null)
								}
								args.push(parseExpr())
						}

						if tok() == Token.Comma {
							i++
						} else {
							break
						}
					} }
				step(Token.CallClose)
				result = Node.New([], t, args, names, values, argNames)
			case KSwitch:
				i++
				// TODO multiple
				var exprs = [parseExpr()]

				while tok() == Token.Comma {
					i++
					exprs.push(parseExpr())
				}
				step(Token.BlockOpen)
				var cases = []
				var conds = []
				var guards = []
				// Collect documentation comments for case body TODO decorators
				var docComments = collectDocumentationComments()

				while tok() != Token.BlockClose {
					// `case conds:` and `case cond, cond, cond:`
					step(Token.KCase)

					if tok() == Token.Underscore {
						// `case _:`
						conds.push(Node.Underscore)
						i++
					} else {
						// `case expr:`
						// TODO handle `case cond, cond, cond:`
						conds.push(parseExpr())
					}
					// Map documentation comments to the case itself TODO make Node.Case or similar

					if docComments.length > 0 {
						project.leadingComments.set(conds[0], docComments)
						docComments = []
					}
					// `case conds if guard:`

					if tok() == Token.KIf {
						i++
						guards.push(parseExpr())
					} else {
						// No guard
						guards.push(null)
					}
					// `case ...:`
					step(Token.Colon)
					docComments = collectDocumentationComments()
					// `case ...: expr expr expr`
					var exs = []
					// TODO , instead of && ie `while a, b` new syntax here

					while tok() != Token.KCase and tok() != Token.BlockClose {
						// TODO this would be unneded if `parseExpr` would parse `case` on its own?
						let expr = parseExpr()
						let pending = collectDocumentationComments()

						if docComments.length > 0 {
							project.leadingComments.set(expr, docComments)
							// docComments = collectDocumentationComments()
						}
						docComments = pending
						exs.push(expr)
					}
					// Also assumes `0` expressions (ie `0 != 1`) thus makes a block with empty array

					if exs.length != 1 {
						// Collect them into a block
						// TODO is this really needed by the typer?
						cases.push(Node.Block(exs))
					} else {
						cases.push(exs[0])
					}
				}
				// Check for unattached documentation comments at end of switch block

				if docComments.length > 0 {
					fail("Documentation `///` comments must be attached to a `case` pattern or some statement in its body")
				}
				step(Token.BlockClose)
				result = Node.Switch(exprs, conds, guards, cases)
			case KFor:
				i++
				// TODO slow parser
				// if tok() == Token.CallOpen {
				// step(Token.CallOpen)
				// }

				if tok() == Token.KLet or tok() == Token.KVar {
					i++
					var name = getgo(Token.Identifier)
					// Approximately detect `for (let/var field of/in fields)`
					// TODO write tests for this with proper validation of err message
					// TODO quick fix support in vs hexa
					{
						if print() == 'of' or print() == 'in' {
							i++
							var values = print()
							i++

							while tok() != Token.CallClose and tok() != Token.Eof {
								if tok() == Token.Subtract or tok() == Token.Add {
									values += ' ' + print() + ' '
								} else {
									values += print()
								}
								i++
							}
							// TODO test those messages (with English local)
							fail("This loop should be replaced to `for \(name) in \(values)`")
						}
					}
					// Approximately detect `for (let i = 0; i < count; i++)`
					// TODO `++i` `const i` `var i` `auto i` `int i`
					// TODO ensure `i` name is the same at all places
					var classic = true
					if tok() == Token.Assign {
						i++
					} else {
						classic = false
					}
					var specialCase = ''

					if tok() == Token.Integer, lex.value[i] == '0' {
						i++
					} else { // TODO always consume values, and compare iwht '0'
						// `Blah.blah().blah - 1 + 1`
						// TODO cache to `tok()` + `switch`
						while
						tok() == Token.Identifier or
						tok() == Token.Title or
						tok() == Token.CallOpen or
						tok() == Token.CallClose or
						tok() == Token.Add or
						tok() == Token.Subtract or
						tok() == Token.Integer or
						tok() == Token.Multiply or
						tok() == Token.Dot
						{
							// `a-1` -> `a - 1`
							if tok() == Token.Subtract or tok() == Token.Add {
								specialCase += ' ' + print() + ' '
							} else {
								specialCase += print()
							}
							i++
						}
					}

					if tok() == Token.Semicolon {
						i++
					} else {
						classic = false
					}

					if tok() == Token.Identifier, lex.value[i] == name {
						i++
					} else {
						classic = false
					}
					var lesserOrEqual = false
					if tok() == Token.Less {
						i++
					} else if tok() == Token.LessOrEqual {
						i++
						lesserOrEqual = true
					} else {
						classic = false
					}
					var values = print()
					i++
					// `Blah.blah().blah - 1 + 1`

					while
					tok() == Token.Identifier or
					tok() == Token.Title or
					tok() == Token.CallOpen or // TODO align || in formatter
					tok() == Token.CallClose or
					tok() == Token.Add or
					tok() == Token.Subtract or
					tok() == Token.Integer or
					tok() == Token.Multiply or
					tok() == Token.Dot
					{
						// `a-1` -> `a - 1`
						if tok() == Token.Subtract or tok() == Token.Add {
							values += ' ' + print() + ' '
						} else {
							values += print()
						}
						i++
					}

					if lesserOrEqual {
						values += ' + 1'
					}

					if tok() == Token.Semicolon {
						i++
					} else {
						classic = false
					}
					// `i++`

					if tok() == Token.Identifier, lex.value[i] == name {
						i++

						if tok() == Token.Increment {
							i++
						} else {
							classic = false
						}
					} else
					// `++i`
					if tok() == Token.Increment {
						i++

						if tok() == Token.Identifier, lex.value[i] == name {
							i++
						} else {
							classic = false
						}
					} else {
						classic = false
					}

					if tok() == Token.CallClose { } else {
						classic = false
					}

					if classic, specialCase == '' {
						// `for (let i = 0; i < count; i++)` -> `for i in count`
						fail("This loop should be replaced to `for \(name) in \(values)`")
					}

					if classic {
						fail("This loop should be replaced to `for \(name) in \(specialCase) ... \(values)`")
					}
					fail("Hexa has only `for \(name) in values` syntax")
				}
				var name = getgo(Token.Identifier)
				step(Token.KIn)
				var values = parseExpr()
				// let range = if tok() == Token.Interval { TODO not works!
				var range = null
				if tok() == Token.Interval {
					i++
					range = parseExpr()
				}
				// TODO slow parser
				// if tok() == Token.CallClose {
				// step(Token.CallClose)
				// }
				var expression = parseExpr()
				result = Node.For(name, values, expression, range)
			case KStatic:
				// Consume `static` keyword and set the flag on the parsed expression
				next()
				result = parseExpr()
				project.mapStatic.set(result, true)
			case KAsync:
				next()
				var mode: Node? = null
				if tok() == Token.CallOpen {
					next()
					mode = parseExpr()
					step(Token.CallClose)
				}
				let fieldExpr = parseExpr()
				result = fieldExpr
				project.mapAsync.set(result, true)

				if mode != null {
					project.mapAsyncMode.set(result, mode)
				}
				project.data.set(result, project.data.get(fieldExpr))
			case KPrivate:
				// Consume `private` keyword and set the flag on the parsed expression
				next()
				result = parseExpr()
				project.mapPrivate.set(result, true)
			case Less:
				// JSX: <tag> or <tag />
				// Note: In prefix position, < always starts JSX (comparison needs left-hand side)
				result = parseJSXElement()
			case _: unexpected()
		}

		if result == null {
			Process.stdout.write('\n')
			fail("Expression is incomplete, current token is: " + Token.stringify(tok()))
		}
		// Save original starting position before any sub-parsing (postfix can advance i): final map uses prefix location for the whole expression
		// TODO test with complex expressions like `a.b[c](d).e ?? f` to verify positions
		project.data.set(result, new NodeData(nodePosition.line, nodePosition.column, lex.fileName)) // map element at prefix step

		if atts.length > 0 {
			project.mapDecorators.set(result, atts)
			atts = []
		}
		// Map documentation comments to the node

		if docComments.length > 0 {
			project.leadingComments.set(result, docComments)
		}
		// --------------
		// POSTFIX STEP
		// --------------
		var done = i >= lex.length

		while not done {
			project.data.set(result, new NodeData(lex.line[i], lex.column[i], lex.fileName))

			switch tok() {
				case Eof: done = true
				case IndexOpen:
					// Check if `[` is on the next line - if so, don't treat as indexing
					let resultLine = lex.line[i - 1]
					let indexOpenLine = lex.line[i]

					if indexOpenLine != resultLine {
						// The `[` is on a different line, so this is likely a new array literal
						// not an indexing operation. Stop the postfix loop to let array literal parsing handle it.
						done = true
						break
					}
					i++
					var indices = [parseExpr()]

					while tok() == Token.Comma {
						i++
						indices.push(parseExpr())
					}
					step(Token.IndexClose)
					// Check if we're trying to index with empty brackets (no indices at all)

					if indices.length == 0 {
						failHint('Cannot index with empty brackets `[]`. Provide at least one index value.')
					} else if indices.length == 1 {
						result = Node.Index(result, indices[0])
					} else if indices.length == 2 {
						result = Node.Index2D(result, indices[0], indices[1])
					} else if indices.length == 3 {
						result = Node.Index3D(result, indices[0], indices[1], indices[2])
					} else {
						failHint("Hexa supports only up to 3 dimensions in indexing like `[x, y, z]`")
					}
				case KIs:
					i++

					switch tok() {
						case Title:
							result = Node.Is(result, parseType())
						case _:
							fail("Cannot parse type `" + Token.stringify(tok()) + "`")
					}
				case KAs:
					i++
					var kind = tok()

					if tok() == Token.Exclamation {
						i++
					} else if tok() == Token.Question {
						i++
					} else {
						kind = Token.Default
					}
					result = Node.As(result, kind, parseType())
				case CallOpen: { // `call(a, name: b, c)`
						// Check if `(` is on the next line - if so, don't treat as call
						let resultLine = lex.line[i - 1]
						let callOpenLine = lex.line[i]

						if callOpenLine != resultLine {
							// The `(` is on a different line, so this is likely a new parenthesized expression
							// not a call operation. Stop the postfix loop to let it be parsed separately.
							done = true
							break
						}
						var args: [Node] = []
						var argNames: [String] = []
						i++

						if tok() != Token.CallClose { while true {
								switch tok() {
									case CallClose:
										// Check if the comma was the last token on its line
										let commaLine = lex.line[i - 1]
										let nextTokenLine = lex.line[i]

										if commaLine == nextTokenLine {
											fail("Unexpected `)`, remove trailing `,` comma")
										}
										break
									case Title:
										argNames.push(null)
										args.push(parseExpr())

										if tok() == Token.Colon {
											step(Token.Colon)
											parseType()
										}
									case _:
										if tok() == Token.Identifier, offset(1) == Token.Colon {
											argNames.push(getgo(Token.Identifier))
											step(Token.Colon)
										} else {
											argNames.push(null)
										}
										args.push(parseExpr())
								}

								if tok() == Token.Comma {
									i++
								} else {
									break
								}
							} }
						step(Token.CallClose)
						result = Node.Call(result, args, argNames)
					}
				case RightArrow:
					next()
					result = Node.Arrow(parseExpr(), [result], null)

				case CascadeBlock: // .{
					i++
					var names: [String] = []
					var el: [Node] = []

					while tok() != Token.BlockClose {
						let fieldName = getgo(Token.Identifier)
						names.push(fieldName)

						if tok() == Token.Colon {
							i++
							el.push(parseExpr())
						} else {
							// Shorthand syntax: { fieldName } means { fieldName: fieldName }
							el.push(Node.Ident(fieldName, null))
						}

						if tok() == Token.Comma {
							i++

							if tok() == Token.BlockClose {
								// Check if the comma was the last token on its line
								let commaLine = lex.line[i - 1]
								let nextTokenLine = lex.line[i]

								if commaLine == nextTokenLine {
									fail("Unexpected `\}`, remove trailing `,` comma")
								}
								break
							}
						} else {
							break
						}
					}
					step(Token.BlockClose)
					result = Node.Cascade(result, names, [], el)

				case CascadeArray: // .[
					i++
					var keys: [Node] = []
					var el: [Node] = []

					while tok() != Token.IndexClose {
						keys.push(parseExpr())
						step(Token.Colon)
						el.push(parseExpr())

						if tok() == Token.Comma {
							i++

							if tok() == Token.IndexClose {
								// Check if the comma was the last token on its line
								let commaLine = lex.line[i - 1]
								let nextTokenLine = lex.line[i]

								if commaLine == nextTokenLine {
									fail("Unexpected `]`, remove trailing `,` comma")
								}
								break
							}
						} else {
							break
						}
					}
					step(Token.IndexClose)
					result = Node.Cascade(result, [], keys, el)

				case Exclamation:
					i++
					result = Node.Unop(Token.Exclamation, true, result)

					// i++
				case Increment:
					switch result {
						case Unop(_): return result
					}
					i++
					result = Node.Unop(Token.Increment, true, result)

					// i--
				case Decrement:
					switch result {
						case Unop(_): return result
					}
					i++
					result = Node.Unop(Token.Decrement, true, result)

					// a.b
					// a.B
				case Dot:
					i++

					switch tok() {
						case KMeta:
							i++
							step(Token.Dot)
							let name = getgo(Token.Identifier)
							var args: [Node]? = null
							var argNames: [String]? = null
							if tok() == Token.CallOpen {
								i++
								args = []
								argNames = []

								if tok() != Token.CallClose { while true {
										if tok() == Token.Identifier and offset(1) == Token.Colon {
											if let argNames = argNames {
												argNames.push(getgo(Token.Identifier))
											}
											step(Token.Colon)
										} else {
											if let argNames = argNames {
												argNames.push(null)
											}
										}

										if let args = args {
											args.push(parseExpr())
										}

										if tok() == Token.Comma {
											i++
										} else {
											break
										}
									} }
								step(Token.CallClose)
							}
							result = Node.DotMeta(result, name, args, argNames)
						case Title:
							result = Node.DotUpper(result, getgo(Token.Title))
						case KAwait:
							i++
							result = Node.Await(result)
						case KAs:
							i++
							// Check if this is expr.as(Type, expr) syntax
							if tok() == Token.CallOpen {
								i++
								let toType = parseType()
								var castKind: Node? = null
								if tok() == Token.Comma {
									i++
									castKind = parseExpr()
								}
								step(Token.CallClose)
								result = Node.Cast(result, toType, castKind)
							} else {
								fail('Expected `(` after `.as` for cast syntax')
							}
						case _:
							result = Node.Dot(result, getgo(Token.Identifier))
					}

					// a ? b : c
					// a ?? b
					// a ?. b
				case Question:
					i++
					// TODO Probably keep just Token.OptionalChain? or only this?
					// This way it allows to parse `a? .xx()? .yy()` on separate lines
					if tok() == Token.Dot {
						// a ?. b
						var name = getgo(Token.Identifier)
						// TODO Node.Chain()
						result = Node.Dot(result, name)
					} else if tok() == Token.Question {
						// a ?? b
						i++
						result = Node.Elvis(result, parseExpr())
					} else {
						// a ? b : c
						var eif = parseExpr()
						step(Token.Colon)
						var eelse = parseExpr()
						result = Node.If([result], eif, eelse, true)
					}
					// a ?. b
				case OptionalChain:
					i++
					// TODO
					result = parseExpr()
					// a += b
				case _:
					let failAt = i
					let t = tok()

					if isBinop(t) and offset(1) == Token.Assign {
						var op = tok()
						i++
						i++
						var b = parseExpr()

						switch result {
							case Ident(_): // Ok
							case Dot(_): // Ok
							case Index(_): // Ok
							case _:
								let temp = i
								i = failAt
								failHint('Cannot reassign `=` expression `\(Node.stringify(result))`')
								i = temp
						}

						result = Node.AssignOp(result, op, b)
					}
					// a + b
					else if isBinop(t) {
						// If `<` on a new line then parse as JSX
						if t == Token.Less, lex.line[i] != lex.line[i - 1] {
							done = true
							break
						}
						i++
						// if tok() == Assign { // +=
						// i++
						// }
						var b = parseExpr()
						var a = result

						switch b {
							case Binop(aa, op, bb):
								var tp = precedence(t)
								var tLeft = tp > 99
								tp = tp % 100
								var bp = precedence(op)
								var bLeft = bp > 99
								bp = bp % 100

								if bp > tp {
									let eb = Node.Binop(result, t, aa)
									// project.data.set(eb, project.data.get(result) ?? project.data.get(b) ?? project.data.get(aa))
									project.data.set(eb, project.data.get(result) ?? project.data.get(b) ?? project.data.get(aa))
									// project.data.set(eb, new NodeData(nodePosition.line, nodePosition.column, lex.fileName))
									result = Node.Binop(eb, op, bb)
									// project.data.set(result, project.data.get(b))
								} else {
									result = Node.Binop(result, t, b)
									// project.data.set(result, project.data.get(b))
								}
								// Ternary operator has the lowest precedence
							case If(econd, eif, eelse, ternary):
								if ternary == true and t != Token.Assign {
									result = Node.If([Node.Binop(result, t, econd[0])], eif, eelse, true)
								} else {
									result = Node.Binop(result, t, b)
									// project.data.set(result, project.data.get(b))
								}
							case _:
								result = Node.Binop(result, t, b)
								// project.data.set(result, project.data.get(b))
						}
					} else {
						done = true
					}
			}
		}

		if result == null {
			Process.stdout.write('\n')
			fail("Expression postfix is incomplete")
		}

		if atts.length > 0 {
			project.mapDecorators.set(result, atts)
			atts = []
		}

		project.data.set(result, new NodeData(nodePosition.line, nodePosition.column, lex.fileName))
		return result
	}

	fun parseBlock(): Node {
		// TODO handle EOF
		// TODO i++ leftover
		step(Token.BlockOpen)

		if tok() == Token.BlockClose { // Empty block {}
			i++
			return Node.Block([])
		} else if tok() == Token.Identifier and offset(1) == Token.Colon { // Object { k:v }
			var names: [String] = []
			var el: [Node] = []

			while true {
				names.push(getgo(Token.Identifier))
				step(Token.Colon)

				el.push(parseExpr())

				if tok() == Token.Comma { // Object { k:v, ... }
					i++

					if tok() == Token.BlockClose { // Object { k:v, }
						fail("Unexpected `\}`, remove trailing `,` comma")
					}
					continue
				} else {
					break
				}
			}

			if tok() != Token.BlockClose {
				fail('Expected `\}` or `,` before `\(print())`')
			}
			step(Token.BlockClose)
			return Node.Object(names, el)
		} else { // Block { expr expr expr }
			var el = []

			while tok() != Token.BlockClose {
				el.push(parseExpr())
			}
			// Check for unattached documentation comments at end of block
			let remainingComments = collectDocumentationComments()

			if remainingComments.length > 0 {
				fail("Documentation comments must be attached to an expression")
			}
			step(Token.BlockClose)
			return Node.Block(el)
		}

		return Node.Block([]) // TODO just throw
	}

	fun parseVar(external: Bool = false): [Node] {
		var const = tok() == Token.KLet
		i++
		var vars: [Node] = []

		/// Disallows `var $name`
		if tok() == Token.Query {
			i++
			let name = if tok() == Token.Identifier {
				print()
			} else {
				'name'
			}
			let prefix = const? 'let' : 'var'
			fail("Hexa doesn't support PHP-style variables, replace it to `\(prefix) \(name)`")
		}

		fun parseSingleVar(): Node {
			// TODO proper error if Title `var cannot start with upper case letter`
			// ^ same for fun args
			let varName = getgo(Token.Identifier)
			// TODO document this and actually use, beginning underscores too?
			if varName.endsWith("___") {
				fail("Variables can't end with `___`, it is reserved.")
			}

			// TODO disallow `expr if` cause it looks python-ysh and confusing as heck
			// ^ `var type = null if tok() == Token.Colon { i++ type = parseType() }`
			var dataType = null

			if tok() == Token.Colon {
				// TODO helpful hint for Token.Colon that it should be dropped (soft parsing error)
				i++
			}

			let token = tok()

			// TODO drop support for type-level decorators
			// if token == Token.At {
			// // TODO soft parsing error
			// i++
			// let name = print() // TODO `getgo(Token.Identifier)`
			// // TODO `failHintAt` but consume decorator first with `parserDec` cause may have parameters
			// i--
			// // TODO should know if it `var`, `let` or function argument
			// fail("Decorators should be placed at variable's declaration like `@\(name) var \(varName)` instead of their type.")
			// // TODO it may happen that decorator is applied to next var if current is type-less
			// // ^ recommend `///` to split expressions
			// }

			// TODO reuse in inline function `fun isStartOfType(token)`
			// ^ to be used in [[parseFunction]]
			if
				// token == Token.Colon or // `: T`
				(
					token == Token.At and (
						// `var name <single space here> @decorator Type`
						// TODO add `lastToken*`
						// TODO proper error for `+ 0` when no space
						lex.column[i] == lex.value[i - 1].length + lex.column[i - 1] + 1
					)
				) or
				token == Token.IndexOpen or // `[T]` TODO rename `B?Open` to `ArrayOpen`
				// TODO rename `B?Open` to `BlockOpen` `BodyOpen` `GroupOpen`
				token == Token.KType or
				token == Token.KInterface or
				token == Token.Title or // `T` TODO rename `Title` to `TitleCase`, `Identifier` to `CamelCase`
				token == Token.CallOpen // `()=>T` TODO rename `CallOpen` to `CallOpen`
			{
				// TODO i++ leftover
				dataType = parseType()
			}

			var expr = null

			if tok() == Token.Assign {
				i++
				expr = parseExpr()
			}

			return Node.Var(varName, dataType, expr, const, external ?? false)
		}

		fun parseSingleBinding(): Node {
			var path = []
			// Path let path.path.path.
			while tok() == Token.Identifier and offset(1) == Token.Dot {
				path.push(getgo(Token.Identifier))
				i++
			}
			// Enum type
			path.push(getgo(Token.Title))
			step(Token.Dot)
			// Enum exact tag
			path.push(getgo(Token.Title))

			// Enum bind vars or none
			if tok() == Token.CallOpen and offset(1) == Token.CallClose {
				fail("Don't use empty parenthesis for `let " + path.join('.') + '()` bindings')
			}
			var bind = [] // Variables T(var, var, var)
			if tok() == Token.CallOpen {
				do {
					i++

					if tok() == Token.Underscore { i++ bind.push(null) }
					else {
						bind.push(Node.Var(getgo(Token.Identifier), null, null, const, false))
					}
				} while tok() == Token.Comma
				step(Token.CallClose)
			}

			step(Token.Assign)

			var expr = parseExpr()
			return Node.EnumExtract(path, bind, expr)
		}

		// TODO deprecated
		// while (true) {
		//
		// if tok() == Token.Title || (tok() == Token.Identifier && offset(1) == Token.Dot) {
		// vars.push(parseSingleBinding())
		// } else {
		vars.push(parseSingleVar())
		// }
		//
		// // Multiple variables var a, b, c
		// if tok() == Token.Comma && offset(1) == Token.Identifier && (offset(2) == Token.Assign || offset(2) == Token.Colon) {
		// i++
		// } else {
		// break
		// }
		// }

		return vars

		// TODO this code is not used
		var const = tok() == Token.KLet
		i++
		var vars: [Node] = []

		switch tok() {
			// var a
			case Identifier:
				// TODO Refactor
				while true {

					var varname = getgo(Token.Identifier)

					if varname.endsWith("___") {
						// TODO still applies?
						fail("Variables can't end with `___`, it is reserved.")
					}

					// TODO disallow `expr if/for/etc` because its confusing for Python programmers
					// `var kind = null if ...`
					var kind = null
					if tok() == Token.Colon {
						i++
						kind = parseType()

					}
					var expr = null
					if tok() == Token.Assign {
						i++
						expr = parseExpr()
					}

					vars.push(Node.Var(varname, kind, expr, const, external))

					if tok() == Token.Comma and offset(1) == Token.Identifier and (offset(2) == Token.Assign or offset(2) == Token.Colon) {
						i++
					} else {
						break
					}
				}
				// var Left
			case Title:
				// if offset(1) != Dot {
				// fail("Please use lowercase for variable")
				// }
				// // var Left.B
				// else {
				var left = Node.Ident(getgo(Token.Title), null)
				var res = left
				// var Left.B.C.D...
				while tok() == Token.Dot {
					res = Node.Dot(res, getgo(Token.Title))
				}

				switch tok() {
					case CallOpen:
						var args: [String] = []

						while tok() != Token.CallClose {
							args.push(getgo(Token.Identifier))
						}
						step(Token.Assign)
						var varname = getgo(Token.Identifier)
						// vars.push(EnumExtract(res, args, varname))
					case Assign:
						// warning Extracting empty enum
					case _:
						fail("Wrong syntax")
				}
				// }
			case _:
				fail("Wrong syntax")
		}
		return vars
	}

	/// Parse JSX element: <TagName attr="value">children</TagName> or <TagName />
	fun parseJSXElement(): Node {
		// Save position at the opening `<`
		var jsxLine = lex.line[i]
		var jsxColumn = lex.column[i]

		// Current token is `<`
		step(Token.Less)

		// Parse tag name (Title or Identifier)
		var tag = ""

		switch tok() {
			case Title:
				tag = getgo(Token.Title)
			case Identifier:
				tag = getgo(Token.Identifier)
			case _:
				fail("Expected JSX tag name, got " + Token.stringify(tok()))
		}

		// Parse attributes
		var attrs: [Node] = []

		while tok() != Token.Greater and tok() != Token.Divide {
			// Attribute name
			var attrLine = lex.line[i]
			var attrColumn = lex.column[i]
			var attrName = ""

			switch tok() {
				case Identifier:
					attrName = getgo(Token.Identifier)
				case Title:
					attrName = getgo(Token.Title)
				case _:
					fail("Expected JSX attribute name, got " + Token.stringify(tok()))
			}

			// Check for attribute value
			if tok() == Token.Assign {
				i++
				var value: Node? = null
				if tok() == Token.QuotedString {
					var strLine = lex.line[i]
					var strColumn = lex.column[i]
					value = Node.String(getgo(Token.QuotedString))
					project.data.set(value, new NodeData(strLine, strColumn, lex.fileName))
				} else if tok() == Token.BlockOpen {
					// {expr} - parse as expression or block
					value = parseJSXExpr()
				} else {
					fail("Expected attribute value (string or \{expr\}), got " + Token.stringify(tok()))
				}
				var attrNode = Node.Binop(Node.Ident(attrName, null), Token.Assign, value)
				project.data.set(attrNode, new NodeData(attrLine, attrColumn, lex.fileName))
				attrs.push(attrNode)
			} else {
				// Boolean attribute (no value)
				var attrNode = Node.Ident(attrName, null)
				project.data.set(attrNode, new NodeData(attrLine, attrColumn, lex.fileName))
				attrs.push(attrNode)
			}
		}

		// Check for self-closing <tag />
		if tok() == Token.Divide {
			i++
			step(Token.Greater)
			var result = Node.JSXElement(tag, attrs, [])
			project.data.set(result, new NodeData(jsxLine, jsxColumn, lex.fileName))
			return result
		}

		// Consume >
		step(Token.Greater)

		// Parse children until closing tag </tag>
		var children: [Node] = []

		while tok() == Token.Less and offset(1) == Token.Divide {
			// Closing tag
			break
		}

		while true {
			// Check for EOF first (unclosed element)
			if tok() == Token.Eof {
				fail("Unclosed JSX element `<" + tag + ">` - reached end of file")
			}

			// Check for closing tag: </tag>
			if tok() == Token.Less and offset(1) == Token.Divide {
				step(Token.Less)
				step(Token.Divide)

				// Parse closing tag name
				var closeTag = ""

				switch tok() {
					case Title:
						closeTag = getgo(Token.Title)
					case Identifier:
						closeTag = getgo(Token.Identifier)
					case _:
						fail("Expected closing tag name, got " + Token.stringify(tok()))
				}

				if closeTag != tag {
					fail("Closing tag `</" + closeTag + ">` does not match opening tag `<" + tag + ">`")
				}
				step(Token.Greater)
				break
			}

			// Parse child content
			if tok() == Token.Less {
				// Nested JSX element - parseJSXElement sets its own position
				children.push(parseJSXElement())
			} else if tok() == Token.BlockOpen {
				// {expr} block - parseJSXExpr sets position for Block, inner expressions set their own
				children.push(parseJSXExpr())
			} else if tok() == Token.QuotedString {
				// Text content as String node
				var strLine = lex.line[i]
				var strColumn = lex.column[i]
				var strNode = Node.String(getgo(Token.QuotedString))
				project.data.set(strNode, new NodeData(strLine, strColumn, lex.fileName))
				children.push(strNode)
			} else {
				// Text content: accumulate any consecutive tokens that aren't JSX control tokens
				// Stop tokens: < (nested element/closing tag), { (expression), EOF (unclosed)
				var idLine = lex.line[i]
				var idColumn = lex.column[i]
				var text = ""

				while tok() != Token.Less and tok() != Token.BlockOpen and tok() != Token.Eof {
					if tok() == Token.Identifier or tok() == Token.Title {
						text += getgo(tok())
					} else {
						// Any other token: stringify it (punctuation, operators, etc.)
						text += Token.stringify(tok())
						i++
					}
				}
				var textNode = Node.String(text)
				project.data.set(textNode, new NodeData(idLine, idColumn, lex.fileName))
				children.push(textNode)
			}
		}

		var result = Node.JSXElement(tag, attrs, children)
		project.data.set(result, new NodeData(jsxLine, jsxColumn, lex.fileName))
		return result
	}

	/// Parse JSX expression block: { singleExpr } or { expr1 expr2 lastExpr }
	/// Returns the expression directly (single) or as Block (multiple)
	fun parseJSXExpr(): Node {
		// Save position at opening `{`
		var blockLine = lex.line[i]
		var blockColumn = lex.column[i]

		step(Token.BlockOpen)

		// Empty block {}
		if tok() == Token.BlockClose {
			i++
			var emptyBlock = Node.Block([])
			project.data.set(emptyBlock, new NodeData(blockLine, blockColumn, lex.fileName))
			return emptyBlock
		}

		var exprs: [Node] = []

		while tok() != Token.BlockClose {
			if tok() == Token.Eof {
				fail("Unclosed JSX expression block `\{` - reached end of file")
			}
			exprs.push(parseExpr())
		}
		step(Token.BlockClose)

		// Single expression: return as-is (position already set by parseExpr)
		if exprs.length == 1 {
			return exprs[0]
		}

		// Multiple expressions: wrap in Block (last expression is the result)
		var block = Node.Block(exprs)
		project.data.set(block, new NodeData(blockLine, blockColumn, lex.fileName))
		return block
	}

	fun parseFunction(parseBody: Bool = true, external: Bool = false): Node {
		let parseBody = (parseBody != null) ? parseBody : true
		i++
		var expr: Node? = null
		var name: String? = null
		var vars: [String] = []
		var atts: [[Decorator]] = []
		var argComments: [[Comment]] = []
		var types = []
		var values = []
		var pos: [{ line: Int, column: Int }] = []
		let params: [NodeType] = null // TODO must error
		var params: [NodeType]? = null
		switch tok() {
			case Identifier:
				name = getgo(Token.Identifier)

				if tok() == Token.Less {
					i++
					let param: [NodeType] = [parseType()]

					while tok() == Token.Comma {
						i++
						param.push(parseType())
					}
					step(Token.Greater)
					params = param
				}
			case Title:
				fail("Function names can't start with uppercase `\(print())` -> `\(Hint.toCamelCase(print()))`")
			case _:
		}

		if name == null, external {
			fail('Unnamed functions cannot be marked as `declare fun`')
		}

		var variadic = false
		step(Token.CallOpen)
		{
			if tok() != Token.CallClose {
				// TODO indent properly
				while true {
					let docComments = collectDocumentationComments()
					let decorators: [Decorator] = []

					while tok() == Token.At {
						decorators.push(parseDecorator())
					}

					var expr = null
					var t = null
					if tok() == Token.Interval {
						variadic = true
						i++
					}
					pos.push({ line: lex.line[i], column: lex.column[i] })
					let name = getgo(Token.Identifier)

					if tok() == Token.Colon {
						// TODO no colon
						i++
						// TODO decorator before argument name like at [[parseVar.parseSingleVar]]
						// TODO ^ vs hexa [[navigation]] on ctrl-click and hover over comment
						// ^ make it fuzzy so no need for full [[path.path.path]]
						// ^ RMB or DnD from Outline to code to make link
						// t = parseType() // Leftover
					}

					// TODO well `tok()` could be just `@inline let token { get }` or something
					// if tok() == Token.At { TODO rethink this limitation
					// i++
					// let decName = print() // TODO `getgo(Token.Identifier)` + `failHintAt`
					// i--
					// fail("Decorators should be placed at argument's declaration like `@\(decName) \(name)` instead of their type.")
					// }
					let token = tok()

					if
						// NOTE don't do it like that! Some type syntax uses lowercases
						// tok() != Token.Assign and
						// tok() != Token.CallClose and
						// tok() != Token.Comma
						token == Token.At or
						token == Token.IndexOpen or
						token == Token.BlockOpen or
						token == Token.Title or
						token == Token.CallOpen
					{
						t = parseType()
					}

					if tok() == Token.Assign {
						i++
						expr = parseExpr()
					}
					vars.push(name)
					atts.push(decorators)
					argComments.push(docComments)
					types.push(t)
					values.push(expr)

					if tok() == Token.Comma {
						i++

						if variadic {
							fail('Variadic `...\(name)` argument must be the last argument')
						}
					} else {
						break
					}
				} }
			step(Token.CallClose)
		}
		// TODO `retType`
		var rettype = null
		if tok() == Token.Colon {
			// TODO colon-less
			i++
			rettype = parseType()
		} else {
			let token = tok()

			if
				token == Token.IndexOpen or
				// TODO `{` conflicts with no-retType `token == Token.BlockOpen or`
				token == Token.Title or
				token == Token.CallOpen
			{
				rettype = parseType()
			}
		}

		if parseBody { switch tok() {
				case KNew: if offset(1) == Token.CallOpen { } else {
						expr = parseExpr()
					}
				case BlockClose: { }
				case KStatic: { }
				case KPrivate: { }
				case KFun: { }
				case KVar: { }
				case KLet: { }
				case At: {
						var tmp = i

						while tok() == Token.At {
							parseDecorator()
						}

						if
							tok() != Token.BlockClose
							and tok() != Token.KStatic
							and tok() != Token.KPrivate
							and tok() != Token.KFun
						{
							i = tmp
							expr = parseExpr()
						} else {
							i = tmp
						}
					}
				case Eof:
					// TODO top-level (non-external) functions cannot be unnamed
					if let name = name {
						fail('Function `fun \(name)` should have a `\{ block }` as a body or must be marked as `declare fun \(name)`')
					} else {
						fail('Unnamed functions should have a `\{ block }` as a body')
					}
				case _: expr = parseBlock()
			} }

		var v = []

		for i in vars.length {
			let n = Node.Var(vars[i], types[i], values[i], true, false)
			project.data.set(n, new NodeData(pos[i].line, pos[i].column, lex.fileName))

			if let decorators = atts[i] {
				project.mapDecorators.set(n, decorators)
			}

			if argComments[i].length > 0 {
				project.leadingComments.set(n, argComments[i])
			}

			v.push(n)
		}

		switch expr {
			case null:
			case Block(_):
			case _:
				let named = name ?? 'fun'
				// TODO proper error position
				i--
				fail('Function `\(named)` should have a `{ block }` as a body')
		}
		let result = Node.Function(name, expr, v, rettype, external /*, TODO params*/, variadic: variadic)
		if let params = params {
			project.mapFuncParams.set(result, params)
		}
		return result
	}

	// TODO JS/other code gen problem `\` escaping
	fun backtickOr(prefix: String, value: String?, placeholder: String): String {
		if let value = value {
			// TOOD fix `\` gen return prefix + `\` + value + `\`
			return prefix + '`' + value + '`'
		}

		return placeholder
	}

	fun parseClass(external: Bool = false, alias NodeType? = null, kind ClassKind = ClassKind.Class): Node {
		let _classExternal = classExternal
		classExternal = external
		var isInterface = kind

		if alias == null { i++ } // Only consume keyword if we haven't already
		var t = alias ?? parseType()

		switch t {
			case Type(_): // Ok
			case ParametricType(_, _): // Ok
			case Ident(name):
				if name.startsWith('_') {
					switch isInterface {
						case Class:
							fail('Class name cannot start with `_` underscore')
						case Interface:
							fail('Interface name cannot start with `_` underscore')
						case Type:
							fail('Type name cannot start with `_` underscore')
					}
				}

				switch isInterface {
					case Class:
						fail('Class name cannot start with lowercase and should be formatted as `class \(Hint.toTitleCase(name))`')
					case Interface:
						fail('Interface name cannot start with lowercase and should be formatted as `interface \(Hint.toTitleCase(name))`')
					case Type:
						fail('Type name cannot start with lowercase and should be formatted as `type \(Hint.toTitleCase(name))`')
				}
			case _:
				switch isInterface {
					case Class:
						fail('Class name should be formatted as `class TitleCase`')
					case Interface:
						fail('Interface name should be formatted as `interface TitleCase`')
					case Type:
						fail('Type name should be formatted as `type TitleCase`')
				}
		}

		var ext: NodeType? = null
		if tok() == Token.KExtends {
			i++
			ext = parseType()
		} else if tok() == Token.KReadonly {
			// `class Point readonly Base {}` syntax - readonly base class
			i++
			let baseType = parseType()
			// Mark the type as readonly
			project.typeReadonly.set(baseType, true)
			ext = baseType
		}

		var impl = []

		/*while tok() == Token.KImplements { TODO
			i++
			impl.push(parseType())
		}*/
		// Parse inherited types (like `Add Copy`) and add them to implements list for all class kinds
		while tok() == Token.Title {
			let extendedType = parseType()
			impl.push(extendedType)
		}

		step(Token.BlockOpen)
		var fields = parseFields()
		step(Token.BlockClose)
		var me = Node.Class(t, ext, impl, fields, external ?? false, isInterface)
		classExternal = _classExternal
		return me
	}

	fun hasInterpolation(str: String): Bool {
		var chars = str.split("")
		var i = 0

		while i < chars.length {
			if chars[i] == "\\" {
				if i + 1 < chars.length {
					if chars[i + 1] == "\\" {
						i++
					} else if chars[i + 1] == "(" {
						return true
					}
				}
			}
			i++
		}
		return false
	}

	fun parseInterpolations(str: String): Node {
		fun interpolate(s: String): String {
			var out = ['"']

			if s.length < 2 {
				return s
			}
			var i = 0
			let s = s.split('"').join('\\"')
			fun pushInterpolator() {
				i++
				i++
				fun pushParen(): Void {
					i++

					while i < s.length {
						out.push(s.charAt(i))

						if s.charAt(i) == '(' {
							pushParen()
							continue
						}

						if s.charAt(i) == ')' {
							i++
							return
						}
						i++
					}
					// TODO wrap into error
					throw 'String interpolation error: unclosed inner parenthesis'
				}

				while i < s.length {
					out.push(s.charAt(i))

					if s.charAt(i) == '(' {
						pushParen()
						continue
					}

					if s.charAt(i) == ')' {
						i++
						return
					}
					i++
				}
				// TODO wrap into error
				throw 'String interpolation error: unclosed parenthesis'
			}
			var result = ['"']
			while i < s.length {
				if s.charAt(i) == '\\' and s.charAt(i + 1) == '(' {
					result.push('" + ')
					out.push('" + (')
					var ii = i + 1
					pushInterpolator()
					result.push(s.substring(ii, i + 1))
					result.push(' + "')
					out.push(' + "')
				} else {
					out.push(s.charAt(i))
					result.push(s.charAt(i))
					i++
				}
			}
			result.push('"')
			out.push('"')
			return out.join('')
		}
		var resStr = interpolate(str)
		var tokens = Lexer.tokenize(Buffer.from(resStr), lex.fileName)
		try {
			var parsed = toNode(parseNodes(tokens, project))

			switch parsed {
				case Block(_):
					// TODO wrap into error
					throw "String interpolation error: got a block"
				case _: return parsed
			}
		}
		catch e: Any {
			fail("String interpolation error\n" + e)
		}
	}

	/// Collect sequential Token.Documentation as Comment objects
	// TODO do not allocate `[]` when none... better gather inplace to avoid this temporary array at all
	fun collectDocumentationComments(): [Comment] {
		var comments: [Comment] = []

		while tok() == Token.Documentation {
			let text = lex.value[i]
			let line = lex.line[i]
			let column = lex.column[i]
			comments.push(new Comment(text, line, column))
			i++
		}
		return comments
	}

	fun parseDecorator() {
		i++
		let name = getgo(Token.Identifier)
		let values = []
		// `@name/*no space here*/(args)`
		if tok() == Token.CallOpen and (lex.column[i] == lex.value[i - 1].length + lex.column[i - 1]) {
			i++

			if tok() != Token.CallClose { while true {
					values.push(parseExpr())

					if tok() == Token.Comma {
						i++
					} else {
						break
					}
				} }
			step(Token.CallClose)
		}
		return new Decorator(name, values)
	}

	var parametricTypeNesting = 0
	var parametricTypeNestingToken = Token.Eof

	/// Parses types with decorators
	fun parseType(): NodeType {
		var isReadonly = false
		if tok() == Token.KReadonly {
			isReadonly = true
			i++
		}

		if tok() == Token.At {
			let decorators: Array<Decorator> = []

			while tok() == Token.At {
				decorators.push(parseDecorator())
			}
			let kind = parseUndecoratedType()
			project.typeDecorators.set(kind, decorators)
			if isReadonly {
				project.typeReadonly.set(kind, true)
			}
			return kind
		}

		let kind = parseUndecoratedType()
		if isReadonly {
			project.typeReadonly.set(kind, true)
		}
		return kind
	}

	/// Parses only types
	fun parseUndecoratedType(): NodeType {
		// Plain values

		if tok() == Token.Identifier {
			// TODO `ident<T>` maybe?
			return NodeType.Ident(getgo(Token.Identifier))
		}

		if tok() == Token.Integer {
			return NodeType.Int(parseInt(getgo(Token.Integer)))
		}

		if tok() == Token.FloatingPoint {
			return NodeType.Float(parseFloat(getgo(Token.FloatingPoint)))
		}

		if tok() == Token.QuotedString {
			return NodeType.String(getgo(Token.QuotedString))
		}

		if tok() == Token.Identifier and offset(1) == Token.CallOpen {
			let name = getgo(Token.Identifier)
			i++
			let argNames: [String] = []
			let values: [NodeType] = []

			while tok() != Token.CallClose {
				if tok() == Token.Identifier {
					argNames.push(getgo(Token.Identifier))
					step(Token.Colon)
				} else {
					argNames.push(null)
				}

				values.push(parseType())

				if tok() == Token.CallClose {
					break
				} else {
					step(Token.Comma)
				}
			}

			step(Token.CallClose)
			return NodeType.Call(name, argNames, values)
		}

		// Types
		// TODO NameSpace.NameSpace.T parsing
		// var path = []
		// while (tok() == Token.Identifier && offset(1) == Token.Dot) {
		// path.push(getgo(Token.Identifier))
		// i++
		// }

		let path: String? = if tok() == Token.Identifier and offset(1) == Token.Dot {
			let result = getgo(Token.Identifier)
			i++
			result
		} else {
			// TODO special typer case for if xx else null => T?
			null
		}

		var result: NodeType? = null
		switch tok() {
			case Title:
				var name = getgo(Token.Title)
				// if path.length != 0 {
				// name = path.join('.') + '.' + name
				// }
				while tok() == Token.Dot {
					i++
					// TODO why?
					getgo(Token.Title)
				}
				var sresult = if tok() == Token.Less {
					i++
					parametricTypeNesting++
					var params: [NodeType] = [parseType()]

					while tok() == Token.Comma {
						i++
						params.push(parseType())
					}

					if parametricTypeNestingToken == Token.Eof {
						parametricTypeNestingToken = tok()
					}

					switch parametricTypeNestingToken {
						case Greater: parametricTypeNesting -= 1 parametricTypeNestingToken = Token.Eof i++
						case BitwiseRightShift: parametricTypeNesting -= 1 parametricTypeNestingToken = Token.Greater
						case UnsignedRightShift: parametricTypeNesting -= 1 parametricTypeNestingToken = Token.UnsignedRightShift
						case _: unexpected()
					}

					if parametricTypeNesting < 0 {
						// TODO better error (internal)
						fail("parametricTypeNesting < 0")
					}

					NodeType.ParametricType(name, params, path)
				} else {
					NodeType.Type(name, path)
				}

				// `A => B`
				if tok() == Token.RightArrow {
					i++
					sresult = NodeType.Function([sresult], parseType())
				}

				result = sresult
				// `[Type]`
			case IndexOpen:
				if path != null {
					fail("This path syntax is incorrect")
				}

				i++
				var res: NodeType? = null
				switch tok() {
					case IndexClose:
						i++
						res = NodeType.ParametricType("Array", [NodeType.Object([], [])], path)
					case Colon:
						i++

						if tok() == Token.IndexClose {
							i++
							res = NodeType.ParametricType("Map", [NodeType.Object([], []), NodeType.Object([], [])], path)
						}
						else {
							res = NodeType.ParametricType("Map", [NodeType.Object([], []), parseType()], path)
						}
					case _:
						var key = parseType()
						var innerRes = if tok() == Token.Colon { // Map
							i++
							NodeType.ParametricType("Map", [key, parseType()], path)
						} else {
							NodeType.ParametricType("Array", [key], path)
						}
						step(Token.IndexClose)
						if tok() == Token.RightArrow {
							i++
							innerRes = NodeType.Function([res], parseType())
						}
						res = innerRes
				}
				result = res
				// `type/interface {}`
			case KType | KInterface:
				if path != null {
					// TODO deprecated
					fail("This path syntax is incorrect")
				}

				i++
				step(Token.BlockOpen)

				var sresult = if tok() == Token.BlockClose { // Empty
					NodeType.Object([], [])
				} else {
					var names: [String] = []
					var types: [NodeType] = []

					while tok() != Token.BlockClose {
						names.push(getgo(Token.Identifier))

						if tok() == Token.Colon {
							i++
							types.push(parseType())
						}

						if tok() == Token.Comma {
							i++
						}
					}
					NodeType.Object(names, types)
				}
				step(Token.BlockClose)
				if tok() == Token.RightArrow {
					i++
					sresult = NodeType.Function([sresult], parseType())
				}
				result = sresult
				// `()`
			case CallOpen:
				if path != null {
					fail("This path syntax is incorrect")
				}

				i++
				var args = []

				while tok() != Token.CallClose {
					if tok() == Token.Identifier {
						// TODO save identifier name
						step(Token.Identifier)

						if tok() == Token.Colon {
							// TODO colon-less
							i++
						}
					}
					// TODO combine into single object type+name (NodeType.FunctionArg) instead of two arrays (simplicity + optimization)
					args.push(parseType())
					// TODO parse default value
					if tok() == Token.Comma {
						i++
					}
				}
				step(Token.CallClose)
				step(Token.RightArrow)
				result = NodeType.Function(args, parseType())

				// TODO deprecated
				// name: T (parsing of function arguments directly via `parseType`)
				// name.T
				// name.name.T (recursion)
			case Identifier:
				var res: NodeType? = null
				switch offset(1) {
					case Colon: {
							var argName = getgo(tok())
							step(Token.Colon)
							var argType = parseType()
							res = NodeType.FunctionArg(argName, argType, null)
						}
						// case Dot: {
						// i += 2
						// parseType()
						// }
					case _: {
							fail("Type name `\(print())` cannot start with lowercase")
						}
				}
				result = res

			case _:
				fail("Expected type, parsed `" + Token.stringify(tok()) + "`")
		}

		if tok() == Token.Question {
			result = NodeType.Optional(result)
		}

		while tok() == Token.Question {
			i++
		}

		if tok() == Token.RightArrow {
			i++
			result = NodeType.Function([result], parseType())
		}
		return result
	}

	// TODO proper precedence table
	static fun precedence(op: Token): Int {
		let left = 100
		let right = 0

		switch op {
			case Remainder: return 0 + left
			case Exponent: return 0 + left
			case Multiply: return 1 + left
			case Divide: return 1 + left
			case IntegerDivide: return 1 + left
			case Add: return 2 + left
				// case Question: return 100 + right
			case Subtract: return 2 + left
			case BitwiseLeftShift: return 3 + left
			case BitwiseRightShift: return 3 + left
			case UnsignedRightShift: return 3 + left
			case BitwiseOr: return 4 + left
			case BitwiseAnd: return 4 + left
			case BitwiseXor: return 4 + left
			case Equal: return 5 + left
			case Unequal: return 5 + left
			case Greater: return 5 + left
			case Less: return 5 + left
			case GreaterOrEqual: return 5 + left
			case LessOrEqual: return 5 + left
			case LogicalAnd | KAnd: return 7 + left
			case LogicalOr | KOr: return 8 + left
			case Assign: return 10 + right
			case _: // TODO proper message, this is internal error
				fail("No precedence for " + Token.stringify(op))
		}
	}

	static fun isBinop(t: Token): Bool {
		switch t {
			// TODO case Question: return true
			case Add: return true
			case Multiply: return true
			case Divide: return true
			case IntegerDivide: return true
			case Subtract: return true
			case Assign: return true
			case Equal: return true
			case Unequal: return true
			case Greater: return true
			case GreaterOrEqual: return true
			case Less: return true
			case LessOrEqual: return true
			case BitwiseAnd: return true
			case BitwiseOr: return true
			case BitwiseXor: return true
			case LogicalAnd | KAnd: return true
			case LogicalOr | KOr: return true
			case BitwiseLeftShift: return true
			case BitwiseRightShift: return true
			case UnsignedRightShift: return true
			case Remainder: return true
			case Exponent: return true
			case _: return false
		}
	}
}
