	/// Reflection ABI (hidden+public, COM-compatible, stable negative offsets).
	/// Hidden part lives at negative offset from the public vtable pointer:
	/// instance `_->` points at `Foo_vt.public_`, reflection via
	/// `HexaReflectFor_(tag)->dyn_get_` etc. All impl under vtables, no
	/// direct RTTI reads. Future-proofing is one universal `reflect_` slot
	/// taking `HexaReflectOp_*` (code + args + result placement) — new ops
	/// need no vtable layout change, only new `code_` values.
	/// Public part starts with IUnknown (QI/AddRef/Release) for COM.
	fun printReflectABI(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// Reflection ABI (hidden+public, COM-compatible, stable)' + nl
		r += 'struct String_;' + nl
		r += 'struct Any_;' + nl
		r += 'struct HexaReflectOp_ ' + lb + nl
		r += 'int32_t code_;' + nl
		r += 'int32_t index_;' + nl
		r += 'struct String_* key_;' + nl
		r += 'struct Any_* value_;' + nl
		r += 'struct Any_* result_;' + nl
		r += 'int32_t resultInt_;' + nl
		r += 'const char* resultCStr_;' + nl
		r += 'struct String_* resultStr_;' + nl
		r += 'void* reserved_[4];' + nl
		r += rb + ';' + nl
		r += 'struct HexaReflect_ ' + lb + nl
		r += 'void (*destroy_)(void*);' + nl
		r += 'uint8_t (*toBool_)(void*);' + nl
		r += 'struct String_* (*toString_)(void*);' + nl
		r += 'const char* (*className_)(void);' + nl
		r += 'struct Any_* (*dyn_get_)(void*, struct String_*);' + nl
		r += 'void (*dyn_set_)(void*, struct String_*, struct Any_*);' + nl
		r += 'uint8_t (*has_)(void*, struct String_*);' + nl
		r += 'void (*delete_)(void*, struct String_*);' + nl
		r += 'struct String_* (*keyAt_)(void*, int32_t);' + nl
		r += 'int32_t (*keyCount_)(void*);' + nl
		r += 'struct Any_* (*index_get_)(void*, int32_t);' + nl
		r += 'void (*index_set_)(void*, int32_t, struct Any_*);' + nl
		r += 'int32_t (*index_count_)(void*);' + nl
		r += 'void (*reflect_)(void*, struct HexaReflectOp_*);' + nl
		r += rb + ';' + nl
		r += '_Static_assert(sizeof(struct HexaReflectOp_) == (size_t)88, "reflect: HexaReflectOp_ must stay 88");' + nl
		r += '_Static_assert(sizeof(struct HexaReflect_) == (size_t)112, "reflect: HexaReflect_ must stay 112 for stable negative offsets");' + nl
		r += 'uint8_t Hexa_ToBoolTrue_(void* self);' + nl
