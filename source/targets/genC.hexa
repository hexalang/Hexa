		r += 'void AnyFloat_hiddenDelete_(void*, struct String_*);' + nl
		r += 'void AnyFloat_hiddenDelete_(void* self_, struct String_* k_) ' + lb + ' (void)self_; (void)k_; ' + rb + nl
		r += 'struct String_* AnyFloat_hiddenKeyAt_(void*, int32_t);' + nl
