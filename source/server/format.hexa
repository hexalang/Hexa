/// Formatting preserves user personal style
fun autoFormatWholeFile(file: String): String {
	let project = new Project()
	let content = Buffer.from(file)
	try {
		let tokens = Lexer.tokenize(content, 'hexa.hexa', format: true)
		let count = tokens.line.length - 1
		let result = ['']
		var lastLine = 1
		var lastToken = Token.Eof
		var lastLastToken = Token.Eof

		var tabs = ''
		var tabStack = ['']
		var tabCase = [false]
		var depth = 0
		let assignOp = [Token.Add, Token.Multiply, Token.Subtract]
		var parenthesis = -1000000

		fun updateTab() {
			tabs = tabStack.slice(0, depth + 1).join('')
		}

		fun pushTab() {
			depth++
			tabStack[depth] = '\t'
			updateTab()
		}

		fun popTab() {
			depth--
			if depth < 0 {
				depth = 0
			}
			updateTab()
		}

		fun appendTab() {
			// TODO array[]op= should work at least for strings (and Numbers?)
			tabStack[depth] += '\t'
			updateTab()
		}

		fun resetTab() {
			tabStack[depth] = '\t'
			updateTab()
		}

		for i in count {
			let token = tokens.token[i] as! Token

			if
				token == Token.BlockClose or
				token == Token.CallClose or
				token == Token.IndexClose
			{
				parenthesis--
				popTab()
			}

			if token == Token.BlockOpen and parenthesis == 0 {
				parenthesis = -1000000
				popTab()
			}

			if token == Token.KCase {
				resetTab()
			}

			var shouldSpace = true
			let line = tokens.line[i]
			if line != lastLine {
				result.push('\n')
				// Handle double \n\n
				let lineDiff = line - lastLine
				if lineDiff > 1 {
					result.push('\n')
				}

				// TODO if bool? of array[i] not valid, require == true
				if (token == Token.KCase or token == Token.BlockClose) and tabCase[depth] == true {
					//	tabCase[depth] = false
					//	tabs = tabStack.join('')
				}

				result.push(tabs)
				shouldSpace = false
			}

			lastLine = line

			if
				// `#if`
				lastToken == Token.Sharp or

				// TODO if\nconds\n{}
				lastToken == Token.Eof or
				lastToken == Token.Dot or
				token == Token.Dot or

				(token == Token.Assign and assignOp.includes(lastToken)) or

				lastToken == Token.CallOpen or
				(
					token == Token.CallOpen and
					(
						lastToken != Token.KIf and
						lastToken != Token.KNew and
						lastToken != Token.LogicalAnd and
						lastToken != Token.LogicalOr and
						lastToken != Token.KNew and
						lastToken != Token.Assign
					)
				) or
				token == Token.CallClose or

				lastToken == Token.IndexOpen or
				(
					token == Token.IndexOpen and
					(
						lastToken == Token.Identifier or
						lastToken == Token.IndexClose
					) and (
						// TODO same for ()=>
						lastLastToken != Token.KVar and
						lastLastToken != Token.CallOpen and
						lastLastToken != Token.Comma and
						lastLastToken != Token.KLet
					)
				) or
				token == Token.IndexClose or

				// `@at`
				(token == Token.Identifier and lastToken == Token.At) or

				(
					token == Token.Question and
					(
						// `??`
						lastToken == Token.Question or
						// `Type?`
						lastToken == Token.Title
					)
				) or

				// `as!`
				(lastToken == Token.KAs and token == Token.KNot) or

				// `++`
				token == Token.Increment or

				// `--`
				token == Token.Decrement or

				// `-123`
				(
					(
						token == Token.FloatingPoint or
						token == Token.Integer or
						token == Token.Identifier
					) and
					lastToken == Token.Subtract and
					(
						lastLastToken == Token.IndexOpen or
						lastLastToken == Token.BlockOpen or
						lastLastToken == Token.Comma or
						lastLastToken == Token.Colon or
						lastLastToken == Token.CallOpen or
						lastLastToken == Token.Question or
						lastLastToken == Token.Assign or
						lastLastToken == Token.Equal or
						lastLastToken == Token.Greater or
						lastLastToken == Token.GreaterOrEqual or
						lastLastToken == Token.Less or
						lastLastToken == Token.LessOrEqual or
						lastLastToken == Token.Unequal
					)
				) or

				token == Token.Comma or
				token == Token.Colon
			{
				shouldSpace = false
			}

			if shouldSpace {
				result.push(' ')
			}

			switch token {
				case Comment: result.push(`/*` + tokens.value[i] + `*/`)
				case CommentLine: result.push('//' + tokens.value[i])
				case LogicalAnd: result.push('and')
				case LogicalOr: result.push('or')
				case KNot:
					// TODO Separate exclamation mark
					if lastToken == Token.KAs {
						result.push('!')
					} else {
						result.push('not')
					}
				case QuotedString: switch tokens.meta[i] {
					case SingleQuote: result.push(`'` + tokens.value[i] + `'`)
					case DoubleQuote: result.push(`"` + tokens.value[i] + `"`)
				}
				case _: result.push(Token.stringify(token, tokens.value[i], tokens.meta[i]))
			}

			lastLastToken = lastToken
			lastToken = token

			switch token {
				case BlockOpen:
					pushTab()
					if parenthesis > 0 {
						parenthesis++
					}
				case CallOpen:
					pushTab()
					parenthesis++
				case IndexOpen:
					pushTab()
					parenthesis++
				case KCase:
					appendTab()
				case KIf:
					// TODO appendTab()
					pushTab()
					parenthesis = 0
			}
		}

		// TODO (when) use CRLF? or it seems vscode fixes it on its own
		return result.join('') + '\n'
	} catch e: CompilerErrors {
		return file
	}

	return file
}
