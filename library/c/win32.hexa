// Win32 raw ABI for the native target (Hexa-first std surface).
//
// Pattern: plain `@rename` declares against the real Win32 APIs (kernel32 is
// default-linked; UuidCreate needs rpcrt4, already in the Perfide link). No
// `@dllImport` — same-TU definitions would break with dllimport linkage, and
// system APIs resolve fine via the CRT import libs (same approach as the
// `malloc`/`wprintf` declares in c.hexa).
//
// Awkward signatures (NULL security attributes, WIN32_FIND_DATAW iteration,
// FILETIME math) go through tiny `static inline` C shims in the custom header
// below (the sanctioned raw-C workaround — see `hostNativePrototypes` in
// Perfide's std/native.hexa for why the holder fun needs a real body).

// ─── Access / share / disposition / attribute consts (UInt32) ───────────────
let genericRead UInt32 = 0x80000000u32
let genericWrite UInt32 = 0x40000000u32
let fileShareRead UInt32 = 0x00000001u32
let fileShareWrite UInt32 = 0x00000002u32
let fileShareDelete UInt32 = 0x00000004u32
let createNew UInt32 = 1u32
let createAlways UInt32 = 2u32
let openExisting UInt32 = 3u32
let openAlways UInt32 = 4u32
let truncateExisting UInt32 = 5u32
let fileAttributeReadonly UInt32 = 0x00000001u32
let fileAttributeHidden UInt32 = 0x00000002u32
let fileAttributeSystem UInt32 = 0x00000004u32
let fileAttributeDirectory UInt32 = 0x00000010u32
let fileAttributeArchive UInt32 = 0x00000020u32
let fileAttributeNormal UInt32 = 0x00000080u32
let fileAttributeTemporary UInt32 = 0x00000100u32
let invalidFileAttributes UInt32 = 0xFFFFFFFFu32
let invalidFileSize UInt32 = 0xFFFFFFFFu32
let fileBeginMoveMethod UInt32 = 0u32
let moveFileReplaceExisting UInt32 = 0x00000001u32
let maxPathChars Int = 260

// ─── Win32 handle interop (bare `@rename`, no `@struct` — these are pointer
// typedefs like `void*`, so the Hexa value IS the C pointer, no extra `*`).
// Pattern matches `ClangWideChar` (`@rename('wchar_t')` → `wchar_t`).
// Direct Win32 declares below take these instead of `UInt64` so call sites
// match windows.h without casts (C2664); `null` (nullptr) is the NULL handle.
@rename('HANDLE') declare class HANDLE { }
@rename('HMODULE') declare class HMODULE { }
@rename('HLOCAL') declare class HLOCAL { }
@rename('LPSECURITY_ATTRIBUTES') declare class LPSECURITY_ATTRIBUTES { }
@rename('LPOVERLAPPED') declare class LPOVERLAPPED { }
// DWORD is `unsigned long` (32-bit, distinct from `uint32_t`/`unsigned int` on
// MSVC) — `LPDWORD` (`DWORD*`) out-params need this, not `UInt32`, or C2664
// fires on `uint32_t*` vs `unsigned long*` (ReadFile/WriteFile/GetFileSize).
@rename('DWORD') declare class DWORD { }
// Opaque Win32 struct pointers (call sites cast their byte buffers with
// `as!`, same pattern as HANDLE/LPDWORD — the Hexa value IS the C pointer).
@rename('LPFILETIME') declare class LPFILETIME { }
@rename('LPTIME_ZONE_INFORMATION') declare class LPTIME_ZONE_INFORMATION { }
@rename('u_long') declare class ULong { }
// UUID is a 16-byte struct (RPC `uuidCreate` writes Data1/Data2/Data3/Data4).
// `@struct @byValue` → plain `UUID` value, so `ArrayPointer<UUID>` is `UUID*`.
@struct
@byValue
@rename('UUID') declare class UUID {
	let data1: UInt32
	let data2: UInt16
	let data3: UInt16
	let data4a: UInt32
	let data4b: UInt32
}

// ─── Host-provided shims (defined in the host TU, e.g. Perfide/main-hexa.cpp)
// Awkward signatures (NULL security attributes, WIN32_FIND_DATAW iteration,
// FILETIME math) live in the host as plain C functions — a `@customHeader`
// C body cannot carry `{`/`}` (interpolation), so the host owns them exactly
// like the `native_*` bindings (declared here via `@rename`, defined there).
// Required host symbols: hexaCreateFileRead/Write/Append, hexaFindFirst/Next/
// Close, hexaWallMs, hexaTickMs.

// ─── Shim declares (Hexa vent over the host C above) ─────────────────────────
@rename('hexaCreateFileRead') declare fun hexaCreateFileRead(path: ConstArrayPointer<ClangWideChar>): UInt64
@rename('hexaCreateFileWrite') declare fun hexaCreateFileWrite(path: ConstArrayPointer<ClangWideChar>): UInt64
@rename('hexaCreateFileAppend') declare fun hexaCreateFileAppend(path: ConstArrayPointer<ClangWideChar>): UInt64
@rename('hexaFindFirst') declare fun hexaFindFirst(pattern: ConstArrayPointer<ClangWideChar>, nameOut: ArrayPointer<ClangWideChar>, isDirOut: ArrayPointer<Int32>): UInt64
@rename('hexaFindNext') declare fun hexaFindNext(handle: UInt64, nameOut: ArrayPointer<ClangWideChar>, isDirOut: ArrayPointer<Int32>): Int32
@rename('hexaFindClose') declare fun hexaFindClose(handle: UInt64): Void
@rename('hexaWallMs') declare fun hexaWallMs(): Float
@rename('hexaTickMs') declare fun hexaTickMs(): Float
// Prototype holder — `declare` emits nothing, so without this the shim calls
// above have no prototype before use (C3861; host defines them AFTER the
// include). Body keeps it in `globalFuncs` so the header is emitted.
@customHeader('
	uint64_t hexaCreateFileRead(const wchar_t* path);
	uint64_t hexaCreateFileWrite(const wchar_t* path);
	uint64_t hexaCreateFileAppend(const wchar_t* path);
	uint64_t hexaFindFirst(const wchar_t* pattern, wchar_t* nameOut, int32_t* isDirOut);
	int32_t hexaFindNext(uint64_t handle, wchar_t* nameOut, int32_t* isDirOut);
	void hexaFindClose(uint64_t handle);
	double hexaWallMs(void);
	double hexaTickMs(void);
	int32_t hexaSetFilePointer(void* handle, int64_t distance, uint8_t* outOld, uint32_t method);
')
fun win32HostPrototypes() {
	// Nothing — the custom header above carries the C prototypes
}
// ─── Direct Win32 declares (clean scalar/pointer signatures only) ───────────
// HANDLEs travel as real HANDLEs (INVALID_HANDLE_VALUE is (int64)-1)
@rename('ReadFile') declare fun readFileWin(handle: HANDLE, buffer: ArrayPointer<UInt8>, toRead: UInt32, readOut: ArrayPointer<DWORD>, overlapped: LPOVERLAPPED): Int32
@rename('WriteFile') declare fun writeFileWin(handle: HANDLE, buffer: ConstArrayPointer<UInt8>, toWrite: UInt32, writtenOut: ArrayPointer<DWORD>, overlapped: LPOVERLAPPED): Int32
@rename('GetFileSize') declare fun getFileSizeWin(handle: HANDLE, highOut: ArrayPointer<DWORD>): UInt32
@dllImport('CloseHandle') declare fun closeHandleWin(handle: HANDLE): Int32
@dllImport('GetFileAttributesW') declare fun getFileAttributesW(path: ConstArrayPointer<ClangWideChar>): UInt32
@dllImport('CreateDirectoryW') declare fun createDirectoryW(path: ConstArrayPointer<ClangWideChar>, security: LPSECURITY_ATTRIBUTES): Int32
@dllImport('RemoveDirectoryW') declare fun removeDirectoryW(path: ConstArrayPointer<ClangWideChar>): Int32
@dllImport('DeleteFileW') declare fun deleteFileW(path: ConstArrayPointer<ClangWideChar>): Int32
@dllImport('MoveFileW') declare fun moveFileW(from: ConstArrayPointer<ClangWideChar>, to: ConstArrayPointer<ClangWideChar>): Int32
// Current directory / module path / command line
@dllImport('GetCurrentDirectoryW') declare fun getCurrentDirectoryW(length: UInt32, buffer: ArrayPointer<ClangWideChar>): UInt32
@dllImport('SetCurrentDirectoryW') declare fun setCurrentDirectoryW(path: ConstArrayPointer<ClangWideChar>): Int32
@dllImport('GetModuleFileNameW') declare fun getModuleFileNameW(module: HMODULE, buffer: ArrayPointer<ClangWideChar>, length: UInt32): UInt32
@dllImport('GetCommandLineW') declare fun getCommandLineW(): ConstArrayPointer<ClangWideChar>
@dllImport('CommandLineToArgvW') declare fun commandLineToArgvW(commandLine: ConstArrayPointer<ClangWideChar>, argcOut: ArrayPointer<Int32>): ArrayPointer<ConstArrayPointer<ClangWideChar>>
@dllImport('LocalFree') declare fun localFreeWin(memory: HLOCAL): HLOCAL
// Process / identity
@dllImport('GetCurrentProcessId') declare fun getCurrentProcessId(): UInt32
@dllImport('ExitProcess') declare fun exitProcessWin(code: UInt32): Void
@dllImport('UuidCreate') declare fun uuidCreateWin(guid: ArrayPointer<UUID>): Int32

// ─── Small Hexa helpers over the declares ───────────────────────────────────
// INVALID_HANDLE_VALUE as a signed compare (avoids a 20-digit u64 literal)
fun winHandleFailed(handle: HANDLE): Bool {
	let signed = handle as!Int64
	return signed < 0
}
// Absolute path of the running module (exe dir seeds session/icons later)
fun winExePath(): String {
	var buf ArrayByValue<ClangWideChar, 512> = [0]
	for i in 512 { buf[i] = 0 }
	let n = getModuleFileNameW(null, buf as!ArrayPointer<ClangWideChar>, 512u32)
	if n == 0u32 { return '' }
	return String.fromUTF16zUpTo(buf as!ConstArrayPointer<UInt16>, n as!Int)
}
// Raw command-line words (argv[0] = exe path)
fun winCommandLineArgs(): [String] {
	var out [String] = []
	var argcBox ArrayByValue<Int32, 1> = [0]
	let argv = commandLineToArgvW(getCommandLineW(), argcBox as!ArrayPointer<Int32>)
	if argv as!UInt64 == 0u64 { return out }
	let argc = (argcBox as!ArrayPointer<Int32>)[0]
	var i = 0
	while i < argc {
		let w = (argv as!ArrayPointer<ConstArrayPointer<ClangWideChar>>)[i]
		out.push(String.fromUTF16z(w as!ConstArrayPointer<UInt16>))
		i++
	}
	localFreeWin(argv as!HLOCAL)
	return out
}

// ─── Little-endian byte-blob helpers (addrinfo/sockaddr/frame parsing) ─────
// Win32 structs crossed by pointer (ADDRINFOW, sockaddr, WS frames) are read
// and written as raw bytes — no Hexa struct layout to keep in sync.
fun readU16LE(buf: ArrayPointer<UInt8>, off: Int): Int {
	return (buf[off] as!Int) + (buf[off + 1] as!Int) * 256
}
fun readU32LE(buf: ArrayPointer<UInt8>, off: Int): UInt32 {
	return (buf[off] as!UInt32) + (buf[off + 1] as!UInt32) * 256u32 + (buf[off + 2] as!UInt32) * 65536u32 + (buf[off + 3] as!UInt32) * 16777216u32
}
fun readI32LE(buf: ArrayPointer<UInt8>, off: Int): Int32 {
	let u = readU32LE(buf, off)
	if u >= 2147483648u32 { return (u - 2147483648u32) as!Int32 - 2147483647 - 1 }
	return u as!Int32
}
fun readU64LE(buf: ArrayPointer<UInt8>, off: Int): UInt64 {
	var lo = readU32LE(buf, off) as!UInt64
	var hi = readU32LE(buf, off + 4) as!UInt64
	return lo + hi * 4294967296u64
}
fun writeU16LE(buf: ArrayPointer<UInt8>, off: Int, v: Int): Void {
	buf[off] = (v % 256) as!UInt8
	buf[off + 1] = (v \ 256) as!UInt8
}
fun writeU32LE(buf: ArrayPointer<UInt8>, off: Int, v: UInt32): Void {
	buf[off] = (v % 256u32) as!UInt8
	buf[off + 1] = ((v \ 256u32) % 256u32) as!UInt8
	buf[off + 2] = ((v \ 65536u32) % 256u32) as!UInt8
	buf[off + 3] = (v \ 16777216u32) as!UInt8
}
fun writeU64LE(buf: ArrayPointer<UInt8>, off: Int, v: UInt64): Void {
	writeU32LE(buf, off, (v % 4294967296u64) as!UInt32)
	writeU32LE(buf, off + 4, (v \ 4294967296u64) as!UInt32)
}
// Bitwise ops over the proven `and` (genC maps `&`; `|`/`^`/`~` on ints are
// unverified, so everything here is add/sub/mul over wrapping UInt32).
fun uNot32(v: UInt32): UInt32 { return 4294967295u32 - v }
fun uOr32(a: UInt32, b: UInt32): UInt32 { return a + b - (a and b) }
fun uXor32(a: UInt32, b: UInt32): UInt32 { return a + b - ((a and b) * 2u32) }
fun iXor(a: Int, b: Int): Int {
	let x = a as!UInt32
	let y = b as!UInt32
	return (x + y - ((x and y) * 2u32)) as!Int
}

// ─── Child-process raw ABI (pipes, CreateProcess, wait) ─────────────────────
// STARTUPINFOW / PROCESS_INFORMATION cross as POINTER-shaped declare structs
// (`@struct` without `@byValue` → Hexa value IS the C pointer): allocate with
// malloc, zero with zeroMemory, set fields, pass straight to CreateProcessW.
// Own Hexa structs (FFI pivot: no SDK struct reliance — field layout mirrors
// the SDK's, names keep the `_` suffix so they never collide when SDK headers
// are present; the DLL entry resolves via @dllImport on CreateProcessW below).
@struct
class StartupInfoW {
	var cb: UInt32
	var lpReserved: ArrayPointer<ClangWideChar>
	var lpDesktop: ArrayPointer<ClangWideChar>
	var lpTitle: ArrayPointer<ClangWideChar>
	var dwX: UInt32
	var dwY: UInt32
	var dwXSize: UInt32
	var dwYSize: UInt32
	var dwXCountChars: UInt32
	var dwYCountChars: UInt32
	var dwFillAttribute: UInt32
	var dwFlags: UInt32
	var wShowWindow: UInt16
	var cbReserved2: UInt16
	var lpReserved2: ArrayPointer<UInt8>
	var hStdInput: HANDLE
	var hStdOutput: HANDLE
	var hStdError: HANDLE
}
@struct
@rename('PROCESS_INFORMATION') declare class ProcessInfo {
	var hProcess: HANDLE
	var hThread: HANDLE
	var dwProcessId: UInt32
	var dwThreadId: UInt32
}
let handleFlagInherit UInt32 = 1u32
let startfUseStdHandles UInt32 = 1u32
let startfUseShowWindow UInt32 = 1u32
let createNoWindow UInt32 = 0x08000000u32
let infiniteTimeout UInt32 = 0xFFFFFFFFu32
let waitObject0 UInt32 = 0u32
let stillActive UInt32 = 259u32
let swHide Int32 = 0
@rename('CreatePipe') declare fun createPipeWin(readOut: ArrayPointer<HANDLE>, writeOut: ArrayPointer<HANDLE>, attrs: LPSECURITY_ATTRIBUTES, size: UInt32): Int32
@rename('SetHandleInformation') declare fun setHandleInformationWin(handle: HANDLE, mask: DWORD, flags: DWORD): Int32
@rename('CreateProcessW') declare fun createProcessWin(app: ConstArrayPointer<ClangWideChar>, cmd: ArrayPointer<ClangWideChar>, procAttrs: LPSECURITY_ATTRIBUTES, threadAttrs: LPSECURITY_ATTRIBUTES, inherit: Int32, flags: UInt32, env: ArrayPointer<UInt8>, cwd: ConstArrayPointer<ClangWideChar>?, startup: StartupInfoW, procInfo: ProcessInfo): Int32
@rename('WaitForSingleObject') declare fun waitForSingleObjectWin(handle: HANDLE, timeoutMs: DWORD): UInt32
@rename('GetExitCodeProcess') declare fun getExitCodeProcessWin(handle: HANDLE, codeOut: LPDWORD): Int32
@rename('TerminateProcess') declare fun terminateProcessWin(handle: HANDLE, code: UInt32): Int32
@rename('PeekNamedPipe') declare fun peekNamedPipeWin(handle: HANDLE, buffer: ArrayPointer<UInt8>, size: UInt32, readOut: LPDWORD, availOut: LPDWORD, leftOut: LPDWORD): Int32

// ─── WinHTTP raw ABI (sync request core for fetch + https/http) ─────────────
// winsock2 must come AFTER windows.h here only because the generated TU sets
// WIN32_LEAN_AND_MEAN (which drops winsock.h) — the documented safe order.
// ws2_32/winhttp link via pragma so build_msvc_hexa.bat stays untouched.
// ─── FFI link block: no SDK headers in the generated TU ─────────────────────
@customHeader('
	#include <winsock2.h>
	#include <ws2tcpip.h>
	#include <winhttp.h>
	#pragma comment(lib, "ws2_32.lib")
	#pragma comment(lib, "winhttp.lib")
	#pragma comment(lib, "psapi.lib")
')
fun win32NetPrototypes() {
	// Nothing — the custom header above carries the link pragmas
}
@rename('HINTERNET') declare class HINTERNET { }
let winhttpAccessDefaultProxy UInt32 = 0u32
let winhttpFlagSecure UInt32 = 0x00800000u32
let winhttpQueryStatusCode UInt32 = 19u32
let winhttpQueryLocation UInt32 = 33u32
let winhttpQueryRawHeaders UInt32 = 22u32
let winhttpQueryFlagNumber UInt32 = 0x20000000u32
let winhttpOptionRedirectPolicy UInt32 = 88u32
let winhttpRedirectNever UInt32 = 1u32
@dllImport('WinHttpOpen') declare fun winHttpOpen(agent: ConstArrayPointer<ClangWideChar>, access: DWORD, proxy: ConstArrayPointer<ClangWideChar>, bypass: ConstArrayPointer<ClangWideChar>, flags: DWORD): HINTERNET
@dllImport('WinHttpConnect') declare fun winHttpConnect(session: HINTERNET, host: ConstArrayPointer<ClangWideChar>, port: UInt16, reserved: DWORD): HINTERNET
@dllImport('WinHttpOpenRequest') declare fun winHttpOpenRequest(connect: HINTERNET, verb: ConstArrayPointer<ClangWideChar>, objectName: ConstArrayPointer<ClangWideChar>, version: ConstArrayPointer<ClangWideChar>, referrer: ConstArrayPointer<ClangWideChar>, accept: ArrayPointer<ConstArrayPointer<ClangWideChar>>, flags: DWORD): HINTERNET
@dllImport('WinHttpSendRequest') declare fun winHttpSendRequest(request: HINTERNET, headers: ConstArrayPointer<ClangWideChar>, headersLen: UInt32, optional: ArrayPointer<UInt8>, optionalLen: UInt32, totalLen: UInt32, context: UInt64): Int32
@dllImport('WinHttpReceiveResponse') declare fun winHttpReceiveResponse(request: HINTERNET, reserved: ArrayPointer<UInt8>): Int32
@dllImport('WinHttpQueryHeaders') declare fun winHttpQueryHeaders(request: HINTERNET, infoLevel: DWORD, name: ConstArrayPointer<ClangWideChar>, buffer: ArrayPointer<UInt8>, bufferLen: LPDWORD, index: LPDWORD): Int32
@dllImport('WinHttpQueryDataAvailable') declare fun winHttpQueryDataAvailable(request: HINTERNET, available: LPDWORD): Int32
@dllImport('WinHttpReadData') declare fun winHttpReadData(request: HINTERNET, buffer: ArrayPointer<UInt8>, toRead: UInt32, readOut: LPDWORD): Int32
@dllImport('WinHttpSetTimeouts') declare fun winHttpSetTimeouts(handle: HINTERNET, resolveMs: Int32, connectMs: Int32, sendMs: Int32, receiveMs: Int32): Int32
@dllImport('WinHttpSetOption') declare fun winHttpSetOption(handle: HINTERNET, option: DWORD, buffer: ArrayPointer<UInt8>, length: UInt32): Int32
@dllImport('WinHttpCloseHandle') declare fun winHttpCloseHandle(handle: HINTERNET): Int32

// ─── Winsock raw ABI (TCP connect for WebSocket; DNS via GetAddrInfoW) ──────
let afInet Int32 = 2
let sockStream Int32 = 1
let ipprotoTcp Int32 = 6
let fionbioCtl UInt32 = 0x8004667Eu32
let socketError Int32 = -1
// SOCKET is UINT_PTR — travels as Int64, INVALID_SOCKET is (int64)-1.
@rename('WSAStartup') declare fun wsaStartupWin(version: UInt16, data: ArrayPointer<UInt8>): Int32
@rename('socket') declare fun socketWin(family: Int32, typ: Int32, protocol: Int32): Int64
@rename('GetAddrInfoW') declare fun getAddrInfoWin(node: ConstArrayPointer<ClangWideChar>, service: ConstArrayPointer<ClangWideChar>, hints: ArrayPointer<UInt8>, resultOut: ArrayPointer<UInt64>): Int32
@rename('FreeAddrInfoW') declare fun freeAddrInfoWin(info: ArrayPointer<UInt8>): Void
@rename('connect') declare fun connectWin(sock: Int64, addr: ArrayPointer<UInt8>, addrLen: Int32): Int32
@rename('send') declare fun sendWin(sock: Int64, buffer: ConstArrayPointer<UInt8>, length: Int32, flags: Int32): Int32
@rename('recv') declare fun recvWin(sock: Int64, buffer: ArrayPointer<UInt8>, length: Int32, flags: Int32): Int32
@rename('ioctlsocket') declare fun ioctlSocketWin(sock: Int64, cmd: UInt32, arg: ArrayPointer<ULong>): Int32
@rename('closesocket') declare fun closeSocketWin(sock: Int64): Int32
@rename('WSAGetLastError') declare fun wsaGetLastErrorWin(): Int32
let wsaWouldBlock Int32 = 10035

// ─── Timezone bias (minutes to add to local time to get UTC) ─────────────────
@dllImport('GetTimeZoneInformation') declare fun getTimeZoneInformationWin(info: LPTIME_ZONE_INFORMATION): UInt32
fun winTimezoneBiasMinutes(): Int {
	var blob ArrayByValue<UInt8, 172> = [0]
	for i in 172 { blob[i] = 0 }
	getTimeZoneInformationWin(blob as!LPTIME_ZONE_INFORMATION)
	return readI32LE(blob as!ArrayPointer<UInt8>, 0) as!Int
}

// ─── File time + full-path + environment + std handles ──────────────────────
// FILETIME crosses as 8 raw bytes (two DWORDs, 100ns ticks since 1601).
@dllImport('GetFileTime') declare fun getFileTimeWin(handle: HANDLE, creation: LPFILETIME, access: LPFILETIME, write: LPFILETIME): Int32
// GetFullPathW is intentionally NOT bound (absent from lean windows.h in this
// TU) — realpath resolves against the native cwd in pure Hexa instead.
@dllImport('GetEnvironmentVariableW') declare fun getEnvironmentVariableWin(name: ConstArrayPointer<ClangWideChar>, buffer: ArrayPointer<ClangWideChar>, size: UInt32): UInt32
// Two-call shape: size query first, then the real fetch (avoids truncation).
fun winGetEnv(name: String): String {
	let need = getEnvironmentVariableWin(name.utf16(), null, 0u32)
	if need == 0u32 { return '' }
	var buf ArrayByValue<ClangWideChar, 32768> = [0]
	for i in 32768 { buf[i] = 0 }
	let n = getEnvironmentVariableWin(name.utf16(), buf as!ArrayPointer<ClangWideChar>, 32768u32)
	if n == 0u32 or n >= 32768u32 { return '' }
	return String.fromUTF16zUpTo(buf as!ConstArrayPointer<UInt16>, n as!Int)
}
@dllImport('GetStdHandle') declare fun getStdHandleWin(which: Int32): HANDLE
@dllImport('GetCurrentProcess') declare fun getCurrentProcessWin(): HANDLE
@dllImport('GetProcessMemoryInfo') declare fun getProcessMemoryInfoWin(process: HANDLE, counters: ArrayPointer<UInt8>, size: UInt32): Int32
let stdInputHandle Int32 = -10
let stdOutputHandle Int32 = -11
let stdErrorHandle Int32 = -12
@dllImport('GetLastError') declare fun getLastErrorWin(): UInt32
// Direct CreateFileW for the fd table (access/disposition per flags string).
let genericReadWrite UInt32 = 0xC0000000u32
let fileAppendData UInt32 = 0x00000004u32
let fileCurrentMoveMethod UInt32 = 1u32
@dllImport('CreateFileW') declare fun createFileWin(path: ConstArrayPointer<ClangWideChar>, access: UInt32, share: UInt32, security: LPSECURITY_ATTRIBUTES, disposition: UInt32, attrs: UInt32, template: HANDLE): HANDLE
// SetFilePointerEx takes LARGE_INTEGER by value (a C union — not expressible
// in a Hexa declare), so it goes through a tiny host shim like the other
// awkward signatures (see hexa* shims above).
@rename('hexaSetFilePointer') declare fun setFilePointerExWin(handle: HANDLE, distance: Int64, outOld: ArrayPointer<UInt8>, method: DWORD): Int32
