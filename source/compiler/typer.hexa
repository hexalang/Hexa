/// Analyzes and transforms untyped syntax tree from parser into typed syntax tree, and sends into normalizer
@final
// TODO class Typer extends TyperData/TyperState {
class Typer {
	// Note that we use new instance for each build to avoid collisions with unit tests
	// and to support parallel compilation in future
	var project: Project

	/// Workaround for language server
	var onlyTypeCheck = false

	// TODO move all variables here
	let expectedArrowType: [Node : Type] = [:]

	new (project: Project) {
		this.project = project
	}

	// Starting point of typer
	fun fillModules() {
		// Globals already pre-filled in package loader
		// so we do not fill them here
		fun checkOverrides(info: Module, name: String, e: Node) {
			if info.exported.has(name) {
				fail('Module `\(info.path)` already exports name `\(name)`', e)
				// TODO where?
			}

			if info.imported.has(name) {
				fail('Module `\(info.path)` already imports name `\(name)`', e)
				// TODO where?
			}
		}

		// Fill exports first to allow recursive imports
		for info in project.moduleInfo {
			let nodes = info.nodes

			for e in nodes {
				// TODO just use `case ... or ...:`
				var named = true
				switch e {
					case Var(_):
					case Enum(_):
					case Function(_):
					case Class(_):
					case TypeAlias(_):
						// TODO type alias
					case _:
						named = false
				}

				if named {
					let name = DataHelper.nameOf(e)
					checkOverrides(info, name, e)
					info.exported.set(name, e)
					project.mapModules.set(e, info)
				}
			}
		}

		// Imports & expressions
		for info in project.moduleInfo {
			let nodes = info.nodes
			pushScope()

			var doneImports = false
			for e in nodes {
				var named = true
				var lastOne = nodes[0]
				switch e {
					case Import(els, path):
						if doneImports {
							fail(
								'Imports should follow before expressions\n'
								+ positionOf(lastOne) + 'Expression is here',
								e)
						}

						let index: Module? = project.mapModules.get(e)
						// let index = project.moduleName.indexOf(path)
						// if (index == -1) {
						// fail('Cannot import ' + path, e)
						// }

						if index == null {
							fail('Cannot import ' + path, e)
						}

						fun importAs(name: String, to: String) {
							if let target = index {
								// if let target = project.moduleInfo[index] {
								if name == '*' {
									info.imported.set(to, Node.ModuleExports(target))
								} else
								if let what = target.exported.get(name) {
									checkOverrides(info, to, e)
									info.imported.set(to, what)
								} else {
									var has = [for key in target.exported.keys() key].join(', ')
									if has == '' {
										has = 'module is empty'
									}
									fail('Module `\(path)` does not export `\(name)`\nAvailable exports: \(has)', e)
								}
							}
						}

						// TODO `let target = target.exported.keys() ?? throw 'unreachable'` special case for `??` nodes
						if els.length == 0 {
							// if let target = project.moduleInfo[index] {
							if let target = index {
								for key in target.exported.keys() {
									info.imported.set(key, target.exported.get(key))
								}
								// console.log('wildcard', target.exported.keys(), info.imported.keys())
							}
						}

						for el in els {
							switch el {
								case Lower(name):
									// TODO only camelCase
									importAs(name, name)
								case Upper(name):
									// TODO only TitleCase
									importAs(name, name)
								case As(left, right):
									var lhs = ''
									switch left {
										case Lower(name):
											lhs = name
										case Upper(name):
											lhs = name
										case AllTheThings:
											lhs = '*'
										case _:
											fail('This `import ??? as` kind not implemented yet or syntax is incorrect', e)
									}
									switch right {
										case Lower(name):
											// TODO only camelCase
											importAs(lhs, name)
										case Upper(name):
											// TODO only TitleCase
											importAs(lhs, name)
										case _:
											fail('This `import \(lhs) as ???` kind not implemented yet or syntax is incorrect', e)
									}
								case _:
									fail('This import kind not implemented yet', e)
							}
						}
					case _:
						lastOne = e
						doneImports = true

						// Fill classes and non-ambiguous nodes first
						let node = e
						if currentModule != info {
							// console.log('currentModule = info', currentModule.path, info.path)
						}
						currentModule = info

						switch node {
							case Class(_):
								parents.set(node, e)
								fillModuleTypes(node)
							case Enum(_):
								parents.set(node, e)
								fillModuleTypes(node)
							case TypeAlias(_):
								parents.set(node, e)
								fillModuleTypes(node)
							case Function(name, expr, vars, rettype, _, variadic):
								if let rettype = rettype {
									pushFuncParamsIfRequired(node)
									types.set(
										node,
										Type.Function(varTypes(vars), toType(rettype, node), variadic)
									)
									popFuncParamsIfRequired(node)
								}
							case Var(name, t, e, const):
								if let t = t {
									types.set(node, toType(t, node))
								}
							case _:
						}
				}
			}
		}

		// Fill global expressions // TODO
		let doNotInstantiate = [
			'ConstArrayPointer', 'ArrayPointer', 'ArrayByValue'
		]

		for info in project.moduleInfo {
			let nodes = info.nodes
			let self = Node.Module(info.path, info.nodes)
			pushScope()
			// console.log('Fill expression bodies', info.path)
			currentModule = info

			// Fill expression bodies
			for node in nodes {
				switch node {
					case Import(_):
					case Class(_):
						// Fill generic instances
						// TODO same for enums

						/*switch types.get(node) as! Type {
								case Class(classType):
								if classType.genericCache.length > 0 {
									//console.log('>>', type.name, type.genericCache.length)
									for knownParams in classType.genericCache {
										let known = knownParams.slice()
										known.shift()
										let cloned = Node.clone(project, node)
										//console.log(type.name, 'known:', known)
										console.log(classType.name, 'known:', known.length, Type.stringify(known[0]), Type.stringify(known[1]))

										var type = null as! Type?
										switch known[0] as! Type {
											case Unknown(handle): type = handle.value
											case Generic(_): // Not supposed to be typed TODO is this okay?
											case _: type = known[0]
										}

										if type == null {
											// TODO supposedly un-inferred `=[:]` and `=[]`
										} else {
											parents.set(cloned, cloned)
											//pushScope()
											fillModuleTypes(cloned, known, classType)
											//popScope()
										}
									}
								}
							}*/
					case TypeAlias(_):
					case Enum(_):
					case _:
						switch node {
							case Function(name, _):
								// console.log('func: ' + Node.stringify(node) + ' ' + name)
						}
						parents.set(node, self) // TODO module itself
						fill(node)
				}
			}

			popScope()
		}

		for info in project.moduleInfo {
			let nodes = info.nodes
			let self = Node.Module(info.path, info.nodes)
			pushScope()
			currentModule = info

			// Again for generics
			// TODO has no instances from global vars and exprs!
			for node in nodes {
				switch node {
					case Import(_):
					case Class(_):
						// Fill generic instances
						// TODO same for enums
						switch types.get(node) as! Type {
							case Class(classType):
								if classType.genericCache.length > 0 {

									let nullables = new Map<Type, Type>()

									fun unwrap(dataType: Type?): Type? {
										switch dataType as! Type {
											case Unknown(handle): return unwrap(handle.value)
											case UnknownNullable(handle):
												return unwrap(asNullable(handle.value))
											case Nullable(t):
												let kind = unwrap(t)
												if kind == null {
													return null
												}

												if let nullable = nullables.get(kind) {
													return nullable
												}

												let rewrapped = asNullable(unwrapUnknownAndNullable(kind))
												nullables.set(kind, rewrapped)
												return rewrapped

											case Generic(_): return null // Not supposed to be typed
											case _:
										}

										return dataType
									}

									// TODO could be optimized to not be a closure
									fun indexOf(instance: [Type], types: [[Type]]): Int {
										for i in types.length {
											var found = 0
											for t in types[i].length {
												if types[i][t] == instance[t] {
													found++
												}
											}

											if found == types[i].length {
												return i
											}
										}

										return -1
									}

									let genericCache = classType.genericCache.map(fun (knownParams: [Type]): [Type] {
											let known = knownParams.slice()
											// Remove the class itself (it was pushed here in the cache)
											known.shift()
											// Unwrap
											return known.map(unwrap)
										})
									// Clear unwrapped
									// TODO `as!` here is just for native target
									.filter(known => not (known as! [Type]).includes(null))
									// Deduplicate
									.filter((item, pos, self) => indexOf(item, self) == pos)
									// console.log(classType.name, classType.genericCache.length, genericCache.length)

									for knownParams in genericCache {
										let known = knownParams
										// .slice()
										// console.log(classType.name, 'known:', Type.stringify(known[0]))
										// , Type.stringify(known[1]))
										// known.shift()
										let cloned = Node.clone(project, node)
										// TODO ^ shouldn't it override instance.parent? Oh wait it is done at class typing code
										// console.log(classType.name, 'known:', known.length, Type.stringify(known[0]), Type.stringify(known[1]))

										// Check parameters to be ok
										var dataTypeVar = null as! Type?
										switch known[0] as! Type {
											case Unknown(handle): dataTypeVar = handle.value
											case UnknownNullable(handle): dataTypeVar = handle.value
											case Generic(_): // dataTypeVar = null // Not supposed to be typed TODO is this okay?
											case _: dataTypeVar = known[0]
										}

										if dataTypeVar == null {
											// TODO supposedly un-inferred `=[:]` and `=[]`
											// console.log(classType.name, 'ignored')
										} else {
											// console.log(classType.name, 'templated')
											parents.set(cloned, cloned)
											// pushScope()
											// TODO in future, this should be done on demand,
											// in the instantiation place, due to type inference
											// of function return types etc
											if known[0] == null {
												console.log('bad', known)
												throw known
											}
											// console.log('->> push', DataHelper.nameOf(cloned))
											// TODO while instantiating, new generic instances may be produced
											// IT MUST CONSTRUCT DEPENDENCY BEFORE SELF! PREEMPTIVE! CAUSE TYPES OF FIELDS!!!
											currentlyInstantiatingParams = known
											// TODO save/restore current
											currentlyInstantiating = cloned
											// instantiationsNode.push()
											// instantiationsParams.push()
											// instantiationsOf.push()

											// TODO delayedInstance = (toClone: Node, known: [Type], classType: ClassType) => Void {
											// TODO	let cloned = Node.clone(project, toClone) Cannot find variable with name `toClone`
											// TODO delayedInstance = (node: Node, known: [Type], classType: ClassType) => Void {
											fun delayed(node: Node, known: [Type], classType: ClassType): Void {
												let cloned = Node.clone(project, node)
												parents.set(cloned, cloned)

												// Save
												// TODO could be effect @mustRestoreXXX
												let _currentlyInstantiatingParams = currentlyInstantiatingParams
												let _currentlyInstantiating = currentlyInstantiating
												currentlyInstantiatingParams = known
												currentlyInstantiating = cloned

												// Fill
												var dataTypeVarTmp = null as! Type?
												switch known[0] as! Type {
													case Unknown(handle): dataTypeVarTmp = handle.value
													case UnknownNullable(handle): dataTypeVarTmp = handle.value
													case Generic(_): // dataTypeVarTmp = null // Not supposed to be typed TODO is this okay?
													case _: dataTypeVarTmp = known[0]
												}

												if dataTypeVarTmp != null {
													// console.log('->> fill', DataHelper.nameOf(cloned), known.map(Type.stringify))
													// console.log('@', project.mapDecorators.get(node), project.mapDecorators.get(cloned))
													fillModuleTypes(cloned, known, classType)
													if classType.parent == null {
														throw classType.name // TODO
													}
												} else {
													// console.log('->> known.length == 0', DataHelper.nameOf(cloned))
												}

												// Restore
												currentlyInstantiatingParams = _currentlyInstantiatingParams
												currentlyInstantiating = _currentlyInstantiating
											}

											// TODO wrong scope (module) while instantiation
											if not onlyTypeCheck {
												delayedInstance = delayed
												fillModuleTypes(cloned, known, classType)
											} else {
												delayedInstance = null
											}
											// console.log('--< pop', DataHelper.nameOf(cloned))
											// popScope() TODO
										}
									}
								}
						}

					case TypeAlias(_):
					case Enum(_):
					case _:
				}
			}

			popScope()
		}

		// console.log('--------------------> done generics')

		if failures.length > 0 {
			let errors = failures.slice()
			failures = []
			throw new CompilerErrors(errors)
		}

		// TODO
		// Fill initialization code at files roots
		// for (info in project.moduleInfo) {
		// for (file in info.nodes) {
		// pushScope()
		// for e in file {
		// switch e {
		// case Module(path, el):
		// case _: fill(e)
		// }
		// }
		// popScope()
		// }
		// }
	}

	fun find(name: String): Node? {
		var subj: Node? = null
		for i in scopes.length {
			subj = scopes[scopes.length - i - 1].get(name)
			if subj != null {
				break
			}
		}
		if subj == null {
			subj = findInNamespaceRoots(name)
		}
		return subj
	}

	/// Generates `Did you mean xxx?`
	// TODO use this for other errors
	fun proposeSimilar(names: [String], subject: String, what: String, similarTo: String? = null): String {
		if names.length == 0 {
			return 'No \(what) available for access'
		}

		if let similarTo = similarTo {
			let firstLetter = similarTo.charAt(0)
			names.sort((left, right) => left.startsWith(firstLetter) or left.includes(similarTo)? -1 : 0)
		}

		let ten = if names.length > 11 { // Yeah, 11, so it says "more whats" in plural
			names
			.slice(0, 10)
			// TODO some .wrap/.quote('<','>') built-in
			.map(name => '`' + name + '`')
			.join(', ') + ' and ' + (names.length - 10) + ' more ' + what
		} else {
			names.map(name => '`' + name + '`').join(', ')
		}

		// TODO limit `what` to `types` and `...whatever`
		// TODO if `types` must recommend only UpperCased ones
		// TODO ^ lower for otherwise
		let available = 'Available \(what) are: ' + ten
		let subject = subject.toLowerCase()
		let charSubj = subject.split('')
		var bestValue = 0
		var bestName = ''

		// TODO for name : index in _ _
		for name in names {
			let named = name.toLowerCase()
			if named.startsWith(subject) or subject.startsWith(named) or named.endsWith(subject) {
				return 'Did you mean `\(name)`?\n\n' + available
			}

			var index = 0
			var thisValue = 0
			// TODO for name : index in _ _
			for char in named.split('') {
				if char == charSubj[index] {
					thisValue++
				}
				index++
			}

			if thisValue > bestValue {
				bestValue = thisValue
				bestName = name
			}
		}

		// Avoid really useless proposals
		if bestValue > 2 {
			return 'Did you mean `\(bestName)`?\n\n' + available
		}

		return available
	}

	fun registerClassType(node: Node, callback: Any? = null, params: [Type]? = null, instanceOf: ClassType? = null): ClassType {
		let mod = currentModule
		currentModule = project.mapModules.get(node) ?? mod
		let registered = registerClassTypeWrapped(node, callback, params, instanceOf)
		currentModule = mod
		return registered
	}

	// `class T {}`
	fun registerClassTypeWrapped(node: Node, callback: Any? = null, knownParams: [Type]?, instanceOf: ClassType?): ClassType {
		if let cachedType = types.get(node) {
			switch cachedType as! Type {
				// Avoid typing if already typed
				case Class(t):
					if let setup = callback {
						setup(t)
					}
					return t
			}
		} else {
			let typeName = DataHelper.nameOf(node)

			// let type = new ClassType()

			let classType = switch typeName {
				// TODO respect "built in" decorator
				case 'Int':
					// console.log("case 'Int': ")
					typeIntClass
					// case 'Bool': typeBool = type.instantiate()
					// case 'Float': typeFloat = type.instantiate()
					// case 'String': typeString = type.instantiate()
				case 'Array':
					// console.log("case 'Array': ")
					knownParams != null? new ClassType() : typeArray
					// typeArray
					// case 'Map': typeMap = type
				case 'Any':
					// console.log("case 'Any': ")
					typeAnyClass
					// typeAny = type.instantiate()
					// nodeAny = node
					// case 'Void': typeVoid = type.instantiate()
				case _:
					new ClassType()
			}

			let _thisType = thisType
			let _thisNode = thisNode
			// thisType = Type.ClassInstance(type, [])

			// TODO not simply instantiate, must be filled with generic dummies
			thisType = knownParams != null? classType.instantiateGeneric(knownParams) : classType.instantiate()
			// switch thisType {
			// case Class(_): fail('not instance ' + Type.stringify(thisType), node)
			// case ClassInstance(t, g):
			// if t.name == 'Array', g[0] == null {
			// fail('@@!instance ' + Type.stringify(thisType), node)
			// }
			// }
			// if knownParams != null, (knownParams??[]).length > 0, (knownParams??[])[0] != null {
			// console.log('thisType = ', Type.stringify(thisType), (knownParams??[]).map(t => t?Type.stringify(t): 'null'))
			// }
			thisNode = node
			classType.parent = node
			classType.name = typeName

			if let instanceOf = instanceOf, knownParams != null {
				// TODO better detection
				classType.instanceOf = instanceOf
				classType.instanceParams = knownParams
				instanceOf.instances.push(classType)
			}

			types.set(node, Type.Class(classType))
			// console.log('thisType =>', thisType)
			// console.log('thisType =', Type.stringify(thisType))

			// Solve race condition
			// TODO do only for std lib
			if let setup = callback {
				setup(classType)
			}

			// TODO detect only in root module
			// Probably create them upfront and assign definition later?
			switch classType.name {
				case 'Int': // typeInt = type.instantiate() TODO
				case 'Bool': typeBool = classType.instantiate()
				case 'Float':
					typeFloat = classType.instantiate()
					typeNullFloat = asNullable(typeFloat)

				case 'Float32':
					typeFloat32 = classType.instantiate()
					typeNullFloat32 = asNullable(typeFloat32)

				case 'String': typeString = classType.instantiate()
				case 'Array':
					// TODO protect the same way whole `switch`
					if knownParams == null {
						typeArray = classType
					}
				case 'Map':
					if knownParams == null {
						typeMap = classType
					}
				case 'Any':
					nodeAny = node
				case 'Void': typeVoid = classType.instantiate()

				case 'UInt8': typeUInt8 = classType.instantiate()
				case 'UInt16': typeUInt16 = classType.instantiate()
				case 'UInt32': typeUInt32 = classType.instantiate()
				case 'UInt64':
					typeUInt64 = classType.instantiate()
					typeNullUInt64 = asNullable(typeUInt64)

				case 'SizeOfPointer': typeSizeOfPointer = classType.instantiate()
				case 'SignedSizeOfPointer': typeSignedSizeOfPointer = classType.instantiate()
				case 'Int8': typeInt8 = classType.instantiate()
				case 'Int16': typeInt16 = classType.instantiate()
				case 'Int32': typeInt32 = classType.instantiate()
				case 'Int64': typeInt64 = classType.instantiate()

				case 'BigInt': typeBigInt = classType.instantiate()
			}

			let classDecorators = project.mapDecorators.get(node)
			fun getRename(f: Node, name: String, globalDecorators: [Decorator]): String? {
				let atts = project.mapDecorators.get(f)
				let renamingStrategy = getRenamingStrategy(atts) ?? getRenamingStrategy(globalDecorators)

				if let native = DataHelper.getDecorator(atts, 'rename') {
					// TODO `@asIs` disallows `@rename`
					if native.values.length != 1 {
						// TODO wrap `throw` into `fail`
						throw '@rename takes one string argument'
					}
					if native != null { switch native.values[0] {
							case String(s): return s
							case _: throw '@rename takes string as argument'
						} }
				} else {
					switch renamingStrategy {
						case AsTitleCase: return Hint.toTitleCase(name)
						case AsIs: return name
						case null:
					}
				}

				return null
			}

			switch node {
				case Class(t, extend, implement, f, external, classKind):
					classType.kind = classKind
					classType.external = external

					switch t {
						case ParametricType(name, params):
							classType.genericParams.push(DataHelper.extractTypeName(params[0]))
							let names = classType.genericParams
							for i in 1 ... params.length {
								let name = DataHelper.extractTypeName(params[i])
								if names.includes(name) {
									fail('Parameter `\(name)` already exists in `<T, ...>`', node)
								}
								names.push(name)
							}
					}

					if let ext = extend {
						// TODO cannot extend self or recursively in circle
						// TODO limit nesting depth
						classType.extend = toType(ext, node)
					}
					for impl in implement {
						// TODO
						classType.implement.push(toType(impl, node))
					}
					pushScope()

					var genericParamIndex = 0
					let genericStubs: [Type] = []
					for genericParam in classType.genericParams {
						addScopeType(genericParam, typeAny)
						if let knownParams = knownParams {
							addScopeType(genericParam, knownParams[genericParamIndex])
						} else {
							let stub = Type.Generic(genericParamIndex, genericParam)
							genericStubs.push(stub) // TODO
							addScopeType(genericParam, stub)
						}
						genericParamIndex++
					}

					if knownParams == null, classType.genericParams.length > 0 {
						// thisType = type.instantiateGeneric(genericStubs) // TODO
					}

					// Fill scopes
					for field in f {
						switch field {
							case Function(name, _):
								if classType.fieldNames.includes(name) {
									fail('Field `\(name)` already exists', field)
								}
								classType.fieldNames.push(name)
								if name == 'new' {
									classType.constructor = classType.fieldNames.length - 1
								} else {
									classType.fieldRenames[classType.fieldNames.length - 1] = getRename(field, name, classDecorators)
								}
								classType.fields.set(name, ClassTypeField.Method)
								addScope(name, field)
								if project.mapStatic.get(field) == true {
									classType.fieldStatic[classType.fieldNames.length - 1] = true
								}
							case Var(name, t, e, _):
								if classType.fieldNames.includes(name) {
									fail('Field `\(name)` already exists', field)
								}
								classType.fieldNames.push(name)
								classType.fieldInitialized[classType.fieldNames.length - 1] = false
								classType.fieldRenames[classType.fieldNames.length - 1] = getRename(field, name, classDecorators)
								addScope(name, field)
								if project.mapStatic.get(field) == true {
									classType.fieldStatic[classType.fieldNames.length - 1] = true
								}
							case Property(field, _, _):
								switch field {
									case Var(name, _):
										if classType.fieldNames.includes(name) {
											fail('Field `\(name)` already exists', field)
										}
										classType.fieldNames.push(name)
										addScope(name, field)
									case _:
										fail('Field unrecognized', field)
								}
							case _:
								fail('Wrong class field format', field)
						}
						parents.set(field, node)
					}

					// Fill fields with non-ambiguous types
					for field in f { switch field {
							// `var\let a: known T`
							case Var(name, t, e, const):
								if let t = t {
									types.set(field, toType(t, field))
								}

								// `function a(args with known types or no args): known ret type`
							case Function(name, expr, vars, rettype, _, variadic):
								// console.log('class fun', name, type.name)
								if let rettype = rettype {
									types.set(
										field,
										Type.Function(varTypes(vars), toType(rettype, field), variadic)
									)
								}

								// TODO ensure in parser `new` has no return type
								if name == 'new-TODO#' {
									types.set(
										field,
										Type.Function(varTypes(vars), toType(t, field), variadic)
									)
								}

							case Property(f, _, _):
								switch f {
									case Var(name, t, e, const):
										if external, e != null {
											fail('External class field `var \(name)` cannot have expression', field)
										}
										let _insideClassMethod = insideClassMethod
										insideClassMethod = true
										if e != null {
											fillExpression(e)
										}
										insideClassMethod = _insideClassMethod
										mixVarTypes(t, e, f)
										classType.fieldInitialized[classType.fieldNames.indexOf(name)] = true
										if types.get(f) == null {
											fail('Property `\(name)` initialized, but got no type ' + e, field)
										}
										types.set(field, types.get(f))
								}
						} }

					// Fill expressions
					for field in f { switch field {
							// Instance method or static method
						case Function(name, expr, vars, rettype, _, variadic):
							// console.log('class fun [full]', name, type.name)
							if name == 'new' {
								// TODO this is wrong
								// type.constructor = type.fieldNames.length - 1
							}

							let isStatic = project.mapStatic.get(field) == true

							if external, expr != null {
								if name == 'new' {
									fail('External class constructor `new ()` cannot have a body `{}`', field)
								} else {
									let prefix = isStatic ? 'static ' : ''
									fail('External class field `\(prefix)function \(name)` cannot have a body `{}`', field)
								}
							}

							let _insideClassMethod = insideClassMethod
							let _allowSuper = allowSuper
							insideClassMethod = not isStatic
							allowSuper = (extend != null) and not isStatic

							if not external {
								// TODO
								let rettype = name == 'new'? t : rettype
								fillFunction(field, expr, vars, rettype)
							}

							if external, types.get(field) == null {
								types.set(
									field,
									Type.Function(
										varTypes(vars),
										// TODO is `rettype == null` valid for externals?
										rettype != null? toType(rettype, field) : typeVoid,
										variadic
									)
								)
							}

							insideClassMethod = _insideClassMethod
							allowSuper = _allowSuper

							// Field of `var` or `let`
						case Var(name, t, e, const):
							let isStatic = project.mapStatic.get(field) == true
							if external, e != null {
								let prefix = isStatic ? 'static ' : ''
								fail('External class field `\(prefix)var \(name)` cannot have `= value`', field)
							}
							let _insideClassMethod = insideClassMethod
							insideClassMethod = not isStatic
							if e != null {
								fillExpression(e)
							}
							insideClassMethod = _insideClassMethod
							mixVarTypes(t, e, field)
							classType.fieldInitialized[classType.fieldNames.indexOf(name)] = true
							if types.get(field) == null {
								let prefix = isStatic ? 'static ' : ''
								// TODO internal error?
								fail('Field `\(prefix)var \(name)` initialized, but got no type ' + e, field)
							}

							// The thing with getters and setters
						case Property(f, _, _):
							switch f {
								case Var(name, t, e, const):
									if external, e != null {
										fail('External class field `var \(name)` cannot have expression', field)
									}
									let _insideClassMethod = insideClassMethod
									insideClassMethod = true
									if e != null {
										fillExpression(e)
									}
									insideClassMethod = _insideClassMethod
									mixVarTypes(t, e, f)
									classType.fieldInitialized[classType.fieldNames.indexOf(name)] = true
									if types.get(f) == null {
										fail('Property `\(name)` initialized, but got no type ' + e, field)
									}
									types.set(field, types.get(f))
							}

						case _:
							fail('Wrong class field format', node)
						} }

					popScope()
				case _:
					fail('ClassType expects (declare) class node, but got ' + node, node)
			}

			thisType = _thisType
			thisNode = _thisNode
			return classType
		}
	}

	// `enum T {}`
	fun registerEnumType(node: Node): EnumType {
		if let cachedType = types.get(node) {
			switch cachedType as! Type {
				// Avoid typing if already typed
				case Enum(t): return t
			}
		} else {
			let enumType = new EnumType()
			enumType.parent = node
			enumType.name = DataHelper.nameOf(node)
			// console.log('registerEnumType ' + type.name)
			types.set(node, Type.Enum(enumType))

			switch node {
				case Enum(t, f, valuesType, extend):
					pushScope()
					if let valuesType = valuesType {
						enumType.fieldsTypeSimple = toType(valuesType, node)
					}

					if
						enumType.fieldsTypeSimple != null,
						enumType.fieldsTypeSimple != typeString,
						enumType.fieldsTypeSimple != typeInt,

						// Meta
						enumType.fieldsTypeSimple != typeInt8,
						enumType.fieldsTypeSimple != typeInt16,
						enumType.fieldsTypeSimple != typeInt32,
						enumType.fieldsTypeSimple != typeInt64,

						enumType.fieldsTypeSimple != typeUInt8,
						enumType.fieldsTypeSimple != typeUInt16,
						enumType.fieldsTypeSimple != typeUInt32,
						enumType.fieldsTypeSimple != typeUInt64
					{
						fail('Simple enums may be only of integer and string types', node)
					}

					if f.length == 0, extend == null {
						fail('Enum `\(enumType.name)` must have at least one value `enum \(enumType.name) { Value }`', node)
						// TODO autocomplete and hint `{ TODO }` for placeholder tag
					}

					// Check for incompatible tag format and fill scopes
					let numbers: [Int] = []
					let strings: [String] = []
					let names: [String] = []

					for field in f {
						switch field {
							// `enum E { A }`
							case NodeTypeValue(t): switch t {
									case Type(name):
										if (enumType.fieldNames.includes(name)) {
											// TODO `throw fail` makes no sense and must error on throwing `Void`
											throw fail('Field `\(name)` already exists', node)
										}
										enumType.fieldNames.push(name)
										// TODO refactor `length - 1`
										// TODO combine arrays into single `[class EnumConstructorField]`
										enumType.fieldEnumConstructor[enumType.fieldNames.length - 1] = true
										enumType.tagBindVars[enumType.fieldNames.length - 1] = []
										enumType.tagBindVarsNames[enumType.fieldNames.length - 1] = []
										enumType.tagBindVarsTypes[enumType.fieldNames.length - 1] = []
										enumType.fieldType[enumType.fieldNames.length - 1] = Type.EnumInstance(enumType, enumType.fieldNames.length - 1)
									case _:
										fail('Wrong enum constructor format, should be `Name`', node)
								}

								// `enum E { A(b C) }`
							case Call(e, args, argNames):
								if valuesType != null {
									throw fail('Cannot use `Value(args)` format for simple enum', node)
								}
								switch e {
									case NodeTypeValue(t): switch t {
											case Type(name):
												if enumType.fieldNames.includes(name) {
													throw fail('Field `\(name)` already exists', e)
												}
												enumType.fieldNames.push(name)
												enumType.fieldEnumConstructor[enumType.fieldNames.length - 1] = true
												enumType.fieldType[enumType.fieldNames.length - 1] = Type.EnumConstructor(enumType, enumType.fieldNames.length - 1)
												// TODO disallow just `= []`
												let tagBindVars = []
												enumType.tagBindVars[enumType.fieldNames.length - 1] = tagBindVars
												let tagBindVarsTypes: [Type] = []
												enumType.tagBindVarsTypes[enumType.fieldNames.length - 1] = tagBindVarsTypes
												let tagBindVarsNames: [String] = []
												enumType.tagBindVarsNames[enumType.fieldNames.length - 1] = tagBindVarsNames
												enumType.tagBindVarsNodes[enumType.fieldNames.length - 1] = args

												if args.length == 0 {
													// TODO fix this `: ` and other messages
													fail('Enum constructor expects more than zero arguments `(value: Type)`', e)
												}

												for i in args.length {
													if argNames[i] == null {
														fail('Enum constructor arguments should have names `E(name1: T, name2: T)', args[i])
													}

													let nodeType = nodeToNodeType(args[i])
													tagBindVars[i] = nodeType
													// console.log('tag', args[i])
													// TODO late-binding
													// tagBindVarsTypes[i] = toType(nodeType, args[i])

													if tagBindVarsNames.includes(argNames[i]) {
														fail('Enum constructor argument `\(argNames[i])` already exists', args[i])
													}

													tagBindVarsNames[i] = argNames[i]
												}
											case _:
												fail('Wrong enum constructor format, should be `Name(value: T)`', e)
										}
								}

								// `enum E { A = b }`
								// TODO allow BigInt as possible enum value type?
							case Binop(a, op, b):
								if op != Token.Assign {
									fail('Should use `Value = value` not `Value \(Token.stringify(op)) value` format for enum tag value', node)
								}
								if valuesType == null {
									fail('Cannot use `Value = value` format for complex enum', node)
								}

								// TODO move elsewhere
								// TODO for constants, compatibility factors
								// (like `42` being compatible with `i16` and `i8` and `u16` etc)
								// can be pre-calculated in the Parser
								// (would require some Node tags to be private and build-able only with special methods)
								let numberable = [
									typeInt,
									typeInt32,
									typeInt16,
									typeInt8,
									typeInt64,
									typeUInt32,
									typeUInt16,
									typeUInt8,
									typeUInt64
								]

								switch a {
									case NodeTypeValue(t): switch t {
											case Type(name):
												if enumType.fieldNames.includes(name) {
													fail('Field `\(name)` already exists', a)
												}
												enumType.fieldNames.push(name)
												enumType.fieldEnumConstructor[enumType.fieldNames.length - 1] = true
												switch b {
													case NodeTypeValue(t): switch t {
															case Type(name):
																let at = names.indexOf(name)
																if at == -1 {
																	fail('Value with name `\(name)` not found above current value', b)
																}

																// Ok
																// TODO implement at code gen side
															case _:
																fail('Wrong enum constructor format, should be `Name = value`', b)
														}

													case MetaInt(number, kind):
														// TODO infer i32/etc from constant
														// TODO validate PRECISION compatibility
														if not numberable.includes(enumType.fieldsTypeSimple)
														{
															fail('`\(name) = value` expects constant value of type `\(Type.stringify(enumType.fieldsTypeSimple))`', b)
														}

														if let at = strings.indexOf('' + number), at != -1 {
															let named = names[at]
															fail('Combination `\(name) = \(number)` already defined as `\(named) = \(number)`, try to assign same value as `\(name) = \(named)` or set new unique value', b)
														}

														// NOTE string is used here, cause BigInt not fit into Int
														strings.push('' + number)
														names.push(name)

													case Int(number):
														// TODO infer i32/etc from constant
														// TODO validate PRECISION compatibility
														if not numberable.includes(enumType.fieldsTypeSimple) {
															fail('`\(name) = value` expects constant value of type `\(Type.stringify(enumType.fieldsTypeSimple))`', b)
														}

														if let at = numbers.indexOf(number), at != -1 {
															let named = names[at]
															fail('Combination `\(name) = \(number)` already defined as `\(named) = \(number)`, try to assign same value as `\(name) = \(named)` or set new unique value', b)
														}

														numbers.push(number)
														names.push(name)

													case String(string):
														if enumType.fieldsTypeSimple != typeString {
															fail('`\(name) = value` expects constant value of type `\(Type.stringify(enumType.fieldsTypeSimple))`', b)
														}
														// TODO non-constant values
														// TODO other types

														if let at = strings.indexOf(string), at != -1 {
															let named = names[at]
															fail('Combination `\(name) = \(string)` already defined as `\(named) = \(string)`, try to assign same value as `\(name) = \(named)` or set new unique value', b)
														}

														strings.push(string)
														names.push(name)

													case _:
														fail('Wrong enum constructor format, should be `Name = value`', b)
												}
												// fillExpression(b)
												// TODO unity to `ClassType` and use separate field for enum constructors, not `fieldNames`
												enumType.fieldType[enumType.fieldNames.length - 1] = Type.EnumInstance(enumType, enumType.fieldNames.length - 1)
										}
								}

								// `enum E { a }`
							case Ident(name):
								fail('Cannot use lowercase `\(name)` format for enum values', node)

							// `enum E { static fun ... }` or `enum E { static var ... }`
						case Function(name, _):
							if enumType.fieldNames.includes(name) {
								fail('Field `\(name)` already exists', node)
							}
							enumType.fieldNames.push(name)
							if project.mapStatic.get(field) == true {
								enumType.fieldStatic[enumType.fieldNames.length - 1] = true
							}
							addScope(name, field)
						case Var(name, _, _, _):
							if enumType.fieldNames.includes(name) {
								fail('Field `\(name)` already exists', node)
							}
							enumType.fieldNames.push(name)
							if project.mapStatic.get(field) == true {
								enumType.fieldStatic[enumType.fieldNames.length - 1] = true
							}
							addScope(name, field)
						case _:
							fail('Wrong enum field format', field)
						}

						parents.set(field, node)
					}

					// Fill expressions
					for field in f { switch field {
							case Function(name, expr, vars, rettype, _, variadic):
								let isStatic = project.mapStatic.get(field) == true
								let _insideClassMethod = insideClassMethod
								insideClassMethod = not isStatic

								// This weird hack, because of race condition
                                // if function called within self
								if let rettype = rettype {
									types.set(field, Type.Function(varTypes(vars), toType(rettype, field), variadic))
								} else {
									types.set(field, Type.Function(varTypes(vars), typeVoid, variadic))
								}

								fillFunction(field, expr, vars, rettype)
								insideClassMethod = _insideClassMethod
								if types.get(field) == null {
									// TODO make `Map.set(k)` the `k` non-nullable y default to avoid those weird checks
									fail('Function get no type: enum ' + DataHelper.nameOf(node) + ' fun ' + name, field)
								}
							case Var(name, t, e, const):
								if project.mapStatic.get(field) == true {
									if e != null {
										fillExpression(e)
									}
									mixVarTypes(t, e, field)
								}
							case NodeTypeValue(_): // Ok
							case Call(_): // Ok
							case Binop(_): // TODO validate them
							case _:
								fail('Unknown enum field format', field)
					} }
					popScope()
				case _:
					fail('EnumType expects (declare) enum node, but got ' + node, node)
			}

			return enumType
		}
	}

	static let never = '. This should never happen. Probably incomplete feature was used. Ping a compiler developer with a code sample.'
	// static let/var failures: [{msg: String, node: Node?}] = []
	// TODO ^ push withinStaticFun = true/pop (crashed at runtime cause non-static accessed from static or vise-versa)
	var failures: [{ msg: String, node: Node? }] = []

	// TODO node: Node = null error
	fun fail(msg: String, node: Node = null): Void {
		failNonFatal(msg, node)

		// TODO wrong kind of error for trailing `,` `if let currentlyInstantiating = currentlyInstantiating, {`
		if let currentlyInstantiating = currentlyInstantiating, let currentlyInstantiatingParams = currentlyInstantiatingParams {
			let name = DataHelper.nameOf(currentlyInstantiating)
			let msg =
				'While instantiating `'
			+ name
			+ '<'
			+ currentlyInstantiatingParams.map(param => Type.stringify(param)).join(', ')
			+ '>`'
			failNonFatal(msg, node)
			// TODO could be clickable links in vs hexa too on hovers
			failNonFatal('Type `\(name)` is defined here', currentlyInstantiating)
		}

		let errors = failures.slice()
		failures = []
		// TODO failures is `let` not `var`!
		throw new CompilerErrors(errors)
	}

	fun failNonFatal(msg: String, node: Node = null): Void {
		let t: Int = project.data.get // TODO invalid
		let data = project.data.get(node)
		if let data = data {
			failures.push(new CompilerError(Fail.TyperError, msg, data.line, data.column, data.fileName))
		} else {
			failures.push(new CompilerError(Fail.TyperError, msg, 1, 1, "unknown.hexa"))
		}
	}

	fun positionOf(node: Node) {
		let data = project.data.get(node)
		as! NodeData // TODO
		if data == null {
			return "[Unknown]: "
		}
		return "[" + data.fileName + ":" + data.line + ":" + data.column + "]: "
	}

	/// Produces type `[T]` from same looking node, and other cases
	static fun nodeToNodeType(node: Node): NodeType { switch node {
			case Array(el):
				if el.length > 1 {
					fail('Array type `[T]` cannot have more than 1 parameter `T`', el[1])
				}
				return NodeType.ParametricType("Array", [nodeToNodeType(el[0])], null)
			case NodeTypeValue(t):
				return t
			case Object(names, el):
				// var eee: Node = null as! Node
				// let xxx = [for e in el {
				// eee = e
				// 123
				// }] // TODO

				let types = [for e in el nodeToNodeType(e)]
				return NodeType.Object(names, types)
			case _:
				fail('Cannot nodeToNodeType of ' + Node.stringify(node), node)
		} }

	// Takes only nodes valid for `module { node }`
	fun nameOfModuleItem(node: Node): String {
		switch node {
			case Var(name, _): return name
			case Function(name, _):
				if let named = name {
					return named
				} else {
					throw 'Module function should have a name'
				}
			case Class(t, _): switch t {
					case Type(name): return name
					case ParametricType(name): return name
				}
			case Enum(t, _): switch t {
					case Type(name): return name
					case ParametricType(name): return name
				}
			case TypeAlias(t, _): switch t {
					case Type(name): return name
					case ParametricType(name): return name
				}
			case _: fail('Improper module item format, wrap expressions as `{ expressions }`', node)
		}
	}

	var currentModule: Module = new Module()
	fun findInNamespaceRoots(name: String): Node? {
		if let node = currentModule.imported.get(name) {
			return node
		}

		if let node = currentModule.exported.get(name) {
			return node
		}

		if let node = project.globals.get(name) {
			return node
		}

		return null
	}

	// Scopes
	private let scopes: [[String : Node]] = [[:]]
	private let scopeTypes: [[String : Type]] = [[:]]
	let parents: [Node : Node] = [:]

	private fun pushScope(): Void {
		scopes.push([:])
		scopeTypes.push([:])
	}

	private fun popScope(): Void {
		scopes.pop()
		scopeTypes.pop()
	}

	private fun addScope(name: String, node: Node): Void {
		scopes[scopes.length - 1].set(name, node)
	}

	private fun addScopeType(name: String, ofType: Type): Void {
		scopeTypes[scopeTypes.length - 1].set(name, ofType)
	}

	// Types
	// private let types: [String : Type] = [:]
	private let types: [Node : Type] = [:]
	private var typeString: Type? = null
	private var typeIntClass: ClassType = new ClassType()
	private var typeInt: Type = typeIntClass.instantiate()
	private var typeBool: Type? = null
	private var typeArray: ClassType = new ClassType() // Type instantiators
	private var typeMap: ClassType = null as! ClassType // Type instantiators
	private var typeAnyClass: ClassType = new ClassType()
	private var typeAny: Type = typeAnyClass.instantiate()
	private var nodeAny: Node? = null
	private var typeVoid: Type? = null
	private var namespaces: [String : Node] = [:]
	private var currentlyInstantiating: Node? = null
	private var currentlyInstantiatingParams: [Type]? = null
	static var delayedInstance: (toClone: Node, known: [Type], classType: ClassType) => Void = null

	// Meta
	// TODO those fields should be public actually
	private var typeBigInt: Type? = null
	private var typeInt32: Type? = null
	private var typeInt64: Type? = null
	private var typeInt16: Type? = null
	private var typeInt8: Type? = null
	private var typeUInt32: Type? = null
	private var typeUInt64: Type? = null
	private var typeSizeOfPointer: Type? = null
	private var typeSignedSizeOfPointer: Type? = null
	private var typeNullUInt64: Type? = null
	private var typeUInt16: Type? = null
	private var typeUInt8: Type? = null
	private var typeFloat: Type? = null
	private var typeNullFloat: Type? = null
	private var typeFloat32: Type? = null
	private var typeNullFloat32: Type? = null

	// Stack
	// TODO turn them into /// comments
	var functionAllowedToThrow = false // `true` if `@noThrow` is *not* set
	var functionThrows = false // `throw` is happened
	var insideTry = false // `try { insideTry } catch ... { ... }`
	var insideFunction = false // `function () { insideFunction }`
	var insideAsync = false
	var allowBreakAndContinue = false // Used in loops
	var functionReturnsAType: Type? = null // `: T` is happened, or infer if `null`
	var functionActuallyReturns: Bool = false // `return something` is actually happened
	var insideClassMethod = false // `class T { function () { insideClassMethod } }` non-static!
	var allowSuper = false // `class T extends C { function () { super() } }` non-static!
	var thisType: Type = null as! Type // Current class
	var thisNode: Node = null as! Node // Current class node

	// `var to = from`
	fun unify(to: Type, fromValue: Type, node: Node): Type {
		// Short path
		if to == fromValue {
			return to
		}

		if to == typeAny {
			return to
		}

		if fromValue == typeVoid {
			fail('Incompatible types `\(Type.stringify(to))` and non-value type `Void`', node)
		}

		// `Int` is assignable to `Float`
		if to == typeFloat, fromValue == typeInt {
			return typeFloat
		}

		// Nullability
		fun isNullable(t: Type): Bool {
			switch t {
				case UnknownNullable(_): return true
				case Nullable(_): return true
			}
			return false
		}

		fun instanceOfClass(t: Type): ClassType? {
			switch Type.unwrapNullable(t) {
				case ClassInstance(t): return t
				case Class(t):
					fail('Cannot take classes `class \(t.name)` as values', node)
					// TODO case Enum(t):
					// fail('Cannot take enums `enum \(t.name)` as values', node)
			}
			return null
		}

		fun instanceOfEnum(t: Type): EnumType? {
			switch Type.unwrapNullable(t) {
				case EnumInstance(t, _): return t
				case Enum(t): return t
			}
			return null
		}

		// Fill unknown nullable
		switch to {
			case UnknownNullable(handle):
				if (handle.value == null) {
					handle.value = switch fromValue {
						case UnknownNullable(handle): handle.value
						case Nullable(t): t
						case _: fromValue
					}
				}
		}

		var toNullable = isNullable(to)
		var fromNullable = isNullable(fromValue)

		// if (fromNullable, !toNullable, Type.stringify)
		// fail('Cannot assign nullable type `\(Type.stringify(fromValue))` to non-nullable `\(Type.stringify(to))`', node)

		var toInstance = instanceOfClass(to)
		var fromInstance = instanceOfClass(fromValue)

		var toEnumInstance = instanceOfEnum(to)
		var fromEnumInstance = instanceOfEnum(fromValue)
		// if (toEnumInstance == null || fromEnumInstance == null) {
		// return to ?? fromValue
		// } TODO

		if
			(toInstance == null and toEnumInstance == null)
			or
			(fromInstance == null and fromEnumInstance == null)
		{
			return to ?? fromValue
		}

		if toInstance != fromInstance, Type.unwrapNullable(to) != typeAny, Type.unwrapNullable(fromValue) != typeAny {
			// Cannot assign signed to unsigned
			// TODO OK by known positive values and zero `: UInt64 = 123`
			// TODO same for comparisons `if UInt64 == 0 {}`

			// Float is 64-bit signed
			// `UInt64` & `Int64` are too large or too precise
			if to == typeFloat, [
					typeUInt32,
					typeUInt16,
					typeUInt8,

					typeInt32,
					typeInt16,
					typeInt8,

					typeFloat32,
					typeInt
				].includes(fromValue) {
				return to // Larger type
			}

			if to == typeFloat32, [
					typeUInt16,
					typeUInt8,

					typeInt16,
					typeInt8
				].includes(fromValue) {
				return to // Larger type
			}

			if to == typeUInt16, [
					typeUInt8 // TODO just one case? is it useful?
				].includes(fromValue) {
				return to // Larger type
			}

			if to == typeInt16, [
					typeUInt8,
					typeInt8
				].includes(fromValue) {
				return to // Larger type
			}

			if to == typeUInt64, [
					typeUInt8,
					typeUInt16,
					typeUInt32
				].includes(fromValue) {
				return to // Larger type
			}

			if to == typeInt64, fromValue == typeInt {
				return to // Larger type
			}

			if to == typeInt64, fromValue == typeInt32 {
				return to // Larger type
			}

			if to == typeInt64, fromValue == typeUInt32 {
				return to // Larger type
			}

			if to == typeInt64, [
					typeInt8,
					typeInt16,
					typeInt32,

					typeUInt8,
					typeUInt16,
					typeUInt32
				].includes(fromValue) {
				return to // Larger type
			}

			if to == typeUInt64, fromValue == typeUInt32 {
				return to // Larger type
			}

			if to == typeUInt32, fromValue == typeUInt8 {
				return to // Larger type
			}

			if to == typeUInt32, fromValue == typeUInt16 {
				return to // Larger type
			}

			if to == typeInt32 or to == typeInt, [
					typeUInt8,
					typeInt8,

					typeUInt16,
					typeInt16,

					typeInt
				].includes(fromValue) {
				return to // Larger type
			}

			if to == typeInt32, fromValue == typeUInt16 {
				return to // Larger type
			}

			if (to == typeInt32 and fromValue == typeInt) or (to == typeInt and fromValue == typeInt32) {
				return typeInt32 // More specific
			}

			// TODO should check for 32-bits limit for 32-bit platforms?
			if to == typeSignedSizeOfPointer,
				fromValue == typeInt
				or fromValue == typeInt64
				or fromValue == typeInt32
				or fromValue == typeInt16
				or fromValue == typeInt8
				or fromValue == typeUInt32
				or fromValue == typeUInt16
				or fromValue == typeUInt8
				// NOTE not u64
			{
				return to // Safe to do so
			}

			if to == typeSizeOfPointer,
				fromValue == typeUInt64
				or fromValue == typeUInt32
				or fromValue == typeUInt16
				or fromValue == typeUInt8
			{
				return to // Safe to do so
			}

			// Here we try to infer type of a constant expression
			switch node {
				case Int(value):
					if value == 0 and [
							typeInt64,
							typeInt32,
							typeInt16,
							typeInt8,

							typeUInt64,
							typeUInt32,
							typeUInt16,
							typeUInt8,

							typeInt
						].includes(fromValue) {
						return to
					}

					// TODO more cases
					if to == typeUInt8, value >= 0, value < 256 {
						// TODO override type of node or node itself in normalizer
						// so code generator generates proper int
						return to
					}

					if to == typeUInt16, value >= 0, value < 65536 {
						return to
					}

					if to == typeUInt32, value >= 0, value < 4294967296u64 {
						return to
					}

					if to == typeUInt64, value >= 0, value < 18446744073709551616n {
						return to
					}

					// TODO should check for 32-bits limit for 32-bit platforms?
					if to == typeSizeOfPointer, value >= 0 {
						return to
					}

					if to == typeSignedSizeOfPointer {
						return to
					}
			}

			let toName = Type.primaryName(to)
			let fromName = Type.primaryName(fromValue)

			if toName == 'ArrayByValue', (fromName == 'Array' or fromName == 'String') {
				// TODO better checks
				return to
			}

			if toName == 'ConstPointer', fromName == 'Pointer' {
				// TODO better checks
				return to // More specific
			}

			/* TODO switch node {
				case Int(value):
					if to == typeUInt64 {
						// console.log('Int->', typeUInt64 == to)
					}
					if value >= 0, value < 18446744073709551616n {
						// console.log('Int->', value)
					}
					// console.log('Int->', node, to, 'value=', value)
			} */
			switch fromValue {
				case ClassInstance(classType, generic):
					// Infer `= []`
					switch to {
						case ClassInstance(typeTo, genericTo):
							// Compare interfaces
							if typeTo.kind == ClassKind.Interface {
								if classType.implement.includes(to) {
									return to
								}
							}

							if
								toName == 'ConstArrayPointer',
								fromName == 'ArrayPointer',
								generic[0] == genericTo[0]
							{
								return to // Can cast to const
							}

							// TODO better comparison, not by name
							if classType.name == typeTo.name {
								// inferNullType(generic[0], genericTo[0])

								// if isNullable(generic[0]), not isNullable(genericTo[0]) {
								// fail('Value `\(Type.stringify(fromValue))` contains nullable generic parameter, while `\(Type.stringify(to))` does not', node)
								// }

								let a: [String] = [null] // TODO to tests
								let a: [String] = new Array<String?>()
								let a: [String] = [null as! String?]

								switch generic[0] {
									case Unknown(handle):
										// if unwrapUnknownAndNullable(genericTo[0]) == null {
										// fail('Cannot infer type of value `\(Type.stringify(fromValue))` due to incomplete type of destination `\(Type.stringify(to))`', node)
										// }

										// console.log('wohooo???', Type.stringify(fromValue), Type.stringify(to))
										// TODO "infinite" loop here
										// handle.value = unwrapUnknownAndNullable(genericTo[0])
										// generic[0] = unwrapUnknownAndNullable(genericTo[0])
										// generic[0] = genericTo[0]
										// console.log('wohooo!!!', Type.stringify(fromValue), Type.stringify(to))
										return to
										// `[null]`
									case UnknownNullable(handle):
										// if not isNullable(genericTo[0]) {
										// fail('Value `\(Type.stringify(fromValue))` contains nullable generic parameter, while `\(Type.stringify(to))` does not', node)
										// }

										//
										// handle.value = unwrapUnknownAndNullable(genericTo[0])
										// if handle.value != null {
										// console.log('wohooo')
										// } else {
										// console.log('not wohooo')
										// }
										return to
									case _:
										if let instanceOf = classType.instanceOf {
											return instanceOf.instantiateGeneric(genericTo)
										}

										if let instanceOf = typeTo.instanceOf {
											return instanceOf.instantiateGeneric(genericTo)
										}
										// if type.name == 'Array' {
										// return typeArray.instantiateGeneric(genericTo)
										// } else {
										// console.log('type.instanceOf', type.name, type.instanceOf, typeTo.instanceOf)
										// let instanceOf = type.instanceOf as! ClassType
										// return instanceOf.instantiateGeneric(genericTo)
										// }
								}
							}
					}

					// TODO respect generics
					var extended = classType.extend
					var depth = 0

					while true {
						depth++
						if depth > 100 {
							fail('Inheritance depth is too large', node)
							break
						}

						if let extend = extended {
							if extend == to {
								return to
							}

							switch extend {
								case ClassInstance(classType, generic):
									extended = classType.extend
								case Class(classType):
									extended = classType.extend
								case _:
									extended = null
							}
						} else {
							break
						}
					}
			}

			// TODO show also variable name (Ident) when possible for a value
			fail('Incompatible types `\(Type.stringify(to))` and value of `\(Type.stringify(fromValue))`', node)
		}

		if toEnumInstance != fromEnumInstance, Type.unwrapNullable(to) != typeAny, Type.unwrapNullable(fromValue) != typeAny {
			// TODO
			// fail('Incompatible types `\(Type.stringify(to))` and value of `\(Type.stringify(fromValue))`', node)
		}

		return to ?? fromValue
	}

	fun findType(name: String): Node? {
		for i in scopes.length {
			if let subj = scopes[scopes.length - i - 1].get(name) {
				return subj
			}
		}
		let rooted = findInNamespaceRoots(name)
		if (rooted == null) {
			// TODO return findInNamespaceRoots(name)
			// console.log('findType == null', /*scopes, */currentModule.exported.keys())
		}
		return rooted
	}

	fun findActualType(name: String): Type? {
		for i in scopeTypes.length {
			if let subj = scopeTypes[scopeTypes.length - i - 1].get(name) {
				return subj
			}
		}

		// console.log('findActualType == null', name, scopeTypes, /*scopes, */currentModule.exported.keys(),
		// types.get(currentModule.exported.get(name)) )
		// TODO global
		// return null
		return null
	}

	fun toType(t: NodeType, node: Node): Type {
		switch t {
			case Type(name, path):
				// let nodeType: Node = findType(name) ?? currentModule.exported.get(name) ?? currentModule.imported.get(name)
				var nodeType: Node? = null

				if let path = path {
					// fail('Cannot finssssd supposedly imported namespace `\(path)` of type `\(name)`', node)
					switch currentModule.imported.get(path) as! Node {
						case ModuleExports(handle):
							nodeType = handle.exported.get(name)
							if nodeType == null {
								let file = handle.file
								fail('Namespace `\(path)` does not export type `\(name)` (aliased module is `\(file)`)', node)
							}
						case _:
							// TODO
							// console.log(currentModule.file)
							// console.log(currentModule.exported.keys())
							// console.log(currentModule.imported.keys())
							// console.log(currentModule.imported.get(path))
							fail('Cannot find supposedly imported namespace `\(path)` of type `\(name)`', node)
					}
				} else {
					nodeType = findType(name) ?? currentModule.exported.get(name) ?? currentModule.imported.get(name)
				}

				if (types.get(nodeType) == null) {
					// let node: Node = nodeType ?? currentModule.exported.get(name) // TODO ?? currentModule.imported.get(name)
					switch nodeType {
						case Class(_):
							let mod = currentModule
							registerClassType(nodeType)
							currentModule = mod

						case Enum(_):
							registerEnumType(nodeType)
						case null:
							// console.log('toType registerClassType null!', name)
						case _:
							// console.log('toType registerClassType _!', name)
					} }
				// TODO ^ fix indentation
				let actualType: Type? = findActualType(name) ?? types.get(nodeType)
				switch actualType {
					case Class(classType):
						if (classType.genericParams.length > 0) {
							fail('The type `\(classType.name)` requires `<\(classType.genericParams)>` generic parameters', node)
						}
						return classType.instantiate()
					case Enum(enumType):
						return types.get(nodeType)
					case ClassInstance(_):
						return actualType
					case EnumInstance(_):
						return actualType
					case Nullable(_):
						return actualType
						// case Alias(aliasType): TODO
						// //return
						// fail('Unsupported Alias type `\(name)`', node)
					case null:
						let available = []

						for name in currentModule.imported.keys() {
							available.push(name)
						}

						for name in currentModule.exported.keys() {
							available.push(name)
						}

						for name in project.globals.keys() {
							available.push(name)
						}

						fail(
							'Cannot find type `\(name)`\n'
							+ proposeSimilar(available.filter((named) => DataHelper.isTitleCase(named)), name, 'types', name),
							node)
					case Alias(alias):
						return toType(alias.value, node)
					case _:
						if actualType == typeAny {
							return typeAny
						}

						switch actualType {
							case Generic(_):
								return actualType
								// return typeAny TODO
						}

						return actualType
						console.log('Unsupported type:', actualType)
						fail('Unsupported type~ `\(name)`', node)
				}
			case ParametricType(name, params, path):
				let nodeType: Node = findType(name) ?? currentModule.exported.get(name) ?? currentModule.imported.get(name)
				if types.get(nodeType) == null { switch nodeType {
						case Class(_):
							let mod = currentModule
							registerClassType(nodeType)
							currentModule = mod
						case Enum(_):
							registerEnumType(nodeType)
					} }
				let actualType: Type? = findActualType(name) ?? types.get(nodeType)
				switch actualType {
					case Class(classType):
						if classType.genericParams.length == 0 {
							fail('The type `\(classType.name)` requires zero generic parameters', node)
						}
						if classType.genericParams.length != params.length {
							fail('The type `\(classType.name)` requires `<\(classType.genericParams)>` generic parameters', node)
						}

						let instanceParams = [for p in params toType(p, node)]

						// Fix C forward declaration order
						if name == 'ByValue' {
							switch instanceParams[0] {
								case ClassInstance(classType):
									// throw 'yeeeay' + name + classType.name
									// TODO is it even useful here? Or just keep in normalizer?
									classType.usedByValueDepth = 1
							}
						}

						return classType.instantiateGeneric(instanceParams)
					case null:
						fail('Cannot find type `\(name)`', node)
					case _:
						if actualType == typeAny {
							// Ignore all parameters here
							return typeAny
						}

						switch actualType {
							case Generic(_):
								return typeAny
						}
						fail('Unsupported type `\(name)`', node)
				}
			case Optional(t):
				return asNullable(toType(t, node))
			case Function(args, ret):
				let variadic = false // TODO
				return Type.Function(
					// TODO varTypes
					[for arg in args new FunctionArgument(toType(arg, node))],
					toType(ret, node),
					variadic
				)
			case Object(names, el):
				let els = [for e in el toType(e, node)]
				return Type.Struct(names, els)
			case Int(value):
				return Type.Constant('' + value)
				return Type.Constant // TODO must error: not enough args
			case Ident(value):
				return Type.Constant('' + value)
			case _:
				fail('Unsupported node type ' + t + never, node)
		}
	}

	// Infer `var a [T] = []`
	fun inferEmptyArray(t: Type, e: Node?) {
		switch e {
			case Array(el) if el.length == 0 and t != null: {
					// types.set(node,
					///// Inferred in `mixVarTypes`
					// let tType = toType(t, node)
					types.set(e, t)
				}
			case null: // TODO `case null` should be error for non-nullable expressions
			case _:
				// throw 'ok ok'
				// fillExpression(e)
		}
	}

	// `var node: NodeType = e`
	fun mixVarTypes(t: NodeType?, e: Node?, node: Node) {

		if t != null, e != null {
			let tType = toType(t, node)

			inferEmptyArray(tType, e)

			types.set(node, unify(tType, types.get(e), e))
		}
		if t == null, e != null {
			types.set(node, types.get(e))
		}
		if t == null, e == null {
			types.set(node, Type.UnknownNullable({ value: null }))
		}
		if t != null, e == null {
			types.set(node, toType(t, node))
		}
	}

	// `var left = right`
	fun areCovariant(left: Type?, right: Type?, strictNull: Bool = false): Bool {
		if left == right {
			return true
		}

		var left = left
		var right = right

		var leftNullable = false
		var rightNullable = false

		switch left {
			case null:
				return true // TODO inference hack
			case Nullable(t):
				left = t
				leftNullable = true
		}

		switch right {
			case null:
				return true // TODO inference hack
			case Nullable(t):
				right = t
				rightNullable = true
		}

		// Nullability still checks even `Any`
		if rightNullable, not leftNullable, strictNull {
			return false
		}

		if left == typeAny or right == typeAny {
			return true
		}

		if left == right {
			return true
		}

		// TODO inheritance etc

		switch left {
			case Enum(lt):
				switch right {
					case EnumInstance(rt):
						if lt == rt {
							return true
						}
					case Enum(rt):
						if lt == rt {
							return true
						}
						// TODO Class, ClassInstance
				}
			case EnumInstance(lt):
				switch right {
					case EnumInstance(rt):
						if lt == rt {
							return true
						}
					case Enum(rt):
						if lt == rt {
							return true
						}
				}
		}

		return false
	}

	// `left > right`, `left == right`, etc
	// Nullables are not allowed
	fun areComparable(left: Type, right: Type): Bool {
		if left == typeAny or right == typeAny {
			return true
		}

		switch left {
			case Generic(_): return true
		}

		switch right {
			case Generic(_): return true
		}

		// TODO check that `unsigned < -10` makes no sense
		let numerical = [
			typeSignedSizeOfPointer,
			typeSizeOfPointer,

			typeInt,
			typeFloat,

			typeFloat32,
			typeBigInt,

			typeUInt64,
			typeUInt32,
			typeUInt16,
			typeUInt8,

			typeInt64,
			typeInt32,
			typeInt16,
			typeInt8
		]

		return numerical.includes(left) and numerical.includes(right)
	}

	/// Adds to scope all of `fun name<PARAMS>`
	fun pushFuncParamsIfRequired(func: Node) {
		if let params = project.mapFuncParams.get(func) as! [NodeType], params.length > 0 {
			pushScope()

			for genericParam in params {
				let name = DataHelper.extractTypeName(genericParam)
				addScopeType(name, typeAny)
			}
		}
	}

	fun popFuncParamsIfRequired(func: Node) {
		if let params = project.mapFuncParams.get(func) as! [NodeType], params.length > 0 {
			popScope()
		}
	}

	// Used only for function arguments
	fun varTypes(vars: [Node]): [FunctionArgument] {
		let varTypes: [FunctionArgument] = []
		// var pushedScope = false
		// params: [NodeType]? = null
		// if let node = func, let params = project.mapFuncParams.get(node) as! [NodeType] {
		// console.log(params)
		// pushScope()
		// pushedScope = true
		// for genericParam in params {
		// let name = DataHelper.extractTypeName(genericParam)
		// addScopeType(name, typeAny)
		// console.log('added: ' + name)
		// }
		// }

		for v in vars {
			switch v {
				// TODO names really must be same as in declaration cause I did:
				// case Var(expr, t): misused `expr != null` but by reading `name`
				case Var(name, t, expr):
					// TODO different logic, cause does `types.get(v)`
					if let t = t {
						// console.log('<--before')
						// TODO optional etc
						let arg = new FunctionArgument(types.get(v) ?? toType(t, v))
						arg.optional = expr != null
						arg.name = name
						varTypes.push(arg)
						// console.log('<--after')
					} else {
						// TODO same
						varTypes.push(new FunctionArgument(types.get(v) ?? Type.Unknown({ value: null })))
					}
			}
		}

		// if pushedScope {
		// popScope()
		// }

		return varTypes
	}

	/// `Bool` or convertible to `Bool`
	fun booleanable(checkType: Type?): Bool {
		return (checkType == typeBool) or (checkType == typeAny)
		// if checkType == null {
		// return false
		// }
		//
		// //if checkType != typeBool, checkType != typeAny, checkType != null {
		// if checkType != typeBool, checkType != typeAny {
		// return false
		// }
		//
		// return true
		// TODO
	}

	// Uses idea of stacks to track nested function behavior
	private fun fillFunction(node: Node, expr, vars: [Node], rettype, arrow: Bool = false): Void {
		// TODO move duplicate argument names check to parser (so it can be cached)
		let argNames: [String] = []
		var expectedArrow: [Type] = []
		if let expectedArrowSignature = expectedArrowType.get(node) {
			switch expectedArrowSignature {
				case Function(args, rets): expectedArrow = args.map(arg => arg.dataType)
			}
		}

		pushScope()
		// Save stack
		let _insideFunction = insideFunction
		let _insideAsync = insideAsync
		let _functionAllowedToThrow = functionAllowedToThrow
		let _functionThrows = functionThrows
		let _functionReturnsAType = functionReturnsAType
		let _functionActuallyReturns = functionActuallyReturns
		let _insideTry = insideTry

		for i in vars.length {
			let v = vars[i]
			switch v {
				case Var(vname, t, e, const):
					if argNames.includes(vname) {
						fail('Argument `\(vname)` defined multiple times', v)
					}
					argNames.push(vname)

					if t != null, toType(t, v) == typeVoid {
						fail('Argument cannot be of type `Void`', v)
					}

					if t != null {
						types.set(v, toType(t, v))
					} else {
						types.set(v, expectedArrow[i])
					}

					if e != null {
						// TODO fillExpression should return type of `e` to not do `types.get(e)`
						fillExpression(e)

						if let t = types.get(v) {
							// unify(types.get(e), t, e) TODO
							unify(to: t, fromValue: types.get(e), e)
						}

						// TODO `Unknown` or something, argument shouldn't be of type `null`
					}

					addScope(vname, v)
			}
		}

		var variadic = false
		var constructor = false
		switch node {
			// TODO `(variadic, ...)`
			case Function(name, _, _, _, _, isVariadic):
				variadic = isVariadic
				constructor = name == 'new'
				// var x: [] = [] // TODO invalid!!!
				if let params = project.mapFuncParams.get(node) as! [NodeType] {
					for genericParam in params {
						let name = DataHelper.extractTypeName(genericParam)
						addScopeType(name, typeAny)
					}
				}
				// case _: {
				// TODO
				// //console.log('what? ' + Node.stringify(node) + ' ' + node)
				// }
		}

		// Reset stack
		var ret: Type? = null // TODO = if (let)
		if let rt = rettype {
			ret = toType(rt, node)
		}

		functionReturnsAType = ret
		functionActuallyReturns = constructor

		let atts = project.mapDecorators.get(node)

		if let noThrow = DataHelper.getDecorator(atts, 'noThrow') {
			if (noThrow.values.length > 0) {
				fail('Decorator `@noThrow` should have no parameters', node)
			}
			functionAllowedToThrow = false
		} else {
			functionAllowedToThrow = true
		}

		if let throws = DataHelper.getDecorator(atts, 'throws') {
			if (functionAllowedToThrow == false) {
				fail('Decorator `@noThrow` cannot be used with `@throws`', node)
			}
			functionThrows = true
		} else {
			functionThrows = false
		}

		insideFunction = true
		insideAsync = project.mapAsync.get(node) == true
		insideTry = false

		if arrow, expr != null {
			fillExpression(expr)
		}
		if not arrow, expr != null {
			fill(expr)
		}
		popScope()

		ret = functionReturnsAType // Inferred
		if arrow {
			if arrow, ret == null, expr != null {
				ret = types.get(expr)
			} else {
				unify(types.get(expr), ret, expr)
			}
		} else {
			if ret == null {
				ret = typeVoid
			}
			if ret != typeVoid, expr != null, functionActuallyReturns == false {
				// To handle arrow
				fail('Function expects result of `\(Type.stringify(ret))` but never does `return value`', node)
			}
		}

		// Restore stack
		insideFunction = _insideFunction
		insideAsync = _insideAsync
		functionReturnsAType = _functionReturnsAType
		functionActuallyReturns = _functionActuallyReturns

		// Set function type
		// varTypes(vars)
		types.set(node, Type.Function(args: varTypes(vars), returns: ret, variadic))
		// types.set(node, Type.Function(args: [for v in vars new FunctionArgument(types.get(v))], returns: ret))
	}

	private fun fillModuleTypes(node: Node, params: [Type]? = null, instanceOf: ClassType? = null): Void {
		switch node {
			// `class T {}`
			case Class(t, extend, implement, f, external):
				addScope(DataHelper.extractTypeName(t), node)
				let mod = currentModule
				if params != null {
					// console.log('fillModuleTypes params!')
				}
				registerClassType(node, null, params, instanceOf)
				currentModule = mod

				// `enum T {}`
			case Enum(t, f, valuesType):
				addScope(DataHelper.extractTypeName(t), node)
				let mod = currentModule
				registerEnumType(node)
				currentModule = mod

				// `declare A = T`
			case TypeAlias(alias, value):
				let aliasType = new AliasType(value)
				// TODO pre-check somehow that aliased type exists (and takes generic parameters)
				types.set(node, Type.Alias(aliasType))
				addScope(nameOfModuleItem(node), node)

			case _: console.log('fillModuleTypes', node) // TODO
		}
	}

	// Syntax tree traverse
	private fun fill(node: Node): Void {
		switch node {
			//
			// Types
			//

			case Class(_):
				fail('Defining classes within blocks not allowed', node)

			case Enum(_):
				fail('Defining enums within blocks not allowed', node)

			case TypeAlias(_, t):
				fail('Defining alias within blocks not allowed', node)

				let name = switch t {
					case Type(name): name
					case ParametricType(name, _): name
					case null:
						fail('Type has no name: ' + NodeType.stringify(t), node)
						// TODO `throw` ie must break this expression
						''
					case _:
						fail('Wrong alias format: ' + NodeType.stringify(t), node)
						// throw 'Wrong alias format: ' + NodeType.stringify(t)
						// TODO `throw` ie must break this expression
						''
				}

				let actualType: Type? = findActualType(name)
				let alias = new AliasType(actualType)
				types.set(node, Type.Alias(alias))
				addScope(nameOfModuleItem(node), node)
				// TODO
				// fail('Defining types within blocks not allowed', node)

				//
				// Statements do not return a value
				//

				// `var a = e, b: T, c`
				// case Vars(e):
				// for ee in e {
				// fill(ee)
				// }
				// `{...}`
			case Block(el):
				pushScope()
				for e in el {
					switch e {
						case Ident(name):
							// { name, name } short syntax (but not { name }) TODO
					}
					fill(e)
				}
				popScope()

				// `var name: t = e`
			case Var(name, t, e, const, external):
				if project.mapStatic.get(node) == true {
					fail('Local variables cannot be `static`', node)
				}
				if project.mapPrivate.get(node) == true {
					fail('Local variables cannot be `private`', node)
				}
				if e == null, const, not external {
					fail('Constant should have a value `let \(name) = value`', node)
				}
				if e == null, not external {
					fail('Variable should have a value `var \(name) = value` or type set to nullable with a value of null `var \(name) T? = null`', node)
				}
				if e != null, external {
					fail('External variable should not have a value `declare let \(name)`', node)
				}
				if t == null, external {
					fail('External variable should have a type `declare let \(name): T`', node)
				}
				if e != null {
					pushScope()

					switch e {
						case Array(el) if el.length == 0 and t != null: {
								// Inferred in `mixVarTypes`
							}
						case _:
							fillExpression(e)
					}
					popScope()
				}

				mixVarTypes(t, e, node)

				addScope(name, node)

				// `a = b` as a statement
			case Binop(a, op, b):
				fillExpression(node)
				// TODO
				// fillExpression(a)
				// fillExpression(b)

				var parent: Node = parents.get(a)
				// `a = b`
				// TODO separate assign node? or just nested pattern...
				if op == Token.Assign {
					switch parent {
						case null:
							switch a {
								case Ident(_): // Ok
								case Dot(_): // Ok
								case Index(_): // Ok
								case Index2D(_): // Ok
								case Index3D(_): // Ok
									let typeA = types.get(a)
									let typeB = types.get(b)
									inferNullType(typeB, typeA) // `a[i] = null`
								case _:
									fail('Cannot reassign `\(Node.stringify(a))`', a)
							}
							// TODO typings for `[]` etc
							// Infer `[]`
							inferEmptyArray(types.get(a), b)
						case Var(name, _, _, const):
							if const {
								fail(
									'Cannot reassign a constant `let \(name)`, redefine it as `var \(name)` to allow reassignment\n'
									+ positionOf(parent) + '`let \(name)` is defined here',
									node)
							}

							let typeA = types.get(a)
							let typeB = types.get(b)
							inferNullType(typeB, typeA) // `a = null`
							inferEmptyArray(typeA, b) // `a = []`
							let newType = unify(typeA, typeB, b)
							types.set(node, newType)

							let parentType: Type? = types.get(parent)
							switch parentType {
								case null:
									types.set(parent, newType)
								case UnknownNullable(handle):
									if handle.value == null {
										handle.value = newType
									}

							}
						case Ident(name):
							fail('Cannot reassign case parameter `\(name)`', node)
						case Function(name, _):
							fail('Cannot reassign a function `\(name)`', node)
						case Class(_):
							fail('Cannot reassign class', node)
						case Enum(_):
							fail('Cannot reassign enum', node)
						case For(name, _):
							fail(
								'Cannot reassign iterator value `\(name)` of for loop\n'
								+ positionOf(parent) + '`for \(name) in ...` is defined here',
								node)
						case Super:
							fail('Cannot reassign `super`', node)
						case _:
							fail('`=` not implemented for: ' + parent, node)
					} }

				// `break`
			case Break:
				if not allowBreakAndContinue {
					fail('Cannot use `break` outside of loop', node)
				}

				// `for name in over ... range { by }`
			case For(name, over, by, range):
				// TODO refactor
				let iterableIntegers = [
					typeInt,

					typeUInt64,
					typeUInt32,
					typeUInt16,
					typeUInt8,

					typeInt64,
					typeInt32,
					typeInt16,
					typeInt8
				]

				pushScope()
				fillExpression(over)
				let overType: Type = types.get(over)
				switch overType {
					case ClassInstance(classType, generic):
						// Extract Array<T>
						if generic != null, generic.length == 1 {
							types.set(node, generic[0])
						} else if (iterableIntegers.includes(overType)) {
							types.set(node, overType)
						} else {
							fail('Type of iterable is neither integer nor `Array`, but `' + Type.stringify(overType) + '`', over)
						}

					case Nullable(_):
						fail('Type of iterable should not be nullable', over)

					case UnknownNullable(_):
						fail('Type of iterable should not be nullable', over)

					case null:
					case _:
						fail('Type of iterable is neither integer nor `Array`', over)
				}
				if let range = range {
					fillExpression(range)
					let endType = types.get(range)
					// TODO `fillExpression(X)` to return `types.get(X)` and fix other places
					// Ranges always integer/Int for now
					if not iterableIntegers.includes(endType) {
						fail('Range end must be of integer type', range)
					}
					if not iterableIntegers.includes(overType) {
						fail('Range start must be of integer type', over)
					}
					if endType != overType {
						// TODO `finish`/`final` instead of `end`?
						fail('Range start and end must be of the same type, but got `' + Type.stringify(overType) + '...' + Type.stringify(endType) + '`', over)
					}
					types.set(node, overType)
				}
				addScope(name, node)
				// TODO macro `@push allowBreakAndContinue = true` + `@pop allowBreakAndContinue`
				let _allowBreakAndContinue = allowBreakAndContinue
				allowBreakAndContinue = true
				switch by {
					case Block(_):
					case _: {
							fail('Loop body must be a `{` block `}`', by)
						}
				}
				fill(by)
				allowBreakAndContinue = _allowBreakAndContinue
				popScope()

			// `function name(vars): rettype {expr}`
				// `vars` are `Var(name, t, ...)` where `function(name: t)`
			case Function(name, expr, vars, rettype, external):
				if project.mapStatic.get(node) == true {
					fail('Local functions cannot be `static`', node)
				}
				if project.mapPrivate.get(node) == true {
					fail('Local functions cannot be `private`', node)
				}
				if not external, expr == null {
					fail('Non-external function `\(name)` should have a body', node)
				}
				if external, rettype == null {
					fail('External function `\(name)` should have a returning type', node)
				}
				addScope(name, node)
				pushFuncParamsIfRequired(node) // Do this before `expr` typing
				fillFunction(node, expr, vars, rettype)
				if false {

					// Save stack
					let _insideFunction = insideFunction
					// Reset stack
					insideFunction = true
					pushScope()
					if (expr != null) {
						fill(expr)
					}
					popScope()
					popFuncParamsIfRequired(node) // Do this after `expr` typing

					// Restore stack
					insideFunction = _insideFunction
				} // if false

				// `if econd { eif } else { eelse }`
				// `if econd { eif }`
				// Also `if let bind = value, econd..., econd...`
			case If(econd, eif, eelse):
				var depth = 0
				for e in econd {
					switch e {
						case Var(name, t, expr, const):
							if not const {
								fail('Only `if let` bindings supported, not `if var`', node)
							}
							if t != null {
								fail('Do not specify a type `: T` in `if let` bindings', node)
							}
							if expr == null {
								fail('`if let` binding should have a value `\(name) = value', node)
							}
							depth++
							pushScope()
							pushScope()
							fillExpression(expr)
							popScope()
							switch types.get(expr) as! Type {
								case Nullable(t): types.set(e, t)
								case UnknownNullable(handle):
									if let t = handle.value {
										types.set(e, t)
									} else {
										fail('`if let` cannot bind not fully known nullable type', node)
									}
								case _: types.set(e, types.get(expr))
							}
							addScope(name, e)
						case _:
							fillExpression(e)
							// Only Bool allowed
							let exprType = types.get(e)
							if exprType != typeBool, exprType != typeAny, exprType != null {
								if exprType == typeInt {
									fail('Use `if ' + Node.stringify(e) + ' != 0` syntax to compare `Int` values with zero', e)
								}

								switch e {
									case Binop(a, op, b):
										// TODO rename Equal to Equal, also confusion with Assign
										if op == Token.Assign {
											fail('Probably change `=` to `==` here. `if value` expects `value` only of type `Bool`, but got `' + Type.stringify(exprType) + '`', e)
										}
								}

								fail('`if value` expects `value` only of type `Bool`, but got `' + Type.stringify(exprType) + '`', e)
							}
					}
				}
				fill(eif)
				while depth > 0 {
					depth--
					popScope()
				}

				// TODO Hint Consider changing this code to `if let eelse = eelse`
				if eelse != null {
					fill(eelse)
				}

				// `switch exprs { case conds if (guards): { cases } }`
			case Switch(exprs, conds, guards, cases):
				fillSwitch(node, false)

				// `try { } catch e: T { }`
			// `try { } catch e T if cond, let x = expr { }`
			case Try(e, t, v, ca):
				// Save stack
				let _insideTry = insideTry
				// Reset stack
				insideTry = true
				switch e {
					case Block(_):
					case _:
						fail('Try body must be a `{ block }`', e)
				}
				fill(e)
				// Restore stack
				insideTry = _insideTry

				for i in ca.length {
					let catchType = toType(t[i], ca[i])
					switch catchType {
						case Struct(_):
							fail('Catch type must be a specific class, not `{}`', ca[i])
						case Function(_):
							fail('Catch type must be a specific class, not function', ca[i])
					}
					types.set(t[i], catchType)
					pushScope()
					// v[i] is now an array of nodes: [catchVar, letBindings..., conditions...]
					let catchClauseValues = v[i]
					// First element is always the catch variable
					if catchClauseValues.length > 0 {
						let catchVar = catchClauseValues[0]
						scopes[scopes.length - 1].set(DataHelper.varName(catchVar), catchVar)
						// Process any additional let bindings and conditions
						for j in 1...catchClauseValues.length - 1 {
							let val = catchClauseValues[j]
							switch val {
								case Var(name, _, expr, const, _):
									// let binding - evaluate expr and add to scope
									if let expr = expr {
										fillExpression(expr)
										types.set(val, types.get(expr))
									}
									scopes[scopes.length - 1].set(name, val)
								case _:
									// Condition expression
									fillExpression(val)
							}
						}
					}
					switch ca[i] {
						case Block(_):
						case _:
							fail('Catch body must be a `{ block }`', ca[i])
					}
					fill(ca[i])
					popScope()
				}

				// `while (econd[0], ...econd[n]) e` if pre == true
				// `do e while (econd[0], ...econd[n])` if pre == false
			case While(econd, e, pre):
				if pre == true {
					for cond in econd {
						// TODO push scope for bindings
						fillExpression(cond)
					}
				}
				let _allowBreakAndContinue = allowBreakAndContinue
				allowBreakAndContinue = true
				switch e {
					case Block(_):
					case _:
						fail('`while` statements must be wrapped with a `{` block `}`', e)
				}
				fill(e)
				allowBreakAndContinue = _allowBreakAndContinue
				if pre == false {
					for cond in econd {
						// TODO push scope for bindings
						fillExpression(cond)
					}
				}
				types.set(node, typeVoid)

				// `continue`
			case Continue:
				types.set(node, typeVoid)
				if not allowBreakAndContinue {
					fail('Cannot use `continue` outside of loop', node)
				}

				// Expressions and errors
			case _:
				fillExpression(node)
		}
	}

	// Expressions return values
	fun fillExpression(node Node, asValue Bool = true) {
		if not asValue {
			// console.log('not asValue', node, project.data.get(node))
		}
		switch node {
			// Just `name`
			case Ident(name, params):
				var subj = null
				for i in scopes.length {
					subj = scopes[scopes.length - i - 1].get(name)
					if (subj != null) {
						break
					}
				}

				if subj == null {
					subj = findInNamespaceRoots(name)
				}
				if subj == null, name == 'const' {
					fail('No variable named `const` found. Are you trying to use `const` as a keyword? Use `let varname` syntax instead.', node)
				}
				if subj == null {
					// console.log(currentModule.imported.keys())
					// console.log(currentModule.exported.keys())
					// console.log(currentModule.file)
					fail('Cannot find variable with name `\(name)`', node)
				}
				if parents.get(node) != null, parents.get(node) != subj {
					fail('Parent overwritten from \(parents.get(node)) to \(subj) for node \(node)' + never, node)
				}
				parents.set(node, subj)
				if let identType = types.get(subj) {
					types.set(node, identType)
				}

				if let params = params {
					for param in params {
						types.set(param, toType(param, node))
					}
				}

				// `(args) => {expr}`
			case Arrow(expr, vars, rettype):
				fillFunction(node, expr, vars, rettype, arrow: true)
				if false {
					pushScope()
					// Save stack
					let _insideFunction = insideFunction

					// Reset stack
					insideFunction = true
					fillExpression(expr)
					popScope()

					// Restore stack
					insideFunction = _insideFunction
				}

				// `fun name(vars) rettype {expr}`
			case Function(name, expr, vars, rettype, external):
				if external {
					fail('External function `declare fun \(name)` cannot be taken as a value', node)
				}

				fillFunction(node, expr, vars, rettype)

				if false {
					pushScope()
					addScope(name, node)

					// Save stack
					let _insideFunction = insideFunction

					// Reset stack
					insideFunction = true

					if (expr != null) {
						fill(expr)
					}
					popScope()

					// Restore stack
					insideFunction = _insideFunction
				}

				// `[a,b,c]`
			case Array(el):
				// `[for name in over ... range by]`
				switch el[0] {
					case For(name, over, by, range):
						if (el.length > 1) {
							fail('Cannot use loop `for` within array of more than one element `[for, ...]`', el[1])
						}
						if (range != null) {
							fail('Ranges `...range` are not supported here yet', range)
						}

						pushScope()
						fillExpression(over)
						// types.set(el[0], types.get(over))
						// TODO reuse code from for-as-statement
						let overType: Type = types.get(over)
						switch overType {
							case ClassInstance(classType, generic):
								// Extract Array<T>
								// TODO check classType == typeArray
								if generic != null, generic.length == 1 {
									types.set(el[0], generic[0])
								} else if overType == typeInt {
									types.set(el[0], typeInt)
								} else if ((overType == typeUInt32) or (overType == typeUInt64)) {
									types.set(el[0], overType)
								} else {
									fail('Type of iterable is neither `Int` nor `Array`, but `' + Type.stringify(overType) + '`', over)
								}

							case Nullable(_):
								fail('Type of iterable should not be nullable', over)

							case UnknownNullable(_):
								fail('Type of iterable should not be nullable', over)

							case null:
							case _:
								fail('Type of iterable is neiter Int nor Array', over)
						}

						// types.set(el[0], types.get(over))
						addScope(name, el[0])
						let _allowBreakAndContinue = allowBreakAndContinue
						allowBreakAndContinue = false
						fillExpression(by)
						allowBreakAndContinue = _allowBreakAndContinue
						popScope()

						types.set(node, typeArray.instantiateGeneric([types.get(by)]))
					case _:
						for i in el.length {
							let e = el[i]
							fillExpression(e)

							if let elementsType = types.get(el[0]), i != 0 {
								unify(elementsType, types.get(e), e)
							}
						}
						types.set(node, typeArray.instantiateGeneric([
									if (el.length > 0) {
										types.get(el[0])
									} else {
										Type.Unknown({ value: null })
									}
								]))
				}

				// `[k:v, k:v]`
			case Map(keys, values):
				if (keys.length == 0) {
					types.set(node, typeMap.instantiateGeneric([
								Type.Unknown({ value: null }),
								Type.Unknown({ value: null })
							]))
					return
				}
				for i in keys.length {
					fillExpression(keys[i])
					fillExpression(values[i])
				}
				types.set(node,
					typeMap.instantiateGeneric([types.get(keys[0]), types.get(values[0])])
				)

				// `e as  t`
				// `e as! t`
				// `e as? t`
			case As(e, kind, t):
				// TODO error position must not a node, but at node type (`x as __here__` not `__here__ as tt`)
				let actualType = toType(t, node)
				if (actualType == typeVoid) {
					fail('Conversion `as Void` makes no sense', e)
				}
				fillExpression(e)
				if (types.get(e) == typeVoid) {
					fail('Conversion of `value as \(Type.stringify(t))` where `value` is of type `Void` makes no sense', e)
				}
				types.set(t, actualType)
				types.set(node, actualType)

				// `e is t`
			case Is(e, t):
				let actualType = toType(t, node)
				if (actualType == typeAny) {
					fail('Comparing `is Any` makes no sense, always true', e)
				}
				if (actualType == typeVoid) {
					fail('Comparing `is Void` makes no sense', e)
				}
				fillExpression(e)
				types.set(t, actualType)
				types.set(node, typeBool)

				// `{...}`
			case Block(el):
				if (el.length == 0) {
					types.set(node, Type.Struct([], []))
				} else {
					pushScope()
					for i in el.length { if (i < el.length - 1) {
							fill(el[i])
						} }
					let latest = el[el.length - 1]
					fillExpression(latest)
					types.set(node, types.get(latest))
					popScope()
				}

				// `e.n`
			case Dot(e, n):
				switch e {
					case Super:
						if not allowSuper {
							fail('Cannot access `super` here', node)
						}

					case NodeTypeValue(_):
						fillExpression(e, false)

					case _:
						fillExpression(e)
				}
				if let etype = types.get(e) as! Type? { switch etype {
						case ClassInstance(classType, generic): // Non-static fields
							classType.useless = false
							if etype == typeAny {
								types.set(node, typeAny)
								return
							}
							let index = classType.fieldNames.indexOf(n)
							// TODO print `<T>` of class, not just name
							let named = nameOfModuleItem(classType.parent)
							if index < 0 {
								// TODO should be `failInfo` as in vscode PROBLEMS tab
								// TODO ^ `you have errors in` also change `hints in`
								failNonFatal('Type `\(classType.name)` is defined here', classType.parent)
								fail(
									'Class `\(named)` has no field `.\(n)`\n'
									// + positionOf(classType.parent) + '`\(named)` is defined here\n'
									+ proposeSimilar(classType.fieldNames, n, 'fields'),
									e ?? node
								)
							}
							if classType.fieldStatic[index] == true {
								failNonFatal('Type `\(classType.name)` is defined here', classType.parent)
								fail('Class `\(named)` field `.\(n)` is static', node)
							}
							switch classType.parent {
								case Class(t, extend, implement, fields, external):
									let mod = currentModule
									registerClassType(classType.parent)
									currentModule = mod

									for field in fields {
										if DataHelper.nameOf(field) == n {
											fun genericFixup(ofType: Type, generic: [Type]): Type {
												switch ofType {
													// TODO `: Generic<NonGeneric, Generic>`
													// `: T`
													case Generic(genericParamIndex, genericParam):
														// console.log('<@>' + Type.stringify(etype) + '.' + DataHelper.nameOf(field) + ': <' + genericParam + ' ' + genericParamIndex + '>')
														// types.set(node, generic[genericParamIndex])
														// TODO due enable null checks so this never happens AND ARGS COUNT
														if generic == null {
															// TODO console.log('bad generic')
															return typeAny
														}
														return generic[genericParamIndex]
														// `: [T]`
													case ClassInstance(classType, generics):
														if let general = generics {
															// console.log('[[!]]ClassInstance<...>:' + classType.name)
															//
															return classType.instantiateGeneric([for item in general genericFixup(item, generic)])
														} else {
															// console.log('[[!]]ClassInstance:' + classType.name)
															return ofType
														}
														// `:  T?`
													case Nullable(nullableType):
														return asNullable(genericFixup(nullableType, generic))
													case Function(args, returns, variadic):
														// console.log('<*>' + Type.stringify(etype) + '.' + DataHelper.nameOf(field) + ': fun...')
														var returns = returns
														var changed = false
														let fixedReturns = genericFixup(returns, generic)
														changed = fixedReturns != returns
														returns = fixedReturns
														// switch returns {
														// case Generic(genericParamIndex, genericParam):
														// console.log('<#>' + Type.stringify(etype) + '.' +
														// DataHelper.nameOf(field) + ': return <' + genericParam + ' ' + genericParamIndex + '>')
														// returns = generic[genericParamIndex]
														// console.log('~fixed to ' + Type.stringify(returns))
														// changed = true
														// }

														var reArgs: [FunctionArgument] = []
														for arg in args {
															// switch arg {
															// case Generic(genericParamIndex, genericParam):
															// console.log('<!>' + Type.stringify(etype) + '.' +
															// DataHelper.nameOf(field) + ': argument <' + genericParam + ' ' + genericParamIndex + '>')
															// reArgs.push(generic[genericParamIndex])
															// console.log('~fixed to ' + Type.stringify(generic[genericParamIndex]))
															// changed = true
															// case _:
															// reArgs.push(arg)
															// }
															let fixedArg = genericFixup(arg.dataType, generic)
															changed = changed or (fixedArg != arg.dataType)
															let reArg = new FunctionArgument(fixedArg)
															reArg.optional = arg.optional
															reArg.name = arg.name
															reArgs.push(reArg)
														}

														if changed {
															// types.set(node, Type.Function(args, returns))
															return Type.Function(reArgs, returns, variadic)
														}
													case _:
														// TODO handle more types
														// console.log('<?!>' + DataHelper.extractTypeName(t) + '.' + DataHelper.nameOf(field) + ': ' + Type.stringify(ofType))
														// console.log('<?!>=', ofType)
												}

												return ofType
											}

											let extractedType = types.get(field) ?? switch field {
												// TODO on-demand full class field inference
												case Var(name, t, e, const):
													// TODO `if let t = t {`
													if t != null {
														toType(t, field)
													} else {
														null
													}
											}

											// TODO somehow pre-flag (when parsing class fields) it it requires fixup at all
											types.set(node, genericFixup(extractedType, generic))
											parents.set(node, field)

											if extractedType == null {
												console.log(positionOf(node) + 'Note: field fieldInitialized[\(n)] =', classType.fieldInitialized[classType.fieldNames.indexOf(n)])
												fail('Type for this field cannot be inferred, try to specify types manually: `' + n + '`', field)
											}
										}
									}
								case _:
									fail('classType.parent not a class, internal error', classType.parent)
							}
						case Class(classType): // Static fields
							classType.useless = false
							let index = classType.fieldNames.indexOf(n)
							if (index < 0) {
								fail('Class `\(nameOfModuleItem(classType.parent))` has no static field `.\(n)`\nAvailable fields are: ' + classType.fieldNames.join(', '), node)
							}
							if (classType.fieldStatic[index] != true) {
								fail('Class `\(nameOfModuleItem(classType.parent))` field `.\(n)` is not static', node)
							}
							switch classType.parent {
								case Class(t, extend, implement, fields, external):
									for field in fields {
										if (DataHelper.nameOf(field) == n) {
											types.set(node, types.get(field))
											parents.set(node, field)
										}
									}
								case _:
									fail('classType.parent not a class, internal error', classType.parent)
							}
						case Enum(enumType):
							let index = enumType.fieldNames.indexOf(n)
							if index < 0 {
								fail('Enum `\(enumType.name)` has no field `.\(n)`', node)
							}
							if not enumType.fieldStatic[index] {
								fail('Enum field `.\(n)` is not static', node)
							}
							switch enumType.parent {
								case Enum(t, fields, valuesType):
									for field in fields { switch field {
											case Call(_):
											case NodeTypeValue(_):
											case Binop(_):
											case _:
												if DataHelper.nameOf(field) == n {
													types.set(node, types.get(field))
													parents.set(node, field)
												}
										} }
								case _:
									fail('enumType.parent not an enum, internal error', enumType.parent)
							}
						case Struct(names, els):
							let index = names.indexOf(n)
							if (index < 0) {
								var object = ''
								switch e {
									case Ident(name): object = ' `\(name)`' // Note a space after '
									case _: { }
								}

								if (names.length == 0) {
									fail('Object\(object) is empty `{}` and has no fields. Create object with all fields defined upfront, like this: `obj = { \(n): value }`', node)
								}
								if (names.length != 0) {
									fail('Object\(object) has no field `.\(n)`\nAvailable fields are: ' + names.join(', '), node)
								}
							}
							types.set(node, els[index])
						case UnknownNullable(handle):
							failNonFatal('Cannot access `.\(n)` of nullable type `\(Type.stringify(etype))`, try to unwrap it with `if let`', node)
							types.set(node, typeAny) // TODO unwrap proper type
						case Nullable(nullableType):
							failNonFatal('Cannot access `.\(n)` of nullable type `\(Type.stringify(etype))`, try to unwrap it with `if let`', node)
							types.set(node, typeAny) // TODO unwrap proper type
						case Unknown(handle):
							if let unknownType = handle.value {
								types.set(node, unknownType)
							} else {
								switch e {
									case Call(what, _):
										switch what {
											case Ident(name):
												// TODO show position of Ident parent
												failNonFatal('Cannot access `.\(n)` due to return type of `\(name)(...)` being unknown, try to specify a proper type (set full type `[T]` if this value coming from array)', node)
											case _:
												// TODO specify `value` that's referenced in the text
												failNonFatal('Cannot access `.\(n)` due to type of value being unknown, try to specify a proper type (set full type `[T]` if this value coming from array)', node)
										}
									case Ident(name):
										// failNonFatal('Cannot access `.\(n)` due to type of `\(name)` being unknown, try to specify a proper type (set full type `[T]` if this value coming from array)', node)
									case _:
										failNonFatal('Cannot access `.\(n)` due to type of value being unknown, try to specify a proper type (set full type `[T]` if this value coming from array)', node)
								}
								// TODO what means `set full type [T]`?
								// failNonFatal('Cannot access `.\(n)` due to type of value being unknown, try to specify a proper type (set full type `[T]` if this value coming from array)', node)
								types.set(node, typeAny) // TODO unwrap proper type
							}
						case Generic(_):
							types.set(node, typeAny)
						case null:
							fail('Cannot access `.\(n)` due to type being `null`, seems to be internal compiler error', node)
						case Function(_):
							fail('Cannot access `.\(n)` of function type `\(Type.stringify(etype))`', node)
						case _:
							fail('Cannot access `.\(n)` due to type being unhandled `\(Type.stringify(etype))`, seems to be internal compiler error', node)
					} } else {
					// failNonFatal('Got value without a type `\(Node.stringify(e))`. Seems like it cannot be automagically inferred. Try to specify a type manually.', e)
					// TODO uncomment this to see problems with inference (hint: lambda functions in forEach)
					// fail('Got node without type `\(e)`' + never, node)
					types.set(node, typeAny)
				}

				// `e.N`
			case DotUpper(e, n):
				switch e {
					case Super:
						fail('Cannot access `super` here', node)

					case NodeTypeValue(_):
						// console.log('NodeTypeValue', e, project.data.get(e))
						fillExpression(e, asValue: false)

					case _:
						fillExpression(e)
						// Typer()
				}

				switch types.get(e) as! Type {
					case EnumInstance(enumType):
						failNonFatal('Type `\(enumType.name)` is defined here', enumType.parent)
						// TODO why the heck `.Vname` here gives Ln1, Col 12????
						// enumType.V here is ok, but is in the string interpolator
						// ^ should be possible to set starting col/line in Lexer
						// NOTE `proposeSimilar` is useless for DotUpper over instances
						fail('Enum `\(enumType.name)` instance has no field `.\(n)`', node)
					case ClassInstance(classType):
						failNonFatal('Type `\(classType.name)` is defined here', classType.parent)
						// NOTE `proposeSimilar` is useless for DotUpper over instances
						fail('Class `\(classType.name)` has no field `.\(n)`\n\nNote that you are trying to access plain `class` instance and not `enum`', node)
					case Class(classType):
						failNonFatal('Type `\(classType.name)` is defined here', classType.parent)
						// NOTE `proposeSimilar` is useless for DotUpper over classes
						fail('Class `\(classType.name)` has no field `.\(n)`\n\nNote that you are trying to access `class` and not `enum`', node)
						// let index = type.fieldNames.indexOf(n)
						// if index < 0 {
						// fail('Class has no field `.\(n)`', node)
						// }
						// if type.fieldStatic[index] != true {
						// fail('Class field `.\(n)` is not static', node)
						// }
					case Enum(enumType):
						let index = enumType.fieldNames.indexOf(n)
						// TODO `@lazy let enumName = getName(enumType.name)` so no need to place in every failing `if`
						if index < 0 {
							failNonFatal('Type `\(enumType.name)` is defined here', enumType.parent)
							// NOTE `proposeSimilar` but only constructors (if any)
							fail('Enum `\(enumType.name)` has no value constructor `.\(n)`\n' + proposeSimilar(enumType.fieldNames.filter((element, index) => enumType.fieldEnumConstructor[index]), n, 'constructors'), node)
						}
						if enumType.fieldEnumConstructor[index] != true {
							// NOTE this case is probably impossible, i.e. .N *not* being constructor (than what?)
							fail('Enum `\(enumType.name)` field `.\(n)` is not a value constructor', node)
						}
						if let fieldType = enumType.fieldType[index] {
							types.set(node, fieldType)
						} else {
							// TODO wrap into common `failInternal`
							fail('Enum `\(enumType.name)` field type is null for `\(Node.stringify(node))`', node)
						}
					case null:
						fail('Accessing non-existing field `.\(n)` of `\(Node.stringify(e))`', node)
					case _:
						// Typer//<T>
						// var t = Typer
						// //var t = Typer(1)
						// Node.Block
						// var b = Node.Block
						// b.z
						// ([]) // <- newline
						// t.d
				} // else TODO fail('Got node without type `\(e)`' + never, node)

				// `T` or `T<G>`
			case NodeTypeValue(t):
				switch t {
					// TODO `case Type(name) or ParametricType(name, _):` or just unify all to `Type(name, null)`
					case Type(name):
						if asValue {
							fail('Cannot use type `\(name)` as a value, use `\(name)()` to call constructor', node)
						}

						let subj = find(name)
						if subj == null {
							fail('Cannot find type with name `\(name)`', node)
						}
						if parents.get(node) != null, parents.get(node) != subj {
							fail('Parent overwritten from \(parents.get(node)) to \(subj) for node \(node)' + never, node)
						}
						parents.set(node, subj)
						if let nodeType = types.get(subj) {
							types.set(node, nodeType)
						} else {
							// Try eager on-demand type build
							switch subj {
								case Class(_):
									// TODO better idea
									let mod = currentModule
									registerClassType(subj)
									currentModule = mod
								case Enum(_):
									// TODO module trick around this whole `switch`?
									registerEnumType(subj)
							}

							if let nodeType = types.get(subj) {
								types.set(node, nodeType)
							} else {
								console.log(positionOf(subj) + '\(name) is here')
								fail('Cannot find type for `\(name)` even after late build' + never, node)
							}
						}
					case ParametricType(name, _):
						if asValue {
							fail('Cannot use generic type `\(name)` as a value', node)
							// TODO ^ "you forgot () to call constructor?"
						}

						let subj = find(name)
						if subj == null {
							fail('Cannot find type with name `\(name)`', node)
						}
						if parents.get(node) != null, parents.get(node) != subj {
							fail('Parent overwritten from \(parents.get(node)) to \(subj) for node \(node)' + never, node)
						}
						parents.set(node, subj)
						if let nodeType = types.get(subj) {
							types.set(node, nodeType)
						} else {
							// Try eager on-demand type build
							switch subj {
								case Class(_):
									// TODO better idea
									let mod = currentModule
									registerClassType(subj)
									currentModule = mod
								case Enum(_):
									// TODO module trick around this whole `switch`?
									registerEnumType(subj)
							}

							if let nodeType = types.get(subj) {
								types.set(node, nodeType)
							} else {
								console.log(positionOf(subj) + '\(name) is here')
								fail('Cannot find type for `\(name)` even after late build' + never, node)
							}
						}
					case _:
						fail('Cannot use this type as a value', node)
				}

				// `new T {names: values} ()`
				// TODO `new T () {names: values}`
				// TODO remove
			case New(path, t, el, names, values):
				let actualType = toType(t, node)
				let subj = find(DataHelper.extractTypeName(t))
				parents.set(node, subj)
				for e in el {
					fillExpression(e)
				}

				switch actualType {
					case ClassInstance(classType):
						if classType.constructor == -1 {
							fail('Cannot construct class without `new () {}` constructor', node)
						}
						classType.useless = false
					case _:
						fail('Constructor `new` may instantiate only classes', node)
				}

				types.set(node, actualType)

				// `{names:el, ...}`
			case Object(names, el):
				for name in names.length {
					if names.indexOf(names[name]) != name {
						fail('Field `\(names[name])` already exists', node)
					}
				}

				for e in el {
					fillExpression(e)
				}

				let els = [for e in el types.get(e)]
				types.set(node, Type.Struct(names, els))

				// `try { ... value } catch e: T { ... value }`
			// `try { } catch e T if cond, let x = expr { }`
			case Try(e, t, v, ca):
				// Save stack
				let _insideTry = insideTry
				// Reset stack
				insideTry = true
				fillExpression(e)
				// Restore stack
				insideTry = _insideTry

				for i in ca.length {
					pushScope()
					// v[i] is now an array of nodes: [catchVar, letBindings..., conditions...]
					let catchClauseValues = v[i]
					// First element is always the catch variable
					if catchClauseValues.length > 0 {
						let catchVar = catchClauseValues[0]
						scopes[scopes.length - 1].set(DataHelper.varName(catchVar), catchVar)
						// Process any additional let bindings and conditions
						for j in 1...catchClauseValues.length - 1 {
							let val = catchClauseValues[j]
							switch val {
								case Var(name, _, expr, const, _):
									// let binding - evaluate expr and add to scope
									if let expr = expr {
										fillExpression(expr)
										types.set(val, types.get(expr))
									}
									scopes[scopes.length - 1].set(name, val)
								case _:
									// Condition expression
									fillExpression(val)
							}
						}
					}
					fill(ca[i])
					popScope()
				}
				types.set(node, types.get(e))

				// `if (econd) eif else eelse`
			case If(econd, eif, eelse, ternary):
				if econd.length > 1 {
					fail('More than one condition is not yet supported', econd[1])
				}
				switch econd[0] {
					case Var(_):
						fail('Variable bindings in ternary conditions are not yet supported', econd[0])
				}
				if eelse == null {
					fail('Expression `if` should have an `else` clause', eif)
				}
				fillExpression(econd[0])
				if ternary == false {
					switch eif {
						case Block(_):
						case _:
							fail('Ternary `if` should have a `{ block }` as a body', eif)
					}
					switch eelse {
						case Block(_):
						case _:
							fail('Ternary `else` should have a `{ block }` as a body', eelse)
					}
				}
				fillExpression(eif)
				fillExpression(eelse)
				types.set(node, unify(types.get(eif), types.get(eelse), eelse))

				// Simple nodes
				// `null`
			case Null:
				types.set(node, Type.UnknownNullable({ value: null }))

			case String(_):
				types.set(node, typeString)

			case Bool(_):
				types.set(node, typeBool)

			case Int(_):
				types.set(node, typeInt)

			case MetaInt(_, metaKind):
				switch metaKind {
					case BigInt: types.set(node, typeBigInt)

					case Int32: types.set(node, typeInt32)
					case Int64: types.set(node, typeInt64)
					case Int16: types.set(node, typeInt16)
					case Int8: types.set(node, typeInt8)

					case UInt32: types.set(node, typeUInt32)
					case UInt64: types.set(node, typeUInt64)
					case UInt16: types.set(node, typeUInt16)
					case UInt8: types.set(node, typeUInt8)

						// TODO move to MetaNumber or Float(kind)?
					case Float32: types.set(node, typeFloat32)

					case _: fail('Unhandled kind type of number', node)
				}

				if types.get(node) == null {
					let name = Meta.stringify(metaKind)
					fail('Number literal of type `\(name)` fail, probably standard library of the current target does not define `class \(name)` type', node)
				}

			case Float(v, metaKind):
				if metaKind == Meta.Float32 {
					types.set(node, typeFloat32)
				} else {
					types.set(node, typeFloat)
				}

				// `(e)`
			case Parenthesis(e):
				fillExpression(e)
				types.set(node, types.get(e))

				// `a ?? b`
			case Elvis(a, b):
				fillExpression(a)
				fillExpression(b)
				unify(types.get(a), types.get(b), b)
				types.set(node, types.get(b))

				// `e(elNames: el, ...)`
				// TODO show called function/method position
			case Call(e, el, elNames):
				// TODO validate `elNames`
				// JavaScript evaluates arguments first
				var constructor Type? = null
				switch e {
					case Super:
						if not allowSuper {
							fail('Cannot access `super` here', node)
						}

					case NodeTypeValue(t):
						// Constructor
						// TODO handle `<T>`
						// console.log('NodeTypeValue', e, project.data.get(e))
						// fillExpression(e, asValue: false)
						// let type = toType(t, node)
						let typeToCreate = toType(t, e)
						// TODO better idea
						let subj = find(DataHelper.extractTypeName(t))
						//
						parents.set(node, subj)
						// for e in el {
						// fillExpression(e)
						// }
						// console.log('Constructor!!', typeToCreate)

						switch typeToCreate {
							case ClassInstance(classType):
								if classType.constructor == -1 {
									fail('Cannot construct class without `new () {}` constructor', node)
								}

								switch classType.parent {
									case Class(t, extend, implement, f, external, classKind):
										// parents.set(e, f[classType.constructor])
										constructor = types.get(f[classType.constructor])
										switch constructor {
											case Function(args, returns, variadic):
												// TODO better idea
												if returns == typeVoid {
													constructor = Type.Function(args, typeToCreate, variadic)
												}
										}
										//
										// constructor =
										// typeToCreate
										// }
										// console.log('Constructor=', constructor)
								}

								// parents.set(node, subj)
								classType.useless = false
							case _:
								// TODO
								fail('Constructor may instantiate only classes', node)
						}

						// Typer()
						//
						//
						// var v = Typer(7)
						// v.z // TODO

						// types.set(node, type)
						// return

					case _:
						fillExpression(e)
				}

				fun evaluateArguments(el: [Node], expected: [Type]) {
					var arg = expected[0]
					for i in el.length {
						let e = el[i]

						switch e {
							// TODO write tests
							case Arrow(_): {
									expectedArrowType.set(e, arg)
								}
						}

						fillExpression(e)
						let argumentValueType = types.get(el[i])
						let expectedType = arg
						// `func(null)`
						inferNullType(argumentValueType, expectedType, el[i])
						unify(expectedType, argumentValueType, el[i])

						// Take the latest arg type in case of ...variadic
						arg = expected[i + 1] ?? arg
					}
				}

				@noCapture // TODO cause I wrote `return types.get(e)` not `return types.get(node)`
				fun obviousTyping(node: Node): Type {
					switch node {
						case Function(name, expr, vars, rettype, _, variadic):
							// console.log('obviousTyping', name)
							pushFuncParamsIfRequired(node)
							if let rettype = rettype {
								types.set(node, Type.Function(varTypes(vars), toType(rettype, node), variadic))
							} else {
								types.set(node, Type.Function(varTypes(vars), Type.Unknown({ handle: null }), variadic))
							}
							popFuncParamsIfRequired(node)
					}
					return types.get(node)
				}

				let eType = constructor ?? types.get(e) ?? obviousTyping(parents.get(e) ?? e)

				switch eType {
					case Function(args, returns, variadic):
						let provided = el.length
						// TODO actually those things must be a part of function type itself
						var expectedAtMax = args.length
						var expectedAtLeast = 0
						// TODO check that variadic is zero-or-many on all targets
						// var variadic = false
						let variadicLimit = 255 // TODO actual limit - `this` arg

						// TODO test ...rest to be at the latest position
						// TODO test optional=default to be at the latest positions
						for arg in args {
							expectedAtLeast++
							// if arg.rest {
							// variadic = true
							// expectedAtMax = variadicLimit
							// expectedAtLeast--
							// break
							// }
							if arg.optional {
								expectedAtLeast--
							}
						}

						if variadic {
							expectedAtMax = variadicLimit
							expectedAtLeast--
						}

						if provided < expectedAtLeast {
							// TODO `fun name` and args names too
							// TODO `fun is defined here`
							// console.log(args)
							fail('Not enough function arguments, required \(expectedAtLeast) but got only \(provided)', node)
						}

						if provided > expectedAtMax {
							// TODO `fun name` and args names too
							// console.log(args)
							fail('Too many function arguments, expected only \(expectedAtMax) but got \(provided)', node)
						}

						evaluateArguments(el, args.map(arg => arg.dataType))

						/*
				 			for i in el.length { if let arg = args[i] {
								let argumentValueType = types.get(el[i])
								let expectedType = arg
								// `func(null)`
								inferNullType(argumentValueType, expectedType)
				 				unify(expectedType, argumentValueType, el[i])
				 			}}*/
						types.set(node, returns)
						// TODO (name: )
						// TODO Not enough
						// TODO Too many
						// TODO ...rest
						// TODO optional args
						// TODO default args expressions+typing to use in normalization
						// TODO require names: if types of parameters the same too much
						// (bmp, 100, 200) ok
						// (bmp, 100, 200, 300, 400) not ok
						// (bmp, 100, 200, 300u16, 400u16) ok
						// TODO is const exprs >= 3 then require second names
						// "This function call is hard to read.\Replace this code: ... with this one: ..."
					case EnumConstructor(enumType, tag):
						// evaluateArguments(el, []) // TODO
						let name = enumType.fieldNames[tag]

						if el.length < enumType.tagBindVars[tag].length {
							fail('Not enough enum parameters, required `\(name)` parameters are: `' + enumType.tagBindVarsNames[tag].join('`, `') + '`', node)
						}

						if el.length > enumType.tagBindVars[tag].length {
							// TODO also print argument types (in short form) for clarity
							fail('Too many enum parameters, required `\(name)` parameters are: `' + enumType.tagBindVarsNames[tag].join('`, `') + '`', node)
						}

						// Don't allow `A.B()` syntax, require `A.B(a, b, c)` or just `A.B`
						if el.length == 0 {
							fail('Use syntax without empty `()`', node)
						}

						evaluateArguments(el, typesOfTagArguments(enumType, tag))
						types.set(node, Type.EnumInstance(enumType, tag))
						// TODO check arg types!
						// let x = Type.EnumInstance()
						// let x = Type.EnumInstance(123)
						// let x = Type.EnumInstance(123,4,5,6,78,9,0)
						// let x = Type.EnumInstance(name: 123)
					case null:
						evaluateArguments(el, [])

						// TODO
						// fail('Calling null ' + Node.stringify(e), e)
						// console.error('Calling null ' + Node.stringify(e))
					case _:
						evaluateArguments(el, [])

						if types.get(e) == typeAny {
							types.set(node, typeAny)
						} else {
							fail('Calling *not* a function, type is `' + Type.stringify(types.get(e)) + '`', e)
						}
				}

				// `a op b` like `a + b`
			case Binop(a, op, b):
				// fill(a) // TODO
				fillExpression(a)
				fillExpression(b)

				let typeA = types.get(a)
				let typeB = types.get(b)

				inferNullType(typeA, typeB, a)
				inferNullType(typeB, typeA, b)
				// var aa: Int = Token.Unequal
				// aa = Token.Unequal
				// var aazz: String = Token.Unequal
				// aazz = Token.Unequal
				// var aa = Token.Unequal
				// aa.g // TODO

				// Anything + String = String
				if op == Token.Add, typeA == typeString {
					types.set(node, typeString)
				} else
				if (
						op == Token.LogicalAnd or op == Token.LogicalOr
					) {
					let token = op == Token.LogicalAnd? 'and' : 'or'
					// let token = Token.stringify(op)
					if not booleanable(typeA) {
						// fail('Operator `a \(token) b` takes `a` of type `Bool` only, but got `\(Type.stringify(typeA))`', b)
						fail('Operator `a \(token) b` takes `a` of type `Bool` only, but got `\(Type.stringify(typeA))`', a)
					}
					if not booleanable(typeB) {
						// TODO textual static analysis: typeB-a should be typeB-b
						fail('Operator `a \(token) b` takes `b` of type `Bool` only, but got `\(Type.stringify(typeB))`', b)
					}
					// console.log(Type.stringify(typeA), Type.stringify(typeB), positionOf(node), Node.stringify(node))
					// console.log(Type.stringify(typeA), Type.stringify(typeB), a, b)
					types.set(node, typeBool)
				} else
				// Always provides boolean result
				if (typeA == typeB) and (typeA == typeString) and (
						(op == Token.GreaterOrEqual) or
						(op == Token.Greater) or
						(op == Token.LessOrEqual) or
						(op == Token.Less)
					) {
					types.set(node, typeBool)
				} else
				if op == Token.Equal or op == Token.Unequal {
					let booleans = (typeA == typeB) and (typeA == typeBool)
					let comparable = areComparable(typeA, typeB)
					let covariant = areCovariant(typeA, typeB)
					let nullableA = unwrapUnknownAndNullable(typeA)
					let nullableB = unwrapUnknownAndNullable(typeB)
					let nullable = nullableA == nullableB

					// Fill `a != null`
					inferNullType(typeA, typeB)
					inferNullType(typeB, typeA)

					/* Alternative version:
						if nullableB == null {
							switch typeB {
								case UnknownNullable(handle):
									if handle.value != null {
										throw 'TODO'
									}
									handle.value = nullableA
							}
						// TODO commutative due to `[]`: `switch [a, b] { case [null, UN(_)] or [UN(_), null]:`
						} else if nullableA == null {
							switch typeA {
								case UnknownNullable(handle):
									if handle.value != null {
										throw 'TODO'
									}
									handle.value = nullableB
							}
						}
						*/
					if not comparable, not booleans, not covariant, not nullable {
						let tokenString = Token.stringify(op)

						// TODO optimize in normalizer those simple returnable switches
						let leftString = switch a {
							case Null:
								'null'
							case _:
								Type.stringify(typeA)
						}

						let rightString = switch b {
							case Null:
								'null'
							case _:
								Type.stringify(typeB)
						}

						// TODO `null == null` should error cause no sense
						if leftString != 'null', rightString != 'null' {
							// TODO recommend `.address` for pointers
							fail('Operator `a \(tokenString) b` requires `a` and `b` of comparable types, but got `\(leftString)` and `\(rightString)`', b)
						}
					}

					types.set(node, typeBool)
				} else
				if (
						(op == Token.GreaterOrEqual) or
						(op == Token.Greater) or
						(op == Token.LessOrEqual) or
						(op == Token.Less) or
						(op == Token.Equal) or
						(op == Token.Unequal)
					) {
					let comparable = areComparable(typeA, typeB)

					if not comparable {
						let tokenString = Token.stringify(op)

						let leftString = switch a {
							case Null:
								'null'
							case _:
								Type.stringify(typeA)
						}

						let rightString = switch b {
							case Null:
								'null'
							case _:
								Type.stringify(typeB)
						}

						fail(
							'Operator `a \(tokenString) b` requires `a` and `b` of comparable non-nullable types, but got `\(leftString)` and `\(rightString)`',
							b
						)
					}

					// let equality = op == Token.Equal or op == Token.Unequal
					// let booleans = (typeA == typeB) and (typeA == typeBool)
					//
					//
					//
					// if booleans and equality {
					// // Ok
					// } else
					// if not comparable, not (booleans and equality) {
					// let tokenString = Token.stringify(op)
					//
					// // TODO optimize in normalizer those simple returnable switches
					// let leftString = switch a {
					// case Null:
					// 'null'
					// case _:
					// Type.stringify(typeA)
					// }
					//
					// let rightString = switch b {
					// case Null:
					// 'null'
					// case _:
					// Type.stringify(typeB)
					// }
					//
					// if equality, not areCovariant(typeA, typeB) {
					// // TODO `null == null` should error cause no sense
					// if leftString != 'null', rightString != 'null' {
					// fail('Operator `a \(tokenString) b` requires `a` and `b` of comparable types, but got `\(leftString)` and `\(rightString)`', b)
					// }
					// }
					//
					// if true {
					// fail('Operator `a \(tokenString) b` requires `a` and `b` of comparable types, but got `\(leftString)` and `\(rightString)`', b)
					// }
					// }

					types.set(node, typeBool)
				} else {
					// TODO replace without `??`
					var typeLeft = types.get(a) ?? types.get(b)
					var typeRight = types.get(b) ?? types.get(a)

					// TODO
					if typeLeft == typeUInt32, typeRight == typeInt {
						typeRight = typeUInt32
					}

					if typeLeft == typeUInt64, typeRight == typeInt {
						typeRight = typeUInt64
					}

					if typeLeft == typeUInt16, typeRight == typeInt {
						typeRight = typeUInt16
					}

					types.set(node, typeRight)

					// TODO More of them
					let mathTokens [Token] = [
						Token.BitwiseXor,
						Token.BitwiseOr,
						Token.BitwiseAnd
					]

					if mathTokens.includes(op) {
						// TODO could be optimized to ArrayByValue here
						// or just allocate a normal class on stack
						// cause values are possibly primitives?
						let integers = [
							typeInt,
							// TODO big int etc

							typeUInt64,
							typeUInt32,
							typeUInt16,
							typeUInt8,

							typeInt64,
							typeInt32,
							typeInt16,
							typeInt8
						]

						/// Allow bitwise operations on enum values when the enum is used as flags
						/// Both operands must be of the exact same enum type, and the enum must have
						/// an integer underlying type
						/// This enables common flag patterns such as `OptionA | OptionB`
						var enumFlags = true // Assume `true` until proven otherwise

						// And be an actual enum with type of tags defined as integer
						let enumLeft = switch typeLeft {
							case EnumInstance(enumTypeLeft):
								enumTypeLeft
							case Enum(enumTypeLeft):
								enumTypeLeft
							case _:
								null
						}

						let enumRight = switch typeRight {
							case EnumInstance(enumTypeRight):
								enumTypeRight
							case Enum(enumTypeRight):
								enumTypeRight
							case _:
								null
						}

						if enumLeft != null, enumRight != null {
							if enumLeft != enumRight {
								enumFlags = false
							}
							if not integers.includes(enumLeft.fieldsTypeSimple) {
								enumFlags = false
							}
						} else {
							// TODO limit enum bitwise ops to `|` according to spec
							enumFlags = false
						}

						// switch typeLeft {
						// case EnumInstance(enumTypeLeft):
						// switch typeRight {
						// case EnumInstance(enumTypeRight):
						// // First, flags should be of the same enum type
						// if enumTypeLeft != enumTypeRight {
						// enumFlags = false
						// }
						// // TODO check if enumType is flags and not just integers
						// if not integers.includes(enumTypeLeft.fieldsTypeSimple) {
						// enumFlags = false
						// }
						// case _:
						// enumFlags = false
						// }
						// case _:
						// enumFlags = false
						// }

						/// Error only if (not integer on left/right) AND (not enumFlags)
						if not integers.includes(typeLeft) or not integers.includes(typeRight), not enumFlags {
							let tokenString = Token.stringify(op)

							let leftString = switch a {
								case Null:
									'null'
								case _:
									Type.stringify(typeA)
							}

							let rightString = switch b {
								case Null:
									'null'
								case _:
									Type.stringify(typeB)
							}

							// console.log('enum', enumFlags, typeLeft == typeRight, typeLeft)
							fail(
								'Operator `a \(tokenString) b` requires `a` and `b` of integer types, but got `\(leftString)` and `\(rightString)`',
								b
							)
						}
					}
				}

				// `await e`
			case Await(e):
				if not insideAsync {
					fail('Cannot use `await` outside of async function', node)
				}
				fillExpression(e)
				// TODO if e is Promise<T>, return T
				types.set(node, types.get(e))

				// `op e` or `e op`
			case Unop(op, postfix, e):
				fillExpression(e)

				// Always provides boolean result
				if op == Token.KNot, not postfix {
					let exprType = types.get(e)
					// if exprType != typeBool, exprType != typeAny, exprType != null {
					if not booleanable(exprType) {
						fail('Operator `not value` takes `value` of type `Bool` only, but got `\(Type.stringify(types.get(e)))`', e)
					}
					types.set(node, typeBool)
					return
				}

				types.set(node, types.get(e))

				let mutates = op == Token.Increment or op == Token.Decrement
				// TODO ^ must allow only integer ++/--
				if not mutates { return }
				var parent: Node = parents.get(e)
				switch parent {
					case Var(name, _, _, const):
						let isStatic = project.mapStatic.get(parent) == true
						let prefix = isStatic ? 'static ' : ''
						if const {
							fail(
								'Cannot change a constant `\(prefix)let \(name)`, redefine it as `\(prefix)var \(name)` to allow value changes\n'
								+ positionOf(parent) + '`\(prefix)let \(name)` is defined here',
								node)
						}
					case Function(name, _):
						let prefix = project.mapStatic.get(parent) == true ? 'static ' : ''
						fail('Cannot `\(Token.stringify(op))` a function `\(prefix)fun \(name)`', node)
					case For(name, _):
						fail(
							'Cannot change iterator value `\(name)` of for loop\n'
							+ positionOf(parent) + '`for \(name) in ...` is defined here',
							node)
					case _:
						switch e {
							case Index(_):
							case Index2D(_):
							case Index3D(_):
								// Ok
								// Sets NaN to `[n]` in JavaScript if `[n] == null` and returns NaN
								// TODO maybe require `a[i] == a[i] ?? n + 1` instead?
								// cause also string/etc arrays...
							case _:
								let ops = Token.Increment? 'increment `++`' : 'decrement `--`'
								fail('You can \(ops) only a variable, .field or array element', node)
								// TODO `x={i:123} x.i++` <- by type and const factor
						}
				}

				// var hha = 1 // {i:1}
				{
					// TODO hha.i++
					// {++hha}
					// {hha}++
				}

				// `e[i]`
			case Index(e, i):
				fillExpression(e)
				fillExpression(i)

				let eType = types.get(e) as! Type
				let iType = types.get(i) as! Type

				// For now, only Int & Any index supported
				var indexableIsAny = false
				var indexableIsMap = false
				var mapKey: Type? = null
				switch eType {
					case ClassInstance(classType, generic):
						if classType.name == 'Any' { // TODO
							indexableIsAny = true
						}

						if classType.name == 'Map' { // TODO
							indexableIsMap = true
							mapKey = generic[0]
						}
					case Nullable(_):
						fail('Cannot index `\(Node.stringify(e))` because `\(Type.stringify(eType))` can be null, try to extract its value with `if let value = \(Node.stringify(e))`', e)
					case UnknownNullable(handle):
						fail('Cannot index `\(Node.stringify(e))` because `\(Type.stringify(eType))` can be null, try to extract its value with `if let value = \(Node.stringify(e))`', e)
				}

				if not indexableIsAny {
					switch iType {
						case Generic(_): // Ok
						case ClassInstance(classType):
							if
								// TODO check actual types
								not indexableIsMap,
								classType.name != 'Int',
								classType.name != 'UInt64',
								classType.name != 'UInt32',
								classType.name != 'UInt16',
								classType.name != 'UInt8',
								classType.name != 'Int64',
								classType.name != 'Int32',
								classType.name != 'Int16',
								classType.name != 'Int8',
								classType.name != 'Any',
								classType.name != 'UInt64'
							{
								fail('`value[index]` expects `index` only of type `Int` or similar, but got `' + Type.stringify(iType) + '`', e)
							}

							if indexableIsMap, iType != mapKey {
								// TODO `or similar` i.e. inherited classes etc covariance
								fail('`map[key]` expects `key` only of type `\(Type.stringify(mapKey))`, but got `' + Type.stringify(iType) + '`', e)
							}
						case _:
							// TODO is this even reachable?
							fail('`value[i]` expects `i` only of type `Int` or similar, but got `' + Type.stringify(iType) + '`', e)
						case null:
					} }

				// For now, only `Array[i]` and `Map[k]` supported
				switch eType {
					case ClassInstance(classType, generic):
						if generic != null, generic.length >= 1 {
							// TODO check actual types
							if classType.name == 'Map' {
								types.set(node, generic[1])
							} else {
								types.set(node, generic[0])
							}
							// TODO check actual types
						} else if ['Buffer', 'Uint8Array', 'Uint32Array'].includes(classType.name) {
							types.set(node, toType(NodeType.Type("Int", null), node))
							// TODO check actual types
						} else if ['Any'].includes(classType.name) {
							types.set(node, toType(NodeType.Type("Any", null), node))
						} else {
							fail('Cannot index `\(Node.stringify(e))` because `\(Type.stringify(eType))` is not indexable', e)
							// fail('value[i] generic is null or >1', e) TODO
						}
					case _:
						fail('Cannot index `\(Node.stringify(e))` because `\(Type.stringify(eType))` is not indexable', e)
					case null:
						fail('Cannot index `\(Node.stringify(e))` because its type cannot be inferred', e)
				}

				// `a op= b`
			case AssignOp(a, op, b):
				// `===`
				if op == Token.Equal {
					fail('`===` not supported, use `strictEqual`', node)
				}
				// `!==`
				if op == Token.Equal {
					fail('`!==` not supported, use `strictNotEqual`', node)
				}

				fillExpression(a)
				let parent: Node = parents.get(a)
				switch parent {
					case Var(name, _, _, const):
						if const {
							fail(
								'Cannot change a constant `let \(name)`, redefine it as `var \(name)` to allow value changes\n'
								+ positionOf(parent) + '`let \(name)` is defined here',
								node)
						}
					case Function(name, _):
						fail('Cannot reassign a function `\(name)`', node)
					case For(name, _):
						fail(
							'Cannot change iterator value `\(name)` of for loop\n'
							+ positionOf(parent) + '`for \(name) in ...` is defined here',
							node)
					case _: // Ok
				}
				fillExpression(b)
				types.set(node, unify(types.get(a), types.get(b), b))

				// `throw e`
			case Throw(e):
				if not insideFunction, not insideTry {
					fail('Cannot throw outside of `function` or `try`', node)
				}
				if insideFunction, not functionAllowedToThrow {
					fail('Cannot throw in a @noThrow function', node)
				}
				if insideFunction {
					functionThrows = true // Infer that function throws
				}
				fillExpression(e)

				// `this`
			case This:
				if not insideClassMethod {
					fail('Cannot access `this` outside of class method', node)
				}

				if thisType == null {
					fail('Cannot access `this` in the static method', node)
				}

				// switch thisType {
				// case Class(_): fail('not instance ' + Type.stringify(thisType), node)
				// case ClassInstance(t, g):
				// if t.name == 'Array', g[0] == null {
				// //fail('!instance ' + Type.stringify(thisType), node)
				// }
				// } TODO
				types.set(node, thisType)
				parents.set(node, thisNode)

				// `super`
			case Super:
				fail('Cannot use `super` as value', node)

				// `return e`
			case Return(e):
				// TODO cannot return from constructor
				switch e {
					case Var(name, _, _, const):
						let prefix = const? 'let' : 'var'
						fail(
							'This `return` tries to return a variable `\(prefix) \(name)`. Try to wrap it into braces like this `{ return } \(prefix) \(name)`',
							node
						)
					case Return(_):
						fail('Cannot return another return. Try to wrap first `{ return } return 2` into braces', node)
				}
				if not insideFunction {
					fail('Cannot use `return` outside of function', node)
				}
				if e != null {
					if functionReturnsAType == typeVoid {
						fail('Function returns `Void`, cannot return a value here', e)
					}
					fillExpression(e)
					let ret = types.get(e)
					if ret == typeVoid {
						fail('Cannot `return` a `Void` non-value', node)
					}

					// TODO test this `return null`
					inferNullType(ret, functionReturnsAType)

					functionReturnsAType = unify(functionReturnsAType, ret, e)
					functionActuallyReturns = true
				} else {
					if let ret = functionReturnsAType {
						if ret != typeVoid {
							fail('Expected `return value` of type `\(Type.stringify(ret))`', node)
						}
					} else {
						functionReturnsAType = typeVoid
					}
				}

				// Errors
			case Underscore:
				fail('Cannot use underscore `_` outside of case pattern', node)
			case Module(_):
				// fail('Modules should be at a file upper scope', node) TODO

				// Not expressions
			case Break:
				fail('Cannot use `break` as a value', node)
			case Continue:
				fail('Cannot use `continue` as a value', node)
			case Class(_):
				fail('Cannot use `class` as a value', node)
			case Enum(_):
				fail('Cannot use `enum` as a value', node)
			case TypeAlias(_):
				fail('Cannot use `declare` as a value', node)
			case Import(_):
				fail('Cannot use `import` as a value', node)
			case Var(name, _, _, const):
				let prefix = const? 'let' : 'var'
				fail('Cannot use `\(prefix) \(name)` as a value', node)
			case Switch(_):
				fillSwitch(node, true)
			case While(_):
				fail('Cannot use `while` as a value', node)
			case For(_):
				fail('Cannot use `for` as a value. To build array from loop, surround with `[for]` brackets.', node)

				//// Fallback
				// case ParametricIdent(name, params):
				// // TODO
				// let fallback = Node.Ident(name)
				// project.data.set(fallback, project.data.get(node))
				// fillExpression(fallback)
				// Fails
			case null:
				fail('Got null node' + never, node)
			case _:
				fail('Unknown node expression kind to type ' + node + never, node)
		}
	}

	let nullables: [Type : Type] = [:]
	fun asNullable(inputType: Type): Type {
		if let has = nullables.get(inputType) {
			return has
		}

		let spawned = Type.Nullable(inputType)
		nullables.set(inputType, spawned)
		return spawned
	}

	/// Sets the type of `null` which has `UnknownNullable` be default
	fun inferNullType(to: Type, fromValue: Type, node: Node? = null) {
		switch to {
			case UnknownNullable(handle):
				if handle.value == null {
					handle.value = unwrapUnknownAndNullable(fromValue)
					if let node = node {
						types.set(node, asNullable(unwrapUnknownAndNullable(fromValue)))
					}
				}
		}
	}

	/// `T?`
	fun isNullable(nullableType: Type): Bool {
		switch nullableType {
			case Nullable(_):
				return true
			case UnknownNullable(_):
				return true
		}

		return false
	}

	/// `T? => T`
	fun unwrapUnknownAndNullable(inputType: Type?): Type? {
		switch inputType {
			case null: return null
			case Nullable(innerType): return unwrapUnknownAndNullable(innerType)
			case Unknown(unknownType): return unwrapUnknownAndNullable(unknownType.value)
			case UnknownNullable(unknownNullableType): return unwrapUnknownAndNullable(unknownNullableType.value)
		}

		return inputType
	}

	fun fillSwitch(node: Node, value: Bool) {
		switch node {
			// TODO extracting like this is weird, Just pass arguments to fillSwitch
			case Switch(exprs, conds, guards, cases):
				for e in exprs { pushScope() fillExpression(e) popScope() }
				if let expr = exprs[1] {
					fail('Multiple switch values are not yet supported', expr)
				}

				let etype = unwrapUnknownAndNullable(types.get(exprs[0]))

				if etype == null {
					fail('Value of switch `\(Node.stringify(exprs[0]))` must have a known type at this position', exprs[0])
				}

				var enumType: EnumType? = null
				var shortHandSyntax = false

				// TODO typeArray
				// TODO typeMap?
				let switchable = [
					typeBool,
					typeInt,

					typeUInt64,
					typeUInt32,
					typeUInt16,
					typeUInt8,

					typeInt64,
					typeInt32,
					typeInt16,
					typeInt8,

					typeString
				]

				if switchable.includes(etype) {
					// Okay
				} else if etype == typeFloat {
					fail('Due to imprecise nature of `Float` type, switching over it is not allowed', exprs[0])
				} else {
					switch etype {
						case Enum(enType):
							enumType = enType
						case EnumInstance(enType, _):
							enumType = enType
						case _:
							fail('Cannot switch over `\(Type.stringify(etype))` type', exprs[0])
					}
				}

				// TODO if typeof(expr) == typeInt ... special code path
				// same for simple enums
				// and special for complex enums
				// and error on typeVoid, type unknown (not inferred) and etc
				// same for Normalizer

				// TODO support for simple (exhaustive checked) nested patterns
				// like A(true) A(false) and A(NonComplexEnum)
				// complex enums may break readability... but helpful for
				// shader langs? meh.. they require some computations
				// (like case normalization)
				// between pattern matching anyway

				// TODO guards
				// let expr = if (let expr = exprs[0]) expr else return
				// @guard let expr = exprs[0]
				// Node.TMacroExpansion <- for simple debug and print of
				// result of evaluated syntax @macro

				// TODO exprs is a positive array like
				// : [T, 1 ...] 1 or more elements, so [0] != don't require null check

				// TODO error on not-all-matched patterns of enum by default,
				// but @hint makes it only a hint and @ok to ignore

				// var matched: [String] = [] TODO
				var tags: [String] = []
				var i = 0

				// Avoid repeating tags `case Tag:` and values `case 123:`
				fun tagCheck(currentTag: String, e: Node) {
					if tags.includes(currentTag) {
						fail('Tag `\(currentTag)` already matched', e)
						// TODO .. at line (new and old)
					} else {
						tags.push(currentTag)
					}
				}

				while i < cases.length {
					pushScope()
					var e = conds[i]
					// Fill case condition `case pattern:`
					var currentType: EnumType? = null
					var currentTag: String? = null
					var currentTagBind = 0
					var interval = false

					fun follow(e: Node) {
						switch e {
							// `case E.T:`
							case DotUpper(ex, name):
								fillExpression(e)
								switch types.get(ex) as! Type {
									case Enum(enumType):
										currentType = enumType
										// TODO currentType = 123
										currentTag = name

										// This syntax is not supported anymore
										fail('Use `case \(currentTag)` instead of `case \(enumType.name).\(currentTag)`', e)

										if tags.includes(currentTag) {
											fail('Tag `\(currentTag)` already matched', e)
											// TODO .. at line
										} else {
											tags.push(currentTag)
										}
								}
							case Parenthesis(e): { fill(e) }
								// `case _:` default case
							case Underscore: { }

								// TODO error on complex enums
							case Null: { }
							case Bool(val):
								tagCheck('' + val, e)
								if etype != typeBool {
									fail('Cannot switch over boolean here', e)
								}
								// TODO MetaInt
							case Int(val):
								tagCheck('' + val, e)

								// TODO validate that values are within integer range of switch value
								// TODO big int?

								let validNumberTypes = [
									typeInt32,
									typeInt64,
									typeInt16,
									typeInt8,

									typeUInt32,
									typeUInt64,
									typeUInt16,
									typeUInt8,

									typeInt
								]

								if not validNumberTypes.includes(etype) {
									fail('Cannot switch over number here', e)
								}
							case String(val):
								tagCheck(val, e)
								if etype != typeString {
									fail('Cannot switch over string here', e)
								}
							case Call(ex, args, argNames): {
									// TODO rethink nested pattern mechanics
									// TODO don't follow nested patterns for now
									follow(ex)
									currentTagBind = 0

									if args.length == 0 {
										fail('Do not use `()` empty pattern, use `\(currentTag)(...)` syntax to ignore all bindings', e)
									}

									if
										let enumType = enumType,
										enumType.fieldsTypeSimple != null
									{
										fail('The `\(enumType.name)` is simple enum and has no `()` bindings', e)
									}

									if
										let enumType = enumType,
										shortHandSyntax == true,
										let i = enumType.fieldNames.indexOf(currentTag),
										let binds = enumType.tagBindVarsNames[i],
										binds.length == 0
									{
										switch args[0] {
											case Interval:
												// Okay
											case _:
												fail('The `\(currentTag)` has no `()` bindings, use `\(currentTag)(...)` syntax to ignore all future bindings added', e)
										}
									}

									for ee in args {
										if interval {
											fail('Do not match any patterns after `...` interval', ee)
										}

										switch ee {
											case Interval:
												interval = true
											case Ident(name):
												follow(ee)
												currentTagBind++
											case Underscore:
												if
													let enumType = enumType,
													shortHandSyntax == true,
													let i = enumType.fieldNames.indexOf(currentTag),
													let binds = enumType.tagBindVarsNames[i],
													binds.length <= currentTagBind
												{
													fail('Too many bindings ignored with `_` for `F` tag, use `...` syntax to ignore all future bindings', e)
												}

												currentTagBind++
											case _:
												fail('This case pattern is not supported', e)
										}
									}
								}

								// case TagName:
							case NodeTypeValue(t):
								shortHandSyntax = true
								switch t {
									case Type(name):
										// TODO `enumType ?? earlyTyping`
										if let enumType = enumType {
											if let i = enumType.fieldNames.indexOf(name), enumType.fieldEnumConstructor[i] == true {
												currentType = enumType
												currentTag = name
												if tags.includes(currentTag) {
													fail('Tag `\(currentTag)` already matched', e)
													// TODO .. at line
												} else {
													tags.push(currentTag)
												}
											} else {
												fail('The `\(name)` is not an enum constructor of `\(enumType.name)`', e)
												// fail('Available constructors are: ' + [
												// for (i in enumType.fieldNames.length) if (enumType.fieldEnumConstructor) {
												//
												// }
												// ].join(', '), e) TODO
											}
										} else {
											fail('This case pattern is not supported over non-enum types', e)
										}
									case _:
										fail('This case pattern is not supported', e)
								}
								// fail('This case pattern is not supported'+DataHelper.extractTypeName(t), e) TODO

							case Ident(name): // Bind (var)
								{
									if name.charAt(0) == name.charAt(0).toUpperCase() {
										fill(e)
									} else {
										addScope(name, e)

										// Find tag bind var and set it's type:
										if let currentType = currentType {
											let indexOf = currentType.fieldNames.indexOf(currentTag)
											if indexOf == -1 {
												fail('currentType.fieldNames.indexOf == -1', e)
											}

											let bindType =
												currentType.tagBindVarsTypes[indexOf][currentTagBind]
											??
											typesOfTagArguments(currentType, indexOf)[currentTagBind]
											// let nodeType = currentType.tagBindVars[indexOf][currentTagBind] TODO
											let name = currentType.tagBindVarsNames[indexOf][currentTagBind]

											if name == null {
												let available = currentType.tagBindVarsNames[indexOf].join(', ')
												if available.length == 0 {
													fail('No bindings available for `.' + currentTag + '`', e)
												}
												fail('Too many bindings requested for `\(currentTag)`, available are: ' + available, e)
											}

											if bindType != null {
												// types.set(e, toType(bindType, e)) TODO
												types.set(e, bindType)
											} else {
												fail('Internal error: tagBindVars has no type for ' + name, e)
											}
										} else {
											fail('No currentType for ' + name, e)
										}
									}
								}
							case Binop(a, op, b):
								if op == Token.BitwiseOr {
									follow(a)
									follow(b)
								} else {
									fail('This case pattern is not supported', e)
								}
							case If(econd, _, _):
								pushScope()
								fill(econd[0])
								popScope()
							case _:
								fail('This case pattern is not supported', e)
						}
					}
					follow(e)
					// Fill case result expression
					var e = cases[i]
					pushScope()

					if let guardian = guards[i] {
						fillExpression(guardian)
						if types.get(guardian) != typeBool {
							fail('Case `if` guard must be a simple boolean expression', guardian)
						}
					}

					if value == false {
						fill(e)
					}
					if value == true {
						fillExpression(e)
						if types.get(node) == null {
							types.set(node, types.get(e))
						} else {
							types.set(node, unify(types.get(node), types.get(e), e))
						}
					}
					popScope()

					popScope()
					i++
				}
		}
	}

	fun typesOfTagArguments(enumType: EnumType, tag: Int): [Type] {
		var types = enumType.tagBindVarsTypes[tag]
		let nodeTypes = enumType.tagBindVars[tag]
		let nodes = enumType.tagBindVarsNodes[tag]

		if types.length == nodeTypes.length {
			return types
		}

		types = nodeTypes.map(
			(nodeType, i) => toType(nodeType, nodes[i])
		)

		enumType.tagBindVarsTypes[tag] = types

		return types
	}
}
