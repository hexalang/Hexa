	static fun isFrozen(obj: Any): Bool { return false }
	static fun isSealed(obj: Any): Bool { return false }
	static fun getOwnPropertyDescriptor(obj: Any, prop: String): Any? { return null }
	static fun getOwnPropertyDescriptors(obj: Any): Any { return null }
}

// Set-like collections — real array-backed generic classes (the typer keeps
// constructor type args now, see `Promise` above)
@final
@asIs
class Set<T> {
	// Number of live entries (kept in sync by `add`/`delete`/`clear`)
	var size: Int = 0
	private let items: [T] = []

	new () { }

	fun add(value: T): Set<T> {
		if not items.includes(value) {
			items.push(value)
			size = items.length
		}

		return this
	}

	fun has(value: T): Bool {
		return items.includes(value)
	}

	fun delete(value: T): Bool {
		let index = items.indexOf(value)

		if index == -1 {
			return false
		}

		items.spliceAndInsert(index, 1, [])
		size = items.length
		return true
	}

	fun clear(): Void {
			items.spliceAndInsert(0, items.length, [])
		size = 0
	}

	fun forEach(f: (value: T, key: T, set: Set<T>) => Void): Void {
		let count = items.length
		var i = 0

		while i < count {
			if let value = items.get(i) {
				f(value, value, this)
			}

			i++
		}
	}
}

