/// Does not return a value
enum Statement {
	/// Multiple statements *not* wrapped into a block
	// TODO get rid of this, use meta blocks like native gen (currentBlock push/pop)
	Statements(el [Statement])

	/// Expression used as statement
	// TODO Expression(expr Expression)

	Block(el [Statement])
	Call(e Expression, args [Expression], expects [Type], kind CallKind)
	// TODO why need same `Call` here when we have same expression?
	Var(name String, expr Expression, dataType Type /*NiceType, readonly Bool*/)
	// TODO ^ expr is nullable
	// CapturedVar
	Const(name String, expr Expression, dataType Type)
	Function(name String, expr Statement, args [String], defaults [Expression], funcType Type, variadic VariadicKind, isAsync Bool)
	// TODO ^ funcType to plain class, so no need to pattern match it
	Return(e Expression) // TODO Null?
	If(econd Expression, eif Statement, eelse Statement) // TODO Null?
	Try(expr Expression, t [Type], v [String], catches [Statement], temp String)
	Throw(value Expression)
	Assign(name Expression, value Expression, to Type)
	// TODO ^ more precise assign, like `Assign[Class/Enum][Global/Static]Var`
	// ^ same for reading values
	Assignop(name Expression, op Token, value Expression)
	// TODO ^ `AssignOp`
	For(name String, over Expression, by Statement, reverse Bool)
	// TODO why not separate `DoWhile`?
	While(econd Expression, e Statement, pre Bool)
	Increment(e Expression)
	Decrement(e Expression)
	/// Pattern-matching switch (guards/binds) — the normalizer must lower it
	PatternSwitch(expr Expression, cases [[Expression]], statements [Statement], guards [Expression], binds [[Statement]])
	/// C-like switch with multiple values per case — `case 1: case 2: { … }`
	PlainSwitch(expr Expression, cases [[Expression]], statements [Statement])
	Continue
	Break
	// TODO .BreakFromLoop(nah) .BreakFromSwitch
	SuperConstructor(args [Expression])
	// TODO seems like types *here* `EnumValue(e THISTYPE)` not checked

	/// Can be re-allocated (on stack)
	// TODO NotNeededStack(name String)
	// UnwrapNullable
	// ToNullable `Int? = 123` also do it for array elements `[Int?] = [1, 2]`
	// ToString(value, fromNullable Bool)
	// IsNull instead of ==null null==, IsNotNull

	/// Can be un-counted (ARC--)
	// TODO it is better to unref early, not a func return
	// TODO NotNeededRef(name String)

	RefInc(name [Expression])
	// TODO capture `let` with `[=]`
	DeferRefDec(name [Expression])
}

/// Returns a value
// TODO assign overall expr type in norm where positions set?
// TODO unindent
// TODO must contain position information
enum Expression {
	String(s String)
	// TODO : Int32
	Int(v Int)
	MetaInt(v BigInt, kind Meta, dataType Type)
	// TODO UInt32, BigInt
	// TODO : Float
	Float(v Float)
	// TODO Avoid allocation of every Expression.True or
	@singletonTag
	True
	// static let exprTrue = Expression.True
	False
	// TODO `underscore Bool` for idents?
	Ident(name String, dataType Type)
	// TODO ^ `(name and originalName)`
	// TODO ^ instead of `globalAccessor` just add `kind Global/Local`
	// TODO ^ `LocalVar`
	// Reference(name NiceName, type Type)
	// NativeIdent(s String) // Just textual as is, sorta hack
	Null(nullOf Type)
	// TODO UnwrapNullable
	This(me Type)
	Dot(expr Expression, name String, result Type) // TODO Field index instead of name string
	// Dot(expr Expression, name String, result Type, renamed Bool `= false`) // TODO default enum values
	// TODO ^ resolved references, not `expr Expression, name String`
	// ^ but instead something precise like `ClassStaticField`, `LocalVar`, `CapturedVar`
	// Field(expr Expression, field Int)
	// DynamicField(expr Expression, name String, result Type)
	Call(e Expression, args [Expression], result Type, kind CallKind)
	// CallMethod(e, name, rags)
	// ^ todo expects
	New(e Expression, args [Expression], result Type)
	Binop(a Expression, op Token, b Expression, result Type)
	Function(name String, expr Statement, args [String], defaults [Expression], funcType Type, isAsync Bool)
	Arrow(expr Expression, args [String], defaults [Expression], types [NodeType], returns NodeType, funcType Type, isAsync Bool)
	// TODO ^ why this even needed? Just use Function
	Parenthesis(inner Expression)
	Object(names [String], el [Expression], types [NodeType])
	Array(values [Expression], arrayType Type)
	Map(keys [Expression], values [Expression], keyType Type, valueType Type, mapType Type)
	Unop(op Token, postfix Bool, e Expression)
	Await(e Expression)
	Elvis(nullable Node, otherwise Node)
	If(econd Expression, eif Expression, eelse Expression) // TODO Null?
	Index(expr Expression, index Expression, result Type)

	// TODO rename to `UnsafeCast`
	UnsafeBitCast(expr Expression, to Type)
	Is(expr Expression, of Type)

	/// `nullable!`
	RemoveNullability(expr Expression, result Type)

	/// `name op= value`
	Assignop(name Expression, op Token, value Expression)
	NativeOperator(kind NativeOperatorKind, args [Expression], name String, params [Type], result Type)
	// TODO params [Type]?

	/// `switch expr.tag` extracts tag for `case tag` patterns
	EnumTag(expr Expression)

	/// Type.TagName(args)
	Enum(enumType String, tagName String, tag Expression, args [Expression])

	/// `case E.N(parameter1, parameter2):` does `parameterN` extraction
	EnumParameter(expr Expression, index Int)

	/// `_` used in case patterns (when native enums enabled)
	Underscore

	/// `...expr`
	Spread(expr Expression)

	/// `"hello" + "world"
	StringConcatenation(leftString Expression, rightString Expression)

	/// `"string"[index]` produces `String?`
	StringIndex(expr Expression, index Expression, result Type)
}

enum NativeOperatorKind : Int {
	// `valueA operator valueB`
	Infix = 0

	// `operator(value)`
	Function = 1 // TODO rename to Functional/Callable

	// `operator value`
	Prefix = 2

	// `value operator`
	Postfix = 3
}

enum CallKind : Int {
	Static = 10
	Function = 11 // TODO rename to Callable
	VirtualMethod = 12
	// TODO KnownVirtualMethod = 13
	/// Capturing call (F1.2): the callee is a lifted closure (`closure$N`)
	/// and the call must pass the env first (fat-call shape). Shares the
	/// thin-call printing today (genC treats it like `Function`) — the env
	/// half threads through once the ClosureLifter goes fat per D1
	Closure = 13
}

enum VariadicKind : Int {
	NotVariadic = 10
	NativeVariadic = 11
}

enum CallingConvention : Int {
	Default
	FastCall
	CDecl
	StdCall
}

class NiceLink {
	/// `@rename`
	// TODO this is a workaround until proper underscores in normalizer
	// TODO `@as`
	var rename String?
	/// `@linkName` sets `asm("non mangled name")`
	var linkName String?
	/// `@dllExport` sets `__declspec(dllexport)`
	var dllExport = false
	/// `@dllImport` sets `__declspec(dllimport)`
	var dllImport = false
	/// `@emitHeader` forces header emit for external `declare` statements
	var emitHeader = false
	/// `@customHeader(string)` sets header overriding code generator
	var customHeader String? = null
	/// `@convention` sets `__attribute__((fastcall))`
	var convention CallingConvention = CallingConvention.Default
	/// `@aligned(64)` sets `__attribute__((aligned(64)))`
	var aligned Int? = null
	new () { }
}

enum Memory : Int {
	Modern64 = 64
	Old32 = 32
}

class NiceProject {
	let interfaces [NiceClass] = []
	let classes [NiceClass] = []
	let enumsSimple [NiceSimpleEnum] = []
	let enumsComplex [NiceComplexEnum] = []
	let globalLink [Statement : NiceLink] = [:]
	let globalVars [Statement] = []
	let globalFuncs [Statement] = [] // TODO rename to `globalFunctions`
	// Auto-require consts: var name → module name (`declare let fs` +
	// `@require("fs")` ⇒ `const fs = require("fs")`). Only referenced
	// bindings are recorded here (normalizer filters via usedRequires),
	// so unused modules emit nothing.
	let globalRequires [String : String] = [:]
	let init [Statement] = []
	var package Package
	var typer Typer
	let expressionType [Expression : Type] = [:]
	let expressionPosition [Expression : NodeData] = [:]
	let statementPosition [Statement : NodeData] = [:]
	let native [Expression : Bool] = [:]
	var mapDecorators [Node : [Decorator]] = [:]
	var memory = Memory.Modern64
	/// S3b: env globals whose creation fills were dropped (field/global/var
	/// initializers have no owning statement list). Pair/direct uses of these
	/// closures fall back to the GLOBAL slot (S2-identical) instead of the
	/// per-instance local twin (which was never emitted).
	var droppedClosureEnvs [String : Bool] = [:]
	/// Body-less `declare fun` signatures (no Nice `globalFuncs` entry to read
	/// expects from). Filled at normalize time from typer types keyed by the
	/// renamed Nice name; read by genC `callExpects` Ident fallback so
	/// `Any_$toString_(String)` etc. convert (D8-style, small).
	var declareTypes [String : Type] = [:]
	// Escape census (report-only, no promotion yet): function key
	// (global name or `Class_$method`) -> per-arg escaping flags.
	// Filled by ReflectLowerer after lowering; backends ignore it for now.
	// Single-level + call-graph fixpoint, over-approximate by design.
	let funcArgEscape [String : [Bool]] = [:]

	new () { }
}

enum ClassBinaryInterface : Int {
	Normal = 10
	// TODO `Reuse = Normal`
	// TODO `Reuse = Normal++` or `Normal + 1`
	// TODO `Reuse` // Implies `Normal + 1`
	StructureNoVirtual = 20
	/// Closure helper env (F1.3/F10.3, S4): synthesized `Env$N` classes.
	/// genC auto-generates the `call(Any**, argc)` dynamic-call thunk slot
	/// for these (plain `Normal` helpers get none). Structural vtables need
	/// nothing new — the kind is exactly "genC, make the Any-callable thunk".
	Closure = 30
}

class NiceClass {
	new () { }
	var external Bool
	var useless Bool

	/// Fully-renamed type name, additional postfixes are not needed
	var name String

	/// Name from Hexa source code, useful for debugging
	// var originalName String
	// var file String
	// var line Int

	var extend String?
	var genericParams [String]
	var api ClassBinaryInterface

	/// The more - the earlier in code gen
	/// Fixes forward declaration incomplete type error for by-value structures
	var usedByValueDepth Int = 0

	/// Class itself is a generic instance of a template class
	var implementationForGenericParams [Type] // TODO `[NiceClass]`

	/// Class itself is a generic template
	var template Bool = false
	var classType Type

	var implement String
	var implementParams [String]
	var rename Int
	var constructor
	// `@destructor` instance method (renamed Nice name) — called by the ARC
	// sweep before freeing the object. Null when the class declares none.
	var destructor String?
	// Synthesized container destroy (F11.2, ARC-marked): 0 none, 1 Array
	// element walk + buffer free, 2 Array buffer free only (unmanaged
	// elements), 3 Map inner-array release. The sweep calls the destroy via
	// the destroy table before freeing the struct (additive dead code until
	// the sweep lands, like the S4 thunks).
	var destroyKind Int = 0
	// TODO native kind: class, union, struct

	var staticMethods [Statement] = []
	// TODO ^ actual NiceMethods instead of Function statements, cause closures, is-virtual methods, throws etc
	var staticVars [Statement] = []
	var methods [Statement] = []
	var vars [Statement] = []
	var varBits [Int?] = []
	// `@weak` instance fields (renamed Nice names): weak links — ARC stores
	// into them without retaining and releases nothing on overwrite (the
	// intern-table `next` links: buckets must not own, destroy unlinks).
	// Reads are unaffected (locals still take transient shares).
	var weakFields [String] = []
	// TODO let renames [String] = []
	let property [String] = [] // `var/let { get ?set }`

	var jsRequire String? = null
	var jsNative String? = null
}

class NiceSimpleEnum {
	new () { }
	var name String
	var external Bool
	var names [String]
	var values [Expression]
	var staticMethods [Statement] = []
	var staticVars [Statement] = []
}

class NiceComplexEnum {
	new () { }
	var name String
	var external Bool
	var names [String]
	var constructors [[String]]
	var constructorsTypes [[Type]]
	var types [[NodeType]]
	var staticMethods [Statement] = []
	var staticVars [Statement] = []
	var expose Bool
}

