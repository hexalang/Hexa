/// Post-closure lowering (PoC), runs AFTER ClosureLifter and BEFORE
/// ArcInserter (see `source/main.hexa` order). Generators stay thin: this
/// pass rewrites genC-flavored Nice into plainer Nice that calls explicit
/// static helpers, so genC converges toward a pure C AST printer.
///
/// PoC scope: scalar `.toString()` only. `x.toString()` on a scalar
/// receiver (`Int`/`Int64`/`UInt64`/`Float`/`Bool`/narrow ints) has no
/// vtable — genC's `scalarToString` emits `String_$from*` helpers instead
/// of `int->_->toString_` (invalid C). This pass lowers the same shape in
/// Nice: `Call(Dot(scalar, 'toString'), [])` becomes an explicit
/// `Call(Dot(String, 'fromInt32'/'fromFloat'/...), [scalar])` with
/// `CallKind.Static`, reusing the tested static-call printer verbatim.
/// genC keeps its `scalarToString` branches untouched as fallback for every
/// shape this pass skips (dynamic, `Any`, nullable-unknown, missing
/// `String` class, non-empty args), so output stays green while the new
/// shape proves itself.
///
/// Bundle 2: object-literal → `Any` bag. `{ k: v, ... }` in an `Any`
/// position (`Var`/`Const`/`Assign`/`Return`/call args with `Any` target)
/// becomes explicit `Any_objectNew_()` + per-field `Any_objectSet_()`
/// statements hoisted into the owning list (closures pattern), with the
/// owner rewritten to use the bag temp. Field exprs are evaluated once,
/// in order, before the owner. Fat fields, missing declares, untyped and
/// non-hoistable positions keep the genC fallback untouched.
///
/// Direction map (#6): this pass owns struct→bag (static shape→dynamic).
/// The reverse — Any→struct (dynamic payload→static shape, genC
/// `printAnyToStruct` helpers) — has NO lowering yet; it stays in genC
/// until `Any`/bags become Nice classes (then bag reads become field
/// reads and the helpers disappear). Same dependency gates #4 (struct /
/// interface literal construction via `hexaNewBytes` + field `Assign`s —
/// blocked on encoding generic `sizeOf<T>()` calls in Nice IR).
///
/// Bundle 3: `Var(x, Null)` + conditional-`Assign` fusion. The `if let` /
/// `guard let` state machine emits `Var(temp_N, Null)` + `If(c){x=v;…}`
/// (single-assignment transfer slots rewritten — the proven source of the
/// `reassign-temp` census hits, problem-1 double-release candidates).
/// Adjacent pairs with pure conditions and hoist-free branches fuse into
/// `Var(x, If(c, v, Null))` (single assignment; the `If` stays with the
/// remaining branch statements). Scalarish/untyped temps keep the fallback
/// (harmless for ARC). Single eval, source order kept.
///
/// Ordering note: after ClosureLifter on purpose. Receivers may contain
/// lifted closures (`closure$N` values, `Env$N` fills) and `$nrest`/`$rest`
/// params — lowering here sees the final lifted bodies, while ARC still
/// sees the lowered explicit calls and counts them via its standard
/// `hexaMethodReturns` (+1 transfer for `String.from*`) path. Bag temps
/// take the standard retaining path (balanced, leak-free).
@final
class ReflectPostLowerer {
	var niceProject: NiceProject // The IR to mutate
	/// Lean trace: census + LOWERED/KEPT + REFLECT-POST-MISS + summary.
	let trace: [String] = []
	var scalarSites Int = 0
	var scalarLowered Int = 0
	var bagSites Int = 0
	var bagLowered Int = 0
	var intIfSites Int = 0
	var intIfLowered Int = 0
	var arrayAnySites Int = 0
	var arrayAnyLowered Int = 0
	var voidSites Int = 0
	var voidLowered Int = 0
	// Problem-1 triage census (report-only, never mutates): ARC double
	// releases come from guards releasing what the assignment path already
	// released. Compiler temps (`temp_*`) are single-assignment transfer
	// slots by construction, and `Const` bindings never rebind — any
	// violation logged here is a candidate root (or a rule-out when zero).
	var arcWarnTempReassign Int = 0
	var arcWarnConstReassign Int = 0
	var arcWarnDotOnTemp Int = 0
	/// Const-scope stack for the census (innermost first). `Var` shadows
	/// as non-const so inner rebinding never misfires on outer consts.
	let constStack: [[String : Bool]] = []
	/// Parallel stack recording each binding's declared type (for the
	/// `reassign-temp` WARN lines — problem-1 triage needs the temp's type
	/// to tell scalar slots from ARC-managed ones). Report-only.
	let typeStack: [[String : Type?]] = []
	/// Enclosing function key for census lines (mirrors the escape census
	/// `Class_$method` scheme loosely — `?` outside functions).
	var currentFuncName String = '?'
	/// Hoisted bag-build statements for the statement being rewritten.
	/// Drained by `processStatementList` / `rewriteStmtHoisted` / function
	/// bodies (closures pattern) — never held across statements.
	let hoisted: [Statement] = []
	var tempId Int = 0
	/// False in positions with no owning list (global/static/instance
	/// inits, default values): lowering bails to the genC fallback there.
	var hoistable Bool = true
	/// Declared return type of the function being rewritten (for the
	/// `Return` lowering site). Null outside functions.
	var currentReturn Type? = null

	new (niceProject: NiceProject) {
		this.niceProject = niceProject
	}

	/// TEMPORARY INSTRUMENTATION helper
	fun traceLog(line: String) {
		trace.push(line)
	}

	/// Main entry, same coverage shape as ClosureLifter lift
	fun lower() {
		for i in niceProject.globalFuncs.length {
			niceProject.globalFuncs[i] = rewriteFnStmt(niceProject.globalFuncs[i])
		}

		for c in niceProject.classes {
			for i in c.methods.length {
				c.methods[i] = rewriteFnStmt(c.methods[i])
			}

			for i in c.staticMethods.length {
				c.staticMethods[i] = rewriteFnStmt(c.staticMethods[i])
			}

			processVarList(c.vars)
			processVarList(c.staticVars)
		}

		for e in niceProject.enumsSimple {
			processVarList(e.staticVars)

			for i in e.staticMethods.length {
				e.staticMethods[i] = rewriteFnStmt(e.staticMethods[i])
			}
		}

		for e in niceProject.enumsComplex {
			processVarList(e.staticVars)

			for i in e.staticMethods.length {
				e.staticMethods[i] = rewriteFnStmt(e.staticMethods[i])
			}
		}

		processVarList(niceProject.globalVars)

		if niceProject.init.length > 0 {
			let wrapped = processStatementList(niceProject.init)
			niceProject.init.splice(0, niceProject.init.length)

			for s in wrapped {
				niceProject.init.push(s)
			}
		}

		traceLog('REFLECT-POST scalarToString sites=' + scalarSites + ' lowered=' + scalarLowered)
		traceLog('REFLECT-POST objectToBag sites=' + bagSites + ' lowered=' + bagLowered)
		traceLog('REFLECT-POST intIf sites=' + intIfSites + ' lowered=' + intIfLowered)
		traceLog('REFLECT-POST arrayAny sites=' + arrayAnySites + ' lowered=' + arrayAnyLowered)
		traceLog('REFLECT-POST void sites=' + voidSites + ' lowered=' + voidLowered)
		traceLog('REFLECT-POST-ARC-CENSUS tempReassign=' + arcWarnTempReassign + ' constReassign=' + arcWarnConstReassign + ' dotOnTemp=' + arcWarnDotOnTemp)
		traceLog('REFLECT-POST sigCacheMisses=' + sigCacheMisses)
		Fs.writeFileSync('reflect-post-trace.log', trace.join('\n'))
	}

	/// Census scope push (fresh map per function/list + func key for lines).
	fun pushScopeFor(name: String?): String {
		let prev = currentFuncName

		if name != null {
			currentFuncName = name
		} else {
			currentFuncName = '?'
		}

		let m: [String : Bool] = [:]
		constStack.push(m)
		let tm: [String : Type?] = [:]
		typeStack.push(tm)
		return prev
	}

	/// Census scope pop (restores the enclosing map + func key).
	fun popScopeFor(prev: String) {
		if constStack.length > 0 {
			constStack.pop()
		}

		if typeStack.length > 0 {
			typeStack.pop()
		}

		currentFuncName = prev
	}

	/// Records a `Var`/`Const` binding in the innermost census scope.
	fun scopeBind(name: String, isConst: Bool, dataType: Type?) {
		if constStack.length > 0 {
			constStack[constStack.length - 1].set(name, isConst)
		}

		if typeStack.length > 0 {
			typeStack[typeStack.length - 1].set(name, dataType)
		}
	}

	/// Innermost-first const lookup (inner `Var` shadows outer `Const`).
	fun scopeLookupConst(name: String): Bool? {
		var i = constStack.length - 1

		while i >= 0 {
			if let v = constStack[i].get(name) {
				return v
			}

			i--
		}

		return null
	}

	/// Innermost-first type lookup (mirrors `scopeLookupConst`).
	fun scopeLookupType(name: String): Type? {
		var i = typeStack.length - 1

		while i >= 0 {
			if let v = typeStack[i].get(name) {
				return v
			}

			i--
		}

		return null
	}

	/// Report-only audit of an assign target for problem-1 shapes:
	/// reassigned compiler temps (single-assignment transfer slots),
	/// rebound `Const` names, and stores through temp-held bases.
	/// WARN lines carry the target's declared type (scalar vs
	/// ARC-managed) for triage.
	fun auditAssignTarget(t: Expression) { switch t {
			case Ident(name, _):
				if name.startsWith('temp_') {
					arcWarnTempReassign++
					var tname = 'null'

					if let tt = scopeLookupType(name) {
						tname = Type.stringify(tt)
					}

					traceLog('REFLECT-POST-ARC-WARN reassign-temp ' + name + ' type=' + tname + ' in ' + currentFuncName)
				}

				if scopeLookupConst(name) == true {
					arcWarnConstReassign++
					traceLog('REFLECT-POST-ARC-WARN assign-const ' + name + ' in ' + currentFuncName)
				}
			case Dot(base, _, _): switch base {
					case Ident(bname, _):
						if bname.startsWith('temp_') {
							arcWarnDotOnTemp++
							traceLog('REFLECT-POST-ARC-WARN dot-on-temp ' + bname + ' in ' + currentFuncName)
						}
					case _:
				}
			case _:
		} }

	/// Rewrites initializers of var and const lists in place. No owning
	/// list exists here (globals/statics/instance fields), so hoisting is
	/// off: bag lowering bails to the genC fallback in these positions.
	/// Runs under its own census scope (rebinds across lists are invisible
	/// to each other — documented limitation, log-only either way).
	fun processVarList(list: [Statement]) {
		let savedHoistable = hoistable
		hoistable = false
		let prevFunc = pushScopeFor(null)

		for i in list.length {
			let old = list[i]
			list[i] = rewriteVarInit(old)

			if list[i] != old {
				if let link = niceProject.globalLink.get(old) {
					niceProject.globalLink.set(list[i], link)
				}
			}
		}

		popScopeFor(prevFunc)
		hoistable = savedHoistable
	}

	/// Rewrites one var or const initializer expression
	fun rewriteVarInit(s: Statement): Statement { switch s {
			case Var(name, expr, dataType):
				return Statement.Var(name, rewriteExpr(expr), dataType)
			case Const(name, expr, dataType):
				return Statement.Const(name, rewriteExpr(expr), dataType)
			case _:
				return s
		} }

	/// Rewrites the body of a top-level function or method statement.
	/// Owns the hoisting scope and the census scope: bag builds drain
	/// into the body, `Var`/`Const` bindings are visible to the assign
	/// audit below.
	fun rewriteFnStmt(s: Statement): Statement { switch s {
			case Function(name, body, args, defaults, funcType, variadic, isAsync):
				let savedHoisted = drainHoisted()
				let savedHoistable = hoistable
				let savedReturn = currentReturn
				let prevFunc = pushScopeFor(name)
				hoistable = true
				currentReturn = returnTypeOf(funcType)
				hoistable = false
				let newDefaults = rewriteExprList(defaults)
				hoistable = true
				let newBody = rewriteStmt(body)
				let drained = drainHoisted()
				let kept = prependHoisted(newBody, drained)
				hoistable = savedHoistable
				currentReturn = savedReturn
				restoreHoisted(savedHoisted)
				popScopeFor(prevFunc)
				let result = Statement.Function(name, kept, args, newDefaults, funcType, variadic, isAsync)

				if let link = niceProject.globalLink.get(s) {
					niceProject.globalLink.set(result, link)
				}

				return result
			case _:
				return s
		} }

	/// Declared return type behind a function type (for the `Return`
	/// lowering site). Null when untyped — caller keeps the fallback.
	fun returnTypeOf(funcType: Type?): Type? { switch funcType {
			case Function(_, returns, _):
				return returns
			case _:
				return null
		} }

	/// Takes the pending hoisted statements, leaving the slot empty.
	fun drainHoisted(): [Statement] {
		let out: [Statement] = []

		for h in hoisted {
			out.push(h)
		}

		hoisted.splice(0, hoisted.length)
		return out
	}

	/// Restores a previously drained hoisted list (nesting save/restore).
	fun restoreHoisted(saved: [Statement]) {
		for s in saved {
			hoisted.push(s)
		}
	}

	/// Prepends hoisted statements to a function body: existing `Block`
	/// grows in place, anything else wraps (same rule as closures).
	fun prependHoisted(body: Statement, drained: [Statement]): Statement {
		if drained.length == 0 {
			return body
		}

		switch body {
			case Block(els):
				var k = drained.length

				while k > 0 {
					k = k - 1
					els.unshift(drained[k])
				}

				return Statement.Block(els)
			case _:
				let nel: [Statement] = []

				for d in drained {
					nel.push(d)
				}

				nel.push(body)
				return Statement.Block(nel)
		}
	}

	/// Result type carried by a `Dot` callee (`recv.toString` claims
	/// `String`), used as the lowered static-call result in statement
	/// position (which carries no result of its own).
	fun dotResultOf(callee: Expression): Type? { switch callee {
			case Dot(_, _, result):
				return result
			case _:
				return null
		} }

	/// Occurrence check for the null-var fusion below: does `e` name `x`
	/// anywhere (reads, writes, captures)? Conservative — unknown shapes
	/// count as hits so fusion only fires on fully-understood pairs.
	fun exprMentions(e: Expression, x: String): Bool { switch e {
			case Ident(name, _): return name == x
			case Dot(inner, _, _): return exprMentions(inner, x)
			case This(_): return false
			case Null(_): return false
			case String(_): return false
			case Int(_): return false
			case Float(_): return false
			case True: return false
			case False: return false
			case MetaInt(_, _, _): return false
			case Underscore: return false
			case Parenthesis(inner): return exprMentions(inner, x)
			case Binop(a, _, b, _): return exprMentions(a, x) or exprMentions(b, x)
			case Unop(_, _, inner): return exprMentions(inner, x)
			case RemoveNullability(inner, _): return exprMentions(inner, x)
			case Is(inner, _): return exprMentions(inner, x)
			case Index(a, b, _): return exprMentions(a, x) or exprMentions(b, x)
			case StringIndex(a, b, _): return exprMentions(a, x) or exprMentions(b, x)
			case Call(callee, args, _, _, _):
				if exprMentions(callee, x) { return true }

				for a in args {
					if exprMentions(a, x) { return true }
				}

				return false
			case New(callee, args, _):
				if exprMentions(callee, x) { return true }

				for a in args {
					if exprMentions(a, x) { return true }
				}

				return false
			case Array(vals, _):
				for v in vals {
					if exprMentions(v, x) { return true }
				}

				return false
			case Object(_, vals, _):
				for v in vals {
					if exprMentions(v, x) { return true }
				}

				return false
			case Map(ks, vs, _, _, _):
				for k in ks {
					if exprMentions(k, x) { return true }
				}

				for v in vs {
					if exprMentions(v, x) { return true }
				}

				return false
			case If(c, a, b, _):
				if exprMentions(c, x) or exprMentions(a, x) { return true }

				if b != null, exprMentions(b, x) { return true }

				return false
			case Elvis(a, b): return exprMentions(a as!Expression, x) or exprMentions(b as!Expression, x)
			case Await(inner): return exprMentions(inner, x)
			case UnsafeBitCast(inner, _): return exprMentions(inner, x)
			case Assignop(n, _, v): return exprMentions(n, x) or exprMentions(v, x)
			case Spread(inner): return exprMentions(inner, x)
			case CapturedVar(name, _): return name == x
			case EnumTag(inner): return exprMentions(inner, x)
			case Enum(_, _, tag, args):
				if exprMentions(tag, x) { return true }

				for a in args {
					if exprMentions(a, x) { return true }
				}

				return false
			case EnumParameter(inner, _): return exprMentions(inner, x)
			case StringConcatenation(l, r): return exprMentions(l, x) or exprMentions(r, x)
			case NativeOperator(_, args, _, _, _):
				for a in args {
					if exprMentions(a, x) { return true }
				}

				return false
			case Function(_, _, _, _, _, _): return true
			case Arrow(_, _, _, _, _, _, _): return true
			case _: return true
		} }

	/// Statement-level occurrence check (same contract as `exprMentions`).
	/// `Function`/`Arrow` count as hits (capture timing would change).
	fun stmtMentions(s: Statement, x: String): Bool { switch s {
			case Statements(els):
				for e in els {
					if stmtMentions(e, x) { return true }
				}

				return false
			case Block(els):
				for e in els {
					if stmtMentions(e, x) { return true }
				}

				return false
			case Call(e, args, _, _):
				if exprMentions(e, x) { return true }

				for a in args {
					if exprMentions(a, x) { return true }
				}

				return false
			case Var(name, expr, _):
				if name == x { return true }

				return exprMentions(expr, x)
			case Const(name, expr, _):
				if name == x { return true }

				return exprMentions(expr, x)
			case Function(_, _, _, _, _, _, _): return true
			case Return(e): return exprMentions(e, x)
			case Throw(v): return exprMentions(v, x)
			case If(c, a, b):
				if exprMentions(c, x) or stmtMentions(a, x) { return true }

				if b != null, stmtMentions(b, x) { return true }

				return false
			case Try(expr, _, _, catches, temp):
				if temp == x { return true }

				if stmtMentions(expr, x) { return true }

				for c in catches {
					if stmtMentions(c, x) { return true }
				}

				return false
			case Assign(n, v, _): return exprMentions(n, x) or exprMentions(v, x)
			case Assignop(n, _, v): return exprMentions(n, x) or exprMentions(v, x)
			case For(name, over, by, _):
				if name == x { return true }

				return exprMentions(over, x) or stmtMentions(by, x)
			case While(c, e, _): return exprMentions(c, x) or stmtMentions(e, x)
			case Increment(e): return exprMentions(e, x)
			case Decrement(e): return exprMentions(e, x)
			case PatternSwitch(expr, cases, statements, guards, binds):
				if exprMentions(expr, x) { return true }

				for c in cases {
					for e in c {
						if exprMentions(e, x) { return true }
					}
				}

				for st in statements {
					if stmtMentions(st, x) { return true }
				}

				for g in guards {
					if exprMentions(g, x) { return true }
				}

				for b in binds {
					for st in b {
						if stmtMentions(st, x) { return true }
					}
				}

				return false
			case PlainSwitch(expr, cases, statements):
				if exprMentions(expr, x) { return true }

				for c in cases {
					for e in c {
						if exprMentions(e, x) { return true }
					}
				}

				for st in statements {
					if stmtMentions(st, x) { return true }
				}

				return false
			case SuperConstructor(args):
				for a in args {
					if exprMentions(a, x) { return true }
				}

				return false
			case RefInc(es):
				for e in es {
					if exprMentions(e, x) { return true }
				}

				return false
			case DeferRefDec(es):
				for e in es {
					if exprMentions(e, x) { return true }
				}

				return false
			case Continue: return false
			case Break: return false
			case _: return true
		} }

	/// Clone for the purity-whitelisted condition shapes (never share one IR
	/// object between parents — the fused `Var` init and the kept `If` each
	/// need their own condition object).
	fun clonePureCond(e: Expression): Expression? { switch e {
			case Ident(name, t): return Expression.Ident(name, t)
			case This(me): return Expression.This(me)
			case Dot(inner, name, res):
				if let c = clonePureCond(inner) {
					return Expression.Dot(c, name, res)
				}

				return null
			case Parenthesis(inner):
				if let c = clonePureCond(inner) {
					return Expression.Parenthesis(c)
				}

				return null
			case Binop(a, op, b, res):
				if let na = clonePureCond(a) {
					if let nb = clonePureCond(b) {
						return Expression.Binop(na, op, nb, res)
					}
				}

				return null
			case Unop(op, post, inner):
				if let c = clonePureCond(inner) {
					return Expression.Unop(op, post, c)
				}

				return null
			case RemoveNullability(inner, res):
				if let c = clonePureCond(inner) {
					return Expression.RemoveNullability(c, res)
				}

				return null
			case Is(inner, of):
				if let c = clonePureCond(inner) {
					return Expression.Is(c, of)
				}

				return null
			case Null(t): return Expression.Null(t)
			case Int(v): return Expression.Int(v)
			case Float(v): return Expression.Float(v)
			case String(s): return Expression.String(s)
			case True: return Expression.True
			case False: return Expression.False
			case MetaInt(v, k, t): return Expression.MetaInt(v, k, t)
			case _: return null
		} }

	/// Purity gate for the fusion: the condition is duplicated (once in the
	/// fused `Var` init, once in the kept `If`), so it must be side-effect
	/// free. The `if let` machine builds `step==k && last!=null` from pure
	/// reads, which passes; anything effectful keeps the two-statement form.
	fun isPureMachineCond(e: Expression): Bool {
		return clonePureCond(e) != null
	}

	/// True for scalar (non-ARC) value types: fusing their null-var pairs
	/// has no ARC payoff (`Int` would even ping-pong with `tryLowerIntIf`),
	/// so they keep the fallback and the census stays focused on managed
	/// slots. Mirrors `scalarStaticForName` plus tri-state/bool shapes.
	fun isScalarishForFusion(t: Type?): Bool {
		if t == null {
			return false
		}

		switch t {
			case Nullable(inner): return isScalarishForFusion(inner)
			case UnknownNullable(handle):
				if handle.value != null {
					return isScalarishForFusion(handle.value)
				}

				return false
			case Unknown(handle):
				if handle.value != null {
					return isScalarishForFusion(handle.value)
				}

				return false
			case ClassInstance(c, _): return isScalarishName(c.name)
			case Class(c): return isScalarishName(c.name)
			case Enum(_): return true
			case EnumInstance(_, _): return true
			case _: return false
		}
	}

	/// Scalar class names (value types with no ARC traffic).
	fun isScalarishName(n: String?): Bool {
		if n == null {
			return false
		}

		return ['Int', 'Int8', 'Int16', 'Int32', 'Int64', 'UInt8', 'UInt16', 'UInt32', 'UInt64', 'Float', 'Float32', 'Number', 'Bool', 'Bool8', 'Bool32', 'SizeOfPointer', 'SignedSizeOfPointer', 'ClangChar'].includes(n)
	}

	/// Fuses `Var(x, Null(T))` + following `If(c, then, else)` into
	/// single-assignment `Var(x, If(c, v, Null(T)))` when `then` assigns `x`
	/// exactly once as its FIRST statement (hoist-free by construction —
	/// anything already-hoisted for `v` would precede the assign and fail
	/// the shape check, so no use-before-def can strand) and nothing else
	/// mentions `x`. The `if let`/`guard let` state machine
	/// (`Var(temp_N, Null)` + conditional `Assign`) is the proven source of
	/// the `reassign-temp` census hits (problem-1 double-release
	/// candidates); this is its fix. Keeps the `If` with the remaining
	/// branch statements (e.g. the `step` advance), drops it when nothing
	/// remains. `Int`/scalarish and untyped temps keep the fallback.
	/// Returns the replacement statements, or null when the pair must stay.
	fun tryFuseNullVar(first: Statement, second: Statement): [Statement]? { switch first {
			case Var(name, init, dataType):
				switch init {
					case Null(_):
						if dataType == null { return null }

						if isScalarishForFusion(dataType) { return null }

						switch second {
							case If(cond, thenB, elseB):
								if not isPureMachineCond(cond) { return null }

								var list: [Statement] = []

								switch thenB {
									case Block(els):
										for s in els { list.push(s) }
									case Statements(els):
										for s in els { list.push(s) }
									case _: list.push(thenB)
								}

								if list.length == 0 { return null }

								var val: Expression? = null

								switch list[0] {
									case Assign(t, v, _):
										switch t {
											case Ident(n, _):
												if n != name { return null }

												val = v
											case _: return null
										}
									case _: return null
								}

								if let vv = val {
									for k in list.length - 1 {
										if stmtMentions(list[k + 1], name) { return null }
									}

									if elseB != null, stmtMentions(elseB, name) { return null }

									let fused = Statement.Var(name, Expression.If(cond, vv, Expression.Null(dataType), dataType), dataType)
									var rest: [Statement] = []

									for k in list.length - 1 { rest.push(list[k + 1]) }

									if rest.length == 0 and elseB == null {
										return [fused]
									}

									if let cond2 = clonePureCond(cond) {
										return [fused, Statement.If(cond2, Statement.Block(rest), elseB)]
									}

									return null
								}

								return null
							case _: return null
						}
					case _: return null
				}
			case _: return null
		} }

	/// Post-pass over a rewritten statement list: fuses adjacent
	/// `Var(x, Null)` + conditional-`Assign` pairs into single-assignment
	/// form (see `tryFuseNullVar`). Preserves `globalLink` entries.
	fun fuseNullVarAssigns(stmts: [Statement]): [Statement] {
		let out: [Statement] = []
		var i = 0

		while i < stmts.length {
			if i + 1 < stmts.length {
				if let fused = tryFuseNullVar(stmts[i], stmts[i + 1]) {
					if let link = niceProject.globalLink.get(stmts[i]) {
						niceProject.globalLink.set(fused[0], link)
					}

					if fused.length > 1 {
						if let link2 = niceProject.globalLink.get(stmts[i + 1]) {
							niceProject.globalLink.set(fused[1], link2)
						}
					}

					for f in fused { out.push(f) }

					// The pre-fusion `reassign-temp` WARN above fired for this
					// pair during rewriting — this line marks it eliminated
					// (single assignment, no transfer-slot reassign for ARC).
					traceLog('REFLECT-POST-ARC-FUSED ' + currentFuncName)
					i += 2
					continue
				}
			}

			out.push(stmts[i])
			i++
		}

		return out
	}

	/// Raw pre-pass over an unrewritten statement list: fuses adjacent
	/// `Var(x, Null)` + conditional-`Assign` pairs BEFORE rewriting, so the
	/// fused `Var(x, If(c, v, Null))` flows through the normal value
	/// lowering (`tryLowerStructValue` whole-`If`, `tryLowerIntIf`,
	/// `tryLowerArrayAny`) with proper per-branch hoisting. This is what
	/// handles hoisted values (bag builds) that the post-pass must refuse
	/// (use-before-def). Consumed assigns never reach the rewrite audit, so
	/// the `reassign-temp` WARN only fires for pairs that survive both
	/// passes. Preserves `globalLink` entries.
	fun prefuseNullVarAssigns(els: [Statement]): [Statement] {
		let out: [Statement] = []
		var i = 0

		while i < els.length {
			if i + 1 < els.length {
				if let fused = tryFuseNullVar(els[i], els[i + 1]) {
					if let link = niceProject.globalLink.get(els[i]) {
						niceProject.globalLink.set(fused[0], link)
					}

					if fused.length > 1 {
						if let link2 = niceProject.globalLink.get(els[i + 1]) {
							niceProject.globalLink.set(fused[1], link2)
						}
					}

					for f in fused { out.push(f) }

					traceLog('REFLECT-POST-ARC-PREFUSED ' + currentFuncName)
					i += 2
					continue
				}
			}

			out.push(els[i])
			i++
		}

		return out
	}

	/// Rewrites a statement list, draining hoisted bag-builds before
	/// their owner (closures pattern — single eval, source order kept).
	fun processStatementList(els: [Statement]): [Statement] {
		let pre = prefuseNullVarAssigns(els)
		let out: [Statement] = []

		for s in pre {
			let saved = drainHoisted()
			let savedHoistable = hoistable
			hoistable = true
			let r = rewriteStmt(s)
			let drained = drainHoisted()
			hoistable = savedHoistable
			restoreHoisted(saved)

			for h in drained {
				out.push(h)
			}

			out.push(r)

			if r != s {
				if let link = niceProject.globalLink.get(s) {
					niceProject.globalLink.set(r, link)
				}
			}
		}

		return fuseNullVarAssigns(out)
	}

	/// Rewrites a single-statement child (branches, loop bodies, catches):
	/// hoisted bag-builds wrap into a block with their owner.
	fun rewriteStmtHoisted(s: Statement): Statement {
		let saved = drainHoisted()
		let savedHoistable = hoistable
		hoistable = true
		let r = rewriteStmt(s)
		let drained = drainHoisted()
		hoistable = savedHoistable
		restoreHoisted(saved)

		if drained.length == 0 {
			return r
		}

		return prependHoisted(r, drained)
	}

	/// Scalar receiver -> explicit `String.from*` static name, mirroring
	/// genC `scalarToString` (decimal only, radix dropped in Phase 1).
	/// Null for every non-scalar shape (genC fallback owns those).
	fun scalarStaticFor(t: Type?): String? {
		if t == null {
			return null
		}

		switch t {
			case Nullable(inner):
				return scalarStaticFor(inner)
			case UnknownNullable(inner):
				return scalarStaticFor(inner)
			case Unknown(inner):
				return scalarStaticFor(inner.value)
			case ClassInstance(c, _):
				return scalarStaticForName(c.name)
			case Class(c):
				return scalarStaticForName(c.name)
			case _:
				return null
		}
	}

	/// Name-level mapping (both `Class` and `ClassInstance` shapes).
	/// Mirrors genC `scalarToString` + `printTypeConverter` (`UInt32`
	/// formats via `fromUInt64` — `fromInt32` would go negative over
	/// 2^31, same as the converter's `UInt32 -> String` arm).
	fun scalarStaticForName(name: String?): String? {
		if name == 'Int' or name == 'Int8' or name == 'Int16' or name == 'Int32' {
			return 'fromInt32'
		}

		if name == 'UInt8' or name == 'UInt16' {
			return 'fromInt32'
		}

		if name == 'UInt32' {
			return 'fromUInt64'
		}

		if name == 'Int64' {
			return 'fromInt64'
		}

		if name == 'UInt64' {
			return 'fromUInt64'
		}

		if name == 'Float' or name == 'Float32' or name == 'Number' {
			return 'fromFloat'
		}

		if name == 'Bool' {
			return 'fromBool'
		}

		return null
	}

	/// The `String` class type for the explicit static callee base.
	/// Null when unresolvable (caller keeps the genC fallback).
	fun stringClassType(): Type? {
		for c in niceProject.classes {
			if c.name == 'String' {
				return c.classType
			}
		}

		return null
	}

	/// Carried type behind an expression (fallback when the
	/// `expressionType` map entry was dropped by a pass rebuild).
	/// Literal arms mirror genC `getType` (shape-typed, never null).
	fun carriedTypeOf(e: Expression): Type? { switch e {
			case Ident(_, dataType):
				return dataType
			case This(me):
				return me
			case Dot(_, _, result):
				return result
			case Call(_, _, result, _, _):
				return result
			case New(_, _, result):
				return result
			case Binop(_, _, _, result):
				return result
			case Index(_, _, result):
				return result
			case StringIndex(_, _, result):
				return result
			case If(_, _, _, result):
				return result
			case Parenthesis(inner):
				return carriedTypeOf(inner)
			case UnsafeBitCast(_, to):
				return to
			case RemoveNullability(_, result):
				return result
			case Unop(op, postfix, inner):
				// Mirrors genC `getType`: `!x` is always `Bool`, else recurse.
				if not postfix, op == Token.KNot or op == Token.Exclamation {
					return niceProject.typer.typeBool
				}

				return carriedTypeOf(inner)
			case Array(_, arrayType):
				return arrayType
			case Int(_):
				return niceProject.typer.typeInt
			case Float(_):
				return niceProject.typer.typeFloat
			case String(_):
				return niceProject.typer.typeString
			case True:
				return niceProject.typer.typeBool
			case False:
				return niceProject.typer.typeBool
			case _:
				return null
		} }

	/// Receiver type: map first (survives for literals like `5`/`true`
	/// that carry no payload type), carried payload as fallback.
	fun baseTypeOf(e: Expression): Type? {
		if let t = niceProject.expressionType.get(e) {
			return t
		}

		return carriedTypeOf(e)
	}

	/// True for the dynamic `Any` shape that genC routes via reflection.
	fun isAnyType(t: Type?): Bool {
		if t == null {
			return false
		}

		return t == niceProject.typer.typeAny
	}

	/// Callee for the explicit bag construction. Uses the C name with the
	/// `native` flag, exactly like the normalizer-built call Idents for
	/// `@rename` declares (`malloc(...)` precedent prints raw). No
	/// existence check needed: genC emits the definition unconditionally.
	fun bagNewCallee(): Expression {
		let id = Expression.Ident('Any_objectNew_', null)
		niceProject.native.set(id, true)
		return id
	}

	/// Callee for the explicit field stores (same convention as above).
	fun bagSetCallee(): Expression {
		let id = Expression.Ident('Any_objectSet_', null)
		niceProject.native.set(id, true)
		return id
	}

	/// Callee for explicit D7 truthiness conversion (same convention as the
	/// bag callees — the C name prints raw; genC emits the definition
	/// unconditionally, so no existence check needed).
	fun toBoolCallee(): Expression {
		let id = Expression.Ident('Any_toBool_', null)
		niceProject.native.set(id, true)
		return id
	}

	/// Printed-shape test for the truthiness wrap (mirrors genC `cShape` /
	/// `binopShape`): true when the expression prints as a dynamic `Any_*`
	/// pointer, where C `&&`/`||`/`?:` would test pointer non-null instead of
	/// JS truthiness. Static shapes print scalar and keep the genC fallback.
	fun needsTruthinessWrap(e: Expression): Bool {
		if isAnyType(baseTypeOf(e)) {
			switch e {
				case Binop(_, op, _, _):
					// Logic/comparison/relational `Binop`s print scalar C
					// values despite an `Any` type — wrapping those would feed
					// a scalar to the pointer parameter. Arithmetic keeps the
					// wrap (it boxes to `Any_*` when the result is dynamic).
					if op == Token.KAnd or op == Token.LogicalAnd or op == Token.KOr or op == Token.LogicalOr or op == Token.Equal or op == Token.Unequal or op == Token.Less or op == Token.LessOrEqual or op == Token.Greater or op == Token.GreaterOrEqual { return false }
					return true
				case _:
					return true
			}
		}

		switch e {
			case Parenthesis(inner):
				return needsTruthinessWrap(inner)
			case Dot(base, _, _):
				// Dynamic root prints `Any_*` no matter what the use node claims.
				return isAnyType(baseTypeOf(base))
			case Index(base, _, _):
				return isAnyType(baseTypeOf(base))
			case Call(callee, _, _, _, _):
				switch callee {
					case Dot(base, _, _):
						return isAnyType(baseTypeOf(base))
					case Ident(_, _):
						return isAnyType(baseTypeOf(callee))
					case _:
						return false
				}
			case _:
				return false
		}
	}

	/// Wrap site for D7 truthiness (Bundle 4): `&&`/`||` operands and
	/// ternary conds that print as `Any_*` become explicit `Any_toBool_()`
	/// calls. Counts every examined site; wraps + traces only the dynamic
	/// ones. Static shapes fall through to the genC fallback untouched.
	fun wrapBoolIfNeeded(e: Expression): Expression {
		boolSites++

		if needsTruthinessWrap(e) {
			boolLowered++
			traceLog('REFLECT-POST-LOWERED bool ' + currentFuncName + ' kind=' + kindOfExpr(e))
			return Expression.Call(toBoolCallee(), [e], niceProject.typer.typeBool, CallKind.Function, [])
		}
		return e
	}

	/// True for plain bag fields: scalars and object pointers bridge to
	/// `Any` identically in the lowered `Any_objectSet` call and in the
	/// genC fallback, so no conversion can diverge. Nullable wrappers
	/// around plain shapes lower too (the set-call printer applies the
	/// same `Nullable -> Any` bridge the fallback uses; null flows as
	/// nullptr). Everything else (`Any` itself excluded as dynamic,
	/// `Function` needs pair boxing, `Struct`/generics/erased shapes need
	/// type-directed conversion) keeps the fallback.
	fun isPlainBagField(t: Type?): Bool {
		if t == null {
			return false
		}

		switch t {
			case Nullable(inner):
				return isPlainBagField(inner)
			case UnknownNullable(handle):
				if handle.value != null {
					return isPlainBagField(handle.value)
				}
				return false
			case Unknown(handle):
				if handle.value != null {
					return isPlainBagField(handle.value)
				}
				return false
			case ClassInstance(c, _):
				return c.name != 'Any'
			case Class(c):
				return c.name != 'Any'
			case _:
				return false
		}
	}

	/// Pure pre-gate: can this value lower to a bag without side effects
	/// beyond its own evaluation? Mirrors the commit paths exactly
	/// (same predicate, no pushes), so a pass here guarantees the commit
	/// cannot strand partial builds in `hoisted`. Logs blockers with a
	/// nesting path for triage; silent on success.
	fun canLowerValue(fv: Expression, where: String): Bool {
		switch fv {
			case Object(_, vals, _):
				for i in vals.length {
					if not canLowerValue(vals[i], where + '.' + i) {
						return false
					}
				}

				return true
			case _:
				let ft = baseTypeOf(fv)

				switch ft {
					case Struct(_, fts):
						for i in fts.length {
							if not canLowerType(fts[i], where + '.' + i) {
								return false
							}
						}

						return true
					case _:
						if not isPlainBagField(ft) {
							var typeName = 'null'

							if ft != null {
								typeName = Type.stringify(ft)
							}

							traceLog('REFLECT-POST-KEPT ' + where + ' kind=' + kindOfExpr(fv) + ' type=' + typeName)
							return false
						}

						return true
				}
		}
	}

	/// Pure pre-gate over a struct type's fields (same contract as above).
	fun canLowerType(t: Type?, where: String): Bool {
		if t == null {
			traceLog('REFLECT-POST-KEPT ' + where + ' untyped')
			return false
		}

		switch t {
			case Struct(_, fts):
				for i in fts.length {
					if not canLowerType(fts[i], where + '.' + i) {
						return false
					}
				}

				return true
			case _:
				if not isPlainBagField(t) {
					traceLog('REFLECT-POST-KEPT ' + where + ' type=' + Type.stringify(t))
					return false
				}

				return true
		}
	}

	/// Trial lowering: struct value in an `Any` position becomes an
	/// explicit bag build. Two heads share one tail:
	/// - object literal: field exprs (already rewritten) go straight into
	///   the per-field sets (no intermediate struct — fewer allocs than
	///   the genC shape, same order, same single eval);
	/// - any other struct-typed expression (`Ident`/`Dot`/`Call` result):
	///   hoists `Var($pspN, expr, structT)` once (single eval for
	///   side-effecting exprs), field reads are `Dot($pspN, f)` temps.
	/// Then: `Var($psbN, Any_objectNew_())` plus one
	/// `Any_objectSet_($psbN, "field", fieldExpr)` per field, returning
	/// the bag temp. Skips (genC fallback owns): non-hoistable positions,
	/// non-plain fields, untyped fields, length mismatches, non-struct
	/// shapes. Fat-typed fields can never pass the plain-field gate, so
	/// pair boxing stays in the fallback exactly as today.
	fun tryLowerStructValue(e: Expression, targetIsAny: Bool): Expression? {
		if not targetIsAny {
			return null
		}

		if not hoistable {
			traceLog('REFLECT-POST-KEPT struct no-hoist position')
			return null
		}

		switch e {
			case Object(names, vals, _):
				if names.length != vals.length {
					traceLog('REFLECT-POST-KEPT object length mismatch')
					return null
				}

				bagSites++

				if not canLowerFields(vals, 'object') {
					return null
				}

				return lowerObjectFields(names, vals)
			case If(cond, eif, eelse, _):
				// Conditional materialization: exactly one branch runs, so
				// each lowered branch builds inside its own block. Partial
				// lowering is sound only when the unlowered branch assigns
				// safely as-is (bridge/box/nullptr — same conversion the
				// fallback applies); fat/struct/untyped inline values would
				// mis-convert, so those keep the whole If on the fallback.
				bagSites++
				let okA = canLowerValue(eif, 'then')
				let okB = canLowerValue(eelse, 'else')
				var canA = okA
				var canB = okB

				if not canA {
					canA = inlineSafeAsAny(eif)
				}

				if not canB {
					canB = inlineSafeAsAny(eelse)
				}

				if canA {
					if canB {
						return lowerIfStruct(cond, eif, eelse, okA, okB)
					}
				}

				traceLog('REFLECT-POST-KEPT if unsafe branch')
				return null
			case _:
				let st = baseTypeOf(e)

				switch st {
					case Struct(snames, sfts):
						bagSites++

						if not canLowerTypeList(sfts, 'struct') {
							return null
						}

						return lowerStructExpr(e, st, snames, sfts)
					case _:
						return null
				}
		}
	}

	/// Pure pre-gate over a field-value list (no pushes, logs blockers).
	fun canLowerFields(vals: [Expression], where: String): Bool {
		for i in vals.length {
			if not canLowerValue(vals[i], where + '.' + i) {
				return false
			}
		}

		return true
	}

	/// Pure pre-gate over a struct type's fields (same contract).
	fun canLowerTypeList(fts: [Type], where: String): Bool {
		for i in fts.length {
			if not canLowerType(fts[i], where + '.' + i) {
				return false
			}
		}

		return true
	}

	/// Conditional lowering: temp + If statement with per-branch builds.
	/// `okA`/`okB` come from the pure pre-gate above, so both commits are
	/// infallible and hoist strictly inside their own block.
	fun lowerIfStruct(cond: Expression, eif: Expression, eelse: Expression, okA: Bool, okB: Bool): Expression {
		let anyT = niceProject.typer.typeAny
		let pst = '$pst' + tempId
		tempId++
		hoisted.push(Statement.Var(pst, Expression.Null(anyT), anyT))
		// Branch A builds into its own block (commits hoist here, in order).
		// Fresh Ident per use (same name = same variable; never share one
		// IR object between parents).
		let savedA = drainHoisted()
		var valA = eif

		if okA {
			if let loweredA = tryLowerStructValue(eif, true) {
				valA = loweredA
			}
		}

		var blockA: [Statement] = []

		for h in drainHoisted() {
			blockA.push(h)
		}

		restoreHoisted(savedA)
		blockA.push(Statement.Assign(Expression.Ident(pst, anyT), valA, null))
		// Branch B (same shape).
		let savedB = drainHoisted()
		var valB = eelse

		if okB {
			if let loweredB = tryLowerStructValue(eelse, true) {
				valB = loweredB
			}
		}

		var blockB: [Statement] = []

		for h in drainHoisted() {
			blockB.push(h)
		}

		restoreHoisted(savedB)
		blockB.push(Statement.Assign(Expression.Ident(pst, anyT), valB, null))
		hoisted.push(Statement.If(cond, Statement.Block(blockA), Statement.Block(blockB)))
		bagLowered++
		traceLog('REFLECT-POST-LOWERED if->bag')
		return Expression.Ident(pst, anyT)
	}

	/// Shared field pass (pre-gated by `tryLowerStructValue` — the checks
	/// below only re-verify defensively and never push before their own
	/// gate): nested struct values lower first (their build hoists before
	/// the outer sets that consume the inner bag temp); a nested failure
	/// keeps the whole outer object on the fallback (an inline nested
	/// literal would bypass materialization). Plain leaves pass through
	/// for the set-call conversion. Returns null when the outer object
	/// must stay on the fallback.
	fun lowerObjectFields(names: [String], vals: [Expression]): Expression? {
		if names.length != vals.length {
			traceLog('REFLECT-POST-KEPT object length mismatch')
			return null
		}

		var newVals: [Expression] = []

		for i in vals.length {
			if let fv = lowerFieldValue(vals[i], i) {
				newVals.push(fv)
			} else {
				return null
			}
		}

		return buildBag(names, newVals)
	}

	/// One field: nested struct shapes lower recursively, leaves take
	/// the plain gate (scalars/pointers convert identically in the set
	/// call and in the fallback). Null keeps the outer object.
	fun lowerFieldValue(fv: Expression, index: Int): Expression? {
		var nested = false

		switch fv {
			case Object(_, _, _):
				nested = true
			case _:
				nested = isStructShape(baseTypeOf(fv))
		}

		if nested {
			if let inner = tryLowerStructValue(fv, true) {
				return inner
			}

			traceLog('REFLECT-POST-KEPT object nested field[' + index + '] kept')
			return null
		}

		let ft = baseTypeOf(fv)

		if not isPlainBagField(ft) {
			var typeName = 'null'

			if ft != null {
				typeName = Type.stringify(ft)
			}

			traceLog('REFLECT-POST-KEPT object field[' + index + '] kind=' + kindOfExpr(fv) + ' type=' + typeName)
			return null
		}

		return fv
	}

	/// Struct-expression head (pre-gated by `tryLowerStructValue` — same
	/// defensive-re-verify contract as above): spill the value once, then
	/// share the field pass (nested struct reads lower recursively off
	/// the spill temp).
	fun lowerStructExpr(e: Expression, structT: Type, snames: [String], sfts: [Type]): Expression? {
		for ft in sfts {
			if not isPlainBagField(ft) {
				if not isStructShape(ft) {
					var typeName = 'null'

					if ft != null {
						typeName = Type.stringify(ft)
					}

					traceLog('REFLECT-POST-KEPT struct field type=' + typeName)
					return null
				}
			}
		}

		if not hoistable {
			traceLog('REFLECT-POST-KEPT struct no-hoist position')
			return null
		}

		let sp = '$psp' + tempId
		tempId++
		hoisted.push(Statement.Var(sp, e, structT))
		var rawVals: [Expression] = []

		for i in snames.length {
			rawVals.push(Expression.Dot(Expression.Ident(sp, structT), snames[i], sfts[i]))
		}

		var newVals: [Expression] = []

		for i in rawVals.length {
			if let fv = lowerFieldValue(rawVals[i], i) {
				newVals.push(fv)
			} else {
				return null
			}
		}

		return buildBag(snames, newVals)
	}

	/// True for inline-struct shapes (nested bags recurse through them).
	fun isStructShape(t: Type?): Bool {
		if t == null {
			return false
		}

		switch t {
			case Struct(_, _):
				return true
			case _:
				return false
		}
	}

	/// True for function-typed values (pair boxing lives in genC).
	/// Anything this flags must never cross a plain `Any` conversion,
	/// in either direction (the fallback boxes it via `isBoxableFat`).
	fun isFatType(t: Type?): Bool {
		if t == null {
			return false
		}

		switch t {
			case Function(_, _, _):
				return true
			case Nullable(inner):
				return isFatType(inner)
			case _:
				return false
		}
	}

	/// True when a value is safe to assign into an `Any` slot as-is
	/// (bridge/box/nullptr — exactly what the fallback emits there).
	/// Object literals and struct values need materialization, fat
	/// values need pair boxing, untyped values keep the fallback.
	/// Nullable wrappers unwrap first: `String?` is as safe as `String`,
	/// but `Nullable(Struct)` / `Nullable(Function)` still need their
	/// own lowering/boxing and return false here.
	fun inlineSafeAsAny(v: Expression): Bool {
		switch v {
			case Object(_, _, _):
				return false
			case Null(_):
				return true
			case _:
				let ft = baseTypeOf(v)

				if ft == null {
					return false
				}

				if isFatType(ft) {
					return false
				}

				var unwrapped = ft

				switch unwrapped {
					case Nullable(inner):
						unwrapped = inner
					case UnknownNullable(handle):
						if handle.value != null {
							unwrapped = handle.value
						} else {
							return false
						}
					case Unknown(handle):
						if handle.value != null {
							unwrapped = handle.value
						} else {
							return false
						}
					case _:
				}

				switch unwrapped {
					case Struct(_, _):
						return false
					case _:
						return true
				}
		}
	}

	/// Shared tail: `Var($psbN, Any_objectNew_())` + per-field sets.
	/// Fresh Ident per use (same name = same variable; never share one
	/// IR object between parents).
	fun buildBag(names: [String], vals: [Expression]): Expression? {
		if not hoistable {
			traceLog('REFLECT-POST-KEPT object no-hoist position')
			return null
		}

		let anyT = niceProject.typer.typeAny
		let bag = '$psb' + tempId
		tempId++
		hoisted.push(Statement.Var(bag, Expression.Call(bagNewCallee(), [], anyT, CallKind.Function, []), anyT))

		// Explicit expects: the value converts to `Any` exactly like the
		// genC fallback's per-field conversion (scalars box, pointers
		// bridge). Reuses the tested call-argument printer.
		let setExpects = [anyT, niceProject.typer.typeString, anyT]

		for i in names.length {
			let key = Expression.String(names[i])
			hoisted.push(Statement.Call(bagSetCallee(), [Expression.Ident(bag, anyT), key, vals[i]], setExpects, CallKind.Function))
		}

		bagLowered++
		traceLog('REFLECT-POST-LOWERED object->bag fields=' + names.length)
		return Expression.Ident(bag, anyT)
	}

	/// Trial lowering on a call argument: struct value into an `Any`
	/// parameter becomes the bag temp (built by `tryLowerStructValue`);
	/// array literal into an `Any` parameter becomes the `Array<Any>` temp
	/// (built by `tryLowerArrayAny` — fixes env loss the raw pointer bridge
	/// would cause). Explicit `expects` hit the fast path; empty/missing
	/// `expects` consult the callee signature read-only (`paramIsAny`) —
	/// the lowering itself does the conversion, no IR `expects` are written.
	fun lowerCallObjectArg(arg: Expression, expects: [Type]?, index: Int, callee: Expression, kind: CallKind): Expression {
		if let ex = expects {
			if index < ex.length {
				if isAnyType(ex[index]) {
					if let bag = tryLowerStructValue(arg, true) {
						return bag
					}

					if let arr = tryLowerArrayAny(arg, true) {
						return arr
					}
				}

				return arg
			}
		}

		if paramIsAny(callee, kind, index) {
			traceLog('REFLECT-POST call-arg via signature ' + index)

			if let bag = tryLowerStructValue(arg, true) {
				return bag
			}

			if let arr = tryLowerArrayAny(arg, true) {
				return arr
			}
		}

		return arg
	}

	/// Read-only signature probe for empty-`expects` calls: is parameter
	/// `index` exactly `Any`? Resolves plain globals via `globalFuncs`
	/// and methods via the receiver class (walking `extend`); everything
	/// else (declares with no body to read, dynamics, IIFEs, unknown
	/// arity, `Closure` kind owned by the fat machinery) returns false
	/// and keeps the genC fallback. Never mutates IR.
	fun paramIsAny(callee: Expression, kind: CallKind, index: Int): Bool {
		if kind == CallKind.Closure {
			return false
		}

		switch callee {
			case Ident(name, _):
				if let params = globalParamTypes(name) {
					if index < params.length {
						return isAnyType(params[index])
					}
				}

				return false
			case Dot(base, name, _):
				if let params = methodParamTypes(base, name) {
					if index < params.length {
						return isAnyType(params[index])
					}
				}

				return false
			case Parenthesis(inner):
				return paramIsAny(inner, kind, index)
			case _:
				return false
		}
	}

	/// Memoized callee signatures (`name` / `Class_$method` keys).
	let sigCache: [String : [Type]] = [:]
	var sigCacheMisses Int = 0

	/// Param dataTypes of a plain global (Hexa-implemented or not — the
	/// read is type-only; calls into it still print as before).
	fun globalParamTypes(name: String): [Type]? {
		if let hit = sigCache.get(name) {
			return hit
		}

		for g in niceProject.globalFuncs { switch g {
				case Function(gname, _, _, _, gfuncType, _, _):
					if gname == name { switch gfuncType {
							case Function(fargs, _, _):
								var out: [Type] = []

								for fa in fargs {
									out.push(fa.dataType)
								}

								sigCache.set(name, out)
								return out
							case _:
						} }
				case _:
			} }

		return null
	}

	/// Param dataTypes of `base.name` through the receiver's class
	/// (following `extend`, like ARC's method resolution). Static bases
	/// (`Uppercase`) resolve through `staticMethods`; anything
	/// unresolvable returns null and keeps the fallback.
	fun methodParamTypes(base: Expression, name: String): [Type]? {
		let bt = baseTypeOf(base)

		if bt == null {
			return null
		}

		var clsName String? = null

		switch bt {
			case ClassInstance(c, _):
				clsName = c.name
			case Class(c):
				clsName = c.name
			case _:
				return null
		}

		if clsName == null {
			return null
		}

		let key = clsName + '_$' + name

		if let hit = sigCache.get(key) {
			return hit
		}

		sigCacheMisses++
		var cur String? = clsName
		var depth = 0

		while cur != null and depth < 64 {
			depth++

			if let nc = findPostClass(cur as!String) {
				for m in nc.methods { switch m {
						case Function(mname, _, _, _, ftype, _, _):
							if mname == name { switch ftype {
									case Function(fargs, _, _):
										var out: [Type] = []

										for fa in fargs {
											out.push(fa.dataType)
										}

										sigCache.set(key, out)
										return out
									case _:
								} }
						case _:
					} }

				for m in nc.staticMethods { switch m {
						case Function(mname, _, _, _, ftype, _, _):
							if mname == name { switch ftype {
									case Function(fargs, _, _):
										var out: [Type] = []

										for fa in fargs {
											out.push(fa.dataType)
										}

										sigCache.set(key, out)
										return out
									case _:
								} }
						case _:
					} }

				cur = nc.extend
			} else {
				cur = null
			}
		}

		return null
	}

	/// Finds a NiceClass by (possibly renamed) name.
	fun findPostClass(name: String): NiceClass? {
		for c in niceProject.classes {
			if c.name == name {
				return c
			}
		}

		return null
	}

	/// Trial lowering: `recv.toString()` on a scalar receiver becomes
	/// `String.from*(recv)`. Static call, zero-arg plus decimal-radix-10
	/// guard (radix dropped — decimal only in Phase 1, same as genC),
	/// `String`-typed receivers excluded by construction (not scalar).
	/// Returns null when not applicable (genC fallback owns it).
	fun lowerScalarToString(callee: Expression, args: [Expression], result: Type): Expression? { switch callee {
			case Dot(base, name, _):
				if name != 'toString' {
					return null
				}

				if args.length == 1 {
					switch args[0] {
						case Int(v):
							if v != 10 {
								return null
							}
						case _:
							return null
					}
				} else if args.length != 0 {
					return null
				}

				scalarSites++

				let st = baseTypeOf(base)
				let staticName = scalarStaticFor(st)

				if staticName == null {
					var typeName = 'null'

					if st != null {
						typeName = Type.stringify(st)
					}

					traceLog('REFLECT-POST-KEPT toString over ' + kindOfExpr(base) + ' type=' + typeName)
					return null
				}

				let sc = stringClassType()

				if sc == null {
					traceLog('REFLECT-POST-KEPT toString (no String class)')
					return null
				}

				let newCallee = Expression.Dot(Expression.Ident('String', sc), staticName, result)
				scalarLowered++
				traceLog('REFLECT-POST-LOWERED toString -> String.' + staticName)
				return Expression.Call(newCallee, [base], result, CallKind.Static, [])
			case _:
				return null
		} }

	/// True for the `Int` declared target (the only scalar `printInitializer`
	/// special-cases: `var x Int = cond ? a : b` where a branch is `Int?`).
	fun isIntTarget(t: Type?): Bool {
		if t == null {
			return false
		}

		return t == niceProject.typer.typeInt
	}

	/// Trial lowering (#2): `Var/Const/Assign/Return` with `Int` target and
	/// an `If` value becomes a hoisted temp + `If` statement with per-branch
	/// `Assign`s. Each branch then converts toward `Int` through the normal
	/// `Assign` path instead of the outer `forcedCast` truncating a pointer
	/// (`C4311`). Mirrors `lowerIfStruct` but for scalars: no field gates,
	/// any branch type works (same converter the fallback applies).
	/// Non-hoistable positions keep the genC `printInitializer` fallback.
	fun tryLowerIntIf(e: Expression, targetIsInt: Bool): Expression? {
		if not targetIsInt {
			return null
		}

		switch e {
			case If(cond, eif, eelse, _):
				intIfSites++

				if not hoistable {
					traceLog('REFLECT-POST-KEPT intIf no-hoist position')
					return null
				}

				let intT = niceProject.typer.typeInt
				let pst = '$pst' + tempId
				tempId++
				hoisted.push(Statement.Var(pst, Expression.Int(0), intT))
				let savedA = drainHoisted()
				var blockA: [Statement] = []

				for h in drainHoisted() {
					blockA.push(h)
				}

				restoreHoisted(savedA)
				blockA.push(Statement.Assign(Expression.Ident(pst, intT), eif, null))
				let savedB = drainHoisted()
				var blockB: [Statement] = []

				for h in drainHoisted() {
					blockB.push(h)
				}

				restoreHoisted(savedB)
				blockB.push(Statement.Assign(Expression.Ident(pst, intT), eelse, null))
				hoisted.push(Statement.If(cond, Statement.Block(blockA), Statement.Block(blockB)))
				intIfLowered++
				traceLog('REFLECT-POST-LOWERED intIf->temp')
				return Expression.Ident(pst, intT)
			case _:
				return null
		}
	}

	/// The `Array<Any>` element type for #3 (found by name; null when the
	/// class is missing — caller keeps the genC `hexaItems` fallback).
	fun arrayAnyType(): Type? {
		for c in niceProject.classes {
			if c.name == 'Array' {
				switch c.classType {
					case Class(ct):
						return Type.ClassInstance(ct, [niceProject.typer.typeAny])
					case ClassInstance(ct, _):
						return Type.ClassInstance(ct, [niceProject.typer.typeAny])
					case _:
				}
			}
		}

		return null
	}

	/// Trial lowering (#3): array literal into an `Any` slot becomes a
	/// hoisted `new Array<Any>(0)` plus per-element `push` calls. Each
	/// element then converts toward `Any` through the normal `push` call-arg
	/// path (scalars box, fat leaves pair-box via `boxFatPair`) instead of
	/// the single-shot `hexaItems` buffer (which built `Array<Fn>` storage
	/// and dropped envs). Single eval, source order. Non-hoistable positions
	/// and missing `Array` keep the genC fallback.
	fun tryLowerArrayAny(e: Expression, targetIsAny: Bool): Expression? {
		switch e {
			case Array(vals, _):
				if not targetIsAny {
					return null
				}

				arrayAnySites++

				if not hoistable {
					traceLog('REFLECT-POST-KEPT arrayAny no-hoist position')
					return null
				}

				let arrT = arrayAnyType()

				if arrT == null {
					traceLog('REFLECT-POST-KEPT arrayAny (no Array class)')
					return null
				}

				let tmp = '$arr' + tempId
				tempId++
				hoisted.push(Statement.Var(tmp, Expression.New(Expression.Ident('Array', null), [Expression.Int(vals.length)], arrT), arrT))
				hoisted.push(Statement.Var(tmp, Expression.New(Expression.Ident('Array', null), [Expression.Int(0)], arrT), arrT))
				// Explicit `[Any]` expects (not the `[]`-derive precedent):
				// `callExpects` cannot resolve the `Dot` callee, so empty
				// expects would print elements raw (`String_*` into `Any_*`
				// param → C2664). With `Any` the normal call-arg conversion
				// boxes/bridges each element (scalars box, fat pairs).
				let pushExpects = [niceProject.typer.typeAny]

				for v in vals {
					hoisted.push(Statement.Call(Expression.Dot(Expression.Ident(tmp, arrT), 'push', null), [v], pushExpects, CallKind.VirtualMethod))
				}

				arrayAnyLowered++
				traceLog('REFLECT-POST-LOWERED arrayAny len=' + vals.length)
				return Expression.Ident(tmp, arrT)
			case _:
				return null
		}
	}

	/// Rewrites statements, recursing everywhere Calls can hide.
	/// Single-statement children go through `rewriteStmtHoisted` so bag
	/// builds wrap with their owner instead of leaking out of the scope.
	fun rewriteStmt(s: Statement): Statement { switch s {
			case Statements(els):
				return Statement.Statements(processStatementList(els))
			case Block(els):
				return Statement.Block(processStatementList(els))
			case Call(e, args, expects, kind):
				let nc = rewriteExpr(e)
				var na = rewriteExprList(args)

				if let rt = dotResultOf(nc) {
					if let lowered = lowerScalarToString(nc, na, rt) { switch lowered {
							case Call(nc2, na2, _, _, _):
								return Statement.Call(nc2, na2, expects, CallKind.Static)
							case _:
								return Statement.Call(nc, na, expects, kind)
						} }
				}

				let loweredArgs = lowerCallObjectArgs(na, expects, nc, kind)
				return Statement.Call(nc, loweredArgs, expects, kind)
			case Var(name, expr, dataType):
				let ne = rewriteExpr(expr)
				scopeBind(name, false, dataType)

				if let bag = tryLowerStructValue(ne, isAnyType(dataType)) {
					return Statement.Var(name, bag, dataType)
				}

				if let arr = tryLowerArrayAny(ne, isAnyType(dataType)) {
					return Statement.Var(name, arr, dataType)
				}

				if let tmp = tryLowerIntIf(ne, isIntTarget(dataType)) {
					return Statement.Var(name, tmp, dataType)
				}

				return Statement.Var(name, ne, dataType)
			case Const(name, expr, dataType):
				let ne = rewriteExpr(expr)
				scopeBind(name, true, dataType)

				if let bag = tryLowerStructValue(ne, isAnyType(dataType)) {
					return Statement.Const(name, bag, dataType)
				}

				if let arr = tryLowerArrayAny(ne, isAnyType(dataType)) {
					return Statement.Const(name, arr, dataType)
				}

				if let tmp = tryLowerIntIf(ne, isIntTarget(dataType)) {
					return Statement.Const(name, tmp, dataType)
				}

				return Statement.Const(name, ne, dataType)
			case Function(name, body, args, defaults, funcType, variadic, isAsync):
				// Defaults evaluate at call time in the caller scope — never
				// hoist out of them (same rule as nested function defaults).
				let savedHoistable = hoistable
				hoistable = false
				let newDefaults = rewriteExprList(defaults)
				hoistable = savedHoistable
				return Statement.Function(name, rewriteNestedBody(body, args, funcType, name), args, newDefaults, funcType, variadic, isAsync)
			case Return(e):
				let ne = rewriteExpr(e)

				if currentReturn != null, isAnyType(currentReturn) {
					if let bag = tryLowerStructValue(ne, true) {
						return Statement.Return(bag)
					}

					if let arr = tryLowerArrayAny(ne, true) {
						return Statement.Return(arr)
					}
				}

				if currentReturn != null, isIntTarget(currentReturn) {
					if let tmp = tryLowerIntIf(ne, true) {
						return Statement.Return(tmp)
					}
				}

				return Statement.Return(ne)
			case If(econd, eif, eelse):
				return Statement.If(rewriteExpr(econd), rewriteStmtHoisted(eif), rewriteStmtHoisted(eelse))
			case Try(expr, t, v, catches, temp):
				let newCatches: [Statement] = []

				for c in catches {
					newCatches.push(rewriteStmtHoisted(c))
				}

				return Statement.Try(rewriteStmtHoisted(expr), t, v, newCatches, temp)
			case Throw(value):
				return Statement.Throw(rewriteExpr(value))
			case Assign(name, value, to):
				let nn = rewriteExpr(name)
				let nv = rewriteExpr(value)
				auditAssignTarget(nn)

				if let bag = tryLowerStructValue(nv, isAnyType(baseTypeOf(nn))) {
					return Statement.Assign(nn, bag, to)
				}

				if let arr = tryLowerArrayAny(nv, isAnyType(baseTypeOf(nn))) {
					return Statement.Assign(nn, arr, to)
				}

				if let tmp = tryLowerIntIf(nv, isIntTarget(baseTypeOf(nn))) {
					return Statement.Assign(nn, tmp, to)
				}

				if baseTypeOf(nn) == null {
					if canLowerValue(nv, 'assign-untyped') {
						traceLog('REFLECT-POST-KEPT assign untyped struct in ' + currentFuncName + ' target=' + kindOfExpr(nn))
					}
				}
				return Statement.Assign(nn, nv, to)
			case Assignop(name, op, value):
				return Statement.Assignop(rewriteExpr(name), op, rewriteExpr(value))
			case For(name, over, by, reverse):
				return Statement.For(name, rewriteExpr(over), rewriteStmtHoisted(by), reverse)
			case While(econd, e, pre):
				// The condition runs per iteration: bag builds inside it must
				// not hoist out (they would evaluate once with stale captures).
				let savedHoistable = hoistable
				hoistable = false
				let nc = rewriteExpr(econd)
				hoistable = savedHoistable
				return Statement.While(nc, rewriteStmtHoisted(e), pre)
			case Increment(e):
				return Statement.Increment(rewriteExpr(e))
			case Decrement(e):
				return Statement.Decrement(rewriteExpr(e))
			case PatternSwitch(expr, cases, statements, guards, binds):
				// Case values match conditionally per case: no hoisting out of
				// them either (same rule as guards below).
				let savedHoistable = hoistable
				hoistable = false
				let newCases: [[Expression]] = []

				for case_ in cases {
					newCases.push(rewriteExprList(case_))
				}

				// Guards run conditionally per case: no hoisting out of them
				// (a hoisted build would evaluate even when its case loses).
				let newGuards: [Expression] = []

				for g in guards {
					newGuards.push(rewriteExpr(g))
				}

				hoistable = savedHoistable

				let newStatements: [Statement] = []

				for st in statements {
					newStatements.push(rewriteStmtHoisted(st))
				}

				let newBinds: [[Statement]] = []

				for b in binds {
					newBinds.push(processStatementList(b))
				}

				return Statement.PatternSwitch(rewriteExpr(expr), newCases, newStatements, newGuards, newBinds)
			case PlainSwitch(expr, cases, statements):
				let savedHoistable = hoistable
				hoistable = false
				let newCases: [[Expression]] = []

				for case_ in cases {
					newCases.push(rewriteExprList(case_))
				}

				hoistable = savedHoistable

				let newStatements: [Statement] = []

				for st in statements {
					newStatements.push(rewriteStmtHoisted(st))
				}

				return Statement.PlainSwitch(rewriteExpr(expr), newCases, newStatements)
			case SuperConstructor(args):
				return Statement.SuperConstructor(rewriteExprList(args))
			case RefInc(name):
				return Statement.RefInc(rewriteExprList(name))
			case DeferRefDec(name):
				return Statement.DeferRefDec(rewriteExprList(name))
			case Continue | Break:
				return s
			case _:
				if s != null, kindOfStmt(s) != 'UnknownStmt' {
					traceLog('REFLECT-POST-MISS stmt ' + kindOfStmt(s))
				}

				return s
		} }

	/// TEMPORARY INSTRUMENTATION, exact case tags mirroring ClosureLifter
	fun kindOfStmt(s: Statement): String { switch s {
			case Statements(_): return 'Statements'
			case Block(_): return 'Block'
			case Call(_, _, _, _): return 'Call'
			case Var(_, _, _): return 'Var'
			case Const(_, _, _): return 'Const'
			case Function(_, _, _, _, _, _, _): return 'Function'
			case Return(_): return 'Return'
			case If(_, _, _): return 'If'
			case Try(_, _, _, _, _): return 'Try'
			case Throw(_): return 'Throw'
			case Assign(_, _, _): return 'Assign'
			case Assignop(_, _, _): return 'Assignop'
			case For(_, _, _, _): return 'For'
			case While(_, _, _): return 'While'
			case Increment(_): return 'Increment'
			case Decrement(_): return 'Decrement'
			case PatternSwitch(_, _, _, _, _): return 'PatternSwitch'
			case PlainSwitch(_, _, _): return 'PlainSwitch'
			case Continue: return 'Continue'
			case Break: return 'Break'
			case SuperConstructor(_): return 'SuperConstructor'
			case RefInc(_): return 'RefInc'
			case DeferRefDec(_): return 'DeferRefDec'
			case _: return 'UnknownStmt'
		} }

	/// TEMPORARY INSTRUMENTATION, exact case tags mirroring ClosureLifter
	fun kindOfExpr(e: Expression): String { switch e {
			case String(_): return 'String'
			case Int(_): return 'Int'
			case MetaInt(_, _, _): return 'MetaInt'
			case Float(_): return 'Float'
			case True: return 'True'
			case False: return 'False'
			case Ident(_, _): return 'Ident'
			case Null(_): return 'Null'
			case This(_): return 'This'
			case Dot(_, _, _): return 'Dot'
			case Call(_, _, _, _, _): return 'Call'
			case New(_, _, _): return 'New'
			case Binop(_, _, _, _): return 'Binop'
			case Function(_, _, _, _, _, _): return 'Function'
			case Arrow(_, _, _, _, _, _, _): return 'Arrow'
			case Parenthesis(_): return 'Parenthesis'
			case Object(_, _, _): return 'Object'
			case Array(_, _): return 'Array'
			case Map(_, _, _, _, _): return 'Map'
			case Unop(_, _, _): return 'Unop'
			case Await(_): return 'Await'
			case Elvis(_, _): return 'Elvis'
			case If(_, _, _, _): return 'If'
			case Index(_, _, _): return 'Index'
			case UnsafeBitCast(_, _): return 'UnsafeBitCast'
			case Is(_, _): return 'Is'
			case RemoveNullability(_, _): return 'RemoveNullability'
			case Assignop(_, _, _): return 'Assignop'
			case EnumTag(_): return 'EnumTag'
			case Enum(_, _, _, _): return 'Enum'
			case EnumParameter(_, _): return 'EnumParameter'
			case Underscore: return 'Underscore'
			case Spread(_): return 'Spread'
			case CapturedVar(_, _): return 'CapturedVar'
			case StringConcatenation(_, _): return 'StringConcatenation'
			case StringIndex(_, _, _): return 'StringIndex'
			case NativeOperator(_, _, _, _, _): return 'NativeOperator'
			case _: return 'UnknownExpr'
		} }

	fun rewriteExprList(list: [Expression]): [Expression] {
		let out: [Expression] = []

		for e in list {
			out.push(rewriteExpr(e))
		}

		return out
	}

	/// Rewrites a nested function body with its own hoisting scope,
	/// return-type context and census scope (same contract as
	/// `rewriteFnStmt`).
	fun rewriteNestedBody(body: Statement, args: [String], funcType: Type, name: String?): Statement {
		let savedHoisted = drainHoisted()
		let savedHoistable = hoistable
		let savedReturn = currentReturn
		let prevFunc = pushScopeFor(name)
		hoistable = true
		currentReturn = returnTypeOf(funcType)
		let newBody = rewriteStmt(body)
		let drained = drainHoisted()
		let kept = prependHoisted(newBody, drained)
		hoistable = savedHoistable
		currentReturn = savedReturn
		restoreHoisted(savedHoisted)
		popScopeFor(prevFunc)
		return kept
	}

	/// Trial lowering helper (see `tryLowerStructValue`): lowers struct args
	/// at `Any` parameter positions, preserving order.
	fun lowerCallObjectArgs(args: [Expression], expects: [Type]?, callee: Expression, kind: CallKind): [Expression] {
		let out: [Expression] = []

		for i in args.length {
			out.push(lowerCallObjectArg(args[i], expects, i, callee, kind))
		}

		return out
	}

	/// Rewrites expressions, lowering scalar `.toString()` calls
	fun rewriteExpr(e: Expression): Expression { switch e {
			case Ident(_, _): return e
			case Dot(expr, name, result):
				return Expression.Dot(rewriteExpr(expr), name, result)
			case Index(expr, index, result):
				return Expression.Index(rewriteExpr(expr), rewriteExpr(index), result)
			case StringIndex(expr, index, result):
				return Expression.StringIndex(rewriteExpr(expr), rewriteExpr(index), result)
			case Call(callee, args, result, kind, expects):
				let nc = rewriteExpr(callee)
				let na = lowerCallObjectArgs(rewriteExprList(args), expects, nc, kind)

				if let lowered = lowerScalarToString(nc, na, result) {
					return lowered
				}

				return Expression.Call(nc, na, result, kind, expects)
			case New(callee, args, result):
				return Expression.New(rewriteExpr(callee), rewriteExprList(args), result)
			case Binop(a, op, b, result):
				let na = rewriteExpr(a)

				// `&&`/`||` short-circuit the right side: bag builds inside it
				// must not hoist out (they would evaluate when skipped).
				if op == Token.KAnd or op == Token.LogicalAnd or op == Token.KOr or op == Token.LogicalOr {
					let savedHoistable = hoistable
					hoistable = false
					let nb = rewriteExpr(b)
					hoistable = savedHoistable
					// D7 truthiness (Bundle 4): dynamic operands print as
					// `Any_*` pointers — explicit `Any_toBool_` so C `&&`/`||`
					// test JS truthiness, not pointer non-null.
					return Expression.Binop(wrapBoolIfNeeded(na), op, wrapBoolIfNeeded(nb), result)
				}

				return Expression.Binop(na, op, rewriteExpr(b), result)
			case Unop(op, postfix, inner):
				return Expression.Unop(op, postfix, rewriteExpr(inner))
			case Parenthesis(inner):
				return Expression.Parenthesis(rewriteExpr(inner))
			case Array(values, arrayType):
				return Expression.Array(rewriteExprList(values), arrayType)
			case Object(names, el, types):
				return Expression.Object(names, rewriteExprList(el), types)
			case Map(keys, values, keyType, valueType, mapType):
				return Expression.Map(rewriteExprList(keys), rewriteExprList(values), keyType, valueType, mapType)
			case If(econd, eif, eelse, result):
				let nc = wrapBoolIfNeeded(rewriteExpr(econd))
				// Branches run conditionally (at most one): bag builds inside
				// them must not hoist out (they would evaluate unconditionally).
				// The whole-If lowering in `tryLowerStructValue` re-attempts
				// them with proper per-branch hoisting instead.
				let savedHoistable = hoistable
				hoistable = false
				let nb = rewriteExpr(eif)
				let ne = rewriteExpr(eelse)
				hoistable = savedHoistable
				return Expression.If(nc, nb, ne, result)
			case Elvis(a, b):
				let na = rewriteExpr(a as!Expression)
				// The fallback runs conditionally: same rule as If branches.
				let savedHoistable = hoistable
				hoistable = false
				let nb = rewriteExpr(b as!Expression)
				hoistable = savedHoistable
				return Expression.Elvis(na, nb)
			case This(_):
				return e
			case Await(inner):
				return Expression.Await(rewriteExpr(inner))
			case UnsafeBitCast(inner, to):
				return Expression.UnsafeBitCast(rewriteExpr(inner), to)
			case Is(inner, of):
				return Expression.Is(rewriteExpr(inner), of)
			case RemoveNullability(inner, result):
				return Expression.RemoveNullability(rewriteExpr(inner), result)
			case Assignop(name, op, value):
				return Expression.Assignop(rewriteExpr(name), op, rewriteExpr(value))
			case EnumTag(inner):
				return Expression.EnumTag(rewriteExpr(inner))
			case Enum(enumType, tagName, tag, args):
				return Expression.Enum(enumType, tagName, rewriteExpr(tag), rewriteExprList(args))
			case EnumParameter(inner, index):
				return Expression.EnumParameter(rewriteExpr(inner), index)
			case Spread(inner):
				return Expression.Spread(rewriteExpr(inner))
			case StringConcatenation(leftString, rightString):
				return Expression.StringConcatenation(rewriteExpr(leftString), rewriteExpr(rightString))
			case NativeOperator(kind, args, name, params, result):
				return Expression.NativeOperator(kind, rewriteExprList(args), name, params, result)
			case String(_): return e
			case Int(_): return e
			case Float(_): return e
			case Null(_): return e
			case Underscore: return e
			case True: return e
			case False: return e
			case MetaInt(_, _, _): return e
			case Function(name, body, args, defaults, funcType, isAsync):
				let savedHoistable = hoistable
				hoistable = false
				let newDefaults = rewriteExprList(defaults)
				hoistable = savedHoistable
				return Expression.Function(name, rewriteNestedBody(body, args, funcType, name), args, newDefaults, funcType, isAsync)
			case Arrow(expr, args, defaults, types, returns, funcType, isAsync):
				// Arrow bodies are single expressions with no statement slot:
				// bag builds cannot hoist out of them (that would evaluate
				// per-call fields once at creation), so hoisting stays off
				// here and those shapes keep the genC fallback. Nested
				// function values re-enable their own scope via
				// `rewriteNestedBody`.
				let savedHoistable = hoistable
				hoistable = false
				let newDefaults = rewriteExprList(defaults)
				let newBody = rewriteExpr(expr)
				hoistable = savedHoistable
				return Expression.Arrow(newBody, args, newDefaults, types, returns, funcType, isAsync)
			case _:
				if e != null, kindOfExpr(e) != 'UnknownExpr' {
					traceLog('REFLECT-POST-MISS expr ' + kindOfExpr(e))
				}

				return e
		} }
}
