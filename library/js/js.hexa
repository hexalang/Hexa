@rename('Set')
declare class Set<T> {
	let size: Int
	fun add(value: T): Set<T>
	fun has(value: T): Bool
	fun delete(value: T): Bool
	fun clear(): Void
	fun forEach(f: (value: T, key: T, set: Set<T>) => Void): Void
	fun keys(): [T]
	fun values(): [T]
	fun entries(): [[T: T]]
	new ()
	// TODO new (values: [T]?)
}

@rename('WeakMap')
declare class WeakMap<K, V> {
	fun get(k: K): V?
	fun set(k: K, v: V): WeakMap<K, V>
	fun has(k: K): Bool
	fun delete(k: K): Bool
	new ()
}

@rename('WeakSet')
declare class WeakSet<T> {
	fun add(value: T): WeakSet<T>
	fun has(value: T): Bool
	fun delete(value: T): Bool
	new ()
}

@rename('Map')
declare class Map<K, V> {
	new ()
	// TODO nullable `V?`
	fun get(k: K): V
	fun set(k: K, v: V): Void
	fun has(k: K): Bool
	fun delete(k: K): Bool
	fun keys(): [K]
	fun values(): [V] // Type is not `[V]` but `Iterator`
}

@rename("console")
declare class Console {
	// TODO first arg required! cause ... is zero-or-more
	fun log(...message: Any?): Void
	fun trace(...message: Any?): Void
	fun error(...message: Any?): Void
	fun warn(...message: Any?): Void
	fun info(...message: Any?): Void
	fun dir(value: Any?): Void
	fun time(label: String? = 'default'): Void
	fun timeEnd(label: String? = 'default'): Void
	fun table(value: Any?): Void
	fun count(label: String? = 'default'): Void
	fun group(...label: Any?): Void
	fun groupEnd(): Void
	fun assert(condition: Bool,...message: Any?): Void
	fun clear(): Void
}

declare let console: Console

declare class Array<T> {
	let length: Int
	fun concat(array: [T]): [T]
	fun join(separator: String): String
	fun pop(): T?
	fun push(value: T): Int
	fun includes(value: T): Bool
	fun reverse(): Void
	fun shift(): T?
	fun slice(pos: Int = 0, end: Int = 1073741824): [T]
	// Yeah magic trick
	@rename('slice') fun clone() [T]
	fun sort(f: (T, T) => Int): Void
	fun splice(pos: Int, len: Int): [T]
	fun toString(): String
	fun unshift(value: T): Void
	fun indexOf(value: T, fromIndex: Int = 0): Int
	fun lastIndexOf(value: T, fromIndex: Int?): Int
	fun filter(f: (element: T, index: Int) => Bool): [T]
	// TODO index
	fun map(f: T => T): [T]
	// TODO `initialValue = _`
	fun reduce(f: (accumulator: T, currentValue: T) => T, initialValue: T = null): T
	// TODO `reduce<U>(callbackfn: (previousValue: U, currentValue: T, currentIndex: number, array: readonly T[]) => U, initialValue: U): U`
	fun copyWithin(target: Int, start: Int?, end: Int?): [T]
	fun fill(value: T, start: Int, end: Int): [T]
	fun forEach(f: (accumulator: T, currentValue: T) => Void): Void

	// ES5 iteration methods
	fun every(f: (element: T, index: Int) => Bool): Bool
	fun some(f: (element: T, index: Int) => Bool): Bool

	// ES6 search methods
	fun find(f: (element: T, index: Int) => Bool): T?
	fun findIndex(f: (element: T, index: Int) => Bool): Int

	// ES2023 search methods
	fun findLast(f: (element: T, index: Int) => Bool): T?
	fun findLastIndex(f: (element: T, index: Int) => Bool): Int

	// ES2019 flattening
	fun flat(depth: Int = 1): [T]
	fun flatMap(f: (element: T, index: Int) =>[T]): [T]

	// ES5 reduce from right
	fun reduceRight(f: (accumulator: T, currentValue: T) => T, initialValue: T = null): T

	// ES2022 relative indexing
	fun at(index: Int): T?

	// ES2023 immutable methods (return new arrays instead of mutating in place)
	fun toReversed(): [T]
	fun toSorted(f: (T, T) => Int): [T]
	@rename('toSorted') fun toSortedDefault(): [T]
	fun toSpliced(pos: Int, len: Int,...items: T): [T]
	fun with(index: Int, value: T): [T]

	// ES2015 iteration methods
	fun keys(): [Int]
	fun values(): [T]
	fun entries(): [[Int: T]]

	// ES2019 toLocaleString
	fun toLocaleString(locales: Any? = null, options: Any? = null): String

	static fun isArray(value: Any): Bool
	static fun of(...values: T): [T]
	new (arrayLength: Int)
	static fun from(arrayLike: Any, mapFn: Any?, thisArg: Any?): [T]
}

declare class Date {
	static fun now(): Float
	static fun parse(dateString: String): Float
	@rename('UTC') static fun utc(year: Int, monthIndex: Int, day: Int? = 1, hours: Int? = 0, minutes: Int? = 0, seconds: Int? = 0, milliseconds: Int? = 0): Float
	new ()
	// TODO
	// new (value: Any)
	// new (dateString: String)
	// new (year: Int, monthIndex: Int, day: Int? = 1, hours: Int? = 0, minutes: Int? = 0, seconds: Int? = 0, milliseconds: Int? = 0)
	fun getFullYear(): Int
	fun getMonth(): Int
	fun getDate(): Int
	fun getDay(): Int
	fun getHours(): Int
	fun getMinutes(): Int
	fun getSeconds(): Int
	fun getMilliseconds(): Int
	fun getTime(): Float
	fun getTimezoneOffset(): Int
	fun getUTCFullYear(): Int
	fun getUTCMonth(): Int
	fun getUTCDate(): Int
	fun getUTCDay(): Int
	fun getUTCHours(): Int
	fun getUTCMinutes(): Int
	fun getUTCSeconds(): Int
	fun getUTCMilliseconds(): Int
	fun setFullYear(year: Int, month: Int? = 1073741824, day: Int? = 1073741824): Float
	fun setMonth(month: Int, day: Int? = 1073741824): Float
	fun setDate(day: Int): Float
	fun setHours(hours: Int, minutes: Int? = 1073741824, seconds: Int? = 1073741824, milliseconds: Int? = 1073741824): Float
	fun setMinutes(minutes: Int, seconds: Int? = 1073741824, milliseconds: Int? = 1073741824): Float
	fun setSeconds(seconds: Int, milliseconds: Int? = 1073741824): Float
	fun setMilliseconds(milliseconds: Int): Float
	fun setTime(time: Float): Float
	fun toDateString(): String
	fun toISOString(): String
	fun toJSON(): String
	fun toLocaleDateString(locales: Any? = null, options: Any? = null): String
	fun toLocaleString(locales: Any? = null, options: Any? = null): String
	fun toLocaleTimeString(locales: Any? = null, options: Any? = null): String
	fun toString(): String
	fun toTimeString(): String
	fun toUTCString(): String
	fun valueOf(): Float
}

declare class Reflect {
	static fun has(object: Any, name: String): Bool
	static fun get(object: Any, name: String): Any?
	static fun set(object: Any, name: String, value: Any?): Bool
	static fun ownKeys(object: Any): [String]
}

@rename('Promise')
declare class Promise<T> {
	fun then(onFulfilled: (value: T) => Any?, onRejected: (reason: Any) => Any?): Promise<Any>
	@rename('catch') fun except(onRejected: (reason: Any) => Any?): Promise<Any>
	fun finally(onFinally: () => Void): Promise<T>
	static fun resolve(value: T): Promise<T>
	static fun reject(reason: Any): Promise<Any>
	static fun all(promises: [Promise<Any>]): Promise<[Any]>
	static fun race(promises: [Promise<Any>]): Promise<Any>
	static fun allSettled(promises: [Promise<Any>]): Promise<[Any]>
	static fun any(promises: [Promise<Any>]): Promise<Any>
	new (executor: (resolve: (value: T) => Void, reject: (reason: Any) => Void) => Void)
}

@rename('RegExp')
declare class RegExp {
	var global: Bool
	var ignoreCase: Bool
	var multiline: Bool
	var source: String
	var lastIndex: Int
	fun exec(str: String): RegExpMatch?
	fun test(str: String): Bool
	fun toString(): String
	new (pattern: String, flags: String?)
}

declare class RegExpMatch extends Array< String > {
	var index: Int
	var input: String
}

// Typed Arrays
declare class ArrayBuffer {
	let byteLength: Int
	fun slice(begin: Int, end: Int? = null): ArrayBuffer
	static fun isView(value: Any): Bool
	new (byteLength: Int)
}

declare class DataView {
	let buffer: ArrayBuffer
	let byteLength: Int
	let byteOffset: Int
	fun getInt8(byteOffset: Int): Int
	fun getUint8(byteOffset: Int): Int
	fun getInt16(byteOffset: Int, littleEndian: Bool? = false): Int
	fun getUint16(byteOffset: Int, littleEndian: Bool? = false): Int
	fun getInt32(byteOffset: Int, littleEndian: Bool? = false): Int
	fun getUint32(byteOffset: Int, littleEndian: Bool? = false): Int
	fun getFloat32(byteOffset: Int, littleEndian: Bool? = false): Float
	fun getFloat64(byteOffset: Int, littleEndian: Bool? = false): Float
	fun getBigInt64(byteOffset: Int, littleEndian: Bool? = false): BigInt
	fun getBigUint64(byteOffset: Int, littleEndian: Bool? = false): BigInt
	fun setInt8(byteOffset: Int, value: Int): Void
	fun setUint8(byteOffset: Int, value: Int): Void
	fun setInt16(byteOffset: Int, value: Int, littleEndian: Bool? = false): Void
	fun setUint16(byteOffset: Int, value: Int, littleEndian: Bool? = false): Void
	fun setInt32(byteOffset: Int, value: Int, littleEndian: Bool? = false): Void
	fun setUint32(byteOffset: Int, value: Int, littleEndian: Bool? = false): Void
	fun setFloat32(byteOffset: Int, value: Float, littleEndian: Bool? = false): Void
	fun setFloat64(byteOffset: Int, value: Float, littleEndian: Bool? = false): Void
	fun setBigInt64(byteOffset: Int, value: BigInt, littleEndian: Bool? = false): Void
	fun setBigUint64(byteOffset: Int, value: BigInt, littleEndian: Bool? = false): Void
	new (buffer: ArrayBuffer, byteOffset: Int? = 0, byteLength: Int? = null)
}

// Typed Arrays
declare class Int8Array {
	let length: Int
	let byteLength: Int
	let byteOffset: Int
	let buffer: ArrayBuffer
	@rename("BYTES_PER_ELEMENT") static let bytesPerElement: Int
	fun at(index: Int): Int?
	fun set(array: [Int], offset: Int? = 0): Void
	fun subarray(begin: Int, end: Int? = null): Int8Array
	fun slice(begin: Int? = 0, end: Int? = 1073741824): Int8Array
	fun fill(value: Int, start: Int? = 0, end: Int? = 1073741824): Int8Array
	fun join(separator: String? = ','): String
	fun toString(): String
	fun indexOf(value: Int, fromIndex: Int? = 0): Int
	fun includes(value: Int, fromIndex: Int? = 0): Bool
	fun forEach(f: (value: Int, index: Int) => Void): Void
	fun map(f: (value: Int, index: Int) => Int): Int8Array
	fun filter(f: (value: Int, index: Int) => Bool): Int8Array
	fun some(f: (value: Int, index: Int) => Bool): Bool
	fun every(f: (value: Int, index: Int) => Bool): Bool
	fun find(f: (value: Int, index: Int) => Bool): Int?
	fun findIndex(f: (value: Int, index: Int) => Bool): Int
	fun reduce(f: (accumulator: Int, currentValue: Int) => Int, initialValue: Int): Int
	fun sort(f: (a: Int, b: Int) => Int): Int8Array
	fun reverse(): Int8Array
	fun copyWithin(target: Int, start: Int, end: Int? = 1073741824): Int8Array
	new ()
	// TODO new (length: Int)
	// TODO new (array: [Int])
	// TODO new (buffer: ArrayBuffer, byteOffset: Int? = 0, length: Int? = null)
}

