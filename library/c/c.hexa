	fun has(value: T): Bool
	fun delete(value: T): Bool
}

// Errors // // TODO move to a separate `error.hexa` when the loader supports it
// NOTE: no `super(...)` calls yet — GenCxx cannot emit `SuperConstructor`
// statements (it warns "Unknown statement kind (GenCxx): SuperConstructor")

// JS-compatible error hierarchy, stubbed for the native target
class Error {
	var message: String
	var name: String
	var stack: String
	new (message: String?) {
		this.message = message ?? ''
		this.name = 'Error'
		this.stack = ''
	}
}

class EvalError extends Error {
	new (message: String?) { }
}

class URIError extends Error {
	new (message: String?) { }
}

class TypeError extends Error {
	new (message: String?) { }
}

class SyntaxError extends Error {
	new (message: String?) { }
}

class ReferenceError extends Error {
	new (message: String?) { }
}

class RangeError extends Error {
	new (message: String?) { }
}

class AggregateError extends Error {
	var errors: [Any]
	new (errors: [Any]?, message: String?) {
		this.errors = errors ?? []
	}
}

