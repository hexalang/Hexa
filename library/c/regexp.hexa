// regexp.hexa — native regular expressions (dedicated std file, see W6 in
// Perfide/docs/port-to-cpp-plan.md). `RegExp`/`RegExpMatch` live here (moved
// out of library/c/c.hexa); `String`'s match/search/replaceRegExp delegate
// here. Stubs until the backtracking engine lands (same doc).

// Regular expressions — `/pattern/flags` literals lower to `RegExp(pattern, flags)`
class RegExp {
	var global: Bool = false
	var ignoreCase: Bool = false
	var multiline: Bool = false
	var source: String = ''
	var lastIndex: Int = 0
	new (pattern: String, flags: String?) {
		this.source = pattern
	}
	fun exec(str: String): RegExpMatch? { return null }
	fun test(str: String): Bool { return false }
	fun toString(): String { return '' }
}

// Single match result (`index`/`input` + captured groups as fields over time)
class RegExpMatch {
	var index: Int = 0
	var input: String = ''
}
