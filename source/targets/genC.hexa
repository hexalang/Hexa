	/// The `null` sentinel's own reflection vtable (D2). `null` is an OBJECT for
	/// every managed (`Foo_*`) and `Any` slot: it carries the ordinary instance
	/// header (so `hexaRef`/`hexaUnref` are blind `rc++`/`rc--`), and this
	/// double vtable (`hidden` reflection + `public` COM head, same layout as
	/// every class), so dynamic operations are answered VIRTUALLY instead of by
	/// per-helper null tests: `toBool` = false, `toString` = "null", field reads
	/// = null, field writes dropped, key/index counts = 0, never destroyed.
	/// `_` (the tag) is installed by `hexaInstallNone_()` — the first statement
	/// of `HEXA_MAIN`. Until then the tag is 0, which every dispatcher already
	/// treats as "no reflection", so nothing can mis-dispatch.
	fun printNullSentinel(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// Null sentinel (D2: `null` is an object, never a null pointer)' + nl
		// The public half is emitted LATE (`printNullVtable`, after Types, where
		// `struct String__` is complete) — a single sentinel cannot be shaped
		// like every class, so it is shaped like the one class JS coerces.
		r += 'static void* HexaNone_stringStub_(void);' + nl
		r += 'HEXA_C void hexaInstallNone_(void);' + nl
		r += 'static uint8_t HexaNone_hiddenToBool_(void* self_) ' + lb + ' (void)self_; return (uint8_t)0; ' + rb + nl
		r += 'static const char* HexaNone_hiddenClassName_(void) ' + lb + ' return "Null"; ' + rb + nl
		r += 'static struct Any_* HexaNone_hiddenDynGet_(void* self_, struct String_* k_) ' + lb + ' (void)k_; return (struct Any_*)(self_); ' + rb + nl
		r += 'static void HexaNone_hiddenDynSet_(void* self_, struct String_* k_, struct Any_* v_) ' + lb + ' (void)self_; (void)k_; (void)v_; ' + rb + nl
		r += 'static uint8_t HexaNone_hiddenHas_(void* self_, struct String_* k_) ' + lb + ' (void)self_; (void)k_; return (uint8_t)0; ' + rb + nl
		r += 'static void HexaNone_hiddenDelete_(void* self_, struct String_* k_) ' + lb + ' (void)self_; (void)k_; ' + rb + nl
		r += 'static struct String_* HexaNone_hiddenKeyAt_(void* self_, int32_t i_) ' + lb + ' (void)i_; return (struct String_*)(self_); ' + rb + nl
		r += 'static int32_t HexaNone_hiddenKeyCount_(void* self_) ' + lb + ' (void)self_; return (int32_t)0; ' + rb + nl
		r += 'static struct Any_* HexaNone_hiddenIndexGet_(void* self_, int32_t i_) ' + lb + ' (void)i_; return (struct Any_*)(self_); ' + rb + nl
		r += 'static void HexaNone_hiddenIndexSet_(void* self_, int32_t i_, struct Any_* v_) ' + lb + ' (void)self_; (void)i_; (void)v_; ' + rb + nl
		r += 'static int32_t HexaNone_hiddenIndexCount_(void* self_) ' + lb + ' (void)self_; return (int32_t)0; ' + rb + nl
		// Body emitted with the sweep/tag section (it needs the interned "null").
		r += 'static struct String_* HexaNone_hiddenToString_(void* self_);' + nl
		r += 'static void HexaNone_hiddenReflect_(void* self_, struct HexaReflectOp_* op_);' + nl
		// Reflection half: compiled here, wired into `HexaNone_vt_` at boot.
		r += 'static const struct HexaReflect_ HexaNone_hidden_ = ' + lb + ' nullptr, &HexaNone_hiddenToBool_, &HexaNone_hiddenToString_, &HexaNone_hiddenClassName_, &HexaNone_hiddenDynGet_, &HexaNone_hiddenDynSet_, &HexaNone_hiddenHas_, &HexaNone_hiddenDelete_, &HexaNone_hiddenKeyAt_, &HexaNone_hiddenKeyCount_, &HexaNone_hiddenIndexGet_, &HexaNone_hiddenIndexSet_, &HexaNone_hiddenIndexCount_, &HexaNone_hiddenReflect_ ' + rb + ';' + nl
		r += 'static void HexaNone_hiddenReflect_(void* self_, struct HexaReflectOp_* op_) ' + lb + ' if (op_ == nullptr) return; switch (op_->code_) ' + lb + ' case (int32_t)1: op_->resultInt_ = (int32_t)0; break; case (int32_t)2: op_->resultStr_ = HexaNone_hiddenToString_(self_); break; case (int32_t)3: op_->resultCStr_ = HexaNone_hiddenClassName_(); break; default: break; ' + rb + ' ' + rb + nl
		return r
	}

	/// The `null` sentinel's PUBLIC half (D2) — emitted with the sweep section so
	/// `struct String__` (its exact shape) is complete.
	/// WHY String-shaped: every Hexa method call is `recv->_->m(recv, …)`, so a
	/// `null` receiver must answer with the JS coercion (`String(null)` =
	/// "null") instead of reading a slot past a short head and calling 0. All
	/// slots get one stub returning the interned `"null"`; the head is filled at
	/// boot (`hexaInstallNone_`, first statement of `HEXA_MAIN`) by slot count,
	/// so no `String__` field list is needed here. Non-String receivers also land
	/// on the stub (pointer-sized return, never a jump to 0) — calling a method
	/// on `null` is a source bug either way and the trace assert names it.
	fun printNullVtable(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// Null sentinel public half: String-shaped, every slot = the coercion stub' + nl
		// A plain slot array (not `struct String__`): String's method members are
		// `const` function pointers, so the struct has no default constructor and
		// cannot host a mutable table. 14 = the reflect head, 64 = method slots.
		r += 'static void* HexaNone_vt$_[14 + 64];' + nl
		r += '#define HexaNone__$ (*(void**)(&(HexaNone_vt$_[14])))' + nl
		r += '_Static_assert(sizeof(struct HexaReflect_) / sizeof(void*) == 14, "reflect: head must stay 14 slots");' + nl
		r += '_Static_assert(sizeof(struct String__) / sizeof(void*) <= 64, "reflect: HexaNone_ needs more method slots");' + nl
		r += 'static void* HexaNone_stringStub_(void) ' + lb + ' return (void*)String_1; ' + rb + nl
		r += 'HEXA_C void hexaInstallNone_(void) ' + lb + ' memcpy(&(HexaNone_vt$_[0]), &HexaNone_hidden_, sizeof(struct HexaReflect_)); size_t n_ = sizeof(struct String__) / sizeof(void*); void** s_ = (void**)(&(HexaNone_vt$_[14])); for (size_t i_ = (size_t)0; i_ < n_; i_++) s_[i_] = (void*)(&HexaNone_stringStub_); HexaNone_._ = (const void*)(&HexaNone__$); ' + rb + nl
		return r
	}

	/// ARC destroy registry: one row per `@destructor` class (vtable tag,
	/// destroy fn, instance size) plus a tag lookup for the future F11 sweep.
	/// Always emitted (lone null row when empty) so the sweep links blindly.
	/// (Braces ride via fromCharCode like the neighboring runtime printers —
	/// never as escapes, which misparse in this position.)
	fun printDestroyTable(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// ARC destroy registry (tag -> destructor, F11 sweep reads it)' + nl
		r += 'struct HexaDestroyEntry_ ' + lb + ' const void* tag_; void (*destroy_)(void*); size_t size_; ' + rb + ';' + nl
		r += 'static const struct HexaDestroyEntry_ hexaDestroyTable_[] = ' + lb

		if destroyTable.length == 0 {
			r += lb + 'nullptr, nullptr, 0' + rb
		} else {
			r += destroyTable.join(', ')
		}
		r += rb + ';' + nl
		r += 'static void (*HexaDestroyLookup_(const void* tag))(void*) ' + lb + ' for (size_t i_ = 0; i_ < sizeof(hexaDestroyTable_)/sizeof(hexaDestroyTable_[0]); i_++) ' + lb + ' if (hexaDestroyTable_[i_].tag_ != nullptr && hexaDestroyTable_[i_].tag_ == tag) return hexaDestroyTable_[i_].destroy_; ' + rb + ' return nullptr; ' + rb + nl
		return r
	}

	/// F11 live-object registry (side table — the host mirrors Hexa layouts,
	/// so no intrusive link may be added to instance headers). `$new_`
	/// registers every vtable-managed birth after `$this_` completes (a
	/// registered object is always fully constructed); boxes register at
	/// creation. Nothing reads the table yet (sweep + census land next).
	fun printLiveRegistry(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// F11 live-object registry (side table, host-mirror safe)' + nl
		r += 'static void** hexaLiveList_ = nullptr;' + nl
		r += 'static size_t hexaLiveNum_ = 0;' + nl
		r += 'static size_t hexaLiveCap_ = 0;' + nl
		// F11 pressure trigger (alloc-path sweep): managed births drive the
		// sweep, so bursty allocators can't outrun the 600-pump cadence.
		// Prototype rides here (hexaSweep is defined later in this TU);
		// the sweep's own sweeping_ guard makes nested triggers (user
		// @destructors that allocate) safe no-ops. Mode 4 (off) still pays
		// a scan per interval — acceptable for a manual triage mode.
		r += 'void hexaSweep(void);' + nl
		r += 'static uint8_t hexaSweepVerbose_ = (uint8_t)0;' + nl
		// Pressure trigger: 65536 births (was 8192). Each sweep is O(live list)
		// and the live list reaches ~400k, so a tight trigger means sweeps run
		// dozens of times per second inside ordinary allocation — that is a
		// multi-second stall, not a saving.
		r += 'static size_t hexaAllocSinceSweep_ = 0;' + nl
		r += 'void hexaRegisterLive_(void* p) ' + lb + ' if (p == nullptr) return; if (hexaLiveNum_ >= hexaLiveCap_) ' + lb + ' size_t ncap = hexaLiveCap_ == (size_t)0 ? (size_t)4096 : hexaLiveCap_ * (size_t)2; void** nn = (void**)(HEXA_NEW(sizeof(void*) * ncap)); for (size_t i = (size_t)0; i < hexaLiveNum_; i++) nn[i] = hexaLiveList_[i]; if (hexaLiveList_ != nullptr) HEXA_FREE(hexaLiveList_, sizeof(void*) * hexaLiveCap_); hexaLiveList_ = nn; hexaLiveCap_ = ncap; ' + rb + ' hexaLiveList_[hexaLiveNum_] = p; hexaLiveNum_++; if (++hexaAllocSinceSweep_ >= (size_t)65536) ' + lb + ' hexaAllocSinceSweep_ = 0; hexaSweep(); ' + rb + rb + nl
		r += 'size_t hexaLiveCount_(void) ' + lb + ' return hexaLiveNum_; ' + rb + nl
		r += 'void hexaSweepCensus(void) ' + lb + ' size_t live_ = hexaLiveNum_; size_t zero_ = (size_t)0; size_t null_ = (size_t)0; size_t stringLive_ = (size_t)0; size_t stringBytes_ = (size_t)0; for (size_t i_ = (size_t)0; i_ < hexaLiveNum_; i_++) ' + lb + ' void* p_ = hexaLiveList_[i_]; if (p_ == nullptr) continue; int64_t v_ = (int64_t)p_; if (v_ >= (int64_t)-65535 && v_ <= (int64_t)65535) continue; const void* tag_ = ((const void**)(p_))[0]; if (tag_ == nullptr) ' + lb + ' null_++; continue; ' + rb + ' if (tag_ == (const void*)(&String__$)) ' + lb + ' stringLive_++; stringBytes_ += (size_t)(((String_*)(p_))->bytesLength_); ' + rb + ' if (((const struct HexaHeader_*)(p_))->rc_ == (int32_t)0) zero_++; ' + rb + ' FILE* f_ = fopen("sweep-census.log", "a"); if (f_ != nullptr) ' + lb + ' fprintf(f_, "sweep-census live=%llu zero=%llu nullTag=%llu stringLive=%llu stringBytes=%llu", (unsigned long long)live_, (unsigned long long)zero_, (unsigned long long)null_, (unsigned long long)stringLive_, (unsigned long long)stringBytes_); fputc(10, f_); fclose(f_); ' + rb + rb + nl
		return r
	}

	/// D2 storage: `ArrayByValue<T?, N>` globals live in BSS (all-zero words),
	/// but their unset slots are observable — `stringBuckets` (the intern
	/// table) is retained before any bucket is filled. Fill them with the
	/// sentinel object in the `HEXA_MAIN` prologue, before strings intern.
	fun printNoneSlotInit(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// D2: sentinel-fill ArrayByValue slots (a BSS zero is not `null`)' + nl
		r += 'static void hexaInitNoneSlots_(void) ' + lb + nl

		for line in noneSlotInitLines {
			r += line + nl
		}
		r += rb + nl
		return r
	}

	/// Sweep victim-class names (diagnostic): one `if` per vtable-managed
	/// class so the sweep can log WHO it frees (first victims per sweep).
	/// Same vtable predicate as the class printer (structs/unions/native
	/// layouts have no `__$` tag global and are skipped).
	fun printTagNames(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// Sweep victim-class names (diagnostic, first freed per sweep)' + nl
		r += 'HEXA_C const char* hexaTagName_(const void* tag_) ' + lb + nl

		for n in vtableClasses {
			r += 'if (tag_ == (const void*)(&' + n + '__$)) return "' + n + '";' + nl
		}
		r += 'if (tag_ == (const void*)(&AnyObject__$)) return "Object";' + nl
		r += 'if (tag_ == (const void*)(&AnyInt__$)) return "Int";' + nl
		r += 'if (tag_ == (const void*)(&AnyFloat__$)) return "Float";' + nl
		r += 'if (tag_ == (const void*)(&FatPair__$)) return "FatPair";' + nl
		r += 'if (tag_ == (const void*)(&HexaNone__$)) return "Null";' + nl
		r += 'return "?";' + nl
		r += rb + nl
		r += 'static const void* hexaReflectLast_ = nullptr;' + nl
		r += 'uint8_t HexaHasReflect_(const void* tag_) ' + lb + nl
		r += 'if (tag_ == (const void*)(&AnyObject__$)) return (uint8_t)1;' + nl
		r += 'if (tag_ == (const void*)(&AnyInt__$)) return (uint8_t)1;' + nl
		r += 'if (tag_ == (const void*)(&AnyFloat__$)) return (uint8_t)1;' + nl
		r += 'if (tag_ == (const void*)(&FatPair__$)) return (uint8_t)1;' + nl
		r += 'if (tag_ == (const void*)(&String__$)) return (uint8_t)1;' + nl
		r += 'if (tag_ == (const void*)(&HexaNone__$)) return (uint8_t)1;' + nl
		r += 'if (tag_ == hexaReflectLast_) return (uint8_t)1;' + nl

		for n in vtableClasses {
			r += 'if (tag_ == (const void*)(&' + n + '__$)) ' + lb + ' hexaReflectLast_ = tag_; return (uint8_t)1; ' + rb + nl
		}
		r += 'return (uint8_t)0;' + nl
		r += rb + nl
		// `hexaUnref` (compile prologue) exempts interned strings from the
		// negative-refcount assert — see the D2/F11 note there. Declared early,
		// defined here because `String__$` only exists after the type section.
		r += 'HEXA_C uint8_t hexaTagIsString_(const void* tag_) ' + lb + ' return (uint8_t)(tag_ != nullptr && tag_ == (const void*)(&String__$)); ' + rb + nl
		// `null`'s `toString` lives here (needs the interned "null" global, which
		// only exists after the Global variables section).
		r += 'static struct String_* HexaNone_hiddenToString_(void* self_) ' + lb + ' (void)self_; return String_1; ' + rb + nl
		return r
	}

	/// F11 sweep v1 (deferred free, D6): scans the live side-table and frees
	/// every `rc == 0` entry (destroy via `HexaDestroyLookup_`, then `HEXA_FREE`;
	/// `AnyObject_` bags free their entry buffer inline — boxes have no table
	/// row and no other inner heap). Swap-remove compacts the list, so a second
	/// sweep never re-frees. Null/immediate/null-tag entries are compacted or
	/// skipped (leak, safe). Re-entrancy guard (destroys only `hexaUnref` + free,
	/// never allocate — belt-and-braces). Called from Hexa `timerPump()` next to
	/// the census — never from the alloc path, so no `HEXA_NEW` re-entry.
	/// Layout note: this section emits AFTER Global variables (`AnyObject_`
	/// must be a complete type for the inline entry-buffer free).
	/// `HEXA_SWEEP_MODE` bisect (diagnostic): 0 = DEFAULT, full incl. strings
	/// (previously menubar UAF — shared interned literals freed while
	/// referenced; ARC now pins every share: immortal globals/statics,
	/// constructor-lowered field defaults, guarded transfers — under test).
	/// 1 = retire `String` objects from the live set without
	/// destroying/freeing them (bucket stays valid for future interns, object
	/// stays mapped for any outstanding referrer — the D2 "interned globals
	/// are immortal" rule made operational; the old bisect mode, kept for
	/// triage). 2 = skip arrays, 3 =
	/// destroy-less only, 4 = off (log only). Latched once per process.
	/// Pressure trigger: every 8192nd managed birth also sweeps (alloc-path
	/// hook in `hexaRegisterLive_`, same TU) so bursty allocators can't
	/// outrun the 600-pump cadence.
	fun printSweep(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// F11 sweep (deferred free of rc==0 live entries, D6)' + nl
		// Per-sweep memory (taskmgr-comparable): WorkingSet + PagefileUsage via
		// K32 (kernel32, no psapi dep — same pattern as the prologue imports).
		// Logged on EVERY sweep so the file shows the reclaim timeline even
		// when the frame pump never runs (headless smoke). Layout is the
		// documented PROCESS_MEMORY_COUNTERS (64-bit): cb@0, faults@4,
		// peakWS@8, WS@16, quotaPeakPaged@24, quotaPaged@32, quotaPeakNonPaged
		// @40, quotaNonPaged@48, pagefile@56, peakPagefile@64 (72 bytes).
		r += 'struct HexaMemCounters_ ' + lb + ' unsigned long cb_; unsigned long pageFaults_; unsigned long long peakWs_; unsigned long long ws_; unsigned long long quotaPeakPaged_; unsigned long long quotaPaged_; unsigned long long quotaPeakNonPaged_; unsigned long long quotaNonPaged_; unsigned long long pagefile_; unsigned long long pagefilePeak_; ' + rb + ';' + nl
		r += '__declspec(dllimport) int K32GetProcessMemoryInfo(void* hProcess, void* ppsmemCounters, unsigned long cb);' + nl
		r += '__declspec(dllimport) void* GetCurrentProcess(void);' + nl
		r += 'static const void* hexaArrayTags_[] = ' + lb

		if arrayDestroyTags.length == 0 {
			r += 'nullptr'
		} else {
			var rows: [String] = []

			for n in arrayDestroyTags { rows.push('(const void*)&' + n + '__$') }
			r += rows.join(', ')
		}
		r += rb + ';' + nl
		r += 'HEXA_C uint8_t hexaTagIsArray_(const void* tag_) ' + lb + ' for (size_t i_ = (size_t)0; i_ < sizeof(hexaArrayTags_)/sizeof(hexaArrayTags_[0]); i_++) ' + lb + ' if (hexaArrayTags_[i_] != nullptr && hexaArrayTags_[i_] == tag_) return (uint8_t)1; ' + rb + ' return (uint8_t)0; ' + rb + nl
		r += 'void hexaSweep(void) ' + lb + nl
		r += 'static uint8_t sweeping_ = 0;' + nl
		r += 'if (sweeping_ != (uint8_t)0) return;' + nl
		r += 'sweeping_ = 1;' + nl
		r += 'static int mode_ = -1;' + nl
		r += 'if (mode_ < 0) ' + lb + ' mode_ = 0; const char* e_ = getenv("HEXA_SWEEP_MODE"); if (e_ != nullptr) mode_ = atoi(e_); ' + rb + nl
		r += 'static int victims_ = 0; victims_ = 0;' + nl
		// Victim logging is DIAGNOSTIC and costs a fopen/fprintf/fclose per
		// victim (up to 64) — with ~40 sweeps/second over a 400k-object live
		// list that dominated the runtime and froze the message loop
		// ("Not Responding" + 45 s stalls inside a JSON.parse). Opt in with
		// HEXA_SWEEP_VERBOSE=1.
		r += 'hexaSweepVerbose_ = (getenv("HEXA_SWEEP_VERBOSE") != nullptr) ? (uint8_t)1 : (uint8_t)0;' + nl
		r += 'size_t freed_ = (size_t)0;' + nl
		r += 'size_t strLive_ = (size_t)0;' + nl
		r += 'size_t strBytes_ = (size_t)0;' + nl
		r += 'size_t strMax_ = (size_t)0;' + nl
		r += 'size_t strBig_ = (size_t)0;' + nl
		r += 'size_t i_ = (size_t)0;' + nl
		r += 'while (i_ < hexaLiveNum_) ' + lb + nl
		r += 'void* p_ = hexaLiveList_[i_];' + nl
		r += 'if (p_ == nullptr) ' + lb + ' hexaLiveNum_--; if (i_ < hexaLiveNum_) hexaLiveList_[i_] = hexaLiveList_[hexaLiveNum_]; continue; ' + rb + nl
		r += 'int64_t v_ = (int64_t)p_;' + nl
		r += 'if (v_ >= (int64_t)-65535 && v_ <= (int64_t)65535) ' + lb + ' hexaLiveNum_--; if (i_ < hexaLiveNum_) hexaLiveList_[i_] = hexaLiveList_[hexaLiveNum_]; continue; ' + rb + nl
		r += 'const void* tag_ = ((const void**)(p_))[0];' + nl
		r += 'if (tag_ == (const void*)(&String__$)) ' + lb + ' strLive_++; strBytes_ += (size_t)(((String_*)(p_))->bytesLength_); if ((size_t)(((String_*)(p_))->bytesLength_) > strMax_) strMax_ = (size_t)(((String_*)(p_))->bytesLength_); if ((size_t)(((String_*)(p_))->bytesLength_) >= (size_t)1048576) strBig_++; ' + rb + nl
		r += 'if (tag_ == nullptr) ' + lb + ' i_++; continue; ' + rb + nl
		r += 'if (((const struct HexaHeader_*)(p_))->rc_ != (int32_t)0) ' + lb + ' i_++; continue; ' + rb + nl
		r += 'if (mode_ == 4) ' + lb + ' i_++; continue; ' + rb + nl
		// D2 "interned globals are immortal", enforced operationally: `String`
		// objects are RETIRED from the live set (never destroyed/freed) in
		// every mode. Proof that freeing them is still unsound: with strings
		// freed, the shared empty literal reaches `rc=-207` (under-counted
		// shares — the missing-retain family in `String_$combine_` /
		// `fromFloat` / `toLowerCase` / `jsonIndent` / `path.basename` guards)
		// and later readers AV on the freed header. Cost: interned strings
		// leak until the allocator can count shared ownership (tracked in
		// docs/target-c.md F11).
		r += 'if (tag_ == (const void*)(&String__$)) ' + lb + ' hexaLiveNum_--; if (i_ < hexaLiveNum_) hexaLiveList_[i_] = hexaLiveList_[hexaLiveNum_]; continue; ' + rb + nl
		r += 'if (mode_ == 2 && hexaTagIsArray_(tag_)) ' + lb + ' i_++; continue; ' + rb + nl
		r += 'if (mode_ == 3) ' + lb + ' void (*dd_)(void*) = HexaHasReflect_(tag_) ? HexaReflectFor_(tag_)->destroy_ : HexaDestroyLookup_(tag_); if (dd_ != nullptr) ' + lb + ' i_++; continue; ' + rb + ' ' + rb + nl
		r += 'if (victims_ < 64) ' + lb + ' victims_++; if (hexaSweepVerbose_ != (uint8_t)0) ' + lb + ' FILE* vf_ = fopen("sweep-census.log", "a"); if (vf_ != nullptr) ' + lb + ' fprintf(vf_, "sweep-victim %s %p", (HexaHasReflect_(tag_) ? HexaReflectFor_(tag_)->className_() : hexaTagName_(tag_)), p_); if (tag_ == (const void*)(&String__$)) ' + lb + ' String_* s_ = (String_*)(p_); fprintf(vf_, " len=%d head=", (int)s_->length_); int32_t n_ = s_->length_ < (int32_t)12 ? s_->length_ : (int32_t)12; for (int32_t k_ = (int32_t)0; k_ < n_; k_++) fprintf(vf_, "%04x ", (unsigned)(s_->bytes_[k_])); int32_t bi_ = (int32_t)(s_->bytesHash_ % 65536); if (bi_ < (int32_t)0) bi_ += (int32_t)65536; uint8_t inb_ = (uint8_t)0; uint8_t ishead_ = (uint8_t)0; String_* cur_ = stringBuckets_[bi_]; if (cur_ == s_) ishead_ = (uint8_t)1; int32_t guard_ = (int32_t)0; while (cur_ != nullptr && guard_ < (int32_t)1000000) ' + lb + ' if (cur_ == s_) ' + lb + ' inb_ = (uint8_t)1; break; ' + rb + ' cur_ = cur_->next_; guard_++; ' + rb + ' fprintf(vf_, " inbucket=%d ishead=%d", (int)inb_, (int)ishead_); HEXA_ASSERT(inb_ == (uint8_t)0, "sweep: freeing an interned String still linked in stringBuckets_ - unlink the weak intern link before free (D6)"); ' + rb + ' fputc(10, vf_); fclose(vf_); ' + rb + ' ' + rb + ' ' + rb + nl
		r += 'if (tag_ == (const void*)(&AnyObject__$)) ' + lb + ' AnyObject_* o_ = (AnyObject_*)(p_); if (o_->entries_ != nullptr) ' + lb + ' for (size_t j_ = (size_t)0; j_ < (size_t)o_->count_; j_++) ' + lb + ' if (Any_isCounted_((Any_*)(o_->entries_[j_].k_))) hexaUnref((void*)(o_->entries_[j_].k_)); if (Any_isCounted_(o_->entries_[j_].v_)) hexaUnref((void*)(o_->entries_[j_].v_)); ' + rb + ' HEXA_FREE(o_->entries_, 0); ' + rb + ' ' + rb + ' else if (tag_ == (const void*)(&FatPair__$)) ' + lb + ' FatPair_* fp_ = (FatPair_*)(p_); if (fp_->env_ != nullptr && !((int64_t)(fp_->env_) >= (int64_t)-65535 && (int64_t)(fp_->env_) <= (int64_t)65535)) hexaUnref(fp_->env_); ' + rb + ' else ' + lb + ' void (*d_)(void*) = HexaHasReflect_(tag_) ? HexaReflectFor_(tag_)->destroy_ : HexaDestroyLookup_(tag_); if (d_ != nullptr) d_(p_); ' + rb + nl
		// D6 unlink (Batch-1 leak/corruption fix): a freed interned String must
		// leave `stringBuckets_` BEFORE `HEXA_FREE` — string identity is the
		// pointer, so a freed-but-linked bucket head corrupts every later
		// intern (the victim-block `HEXA_ASSERT(inb_ == 0)` above stays as the
		// tripwire proving the unlink ran: it checks pre-unlink state).
		r += 'if (tag_ == (const void*)(&String__$)) ' + lb + ' String_* s_ = (String_*)(p_); int32_t bi_ = (int32_t)(s_->bytesHash_ % (int32_t)65536); if (bi_ < (int32_t)0) bi_ += (int32_t)65536; String_** link_ = &stringBuckets_[bi_]; int32_t guard_ = (int32_t)0; while (*link_ != nullptr && guard_ < (int32_t)1000000) ' + lb + ' if (*link_ == s_) ' + lb + ' *link_ = s_->next_; break; ' + rb + ' link_ = &((*link_)->next_); guard_++; ' + rb + ' ' + rb + nl
		r += 'HEXA_FREE(p_, 0);' + nl
		r += 'hexaLiveNum_--;' + nl
		r += 'if (i_ < hexaLiveNum_) hexaLiveList_[i_] = hexaLiveList_[hexaLiveNum_];' + nl
		r += 'freed_++;' + nl
		r += rb + nl
		r += 'FILE* f_ = fopen("sweep-census.log", "a");' + nl
		r += 'if (f_ != nullptr) ' + lb + ' struct HexaMemCounters_ mc_; mc_.cb_ = (unsigned long)sizeof(struct HexaMemCounters_); unsigned long long rssMB_ = (unsigned long long)0; unsigned long long comMB_ = (unsigned long long)0; if (K32GetProcessMemoryInfo(GetCurrentProcess(), (void*)&mc_, (unsigned long)sizeof(struct HexaMemCounters_))) ' + lb + ' rssMB_ = mc_.ws_ / ((unsigned long long)1048576); comMB_ = mc_.pagefile_ / ((unsigned long long)1048576); ' + rb + ' fprintf(f_, "sweep mode=%d freed=%llu live=%llu rssMB=%llu committedMB=%llu strLive=%llu strBytes=%llu strMax=%llu strBig=%llu", mode_, (unsigned long long)freed_, (unsigned long long)hexaLiveNum_, rssMB_, comMB_, (unsigned long long)strLive_, (unsigned long long)strBytes_, (unsigned long long)strMax_, (unsigned long long)strBig_); fputc(10, f_); fclose(f_); ' + rb + nl
		r += 'sweeping_ = (uint8_t)0;' + nl
		r += rb + nl
		return r
	}

	/// F10.3 dynamic call slot: replaces the `AnyValue_` no-op proxy when the
	/// callee carries a boxed fat pair. Boxed args evaluate once into a stack
	/// argv (scalars box via `Any_box*` — pointers pass through); pairs
	/// dispatch via the thunk registry, everything else keeps the legacy
	/// proxy (observably identical — the proxy ignores arguments).
	/// Temps hoist to the enclosing statement via metaBlock (Elvis pattern).
	fun printDynamicCall(callee: Expression, args: [Expression], expects: [Type]?): String {
		// Bare function designators are directly callable (plain globals by
		// name, lifted closures via their thin wrappers) — no `Any`
		// conversion involved, so keep the normal typed call (status quo).
		if isBareFunctionDesignator(callee) {
			return printExpression(callee) + printCallArguments(args, expects)
		}
		let t = tempId++
		let ftmp = '_$ft' + t
		let fargv = '_$fa' + t
		let fres = '_$fr' + t
		let fok = '_$fok' + t
		metaBlock.push('Any_* ' + ftmp + ' = ' + printExpression(callee))
		var boxes: [String] = []

		for a in args {
			// F10: interface-based args print a TYPED value (fat members
			// the boxed pair) — re-box to Any for the argv slot; never
			// re-derive pair halves from struct slots (may be a bag).
			if isInterfaceBase(a) {
				boxes.push(printToAnyConverter(printExpression(a), valueType(a)))
				continue
			}
			// F10.2: object literals into `Any` build real bags (same as
			// every other `Any`-shaped binding site, see printObjectAs).
			if let objArg = printObjectAs(project.typer.typeAny, a) {
				boxes.push(objArg)
			} else if isBoxableFat(a) {
				boxes.push(boxFatPair(a))
			} else {
				boxes.push(printToAnyConverter(printExpression(a), valueType(a)))
			}
		}
		var argvUse = 'nullptr'

		if boxes.length > 0 {
			metaBlock.push('Any_* ' + fargv + '[] = \{' + boxes.join(', ') + '\}')
			argvUse = fargv
		}
		metaBlock.push('Any_* ' + fres + ' = nullptr')
		metaBlock.push('uint8_t ' + fok + ' = 0')
		// F10.5: `FatPair_.call_` is the argv-ABI thunk of the boxed impl (the
		// box site named it at compile time), so dispatch is O(1) — there is no
		// impl→thunk registry. A pair without a `call_` keeps the legacy proxy
		// (visible through the assert below).
		metaBlock.push('if (Any_isFatPair_(' + ftmp + ')) \{ FatPair_* fp = (FatPair_*)(' + ftmp + '); Any_* (*fc)(struct FatPair_*, Any_**, int32_t) = fp->call_; if (fc != nullptr) \{ ' + fres + ' = fc(fp, ' + argvUse + ', ' + args.length + '); ' + fok + ' = 1; \} \}')
		var refs: [String] = []

		for i in args.length {
			refs.push(fargv + '[' + i + ']')
		}
		var legacy = 'AnyValue_\{' + ftmp + '\}(' + refs.join(', ') + ')'
		metaBlock.push('HEXA_ASSERT(!Any_isFatPair_(' + ftmp + ') || ' + fok + ' != 0, "dynamic call: fat pair without a call thunk - falls into the legacy proxy (F10.5)")')
		return '(' + fok + ' ? ' + fres + ' : ' + legacy + ')'
	}

	fun printCallArgumentsVirtual(me: String, args: [Expression], expects: [Type]? = null) {
		if args.length == 0 {
			return '(' + me + ')'
			if let exp = expects, let restElem = hexaRestElement(exp) {
				return printHexaRestCall(args, exp, restElem, me)
			}
		}

		if let exp = expects {
			// Hexa rest `...x: T` (no @nativeVariadic) is `(count, ptr)`.
			if let restElem = hexaRestElement(exp) {
				return printHexaRestCall(args, exp, restElem, me)
			}
			// NOTE `Void`-typed arguments are dropped together with their
			// parameters (see `printFunctionArguments`)
			let results: [String] = []

			for i in args.length {
				if i < exp.length, stringifyType(exp[i]) == 'void' {
					continue
				}

				// S3b F1.6: one Nice function-typed arg → TWO C slots, BUT only
				// when the callee actually takes a fat value here (`Any` sources
				// unbox via bridge + sentinel, M1 compiles).
				if i < exp.length, isFatValueType(exp[i]), (isFatArg(args[i]) or isDynamic(valueType(args[i]))) {
					// S3b: cast the ptr half on signature mismatch (see above).
					let ptrC = fatPtrAs(args[i], exp[i])
					let envC = fatEnvStr(args[i])
					results.push(ptrC)
					results.push(envC)
					continue
				}

				if i >= exp.length, isFatArg(args[i]) {
					let ptrC = fatPtrStr(args[i])
					let envC = fatEnvStr(args[i])
					results.push(ptrC)
					results.push(envC)
					continue
				}

				// Struct-typed literal: real construction (see printObjectAs).
				if i < exp.length, let s = printObjectAs(exp[i], args[i]) {
					results.push(s)
					continue
				}

				// F10.3: fat value into an `Any`-shaped slot boxes a pair
				// (impl + env survive; the dynamic call slot unpacks it).
				// Previously only the ptr half survived. Leaf shapes only
				// (composites have no addressable pair — see isBoxableFat).
				// Single funnel: `boxFatPair` (see #5).
				if i < exp.length, isBoxableFat(args[i]), stringifyType(exp[i]) == 'Any_*' {
					results.push('Any_boxFatPair_((void(*)())(' + fatPtrStr(args[i]) + '), ' + fatEnvStr(args[i]) + ')')
					results.push(boxFatPair(args[i]))
					continue
				}

				let printedArg = printTypeConverter(printExpression(args[i]), valueType(args[i]), exp[i])
				results.push(printedArg)
			}

			// Omitted OPTIONAL trailing arguments — pad typed nulls so the C
			// call matches the declared arity (see `printCallArguments`).
			// S3b: omitted fat params pad a null pair.
			for i in exp.length {
				if i < args.length {
					continue
				}

				if stringifyType(exp[i]) == 'void' {
					continue
				}

				if isFatValueType(exp[i]) {
					results.push('nullptr')
					results.push('hexaSentinelEnv_')
					continue
				}

				results.push(padValue(exp[i]))
			}

			return '(' + me + ', ' + results.join(', ') + ') '
		}

		return '(' + me + ', ' + [for a in args printExpression(a)].join(', ') + ')'
	}

	fun getFunctionReturnType(funcType: Type): Type? { switch funcType {
			case Function(args, returns):
				return returns
			case _:
				return null
		} }

	fun printFunctionReturnType(funcType: Type): String { switch funcType {
			case Function(args, returns):
				return stringifyType(returns)
			case _:
				return 'void'
		} }

	/// F9 linkage: async funs are C++ (coroutines; `co_await`/`co_return`
	/// require C++ linkage — `extern "C"` coroutines are ill-formed), rest
	/// stay C (direct host links without pragma aliasing — pragma only covers
	/// `__imp_` DLL thunks). Outer `extern "C" {` wrapper is retained for
	/// variables/prototypes; functions carry explicit linkage (inner wins).
	/// Callers resolve via updated forwards (mangled→mangled match); C++ async
	/// calling C sync (via outer-C protos) and C calling C++ async (via C++
	/// forwards) are both legal. No host changes (host only calls C entry
	/// points: `HEXA_MAIN`, sync `__onNative*`).
	/// REDESIGN NOTE (#7, as-is for now): when C++ coroutines go, async funs
	/// become plain `HEXA_C` functions again and this prefix collapses.
	fun linkagePrefix(isAsync: Bool): String {
		if isAsync { return 'HEXA_CPP ' }
		return 'HEXA_C '
	}

	fun linkagePrefixFor(isAsync: Bool, emittedName: String): String {
		if isAsync { return 'HEXA_CPP ' }

		if project.inlineFuncs.get(emittedName) == true {
			return 'HEXA_C HEXA_FORCEINLINE '
		}

		return 'HEXA_C '
	}

	/// F9: `async fun f(): T` emits `Promise<T>* f()` (C++ coroutine returning
	/// a settled-or-pending `Promise*`; `await` co_awaits it). `T=Void` maps
	/// to `Promise<void>*` (`Promise_$void_*`, value still `Any?*`). Uses
	/// `typePromise` (set when `class Promise<T>` registers, before user code).
	/// Nullable unwraps to the inner layout (`Promise<Any?>` -> `Promise<Any>`,
	/// same `Any_*` pointer, js-identical) so no `Null$` Promise structs are
	/// minted (their generic instances never fill, hence C2027/C2065).
	/// Idempotent: already-`Promise` passes through (typer now wraps async
	/// returns, so `printAsyncReturnType` sees `Promise<T>` directly).
	/// REDESIGN NOTE (#7, as-is for now): return type becomes whatever the
	/// state-machine lowering needs — not a coroutine `Promise*`.
	fun promiseOf(t: Type): Type {
		switch t {
			case ClassInstance(c, g):
				if c.name == 'Promise', g != null, g.length == 1 {
					return t
				}
			case _:
		}

		switch t {
			case Nullable(inner):
				return Type.ClassInstance(project.typer.typePromise, [Type.unwrapNullable(inner)])
			case UnknownNullable(handle):
				if handle.value != null {
					return Type.ClassInstance(project.typer.typePromise, [Type.unwrapNullable(handle.value)])
				}
				return Type.ClassInstance(project.typer.typePromise, [project.typer.typeAny])
			case null:
				return Type.ClassInstance(project.typer.typePromise, [project.typer.typeAny])
			case _:
				return Type.ClassInstance(project.typer.typePromise, [t])
		}
	}
	fun printAsyncReturnType(funcType: Type): String { switch funcType {
			case Function(args, returns):
				return stringifyType(promiseOf(returns))
			case _:
				return stringifyType(promiseOf(project.typer.typeVoid))
		} }

	/// F9: one inner `extern "C++"` block after Types (structs complete for
	/// `sizeof`, before async funs needing traits). Per collected `Promise_X_`:
	/// global `operator co_await`, `HexaPromiseType_X` (vtable init, settled
	/// `return_value(Any_*)`/`return_void()`), `std::coroutine_traits` partial
	/// spec (any args: `this`, env-first closures, methods). `HEXA_CPP`
	/// linkage (C++), zero host edits (callers resolve via updated C++ forwards).
	fun printCoroutines(): String {
		if promiseStructs.length == 0 {
			return ''
		}
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '#ifdef __cplusplus' + nl
		r += 'extern "C++" ' + lb + nl

		for s in promiseStructs {
			r += 'HEXA_PROMISE_CORO(' + s + ')' + nl
		}
		r += rb + ' // extern "C++"' + nl
		r += '#endif' + nl
		return r
	}

	/// Scalar-receiver `toString` (e.g. `(n ?? 0).toString()` on `Int`): vtable
	/// dispatch (`int->_->toString_`) is invalid C — emit the matching
	/// `String_$from*` conversion helper instead (radix args are dropped:
	/// decimal only in Phase 1). Returns null for non-scalar receivers so
	/// the normal vtable path applies.
	/// DELETION CANDIDATE (retain until the next implementor re-verifies
	/// on green MSVC smoke): `reflectPost` owns zero-arg + radix-10 scalar
	/// `.toString` (hoist-free, so it covers globals/defaults/arrow bodies
	/// too); keep this for non-10 radix, untyped/dynamic/`Any` receivers
	/// and missing `String` class.
	fun scalarToString(receiverPrinted: String, receiverShape: String): String? {
		if receiverShape == 'int32_t' {
			return 'String_$fromInt32_(' + receiverPrinted + ')'
		}

		if receiverShape == 'int64_t' {
			return 'String_$fromInt64_(' + receiverPrinted + ')'
		}

		if receiverShape == 'uint64_t' or receiverShape == 'uint32_t' {
			return 'String_$fromUInt64_(' + receiverPrinted + ')'
		}

		if receiverShape == 'double' or receiverShape == 'float' {
			return 'String_$fromFloat_(' + receiverPrinted + ')'
		}

		if receiverShape == 'Bool_' {
			return 'String_$fromBool_(' + receiverPrinted + ')'
		}

		// Narrow ints widen to the helper widths (`uint32_t` handled above
		// via `fromUInt64` — `fromInt32` would go negative over 2^31, same
		// as `printTypeConverter`'s `UInt32 -> String` arm).
		if receiverShape == 'int8_t' or receiverShape == 'int16_t'
			or receiverShape == 'uint8_t' or receiverShape == 'uint16_t' {
			return 'String_$fromInt32_((int32_t)(' + receiverPrinted + '))'
		}

		return null
	}

	/// Zero/null literal matching a C parameter type — for padded optional
	/// arguments (`HitBox(text, x, y)` against `new (…, w: Float = 0, …)`)
	fun padValue(to: Type): String { let name = stringifyType(to)

		if name == 'double' {
			return '(double)0.0'
		}

		if name == 'float' {
			return '(float)0.0'
		}

		// D2: managed/`Any` padding is the sentinel OBJECT, not a null pointer.
		// Shape-gated exactly like the converter below: an ERASED target
		// (`Unknown`/generic/`Any`-payload) can TYPE as managed while its C
		// shape is a scalar (`int32_t`) — pouring a pointer into that slot is
		// C4311 (pointer truncation) and passes garbage where `null` was meant.
		if isNullSentinelType(to), (name == 'Any_*' or name.endsWith('_*')) {
			return '(' + name + ')(&HexaNone_)'
		}

		return printTypeConverter('nullptr', Type.UnknownNullable({ value: null }), to)
	}

	/// Casts a dynamic (`Any_*`/proxy) operand to the peer operand's C type.
	/// Boxed payloads unbox through the D7 helpers (real values now that
	/// `Any` carries them); unknown shapes read zero (stub parity).
	fun castOperand(toName: String, string: String): String {
		if toName == 'double' or toName == 'float' {
			return '((' + toName + ')(Any_unboxFloat_(' + string + ')))'
		}

		if toName.endsWith('*') or toName.startsWith('_$') {
			return '(' + toName + ')(' + string + ')'
		}

		return '((' + toName + ')(Any_unboxInt64_(' + string + ')))'
	}

	fun printToAnyConverter(string: String, fromType: Type): String {
		// D2: `null` in an `Any` slot is the sentinel OBJECT, never a null
		// pointer. This matters beyond tidiness: `if let` guards lower to
		// `Any_equals_(x, null)`, and a slot holding 0 would then read as
		// NON-null (0 != sentinel), walking `x->field` on a null object.
		if string == 'nullptr' {
			return '(struct Any_ *) (size_t) (&HexaNone_)'
		}

		if fromType == project.typer.typeAny {
			// F7: bridge through `size_t` (not a raw pointer cast) — the Nice
			// type may say `Any` while the C value is a scalar (widened-field
			// debt, e.g. `layout.statusBarHeight_`); raw `(Any*)(int32)` is
			// C4312, the round-trip is lossless for real pointers and
			// js-identical (genJs erases types).
			return '(struct Any_ *) (size_t) ( /*Any*/ ' + string + ') '
		}

		// F10: inline STRUCT → dynamic shape. A struct's first word is
		// DATA, so `Any_dynGet_`'s legacy `let_` dispatch would treat field0
		// as a vtable and JUMP into it (observed: field0 = a String → RIP =
		// the String vtable +0x0). Materialize an AnyObject bag instead:
		// keys are the interned declaration names (pointer identity — the
		// design's linear entries), values convert to `Any`. Nested struct
		// values recurse; statements hoist to metaBlock (same protocol as
		// struct/interface literal construction).
		// DELETION CANDIDATE (retain until the next implementor re-verifies
		// on green MSVC smoke): `reflectPost` now owns struct→bag at
		// Var/Const/Assign/Return/call-arg/If `Any` positions (incl.
		// nesting + spills + Nullable-plain fields); keep this arm ONLY for
		// non-hoist positions (globals/defaults/arrow bodies/while-conds/
		// switch-cases/guards/`&&`/`||` RHS), fat/`Any`/nullable-struct/
		// untyped fields, `If`-`Elsevis` unlowered shapes and empty-`expects`
		// calls the signature probe misses.
		switch fromType {
			case Struct(names, fieldTypes):
				let tid = tempId++
				let sp = '_$sp' + tid
				let tmp = '_$sb' + tid
				let shape = stringifyType(fromType)
				// Only pointer-shaped struct values can be null; a by-value
				// `@byValue` struct keeps the plain build.
				let guarded = shape.endsWith('_*')
				let gcb = String.fromCharCode(123)
				let gcc = String.fromCharCode(125)
				metaBlock.push(shape + ' ' + sp + ' = ' + string)

				if guarded {
					// The source may be a NULLABLE struct whose C shape is still
					// the bare pointer (e.g. `selection: if let s = tab.selection
					// { { startLine: ... } } else { null }` -> `Struct_N_*` that
					// can be nullptr or the sentinel). Reading a field off a dead
					// value is an AV read at address 0 - Perfide's `pushUndo`
					// crashed on the FIRST typed character this way. Dead source
					// yields the null sentinel (never a zero-filled bag), a live
					// source builds the real bag.
					metaBlock.push('Any_* ' + tmp + ' = (Any_*)(size_t)(&HexaNone_)')
					metaBlock.push('if (' + sp + ' != nullptr && ' + sp + ' != (' + shape + ')(size_t)(&HexaNone_)) ' + gcb)
					metaBlock.push(tmp + ' = Any_objectNew_()')
				} else {
					metaBlock.push('Any_* ' + tmp + ' = Any_objectNew_()')
				}

				for i in names.length {
					var vstr = printToAnyConverter('(' + sp + '->' + names[i] + '_)', fieldTypes[i])

					if isFatValueType(fieldTypes[i]) {
						// Struct fat fields are thin single values (Phase 1)
						// — box as pair with a sentinel env (dynamic calls on
						// them keep the legacy proxy, as before).
						vstr = 'Any_boxFatPair_((void(*)())(' + sp + '->' + names[i] + '_), hexaSentinelEnv_, nullptr)'
					}
					metaBlock.push('Any_objectSet_(' + tmp + ', ' + printExpression(Expression.String(names[i])) + ', ' + vstr + ')')
				}

				if guarded { metaBlock.push(gcc) }
				return tmp
			case _:
		}

		if fromType == project.typer.typeBool {
			return 'Any_fromBool(' + string + ')'
		}

		// D7: real `Any` payloads (were null stubs). Widening conversions are
		// value-preserving; `UInt64` reinterprets (narrow spot, documented).
		if fromType == project.typer.typeInt {
			return 'Any_boxInt_(' + string + ')'
		}

		if fromType == project.typer.typeInt8 or fromType == project.typer.typeInt16 or fromType == project.typer.typeInt32 {
			return 'Any_boxInt_(' + string + ')'
		}

		if fromType == project.typer.typeInt64 {
			return 'Any_boxInt_(' + string + ')'
		}

		if fromType == project.typer.typeUInt8 or fromType == project.typer.typeUInt16 or fromType == project.typer.typeUInt32 {
			return 'Any_boxInt_(' + string + ')'
		}

		if fromType == project.typer.typeUInt64 {
			return 'Any_boxInt_((int64_t)(' + string + '))'
		}

		if fromType == project.typer.typeFloat {
			return 'Any_boxFloat_(' + string + ')'
		}

		if fromType == project.typer.typeFloat32 {
			return 'Any_boxFloat_((double)(' + string + '))'
		}

		if fromType == project.typer.typeNumber {
			return 'Any_boxFloat_(' + string + ')'
		}

		if string == 'nullptr' {
			// D2: `null` in an `Any` slot is the sentinel object, not 0 — the
			// dynamic ops dispatch on its tag (`toBool` false, `toString`
			// "null", reads null), so no `== nullptr` special case is needed.
			return '(struct Any_ *) (size_t) (&HexaNone_)'
		}

		let fromName = stringifyType(fromType)

		// `Any`-shaped sources evaluate to WHATEVER the substituted C value
		// is (pointer or scalar) — bridge through `size_t` which accepts both
		if fromName == 'Any_*' {
			return '(struct Any_ *) (size_t) (' + string + ')'
		}

		// Object pointers and function pointers cast straight through
		if fromName.endsWith('*') or fromName.startsWith('_$') {
			return '(struct Any_ *) (' + string + ')'
		}

		// Remaining C ints box through int64 (any width fits; uint64
		// reinterprets — narrow spot, documented). No int-like value may
		// cross as a raw `size_t` placeholder: unboxers read small ints as
		// values, so placeholders must be real boxes.
		if fromName == 'int8_t' or fromName == 'int16_t' or fromName == 'int32_t' or fromName == 'int64_t' or fromName == 'uint8_t' or fromName == 'uint16_t' or fromName == 'uint32_t' or fromName == 'uint64_t' {
			return 'Any_boxInt_((int64_t)(' + string + '))'
		}

		if fromName == 'float' or fromName == 'double' {
			return 'Any_boxFloat_((double)(' + string + '))'
		}

		// Truly exotic scalars keep the legacy bridge (same as before).
		// Tagged `/*EXOTIC*/` for triage (see #1): every hit is a shape
		// that should gain an explicit `Any_box*` arm or a Nice-side
		// lowering instead of crossing as a raw `size_t` placeholder.
		// Unboxers read small ints as values, so placeholders must stay
		// real boxes — if this fires on a scalar, add the box arm.
		return '(struct Any_ */*EXOTIC*/)(size_t)(' + string + ')'
	}

	fun printValueToNullableConverter(string: String, fromValue: Type, to: Type): String {
		return '%printValueToNullableConverter%'
	}

	/// F10: `Any` -> struct call site — registers the shape (deduped by the
	/// generated helper name) and returns the call. `printAnyToStruct`
	/// emits the decls + bodies into the output.
	fun anyToStructStr(string: String, names: [String], fieldTypes: [Type]): String {
		let sname = omitPointer(stringifyType(Type.Struct(names, fieldTypes)))
		let fn = 'Any_toStruct_' + sname

		if anyToStructNames.get(fn) == null {
			anyToStructNames.set(fn, names)
			anyToStructTypes.set(fn, fieldTypes)
		}
		return fn + '(' + string + ')'
	}

	/// F10: emit the registered `Any` -> inline-struct helpers (#6: DYNAMIC
	/// REGAINS static shape). Decls first (bodies may call nested helpers),
	/// then bodies. A bag value fills the DECL-order fields through the
	/// interned keys; any other value passes through (legacy raw pointers
	/// stay raw — see `/*PASS-THROUGH*/`); null -> nullptr. FUTURE (Nice
	/// classes for Any stuff): replace with `reflectPost` lowering once
	/// `Any`/bags are Nice classes — bag reads become field reads, helpers
	/// disappear, and the `HEXA_ASSERT` tripwire retires with them.
	fun printAnyToStruct(): String {
		if anyToStructNames.keys().length == 0 {
			return ''
		}
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var keys: [String] = []

		for k in anyToStructNames.keys() {
			keys.push(k)
		}
		var r = ''

		for i in keys.length {
			let fn = keys[i]
			let sname = fn.substring(13, fn.length)
			r += 'HEXA_C ' + sname + '* ' + fn + '(Any_* v_);' + nl
		}

		for i in keys.length {
			let fn = keys[i]
			let sname = fn.substring(13, fn.length)
			let names = (anyToStructNames.get(fn) as![String])
			let types = (anyToStructTypes.get(fn) as![Type])
			r += 'HEXA_C ' + sname + '* ' + fn + '(Any_* v_) ' + lb + nl
			r += ' if (v_ == nullptr) return nullptr;' + nl
			r += ' if (((const void**)v_)[0] == (const void*)(&String__$) || hexaTagIsArray_(((const void**)v_)[0])) ' + lb + ' HEXA_ASSERT(0, "Any_toStruct: got a string/array payload - upstream Any-to-struct conversion gap"); return nullptr; ' + rb + nl
			// Headered payloads (bags, class instances, interface structs —
			// `Name_*` values carry a vtable AND `rc_` BEFORE their fields)
			// CANNOT be reinterpreted as the headerless `Struct_N_` layout
			// the caller expects: taking `.line_` at offset 0 would read the
			// vtable pointer. Every reflect-capable payload therefore
			// rebuilds field-by-field through `dyn_get` (the bag arm below
			// is the same path). Only a genuinely headerless legacy struct
			// passes through raw.
			r += ' if (((const void**)(v_))[0] != (const void*)(&AnyObject__$) && !HexaHasReflect_(((const void**)v_)[0])) return /*PASS-THROUGH (#6: headerless legacy struct stays raw)*/ (' + sname + '*)(size_t)(v_);' + nl
			r += ' ' + sname + '* s_ = (' + sname + '*)(HEXA_NEW(sizeof(' + sname + ')));' + nl

			for j in names.length {
				let fieldT = types[j]
				let anyV = anyDynGetStr('v_', names[j])
				var ftS = stringifyType(fieldT)
				var ftBase = fieldT

				switch ftBase {
					case Nullable(inner): ftBase = inner
					case _:
				}
				var val = ''

				if isFatValueType(fieldT) {
					// Struct fat fields are thin single values — unbox the
					// boxed pair (see the struct->bag side).
					val = '(' + ftS + ')(size_t)(Any_isFatPair_(' + anyV + ') ? ((FatPair_*)(' + anyV + '))->impl_ : nullptr)'
				} else {
					switch ftBase {
						case Struct(_, _):
							val = printTypeConverter(anyV, project.typer.typeAny, fieldT)
						case _:
					}

					if val == '' {
						if ftS.endsWith('*') {
							val = '(' + ftS + ')(size_t)(' + anyV + ')'
						} else {
							val = printTypeConverter(anyV, project.typer.typeAny, fieldT)
						}
					}
				}
				r += ' s_->' + names[j] + '_ = ' + val + ';' + nl
			}
			r += ' return s_;' + nl + rb + nl
		}
		return r
	}

	fun printNullableToValueConverter(string: String, fromValue: Type, to: Type): String {
		return '%printNullableToValueConverter%'
	}

	/// NOTE this is a strict `as!` kind of conversion
	fun printTypeConverter(string: String, fromValue: Type, to: Type): String {
		if fromValue == to {
			return string
		}

		// `Void`-typed values (fire-and-forget calls, `async` bodies without
		// `return`) carry no C value — sequence the call for its effects and
		// yield a typed null (placeholder until the async runtime lands, F9).
		// NOTE `to == Void` (e.g. `return;`) prints the bare call instead
		if fromValue == project.typer.typeVoid {
			if to == project.typer.typeVoid {
				return string
			}

			return '(' + string + ', (' + stringifyType(to) + ')0)'
		}

		// Dynamic `Any`-shaped sources (`Generic` stubs, erased generics)
		// convert through the same helpers as `Any` (D7). NOTE the `null`
		// literal is dynamic-shaped too but converts type-directed
		var dynamicSource = isDynamic(fromValue)

		switch fromValue {
			case UnknownNullable(handle):
				if handle.value == null {
					dynamicSource = false
				}
			case _:
		}

		if dynamicSource {
			if to == project.typer.typeBool {
				return 'Any_toBool_(' + string + ')'
			}

			if to == project.typer.typeInt or to == project.typer.typeInt8 or to == project.typer.typeInt16 or to == project.typer.typeInt32 {
				return 'Any_unboxInt_(' + string + ') '
			}

			if to == project.typer.typeUInt8 or to == project.typer.typeUInt16 or to == project.typer.typeUInt32 {
				return '((uint32_t)(Any_unboxInt_(' + string + '))) '
			}

			if to == project.typer.typeFloat {
				return 'Any_unboxFloat_(' + string + ') '
			}

			if to == project.typer.typeNumber {
				return 'Any_unboxFloat_(' + string + ') '
			}

			if to == project.typer.typeFloat32 {
				return '((float)(Any_unboxFloat_(' + string + '))) '
			}

			if to == project.typer.typeInt64 {
				return 'Any_unboxInt64_(' + string + ') '
			}

			if to == project.typer.typeUInt64 {
				return '(uint64_t)(Any_unboxInt64_(' + string + ')) '
			}

			// S3b: `Any` to fat-typedef unboxes through a `size_t` bridge
			// (M1 compiles with sentinel env elsewhere; F10 makes it exact)
			if isFatValueType(to) {
				return '(' + stringifyType(to) + ')(size_t)(' + string + ') '
			}
		}

		// F10: `Any` -> inline struct — inverse of the struct->bag
		// materialization in printToAnyConverter (#6: DYNAMIC REGAINS static
		// shape — a runtime `Any` payload reconstructs a typed struct through
		// the generated per-struct helper: bag -> DECL-order fields read via
		// interned keys; a non-bag value passes through for legacy raw
		// pointers; null -> nullptr). Registered on demand; printAnyToStruct
		// emits decls + bodies. FUTURE (Nice classes for Any stuff): lower in
		// `reflectPost` once `Any`/bags are Nice classes (bag reads become
		// field reads, helpers disappear) — until then this arm stays.
		var toStructType = to

		switch toStructType {
			case Nullable(inner): toStructType = inner
			case _:
		}

		if isDynamic(fromValue) or fromValue == project.typer.typeAny {
			switch toStructType {
				case Struct(names, fieldTypes):
					return anyToStructStr(string, names, fieldTypes)
				case _:
			}
		}

		// Integers
		if fromValue == project.typer.typeUInt16, to == project.typer.typeInt {
			return '(int32_t/*!*/)(' + string + ')'
		}

		// TODO combine all `== project.typer.typeAny` to single `if`
		if fromValue == project.typer.typeBool, to == project.typer.typeAny {
			return 'Any_fromBool(' + string + ')'
		}

		if fromValue == project.typer.typeAny, to == project.typer.typeBool {
			return 'Any_toBool_(' + string + ')'
		}
		// ^ TODO ((==null)?false:_toBool)
		// != null SHOULD BE DONE ONLY FOR NULLABLE AND Any
		if fromValue == project.typer.typeAny, to == project.typer.typeInt or fromValue == project.typer.typeAny, to == project.typer.typeInt8 or fromValue == project.typer.typeAny, to == project.typer.typeInt16 or fromValue == project.typer.typeAny, to == project.typer.typeInt32 {
			return 'Any_unboxInt_(' + string + ')'
		}
		// ^ TODO ((==null)?0:_toInt) cause 1+null+2=3

		if fromValue == project.typer.typeAny, to == project.typer.typeUInt8 or fromValue == project.typer.typeAny, to == project.typer.typeUInt16 or fromValue == project.typer.typeAny, to == project.typer.typeUInt32 {
			return '((uint32_t)(Any_unboxInt_(' + string + ')))'
		}

		if fromValue == project.typer.typeAny, to == project.typer.typeFloat {
			return 'Any_unboxFloat_(' + string + ')'
		}

		if fromValue == project.typer.typeAny, to == project.typer.typeNumber {
			return 'Any_unboxFloat_(' + string + ')'
		}
		// ^ TODO ((==null)?0.0:_to) cause 1+null+2=3

		if fromValue == project.typer.typeAny, to == project.typer.typeInt64 {
			return 'Any_unboxInt64_(' + string + ') '
		}

		if fromValue == project.typer.typeAny, to == project.typer.typeUInt64 {
			return '(uint64_t)(Any_unboxInt64_(' + string + ')) '
		}

		if fromValue == project.typer.typeAny, to == project.typer.typeFloat32 {
			return '((float)(Any_unboxFloat_(' + string + '))) '
		}

		if fromValue == project.typer.typeInt, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		if fromValue == project.typer.typeInt8, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		if fromValue == project.typer.typeUInt8, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		if fromValue == project.typer.typeInt16, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		if fromValue == project.typer.typeUInt16, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		// 64-bit
		if fromValue == project.typer.typeUInt32, to == project.typer.typeString {
			return 'String_$fromUInt64_(' + string + ')'
		}

		if fromValue == project.typer.typeInt64, to == project.typer.typeString {
			return 'String_$fromInt64_(' + string + ')'
		}

		if fromValue == project.typer.typeUInt64, to == project.typer.typeString {
			return 'String_$fromUInt64_(' + string + ')'
		}

		// TODO ^ from Float, etc
		if fromValue == project.typer.typeBool, to == project.typer.typeString {
			return 'String_$fromBool_(' + string + ')'
		}

		if fromValue == project.typer.typeFloat, to == project.typer.typeString {
			return 'String_$fromFloat_(' + string + ') '
		}

		if fromValue == project.typer.typeNumber, to == project.typer.typeString {
			return 'String_$fromFloat_(' + string + ') '
		}

		if fromValue == project.typer.typeFloat32, to == project.typer.typeString {
			return 'String_$fromFloat_(' + string + ') '
		}

		if fromValue == project.typer.typeString {
			switch to {
				case ClassInstance(classType, generic):
					// TODO for strict type check, store all strings like "ConstCharPointer" as constants
					if classType.name == 'ConstCharPointer' {

						return '(' + string + ')->bytes_'
					}

					if classType.name == 'ConstArrayPointer' {

						switch generic[0] {
							// TODO `case (project.typer.typeInt):`
							case ClassInstance(of): // TODO `instance as of`
								switch of.name {
									// NOTE `.bytes` is array of `UInt16` not `ClangWideChar`
									// to guarantee 16-bit even when `-fshort-wchar` is not set
									case 'ClangWideChar': return '(wchar_t *)((' + string + ')->bytes_)'
								}
						}
						return '(' + string + ')->bytes_'
					}
			}

			if string == 'String_199' {
			}
		}

		switch fromValue {
			case Nullable(_):
			case UnknownNullable(_):
			case _:
				if to == project.typer.typeString {
					let cleanedType = omitPointer(stringifyType(fromValue))
					// TODO use meta block
					if cleanedType != 'Any_' {
						// Direct `toString_` call — every class emits one (the
						// synthesized `[object Object]` fallback included)
						return cleanedType + '$toString_(' + string + ') '
					}

					// `Any` — unbox through the D7 helper: real strings pass
					// through, boxed scalars format, everything else keeps
					// the `"null"` placeholder (status quo ante).
					return 'Any_unboxString_((struct Any_ *)(size_t)(' + string + ')) '
				}
		}

		// console.log(to) // , (to as! Any). ConstCharPointer

		if to == project.typer.typeAny {
			return printToAnyConverter(string, fromValue)
		}

		// Erased-`Any` expectations that stringify to `Any_*` but are NOT the
		// typeAny object: a null slot (unbound signature element — the
		// Array<null>-receiver fallout) and `Any?` (rest-args like
		// `console.log(...Any?)`). Without these arms the converter fell
		// through to a RAW pass-through and MSVC reported C2664 (concrete
		// String_*/int32_t/Struct_* into an `Any_*` parameter).
		if to == null {
			return printToAnyConverter(string, fromValue)
		}

		switch to {
			case Nullable(toNull):
				if toNull == project.typer.typeAny {
					return printToAnyConverter(string, fromValue)
				}
			case _:
		}

		if fromValue != to {
			// TODO in future reformat into `case N(A),N(B)|A,B if (A==B):` etc complex nested combined patterns
			// TODO what if use `E.nullable` instead of `Null(E)`? meh than T1 != T2 would be broken?
			switch to {
				// `T? = _`
				case Nullable(toNull): switch fromValue {
						case Nullable(fromNull):
							// `var x: T? = T?`
							if toNull == fromNull {
								return string
							}

							if to == project.typer.typeNullUInt64 {
								return 'toNull$UInt64((uint64_t)(' + string + '))'
							}

							// `var x: A? = B?` unsafe conversion
							// TODO `(Int?) as! (Float?)` should not be bit-cast (how C does `(double)(int)123`?)
							return '(/*A? = B?*/' + stringifyType(to) + ')(' + string + ')'
						case _:
							// `var x: T? = T`
							// TODO do in normalizer ToNullable(v,t1,t2)
							if toNull == fromValue {
								if toNull == project.typer.typeInt {
									return '((int32_t$)(' + string + '))' // TODO
								}

								if toNull == project.typer.typeUInt64 {
									return '(Null$UInt64)\{' + string + ', 1\}'
								}

								if toNull == project.typer.typeInt64 {
									return '(Null$Int64)\{' + string + ', 1\}'
								}

								if toNull == project.typer.typeFloat {
									// TODO isn't it `Null$Float64`?
									return '(Null$Float)\{' + string + ', 1\}'
								}

								if toNull == project.typer.typeNumber {
									return 'Null$Float64\{' + string + ', 1\}'
								}

								if toNull == project.typer.typeFloat32 {
									return '(Null$Float32)\{' + string + ', 1\}'
								}

								// TODO more (un)wrapping cases for basic types where needed
								return string
							}
							// `var x: A? = B` unsafe conversion
							// TODO `(Int?) as! (Float)` should not be bit-cast (how C does `(double)(int)123`?)

							switch fromValue {
								// Essentially just `null`
								case UnknownNullable(value): if value.value == null {
										if toNull == project.typer.typeInt or toNull == project.typer.typeInt32 {
											return 'int32_t$null'
										}
										// TODO null float etc as struct for now
										if toNull == project.typer.typeUInt32 {
											return 'uint32_t$null'
										}

										if toNull == project.typer.typeInt16 {
											return 'int16_t$null'
										}

										if toNull == project.typer.typeUInt16 {
											return 'uint16_t$null'
										}

										if toNull == project.typer.typeInt8 {
											return 'int8_t$null'
										}

										if toNull == project.typer.typeUInt8 {
											return 'uint8_t$null'
										}

										if toNull == project.typer.typeUInt64 {
											return '(Null$UInt64)\{0, 0\}'
										}

										if toNull == project.typer.typeInt64 {
											return '(Null$Int64)\{0, 0\}'
										}

										if toNull == project.typer.typeFloat {
											return '(Null$Float64)\{0.0, 0\}'
										}

										if toNull == project.typer.typeNumber {
											return 'Null$Float64\{0.0, 0\}'
										}

										if toNull == project.typer.typeFloat32 {
											return '(Null$Float32)\{0.0f, 0\}'
										}

										if toNull == project.typer.typeBool {
											return '/*Bool.null*/(uint8_t)2'
										}

										switch toNull {
											case ClassInstance(classType):
												if classType.name == 'ClangWideChar' {
													return '(wchar_t)0'
												}
										}

										if toNull == null {
											return string // TODO seems like unspecified generic type <T>
										}

										// D2: `null` for a managed/`Any` target is the
										// sentinel OBJECT (header + reflection vtable), so
										// retain/release stay blind `rc++`/`rc--` and every
										// dynamic op answers virtually. `_*` shapes are the
										// managed ones (`Foo_*`, `Any_*`, `Array_$X_*`) — that
										// also covers ERASED generics (`T` prints `Any_*`),
										// where the runtime type may be managed. Native
										// pointers (`const uint16_t*`, `void*`) and scalars
										// keep their own null form.
										let targetShape = stringifyType(toNull)

										if isNullSentinelType(toNull) or targetShape == 'Any_*' or targetShape.endsWith('_*') {
											return '(' + targetShape + ')(&HexaNone_)'
										}

										return '/*%T? = null%*/(' + string + ')'
									}
							}

							// return '(/*2 from=' + stringifyType(fromValue) + '*/' + stringifyType(to) + ')(' + string + ')
							return '(/*A? = B*/' + stringifyType(to) + ')(' + string + ')'
					}
					// `T = _`
				case _: switch fromValue {
						case Nullable(fromNull):
							// `var x: T = T?` used in `if let`
							if to == fromNull {
								if fromNull == project.typer.typeInt {
									return '(int32_t)(' + string + ')' // Should truncate
									// TODO Example `return string + '.value_'`
								}

								if
									(fromValue == project.typer.typeNullUInt64 and to == project.typer.typeUInt64)
									or
									(fromValue == project.typer.typeNullFloat and to == project.typer.typeFloat)
									or
									(fromValue == project.typer.typeNullNumber and to == project.typer.typeNumber)
									or
									(fromValue == project.typer.typeNullFloat32 and to == project.typer.typeFloat32)
								{
									return string + '.value_'
									// NOTE no need to validate `has_` cause `null => has_ == 0 and value == 0`
								}
								return string + '/*T = T?*/'
								return '%T = T?%'
							}

							if fromNull == project.typer.typeInt, to == project.typer.typeString {
								return 'String_$fromNullableInt32_(' + string + ')'
							}

							if fromNull == project.typer.typeBool, to == project.typer.typeString {
								return 'String_$fromBool_(' + string + ')'
							}

							if fromNull == project.typer.typeFloat, to == project.typer.typeString {
								return 'String_$fromFloat_(' + string + '.value_)'
							}

							if fromNull == project.typer.typeNumber, to == project.typer.typeString {
								return 'String_$fromFloat_(' + string + '.value_)'
							}

							if fromNull == project.typer.typeFloat32, to == project.typer.typeString {
								return 'String_$fromFloat_(' + string + '.value_)'
							}

							// `var x: A = B?` unsafe conversion
							// TODO `(Int?) as! (Float)` should not be bit-cast (how C does `(double)(int)123`?)
							return '(/*A = B? \(stringifyType(fromNull)) */' + stringifyType(to) + ')(' + string + ')'
						case _:
							// `var x: T = T`
							if to == fromValue {
								// No cast needed
								// TODO probably still generate a cast, maybe there's bindings use-case
								return string
							}

							// `var x: A = B` unsafe conversion
							switch fromValue {
								// Essentially just `null`, not `T?`!
								case UnknownNullable(value): if value.value == null {
										if to == project.typer.typeInt or to == project.typer.typeInt32 {
											return 'int32_t$null'
										}
										// TODO null float etc as struct for now
										if to == project.typer.typeUInt32 {
											return 'uint32_t$null'
										}

										if to == project.typer.typeInt16 {
											return 'int16_t$null'
										}

										if to == project.typer.typeUInt16 {
											return 'uint16_t$null'
										}

										if to == project.typer.typeInt8 {
											return 'int8_t$null'
										}

										if to == project.typer.typeUInt8 {
											return 'uint8_t$null'
										}
										// TODO this `if` should be detected as unreachable (if `to` is `let`)
										if to == project.typer.typeInt {
											return '(int32_t)0'
										}
										// '((Null$Int32)(' + string + ')).value_'
										if to == null {
											return string // TODO seems like unspecified generic type <T>
										}
										return '(/*T = null*/' + stringifyType(to) + ')(' + string + ')'
										return '%T = null%' //
									}
							}

							let tot = JSON.stringify('' + to) // ??!
							if to == null {
								return string
							}

							// TODO do in normalizer
							var fromStructByValue = false
							var fromBasicType = false
							switch fromValue {
								case ClassInstance(classType):
									let atts = project.mapDecorators.get(classType.parent)

									fromBasicType = Decorator.getDecorator(atts, 'nativeBasicType') != null

									fromStructByValue = Decorator.getDecorator(atts, 'byValue') != null
									fromStructByValue = fromStructByValue or classType.name == 'ByValue'
									// TODO
									// or classType.name == 'ArrayByValue'
							}
							var toStructByPointer = false
							var toStructByValue = false
							switch to {
								case ClassInstance(classType):
									let atts = project.mapDecorators.get(classType.parent)

									toStructByPointer = Decorator.getDecorator(atts, 'struct') != null

									toStructByValue = Decorator.getDecorator(atts, 'byValue') != null
									toStructByValue = toStructByValue or classType.name == 'ByValue'
									// TODO
									// or classType.name == 'ArrayByValue'
							}

							// if stringifyType(to) == stringifyType(fromValue) {
							// return string
							// }

							if fromStructByValue and toStructByPointer, not fromBasicType {
								return '(/*struct to pointer*/' + stringifyType(to) + ')&(' + string + ')'
							}

							if fromStructByValue and toStructByValue {
								return '*((/*struct to struct*/' + omitPointer(stringifyType(to)) + '*)&(' + string + '))'
							}

							// Special case in C++: cast from pointer to smaller type 'uint32_t'
							if to == project.typer.typeUInt32 {
								return '(uint32_t)(size_t)(' + string + ')'
							}

							return '(' + stringifyType(to) + ')(' + string + ')'
							return '(' + stringifyType(to) + '/*ff*/)(' + string + ')'
							return '(/*A = B*/' + '/*\(tot)*/' + stringifyType(to) + ')(' + string + ')' //
					}
			}
		}
		return string
		+ '/*TO*/'
		// TODO ANYTHING to string should be checked =null always
	}

	var thisArgument: String? = null
	fun printFunctionArguments(args: [String], funcType: Type, variadic: VariadicKind = VariadicKind.NotVariadic) {
		// New function scope: forget previous locals (params + locals below
		// register into `localDecls` so `cShape` sees the DECLARED C types)
		localDecls = [:]

		if args.length == 0, thisArgument != null {
			// TODO variadic
			return '(' + thisArgument + ')'
		}

		if args.length == 0 {
			// TODO variadic
			return '(void)' // Otherwise C function takes infinite number of arguments
		}

		switch funcType {
			case Function(types, _):
				let results: [String] = []

				if let thisArgument = thisArgument {
					results.push(thisArgument)
				}

				// Hexa rest `...x: T` (no @nativeVariadic) is fixed `(count, ptr)`.
				var hexaRestElement: Type? = null
				var fixedLen = args.length

				if types.length > 0, args.length > 0 {
					switch types[types.length - 1].dataType {
						case Rest(element, native):
							if not native {
								hexaRestElement = element
								fixedLen = args.length - 1
							}
					}
				}

				for a in fixedLen {
					// S3a fat impl env-first: leading `$env` (only lifted
					// `closure$N` have it; user code cannot contain `$`) prints
					// as uniform `void* $env_` (holds any `Env$N_*`/sentinel).
					// Nice keeps the concrete type for callExpects; C needs
					// void* so every function-typed value has identical shape.
					// Registered as `Any` so the `$envT` UnsafeBitCast bridges
					// via `(size_t)` (void*→Env$N_* needs an explicit cast).
					if a == 0, args.length > 0, args[0] == '$env' {
						localDecls.set('$env', project.typer.typeAny)
						results.push('void* $env_')
						continue
					}
					// S3b F1.6: function-typed params double up (`name$ptr_`,
					// `name$env_`) from the type alone; env half is uniform
					// `void*`. Single Nice binding stays one `localDecls` entry.
					if isFatValueType(types[a].dataType) {
						localDecls.set(args[a], types[a].dataType)
						let ptrType = stringifyType(types[a].dataType)
						results.push(ptrType + ' ' + args[a] + '$ptr_')
						results.push('void* ' + args[a] + '$env_')
						continue
					}
					let argType = stringifyType(types[a].dataType)

					// `Void` parameters carry no value — dropped here and in
					// the function-type typedefs (see `stringifyType`)
					if argType == 'void' {
						continue
					}

					// Declare for `cShape` — use nodes may lie about type
					localDecls.set(args[a], types[a].dataType)
					let result = argType + ' ' + args[a] + '_'
					results.push(result)
				}

				if let elem = hexaRestElement {
					// Hexa ABI: `(fixed..., int32_t $nrest_, Elem* $rest_)`.
					// Stack-allocated plain C array at the call site, no `Array` object.
					let elemC = stringifyType(elem)
					localDecls.set('$nrest', project.typer.typeInt)
					localDecls.set('$rest', Type.Rest(elem, false))
					results.push('int32_t $nrest_')
					results.push(elemC + '* $rest_')
				}

				if variadic == VariadicKind.NativeVariadic {
					results.pop() // Last argument is unused
					// Raw C `...` (printf/FFI) — named rest slot dropped, extras raw.
					// Hexa rest never reaches here (fixed count+ptr above).
					results.push('...')
				}

				if results.length == 0 {
					return '(void)' // Otherwise C function takes infinite number of arguments
				}

				return '(' + results.join(', ') + ')'

				// TODO Incompatible types `String` and value of `Array<String?>`
				// var thisArgument: String? = null
				// let results: String = (thisArgument != null)? [thisArgument] : []
				// lol result [String] no String

				// TODO seems like dead code
				// return '(' + [for a in args.length {
				// var result = stringifyType(types[a]) + ' ' + args[a] + '_'
				// if (defaults) { switch types[a] {
				// case Nullable(_): result += ' = ((Unknown_ *)0)'
				// case UnknownNullable(_): result += ' = ((Unknown_ *)0)'
				// }}
				// result
				// }].join(', ') + ')'
		}

		// TODO seems like dead code
		return '(' + [for a in args.length
			'Any_* ' + args[a] + '_'
		].join(', ') + ')'
		// TODO defaults
		// 'void* ' + args[a] + ((defaults != null && defaults[a] != null)? ' = ' + printExpression(defaults[a]) : '')
	}

	fun stringType(t: NodeType, prefix: String) {
		// let prefix = prefix? '' : ''
		if (t == null) {
			return 'void*'
		}
		// if (t == null) return prefix + 'void*'
		switch t {
			case ParametricType(name, params):
				// if (name == 'Buffer') return prefix + name
				// return prefix + name + '<' + [for (param in params) stringType(param, false)].join(', ') + '>'
				return '_x' + name
			case Type(name):
				// if (name == 'Any') return prefix + 'void*'
				return '_x' + name
			case Object(_):
				// return prefix + '\{\}'
			case Optional(t):
				// return prefix + 'Null<' + stringType(t, false) + '>'
				return stringType(t, '')
		}

		return prefix + 'void*'
	}

	fun printType(t: NodeType) {
		let typeName = stringType(t, '')
		return typeName
	}

	fun stringifyType(t: Type, prefixNull: Bool = false): String {
		switch t {
			case Generic(index, name):
				return 'Any_*'
				return 'Any_*/*Generic*/' // TODO + '/*Generic<\(name)>*/'
			case Nullable(t):
				let name = stringifyType(t)

				if name == 'int32_t' {
					return 'int32_t$'
				}

				if name == 'int16_t' {
					return 'int16_t$'
				}

				if name == 'int8_t' {
					return 'int8_t$'
				}

				if name == 'Bool' {
					return 'Bool_'
				}

				if name == 'double' {
					return 'Null$Float64'
				}

				if name == 'float' {
					return 'Null$Float32'
				}

				if name == 'uint64_t' {
					return 'Null$UInt64'
				}

				if name == 'int64_t' {
					return 'Null$Int64'
				}

				if prefixNull == true {
					return 'Null$' + name
				}

				return name
			case Unknown(handle):
				return stringifyType(handle.value, prefixNull)
			case UnknownNullable(handle):
				// if let value = handle.value {
				// return 'Null$' + stringifyType(handle.value, prefixNull)
				// }
				// return 'Null$Unknown_*'
				// return 'Null$' + stringifyType(handle.value, prefixNull)
				return stringifyType(handle.value, prefixNull)
			case ClassInstance(classType, generics):
				// TODO generic params < T > !!!!! just output into C++  templates
				// TODO type == typer.typeX

				if classType.name == 'ByValue' {
					return omitPointer(stringifyType(generics[0], prefixNull))
				}

				if classType.name == 'Int' {
					return 'int32_t'
				}

				if classType.name == 'Int8' {
					return 'int8_t'
				}

				if classType.name == 'Int16' {
					return 'int16_t'
				}

				if classType.name == 'Int32' {
					return 'int32_t'
				}

				if classType.name == 'Int64' {
					return 'int64_t'
				}

				if classType.name == 'UInt8' {
					return 'uint8_t'
				}

				if classType.name == 'UInt16' {
					return 'uint16_t'
				}

				if classType.name == 'UInt32' {
					return 'uint32_t'
				}

				if classType.name == 'UInt64' {
					return 'uint64_t'
				}

				// Useful for `sizeof`
				if classType.name == 'ArrayByValue' {
					return stringifyType(generics[0]) + '[' + stringifyType(generics[1]) + ']'
				}

				let atts = project.mapDecorators.get(classType.parent)
				// TODO refactor
				var renamed = ''

				if let rename = Decorator.getDecorator(atts, 'rename') {
					renamed = DataHelper.asStringAttValue(rename, 0)
					//

					/*console.log('renamed -->', renamed)
						if generics == null {
							if Decorator.getDecorator(atts, 'byValue') != null {
								return renamed
							}
							return renamed + '*'
						}*/
				}

				if let generic = generics, renamed == 'ConstArrayPointer' {
					return 'const ' + stringifyType(generic[0]) + '*'
				}

				if let generic = generics, renamed == 'ArrayPointer' {
					return stringifyType(generic[0]) + '*'
				}

				if let generic = generics, renamed == 'ArrayByValue' {
					// if let count = generic[1] {
					// return stringifyType(generic[0]) + '[' + Type.stringify(count) + ']'
					// }
					// return stringifyType(generic[0]) + '[]'
					return stringifyType(generic[0])
				}

				// Keeps three states: 1 = true, 0 = false, 2 = null
				if classType.name == 'Bool' {
					return 'Bool_'
				}

				// WinDef.h `typedef int BOOL;`
				// TODO should be just simple `enum Bool32 : Int32 { True False }`
				// TODO error if `Enum.V == xx` if Enum != simple enum (i.e. creates new instance so always false)
				// TODO allow short syntax `x == True` & `x != True` if enum's simple type is known
				if classType.name == 'Bool32' {
					return 'int32_t'
				}

				// WinDef.h `typedef BYTE BOOLEAN; typedef unsigned char BYTE;`
				// TODO UBool8?
				if classType.name == 'Bool8' {
					return 'uint8_t'
				}

				// TODO apparently should be just `@rename('void')`
				if classType.name == 'Void' {
					return 'void'
				}

				if classType.name == 'Float' {
					return 'double'
				}

				if classType.name == 'Number' {
					return 'double'
				}

				// if (let jsNative = classType.jsNative) return jsNative

				let atts = project.mapDecorators.get(classType.parent)

				let struct = Decorator.getDecorator(atts, 'struct') != null
				let byValue = Decorator.getDecorator(atts, 'byValue') != null

				if byValue and not struct {
					throw 'Must be @struct to be @byValue'
				}

				let native = Decorator.getDecorator(atts, 'rename')

				if let native = native { switch (native.values[0]) {
						case String(s):
							if struct and byValue {
								return s
							}

							if struct {
								return s + '*'
							}
							return s
					} }

				if let generic = generics, generic.length > 0 {
					var name = classType.name

					if let instanceOf = classType.instanceOf {
						name = instanceOf.name
					}

					name += '_$' + [for param in generic {
							mangleTypeSegment(stringifyType(param, prefixNull: true))
						}].join('$')
						// + '*'

						// name = name.replace('_*_', '_*')

						// F9: record every `Promise_X` instantiation for the
						// post-Types `operator co_await` + `promise_type` block
						// (struct forwards flushed separately in `stringify`,
						// since `stringifyType` cannot see local `forward`).
					if name == 'Promise' or name.startsWith('Promise_$') or name.startsWith('Promise_$_') {
						var structName = name + '_'

						if name.endsWith('_') {
							structName = name
						}

						if not promiseStructs.includes(structName) {
							promiseStructs.push(structName)
						}
					}

					if name.endsWith('_') {
						return name + '*'
					}

					return name + '_*'
				}

				// Generic class without instance params — erases to `Any_*`
				// (`Array_*` etc are not emitted C types)
				if classType.genericParams.length > 0 {
					return 'Any_*'
				}

				return classType.name + '_*'
			case Class(classType):
				// return stringifyType(Type.ClassInstance(classType, null))
				// A bare generic CLASS value (no instance params) erases to
				// `Any_*` — `Array_*` is not an emitted C type
				if classType.genericParams.length > 0 {
					return 'Any_*'
				}

				return classType.name + '_*'
				// TODO ^ probably requires rename basic types too?
			case Enum(enumType):
				if let sub = enumType.fieldsTypeSimple {
					let atts = project.mapDecorators.get(enumType.parent)

					if let rename = Decorator.getDecorator(atts, 'castTo') {
						return DataHelper.asStringAttValue(rename, 0)
					}

					return stringifyType(sub)
				}

				return enumType.name + '_*'
			case EnumInstance(enumType):
				return stringifyType(Type.Enum(enumType))
				// if let sub = enumType.fieldsTypeSimple {
				// return stringifyType(sub)
				// }
				// return enumType.name + '_*/*EnumInstance*/'
			case Struct(names, fieldTypes):
				// Inline structural type (`interface { ... }`) — mint a real C
				// struct with the named fields so member accesses compile
				// (one definition per distinct shape; F10 reflection later)
				let fields: [String] = []

				for i in names.length {
					fields.push(stringifyType(fieldTypes[i]) + ' ' + names[i] + '_')
				}

				let signature = fields.join(';')

				if let existing = structDefsMap.get(signature) {
					return existing
				}

				let structName = 'Struct_' + (tempId++)
				structDefsMap.set(signature, structName + '_*')
				structDefsForward.push('struct ' + structName + '_;')
				structDefsForward.push('typedef struct ' + structName + '_ ' + structName + '_;')
				structDefs.push('struct ' + structName + '_ \{\n\t' + fields.join(';\n\t') + ';\n\};\n')
				return structName + '_*'
			case Function(args, returns):
				// NOTE nested function types emit their own typedefs, so all
				// names must be resolved BEFORE this declaration is assembled
				// or their `typedef ...` text interleaves into the middle of it
				let returnName = stringifyType(returns)
				let a: [String] = []

				for arg in args {
					switch arg.dataType {
						case Rest(element, native):
							if not native {
								// Hexa rest is `(count, ptr)` — two C slots.
								a.push('int32_t')
								a.push(stringifyType(element) + '*')
								continue
							}
							// Native `...` has no typedef slot (raw C variadic).
							continue
					}
					let argName = stringifyType(arg.dataType)

					// `Void` parameters carry no value — drop them (both at
					// the typedef and at the emitted functions/call sites) or
					// `Promise<Void>` produces `void value_` parameters
					if argName == 'void' {
						continue
					}

					a.push(argName)

					// S3b fix: nested fat params double up (mirror
					// `printFunctionArguments` — one Nice function-typed
					// param is TWO C slots `ptr, env`)
					if isFatValueType(arg.dataType) {
						a.push('void*')
					}
				}

				// Same signature = same typedef name (stable for mangling)
				// S3b: every function typedef is fat (env-first `void*`) so all
				// function-typed values share one shape (`f$ptr(f$env, ...)`).
				// Thin direct globals never use typedefs (called by name).
				let fatA = ['void*']

				for x in a {
					fatA.push(x)
				}
				let signature = returnName + ' (' + defaultCallingConvention + ')(' + fatA.join(', ') + ')'

				if let existing = typedefFunctionsMap.get(signature) {
					return existing
				}

				let temp = tempId++
				let name = '_$\(temp)'
				typedefFunctionsMap.set(signature, name)
				typedefFunctions.push('typedef ')
				typedefFunctions.push(returnName)
				// TODO use better name like _fun_123_
				// TODO de-dup all function types in normalizer, expressions to use funcTypes[id]
				// typedefFunctions.push(' (*_$\(temp))(')
				typedefFunctions.push(' (')
				// TODO respect `link.convention`
				typedefFunctions.push(defaultCallingConvention)
				typedefFunctions.push('*')
				typedefFunctions.push(name)
				typedefFunctions.push(')(')
				typedefFunctions.push(fatA.join(', '))
				typedefFunctions.push(');\n')
				return name
				// return 'Any_* /*Function* /'
			case Rest(element, _):
				// Hexa rest lowers to `(count, ptr)` — the ptr alone is `Elem*`.
				return stringifyType(element) + '*'
			case Constant(value): return value
			case null:
				return 'Any_*'
				return 'Any_*/*null*/' // TODO
			case _:
				console.log(t)
				throw 'stringifyType ' + t
		}
	}

	// TODO move to Expression static fun
	fun getType(e: Expression): Type { switch e {
			case Int(_): return project.typer.typeInt
			case MetaInt(_, kind):
				switch kind {
					case Int8: return project.typer.typeInt8
					case Int16: return project.typer.typeInt16
					case Int32: return project.typer.typeInt32
					case Int64: return project.typer.typeInt64

					case UInt8: return project.typer.typeUInt8
					case UInt16: return project.typer.typeUInt16
					case UInt32: return project.typer.typeUInt32
					case UInt64: return project.typer.typeUInt64
				}

			case Float(_): return project.typer.typeFloat
			case String(_): return project.typer.typeString
			case True: return project.typer.typeBool
			case False: return project.typer.typeBool
			case Ident(_, dataType): return dataType
			case Parenthesis(expr): return getType(expr)
			case Call(_, _, dataType): return dataType
				// case If(_): return project.typer.typeAny
			case Binop(_, _, _, dataType): return dataType
			case NativeOperator(_, _, _, _, dataType): return dataType
			case Dot(_, _, dataType): return dataType
			case This(dataType): return dataType
			case Null: return Type.UnknownNullable({ value: null })
			case UnsafeBitCast(_, to): return to
			case Index(_, _, result): return result
			case New(_, _, result): return result
			case Array(_, result): return result
			case Map(keys, values, keyType, valueType, mapType): return mapType
			case Unop(op, postfix, e): return getType(e) // TODO `-N` should convert `UInt` to `Int` in typer
			case Unop(op, postfix, e): {
					// `!x`/`not x` is always `Bool` (the operand type would
					// append a bogus outer `->_toBool()` on dynamic values)
					if not postfix, op == Token.KNot or op == Token.Exclamation {
						return project.typer.typeBool
					}

					return getType(e) // TODO `-N` should convert `UInt` to `Int` in typer
				}
				// If result lives in the node (D8) — Normalizer fills it from typer.
			case If(_, _, _, result):
				return result
			case Enum(dataType, tagName, tag, args):
				// TODO
				return project.typer.typeAny
			case EnumTag(expr):
				// TODO
				return project.typer.typeAny
			case Function(_):
				// TODO
				return project.typer.typeAny
			case Arrow(_):
				// TODO
				return project.typer.typeAny
			case Object(_):
				// TODO
				return project.typer.typeAny
				// `await e` — Promise<T> unwraps to T, plain values pass through
			case Await(e): {
					let inner = getType(e)

					switch inner {
						case ClassInstance(classType, generic):
							if classType.name == 'Promise', generic != null, generic.length == 1 {
								return generic[0]
							}
					}
					return inner
				}
				// `a ?? b` — same as the typer: type of the fallback
			case Elvis(_, otherwise): return getType(otherwise)
				// `x !.` — type of the unwrapped value
			case RemoveNullability(_, result): return result
				// `"str"[i]`
			case StringIndex(_, _, result): return result
				// `x is T`
			case Is(_, _): return project.typer.typeBool
				// `...value` — a runtime list cannot expand statically, neutral `Any`
			case Spread(_): return project.typer.typeAny
			case StringConcatenation(_, _): return project.typer.typeString
				// `a op= b` evaluates to the target's type
			case Assignop(a, _, _): return getType(a)
			case EnumParameter(_): return project.typer.typeAny
				// Unbound `_` must never reach codegen — it is a compilation error
			case Underscore:
				throw 'getType: expression `_` reached codegen'
			case _:
				// console.log(e, 'getType unknown case', project.expressionPosition.get(e))
				// TODO unknown kinds must not crash generation — report & continue
				// throw 'getType ' + e
				return project.typer.typeAny
		} }

	/// Returns type name without last `*` on the end
	fun omitPointer(typeName: String): String {
		if typeName.endsWith('*') {
			return typeName.substr(0, typeName.length - 1)
		}
		return typeName
	}

	/// Dynamic (`Any`-shaped) values — `Any`, untyped, `Generic` stubs and
	/// erased bare-generic classes all stringify to `Any_*` at the C level and
	/// must route member access through the reflection stub (F10)
	fun isDynamic(dataType: Type?): Bool {
		return stringifyType(dataType) == 'Any_*'
	}

	/// S3b: concrete function types (plus nullable-function, null → null pair)
	/// lower to TWO C vars from the type alone (no IR pairing node). `Any_*`
	/// (erased/Generic) stays dynamic (existing `Any` paths); method values
	/// stay thin (F6). Used by bindings, calls, fields, `==`, conversions.
	fun isFatValueType(dataType: Type?): Bool { switch dataType {
			case Function(_, _, _):
				return true
			case Nullable(inner):
				return isFatValueType(inner)
			case _:
				return false
		} }

	/// Any-shaped values that may hold managed payloads (exact `Any`, its
	/// nullables, erased generics): ARC retains/releases them through the
	/// `Any_isCounted_` runtime guard, never blind. Mirrors the ARC-pass
	/// `isAnyLike` predicate — both must agree.
	fun isAnyLikeValue(dataType: Type?): Bool {
		if dataType == null {
			return false
		}

		if dataType == project.typer.typeAny {
			return true
		}

		switch dataType {
			case Nullable(inner):
				return isAnyLikeValue(inner)
			case UnknownNullable(inner):
				return isAnyLikeValue(inner)
			case Unknown(inner):
				return isAnyLikeValue(inner.value)
			case _:
				return false
		}
	}

	/// D2: types whose `null` is the OBJECT sentinel `&HexaNone_` — every
	/// reflection-managed class instance (`String`, `Array_$T$`, `Map`, user
	/// classes: they carry the `__$` tag and the `rc_` header) and `Any`.
	/// Native pointers (`ConstArrayPointer`/`ArrayPointer` lower to raw `T*`),
	/// payload words (`CString8/16`, `RuntimeAllocated`, `ClangWideChar`) and
	/// minted inline structs keep the raw null pointer: no header, never
	/// counted, so a sentinel there would be a lie.
	fun isNullSentinelType(dataType: Type?): Bool {
		if dataType == null {
			return false
		}

		if dataType == project.typer.typeAny {
			return true
		}

		switch dataType {
			case Nullable(inner):
				return isNullSentinelType(inner)
			case UnknownNullable(inner):
				return isNullSentinelType(inner)
			case Unknown(inner):
				return isNullSentinelType(inner.value)
			case ClassInstance(c, _):
				if c.name == null {
					return false
				}

				for n in ['ConstArrayPointer', 'ArrayPointer', 'ArrayByValue', 'RuntimeAllocated', 'ClangWideChar', 'CString8', 'CString16', 'StackAsciiString', 'HeapAsciiString', 'Embed', 'ByValue'] {
					if c.name == n {
						return false
					}
				}

				for n in ['Int', 'Int8', 'Int16', 'Int32', 'Int64', 'UInt8', 'UInt16', 'UInt32', 'UInt64', 'Bool', 'Bool32', 'Bool8', 'Float', 'Float32', 'Number', 'Void', 'BigInt', 'SizeOfPointer', 'SignedSizeOfPointer', 'ClangChar'] {
					if c.name == n {
						return false
					}
				}

				if c.name.startsWith('Struct_') {
					return false
				}

				return true
			case _:
				return false
		}
	}

	/// Whether a call callee must go through the `AnyValue_` call proxy:
	/// an `Any_*`-SHAPED callee is a raw pointer and `ptr(args)` is not valid
	/// C++ even with `Any_::operator()`. DECLARED types win over use-node
	/// types here too: an untyped callback param (`onUpdate` in an `async fun`)
	/// carries a dynamic/function use type while its C parameter is `Any_*`.
	/// Module-level function idents (no declared entry) stay raw calls.
	fun isDynamicCallee(e: Expression): Bool {
		switch e {
			case Ident(name):
				if let t = localDecls.get(name) {
					return stringifyType(t) == 'Any_*'
				}

				if let t = globalDecls.get(name) {
					return stringifyType(t) == 'Any_*'
				}
				// F10.2: lowered dynamic calls (`a[i]` → `a.get(i)`) build
				// `Dot` nodes with a null result, so `getType` says nothing —
				// key on the DECLARED base type instead (declared types win).
				// Static/typed bases (`Math.floor`, `m.get` on a Map) stay
				// false here exactly as before. Static bases take the static
				// print path (TitleCase ident) — never dynamic, even though a
				// bare class ident is typeless (null stringifies to `Any_*`,
				// which `isDynamic` would otherwise accept). Mirrors
				// `dotFieldKind`.
			case Dot(base, _, _):
				var isStaticBase = false
				switch base {
					case Ident(id, _):
						if id.charAt(0) == id.charAt(0).toUpperCase(), not id.startsWith('_'), not id.startsWith('$') {
							isStaticBase = true
						}
					case _:
				}

				if not isStaticBase, isDynamic(valueType(base)) {
					return true
				}
			case _:
		}

		return getType(e) != null and isDynamic(getType(e))
	}

	/// D7 truthiness for a CONDITION (`if`/`while`/ternary/`&&`/`||`): an
	/// `Any`-shaped value goes through `Any_toBool_` (JS: null/`false`/0/''
	/// falsy), never C pointer-non-null. `Bool_`/scalar shapes print as-is.
	fun printCondition(e: Expression): String {
		if cShape(e) == 'Any_*' {
			// `(size_t)` bridge: the use node can claim `Any` while the printed
			// value is already a scalar `Bool_` (callback flags) — the cast
			// keeps both shapes compiling and is harmless for a real `Any_*`.
			return 'Any_toBool_((Any_*)(size_t)(' + printExpression(e) + '))'
		}
		return printExpression(e)
	}

	/// The C shape of an expression's VALUE. For identifiers the DECLARED
	/// type wins over the Nice type of the use node: the typer may coerce an
	/// `Any` variable's use to `Int` (the use node then lies about the C
	/// value, which is still `Any_*`) — operand classification and conversion
	/// must key on what is actually printed
	fun cShape(e: Expression): String {
		return stringifyType(valueType(e))
	}

	/// F10.2: `==`/`!=` operand shape with dynamic roots corrected. The typer
	/// coerces `Any` uses to the expected type (use-node lies), but a `Dot`
	/// on a dynamic base prints `Any_*` (`Any_dynGet_`) no matter what the
	/// use node claims — keying on the lie emits raw cross-type compares
	/// (C2446). Static bases keep their real shape (mirrors `dotFieldKind`).
	fun binopShape(e: Expression): String {
		switch e {
			case Dot(base, _, _):
				var isStaticBase = false
				switch base {
					case Ident(id, _):
						if id.charAt(0) == id.charAt(0).toUpperCase(), not id.startsWith('_'), not id.startsWith('$') {
							isStaticBase = true
						}
					case _:
				}

				if not isStaticBase, isDynamic(valueType(base)) {
					return 'Any_*'
				}
			case _:
		}
		return cShape(e)
	}

	/// F10.2: conversion source type for `==`/`!=` box-both. A dynamic root
	/// prints `Any_*` even when the use node claims a concrete type (the
	/// lie) — boxing through the lie (`Any_boxInt_` of an `Any_*`, C2664)
	/// is wrong; bridge through `Any` instead. Agrees with `binopShape`.
	fun binopFromType(e: Expression): Type {
		if binopShape(e) == 'Any_*' {
			return project.typer.typeAny
		}
		return valueType(e)
	}

	/// Leaves of a `+` chain that is statically plain `String` all the way
	/// down (parentheses unwrapped). Anything else — a nullable `String?`, an
	/// `Any`, a number coerced by JS `+` — fails the walk and keeps the
	/// nullable `String_$combine_` path with its `null` → `"null"` coercion.
	fun collectStringAddLeaves(e: Expression, out: [Expression]): Bool {
		var lhs: Expression? = null
		var rhs: Expression? = null

		switch e {
			case Binop(a, op, b):
				if op == Token.Add {
					lhs = a
					rhs = b
				}
			case Parenthesis(inner):
				return collectStringAddLeaves(inner, out)
			case _:
		}

		if lhs == null {
			if valueType(e) != project.typer.typeString { return false }

			if cShape(e) != 'String_*' { return false }
			out.push(e)
			return true
		}
		var ok = false

		if let l = lhs {
			ok = collectStringAddLeaves(l, out)
		}

		if not ok { return false }

		if let r = rhs {
			return collectStringAddLeaves(r, out)
		}
		return false
	}

	fun remapInlineKeys(oldName: String, newName: String, methods: [Statement]) {
		for m in methods { switch m {
				case Function(mname, _, _, _, _, _, _):
					if project.inlineFuncs.get(oldName + '_$' + mname + '_') == true {
						project.inlineFuncs.set(newName + '_$' + mname + '_', true)
					}
				case _:
			} }
	}

	fun renameClassNamesEmit() {
		for c in project.classes {
			if c.external {
				if c.jsRequire != null { continue }

				if c.jsNative != null { continue }

				if not stringifyType(c.classType).endsWith('_*') { continue }
			}

			// `Any`/`Bool` map onto runtime shapes and templates keep only
			// their static members — never renamed by the types loop
			var builtinName = c.name

			switch c.classType {
				case Class(kind):
					builtinName = kind.name
				case _:
			}

			if builtinName == 'Any' { continue }

			if builtinName == 'Bool' { continue }

			if c.template { continue }

			var cName = ''

			switch c.classType {
				case Class(kind):
					cName = kind.name
				case _:
					cName = stringifyType(c.classType).replace('_*', '')
			}

			if cName == c.name { continue }

			c.name = cName
		}
	}

	/// `@final` method on a parentless, non-template class: no override can
	/// exist, so `recv->_->m(recv, …)` is provably `Cls_$m_(recv, …)` and the
	/// direct call is emitted (the vtable load + indirect call was the only
	/// thing keeping `charCodeAt`/`concat`/`substring` opaque to the C
	/// optimizer). Async (needs `co_await`) and variadic (rest ABI) methods
	/// keep the vtable path.
	///
	/// NOTE the `@final` trait is read off the DECLARATION node the type points
	/// at, and `This`-typed receivers arrive as `Type.Class` (not
	/// `ClassInstance`) — both arms below, or `this.someMethod()` inside a
	/// `@final` class kept the vtable hop. The class scan must also not stop at
	/// the FIRST name match: a generic instance can appear several times in
	/// `project.classes` (per-module duplicates — the genC log prints
	/// `duplicate struct Array_$…`) and the first copy may carry no methods.
	fun finalMethodName(exprType: Type, name: String, where: String = '', pos: String = ''): String? {
		var isFinal = false
		var attsState = 'null'
		var typeKind = 'other'

		switch exprType {
			case ClassInstance(kind, _):
				typeKind = 'ClassInstance'
				let atts = project.mapDecorators.get(kind.parent)
				attsState = atts == null? 'null' : 'present'
				isFinal = Decorator.getDecorator(atts, 'final') != null
				// `this` inside a method types as a bare `Class` value
			case Class(kind):
				typeKind = 'Class'
				let atts = project.mapDecorators.get(kind.parent)
				attsState = atts == null? 'null' : 'present'
				isFinal = Decorator.getDecorator(atts, 'final') != null
			case _:
		}

		if not isFinal {
			return null
		}
		// NOTE the emitted member prefix is the NiceClass `name`
		// (`Array_$int32_t` → `Array_$int32_t_$push_`), and instance types
		// stringify to the POINTER form (`Array_$int32_t_*`, `String_*`), so the
		// receiver side is stripped and compared with `name`/`name + '_'`.
		// NOTE the class list can hold SEVERAL entries per monomorph (the genC
		// log prints `duplicate struct Array_$…`), and the duplicate is the one
		// whose `classType` still stringifies to the mangled name while being
		// `useless` (no bodies emitted) — so key on the NAME + emit flags, never
		// on `stringifyType(c.classType)` (that used to make every library-side
		// receiver miss: only the useless duplicate matched, and the scan bailed
		// out of the whole loop on the first name mismatch).
		let wanted = omitPointer(stringifyType(exprType))

		for c in project.classes {
			if c.name != wanted and c.name + '_' != wanted { continue }

			if c.useless {
				continue
			}

			if c.external {
				continue
			}

			if c.extend != null {
				continue
			}

			if c.template {
				continue
			}
			// Only a plain class DECLARATION emits `Name_$method_`; interfaces and
			// erased shapes have no member bodies to call directly.
			var isPlainClass = false

			switch c.classType {
				case Class(_): isPlainClass = true
					// Monomorphization of a `@final` generic (`Array_$String_`):
					// `isFinal` above already verified the decorator on the
					// DECLARATION, `c.extend == null` (checked above) means no
					// subclass can exist, and the mangled `c.name` already ends
					// with `_` — the emitted member is `Name$method_`.
				case ClassInstance(_, _): isPlainClass = true
				case _:
			}

			if not isPlainClass {
				continue
			}
			// Instantiated names already end with `_`: their members are
			// `Array_$String_$join_`; plain classes emit `String_$trim_`.
			var sep = '_$'

			if c.name.endsWith('_') { sep = '$' }

			for m in c.methods {
				var direct: String? = null

				switch m {
					case Function(mname, _, _, _, mfuncType, mvariadic, misAsync):
						if mname == name {
							if misAsync { direct = null }
							else if mvariadic != VariadicKind.NotVariadic { direct = null }
							else { direct = c.name + sep + name + '_' }
						}
					case _:
				}

				if let hit = direct {
					return hit
				}
			}
		}
		return null
	}

	/// C-shaped scalar classifiers for `==`/`!=` mismatched widths: pure
	/// scalar pairs compare by VALUE (int64, or double if a float is
	/// involved) so sentinel loops (`c != 0`) terminate after D7 boxing
	/// (heap boxes break per-value pointer identity); pointer-involved
	/// shapes keep the legacy box-both identity compare.
	fun isIntCTypeName(name: String): Bool {
		return name == 'int8_t' or name == 'int16_t' or name == 'int32_t' or name == 'int64_t' or name == 'uint8_t' or name == 'uint16_t' or name == 'uint32_t' or name == 'uint64_t'
	}
	fun isFloatCTypeName(name: String): Bool {
		return name == 'float' or name == 'double'
	}

	/// Pure `is` receivers (evaluating twice is harmless): plain idents,
	/// `Dot` chains over them (stub `let_` getters, no mutation) and `as`
	/// bit-casts (no side effects — the cast is a C-style reinterpret).
	/// Calls and exotic shapes keep the legacy single-evaluation truthiness path.
	fun isPureIsReceiver(e: Expression): Bool { switch e {
			case Ident(_, _): return true
			case Dot(base, _, _): return isPureIsReceiver(base)
			case Parenthesis(inner): return isPureIsReceiver(inner)
			case UnsafeBitCast(inner, _): return isPureIsReceiver(inner)
			case _: return false
		} }

	/// F10.1 scalar half: `x is Int` / `is String` / `is Bool` / `is Float` on an
	/// `Any` payload is a REAL runtime shape test (was "non-null", so every
	/// scalar probe read true). Predicates live in the emitted `Any_is*_`
	/// helpers; null when the name isn't a builtin scalar.
	fun scalarIsPredicate(className: String, recv: String): String? {
		let any = '(Any_*)(' + recv + ')'

		if className == 'String' {
			return 'Any_isString_(' + any + ')'
		}

		if className == 'Bool' or className == 'Bool8' or className == 'Bool32' {
			return '(' + any + ' == (Any_*)(&_true) || ' + any + ' == (Any_*)(&_false))'
		}

		if ['Float', 'Float32', 'Number'].includes(className) {
			return 'Any_isNumber_(' + any + ')'
		}

		if ['Int', 'Int8', 'Int16', 'Int32', 'Int64', 'UInt8', 'UInt16', 'UInt32', 'UInt64', 'BigInt', 'SizeOfPointer', 'SignedSizeOfPointer', 'ClangChar'].includes(className) {
			return 'Any_isInt_(' + any + ')'
		}
		return null
	}

	/// F10.1 first consumer: `x is T` for `Any`-shaped receivers via vtable-tag
	/// comparison. Every vtable-bearing heap object stores its vtable first
	/// (`$_[0] = &X__$` at construction), so exact-type tests compare the first
	/// word (null-safe; scalar-boxed `Any`s are null by construction and read
	/// false). Returns null when the shape doesn't apply (non-`Any` receiver
	/// keeps the legacy truthiness path, like the other targets; scalar /
	/// Generic / bare / enum / `Any` targets; struct/union kinds whose first
	/// word is data; templates/externals with no instance vtable; interfaces
	/// whose literals never set `_->`). Exact-type only — subclass instances
	/// read false (documented narrow spot, same convention as RegExp).
	fun anyIsTagCheck(receiver: Expression, target: Type): String? {
		if cShape(receiver) != 'Any_*' {
			return null
		}

		if not isPureIsReceiver(receiver) {
			return null
		}
		var t = target

		switch t {
			case Nullable(inner): t = inner
			case UnknownNullable(handle):
				if handle.value != null { t = handle.value }
				else { return null }
			case _:
		}
		// Builtin scalars: shape test through the `Any_is*_` runtime helpers.
		let recvS = printExpression(receiver)

		switch t {
			case ClassInstance(c, _):
				if let pred = scalarIsPredicate(c.name, recvS) {
					return pred
				}
			case Class(c):
				if let pred = scalarIsPredicate(c.name, recvS) {
					return pred
				}
			case _:
				return null
		}
		let structName = omitPointer(stringifyType(t))

		for c in project.classes {
			if c.name == structName or (c.name + '_') == structName {
				if c.template {
					return null
				}

				if c.jsRequire != null or c.jsNative != null {
					return null
				}

				if c.api == ClassBinaryInterface.StructureNoVirtual {
					return null
				}
				var kindOk = false
				var isStructOrUnion = false
				var isIface = false
				switch c.classType {
					case Class(kind):
						kindOk = true
						let atts = project.mapDecorators.get(kind.parent)
						isStructOrUnion = Decorator.getDecorator(atts, 'struct') != null or Decorator.getDecorator(atts, 'union') != null
						isIface = kind.kind == ClassKind.Interface
					case ClassInstance(kind):
						kindOk = true
						let atts = project.mapDecorators.get(kind.parent)
						isStructOrUnion = Decorator.getDecorator(atts, 'struct') != null or Decorator.getDecorator(atts, 'union') != null
						isIface = kind.kind == ClassKind.Interface
					case _:
				}

				if not kindOk or isStructOrUnion or isIface {
					return null
				}
				let recv = printExpression(receiver)
				return '(' + recv + ' != nullptr && ((const void**)(' + recv + '))[0] == (const void*)(&' + structName + '_$))'
			}
		}
		return null
	}

	/// Honest type behind a printed expression: declared type for identifiers
	/// (locals first, then globals), the recorded type otherwise. Void-C
	/// callees report `Void` (their true C shape) so value contexts bridge
	/// via the comma-sequence instead of emitting `void` where `T` is needed.
	/// `await voidFn()` is the same shape (async lowering is pass-through).
	fun valueType(e: Expression): Type {
		switch e {
			case Ident(name):
				if let t = localDecls.get(name) {
					return t
				}

				if let t = globalDecls.get(name) {
					return t
				}
			case Parenthesis(inner):
				return valueType(inner)
			case Call(callee, _, _, _):
				if isVoidCallee(callee) {
					return project.typer.typeVoid
				}
			case Await(inner):
				if isVoidValue(inner) {
					return project.typer.typeVoid
				}
			case _:
		}

		return getType(e)
	}
	/// True when the expression evaluates a C-void call (direct or awaited)
	fun isVoidValue(e: Expression): Bool { switch e {
			case Call(callee, _, _, _):
				return isVoidCallee(callee)
			case Parenthesis(inner):
				return isVoidValue(inner)
			case Await(inner):
				return isVoidValue(inner)
			case _:
				return false
		} }

	/// Sanitizes a type name into a valid C identifier segment for generic
	/// instantiation mangling: strips `/*...*/` annotation markers (they are
	/// C comments and must never leak inside an identifier), drops one
	/// trailing `*` (pointer-to), maps remaining `*` to `P` (nested pointers
	/// like `uint8_t**` stay distinguishable) and drops other
	/// non-identifier characters (`const uint8_t` -> `constuint8_t`)
	fun mangleTypeSegment(typeName: String): String {
		// Phase 1 — copy while skipping `/* ... */` marker regions
		var stripped = ''
		var i = 0

		while i < typeName.length {
			let ch = typeName.charAt(i)

			if ch == '/', i + 1 < typeName.length, typeName.charAt(i + 1) == '*' {
				i += 2

				while i < typeName.length {
					if typeName.charAt(i) == '*', i + 1 < typeName.length, typeName.charAt(i + 1) == '/' {
						i += 2
						break
					}

					i++
				}

				continue
			}

			stripped += ch
			i++
		}

		// Phase 2 — one trailing `*` is the "pointer to" of the named type
		stripped = omitPointer(stripped)

		// Phase 3 — keep identifier chars only, `*` becomes `P`
		var out = ''

		for i in stripped.length {
			let code = stripped.charCodeAt(i) ?? 0

			if code >= 97 and code <= 122 {
				out += stripped.charAt(i)
			} else if code >= 65 and code <= 90 {
				out += stripped.charAt(i)
			} else if code >= 48 and code <= 57 {
				out += stripped.charAt(i)
			} else if code == 95 or code == 36 {
				out += stripped.charAt(i)
			} else if code == 42 {
				out += 'P'
			}
		}

		return out
	}

	// Non-ASCII → escapes for wide literals: genC writes the .cpp as UTF-8
	// but MSVC reads it in the system ANSI codepage (cp1251 here), so a raw
	// em-dash (E2 80 94) mojibakes into 'вЂ”' in the window title. Rules:
	// BMP > 159 → \uXXXX (fixed 4 digits, not greedy); surrogate halves →
	// \xHHHH ALONE in its own L"…" segment (a \u UCN on a surrogate is
	// C3850, and \x greedily eats following hex digits); 127..159 stay raw
	// (control-char UCNs are C3850 too, and they compiled raw before).
	// ASCII passes through byte-identical; the backslash is built at
	// RUNTIME (edit-tool backslash hazard).
	fun wideLitEsc(s: String): String {
		let bs = String.fromCharCode(92)
		let quote = String.fromCharCode(34)
		let hex = '0123456789abcdef'
		var out = ''
		var i = 0

		while i < s.length {
			let c = s.charCodeAt(i) ?? 0
			var step = 1
			let isHi = c >= 55296 and c <= 56319
			let isLo = c >= 56320 and c <= 57343

			if isHi and (i + 1) < s.length and (s.charCodeAt(i + 1) ?? 0) >= 56320 and (s.charCodeAt(i + 1) ?? 0) <= 57343 {
				let c2 = s.charCodeAt(i + 1) ?? 0
				out = out + quote + ' L' + quote + bs + 'x' + wideHex4(c, hex) + quote + ' L' + quote + bs + 'x' + wideHex4(c2, hex) + quote + ' L' + quote
				step = 2
			} else if isHi or isLo {
				out = out + quote + ' L' + quote + bs + 'x' + wideHex4(c, hex) + quote + ' L' + quote
			} else if c > 159 {
				out = out + bs + 'u' + wideHex4(c, hex)
			} else {
				out += String.fromCharCode(c)
			}

			i += step
		}

		return out
	}

	// Exactly 4 lowercase hex digits (no backslashes in this source line).
	fun wideHex4(v: Int, hex: String): String {
		return hex.charAt((v / 4096) % 16) + hex.charAt((v / 256) % 16) + hex.charAt((v / 16) % 16) + hex.charAt(v % 16)
	}

	fun registerString(string: String): Int {
		declarationsOfStrings.push(wideLitEsc(string))
		return declarationsOfStrings.length - 1
	}

	/// NOTE forced C cast around a converted value: erased/unsubstituted
	/// generic types stringify EQUALLY (`Any_*`) while the actual C value
	/// carries the substituted pointer type — an explicit cast keeps the
	/// assignment well-formed either way (identity cast when types match).
	/// Pointer targets bridge through `size_t`: unrelated class pointers
	/// (e.g. `Any_*` → `FsSync_*`, `Map<K,A>` → `Map<K,B>`) have no C++
	/// conversion, but the round-trip is always well-formed (same address)
	fun forcedCast(to: Type, converted: String): String {
		let toName = stringifyType(to)

		if toName.endsWith('*') {
			return '(' + toName + ')(size_t)(' + converted + ')'
		}

		return '(' + toName + ')(' + converted + ')'
	}

	/// True for inline-struct shapes (headerless C structs: no vtable, no
	/// `rc_` — ARC guards must never touch them).
	fun isInlineStruct(t: Type?): Bool {
		if t == null {
			return false
		}

		switch t {
			case Struct(_, _):
				return true
			case _:
				return false
		}
	}

	/// True when a declared container-element type needs an ARC header
	/// (counted class/interface, or `Any` which takes bags). Inline structs
	/// need none (same headerless family the literal already builds).
	fun declaredNeedsHeader(t: Type?): Bool {
		if t == null {
			return false
		}

		if t == project.typer.typeAny {
			return true
		}

		switch t {
			case ClassInstance(_, _):
				return true
			case Class(_):
				return true
			case Nullable(inner):
				return declaredNeedsHeader(inner)
			case _:
				return false
		}
	}

	/// One container element toward its DECLARED type: struct/interface/Any
	/// literals construct (headered via `printObjectAs`), fat values into
	/// `Any` box as pairs, everything else prints raw (existing behavior
	/// for already-correct shapes).
	fun printContainerElement(declaredT: Type, v: Expression): String {
		if isBoxableFat(v), stringifyType(declaredT) == 'Any_*' {
			return boxFatPair(v)
		}

		if let s = printObjectAs(declaredT, v) {
			return s
		}

		return printExpression(v)
	}

	/// Rebuild a map literal with DECLARED key/value types (see the
	/// `printObjectAs` container arms). Mirrors the `Map` expression printer
	/// exactly, except element construction keys off the declared types.
	/// Callers flush `metaBlock` before the owning assignment (same protocol
	/// as struct/bag construction — per-element builds hoist there).
	fun printMapAs(keyT: Type, valT: Type, keys: [Expression], values: [Expression], toType: Type): String {
		let typeName = omitPointer(stringifyType(toType))

		if keys.length == 0 {
			return typeName + '$new_()'
		}

		let kType = stringifyType(keyT)
		let vType = stringifyType(valT)
		var keyStrs: [String] = []
		var valStrs: [String] = []

		for i in keys.length {
			keyStrs.push(printContainerElement(keyT, keys[i]))
		}

		for i in values.length {
			valStrs.push(printContainerElement(valT, values[i]))
		}

		let keyItems = keyStrs.join(', ')
		let valueItems = valStrs.join(', ')

		if cpp {
			return '\(typeName)$from_(\(typeName)$new_(), \(keys.length), hexaItems<\(kType)>(\(keyItems)), hexaItems<\(vType)>(\(valueItems)))'
		}

		return '\(typeName)$from_(\(typeName)$new_(), \(keys.length), (\(kType)[])\{' + keyItems + '\}, (\(vType)[])\{' + valueItems + '\})'
	}

	/// Rebuild an array literal with the DECLARED element type (same contract
	/// as `printMapAs`). Mirrors the `Array` expression printer.
	fun printArrayAs(elemT: Type, vals: [Expression], toType: Type): String {
		let typeName = omitPointer(stringifyType(toType))

		if vals.length == 0 {
			return typeName + '$new_(0)'
		}

		let elType = stringifyType(elemT)
		var elStrs: [String] = []

		for a in vals {
			elStrs.push(printContainerElement(elemT, a))
		}

		let items = elStrs.join(', ')

		if cpp {
			return '\(typeName)$from_(\(typeName)$new_(\(vals.length)), hexaItems<\(elType)>(\(items)))'
		}

		return '\(typeName)$from_(\(typeName)$new_(\(vals.length)), (\(elType)[])\{' + items + '\})'
	}

	/// Struct-typed object literal → real heap construction, or null when the
	/// shape doesn't apply (non-struct target or non-literal value). Central
	/// decision point for every binding site that knows the target type
	/// (inits, assigns, call args, array/map elements, returns): `Object_from`
	/// is a null stub, so struct shapes must construct or every field deref
	/// AVs (M3 boot: `layout_->tabHeight_`). D8-future: annotate the Object
	/// node in a pre-generator pass and lower there; until expressions carry
	/// struct types, the binding sites below are the only place with both
	/// the shape (target type) and the values (literal).
	fun printObjectAs(toType: Type, e: Expression): String? {
		// Nullable interface/struct targets construct the same way (the C
		// struct has no null wrapper — null is a null pointer).
		var t = toType

		switch t {
			case Nullable(inner): t = inner
			case _:
		}
		// F9: async `co_return {…}` sees `Promise<Struct>` as the return
		// type — unwrap to the inner struct so object literals construct
		// (else `Object_from` null stub → field-deref AV on first paint).
		switch t {
			case ClassInstance(c, g):
				if c.name == 'Promise', g != null, g.length == 1 {
					t = g[0]

					switch t {
						case Nullable(inner): t = inner
						case _:
					}
				}
			case _:
		}
		// F10.2: plain-object literal into an `Any`-shaped slot builds a real
		// heap bag (AnyObject) instead of the `Object_from` null stub.
		if stringifyType(t) == 'Any_*' {
			switch e {
				case Object(onames, oels):
					return printAnyObjectLit(onames, oels)
				case _:
			}
		}

		switch t {
			case Struct(names, fieldTypes):
				switch e {
					case Object(onames, oels):
						return printStructObject(names, fieldTypes, onames, oels)
					case _:
				}
			case ClassInstance(kind, generics):
				// Named interfaces mint real C structs but have no $new_ — an
				// object literal IS the construction (structural typing).
				// Same heap construction as anonymous structs, with field
				// types from the class declaration (matched by name).
				if kind.kind == ClassKind.Interface {
					switch e {
						case Object(onames, oels):
							return printInterfaceObject(kind.name, onames, oels)
						case _:
					}
				}
				// Nominal classes: same named-field construction, PLUS vtable
				// init so `hidden->dyn_*` works on the value (FileInfo/Tab/
				// Cursor/... records). Missing fields stay zero (HEXA_NEW
				// zeroes); the vtable/ARC header is always filled.
				if kind.kind == ClassKind.Class {
					switch e {
						case Object(onames, oels):
							return printClassObject(kind.name, onames, oels)
						case _:
					}
				}
				// Batch-1 UAF fix (headerless struct values in counted slots —
				// the updateBlinkStates `rc went negative` burst): a container
				// literal whose INFERRED element is a headerless inline struct
				// while the DECLARED element needs an ARC header (structural
				// typing erases the interface: `Map<String,BlinkState> =
				// {'a': {...}}` infers `Map<String,Struct_34>`, builds
				// headerless values, and `forcedCast` bridges the whole pointer).
				// ARC guards then count/scribble data words as `rc_` (use →
				// sweep frees live → guard on garbage → negative). Rebuild the
				// elements with the DECLARED types (interface values mint
				// headered `Name_*` via `printInterfaceObject`, `rc_=1`).
				if kind.name == 'Map' {
					if let g = generics {
						if g.length == 2 {
							switch e {
								case Map(keys, values, _, inferredV, _):
									if isInlineStruct(inferredV), declaredNeedsHeader(g[1]) {
										return printMapAs(g[0], g[1], keys, values, t)
									}
								case _:
							}
						}
					}
				}

				if kind.name == 'Array' {
					if let g = generics {
						if g.length == 1 {
							switch e {
								case Array(vals, arrayType):
									switch arrayType {
										case ClassInstance(_, agenerics):
											if let ag = agenerics {
												if ag.length > 0, isInlineStruct(ag[0]), declaredNeedsHeader(g[0]) {
													return printArrayAs(g[0], vals, t)
												}
											}
										case _:
									}
								case _:
							}
						}
					}
				}
			case Class(kind):
				// Bare class-as-value type stringifies identically
				// (`Name_*`) — same interface-literal construction.
				if kind.kind == ClassKind.Interface {
					switch e {
						case Object(onames, oels):
							return printInterfaceObject(kind.name, onames, oels)
						case _:
					}
				}

				if kind.kind == ClassKind.Class {
					switch e {
						case Object(onames, oels):
							return printClassObject(kind.name, onames, oels)
						case _:
					}
				}
			case _:
		}
		return null
	}

	/// Heap-construct a nominal class `Name_*` from an object literal (real
	/// classes, not interfaces): `HEXA_NEW` + vtable init (`->$__$`), `rc_=1`,
	/// live registration, then named field stores. Missing fields stay zero.
	/// This is what makes `FileInfo/Tab/Cursor/...` literals work once those
	/// records are classes — every site gets the same layout, and dynamic
	/// reads go through `hidden->dyn_*`.
	fun printClassObject(className: String, onames: [String], oels: [Expression]): String {
		var names: [String] = []
		var ftypes: [Type] = []

		for c in project.classes {
			if c.name == className {
				for v in c.vars {
					switch v {
						case Var(n, _, t):
							names.push(n)
							ftypes.push(t)
						case Const(n, _, t):
							names.push(n)
							ftypes.push(t)
						case _:
							continue
					}
				}
			}
		}
		let tid = tempId++
		let tmp = '_$cls' + tid
		let sname = className + '_'
		metaBlock.push(sname + '* ' + tmp + ' = (' + sname + '*)(HEXA_NEW(sizeof(' + sname + ')))')
		metaBlock.push('((void**)' + tmp + ')[0] = (void*)&' + className + '__$')
		metaBlock.push(tmp + '->rc_ = 1')
		metaBlock.push('hexaRegisterLive_((void*)' + tmp + ')')
		pushOmittedFieldFill(tmp, names, ftypes, onames)

		for i in names.length {
			for k in onames.length {
				if onames[k] == names[i] {
					if isFatValueType(ftypes[i]) {
						metaBlock.push(tmp + '->' + names[i] + '$f_ = ' + 'reinterpret_cast<' + stringifyType(ftypes[i]) + '>(' + fatPtrStr(oels[k]) + ')')
						metaBlock.push(tmp + '->' + names[i] + '$e_ = ' + fatEnvStr(oels[k]))
					} else {
						metaBlock.push(tmp + '->' + names[i] + '_ = ' + printStructFieldValue(ftypes[i], oels[k]))

						// Borrowed source (`{ a: localTemp }`): the literal must
						// take its own reference — see retainLiteralField.
						if isBorrowedValue(oels[k]) {
							metaBlock.push(retainLiteralField(tmp + '->' + names[i] + '_'))
						}
					}
				}
			}
		}
		return tmp
	}

	/// F10.2: heap-construct an `AnyObject_*` bag from an object literal into
	/// an `Any`-shaped slot (see printObjectAs). Values convert to `Any`
	/// (fat values box as pairs so closures survive dispatch); keys are the
	/// interned string literals. Emitted as a metaBlock temp + stores — the
	/// caller flushes metaBlock before the owning assignment (same protocol
	/// as struct construction and VirtualMethod spills).
	/// DELETION CANDIDATE (retain until the next implementor re-verifies
	/// on green MSVC smoke): `reflectPost` owns the same shapes in Nice
	/// (incl. nesting/spills/If/empty-`expects` calls + Nullable-plain
	/// fields); keep this ONLY for non-hoist positions (globals/defaults/
	/// arrow bodies/while-conds/switch-cases/guards/`&&`/`||` RHS),
	/// fat/`Any`/nullable-struct/untyped fields and shapes the trace
	/// marks KEPT.
	fun printAnyObjectLit(names: [String], els: [Expression]): String {
		let tid = tempId++
		let tmp = '_$obj' + tid
		metaBlock.push('Any_* ' + tmp + ' = Any_objectNew_()')

		for i in names.length {
			var vstr = printToAnyConverter(printExpression(els[i]), valueType(els[i]))

			if isBoxableFat(els[i]) {
				vstr = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(els[i]) + '), ' + fatEnvStr(els[i]) + ')'
			}
			var vstr = anyBox(els[i])
			metaBlock.push('Any_objectSet_(' + tmp + ', ' + printExpression(Expression.String(names[i])) + ', ' + vstr + ')')
		}
		return tmp
	}

	fun registerString(string: String): Int {
		declarationsOfStrings.push(string)
		return declarationsOfStrings.length - 1
	/// F10.2 dynamic member read: `AnyObject` bags read real fields, every
	/// other shape keeps the legacy `let_` proxy (observably identical).
	fun anyDynGetStr(recv: String, name: String): String {
		let q = String.fromCharCode(34)
		return 'Any_dynGet_((Any_*)(' + recv + '), String_$fromUTF16z_((const uint16_t*)L' + q + wideLitEsc(name) + q + '))'
		return 'Any_dynGet_((Any_*)(' + recv + '), ' + printExpression(Expression.String(name)) + ')'
	}

	/// F10.2 dynamic member write: `AnyObject` bags store real fields, every
	/// other shape keeps the legacy `$set` stub.
	fun anyDynSetStr(recv: String, name: String, val: String): String {
		let q = String.fromCharCode(34)
		return 'Any_dynSet_((Any_*)(' + recv + '), String_$fromUTF16z_((const uint16_t*)L' + q + wideLitEsc(name) + q + '), ' + val + ')'
		return 'Any_dynSet_((Any_*)(' + recv + '), ' + printExpression(Expression.String(name)) + ', ' + val + ')'
	}

	/// Heap-construct a `Struct_N_*` from an object literal (see printObjectAs).
	/// Field values convert to their declared types; nested struct literals
	/// recurse (printTypeConverter only sees strings). Missing literal fields
	/// stay zero (`HEXA_NEW` zeroes). Emitted as a metaBlock temp + field
	/// stores (C-shaped, no lambdas) — callers flush metaBlock before the
	/// owning assignment (existing protocol, same as VirtualMethod spills).
	/// #4 LOWERING TARGET: same shape via normal calls — `hexaNewBytes`
	/// (`library/c/runtime.hexa`, `@rename('HEXA_NEW')`) + field `Assign`s
	/// emitted from `reflectPost` (typed Nice nodes ARC can see, no raw
	/// `HEXA_NEW(sizeof(...))` strings here). Blocked on encoding generic
	/// `sizeOf<T>()` calls in Nice IR — needs a normalizer probe first.
	fun printStructObject(names: [String], fieldTypes: [Type], onames: [String], oels: [Expression]): String {
		let sname = omitPointer(stringifyType(Type.Struct(names, fieldTypes)))
		let tid = tempId++
		let tmp = '_$struct\(tid)'
		metaBlock.push(sname + '* ' + tmp + ' = (' + sname + '*)(HEXA_NEW(sizeof(' + sname + ')))')
		pushOmittedFieldFill(tmp, names, fieldTypes, onames)

		for i in names.length {
			for k in onames.length {
				if onames[k] == names[i] {
					metaBlock.push(tmp + '->' + names[i] + '_ = ' + printStructFieldValue(fieldTypes[i], oels[k]))

					// Borrowed source: the struct literal owns its own reference
					// (see retainLiteralField).
					if isBorrowedValue(oels[k]) {
						metaBlock.push(retainLiteralField(tmp + '->' + names[i] + '_'))
					}
				}
			}
		}
		return tmp
	}

	/// D2: a literal that OMITS a field leaves that slot at `HEXA_NEW`'s zero —
	/// a raw `nullptr` in a managed slot. Every emitted null test
	/// (`x != (void*)&HexaNone_`, `if let`, `??`) reads a zero as PRESENT, and
	/// `hexaUnref(old)` on the first `field = value` store would dereference it.
	/// Fill every omitted POINTER-shaped field (`Foo_*`, `Any_*`, `String_*`,
	/// `Struct_N_*`) with the `null` sentinel; omitted by-value fields
	/// (int/float/Bool/`@byValue`) and native pointers keep their zero form,
	/// and present fields overwrite the fill with the literal's own value.
	fun pushOmittedFieldFill(tmp: String, names: [String], ftypes: [Type], onames: [String]) {
		for i in names.length {
			var present = false

			for k in onames.length {
				if onames[k] == names[i] {
					present = true
				}
			}

			if not present {
				let shape = stringifyType(ftypes[i])

				if shape.endsWith('_*') {
					metaBlock.push(tmp + '->' + names[i] + '_ = (' + shape + ')(&HexaNone_)')
				}
			}
		}
	}

	/// Heap-construct a named interface `Name_*` from an object literal (see
	/// printObjectAs). Field order/types come from the class declaration
	/// (matched by name — literal order may differ); missing fields stay
	/// zero. The vtable slot stays null (interfaces carry no bodies) —
	/// virtual dispatch on such values is F10 territory.
	/// #4 LOWERING TARGET: same as `printStructObject` — `hexaNewBytes` +
	/// field `Assign`s from `reflectPost` (plus the `rc_=1` /
	/// `hexaRegisterLive_` birth-count as explicit Nice calls); blocked on
	/// the same `sizeOf<T>()`-in-Nice probe.
	fun printInterfaceObject(className: String, onames: [String], oels: [Expression]): String {
		var names: [String] = []
		var ftypes: [Type] = []

		for c in project.classes {
			if c.name == className {
				for v in c.vars {
					switch v {
						case Var(n, _, t):
							names.push(n)
							ftypes.push(t)
						case Const(n, _, t):
							names.push(n)
							ftypes.push(t)
						case _:
							continue
					}
				}
			}
		}
		let sname = className + '_'
		let tid = tempId++
		let tmp = '_$iface' + tid
		metaBlock.push(sname + '* ' + tmp + ' = (' + sname + '*)(HEXA_NEW(sizeof(' + sname + ')))')
		// Vtable init: interfaces carry the same hidden vtable as classes
		// (per-class string-compare shape). Without this `_` stays null and
		// every dynamic read (`Any_dynGet_` via `hidden->dyn_get_`) misses —
		// the "Loading null…" family. ARC birth count as usual.
		// NOTE `_` is `const ... * const` (like classes) — write through
		// `void**` exactly as `$new_` does, or MSVC rejects it (C2166).
		metaBlock.push('((void**)' + tmp + ')[0] = (void*)&' + className + '__$')
		metaBlock.push(tmp + '->rc_ = 1')
		metaBlock.push('hexaRegisterLive_((void*)' + tmp + ')')
		pushOmittedFieldFill(tmp, names, ftypes, onames)

		for i in names.length {
			for k in onames.length {
				if onames[k] == names[i] {
					if isFatValueType(ftypes[i]) {
						// Pair-held function field (D1 — mirrors the struct
						// body emission, which doubles fat fields into
						// `$f_`/`$e_`): ptr half is the fat impl (fatPtrStr)
						// with a reinterpret_cast (C-style casts are rejected
						// on arity mismatch, C2440); env half is the twin.
						metaBlock.push(tmp + '->' + names[i] + '$f_ = ' + 'reinterpret_cast<' + stringifyType(ftypes[i]) + '>(' + fatPtrStr(oels[k]) + ')')
						metaBlock.push(tmp + '->' + names[i] + '$e_ = ' + fatEnvStr(oels[k]))
					} else {
						metaBlock.push(tmp + '->' + names[i] + '_ = ' + printStructFieldValue(ftypes[i], oels[k]))

						// Borrowed source (`boxes: fresh` — the WindowBoxes
						// rczero UAF): an interface literal owns what it stores,
						// so take the reference here (retainLiteralField).
						if isBorrowedValue(oels[k]) {
							metaBlock.push(retainLiteralField(tmp + '->' + names[i] + '_'))
						}
					}
				}
			}
		}
		return tmp
	}

	/// A literal field value that merely BORROWS an existing reference (a local
	/// temp or parameter) instead of minting its own. Fresh values (`new`, call
	/// results, literals, closures) arrive with their own birth count and
	/// transfer it into the field; borrowed ones do not.
	fun isBorrowedValue(e: Expression): Bool {
		switch e {
			case Ident(_, _):
				return true
			case Parenthesis(inner):
				return isBorrowedValue(inner)
			case _:
				return false
		}
	}

	/// Take a reference for a borrowed value just stored into a freshly
	/// constructed literal (`tmp->field_ = ident`).
	/// WHY: literals are built out of temps whose birth count is released by the
	/// sibling `HexaDeferDecPtr_` guard at the end of the enclosing scope, and
	/// `ArcInserter` never visits `Expression.Object` elements (it only walks
	/// statements), so a borrow-only store left the new object pointing at an
	/// rc==0 object — the sweep freed it and every later read of the field
	/// (`WindowBoxes`/`WindowUi`/state records) returned garbage. The retain is
	/// owned by the receiving object; without a `destroy_` that releases fields
	/// (most interfaces emit `nullptr /*INHERIT-DESTROY*/`) it leaks instead of
	/// corrupting — same trade-off as the `Assign(Dot)` arm in `arc.hexa`.
	/// The `Any_isCounted_` tag check keeps this type-agnostic: scalars,
	/// immediates and bare sentinels are no-ops.
	fun retainLiteralField(slot: String): String {
		return 'if (Any_isCounted_((Any_*)(size_t)(' + slot + '))) hexaRef((void*)(size_t)(' + slot + '));'
	}

	/// One struct field value, converted to its declared type (recursing into
	/// nested struct literals, which printTypeConverter cannot see as strings).
	fun printStructFieldValue(ftype: Type, val: Expression): String {
		// D2: an explicit `null` in a literal (`{ tooltip: null, drag: null }`)
		// must be the sentinel OBJECT for managed/`Any` targets — otherwise
		// every `!= null` / `if let` guard on that field is TRUE (a raw zero is
		// not `&HexaNone_`), which is what made the per-window tooltip paint a
		// "null" box in the top-left corner on every frame. Scalars and native
		// pointers keep their own zero form (handled by the converter below).
		switch val {
			case Null:
				let nullShape = stringifyType(ftype)

				if isNullSentinelType(ftype) or nullShape == 'Any_*' or nullShape.endsWith('_*') {
					return '(' + nullShape + ')(&HexaNone_)'
				}
			case _:
		}

		if let s = printObjectAs(ftype, val) {
			let sname = omitPointer(stringifyType(ftype))
			return '(' + sname + '*)(' + s + ')'
		}

		if isFatValueType(ftype) {
			// Function-typed struct fields hold thin single values in Phase 1
			// (S2) while the typedef is fat (env-first) — arity and
			// convention can differ, so C-style casts are rejected (C2440)
			// and only reinterpret_cast compiles (x64: extra args ignored).
			return 'reinterpret_cast<' + stringifyType(ftype) + '>(' + printExpression(val) + ')'
		}
		let vt = valueType(val)

		if isDynamic(vt), vt != project.typer.typeAny {
			let want = stringifyType(ftype)

			if want.endsWith('*') {
				// Use-node type is unreliable (erased generics, unknown-null
				// payloads) but the C value is a real pointer: bridge through
				// size_t (null-safe, bit-preserving). Exact-Any sources keep
				// the converter's stub semantics (Phase-1 placeholder per F10);
				// without this the converter's passthrough arms emit the value
				// raw (C2440 on shape mismatch).
				return '(' + want + ')(size_t)(' + printExpression(val) + ')'
			}
		}
		return printTypeConverter(printExpression(val), valueType(val), ftype)
	}

	fun printInitializer(ofType: Type, v: Expression) {
		// D2: `= null` on a managed shape must be the sentinel OBJECT. The
		// converter's `/*T? = null*\/` arm needs a *known* nullable type, but
		// this path also serves generic-erased slots (`Map.nullValue = null`,
		// `var x = null` at file scope, untyped field defaults) where the
		// declared type is `T`/Unknown and the arm is skipped — that left a raw
		// `nullptr` in a counted slot, which `hexaRef`/`hexaUnref` (now literally
		// `rc_++`/`rc_--`) dereference. Route by the EMITTED shape instead.
		switch v {
			case Null(_):
				let initShape = stringifyType(ofType)

				if initShape.endsWith('_*') {
					return '(' + initShape + ')(&HexaNone_)'
				}
			case _:
		}

		// F7: `var x Int = cond ? a : b` where a branch is `Int?` (nullable
		// int64 sentinel, e.g. `tc.index`) — convert each branch toward the
		// DECLARED type (not the If's own box-both `Any` result), else the
		// outer `forcedCast` truncates a pointer (C4311). Hoistable statement
		// positions now lower in `reflectPost.tryLowerIntIf` (temp + per-branch
		// Assigns through the normal path); this arm stays ONLY for non-hoist
		// inits (fields/globals/defaults) that never reach that lowering.
		if ofType == project.typer.typeInt {
			switch v {
				case If(econd, eif, eelse):
					var aStr = printExpression(eif)

					if cShape(eif) == 'Any_*' {
						aStr = 'Any_unboxInt_(' + aStr + ')'
					} else {
						aStr = printTypeConverter(aStr, valueType(eif), ofType)
					}
					var bStr = printExpression(eelse)

					if cShape(eelse) == 'Any_*' {
						bStr = 'Any_unboxInt_(' + bStr + ')'
					} else {
						bStr = printTypeConverter(bStr, valueType(eelse), ofType)
					}
					return forcedCast(ofType, '(' + printExpression(econd) + ')?(' + aStr + '):(' + bStr + ')')
				case _:
			}
		}
		// Struct-typed literal: real construction (see printObjectAs).
		if let s = printObjectAs(ofType, v) {
			return s
		}
		// F10.3: array literal into an `Any`-shaped slot builds `Array<Any>`
		// directly so fat elements box as pairs (the literal's inferred
		// `Array<Fn>` storage is single-slot and would drop envs).
		// Hoistable positions now lower in `reflectPost.tryLowerArrayAny`
		// (`new Array<Any>(0)` + `push` per element through the normal
		// call-arg conversion); this arm stays ONLY for non-hoist inits
		// (fields/globals/defaults) plus `If`-branch arrays the whole-`If`
		// lowering leaves inline.
		if stringifyType(ofType) == 'Array_$Any_*' or stringifyType(ofType) == 'Any_*' {
			switch v {
				case Array(el, _):
					if el.length == 0 {
						return forcedCast(ofType, 'Array_$Any_$new_(0)')
					}
					var parts: [String] = []

					for a in el {
						if isBoxableFat(a) {
							parts.push('Any_boxFatPair_((void(*)())(' + fatPtrStr(a) + '), ' + fatEnvStr(a) + ')')
							parts.push(boxFatPair(a))
						} else {
							parts.push(printTypeConverter(printExpression(a), valueType(a), project.typer.typeAny))
						}
					}
					return forcedCast(ofType, 'Array_$Any_$from_(Array_$Any_$new_(' + el.length + '), hexaItems<Any_*>(' + parts.join(', ') + '))')
				case _:
			}
		}
		// F10.3: fat value into an `Any`-shaped slot boxes a pair (impl +
		// env survive; the dynamic call slot unpacks it). Covers `var`/
		// `assign`/field/global inits (which all route here) — call args
		// have their own funnel in `printCallArguments`. Leaf shapes only
		// (composites have no addressable pair — see isBoxableFat).
		// Single funnel: `boxFatPair` (see #5).
		if isBoxableFat(v), stringifyType(ofType) == 'Any_*' {
			return 'Any_boxFatPair_((void(*)())(' + fatPtrStr(v) + '), ' + fatEnvStr(v) + ')'
			return boxFatPair(v)
		}
		// A BARE global function designator is a fat value too, but it has no
		// addressable pair halves, so `isBoxableFat` misses it and the slot got
		// the RAW code pointer (`(Any_*)(size_t)(handler_)`). A raw pointer is
		// not `Any_isFatPair_`, so every dynamic call through such a slot fell
		// into the `AnyValue_` no-op proxy and returned null: the whole Perfide
		// keyboard layer was dead on native (`KeyController.onKey` is `Any?` and
		// every controller is bound as `ctrl.onKey = someKeyHandler`), plus
		// `handleKey`'s `if let handler = this.onKey` read a code pointer as an
		// `Any`. `anyBox` already emits the pair + registers the `$call_` thunk
		// (same arm object-literal fields use — the agent harness bag).
		if stringifyType(ofType) == 'Any_*' {
			switch v {
				case Ident(fnName, _):
					if globalFuncType(fnName) != null {
						return anyBox(v)
					}
				case _:
			}
		}

		switch ofType {
			case ClassInstance(c):
				if c.name == 'ArrayByValue' {
					switch v {
						case Array(el) if el.length == 1: {
								switch el[0] {
									case Int(val): {
											if val == 0 {
												// Print single-element (C-style) initializer for `ArrayByValue`
												return '\{0\}'
											}
											// TODO else what?
										}
								}
							}
					}
				}
		}

		let vType = valueType(v)

		if vType == project.typer.typeAny, ofType != project.typer.typeAny {
			// Cast Any to expected type
			// return printTypeConverter(printExpression(v), vType, ofType)
		}

		return forcedCast(ofType, printTypeConverter(printExpression(v), vType, ofType))
		// return printExpression(v)
	}

	var customThis: String? = null
	fun printExpression(e: Expression): String {
		switch e {
			case This: return customThis ?? 'this'
			case Ident(name):
				if project.native.get(e) == true {
					return name
				}
				// S3a dual-mode: stored `closure$N` values print as the THIN
				// wrapper (`closure$N$thin_`, old signature, calls fat with the
				// global env) until S3b pairs land. Callees never reach here
				// (Call handling emits fat/thin explicitly before generic print).
				if name.startsWith('closure$'), not name.endsWith('$thin') {
					return name + '$thin_'
				}
				// S3b: fat-typed locals/params/globals print as the PTR half
				// here; binding sites (Var/Assign/arg/field) assemble pairs
				// explicitly via `fatPtrStr`/`fatEnvStr` and never route through
				// here. Missed contexts (Any-boxing, ternaries) get a marker
				// for M2+ triage — F10 pair-boxing will replace the proxy.
				if isFatValueType(valueType(e)) {
					return name + '$ptr_/*UNPAIRED-FAT*/'
				}
				return '' + name + '_'
				// case Null: return '((Unknown_ *)0)'
				// case SizeOf(what):
				// fun omitPointer(type: String): String {
				// if type.endsWith('*') {
				// return type.substr(0, type.length - 1) + ' '
				// }
				// return type
				// }
				// return 'sizeof(' + omitPointer(stringifyType(what)) + ')'
				// //return 'sizeof(' + stringifyType(what) + ')'
			case Null(dataType):

				var actualType = dataType

				switch actualType {
					case UnknownNullable(handle): if let of = handle.value {
							actualType = of
						}
					case Nullable(of): actualType = of
				}

				if actualType == project.typer.typeInt {
					return 'int32_t$null'
				}

				// `Int32` and `Int` stringify to the same `int32_t$` but are
				// distinct types — without this arm an `Int32?` null test fell
				// back to `'nullptr'` and the caller could re-emit C2446
				if actualType == project.typer.typeInt32 {
					return 'int32_t$null'
				}

				if actualType == project.typer.typeUInt32 {
					return 'uint32_t$null'
				}

				if actualType == project.typer.typeInt16 {
					return 'int16_t$null'
				}

				if actualType == project.typer.typeUInt16 {
					return 'uint16_t$null'
				}

				if actualType == project.typer.typeInt8 {
					return 'int8_t$null'
				}

				if actualType == project.typer.typeUInt8 {
					return 'uint8_t$null'
				}

				if actualType == project.typer.typeBool {
					// NOTE `2` is chosen because `1 == 0b1` and `2 == 0b10`
					// thus bits are different: `2 & 1 == 0` and `2 | 1 == 3`
					// also it fits nicely into `uint8_t` and `int8_t` without ambiguity
					return '(uint8_t)2'
				}

				// TODO more types

				// TODO infer actual type of null in typer,
				// to print type conversion `((T*)0)`
				return 'nullptr'
				return 'nullptr/*yup*/'
				return '((Unknown_ *)0)'

				/*
					void f(int*) { /*...*/ }
					void f(double*) { /*...*/ }
					void g()
					{
					    f(nullptr); // compilation error, ambiguous call!
					    f(static_cast<int*>(nullptr)); // now compiler knows...
					}
					*/
			case Int(v): return '(int32_t)' + v
			case MetaInt(v, kind, _): {
					switch kind {
						case Int32: return '(int32_t)' + v
						case Int64: return '(int64_t)' + v
						case Int16: return '(int16_t)' + v
						case Int8: return '(int8_t)' + v

						case UInt32: return '(uint32_t)' + v
						case UInt64: return '(uint64_t)' + v
						case UInt16: return '(uint16_t)' + v
						case UInt8: return '(uint8_t)' + v
					}

					// TODO more kinds
				}
			case Float(v):
				let v = '' + v

				if v.indexOf('.') == -1 {
					return '(double)' + v + '.0'
				}
				return '(double)' + v
			case String(string):
				if let id = declarationsOfStringsMap.get(string) {
					return 'String_\(id)'
					// + `/*has:` + string.split('*').join('#') + `*/`
				}

				let s = string.split('')
				let charsOut = []

				while s.length > 0 {
					switch s[0] {
						case "'":
							charsOut.push("\\'")
							s.shift()
						case '"':
							charsOut.push('\\"')
							s.shift()
						case "\n":
							charsOut.push("\\n")
							s.shift()
						case "\r":
							charsOut.push("\\r")
							s.shift()
						case "\\":
							s.shift()

							if s[0] == "'" {
								charsOut.push("\\'")
								s.shift()
							} else if s[0] == '"' {
								charsOut.push('\\"')
								s.shift()
							} else if s[0] == '\\' {
								charsOut.push("\\\\")
								s.shift()
							} else if s[0] == 'u' {
								// `\uXXXX` — surrogate pairs must merge
								// into ONE `\UXXXXXXXX` escape: MSVC
								// rejects lone surrogates in universal
								// character names (C3850)
								var handled = false

								if s.length >= 11, s[5] == '\\', s[6] == 'u' {
									let hi = parseInt(s[1] + s[2] + s[3] + s[4], 16)
									let lo = parseInt(s[7] + s[8] + s[9] + s[10], 16)

									if hi >= 0xD800 and hi <= 0xDBFF, lo >= 0xDC00 and lo <= 0xDFFF {
										let point = 0x10000 + ((hi - 0xD800) * 0x400) + (lo - 0xDC00)
										var hex = point.toString(16)

										while hex.length < 8 {
											hex = '0' + hex
										}

										charsOut.push('\\U' + hex)

										for k in 11 {
											s.shift()
										}

										handled = true
									}
								}

								if not handled {
									charsOut.push('\\')
								}
							} else {
								charsOut.push('\\')
							}
						case _:
							charsOut.push(s[0])
							s.shift()
					}
				}

				// C4129: Hexa escaped braces arrive here as backslash+brace
				// two-char sequences — C has no brace escape, emit bare.
				// Built via fromCharCode to avoid brace literals in genC.
				var rawStr = charsOut.join("")
				rawStr = rawStr.split(String.fromCharCode(92) + String.fromCharCode(123)).join(String.fromCharCode(123))
				rawStr = rawStr.split(String.fromCharCode(92) + String.fromCharCode(125)).join(String.fromCharCode(125))
				let id = registerString(rawStr)
				declarationsOfStringsMap.set(string, id)
				return 'String_\(id)'
				// return 'String_fromUTF8z("' + charsOut.join('') + '")'
			case True: return 'true_'
			case False: return 'false_'
			case Dot(expr, name):
				// F10: interface receivers first — bag-or-struct by the
				// first word (JSON.parse / Any-literal bags vs interface
				// structs), keyed by interned string pointers. Must run
				// before the fat-callee/vtable arms (those print raw struct
				// slots that pun a bag's header).
				if isInterfaceType(valueType(expr)), not isMethodDot(expr, name) {
					return printIfaceField(expr, name, getType(e))
				}
				// S3b: fat-typed field reads print the PTR half here (static
				// bases excluded — they stay on the existing static path);
				// binding sites and fat callees assemble pairs explicitly and
				// never route through here. Missed contexts get a marker.
				if isFatCallee(e) {
					return printExpression(expr) + '->' + name + '$f_/*UNPAIRED-FATDOT*/'
				}
				// S3b: method values read the vtable slot (never a pair half).
				if isMethodDot(expr, name) {
					return printExpression(expr) + '->_->' + name + '_'
				}

				if name == 'toZeroOrOne' {
					let dataType = getType(expr)

					if dataType == project.typer.typeBool {
						return printExpression(expr)
					}
				}

				if name == 'ref' or name == 'address' or name == 'pointer' or name == 'pointerToSelf' {
					let dataType = getType(expr)

					switch dataType {
						case ClassInstance(c):
							if c.name == 'ByValue', name == 'ref' {
								return '(&' + printExpression(expr) + ')'
							}

							if c.name == 'ByValue', name == 'pointer' {
								return '(&' + printExpression(expr) + ')'
							}

							if c.name == 'ArrayByValue', name == 'ref' {
								return '(&' + printExpression(expr) + '[0])'
							}

							if c.name == 'ArrayByValue' and name == 'address' {
								return '(size_t)&(' + printExpression(expr) + ')'
							}

							if c.name == 'ArrayPointer' and name == 'address' {
								return '(size_t)(' + printExpression(expr) + ')'
							}

							if c.name == 'ArrayPointer' and name == 'pointerToSelf' {
								return '(&' + printExpression(expr) + ')'
							}

							if c.name == 'ConstArrayPointer' and name == 'address' {
								return '(size_t)(' + printExpression(expr) + ')'
							}
					}
				}

				switch expr {
					case This: return (customThis ?? 'this') + '->' + name + '_'
					case Ident(id, typed):
						// Static
						// TODO better detect
						if id.charAt(0) == id.charAt(0).toUpperCase(), not id.startsWith('_') {
						// Static (TitleCase base). `$`-leading ABI temps
						// (`$nrest`/`$rest`/`$env`/`$psp`/`$psb`) are never
						// statics — same guard as `dotFieldKind`, which
						// already excludes them (a `$x_$f_` print is always
						// a C2065, never a valid static access).
						if id.charAt(0) == id.charAt(0).toUpperCase(), not id.startsWith('_'), not id.startsWith('$') {
							return id + '_$' + name + '_'
						}
						// Dynamic
						let dataType = getType(expr)

						if isDynamic(dataType) {
							// NOTE the receiver value may carry a SUBSTITUTED
							// pointer type at the C level — the cast keeps the
							// stub call well-formed for any of them
							// TODO leaky!!
							return anyDynGetStr(printExpression(expr), name)
						}

						// NOTE instance members keep their STABLE `name_` C
						// field (the struct declaration always appends `_`,
						// even for `@asIs`); the typer `fieldRenames` hit means
						// nothing here — a bare rename would desync from the
						// declaration (`Set.size` printed `->size` vs `size_`)
						return printExpression(expr) + '->' + name + '_'
					case _:
						// Dynamic `Any` receivers route EVERY member access
						// through the reflection stub (F10 replaces it) —
						// `x.y` on `Any` is `x->let_(L"y")`, chained calls
						// then go through the `AnyValue_` proxy
						let dataType = getType(expr)

						if isDynamic(dataType) {
							return anyDynGetStr(printExpression(expr), name)
						}

						// NOTE same as above: STABLE `name_` fields, no
						// `fieldRenames` shortcut (see `Set.size` fix)
						return printExpression(expr) + '->' + name + '_'
				}

				// TODO to keep local var caches, use something like block.push()
				// into current scope
			case Call(e, args, dataType, kind, callExpectsField):
				// S3a dual-mode TOP (before kind-switch: `Static` returns early
				// and would bypass fat logic — thin-wrapper inners must print
				// FAT with their explicit env). `Closure` → fat + auto-env;
				// untagged fat-impl calls print fat with explicit args.
				if kind == CallKind.Closure {
					if closureBaseName(e) != null {
						return printClosureFatCall(e, args, null)
					}
				}

				if closureBaseName(e) != null {
					return (closureBaseName(e) as!String) + '_' + printCallArguments(args, exprCallExpects(callExpectsField, e))
				}
				// S3b: struct-field calls print thin-member + explicit env.
				if isStructDotCall(e) {
					return printStructDotCall(e, args, exprCallExpects(callExpectsField, e))
				}
				// S3b: method Dots typed as non-virtual still dispatch via the
				// vtable (the typer only marks some sites VirtualMethod).
				var effKind = effCallKind(e, kind)
				// F10: interface-typed callees dispatch dynamically — the
				// value may be a bag whose function fields are boxed pairs
				// (the fat path would read struct slots off it).
				if isInterfaceBase(e) {
					return printDynamicCall(e, args, exprCallExpects(callExpectsField, e))
				}
				// S3b F1.6: fat pair-held callees (params/locals/globals, field
				// Dots) call `ptr_(env_, args...)`. Methods stay on the vtable
				// path (`VirtualMethod` excluded).
				if effKind != CallKind.VirtualMethod, isFatCallee(e) {
					return printFatValueCall(e, args, exprCallExpects(callExpectsField, e))
				}

				switch effKind {
					// TODO error on (_,_) if simple enum case CallKind.VirtualMethod(_, _): return '*.virtual'
					case VirtualMethod:
						switch e {
							case Dot(expr, name, result):
								// Dynamic receivers (`Any`/erased) have no
								// vtable — the Dot path prints the reflection
								// stub call instead (F10). F10.2: route through the
								// dynamic call slot (bags may hold the method as a
								// pair; otherwise the legacy proxy no-ops as before).
								// A raw `Any_dynGet_(...)(args)` call would not even
								// compile (`Any_*` is not callable, C2064).
								if isDynamic(valueType(expr)) {
									return printDynamicCall(e, args, exprCallExpects(callExpectsField, e))
								}

								// Scalar receivers (`(n ?? 0).toString()` on `Int`)
								// have no vtable — `int->_->toString_` is invalid C
								// (C2227/C2660). Emit the conversion helper instead
								if name == 'toString' {
									if let helper = scalarToString(printExpression(expr), cShape(expr)) {
										return helper
									}
								}

								let temp = tempId++
								let temp1 = tempId++
								let mb = metaBlock
								metaBlock = []
								let exprType = getType(expr)
								let typeString = stringifyType(exprType)
								let kind = typeString + ' _$\(temp) = ' + printExpression(expr)

								if name == 'offsetItems' or name == 'offsetItemsBack' {
									switch exprType {
										case ClassInstance(c):
											if
												c.name == 'ConstArrayPointer' or c.name == 'ArrayPointer',
												name == 'offsetItems' or name == 'offsetItemsBack'
											{
												return '((' + printExpression(expr) + ') + (' + printExpression(args[0]) + '))'
											}
									}
								}

								var isStruct = false
								switch exprType {
									case ClassInstance(classType, params): {
											let atts = project.mapDecorators.get(classType.parent)
											isStruct = Decorator.getDecorator(atts, 'struct') != null
										}
										// TODO `case ClassInstance(type, _) | Class(type)`
										// TODO same for statement
										// TODO this should be a NiceClass actually
										// TODO seems like `this` gets type of `Class` instead of instance somewhere
									case Class(classType): {
											let atts = project.mapDecorators.get(classType.parent)
											isStruct = Decorator.getDecorator(atts, 'struct') != null
										}
									case _:
								}

								var vtName = '_$\(temp)->_->' + name + '_'

								if not isStruct {
									// `@final` class: direct call, no vtable hop
									if let direct = finalMethodName(exprType, name, 'expr', exprPos(expr)) {
										vtName = direct
									}
								}

								let result = if isStruct {
									omitPointer(typeString) + '$' + name + '_' + printCallArgumentsVirtual('_$\(temp)', args, exprCallExpects(callExpectsField, e))
								} else {
									vtName + printCallArgumentsVirtual('_$\(temp)', args, exprCallExpects(callExpectsField, e))
								}

								for b in metaBlock {
									mb.push(b)
								}
								mb.push(kind)
								// mb.push('/*result*/auto _$\(temp1) = ' + result)
								metaBlock = mb
								// return '_$\(temp1)'//result
								return result

								// return // + ';\n' + tabs// +
								// return printExpression(expr) + '/*virtual*/' + printCallArguments(args)
						}
				}

				// switch e {
				// // TODO better way
				// case SizeOf: return printExpression(e)
				// }
				// S3a dual-mode (expressions): `CallKind.Closure` → fat impl +
				// global/nullptr env; untagged fat-impl calls (explicit env)
				// print fat with explicit args. Stored values print as thin
				// wrappers via `Ident` below and never reach here as callees.
				if kind == CallKind.Closure {
					if closureBaseName(e) != null {
						return printClosureFatCall(e, args, null)
					}
				}

				if closureBaseName(e) != null {
					return (closureBaseName(e) as!String) + '_' + printCallArguments(args, exprCallExpects(callExpectsField, e))
				}
				// NOTE same proxy rule as statements (declared types decide).
				// F10.3 pair dispatch replaces the proxy when the callee
				// carries a boxed fat pair.
				if isDynamicCallee(e) {
					return printDynamicCall(e, args, exprCallExpects(callExpectsField, e))
				}

				return '/*DYNRAW*/' + printExpression(e) + printCallArguments(args, exprCallExpects(callExpectsField, e))

			case Arrow(expr, args, defaults, types, returns, funcType, isAsync): {
					return printExpression(
						// TODO temp names '$arrow'
						Expression.Function(null, expr: Statement.Return(expr), args, defaults, funcType, isAsync: isAsync)
					)
				}

			case Function(name, expr, args, defaults, funcType, isAsync):
				// TODO this should generate arguments from caller side, ie:
				// `f A -> B` `((a IA)=>IB)` => generate `((a A)=>B)`
				// ^ should be done at normalizer
				let _currentReturnType = currentReturnType
				currentReturnType = getFunctionReturnType(funcType)

				let temp = tempId++
				let rt = linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType))
				forwardFunctions.push(rt)
				// TODO This must be re-think-ed
				if defaultCallingConvention != '' {
					forwardFunctions.push(' ')
					forwardFunctions.push(defaultCallingConvention)
				}
				forwardFunctions.push(' _$\(temp)')
				forwardFunctions.push(printFunctionArguments(args, funcType))
				forwardFunctions.push(';\n')

				let tab = tabs
				tabs = ''
				globalFunctions.push(rt)
				// TODO This must be re-think-ed
				if defaultCallingConvention != '' {
					globalFunctions.push(' ')
					globalFunctions.push(defaultCallingConvention)
				}
				globalFunctions.push(' _$\(temp)')
				globalFunctions.push(printFunctionArguments(args, funcType))
				globalFunctions.push(' ')
				let _insideAsyncFunction = insideAsyncFunction
				insideAsyncFunction = isAsync
				globalFunctions.push(isAsync? printFunctionBody(expr, printFunctionReturnType(funcType)) : printBlock(expr))
				insideAsyncFunction = _insideAsyncFunction
				globalFunctions.push('\n\n')
				tabs = tab

				currentReturnType = _currentReturnType
				return '_$\(temp)'

			case New(e, args, result):
				// TODO probably just `omitPointer(stringifyType(result))`
				// var name = printExpression(e) // TODO redesign, just string from normalizer
				var name = omitPointer(stringifyType(result)) // TODO redesign, just string from normalizer
				switch result {
					case ClassInstance(classType, params): {
							let atts = project.mapDecorators.get(classType.parent)
							let isStruct = Decorator.getDecorator(atts, 'struct') != null
							// TODO Only *external* `C++` and non-external Hexa structs have constructors
							// TODO check arguments count to be zero
							if isStruct {
								let shouldInit = not classType.external

								if shouldInit {
									if args.length > 0 {
										// TODO should not wrap into ( )
										return name + '$this_((\(name)*)HEXA_NEW(sizeof(\(name))), ' + printCallArguments(args) + ')'
									}
									return name + '$this_((\(name)*)HEXA_NEW(sizeof(\(name))))'
								}
								return '(\(name)*)HEXA_NEW(sizeof(\(name)))'
							}
							// if let params = params, params.length == 1 {
							// switch params[0] {
							// case Class(type): name += '$' + type.name + '_' // TODO redesign, should support renaming
							// case ClassInstance(type): name += '$' + type.name + '_' // TODO redesign, should support renaming
							// case Generic(_): name += '$Any_' // TODO should be resolved in normalizer
							// case _: console.log('New', params[0])
							// }
							// }
						}
				}
				return name + '$new_' + printCallArguments(args, constructorExpects(name))

			case Array(el, arrayType):
				var typeName = stringifyType(arrayType)

				// Erased/unknown array types still allocate a real container
				if typeName == 'Any_*' {
					typeName = 'Array_$Any_*'
				}

				if el.length == 0 {
					return '\(omitPointer(typeName))$new_(0)'
				}

				switch arrayType {
					case ClassInstance(_, generic):
						let elType: String = stringifyType(generic[0])
						// Struct-typed elements: real construction (see printObjectAs).
						let elStrs: [String] = []

						for a in el {
							if let s = printObjectAs(generic[0], a) { elStrs.push(s) }
							// F10.3: fat elements into `Any` slots box pairs.
							// Narrowed to `isBoxableFat` (see #5): composites have
							// no addressable halves — boxing them emitted null
							// pairs, worse than the legacy drop.
							else if isBoxableFat(a), stringifyType(generic[0]) == 'Any_*' { elStrs.push(boxFatPair(a)) }
							else { elStrs.push(printExpression(a)) }
						}
						let items = elStrs.join(', ')

						// C++ has no compound literals (C4576) — the runtime
						// helper builds the initializer buffer instead
						if cpp {
							return '\(omitPointer(typeName))$from_(\(omitPointer(typeName))$new_(\(el.length)), hexaItems<\(elType)>(\(items)))'
						}

						return '\(omitPointer(typeName))$from_(\(omitPointer(typeName))$new_(\(el.length)), (\(elType)[])\{' + items + '\})'
				}

				if cpp {
					let items = [for a in el printExpression(a)].join(', ')
					return '\(omitPointer(typeName))$from_(\(omitPointer(typeName))$new_(\(el.length)), hexaItems<Any_*>(\(items)))'
				}

				return '\(omitPointer(typeName))$from_(\(omitPointer(typeName))$new_(\(el.length)), \{' + [for a in el printExpression(a)].join(', ') + '\})'

			case Unop(op, postfix, e):
				if postfix {
					return printExpression(e) + Token.stringify(op)
				}

				// Hexa's word-operator `not` → C's `!` (a word would glue to the operand)
				if op == Token.KNot or op == Token.Exclamation {
					// JS truthiness (D7), never pointer non-null: a boxed
					// `false`/`0`/`''` is a NON-NULL pointer, so `!ptr` was always
					// false and `if not state.flag` (Any) never took the false
					// branch — Perfide's hidden command palette therefore ran its
					// whole per-frame hitbox sync. Same funnel as `printCondition`
					// (If/While); `getType` still reports Bool so no outer
					// `->_toBool()` is appended.
					if cShape(e) == 'Any_*' {
						return '!(Any_toBool_(' + printExpression(e) + '))'
					}

					return '!' + printExpression(e)
				}

				return Token.stringify(op) + printExpression(e)

			case Elvis(nullable, othewise):
				// Fallback — reflect lowers simple lhs to If, so any Elvis
				// here is complex (Dot/Call/Index, single-eval required).
				// Hoist lhs to a metaBlock temp (statement flushes it before
				// use — no closure/env alloc, no double getter/call eval).
				// Null check is shape-aware: Null$ structs via `has_`,
				// pointers (incl. native struct ptrs, plain nullptr) via
				// `!= <null literal for lhs type>`. Both branches convert
				// toward the result (pointer results box to Any_* so the
				// ternary is well-formed despite use-node lies); the owning
				// statement converts outward as usual.
				let lhsT = getType(nullable)
				let resT = getType(othewise)

				if isFatValueType(lhsT) or isFatValueType(resT) {
					throw 'Elvis on function values needs statement lowering (pairs cannot ride a ternary)'
				}
				let lhsC = stringifyType(lhsT)

				if lhsC == 'void' {
					return printExpression(othewise)
				}
				// Non-nullable scalar `??` is dead (lhs cannot be null) —
				// identity, no invalid `nullptr` compare (C2446 on double)
				var lhsNullable = true
				switch lhsT {
					case Nullable(_): lhsNullable = true
					case UnknownNullable(_): lhsNullable = true
					case _: lhsNullable = false
				}

				if not lhsNullable, not lhsC.endsWith('*'), not lhsC.startsWith('_$') {
					return printExpression(nullable)
				}
				let t = tempId++
				metaBlock.push(lhsC + ' _$' + t + ' = ' + printExpression(nullable))
				let tmp = '_$' + t
				var cond = ''

				if lhsC.startsWith('Null$') {
					cond = '(' + tmp + '.has_ != 0)'
				} else {
					// D2: `null` is an OBJECT (`&HexaNone_`) for every
					// managed/`Any` slot, and a raw zero still exists (the
					// `(/*T = null*/…)(nullptr)` producers), so the null test
					// must cover BOTH. A plain `!= nullptr` read the sentinel as
					// PRESENT, which made `??` always take the lhs — the
					// `elvis-fb-miss` probe (`get(k) ?? 'fb'` returned the
					// sentinel instead of the fallback). Two compares, no call:
					// an `Any` slot that holds a boxed 0/immediate is not null.
					if lhsC.endsWith('*') and not lhsC.startsWith('_$') {
						cond = '(' + tmp + ' != nullptr && ' + tmp + ' != (' + lhsC + ')(void*)(&HexaNone_))'
					} else {
						let nullLit = printExpression(Expression.Null(lhsT))
						cond = '(' + tmp + ' != ' + nullLit + ')'
					}
				}
				let resC = stringifyType(resT)
				var thenS = ''
				var elseS = ''

				if resC == 'Any_*' {
					// Dynamic result: box both (C-cast compiles for any
					// pointer pair despite use-node lies); outer converts
					thenS = printToAnyConverter(tmp, lhsT)
					elseS = printToAnyConverter(printExpression(othewise), getType(othewise))
				} else {
					// Typed result (pointer or scalar): convert both toward
					// it so the printed shape already matches — dynamic
					// outers apply no conversion of their own (C2664)
					thenS = printTypeConverter(tmp, lhsT, resT)
					elseS = printTypeConverter(printExpression(othewise), getType(othewise), resT)
				}
				return '(' + cond + ')?(' + thenS + '):(' + elseS + ')'

			case Parenthesis(e):
				return '(' + printExpression(e) + ')'

			case Binop(a, op, b):
				if op == Token.Equal or op == Token.Unequal {
					// S3b: fat `==`/`!=` compare BOTH halves (ptr+env);
					// `== null`/`!= null` test the code-ptr half only (fast path,
					// per F1-Q). `getType` lies for `Any`-coerced uses, so key on
					// `valueType` (declared types win).
					if isFatValueType(valueType(a)) or isFatValueType(valueType(b)) {
						var aNull = false
						var bNull = false
						switch a {
							case Null(_):
								aNull = true
							case _:
						}

						switch b {
							case Null(_):
								bNull = true
							case _:
						}
						let op2 = op == Token.Unequal? '!=' : '=='

						if aNull or bNull {
							let p = aNull? fatPtrStr(b) : fatPtrStr(a)
							return '(' + p + ' ' + op2 + ' nullptr)'
						}
						let pa = fatPtrStr(a)
						let pb = fatPtrStr(b)
						let ea = fatEnvStr(a)
						let eb = fatEnvStr(b)

						if op == Token.Unequal {
							return '!((' + pa + ') == (' + pb + ') && (' + ea + ') == (' + eb + '))'
						}
						return '((' + pa + ') == (' + pb + ') && (' + ea + ') == (' + eb + '))'
					}
					// TODO commutative
					if let aType = getType(a), aType == project.typer.typeNullUInt64 {
						return (op == Token.Unequal? '!' : '') + 'equalNull$UInt64(' + printExpression(a) + ', ' + printTypeConverter(printExpression(b), getType(b), aType) + ')'
					}

					if let aType = getType(a), aType == project.typer.typeNullFloat32 {
						return (op == Token.Unequal? '!' : '') + 'equalNull$Float32(' + printExpression(a) + ', ' + printTypeConverter(printExpression(b), getType(b), aType) + ')'
					}

					// Mismatched operand shapes — scalar-vs-scalar compares by
					// VALUE (int64, or double if a float is involved) so
					// sentinel loops (`c != 0`) terminate after D7 boxing
					// (heap boxes break per-value pointer identity); every
					// pointer-involved shape keeps the legacy box-both
					// identity compare, observably unchanged.
					// NOTE shapes via `binopShape` — use-node types can lie,
					// and a `Dot` on a dynamic base prints `Any_*`
					// (`Any_dynGet_`) no matter what the use node claims
					// (raw cross-type compares are C2446)
					let aName = binopShape(a)
					let bName = binopShape(b)

					if aName != bName {
						let op2 = op == Token.Unequal? '!=' : '=='

						if isIntCTypeName(aName), isIntCTypeName(bName) {
							return '((int64_t)(' + printExpression(a) + ') ' + op2 + ' (int64_t)(' + printExpression(b) + '))'
						}

						if isFloatCTypeName(aName) {
							if isIntCTypeName(bName) or isFloatCTypeName(bName) {
								return '((double)(' + printExpression(a) + ') ' + op2 + ' (double)(' + printExpression(b) + '))'
							}
						}

						if isFloatCTypeName(bName) {
							if isIntCTypeName(aName) or isFloatCTypeName(aName) {
								return '((double)(' + printExpression(a) + ') ' + op2 + ' (double)(' + printExpression(b) + '))'
							}
						}
						// D7/JS VALUE equality when a dynamic side is involved:
						// `Any_boxInt_` keeps the immediate form only for
						// NON-ZERO values, so a boxed `0` is a heap object and a
						// pointer compare against `Any_boxInt_(0)` is false —
						// that is how `state.activePanel == 0` silently became
						// FALSE (Perfide drew the sidebar header but never a
						// panel body: the missing OPEN EDITORS list), and every
						// `Any == 0/1/…` in any project broke the same way.
						let boxedA = printToAnyConverter(printExpression(a), binopFromType(a))
						let boxedB = printToAnyConverter(printExpression(b), binopFromType(b))

						// `null` against a statically typed operand: compare against
						// that operand's OWN null representation — the `&HexaNone_`
						// sentinel object for managed references, the in-band
						// `int32_t$null`-style literal for scalar nullables — instead
						// of boxing both sides and calling `Any_equals_`. The boxed
						// form was a real cost: `if let x = arr[i]` on `[Int]`
						// allocated a box per test (`Any_boxInt_`) and `s != null` on
						// a `String?` paid a helper call for one pointer compare.
						// `valueType` (DECLARED type) is what makes this sound: the
						// use node is exactly what claimed `Any` for the other side.
						var firstNull = false
						var secondNull = false
						switch a { case Null(_): firstNull = true case _: }

						switch b { case Null(_): secondNull = true case _: }

						if firstNull != secondNull {
							let operand = firstNull? b : a
							let operandType = valueType(operand)
							let operandC = binopShape(operand)
							var nullTest: String? = null

							// The twin test is only valid on POINTER shapes:
							// a scalar/widened (`int32_t$`), `Bool_` or `Null$*`
							// struct operand rejects `== nullptr` outright
							// (C2446) — those take the in-band `nullLit` path
							// below. Belt-and-braces on top of the
							// `isNullSentinelType` value-class exclusions so
							// this site can never re-emit it.
							var twinOk = not isIntCTypeName(operandC) and not isFloatCTypeName(operandC) and not operandC.endsWith('$') and operandC != 'Bool_' and not operandC.startsWith('Null$')

							if isNullSentinelType(operandType), twinOk {
								let v = printExpression(operand)
								// twin form: `null` is the sentinel OBJECT for every
								// managed slot, but raw-zero producers still exist
								// (same reason the Elvis temp test covers both)
								nullTest = '(' + v + ' == nullptr || ' + v + ' == (' + operandC + ')(void*)(&HexaNone_))'
								if isPureIsReceiver(operand) {
									nullTest = '((void*)(' + v + ') == nullptr || (void*)(' + v + ') == (void*)(&HexaNone_))'
								} else {
									let t = tempId++
									let tmp = '_$nz' + t
									metaBlock.push('void* ' + tmp + ';')
									nullTest = '((' + tmp + ' = (void*)(' + v + ')), (' + tmp + ' == nullptr || ' + tmp + ' == (void*)(&HexaNone_)))'
								}
							} else {
								let nullLit: String = printExpression(Expression.Null(operandType))

								if nullLit != 'nullptr' {
									nullTest = '(' + printExpression(operand) + ' == ' + nullLit + ')'
								}
							}

							if let nt = nullTest {
								let cmp = op == Token.Equal? nt : '(!' + nt + ')'
								let resC = stringifyType(getType(e))

								if resC == 'Any_*' {
									return '(struct Any_ *)(size_t)(' + cmp + ')'
								}

								return '(' + resC + ')(' + cmp + ')'
							}
						}

						if aName == 'Any_*' or bName == 'Any_*' {
							let eqCall = 'Any_equals_(' + boxedA + ', ' + boxedB + ')'
							return op2 == '!=' ? '(!' + eqCall + ')' : eqCall
						}

						return boxedA + ' ' + op2 + ' ' + boxedB
					}
				}

				if op == Token.Add {
					// `a + b + c` over statically plain `String`s: ONE n-ary
					// concat (one allocation + one intern) instead of n-1
					// nested `concat`s where every step copied the prefix again.
					var leaves: [Expression] = []

					if collectStringAddLeaves(e, leaves) {
						if leaves.length == 2 {
							return 'String_$concat_(' + printExpression(leaves[0]) + ', ' + printExpression(leaves[1]) + ')'
						}

						if leaves.length >= 3 and leaves.length <= 8 {
							var parts: [String] = []

							for leaf in leaves {
								parts.push(printExpression(leaf))
							}
							return 'String_$concat\(leaves.length)_(' + parts.join(', ') + ')'
						}
					}

					if cShape(a) == 'String_*' {
						return 'String_$combine_(' + printExpression(a) + ', ' + printTypeConverter(printExpression(b), valueType(b), project.typer.typeString) + ')'
					}

					if cShape(b) == 'String_*' {
						return 'String_$combine_(' + printTypeConverter(printExpression(a), valueType(a), project.typer.typeString) + ', ' + printExpression(b) + ')'
					}
				}

				let token = op == Token.IntegerDivide? '/' : Token.stringify(op)
				return printExpression(a) + ' ' + token + ' ' + printExpression(b)
				// `x = y` used as an EXPRESSION (e.g. `while (m = re.exec(s))`)
				// — same conversion rules as `Statement.Assign`
				if op == Token.Assign {
					// Struct/interface-typed literal: real construction (see printObjectAs).
					if let s = printObjectAs(valueType(a), b) {
						return printExpression(a) + ' = ' + s
					}
					return printExpression(a) + ' = ' + forcedCast(valueType(a), printTypeConverter(printExpression(b), valueType(b), valueType(a)))
				}

				// C-friendly operators: Hexa's `and`/`or` → `&&`/`||`
				var token = op == Token.IntegerDivide? '/' : Token.stringify(op)

				if op == Token.KAnd or op == Token.LogicalAnd {
					token = '&&'
				}

				if op == Token.KOr or op == Token.LogicalOr {
					token = '||'
				}

				// Dynamic (`Any_*`) operands in arithmetic/comparisons —
				// cast the dynamic side to the other operand's C type (the
				// value is a placeholder until F10 reflection). NOTE operand
				// shapes come from `cShape` — use-node types can lie about
				// the C value (typer coerces `Any` uses to `Int` etc)
				let aSide = cShape(a)
				let bSide = cShape(b)
				// The C shape the RESULT must have: a dynamic Nice type means
				// downstream conversions call `-> _toFloat()`-style members,
				// so the printed value must be `Any_*`-shaped (boxing rule
				// keyed on the C shape — see docs/target-c.md Phase 1)
				let resultSide = stringifyType(getType(e))
				// `+ - * / %` where a pointer-typed side is involved is
				// ill-formed C (C2110) — the `AnyValue_` proxy carries the
				// operator stubs instead. Pure-scalar operands stay raw (a
				// proxy cannot even be CONSTRUCTED from a scalar: C2440).
				// (`==`/`!=` stay referential pointer compares, `&&`/`||` and
				// pointer comparisons are legal C on raw pointers)
				let illegalPointerOp = ['+', '*', '/', '%'].includes(token)
				let aPtr = aSide.endsWith('*')
				let bPtr = bSide.endsWith('*')

				// Dynamic (`Any_*`) arithmetic / relational operators: NUMERIC
				// unboxing (D7 — mimic JS `ToNumber`), never pointer arithmetic
				// and never the Phase-1 `AnyValue_` proxy.
				// The proxy's operators are literal stubs returning 0, so
				// `sel >= (top + visible)` over `Any` fields produced `0 >= 0`
				// → always TRUE: Perfide's `commandPaletteScrollTop` then
				// computed `top = sel - visible + 1` = -11 and the row pool got
				// indexed with a negative index (`list[-11]` → null HitBox → AV
				// in the frame). String shapes keep the `String_$combine_` arms
				// above (JS `+` with a string concatenates); pointer peers and
				// `void` fall through to the legacy paths below.
				if ['+', '-', '*', '/', '%', '<', '<=', '>', '>='].includes(token) {
					if aSide == 'Any_*' or bSide == 'Any_*' {
						let scalarA = aSide == 'Any_*' or (not aPtr and aSide != 'void')
						let scalarB = bSide == 'Any_*' or (not bPtr and bSide != 'void')

						if scalarA and scalarB and aSide != 'String_*' and bSide != 'String_*' {
							// `cShape` can LIE about the printed C value (use-node
							// types are coerced, e.g. an `Any` field that prints as
							// `String_*`/`int32_t`) — the `(size_t)` bridge accepts
							// every shape and round-trips pointers bit-identically.
							let fa = aSide == 'Any_*' ? 'Any_unboxFloat_((Any_*)(size_t)(' + printExpression(a) + '))' : '(double)(' + printExpression(a) + ')'
							let fb = bSide == 'Any_*' ? 'Any_unboxFloat_((Any_*)(size_t)(' + printExpression(b) + '))' : '(double)(' + printExpression(b) + ')'
							var numRaw = '(' + fa + ' ' + token + ' ' + fb + ')'

							// `%` is integer-only in C
							if token == '%' {
								numRaw = '((double)((int64_t)(' + fa + ') % (int64_t)(' + fb + ')))'
							}

							if resultSide == 'Any_*' {
								return 'Any_boxFloat_(' + numRaw + ')'
							}

							return numRaw
						}
					}
				}

				// `==` / `!=` with a dynamic side: VALUE equality (D7/JS).
				// `Any_boxInt_` keeps the immediate form only for NON-ZERO
				// values, so a boxed `0` is a heap object — a pointer compare
				// against `0` is false, which is exactly how
				// `state.activePanel == 0` became FALSE and Perfide drew the
				// sidebar header but never a panel body (the "vertical list of
				// opened files is missing" bug). A literal `null` keeps the
				// plain null check (JS `x == null`).
				// Two-layer `==` / `!=`: (1) `null` on either side of a
				// managed/`Any` comparison is the OBJECT sentinel, so the
				// compare is a plain pointer compare against `&HexaNone_`
				// (JS `x == null`); (2) otherwise dynamic sides compare by
				// value (D7/JS).
				if op == Token.Equal or op == Token.Unequal {
					var anyNull = false
					var aIsNull = false
					var bIsNull = false

					switch a {
						case Null:
							anyNull = true
							aIsNull = true
						case _:
					}

					switch b {
						case Null:
							anyNull = true
							bIsNull = true
						case _:
					}

					// D2: a `null` operand against a managed/`Any` value is the
					// sentinel OBJECT, so the test is a pointer compare against
					// `&HexaNone_` — never a null-pointer compare (which would
					// never be true once `null` is an object). Scalar nullables
					// (`Int?` …) keep their in-band sentinel path below.
					if anyNull and not (aIsNull and bIsNull) {
						let other = aIsNull ? b : a

						if isNullSentinelType(valueType(other)) {
							let left = aIsNull ? '(void*)(&HexaNone_)' : '(void*)(' + printExpression(a) + ')'
							let right = bIsNull ? '(void*)(&HexaNone_)' : '(void*)(' + printExpression(b) + ')'
							let cmp = '(' + left + (op == Token.Equal ? ' == ' : ' != ') + right + ')'

							// Same result-shape convention as the neighboring arms:
							// a dynamic Nice result must stay `Any_*`-shaped (callers
							// unbox it), everything else takes the static shape.
							if resultSide == 'Any_*' {
								return '(struct Any_ *) (size_t) (' + cmp + ')'
							}

							return '(' + resultSide + ')(' + cmp + ')'
						}
					}

					// `x == null` keeps the plain pointer check (it was already
					// correct and it is what guards use everywhere).
					if not anyNull, (aSide == 'Any_*' or bSide == 'Any_*') {
						let eqA = aSide == 'Any_*' ? '(struct Any_ *)(size_t)(' + printExpression(a) + ')' : printToAnyConverter(printExpression(a), valueType(a))
						let eqB = bSide == 'Any_*' ? '(struct Any_ *)(size_t)(' + printExpression(b) + ')' : printToAnyConverter(printExpression(b), valueType(b))
						let eqCall = 'Any_equals_(' + eqA + ', ' + eqB + ')'
						return op == Token.Equal ? eqCall : '(!' + eqCall + ')'
					}
				}

				// NOTE `_$N` fn-ptr typedef names never end with `*`
				if illegalPointerOp, aPtr or bPtr {
					// Pointer-involved: the proxy needs `Any_*` operands but
					// the Nice type may LIE about the C value (a struct field
					// widened to `Any` after the C shape froze, e.g.
					// `layout.bottomPanelH`). The `(size_t)` bridge compiles
					// for EVERY shape (scalar or pointer) and round-trips
					// genuine pointers bit-identically — placeholder
					// semantics either way until F10
					let boxedA = '(struct Any_ *)(size_t)(' + printExpression(a) + ')'
					let boxedB = '(struct Any_ *)(size_t)(' + printExpression(b) + ')'
					let proxy = '(AnyValue_\{' + boxedA + '\}) ' + token + ' (AnyValue_\{' + boxedB + '\})'

					// Proxy operators return scalars (int64_t/uint8_t) —
					// re-box when the Nice result claims dynamic
					if resultSide == 'Any_*' {
						return '(struct Any_ *) (size_t) (' + proxy + ')'
					}

					return '(' + resultSide + ')(' + proxy + ')'
				}

				// Mixed dynamic/scalar for the REMAINING operators (pointer
				// arithmetic already proxied above): bridge the dynamic side
				// to the peer's C type (placeholder semantics until F10)
				if aSide == 'Any_*', bSide != 'Any_*', bSide != 'void' {
					let raw = castOperand(bSide, printExpression(a)) + ' ' + token + ' ' + printExpression(b)

					// Dynamic result over a typed C value — box it back so
					// the C shape matches the `Any_*` Nice type
					if resultSide == 'Any_*' {
						return printToAnyConverter(raw, valueType(b))
					}

					return raw
				}

				if bSide == 'Any_*', aSide != 'Any_*', aSide != 'void' {
					let raw = printExpression(a) + ' ' + token + ' ' + castOperand(aSide, printExpression(b))

					if resultSide == 'Any_*' {
						return printToAnyConverter(raw, valueType(a))
					}

					return raw
				}

				let raw = printExpression(a) + ' ' + token + ' ' + printExpression(b)

				// Typed operands but a dynamic result type (e.g. erased
				// generics) — keep the C shape consistent with the Nice type
				if resultSide == 'Any_*', aSide != 'void', bSide != 'void' {
					return printToAnyConverter(raw, valueType(a))
				}

				return raw

			case Index(expr, index):
				let exprType = getType(expr)

				// `Any` (or untyped) receivers index via `Any_indexGet_` —
				// Any key with runtime type-check (String fast-path, Int →
				// index_get, else to-string). String-static keys take the
				// direct `Any_dynGet` fast-path (no helper, no boxing).
				// `Any` (or untyped) receivers index through the single runtime
				// `Any_indexGet_` dispatcher (F10): bags field-dispatch on the
				// string form of the key, reflect shapes split Int keys to
				// `index_*` and everything else to `dyn_*`. Static `String` keys
				// keep the direct `Any_dynGet` fast path (no key conversion).
				if isDynamic(exprType) {
					let idxT = getType(index)
					var isStrKey = false
					if idxT == project.typer.typeString {
						isStrKey = true
					} else {
						if Type.unwrapNullable(idxT) == project.typer.typeString {
							isStrKey = true
						}
					}

					if isStrKey {
						return 'Any_dynGet_((Any_*)(' + printExpression(expr) + '), ' + printExpression(index) + ')'
					}

					if isPureIsReceiver(expr) {
						let recvS = printExpression(expr)
						let idxS = printExpression(index)
						let direct = 'Any_dynGet_((Any_*)(' + recvS + '), (String_*)(' + idxS + '))'
						let legacy = printExpression(Expression.Call(
								Expression.Dot(expr, 'get', null),
								[index],
								project.typer.typeAny,
								CallKind.Function,
								[]
							))
						return '(Any_isObject_((Any_*)(' + recvS + ')) ? ' + direct + ' : ' + legacy + ')'
					}
					return printExpression(Expression.Call(
							Expression.Dot(expr, 'get', null /*TODO*/),
							[index],
							project.typer.typeAny,
							// `Function` kind so the dynamic path prints the
							// `let_(...)` reflection stub call (F10)
							CallKind.Function,
							[]
						))
					return 'Any_indexGet_((Any_*)(' + printExpression(expr) + '), (Any_*)(' + printExpression(index) + '))'
					// Box the key through the normal `Any` funnel: `Int` ->
					// `Any_boxInt_`, `Float` -> `Any_boxFloat_`, `String_*` ->
					// direct cast, `Any` -> `size_t` bridge. A raw
					// `(Any_*)(int32)` is C4312 (and truncates on 64-bit).
					return 'Any_indexGet_((Any_*)(' + printExpression(expr) + '), ' + printToAnyConverter(printExpression(index), idxT) + ')'
				}

				switch Type.unwrapNullable(exprType) {
					case ClassInstance(classType, generic):
						// Containers with a `get` method (Array, Map) read
						// through it — raw `expr[i]` is only for pointer
						// shaped storage (`ArrayPointer` and friends)
						if classType.fields.get('get') == ClassTypeField.Method {
							var keyType = project.typer.typeInt

							if classType.name != 'Array' {
								if let g = generic, g.length > 0 {
									keyType = g[0]
								}
							}

							return printExpression(Expression.Call(
									Expression.Dot(expr, 'get', null /*TODO*/),
									[Expression.UnsafeBitCast(index, keyType)],
									project.typer.typeAny, // TODO this is a reflection access
									CallKind.VirtualMethod,
									[]
								))
						}

						return printExpression(expr) + '[' + printTypeConverter(printExpression(index), getType(index), project.typer.typeInt) + ']'
					case _:
				}

				return printExpression(expr) + '[' + printTypeConverter(printExpression(index), getType(index), project.typer.typeInt) + ']'

			case If(econd, eif, eelse):
				var r = ''

				try {
					// F10.3: ternary with a fat branch boxes the pair per
					// side (statement-style if/else into a hoisted temp —
					// a riding ternary would drop one side's env, and the
					// two sides may be different impls). The temp is
					// `Any_*`; outer contexts convert as usual (fat
					// outers unbox pairs exactly). Fat-RESULT ternaries
					// stay S3c (need pair temps).
					var anyFatBranch = isBoxableFat(eif)

					if not anyFatBranch {
						anyFatBranch = isBoxableFat(eelse)
					}

					if anyFatBranch {
						let t = tempId++
						let tmp = '_$ftn' + t
						metaBlock.push('Any_* ' + tmp + ' = nullptr')
						var ba = printTypeConverter(printExpression(eif), valueType(eif), project.typer.typeAny)
						var bb = printTypeConverter(printExpression(eelse), valueType(eelse), project.typer.typeAny)

						if isBoxableFat(eif) {
							ba = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(eif) + '), ' + fatEnvStr(eif) + ')'
							ba = boxFatPair(eif)
						}

						if isBoxableFat(eelse) {
							bb = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(eelse) + '), ' + fatEnvStr(eelse) + ')'
							bb = boxFatPair(eelse)
						}
						metaBlock.push('if (' + printExpression(econd) + ') ' + tmp + ' = ' + ba + '; else ' + tmp + ' = ' + bb)
						return tmp
					}
					// Mismatched branch shapes have no common C type — prefer
					// the TYPED side, but ONLY when the If RESULT is typed too
					// (a lone dynamic branch converts toward it). A dynamic
					// RESULT keeps box-both: the outer context converts the
					// Any value itself (`->_toInt()` etc.), and a pre-converted
					// typed ternary would break that outer conversion (C2227)
					let aName = cShape(eif)
					let bName = cShape(eelse)
					let resultTyped = stringifyType(getType(e)) != 'Any_*'

					if aName != bName, resultTyped {
						if aName == 'Any_*', bName != 'Any_*', bName != 'void' {
							return '(' + printExpression(econd) + ')?(' + printTypeConverter(printExpression(eif), valueType(eif), valueType(eelse)) + '):(' + printExpression(eelse) + ')'
						}

						if bName == 'Any_*', aName != 'Any_*', aName != 'void' {
							return '(' + printExpression(econd) + ')?(' + printExpression(eif) + '):(' + printTypeConverter(printExpression(eelse), valueType(eelse), valueType(eif)) + ')'
						}
					}

					if aName != bName {
						// F10.3: fat branches into the `Any` box pair (leaf
						// shapes only — composites keep the legacy drop).
						var boxA = printToAnyConverter(printExpression(eif), valueType(eif))
						var boxB = printToAnyConverter(printExpression(eelse), valueType(eelse))

						if isBoxableFat(eif) {
							boxA = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(eif) + '), ' + fatEnvStr(eif) + ')'
							boxA = boxFatPair(eif)
						}

						if isBoxableFat(eelse) {
							boxB = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(eelse) + '), ' + fatEnvStr(eelse) + ')'
							boxB = boxFatPair(eelse)
						}
						return '(' + printExpression(econd) + ')?(' + boxA + '):(' + boxB + ')'
					}

					r += '(' + printExpression(econd) + ')?'
					r += '(' + printExpression(eif) + ')'
					r += ':' + printExpression(eelse)
					return r
				} catch error: Any {
					console.log('If =>', e, error)
					// TODO eliminate this "debug"
					return r + '<!--If => error-->'
				}

			case EnumTag(expr):
				let e = printExpression(expr)
				return '(' + e + ' == ((Unknown_ *)0)? -1 : ' + e + '->is_)'

			case Object(names, el):
				// Untyped object literal (no target type reached `printObjectAs`):
				// build a REAL `AnyObject_` bag. The old `Object_from(...)`
				// emission was a null stub, so every untyped literal — settings
				// defaults, selector geometry, `ToolLine`, ext records — was
				// null at runtime and blew up on first field read.
				return printAnyObjectLit(names, el)

			case Map(keys, values, keyType, valueType, mapType):
				let typeName = omitPointer(stringifyType(mapType))

				if keys.length == 0 {
					return '\(typeName)$new_()'
				}

				let kType: String = stringifyType(keyType)
				let vType: String = stringifyType(valueType)
				let keyItems = [for el in keys printExpression(el)].join(', ')
				// Struct-typed values: real construction (see printObjectAs).
				let valStrs: [String] = []

				for el in values {
					if let s = printObjectAs(valueType, el) { valStrs.push(s) }
					// F10.3: fat values into `Any` slots box pairs (leaf
					// shapes only — composites have no addressable pair).
					else if isBoxableFat(el), stringifyType(valueType) == 'Any_*' { valStrs.push(boxFatPair(el)) }
					else { valStrs.push(printExpression(el)) }
				}
				let valueItems = valStrs.join(', ')

				// C++ has no compound literals (C4576) — `hexaItems` instead
				if cpp {
					return '\(typeName)$from_(\(typeName)$new_(), \(keys.length), hexaItems<\(kType)>(\(keyItems)), hexaItems<\(vType)>(\(valueItems)))'
				}

				return '\(typeName)$from_(\(typeName)$new_(), \(keys.length), (\(kType)[])\{' +
				keyItems
				+ '\}, (\(vType)[])\{' +
				[for el in values printExpression(el)].join(', ')
				// TODO keep order with meta blocks `[for i in keys.length '' + printExpression(keys[i]) + ', ' + printExpression(values[i]) + ''].join(', ')`
				+ '\})'

				// TODO rename to `AssignOp`
			case Assignop(a, op, value):
				return printExpression(a) + ' ' + Token.stringify(op) + '= ' + printExpression(value)

			case NativeOperator(kind, args, s, params, result): switch kind {
					case Infix:
						// are not C operators — `===` even lexes as `==` + `=`
						// (the stray-`=` syntax error). F10.2: strict equality
						// rides the `==`/`!=` shape logic (box-both for
						// mismatched pointer shapes) instead of a raw compare,
						// which is C2446 on cross-type operands (`Tab_*` vs
						// `Any_*`). `instanceof` stays an F10 stub.
						if s == '===' {
							return printExpression(Expression.Binop(args[0], Token.Equal, args[1], project.typer.typeBool))
						}

						if s == '!==' {
							return printExpression(Expression.Binop(args[0], Token.Unequal, args[1], project.typer.typeBool))
						}

						var infix = s

						if infix == 'instanceof' {
							// Placeholder semantics until F10 reflection
							return '((uint8_t)0 /*instanceof stub*/)'
						}

						return '((' + printExpression(args[0]) + ')' + infix + '(' + printExpression(args[1]) + '))'
					case Function:
						if let params = params, s == '*sizeof' {
							return 'sizeof(' + omitPointer(stringifyType(params[0])) + ')'
						}

						if let params = params, s == '&sizeof' {
							return 'sizeof(' + stringifyType(params[0]) + ')'
						}

						if let params = params, s == '&slotsAlloc' {
							// Hexa-aware container storage (D2). Pointer-shaped
							// slots hold MANAGED references, where `null` is the
							// `&HexaNone_` object: a zeroed slot is a raw nullptr,
							// which forces the temporary null test in
							// `hexaRef`/`hexaUnref`, a canonicalization step in
							// `Any_equals_` and an untagged word in the sweep.
							// By-value slots (`int32_t`/`double`/`Bool_`/
							// `@byValue` structs) must stay ZEROED — a pointer
							// fill would corrupt the element itself.
							let slotShape = stringifyType(params[0])

							if slotShape.endsWith('*') {
								return 'hexaSlotsAlloc((size_t)(' + printExpression(args[0]) + '))'
							}

							return 'calloc((uint64_t)(' + printExpression(args[0]) + '), sizeof(' + slotShape + '))'
						}

						if let params = params, s == '&freeSlots' {
							// Teardown half of `slotsAlloc<T>` — emitted as ONE
							// call, never as an inline per-slot loop:
							// * pointer-managed T → `hexaFreeSlots` (one plain
							// `hexaUnref` per live slot + free the block);
							// * `Any`-shaped T → `hexaFreeAnySlots` (COUNTED:
							// immediates and Bool singletons have no header);
							// * by-value T → nothing to release, just free.
							// `count` is the container's LIVE length: the tail
							// `[count, capacity)` is sentinel/zero filled and owns
							// nothing (releasing a sentinel fill would drain the
							// shared `&HexaNone_` counter per dead slot).
							let slotShape = stringifyType(params[0])
							let ptr = printExpression(args[0])
							let count = printExpression(args[1])

							if not slotShape.endsWith('*') {
								return '(free((void*)(' + ptr + ')), (int32_t)(' + count + '))'
							}

							if slotShape == 'Any_*' {
								return 'hexaFreeAnySlots((struct Any_**)(' + ptr + '), (size_t)(' + count + '))'
							}

							return 'hexaFreeSlots((void**)(' + ptr + '), (size_t)(' + count + '))'
						}

						if let params = params, s == '&resizeSlots' {
							// Grow-in-place twin of `&slotsAlloc` (see
							// `resizeSlots<T>` in library/c/c.hexa): the same
							// slot-shape split, applied to the fresh tail only,
							// on top of `realloc` — no full re-fill, no
							// per-slot copy loop, no free+alloc.
							let slotShape = stringifyType(params[0])
							let p = printExpression(args[0])
							let oc = printExpression(args[1])
							let nc = printExpression(args[2])

							if not slotShape.endsWith('*') {
								return '((' + slotShape + '*)hexaResizeScalar((void*)(' + p + '), sizeof(' + slotShape + '), (size_t)(' + oc + '), (size_t)(' + nc + ')))'
							}

							return '((' + slotShape + '*)hexaResizeSlots((void**)(' + p + '), (size_t)(' + oc + '), (size_t)(' + nc + ')))'
						}

						return s + printCallArguments(args)
					case Prefix:
						return '(' + s + '(' + printExpression(args[0]) + '))'
					case Postfix:
						return '((' + printExpression(args[1]) + ')' + s + ')'
				}

			case UnsafeBitCast(e, to):
				// switch e {
				// case Null: return '(/*UnsafeBitCast*/(Unknown_ *)0)'
				// // TODO maybe use `0` value? or static_cast?
				// }
				return printTypeConverter(printExpression(e), getType(e), to)
				// return 'reinterpret_cast<' + stringifyType(to) + '>(' + printExpression(e) + '))'
				// return '(*reinterpret_cast<' + stringifyType(to) + ' *>(&' + printExpression(e) + '))'

			case Enum(typeName, tagName, tag, args):
				return '' + typeName + '_$' + tagName + '_(' + [for a in args printExpression(a)].join(', ') + ')'

			case EnumParameter(expr, index):
				return printExpression(expr) + '->enum_[' + index + ']'

				// Unbound `_` must never reach codegen — it is a compilation error
			case Underscore:
				throw 'Expression `_` reached codegen — normalizer must bind it first'

				// F9: inside `async fun`, `await p` (Promise) suspends via `co_await`.
				// `co_await (*p)` (deref: operator takes `S&`) yields `Any_*`
				// (`await_resume`), then unboxes to `T` (same bridges as the
				// settled `.value` read it replaces). Settled promises skip
				// suspension via `await_ready` (Phase-1 fast path preserved);
				// pending ones suspend and resume on the frame pump
				// (`hexaPumpResumes`, zero host edits). Outside async (or
				// non-Promise) keeps the pass-through (M1 safe).
					// C++ forbids `co_await` inside `catch` (C2304) — fall back
				// REDESIGN NOTE (#7, as-is for now): `co_await` goes away
				// with C++ coroutines (explicit pending-check + pump re-arm).
			case Await(e):
				// C++ forbids `co_await` inside `catch` (C2304) — fall back
				// to the settled `.value` read below (no suspension).
				if insideAsyncFunction, not insideCatch {
					var awaitedAsync = getType(e)
					var promiseT: Type? = null
					switch awaitedAsync {
						case ClassInstance(classType, generic):
							if classType.name == 'Promise', generic != null, generic.length == 1 {
								promiseT = generic[0]
							}
						case _:
					}

					if let t = promiseT {
						if t == project.typer.typeVoid {
							return '(co_await (*' + printExpression(e) + '), (void)0)'
						}
						let base = '(co_await (*' + printExpression(e) + '))'

						if t == project.typer.typeInt {
							return 'Any_unboxInt_(' + base + ')'
						}

						if t == project.typer.typeFloat or t == project.typer.typeNumber {
							return 'Any_unboxFloat_(' + base + ')'
						}

						if t == project.typer.typeInt64 or t == project.typer.typeUInt64 {
							return 'Any_unboxInt64_(' + base + ')'
						}

						if t == project.typer.typeBool {
							return '(' + base + ')->_toBool()'
						}
						return '((' + stringifyType(t) + ')(size_t)(' + base + '))'
					}
				}
				// The C value is still the PROMISE pointer while `getType`
				// reports the awaited result type — cast to it so
				// `let x: T = await p` compiles (no-op until F9).
				// Void-C callees (`async fun` without `return`) carry no C
				// value — sequence for effects, yield typed null instead
				// of casting `void` (C2440).
				if isVoidValue(e) {
					var awaitedVoid = getType(e)

					switch awaitedVoid {
						case ClassInstance(classType, generic):
							if classType.name == 'Promise', generic != null, generic.length == 1 {
								awaitedVoid = generic[0]
							}
						case _:
					}

					return '(' + printExpression(e) + ', (' + stringifyType(awaitedVoid) + ')0)'
				}
				var awaited = getType(e)

				var settled = false
				switch awaited {
					case ClassInstance(classType, generic):
						if classType.name == 'Promise', generic != null, generic.length == 1 {
							// Phase-1 native await (F9 lands real suspension):
							// promises settle synchronously (resolve() stores
							// .value at construction; executor promises never
							// settle) and there is no event loop to suspend
							// on — so read the settled value instead of
							// reinterpreting the promise object (which jumps
							// into garbage via vtable mismatch, M3 boot).
							if generic[0] != project.typer.typeVoid {
								awaited = generic[0]
								settled = true
							}
						}
					case _:
				}

				if settled {
					let base = '(' + printExpression(e) + ')->value_'
					// Scalar Ts unbox through the conversion helpers
					// (null-safe: unsettled promises read defaults
					// instead of crashing).
					if awaited == project.typer.typeInt {
						return 'Any_unboxInt_(' + base + ')'
					}

					if awaited == project.typer.typeFloat or awaited == project.typer.typeNumber {
						return 'Any_unboxFloat_(' + base + ')'
					}

					if awaited == project.typer.typeInt64 or awaited == project.typer.typeUInt64 {
						return 'Any_unboxInt64_(' + base + ')'
					}

					if awaited == project.typer.typeBool {
						return '(' + base + ')->_toBool()'
					}
					return '((' + stringifyType(awaited) + ')(size_t)(' + base + '))'
				}

				return '((' + stringifyType(awaited) + ')(' + printExpression(e) + '))'

				// `x !.` force-unwrap — nullability checks are elided for now (stub)
			case RemoveNullability(expr, _):
				return printExpression(expr)

				// `"str"[i]` — `String?` per element: the ADDRESS of the
				// character slot stands in for the one-char string (F7)
			case StringIndex(expr, index, _):
				return '(&' + printExpression(expr) + '[' + printTypeConverter(printExpression(index), getType(index), project.typer.typeInt) + '])'

				// `x is T` — vtable-tag check for `Any` receivers (F10.1 first
				// consumer: exact-type, null-safe); everything else keeps the
				// legacy truthiness path (other targets emit it too).
			case Is(e, t):
				if let tag = anyIsTagCheck(e, t) {
					return tag
				}
				return '((bool)(' + printExpression(e) + '))'

				// `...value` — a runtime list cannot expand statically (stub: pass as-is)
			case Spread(expr):
				return printExpression(expr)

			case StringConcatenation(leftString, rightString):
				return 'String_$combine_(' + printExpression(leftString) + ', ' + printExpression(rightString) + ')'

			case _:
				console.error("Unknown expression kind:", e)
				return '<!--' + ((e as!Any)??[])[0] + '-->'
		}
	}
}
