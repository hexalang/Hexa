@rename('Object')
declare class Object {
	static fun keys(obj: Any): [String]
	static fun values(obj: Any): [Any]
	static fun entries(obj: Any): [[String: Any]]
	static fun assign(target: Any,...sources: Any): Any
	static fun freeze(obj: Any): Any
	static fun seal(obj: Any): Any
	@rename("is") static fun isSame(value1: Any, value2: Any): Bool
	static fun create(proto: Any?, propertiesObject: Any? = null): Any
	static fun defineProperty(obj: Any, prop: String, descriptor: Any): Any
	static fun defineProperties(obj: Any, props: Any): Any
	static fun getOwnPropertyNames(obj: Any): [String]
	static fun getOwnPropertySymbols(obj: Any): [Symbol]
	static fun getPrototypeOf(obj: Any): Any?
	static fun setPrototypeOf(obj: Any, proto: Any?): Any
	static fun hasOwn(obj: Any, prop: String): Bool
	static fun fromEntries(entries: [[String: Any]]): Any
	static fun preventExtensions(obj: Any): Any
	static fun isExtensible(obj: Any): Bool
	static fun isFrozen(obj: Any): Bool
	static fun isSealed(obj: Any): Bool
	static fun getOwnPropertyDescriptor(obj: Any, prop: String): Any?
	static fun getOwnPropertyDescriptors(obj: Any): Any
	new ()
	// TODO new (value: Any)
}

@rename('Symbol')
declare class Symbol {
	fun toString(): String
	fun valueOf(): Symbol
	@rename('for') static fun forKey(key: String): Symbol
	static fun keyFor(sym: Symbol): String?
	static let asyncIterator: Symbol
	static let hasInstance: Symbol
	static let isConcatSpreadable: Symbol
	static let iterator: Symbol
	static let match: Symbol
	static let matchAll: Symbol
	static let replace: Symbol
	static let search: Symbol
	static let species: Symbol
	static let split: Symbol
	static let toPrimitive: Symbol
	static let toStringTag: Symbol
	static let unscopables: Symbol
}

@final
declare class String {
	let length: Int
	fun toUpperCase(): String
	fun toLowerCase(): String
	fun endsWith(str: String): Bool
	fun startsWith(str: String): Bool
	fun includes(str: String): Bool
	fun replace(what: String, with: String): String
	fun replaceAll(what: String, with: String): String
	// Overloads for RegExp first arg
	@rename('replace') fun replaceRegExp(what: RegExp, withString: String): String
	@rename('replaceAll') fun replaceAllRegExp(what: RegExp, withString: String): String
	fun charAt(index: Int): String
	fun indexOf(str: String, startIndex: Int = 0): Int
	fun lastIndexOf(str: String, startIndex: Int?): Int
	fun split(delimiter: String): [String]
	fun toString(): String
	fun substring(startIndex: Int, endIndex: Int? = 1073741824): String
	static fun fromCharCode(code: Int): String
	fun charCodeAt(index: Int): Int?
	fun trim(): String
	fun substr(pos: Int, len: Int? = 1073741824): String
	// TODO new optional syntax fun substr(pos: Int, len: Int? = _): String
	fun slice(pos: Int, len: Int? = 1073741824): String
	fun padStart(targetLength: Int, padString: String? = null): String
	fun padEnd(targetLength: Int, padString: String? = null): String
	fun repeat(count: Int): String
	fun trimStart(): String
	fun trimEnd(): String
	fun match(regexp: RegExp): RegExpMatch?
	fun search(regexp: RegExp): Int
	fun at(index: Int): String?
	fun concat(...strings: String): String
	fun codePointAt(pos: Int): Int?
	fun localeCompare(compareString: String, locales: Any? = null, options: Any? = null): Int
	fun normalize(form: String? = 'NFC'): String
	fun valueOf(): String
	static fun fromCodePoint(...codePoints: Int): String
	fun trimLeft(): String
	fun trimRight(): String
}

