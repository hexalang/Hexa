/// Formatting preserves user personal style
fun autoFormatWholeFile(file: String): String {
	let project = new Project()
	let content = Buffer.from(file)
	try {
		let tokens = Lexer.tokenize(content, 'hexa.hexa')
		let count = tokens.line.length - 1
		let result = ['']
		var lastLine = 1
		var lastToken = Token.Eof
		// TODO comments as tokens

		var tabs = ''
		var tabStack = ['']
		var tabCase = [false]
		var depth = 0
		let assignOp = [Token.Add, Token.Multiply, Token.Subtract]

		fun updateTab() {
			tabs = tabStack.slice(0, depth + 1).join('')
		}

		fun pushTab() {
			depth++
			tabStack[depth] = '\t'
			updateTab()
		}

		fun popTab() {
			depth--
			if depth < 0 {
				depth = 0
			}
			updateTab()
		}

		fun appendTab() {
			// TODO array[]op= should work at least for strings (and Numbers?)
			tabStack[depth] += '\t'
			updateTab()
		}

		fun resetTab() {
			tabStack[depth] = '\t'
			updateTab()
		}

		for i in count {
			let token = tokens.token[i] as! Token

			if token == Token.BlockClose {
				popTab()
			}

			if token == Token.KCase {
				resetTab()
			}

			var shouldSpace = true
			let line = tokens.line[i]
			if line != lastLine {
				result.push('\n')
				// Handle double \n\n
				let lineDiff = line - lastLine
				if lineDiff > 1 {
					result.push('\n')
				}

				// TODO if bool? of array[i] not valid
				if (token == Token.KCase or token == Token.BlockClose) and tabCase[depth] == true {
				}

				if token == Token.BlockClose {
				}

				result.push(tabs)
				shouldSpace = false
			}

			lastLine = line

			if
				// TODO #if
				// TODO (\nargs\n)
				// TODO if\nconds\n{}
				lastToken == Token.Eof or
				lastToken == Token.Dot or
				token == Token.Dot or

				(token == Token.Assign and assignOp.includes(lastToken)) or

				lastToken == Token.CallOpen or
				(
					token == Token.CallOpen and
					(
						lastToken != Token.KIf and
						lastToken != Token.KNew and
						lastToken != Token.Assign
					)
				) or
				token == Token.CallClose or

				lastToken == Token.IndexOpen or
				(
					token == Token.IndexOpen and
					(
						lastToken == Token.Identifier or
						lastToken == Token.IndexClose
					)
				) or
				token == Token.IndexClose or

				// `@at`
				(token == Token.Identifier and lastToken == Token.At) or

				token == Token.KNot or
				token == Token.Comma or
				token == Token.Colon
			{
				shouldSpace = false
			}

			if shouldSpace {
				result.push(' ')
			}

			// TODO preserve string double/single quotes as Meta
			switch token {
				case LogicalAnd: result.push('and')
				case LogicalOr: result.push('or')
				case _: result.push(Token.stringify(token, tokens.value[i]))
			}

			lastToken = token

			switch token {
				case BlockOpen:
					pushTab()
				case BlockClose:
				case KCase:
					appendTab()
				case KIf:
					// TODO appendTab()
			}
		}

		// TODO extra line
		return result.join('')
	} catch e: CompilerErrors {
		return file
	}

	return file
}
