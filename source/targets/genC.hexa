		r += 'struct String_* Hexa_GenericToString_(void* self);' + nl
		r += 'struct String_* Hexa_GenericToString_(void* self) ' + lb + ' (void)self; return nullptr; ' + rb + nl
		r += 'uint8_t HexaHasReflect_(const void* tag_);' + nl
		r += 'int32_t Hexa_QI_(void* self, void* riid, void** out);' + nl
		r += 'uint32_t Hexa_AddRef_(void* self);' + nl
		r += 'uint32_t Hexa_Release_(void* self);' + nl
		r += 'int32_t Hexa_QI_(void* self, void* riid, void** out) ' + lb + ' if (out != nullptr) ' + lb + ' *out = self; Hexa_AddRef_(self); return (int32_t)0; ' + rb + ' return (int32_t)1; ' + rb + nl
		r += 'uint32_t Hexa_AddRef_(void* self) ' + lb + ' if (self == nullptr) return (uint32_t)0; hexaRef(self); return (uint32_t)(((struct HexaHeader_*)(self))->rc_); ' + rb + nl
