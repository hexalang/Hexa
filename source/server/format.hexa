/// Formatting preserves user personal style to some degree
// TODO hexa format cli .hexa .json
// TODO cover in testFormat.hexa
fun autoFormatWholeFile(file: String): String {
	let content = Buffer.from(file)
	try {
		// TODO range formatter
		let tokens = Lexer.tokenize(content, 'hexa.hexa', format: true)
		let count = tokens.line.length - 1
		let result = ['']
		var currentCall = [Token.Eof]
		var currentCallLevel = Token.Eof
		var lastLine = 1
		var lastToken = Token.Eof
		var lastLastToken = Token.Eof
		var lastTokenIncludingComments = Token.Eof
		var lastIndentation = ''

		var tabs = ''
		var tabStack = ['']
		var tabCase = [false]
		var depth = 0
		let assignOp = [
			Token.Add, Token.Multiply, Token.Subtract, Token.BitwiseAnd, Token.BitwiseOr,
			Token.BitwiseXor, Token.Divide, Token.IntegerDivide, Token.Remainder,
			Token.BitwiseLeftShift
			// TODO conflicts with `T<<T>> =`
			// Token.BitwiseRightShift, Token.UnsignedRightShift
		]
		var parenthesis = -1000000
		var hangingExtra = ''

		fun updateTab() {
			tabs = tabStack.slice(0, depth + 1).join('')
		}

		fun pushTab() {
			depth++
			tabStack[depth] = '\t'
			updateTab()
		}

		fun popTab() {
			depth--
			if depth < 0 {
				depth = 0
			}
			updateTab()
		}

		fun appendTab() {
			// TODO array[]op= should work at least for strings (and Numbers?)
			tabStack[depth] += '\t'
			updateTab()
		}

		fun resetTab() {
			tabStack[depth] = '\t'
			updateTab()
		}

		fun getToken(i) Token {
			if let token = tokens.token[i] {
				return token as! Token
			}
			return Token.Eof
		}

		fun getTokenLength(i) Int {
			if let string = Token.stringify(getToken(i), tokens.value[i], tokens.kind[i]) {
				return string.length
			}

			return 1
		}

		for i in count {
			let token = tokens.token[i] as! Token

			if lastToken == Token.Sharp {
				result.push(Token.stringify(token, tokens.value[i], tokens.kind[i]))
				lastToken = token
				continue
			}

			if
				token == Token.BlockClose or
				token == Token.CallClose or
				(token == Token.Sharp and getToken(i + 1) != Token.KIf) or
				token == Token.IndexClose
			{
				parenthesis--
				popTab()
			}

			// Clear hanging indent when the condition body starts
			if token == Token.BlockOpen {
				hangingExtra = ''
			}

			if token == Token.KCase {
				resetTab()
			}

			var shouldSpace = true
			let line = tokens.line[i]
			if line != lastLine {
				result.push('\n')
				// Handle double \n\n
				let lineDiff = line - lastLine
				if lineDiff > 1 {
					// `///` doc comments attach to the next expression — no blank lines preserved
					// `//` line comments preserve at most one blank line (collapse multiple to one)
					// All other tokens collapse multiple blank lines to one
					if lastTokenIncludingComments != Token.Documentation {
						result.push('\n')
					}
				}

				// Insert blank line before control flow keywords when following expression
				if lineDiff == 1 {
					if
						token == Token.KIf or
						token == Token.KFor or
						token == Token.KWhile or
						token == Token.KDo or
						token == Token.KTry or
						token == Token.KSwitch
					{
						// Check if previous token was an expression/statement that needs separation
						// But NOT comments - comments should stay adjacent to control flow
						if
							lastTokenIncludingComments != Token.CommentLine and
							lastTokenIncludingComments != Token.Documentation and
							(
								lastToken == Token.Identifier or
								lastToken == Token.Integer or
								lastToken == Token.FloatingPoint or
								lastToken == Token.QuotedString or
								lastToken == Token.CallClose or
								lastToken == Token.IndexClose or
								lastToken == Token.BlockClose or
								lastToken == Token.Increment or
								lastToken == Token.Decrement
							)
						{
							result.push('\n')
						}
					}
				}

				// TODO if `Bool?` of `array[i]` not valid `if tabCase[depth] {}`, require `== true`
				// as `tabCase[depth] == true` cause it can be `null`
				var indentation = tabs + hangingExtra
				result.push(tabs + hangingExtra)

				// `=\nvalue`
				// TODO weird indentation right here
				if lastToken == Token.Assign or (
						lastToken == Token.KReturn and token != Token.BlockClose
					) {
					result.push('\t')
					indentation += '\t'
				}

				// The idea here is `value1 and \n value2` should have `value2` with tab
				// Don't apply this to BlockOpen/BlockClose — they end the condition
				if token != Token.BlockOpen and token != Token.BlockClose {
					if
						lastToken == Token.Add or
						lastToken == Token.Subtract or
						lastToken == Token.Multiply or
						lastToken == Token.LogicalAnd or
						lastToken == Token.LogicalOr or
						lastToken == Token.KAnd or
						lastToken == Token.KOr or
						lastToken == Token.Equal or
						lastToken == Token.Unequal or
						lastToken == Token.RightArrow or
						lastToken == Token.Comma
					{
						if lastIndentation.length > indentation.length {
							result.push('\t')
							indentation += '\t'
						}
					}
				}

				// `and`/`or` at start of a new line — continuation from previous expression
				// When `hangingExtra` is already active (from a control flow keyword),
				// the extra indent is already included in `indentation`, so skip.
				if
					token == Token.KAnd or
					token == Token.KOr or
					token == Token.LogicalAnd or
					token == Token.LogicalOr
				{
					if hangingExtra == '' {
						result.push('\t')
						indentation += '\t'
					}
				}

				// Control flow keyword (`if`/`for`/`while`/`do`/`switch`) on its own line
				// — next line starts the condition with hanging indent
				// Sets `hangingExtra` so the extra indent persists across paren boundaries
				if
					lastToken == Token.KIf or
					lastToken == Token.KFor or
					lastToken == Token.KWhile or
					lastToken == Token.KDo or
					lastToken == Token.KSwitch
				{
					if hangingExtra == '' {
						result.push('\t')
						indentation += '\t'
					}
					hangingExtra = '\t'
				}

				// Comments inside a multi-line condition should preserve hanging indent
				// from the previous condition line
				if token == Token.CommentLine {
					if lastIndentation.length > indentation.length {
						result.push('\t')
						indentation += '\t'
					}
				}

				if token == Token.KAs {
					if lastIndentation != indentation {
						result.push('\t')
						indentation += '\t'
					}
				}

				shouldSpace = false
				lastIndentation = indentation
			}

			// When evaluated to `true` it means `shouldSpace = false`
			// TODO `**` operator
			if
				// `#if`
				lastToken == Token.Sharp or

				// TODO if\nconds\n{}
				lastToken == Token.Eof or
				lastToken == Token.Dot or
				token == Token.Dot or

				// `+=`
				(token == Token.Assign and assignOp.includes(lastToken)) or

				// `~123`
				lastToken == Token.BitwiseNot or

				// `(something`
				lastToken == Token.CallOpen or
				// `(`
				(
					token == Token.CallOpen and
					(
						// Keywords
						lastToken != Token.KIn and
						lastToken != Token.KReturn and
						lastToken != Token.KIf and
						lastToken != Token.KFun and
						lastToken != Token.KNew and
						lastToken != Token.KNot and
						lastToken != Token.KSwitch and
						lastToken != Token.KWhile and
						lastToken != Token.KDo and
						lastToken != Token.KFor and
						lastToken != Token.LogicalAnd and
						lastToken != Token.LogicalOr and
						lastToken != Token.KAnd and
						lastToken != Token.KOr and
						lastToken != Token.KAs and
						lastToken != Token.KIs and

						// Operators
						lastToken != Token.Assign and
						lastToken != Token.Add and
						lastToken != Token.Subtract and
						lastToken != Token.Multiply and
						lastToken != Token.Divide and
						lastToken != Token.Remainder and
						lastToken != Token.BitwiseAnd and
						lastToken != Token.BitwiseOr and
						lastToken != Token.Comma and
						lastToken != Token.Equal and
						lastToken != Token.Unequal and
						lastToken != Token.Less and
						lastToken != Token.Exponent and
						lastToken != Token.BitwiseXor and
						lastToken != Token.IntegerDivide and

						currentCallLevel != Token.KNew and

						// Preserve cause `Class<T>()` and `a > (b)`
						not (
							(
								lastToken == Token.Greater
							) and (
								tokens.column[i] != 1 + (tokens.column[i - 1] ?? 0)
							)
						) and

						lastToken != Token.LessOrEqual and
						lastToken != Token.GreaterOrEqual and
						lastToken != Token.BitwiseLeftShift and
						lastToken != Token.BitwiseRightShift and
						lastToken != Token.UnsignedRightShift and
						lastToken != Token.Interval and
						lastToken != Token.Colon and
						// Includes `??`
						lastToken != Token.Question and
						// `)(`
						lastToken != Token.CallClose and

						// `@demo()` but not `@demo ()`
						not (
							(
								lastToken == Token.Identifier
							) and (
								(lastLastToken == Token.At and tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0))
							)
						) and

						// `call()` but `var callback ()`
						not (
							(
								lastToken == Token.Identifier
							) and (
								((lastLastToken == Token.KVar or lastLastToken == Token.KLet) and true)
							)
						)
					)
				) or
				// @sds() TODO error () no args not allowed
				token == Token.CallClose or

				// `[`
				lastToken == Token.IndexOpen or
				(
					token == Token.IndexOpen and
					(
						// Preserve cause `value[index]` and `value [T]`
						not (
							tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)

					/*
					(
						lastToken == Token.Identifier or
						lastToken == Token.IndexClose
					) and (
						(
							// TODO same for ()=>
							lastLastToken != Token.KVar and
							lastLastToken != Token.CallOpen and // TODO use isFunctionArgument
							lastLastToken != Token.Comma and // TODO use isFunctionArgument
							lastLastToken != Token.KLet
						) or line != lastLastLine
					)
					*/
				) or
				token == Token.IndexClose or
				// `@at`
				(token == Token.Identifier and lastToken == Token.At) or
				// `...arg`
				(
					token == Token.Identifier and lastToken == Token.Interval and
					(
						// `, ...arg`
						lastLastToken == Token.Comma or
						// `(...arg`
						lastLastToken == Token.CallOpen
						// TODO conflicts with `(value) ... range`
						// `@dec ...let`
						// lastLastToken == Token.Identifier
						// `@dec() ...let`
						// lastLastToken == Token.CallClose
					)
				) or

				(
					token == Token.Question and
					(
						// `??`
						lastToken == Token.Question or
						// `Type?`
						// lastToken == Token.Title

						// Preserve cause `a ? b : c` and `T?`
						not (
							tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)
				) or

				// `as!` or `as?`
				(lastToken == Token.KAs and (token == Token.KNot or token == Token.Exclamation or token == Token.Question)) or

				// Space after `as!`, `as?`
				(
					(lastToken == Token.KNot or lastToken == Token.Exclamation or lastToken == Token.Question) and
					lastLastToken == Token.KAs
				) or

				// `++`
				token == Token.Increment or

				// `--`
				token == Token.Decrement or

				// `-123`
				(
					(
						token == Token.FloatingPoint or
						token == Token.Integer or
						token == Token.Identifier or
						token == Token.CallOpen
					) and
					lastToken == Token.Subtract and
					(
						lastLastToken == Token.Eof or
						lastLastToken == Token.KReturn or
						lastLastToken == Token.KThrow or
						lastLastToken == Token.KCase or
						lastLastToken == Token.LogicalAnd or
						lastLastToken == Token.LogicalOr or
						lastLastToken == Token.KAnd or
						lastLastToken == Token.KOr or
						lastLastToken == Token.KNot or
						lastLastToken == Token.Exclamation or
						lastLastToken == Token.IndexOpen or
						lastLastToken == Token.BlockOpen or
						lastLastToken == Token.Comma or
						lastLastToken == Token.Colon or
						lastLastToken == Token.CallOpen or
						lastLastToken == Token.Question or
						lastLastToken == Token.Assign or
						lastLastToken == Token.Equal or
						lastLastToken == Token.Greater or
						lastLastToken == Token.GreaterOrEqual or
						lastLastToken == Token.Less or
						lastLastToken == Token.LessOrEqual or
						lastLastToken == Token.Unequal or
						lastLastToken == Token.Add or
						lastLastToken == Token.Subtract or
						lastLastToken == Token.Multiply or
						lastLastToken == Token.Divide or
						lastLastToken == Token.IntegerDivide or
						lastLastToken == Token.Remainder or
						lastLastToken == Token.BitwiseAnd or
						lastLastToken == Token.BitwiseOr or
						lastLastToken == Token.BitwiseXor or
						lastLastToken == Token.BitwiseLeftShift or
						lastLastToken == Token.BitwiseRightShift or
						lastLastToken == Token.UnsignedRightShift or
						lastLastToken == Token.Exponent
					)
				) or

				(
					token == Token.Less and
					(
						// Preserve cause `a < c` and `T<T>`
						not (
							tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)
				) or

				(
					(
						lastToken == Token.Less and (
							token == Token.Identifier or
							token == Token.At or
							token == Token.Title
						)
					) and
					(
						// Preserve cause `a < c` and `T<T>` and `T<name: T>`
						not (
							tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)
				) or

				// `T>`
				// `T>>`
				(
					(token == Token.Greater or token == Token.BitwiseRightShift) and
					(
						// Preserve cause `a > c` and `T<T>`
						not (
							tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)
				) or

				token == Token.Comma or
				token == Token.Interval or
				// `/abc/gi` — no space between regex pattern and flags
				(
					lastToken == Token.Regex and
					token == Token.Identifier and
					not (
						tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
					)
				) or
				(
					token == Token.Colon and
					(
						// Preserve cause `a ? b : c` and `(name: value)`
						not (
							tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)
				)
			{
				shouldSpace = false
			}


			if shouldSpace {
				result.push(' ')
			}

			if token == Token.CallOpen {
				// TODO `fun`
				currentCall.push(lastToken)
				currentCallLevel = lastToken
			}

			if token == Token.CallClose {
				currentCall.pop()
				currentCallLevel = currentCall[currentCall.length - 1]
			}

			switch token {
				case Comment: result.push(`/*` + tokens.value[i] + `*/`)
				case CommentLine:
					// TODO Doc comments parse separately in tokens
					result.push(((tokens.value[i].startsWith('/') ? '//': '// ') + tokens.value[i].trim()).trim())
				case LogicalAnd: result.push('and')
				case LogicalOr: result.push('or')
				case KNot:
					// TODO Separate exclamation mark
					if lastToken == Token.KAs {
						result.push('!')
					} else {
						result.push('not')
					}
				case QuotedString: switch tokens.kind[i] {
						// TODO FORMAT: should be here 1-tab less
						case SingleQuote: result.push(`'` + tokens.value[i] + `'`)
						case _: result.push(`"` + tokens.value[i] + `"`)
					}
				case _: result.push(Token.stringify(token, tokens.value[i], tokens.kind[i]))
			}

			// Track all tokens including comments
			lastTokenIncludingComments = token

			// Ignore comments for lastToken/lastLastToken
			// TODO same value and meta same way into variables
			if token != Token.CommentLine {
				lastLastToken = lastToken
				lastToken = token
			}

			switch token {
				case BlockOpen:
					pushTab()
					if parenthesis > 0 {
						parenthesis++
					}
				case CallOpen:
					pushTab()
					parenthesis++
				case IndexOpen:
					pushTab()
					parenthesis++
				case Sharp:
					// `#if` `#else`
					if tokens.value[i + 1] == null {
						pushTab()
						parenthesis++
					}
				case KCase:
					appendTab()
				case KIf:
					parenthesis = 0
			}

			lastLine = line

			// TODO not typed if let value = tokens.value[i], value.assaDADADADncludes('\n') {
			if let value = tokens.value[i], value.includes('\n') {
				// TODO String.count('\n')
				lastLine += value.split('\n').length - 1
			}
		}

		// TODO (when) use CRLF? or it seems vscode fixes it on its own
		return result.join('') + '\n'
	} catch e: CompilerErrors {
		return file
	}

	return file
}
