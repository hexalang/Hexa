/// Node position info
// TODO rename to NodePosition or NodeSpan or NodeAt
class NodeData {
	new (atLine, atColumn, atFile) {
		line = atLine
		column = atColumn
		fileName = atFile
	}
	var line: Int
	var column: Int
	// TODO use Int for fileName/module index/id instead of String
	var fileName: String
}

// TODO zero-cost idea: inherite `Token` from `ClassKind` well or just make those tokens same integers
enum ClassKind : Int {
	Class
	Interface
	Type

	static fun stringify(node: ClassKind): String {
		switch node {
			case Class: return "Class"
			case Interface: return "Interface"
			case Type: return "Type"
		}
	}
}

enum ImportNode {
	Lower(name: String)
	Upper(name: String)
	AllTheThings
	As(left: ImportNode, right: ImportNode)
}
