	/// F10.3 thunk BODIES for bare GLOBAL functions boxed into `Any` (see
	/// `anyBox`): no captured env, so the dispatcher's `env_` is ignored. Must
	/// be emitted AFTER the scalar-boxing section (the unbox helpers live
	/// there) — hence a separate section from `printFatPairs`, which only
	/// forward-declares the thunks and fills the registry.
	fun printFatPairGlobalThunks(): String {
		var r = ''

		for i in fatPairGlobalNames.length {
			r += printClosureThunk(fatPairGlobalNames[i] + '_', fatPairGlobalTypes[i], withEnv: false)
		}

		// F10.4: instance-method thunks. A bound method pair stores the
		// receiver in `env_`, which the method's C signature takes as its
		// first parameter (`$this`) — the same shape `withEnv` emits for
		// lifted closures, so param 0 is skipped and `env_` is pushed.
		for i in fatPairMethodNames.length {
			r += printClosureThunk(fatPairMethodNames[i] + '_', fatPairMethodTypes[i], withEnv: true, envCast: fatPairMethodSelf[i], skipFirst: false)
		}

		return r
	}

	/// D7 scalar boxing (real values replace the null stubs): heap boxes with
	/// tag vtables, first word like every object. All unboxers are total and
	/// never AV: null reads as default; small ints (incl. negatives — legacy
	/// int-as-pointer placeholders) read as values, so no deref; Bool
	/// singletons compare by identity (empty structs carry no tag); only
	/// valid heap objects reach the tag deref. FatPair_ reads as non-scalar
	/// default (pairs are functions, not numbers). `String__$` doubles as the
	/// string detector for `Any_unboxString_` (real strings pass through;
	/// scalars format; everything else keeps the `"null"` placeholder).
	fun printScalarBoxing(): String {
		let lb = String.fromCharCode(123)
