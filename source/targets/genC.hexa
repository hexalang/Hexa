	/// F10.2 plain-object bags: `AnyObject_` heap records (first word is the
	/// tag vtable, like every object) holding parallel key/value entries.
	/// Object literals into `Any` slots construct these via `printObjectAs`
	/// (no more `Object_from` null stubs); `Any_dynGet_`/`Any_dynSet_` route
	/// dynamic member access here, everything else keeps the legacy proxy.
	/// Key compare is content-based (length + UTF-16 units). Growth leaks the
	/// old buffer like every other Phase-1 heap object (F11).
	fun printAnyObject(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// F10.2 plain-object bags: `Object` common class, per-instance shape' + nl
		// The common `Object` class: every `JSON.parse` object and every
		// untyped `{...}` literal is an instance. Shape lives PER INSTANCE
		// (`count_/cap_/entries_`), hidden vtable is SHARED (one vt for all
		// bags — fields dispatch by linear key scan, like the per-class
		// string-compare for small static classes).
		r += 'struct AnyObject__ ' + lb + ' int32_t (*QueryInterface_)(void*, void*, void**); uint32_t (*AddRef_)(void*); uint32_t (*Release_)(void*); ' + rb + ';' + nl
		r += 'struct AnyObjectEntry_ ' + lb + ' String_* k_; Any_* v_; ' + rb + ';' + nl
		r += 'struct AnyObject_ ' + lb + ' const struct AnyObject__* _; int32_t rc_; int32_t count_; int32_t cap_; struct AnyObjectEntry_* entries_; ' + rb + ';' + nl
		r += 'int32_t Any_objectFind_(AnyObject_* o, String_* k);' + nl
		r += 'uint8_t Any_isCounted_(Any_* p);' + nl
		r += 'const char* AnyObject_hiddenClassName_(void);' + nl
		r += 'const char* AnyObject_hiddenClassName_(void) ' + lb + ' return "Object"; ' + rb + nl
		r += 'Any_* AnyObject_hiddenDynGet_(void* self_, struct String_* k_);' + nl
		r += 'Any_* AnyObject_hiddenDynGet_(void* self_, struct String_* k_) ' + lb + ' if (self_ == nullptr || k_ == nullptr) return nullptr; AnyObject_* o_ = (AnyObject_*)(self_); int32_t at_ = Any_objectFind_(o_, k_); if (at_ >= (int32_t)0) return o_->entries_[at_].v_; return nullptr; ' + rb + nl
		r += 'void AnyObject_hiddenDynSet_(void* self_, struct String_* k_, Any_* v_);' + nl
		r += 'void AnyObject_hiddenDynSet_(void* self_, struct String_* k_, Any_* v_) ' + lb + ' if (self_ == nullptr || k_ == nullptr) return; AnyObject_* o_ = (AnyObject_*)(self_); int32_t at_ = Any_objectFind_(o_, k_); if (at_ >= (int32_t)0) ' + lb + ' Any_* old_ = o_->entries_[at_].v_; o_->entries_[at_].v_ = v_; if (Any_isCounted_(v_)) hexaRef((void*)v_); if (Any_isCounted_(old_)) hexaUnref((void*)old_); return; ' + rb + ' if (o_->count_ >= o_->cap_) ' + lb + ' int32_t ncap_ = o_->cap_ <= (int32_t)0 ? (int32_t)4 : o_->cap_ * (int32_t)2; struct AnyObjectEntry_* ne_ = (struct AnyObjectEntry_*)(HEXA_NEW(sizeof(struct AnyObjectEntry_) * ncap_)); for (int32_t i_ = (int32_t)0; i_ < o_->count_; i_++) ' + lb + ' ne_[i_].k_ = o_->entries_[i_].k_; ne_[i_].v_ = o_->entries_[i_].v_; ' + rb + ' o_->entries_ = ne_; o_->cap_ = ncap_; ' + rb + ' o_->entries_[o_->count_].k_ = k_; if (Any_isCounted_((Any_*)(k_))) hexaRef((void*)(k_)); o_->entries_[o_->count_].v_ = v_; if (Any_isCounted_(v_)) hexaRef((void*)v_); o_->count_++; ' + rb + nl
		r += 'uint8_t AnyObject_hiddenHas_(void* self_, struct String_* k_);' + nl
		r += 'uint8_t AnyObject_hiddenHas_(void* self_, struct String_* k_) ' + lb + ' if (self_ == nullptr || k_ == nullptr) return (uint8_t)0; return (uint8_t)(Any_objectFind_((AnyObject_*)(self_), k_) >= (int32_t)0); ' + rb + nl
		r += 'void AnyObject_hiddenDelete_(void* self_, struct String_* k_);' + nl
		r += 'void AnyObject_hiddenDelete_(void* self_, struct String_* k_) ' + lb + ' (void)self_; (void)k_; ' + rb + nl
		r += 'struct String_* AnyObject_hiddenKeyAt_(void* self_, int32_t i_);' + nl
