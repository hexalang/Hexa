// TODO include into project only when target is debug one in hexa.json
class TestParser {
	static fun test() {
		console.log("TestParser begin")

		// Basics and indentation
		shouldAllEqual([
				'' : 'null',
				'  ' : 'null',
				'	' : 'null',
				'   	' : 'null',

				'\n' : 'null',
				'\n\n' : 'null',
				'\r\r\n\r\n\r\t' : 'null',

				'{}' : 'Block([])',
				'{{}}' : 'Block([Block([])])',
				'{ 0 0 0 }' : 'Block([Int(0),Int(0),Int(0)])',

				'0' : 'Int(0)',
				' 0 ' : 'Int(0)',
				'123' : 'Int(123)',
				'12' : 'Int(12)',
				"0x1" : 'Int(1)',
				"0x0" : 'Int(0)',
				"0xF" : 'Int(15)',
				"0xFA" : 'Int(250)',
				"0xFABCDEF" : 'Int(262917615)',

				"0.0" : 'Float(0)',
				"0.123" : 'Float(0.123)',

				// Hex/Binary case sensitivity

				// Scientific notation

				// Prefix neg

				// BigInt variations - use MetaInt instead

				// Underscore separators

				// Complex numbers

				// Documentation comments NOTE they preserve the leading ` ` space
				"/// Doc\nfun foo() {}" : 'Doc( Doc,Function(foo,Block([]),[],null,false,false))',
				"///Doc\nfun foo() {}" : 'Doc(Doc,Function(foo,Block([]),[],null,false,false))',
				"/// Doc\n/// Docs [foo]\nfun foo() {}" : 'Doc( Docs [foo],Doc( Doc,Function(foo,Block([]),[],null,false,false)))',
				"/// Variable doc\nvar x = 1" : 'Doc( Variable doc,Var(x,null,Int(1),false,false))',
				"/// Class doc\nclass Test {}" : 'Doc( Class doc,Class(Type(Test),null,[],[],false))',
				"/// Type doc\ntype Alias = String" : 'Doc( Type doc,TypeAlias(Type(Alias),Type(String)))',

				"'s'" : 'String(s)',
				"\"s\"" : 'String(s)'
			])

		// shouldAllEqual([
		// '1 2 3 trace("Hello!", "World!") + 5 * 6 / 3':
		// 'Block([
		// Int(1),
		// Int(2),
		// Int(3),
		// Binop(
		// Call(Ident(trace),[String(Hello!),String(World!)]),
		// +,
		// Binop(Binop(Int(5),*,Int(6)),/,Int(3)))])',
		//
		// 'enum Test { Demo } hello World':
		// 'Block([Enum(Type(Test),[NodeTypeValue(Type(Demo))]),
		// Ident(hello),
		// NodeTypeValue(Type(World))])'
		// ])

		// Precedence
		// shouldAllEqual([
		// '5 * 6 / 3': 'Binop(Binop(Int(5),*,Int(6)),/,Int(3))',
		// '5 * 6 / 2 * 3': '
		// Binop(
		// Binop(
		// Int(5),
		// *,
		// Binop(Int(6),/,Int(2))
		// ),
		// *,
		// Int(3)
		// )' // TODO Should de * -> / -> *
		// ])

		// Operators
		shouldAllEqual([
				'i ++ ++ i': "Block([Unop(++,true,Ident(i)),Unop(++,false,Ident(i))])",
				'a + b': "Binop(Ident(a),+,Ident(b))",
				'a += b': "AssignOp(Ident(a),+,Ident(b))",
				'a ** b': "Binop(Ident(a),**,Ident(b))",
				'a **= b': "AssignOp(Ident(a),**,Ident(b))",
				'a ** b ** c': "Binop(Ident(a),**,Binop(Ident(b),**,Ident(c)))",
				'a * b ** c': "Binop(Ident(a),*,Binop(Ident(b),**,Ident(c)))",
				'a ** b * c': "Binop(Binop(Ident(a),**,Ident(b)),*,Ident(c))"
			])

		// String interpolation
		shouldAllEqual([
				'"\\\\(v)"': "String(\\\\(v))" // ,
				// '"\\(v)"': 'Parenthesis(Binop(Binop(String(),+,Parenthesis(Ident(v))),+,String()))',
				// '"\\(((v)))"': 'Parenthesis(Binop(String(),+,Binop(Parenthesis(Parenthesis(Parenthesis(Ident(v)))),+,String())))',
				// '"\\( v )"': 'Parenthesis(Binop(String(),+,Binop(Parenthesis(Ident(v)),+,String())))',
				// '"\\(V)\\(v)"': 'Parenthesis(Binop(String(),+,Binop(Parenthesis(NodeTypeValue(Type(V))),+,Binop(String(),+,Binop(Parenthesis(Ident(v)),+,String())))))',
				// '"\\(V)\\(v)s\\(v)"': 'Parenthesis(Binop(String(),+,Binop(Parenthesis(NodeTypeValue(Type(V))),+,Binop(String(),+,Binop(Parenthesis(Ident(v)),+,Binop(String(s),+,Binop(Parenthesis(Ident(v)),+,String())))))))',
				// '"\\(V)s\\(v)s\\(v)"': 'Parenthesis(Binop(String(),+,Binop(Parenthesis(NodeTypeValue(Type(V))),+,Binop(String(s),+,Binop(Parenthesis(Ident(v)),+,Binop(String(s),+,Binop(Parenthesis(Ident(v)),+,String())))))))'
			])

		shouldAllEqualWithoutTrim([
				// '"\\( v )"': 'Parenthesis(Binop(String(),+,Binop(Parenthesis(Ident(v)),+,String())))',
				// '"\\(V)\r\n\\(v)"': 'Parenthesis(Binop(String(),+,Binop(Parenthesis(NodeTypeValue(Type(V))),+,Binop(String(\n),+,Binop(Parenthesis(Ident(v)),+,String())))))',
				// '"\\(V) \\(v) \\(v)"': 'Parenthesis(Binop(String(),+,Binop(Parenthesis(NodeTypeValue(Type(V))),+,Binop(String( ),+,Binop(Parenthesis(Ident(v)),+,Binop(String( ),+,Binop(Parenthesis(Ident(v)),+,String())))))))'
			])

		// Modularity
		// shouldAllEqual([
		// // New syntax
		// 'module { }': 'Block([Module(,[]),Block([])])',
		// 'module': 'Module(, [])',
		// //'code module x code': 'Block([Ident(code),Module(x,[Ident(code)])])',
		// //'code module x module y code': 'Block([Ident(code),Module(x,[]),Module(y,[Ident(code)])])',
		// //'code module x module y code {code}': 'Block([Ident(code),Module(x,[]),Module(y,[Ident(code)]),Block([Ident(code)])])',
		// //'module a': 'Module(a, [])',
		// //'module a.b': 'Module(a.b, [])',
		// 'module class Inner { }': 'Module(,[Class(Type(Inner),null,[],[],false)])',
		// 'module private class Inner {}' : 'Module(,[Private(Class(Type(Inner),null,[],[],false))])'
		// //'module a module b': 'Block([Module(a,[]),Module(b,[])])'
		// ])
		shouldAllEqual([
				'import "test"': 'Import([],test)',
				'import xxx in "test"': 'Import([Lower(xxx)],test)',
				'import xxx as yyy in "test"': 'Import([Lower(xxx){as}Lower(yyy)],test)',
				'import XXX as YYY in "test"': 'Import([Upper(XXX){as}Upper(YYY)],test)',
				'import * as mmm in "test"': 'Import([*{as}Lower(mmm)],test)',
				'import XXX, YYY as ZZZ, www in "test"': 'Import([Upper(XXX),Upper(YYY){as}Upper(ZZZ),Lower(www)],test)'
			])

		shouldAllError([
				'import',
				// TODO 'import ""',
				'import test',
				'import _ as B in "test"',
				'import * in "test"',
				'import * as B in "test"'
				// TODO 'import a as B in ""'
			])

		// Types parsing in expressions
		shouldAllEqual([
				'var a = new Array<A>()' : 'Var(a,null,New([],ParametricType(Array,[Type(A)]),[],[],[],[]),false,false)',
				'a = Array<A>.staticField()' : 'Binop(Ident(a),=,Call(Dot(NodeTypeValue(ParametricType(Array,[Type(A)])),staticField),[]))',
				'a = EnumTest.EnumField' : 'Binop(Ident(a),=,DotUpper(NodeTypeValue(Type(EnumTest)),EnumField))',
				'a = EnumTest.EnumField(arg)' : 'Binop(Ident(a),=,Call(DotUpper(NodeTypeValue(Type(EnumTest)),EnumField),[Ident(arg)]))',
				'a = EnumTest.EnumField(argName: argValue, arg2, arg3: arg3)' : 'Binop(Ident(a),=,Call(DotUpper(NodeTypeValue(Type(EnumTest)),EnumField),[argName:Ident(argValue),Ident(arg2),arg3:Ident(arg3)]))',
				'a = EnumTest<A,B>.EnumField' : 'Binop(Ident(a),=,DotUpper(NodeTypeValue(ParametricType(EnumTest,[Type(A),Type(B)])),EnumField))',
				'var a = b as B var c = d as! B var e = f as? B' : 'Block([Var(a,null,As(Ident(b),,Type(B)),false,false),Var(c,null,As(Ident(d),!,Type(B)),false,false),Var(e,null,As(Ident(f),?,Type(B)),false,false)])',
				'var a = b is B var c = d is B var e = f is B' : 'Block([Var(a,null,Is(Ident(b),Type(B)),false,false),Var(c,null,Is(Ident(d),Type(B)),false,false),Var(e,null,Is(Ident(f),Type(B)),false,false)])'
			])

		// Types parsing in declarations
		shouldAllEqual([
				'var x:[Array<T>]' : 'Var(x,ParametricType(Array,[ParametricType(Array,[Type(T)])]),null,false,false)',
				'var x:[Map<K,V> : Array<T>]' : 'Var(x,ParametricType(Map,[ParametricType(Map,[Type(K),Type(V)]),ParametricType(Array,[Type(T)])]),null,false,false)',
				'var x:{} var y:[] var z:[:] var w:()=>{}' : 'Block([Var(x,Object([],[]),null,false,false),Var(y,ParametricType(Array,[Object([],[])]),null,false,false),Var(z,ParametricType(Map,[Object([],[]),Object([],[])]),null,false,false),Var(w,Function([],Object([],[])),null,false,false)])',
				'let x:()=>()=>()=>()=>Void' : 'Var(x,Function([],Function([],Function([],Function([],Type(Void))))),null,true,false)'
			])

		// Enumerations
		shouldAllEqual([
				'enum A {}' : 'Enum(Type(A),[],null,null)',
				'enum A { A B C }' : 'Enum(Type(A),[NodeTypeValue(Type(A)),NodeTypeValue(Type(B)),NodeTypeValue(Type(C))],null,null)',
				'enum A { A(v:Int) B C(v:[K:V], a:Array<T>) }' :
				'Enum(Type(A),[
					Call(NodeTypeValue(Type(A)),[v:NodeTypeValue(Type(Int))]),
					NodeTypeValue(Type(B)),
					Call(NodeTypeValue(Type(C)),[v:NodeTypeValue(ParametricType(Map,[Type(K),Type(V)])),a:NodeTypeValue(ParametricType(Array,[Type(T)]))])
					],null,null)',
				'enum A { E(v: T<T>?) }' : 'Enum(Type(A),[Call(NodeTypeValue(Type(E)),[v:NodeTypeValue(Optional(ParametricType(T,[Type(T)])))])],null,null)',
				'enum A { E(v: T<T?>) }' : 'Enum(Type(A),[Call(NodeTypeValue(Type(E)),[v:NodeTypeValue(ParametricType(T,[Optional(Type(T))]))])],null,null)',
				'enum A { E(v: T?) }' : 'Enum(Type(A),[Call(NodeTypeValue(Type(E)),[v:NodeTypeValue(Optional(Type(T)))])],null,null)'
			])

		// Constructor
		shouldAllEqual([
				'new A(a: 1, b: 2)' : 'New([],Type(A),[Int(1),Int(2)],[],[],[a,b])',
				'class A {} var a = new A { } ()' : "Block([Class(Type(A),null,[],[],false),Var(a,null,New([],Type(A),[],[],[],[]),false,false)])",
				'class A { var field: String } var a = new A { field: "Value" } ()' :
				"Block([Class(Type(A),null,[],[Var(field,Type(String),null,false,false)],false),Var(a,null,New([],Type(A),[],[field],[String(Value)],[]),false,false)])",
				'class A { var field: String var otherField: Int } var a = new A { field: "Value", otherField: 25 } ()' :
				"Block([Class(Type(A),null,[],[Var(field,Type(String),null,false,false),Var(otherField,Type(Int),null,false,false)],false),Var(a,null,New([],Type(A),[],[field,otherField],[String(Value),Int(25)],[]),false,false)])"
			])

		// Functions
		shouldAllError([
				'class A { new(a b) {} }',
				'class A { new(a, b,) {} }',
				'class A { new(,) {} }',
				'fun f(a b c) {}',
				'fun f(a b) {}',
				'fun f(a, b,) {}',
				'fun f(a,) {}',
				'fun f(,) {}'
			])

		// Property
		shouldAllError([
				'class A { var i: Int { set (value) {} } }', // set before get
				'class A { var i: Int { get {} set () {} } }', // No `value` in setter
				'class A { var i: Int { get {} set {} } }', // No `(value)` in setter
				'class A { let i: Int { get {} set (value) {} } }', // set in let
				'class A { let i: Int { get {} set (value, val) {} } }', // Multiple `value`
				'class A { var i: Int { get {} set (Value) {} } }', // Upper `Value`
				'class A { var i: Int { get (value) {} set (value) {} } }', // `value` in get
				'class A { var i: Int {} }' // No get/set
				// TODO private set/private get
			])

		// Commas
		shouldAllError([
				'if (,) {}',
				'if (a,) {}',
				'switch (,) {}',
				'switch (a,) {}',
				'@att(,) x',
				'@att(a,) x',
				'@att(a,b,) x',
				'@att(a b,) x',
				'@att(a b) x',
				'new T(,)',
				'new T(a b,)',
				'new T(a,b,)',
				'new T(a b)',
				'call(1 2)',
				'call(1 2,)',
				'call(1,2,)',
				'call(1,)',
				'call(a:1,)',
				'call(1:1,)',
				'call(a:,)',
				'call(a:)',
				'call(,)',
				'[1 2]',
				'[,]',
				'[1,]',
				'[1,2,]',
				'[1:1 2:2]',
				'[1:1,2:2,]',
				'{a:1 b:2}',
				'{,}',
				'{a:1,}',
				'{a:1,b:2,}'
			])

		// Misc
		shouldAllError([
				'=',
				'= 1'
			])

		// Conditions
		shouldAllEqual([
				'if this { this }' : 'If([This],Block([This]),null)',
				'if this, this { this } else { break }' : 'If([This,This],Block([This]),Block([Break]))',
				'if this, let a = this { this } else { break }' : 'If([This,Var(a,null,This,true,false)],Block([This]),Block([Break]))',
				'if let a = this, let b = this, this { this }' : 'If([Var(a,null,This,true,false),Var(b,null,This,true,false),This],Block([This]),null)'
			])

		// External declarations
		shouldAllEqual([
				'declare var a: T' : 'Var(a,Type(T),null,false,true)',
				'declare let a: T' : 'Var(a,Type(T),null,true,true)',
				'declare fun name()' : 'Function(name,null,[],null,true,false)',
				'declare fun name() hi()' : 'Block([Function(name,null,[],null,true,false),Call(Ident(hi),[])])',
				// External functions do not parse body
				'declare fun name() {}' : 'Block([Function(name,null,[],null,true,false),Block([])])',
				'declare class A {}' : 'Class(Type(A),null,[],[],true)',
				'declare A = B' : 'TypeAlias(Type(A),Type(B))'
			])

		shouldAllError([
				"declare var a, b, c",
				"declare anything"
			])

		// Array and map
		shouldAllEqual([
				'push([:])' : 'Call(Ident(push),[Map([],[])])',
				'push([])' : 'Call(Ident(push),[Array([])])',
				'[].length' : 'Dot(Array([]),length)',
				'[:].length' : 'Dot(Map([],[]),length)',
				'[[:]]': 'Array([Map([],[])])'
			])

		// New syntax
		shouldAllEqual([
				// 1. Variable Declarations (Space-separated types, no semicolons)
				'var x Int = 1' : 'Var(x,Type(Int),Int(1),false,false)',
				'let y String = "hello"' : 'Var(y,Type(String),String(hello),true,false)',

				// 2. Nullability and Unpacking
				'var z Int? = null' : 'Var(z,Optional(Type(Int)),Null,false,false)',

				// 3. Arrays and Maps (New syntax [T] and [K: V])
				'var arr [Int] = [1, 2]' : 'Var(arr,ParametricType(Array,[Type(Int)]),Array([Int(1),Int(2)]),false,false)',
				'var map [String: Int] = ["a": 1]' : 'Var(map,ParametricType(Map,[Type(String),Type(Int)]),Map([String(a)],[Int(1)]),false,false)',

				// 4. String Interpolation (Curly braces)

				// 5. Control Flow (If/Switch)

				// 6. Functions (Space separated args, return type after paren)
				// 7. Decorators
				'@inline fun foo() {}' : 'Decorator(inline,[],Function(foo,Block([]),[],null,false,false))',

				// 8. Object Literals (Structural typing)
				'var p = { x: 1, y: 2 }' : 'Var(p,null,Object([x,y],[Int(1),Int(2)]),false,false)'
			])

		// Space instead of colon
		shouldAllEqual([
				// Types parsing in variables with space instead of colon

				// Enumerations with space instead of colon

				// Constructor class fields with space instead of colon

				// External declarations with space instead of colon
			])

		// New syntax
		shouldAllEqual([
				// Nullability Operators
				'null!' : 'Unop(!,true,Null)',

				// Cascades (Object and Array)

				// Guard statement

				// Ternary Operator

				// Ranges

				// Multi-dimensional Array Indexing

				// Function Overloading

				// Loops and Array Comprehension

				// Regular Expressions

				// Postfix Await

				// Fluent Type Casts

				// Switch Expressions
			])

		// Decorators
		shouldAllEqual([
				'@local var a = 1' : 'Decorator(local,[],Var(a,null,Int(1),false,false))',
				'@tag(\'div\') fun f() {}' : 'Decorator(tag,[String(div)],Function(f,Block([]),[],null,false,false))',
				'@flagOnce("locked") fun f() {}' : 'Decorator(flagOnce,[String(locked)],Function(f,Block([]),[],null,false,false))'
			])

		// Readonly & Immutability modifiers
		shouldAllEqual([
			])

		// Destructuring & Spreads
		shouldAllEqual([
			])

		// Advanced Literals (BigInt, Complex, Raw/Tagged Strings)
		shouldAllEqual([
			])

		// Shorthands (If-let, Objects)
		shouldAllEqual([
			])

		// Meta methods & Preprocessor
		shouldAllEqual([
			])

		// JSX Support
		shouldAllEqual([
			])

		// Types (Interfaces, Traits, Const Generics)
		shouldAllEqual([
			])

		// Properties (Get/Set Blocks)
		shouldAllEqual([
			])

		// Readonly class fields
		shouldAllEqual([
			])

		// Implicit Generics (Type omission)
		shouldAllEqual([
			])

		// Old syntax (deprecated/removed features)
		shouldAllError([
				// Old String Interpolation
				// 'let s = "\\(v)"', // Legacy interpolation, replaced by `{v}`
				// 'let s = "val: \\(1 + 1)"',

				// Old Instantiation
				// 'var a = new T()', // `new` is no longer used at call sites
				// 'var a = new Array<Int>()',
				// 'let p = new Point { x: 1 }',

				// Old Type Annotations (Colons are explicitly forbidden)
				// 'var x: Int = 1',
				// 'let y: String',
				// 'fun foo(a: Int): Void {}',
				// 'class Point { var x: Int }',

				// Old Type Casting Operators
				// 'let a = b as! B', // Replaced by `b.as(B, 'throw')`
				// 'let a = b as? B', // Replaced by `b.as(B)`
				// 'let a = b is B', // `is` is now only for function overloading

				// Old Module/Import concepts
				// 'module a.b', // Replaced by implicit file modules
				'import * in "test"' // Replaced by `import Namespace { ... }`

				// Double logicals
				// 'if a && b {}', // Replaced by `and` or `,`
				// 'if a || b {}', // Replaced by `or`
				// 'if !a {}' // Replaced by `not a`
			])

		shouldAllError([
				// Property errors with space instead of colon
				'class A { var i Int { set (value) {} } }',
				'class A { var i Int { get {} set () {} } }',
				'class A { var i Int { get {} set {} } }',
				'class A { let i Int { get {} set (value) {} } }',
				'class A { let i Int { get {} set (value, val) {} } }',
				'class A { var i Int { get {} set (Value) {} } }',
				'class A { var i Int { get (value) {} set (value) {} } }',
				'class A { var i Int {} }'
			])

		shouldAllError([
				// Expressions & Assignments
				// 'a = b = c', // Chained assignment `Void` is not allowed NOTE this ok, should be allowed by parser?
				// 'a = b += c', // Compound chained assignment is not allowed
				// 'if a = b {}', // Assignment in `if` conditions to prevent typo bugs
				'a ??= b', // `??=` is deliberately omitted

				// Ternary Restrictions
				// 'a ? b : c ? d : e', // Nested ternary requires `()` parentheses

				// Increment Restrictions
				// '++a', // Prefix increment/decrement is omitted
				// '--a',
				'a++ ++', // Repeated postfix is not allowed

				// Guards Restrictions
				'guard a or b else {}', // `or` (double negatives) are not allowed natively in guard conditions

				// Loops & Switch syntax
				'case 1:', // Cases without `switch`
				'{ case 1: }' // Cases without `switch`
				// 'switch 0 { case 1: case 2: }' // Cases on the same line are omitted (requires `case 1 or 2:`)
				// 'do { a } while (b)', // `do-while` omits `()` parenthesis

				// Strings
				// 'let a = "Hello \(v)"' // Standard interpolation is `{v}` now, not `\(v)`
			])

		shouldAllError([
				// Old Syntax Rejections (if enforcing strict new syntax)
				// 'var x: Int = 1', // Colon not allowed in var decl

				// Invalid Nullability
				// 'var x Int = null', // Null assigned to non-nullable

				// Invalid Array/Map Syntax
				// 'var x Array<Int> = []', // If [Int] is preferred/enforced for literals
				// '[1, 2,]', // Trailing comma error if enforced strictly in this context (ref says trailing comma allowed in multi-line, but maybe not single line? Ref says "Trailing comma is allowed when the line ends with a newline")

				// `new T` is deprecated
				// 'new T()'
			])

		for fail in failMessages {
			console.log(fail)
		}

		let percent = Math.round((passed / overall) * 100)
		console.log("TestParser done \(percent)% (\(passed)/\(overall))")

		if failMessages.length > 0 {
			throw "TestParser failed \(overall - passed) tests"
		}
	}

	static var passed = 0
	static var overall = 0
	static var project Project = null // new Project() TODO
	static let failMessages: [String] = []

	//
	// Helpers
	//
	// TODO #region Helpers + require #end_region? or implicitly start next region

	/// Parses `input` into AST and stringifies, checks by trimmed `test`
	static fun shouldEqual(input: String, test: String) {
		let test = TestParser.deepTrim(test)
		shouldEqualWithoutTrim(input, test)
	}

	/// Same as `shouldEqual`, but does no trimming of `test`
	static fun shouldEqualWithoutTrim(input: String, test: String) {
		overall++
		try {
			var lexed = Lexer.tokenize(Buffer.from(input), "TEST")
			project = new Project()
			var parsed = Parser.toNode(Parser.parseNodes(lexed, project))
			var res = stringify(parsed)
			if test != res {
				failMessages.push('TestParser test fail: `\(renderInvisibleChars(input))`')
				failMessages.push('  Expect: `\(renderInvisibleChars(test))`')
				failMessages.push(quote('  Parsed: `\(renderInvisibleChars(res))`'))
				return
			}
		} catch e: Any {
			failMessages.push('TestParser test fail: `\(renderInvisibleChars(input))` failed to parse')
			failMessages.push('  Error: \(e.toString())')
			return
		}
		passed++
	}

	/// Operates `shouldEqual` on all key-value pairs of `input => test`
	static fun shouldAllEqual(map: [String : String]) {
		for input in map.keys() {
			var test = map.get(input)
			shouldEqual(input, test)
		}
	}

	/// Does `shouldEqual` without trimming `=> test` parts
	static fun shouldAllEqualWithoutTrim(map: [String : String]) {
		for input in map.keys() {
			var test = map.get(input)
			shouldEqualWithoutTrim(input, test)
		}
	}

	/// Input should fail to parse
	static fun shouldError(input: String) {
		overall++
		try {
			var lexed = Lexer.tokenize(Buffer.from(input), "TEST")
			project = new Project()
			var parser = Parser.toNode(Parser.parseNodes(lexed, project))
		}
		catch e: Any {
			passed++
			return
		}
		failMessages.push('TestParser test fail: `\(renderInvisibleChars(input))` did not throw exception.')
	}

	/// Every input should fail to parse
	static fun shouldAllError(input: [String]) {
		for str in input {
			shouldError(str)
		}
	}

	/// Removes all internal and trailing whitespace and newlines
	static fun deepTrim(s: String) {
		// TODO String.replaceAll
		return s.split('\n').join('').split('\r').join('').split('\t').join('').split(' ').join('')
	}

	/// Creates a testable consistent string representation of node
	static fun stringify(node: Node): String {
		if node == null {
			return 'null'
		}
		var res = stringifyInternal(node)
		let decorators = project.mapDecorators.get(node)
		if let decorators = decorators, decorators.length > 0 {
			for d in decorators {
				res = 'Decorator(' + d.name + ',[' + [for v in d.values stringify(v)].join(',') + '],' + res + ')'
			}
		}
		let leadingComments = project.leadingComments.get(node)
		if let leadingComments = leadingComments, leadingComments.length > 0 {
			for c in leadingComments {
				res = 'Doc(' + c.text + ',' + res + ')'
			}
		}
		return res
	}

	static fun stringifyInternal(node: Node): String {
		switch node {
			case null: return 'null'

				// Have no sub-nodes
			case String(s): return 'String(\(s))'
			case Ident(s, params): return 'Ident(\(s)' + ((params != null and params.length > 0) ? ',[' + [for p in params stringifyType(p)].join(',') + ']' : '') + ')'
			case Bool(b): return 'Bool(\(b))'
			case This: return 'This'
			case Super: return 'Super'
			case Int(s): return 'Int(\(s))'
			case MetaInt(n, kind): return 'MetaInt(\(n),\(Meta.stringify(kind)))'
			case Float(s, kind): return 'Float(\(s)' + ((kind != null and kind != Meta.Default) ? ',\(Meta.stringify(kind))' : '') + ')'
			case Null: return 'Null'
			case Break: return 'Break'
			case Continue: return 'Continue'
			case Underscore: return 'Wildcard'
			case Interval: return 'Interval'

				// Have sub-nodes
			case Is(expr, kind): return 'Is(' + stringify(expr) + ',' + stringifyType(kind) + ')'
			case As(expr, op, kind): return 'As(' + stringify(expr) + ',' + Token.stringify(op) + ',' + stringifyType(kind) + ')'
			case Binop(a, op, b): return 'Binop(' + stringify(a) + ',' + Token.stringify(op) + ',' + stringify(b) + ')'
			case AssignOp(a, op, b): return 'AssignOp(' + stringify(a) + ',' + Token.stringify(op) + ',' + stringify(b) + ')'
			case Block(els): return 'Block(' + stringifyNodeArray(els) + ')'
			case InlineStatements(els): return 'InlineStatements(' + stringifyNodeArray(els) + ')'
			case Var(name, t, expr, const, external):
				return 'Var(\(name),' + ((t != null) ? stringifyType(t) : "null") +
				"," + ((expr != null) ? stringify(expr) : "null") + ',\(const),\(external))'

			case Function(name, body, vars, retType, external, variadic):
				return 'Function(' + (name == null ? "null" : name) + ','
				+ stringify(body)
				+ "," + stringifyNodeArray(vars) + ',' + ((retType != null) ? stringifyType(retType) : "null") + ",\(external),\(variadic))"

			case Arrow(expr, vars, retType):
				return 'Arrow('
				+ (expr == null ? "null" : stringify(expr))
				+ "," + stringifyNodeArray(vars) + ',' + ((retType != null) ? stringifyType(retType) : "null") + ")"

			case Call(e, el, argNames):
				var res = 'Call(' + stringify(e) + ',['
				for i in el.length {
					res += (argNames[i] == null) ? "" : argNames[i] + ":"
					res += stringify(el[i]) + ((i != el.length - 1) ? "," : "")
				}
				return res + "])"

			case Parenthesis(e): return 'Parenthesis(' + stringify(e) + ')'
			case Return(e): return 'Return(' + stringify(e) + ')'
			case Throw(e): return 'Throw(' + stringify(e) + ')'
			case Enum(t, fields, valuesType, extend):
				return 'Enum(' + stringifyType(t) + ',' + stringifyNodeArray(fields) + ',' + (valuesType != null ? stringifyType(valuesType) : "null") + ',' + (extend != null ? stringifyType(extend) : "null") + ')'
			case Module(path, els):
				return "Module(" + path + "," + stringifyNodeArray(els) + ")"
			case ModuleExports(handle): return 'ModuleExports(...)'
			case Import(els, path):
				fun stringifyImportNode(node: ImportNode): String {
					switch node {
						case Lower(name): return 'Lower(\(name))'
						case Upper(name): return 'Upper(\(name))'
						case AllTheThings: return '*'
						case As(left, right): return stringifyImportNode(left) + '{as}' + stringifyImportNode(right)
					}
				}

				return "Import([" + [for p in els stringifyImportNode(p)].join(',') + "]," + path + ")"

			case Map(k, v): return 'Map([' + stringifyArray(k) + '],[' + stringifyArray(v) + '])'
			case Array(el): return 'Array(' + stringifyNodeArray(el) + ')'
			case Object(names, els): return 'Object([' + names.join(',') + '],' + stringifyNodeArray(els) + ')'

			case Class(t, extend, implement, fields, external, kind):
				var res = ClassKind.stringify(kind) + "(" + stringifyType(t) + ","
				res += ((extend != null) ? stringifyType(extend) : "null") + ","
				res += stringifyNodeTypeArray(implement) + ","
				res += stringifyNodeArray(fields) + ","
				res += external + ")"
				return res

			case New(path, t, args, names, values, argNames):
				return 'New([' + path.join('.') + '],' + stringifyType(t) + ',' + stringifyNodeArray(args) + ',[' + names.join(",") + "]," + stringifyNodeArray(values) + ",[" + argNames.join(',') + "])"

			case NodeTypeValue(t): return 'NodeTypeValue(' + stringifyType(t) + ")"
			case TypeAlias(alias, value): return 'TypeAlias(' + stringifyType(alias) + "," + stringifyType(value) + ")"
			case Dot(l, r): return "Dot(" + stringify(l) + "," + r + ")"
			case DotUpper(l, r): return "DotUpper(" + stringify(l) + "," + r + ")"

			case Private(expr): return 'Private(' + stringify(expr) + ')'
			case Static(expr): return 'Static(' + stringify(expr) + ')'
			case If(eCond, eif, eElse, ternary):
				return 'If(' + stringifyNodeArray(eCond) + ',' + stringify(eif) + ',' + stringify(eElse) + (ternary? ",ternary)": ")")
			case While(reason, body, pre): return 'While(' + stringify(reason) + ',' + stringify(body) + ',\(pre))'
			case For(iterator, over, statement, range): return 'For(\(iterator),' + stringify(over) + ',' + stringify(statement) + ',' + stringify(range) + ')'
			case Index(expr, index): return 'Index(' + stringify(expr) + ',' + stringify(index) + ')'
			case Switch(inputs, expressions, guards, patterns):
				return 'Switch(' + stringifyNodeArray(inputs) + ',' + stringifyNodeArray(expressions) + ',' + stringifyNodeArray(guards) + ',' + stringifyNodeArray(patterns) + ')'
			case Property(field, getter, setter): return 'Property(' + stringify(field) + ',' + stringify(getter) + ',' + stringify(setter) + ')'
			case Try(expr, types, values, catches): return 'Try(' + stringify(expr) + ',' + stringifyNodeTypeArray(types) + ',' + stringifyNodeArray(values) + ',' + stringifyNodeArray(catches) + ')'
			case EnumExtract(path, bind, expr): return 'EnumExtract([' + path.join('.') + '],' + stringifyNodeArray(bind) + ',' + stringify(expr) + ')'
			case Elvis(nullable, alternative): return 'Elvis(' + stringify(nullable) + ',' + stringify(alternative) + ')'
			case EnumConstructor: return 'EnumConstructor'
			case EnumPattern: return 'EnumPattern'
			case Unop(op, postfix, e): return 'Unop(' + Token.stringify(op) + ',' + postfix + ',' + stringify(e) + ')'
		}

		return '<!--stringify-->'
	}

	static fun stringifyArray(nodes: [Node]): String {
		// TODO drop `[for in]` syntax
		return [for node in nodes stringify(node)].join(',')
	}

	static fun stringifyNodeArray(arr: [Node]) {
		return "[" + stringifyArray(arr) + "]"
	}

	static fun stringifyNodeTypeArray(arr: [NodeType]) {
		return "[" + [for e in arr stringifyType(e)].join(',') + "]"
	}

	/// Creates a testable consistent string representation of type
	static fun stringifyType(node: NodeType): String {
		if node == null {
			return 'null'
		}
		var res = stringifyTypeInternal(node)
		let decorators = project.typeDecorators.get(node)
		if let decorators = decorators, decorators.length > 0 {
			for d in decorators {
				res = 'Decorator(' + d.name + ',[' + [for v in d.values stringify(v)].join(',') + '],' + res + ')'
			}
		}
		}
		return res
	}

	static fun stringifyTypeInternal(node: NodeType): String {
		switch node {
			case Type(name, path): return 'Type(\(name)' + (path != null ? ',\(path)' : '') + ')'
			case ParametricType(name, params, path): return 'ParametricType(\(name),[' + [for p in params stringifyType(p)].join(',') + ']' + (path != null ? ',\(path)' : '') + ')'
			case Function(args, retType): return 'Function([' + [for e in args stringifyType(e)].join(',') + "]," + stringifyType(retType) + ')'
			case Object(names, types): return 'Object([' + names.join(',') + "],[" + [for e in types stringifyType(e)].join(',') + "])"
			case FunctionArg(name, kind, defaultValue): return 'FunctionArg(\(name),' + stringifyType(kind) + (defaultValue != null ? ',' + stringify(defaultValue) : '') + ')'
			case Optional(kind): return 'Optional(' + stringifyType(kind) + ')'
			case Ident(name): return 'Ident(\(name))'
			case Int(value): return 'Int(\(value))'
			case Float(value): return 'Float(\(value))'
			case String(value): return 'String(\(value))'
			case Call(name, argNames, values):
				return 'Call(\(name),[' + argNames.join(',') + '],[' + [for v in values stringifyType(v)].join(',') + '])'
			case null: return 'null'
		}

		return '<!--stringifyType-->'
	}

	/// Fix invisible chars like \t\r\n for readable error messages
	static fun renderInvisibleChars(input: String): String {
		return input
		.split('\r').join('\\r')
		.split('\n').join('\\n')
		.split('\t').join('\\t')
	}
}
