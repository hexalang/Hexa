/// Represents different types of comments in source code TODO
/*enum CommentKind {
	/// Single-line comment starting with //
	Line
	/// Multi-line comment between /* and */
	Block
	/// Documentation comment starting with ///
	Documentation
}*/

/// Stores information about a comment in source code
class Comment {
	/// The kind of comment (line, block, or doc)
	// var kind: CommentKind NOTE only /// doc comments supported
	/// The actual text content of the comment
	var text: String
	/// Line number where the comment appears
	var line: Int
	/// Column number where the comment starts
	var column: Int
	/// True if this is a trailing comment (appears after an expression)
	//var isTrailing: Bool

	new (text, line, column) {
		//this.kind = kind
		this.text = text
		this.line = line
		this.column = column
		//this.isTrailing = isTrailing
	}
}
