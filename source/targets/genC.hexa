/// Generates C with C++ compatibility
/// Some features require C11
// TODO extends Generator .features(): GeneratorFeatures
class GenCxx {
	static fun spawn() {
		return new GenCxx()
	}

	static fun spawnCpp() {
		let result = new GenCxx()
		result.cpp = true
		return result
	}

	new () {
		// Fields are initialized at declarations
	}

	// TODO !!! to speed up C++ compile do `typedef hexa<SomeType> $SomeType;`

	// TODO no name no error: fun (){}
	// TODO no body no error: fun x()
	// fun()

	fun perform(normalizer, target: String, options: [String]): String {
		project = normalizer
		extraUnderscore = options.includes('extraUnderscore')
		// TODO report unsupported options
		return stringify(target)
	}

	/// On x64 it is always fast call,
	/// but on Win32 i686 we should use std call
	var defaultCallingConvention = '__conventionName '
	/// C++ generator
	var cpp Bool = false
	/// Quick access
	var memory64 = true
	let nativeIterators = false
	let globalAccessor = ''
	var project: NiceProject
	var declarationsOfFunctions: [String] = []
	var declarationsOfOpaqueTypes: [String] = []
	var declarationsOfFullTypes: [String] = []
	/// Mapping of original strings (optimization)
	var declarationsOfStringsMap: [String : Int] = [:]
	var declarationsOfStrings: [String] = []
	/// Function-type signature -> typedef name (`_$N`) so repeated
	/// `stringifyType` calls return STABLE names (mangled generic names like
	/// `Array<_$N>` depend on it) and identical types emit one typedef
	var typedefFunctionsMap: [String : String] = [:]
	/// Inline-structure signature -> minted `Struct_N_*` name (see
	/// `stringifyType` `Struct` case)
	var structDefsMap: [String : String] = [:]
	/// Minted inline-structure BODIES (`struct Struct_N_ { ... };` — must be
	/// emitted as one block BEFORE the Types section: minting happens lazily
	/// during `stringifyType`, so pushing bodies into `types` interleaves them
	/// INTO the class currently being printed (nested `Outer_::Struct_N_`,
	/// C2027 at use sites). Forwards live in `structDefsForward`
	let structDefs: [String] = []
	/// Declared type per GLOBAL base name — the Nice type of a USE node can
	/// lie about the C value (the typer coerces `Any` uses to `Int` etc), so
	/// operand classification and conversions key on the DECLARED type of
	/// what is actually printed (see `cShape`/`valueType`)
	var globalDecls: [String : Type] = [:]
	/// F9: mangled `Promise_X_` struct names seen via `stringifyType`
	/// (deduped) — after Types, emit per-`X` `operator co_await` + `promise_type`
	/// + `coroutine_traits` in one inner `extern "C++"` block (needs complete
	/// structs for `sizeof`, and must precede async funs using them).
	var promiseStructs: [String] = []
	/// F10.3: Nice names (`closure$N`) of lifted closures whose `$call_`
	/// thunks were emitted (dead code until dynamic calls wire them) — after
	/// Types, emit the `{impl, call}` registry the pair dispatch looks up.
	var fatPairImpls: [String] = []
	/// Declared type per LOCAL/param base name of the function being printed
	/// (cleared at each function signature — see `printFunctionArguments`)
	var localDecls: [String : Type] = [:]
	/// C-void callees (Nice claims non-void like `Promise`/`Any` while the
	/// emitted C returns `void` — `async fun` without `return`). Pre-scanned
	/// from declared returns; `valueType(Call)` reports these as `Void` so
	/// the existing `Void → T` comma-sequence bridge fires in every value
	/// context (Var/Assign/Return/args) with no Call-site duplication.
	var voidFuncs: [String : Bool] = [:]
	var voidFuncsBuilt Bool = false
	/// True when the declared C return is `void`
	fun isVoidReturnType(funcType: Type): Bool { switch funcType {
			case Function(_, returns):
				return stringifyType(returns) == 'void'
			case _:
				return false
		} }
	/// Fill `voidFuncs` once per emit (globals + methods, bare + qualified)
	fun buildVoidFuncs() {
		if voidFuncsBuilt {
			return
		}
		voidFuncsBuilt = true
		for g in project.globalFuncs { switch g {
			case Function(gname, _, _, _, funcType, _, _):
				if isVoidReturnType(funcType) {
					voidFuncs.set(gname, true)
				}
			case _:
		} }
		for c in project.classes {
			for m in c.methods { switch m {
				case Function(mname, _, _, _, funcType, _, _):
					if isVoidReturnType(funcType) {
						voidFuncs.set(mname, true)
						voidFuncs.set(c.name + '_$' + mname, true)
					}
				case _:
			} }

		for c in project.classes {
			for m in c.methods { switch m {
					case Function(mname, _, _, _, funcType, _, _):
						if isVoidReturnType(funcType) {
							voidFuncs.set(mname, true)
							voidFuncs.set(c.name + '_$' + mname, true)
						}
					case _:
				} }

			for m in c.staticMethods { switch m {
					case Function(mname, _, _, _, funcType, _, _):
						if isVoidReturnType(funcType) {
							voidFuncs.set(mname, true)
							voidFuncs.set(c.name + '_$' + mname, true)
						}
					case _:
				} }
		}
	}
	/// True when the callee emits C `void` (declared return, not Nice result)
	fun isVoidCallee(e: Expression): Bool { switch e {
			case Ident(name, _):
				return voidFuncs.get(name) == true
			case Dot(_, name, _):
				return voidFuncs.get(name) == true
			case Parenthesis(inner):
				return isVoidCallee(inner)
			case _:
				return false
		} }
	/// Forward declarations for the minted inline structures (`forward` is
	/// local to `stringify` and flushes these before assembly)
	let structDefsForward: [String] = []
	let forwardFunctions: [String] = []
	let typedefFunctions: [String] = []
	let globalVariables: [String] = []
	let globalFunctions: [String] = []
	// ARC destroy registry rows (tag + destroy fn + size), one per class
	// declaring `@destructor`. Read by the future F11 sweep via the lookup
	// below; backends never consult it today.
	let destroyTable: [String] = []
	// Vtable-managed class names (every class that actually emits a `__$`
	// tag global), for the sweep victim-name table. Collected at vtable
	// emission so the table can only reference symbols that exist.
	let vtableClasses: [String] = []
	// Vtable-managed container class names (destroyKind 1/2 arrays) for the
	// sweep bisect: `hexaArrayTags_` lets `HEXA_SWEEP_MODE=2` skip exactly
	// the array-element unref cascade while freeing everything else.
	let arrayDestroyTags: [String] = []
	let types: [String] = []
	let dllExports: [String] = []
	// TODO Docs
	/// Sets `__link` prefix for `_link` names
	/// Workaround for LLVM 32-bit linker
	var extraUnderscore = false

	fun stringify(target: String) {
		// Configure
		if project.memory == Memory.Modern64 {
			// No space
			defaultCallingConvention = ''
		} else {
			// With space
			// TODO probably should be only on Win32 platform
			// Note this is used for all of Win32 API and COM interfaces anyway
			// thus we default to this calling convention
			defaultCallingConvention = '__stdcall '
			memory64 = false
		}

		// Contains forward declarations
		let header = ['// Generated by Hexa \(version) https://hexalang.github.io']

		if project.package.addLicenseNoticeToOutput {
			// rename `addLicenseNoticeToOutput` TODO what this comment means?
			header.push('// Project: \(project.package.name)')
			header.push('// LICENSE \(project.package.license)')
		} else {
			header.push('// The generated code is subject to the original license')
		}

		header.push(Fs.readFileSync(__dirname + '/library/cxx/hexa.c').toString('utf8').split('\r\n').join('\n'))
		header.push('#ifdef __cplusplus')
		header.push('extern "C" \{')
		header.push('#endif')
		// virtual abstract $unref();
		// virtual abstract $ref();

		// TODO copy hexa.cpp to output folder if not exists (updates??)
		// create hexa.cpp in library/cpp ^
		// ^ just copy into output file
		// header.push('#include "hexa.cpp"')

		let out: [String] = []
		// out.push(header.join('\n'))
		// TODO how to parse without double dots? String[] like dlang/ts V[K]
		let forward: [String] = []

		// Strings
		registerString('') // id == 0
		declarationsOfStringsMap.set('', 0)
		registerString('null') // id == 1
		declarationsOfStringsMap.set('null', 1)

		// Register declared types of globals upfront — expression printing
		// (class methods etc.) may reference them before the GlobalVariables
		// section is assembled, and `cShape` needs the DECLARED C shape
		for g in project.globalVars {
			switch g {
				case Var(name, expr, dataType):
					globalDecls.set(name, dataType)
				case Const(name, expr, dataType):
					globalDecls.set(name, dataType)
			}
		}

		// D2 sentinel env for null-fat values (see Global variables section).
		// Typed `Any` so pair assembly bridges via `(size_t)` (void* value).
		globalDecls.set('hexaSentinelEnv', project.typer.typeAny)
		buildVoidFuncs()

		// Types
		// TODO use _HEX16GUID_ClassName_ instead of _mangledNameSpace_ClassName_!
		// ^ and save this String to class definition for cache in normalizer
		// cause JS will use it too for now
		for e in project.enumsSimple {
			// No need to output simple enum values
			// TODO proper base type
			forward.push('struct ' + e.name + '_;')

			if e.staticVars.length + e.staticMethods.length == 0 {
				continue
			}

			// TODO tdef C* C
			// TODO this seem to be a leftover from C++
			types.push('struct ' + e.name + '_ \{\n\t')

			// Static vars before static functions
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + e.name + '_$' + name + '_;\n')
						// if (expr != null) out.push(' = ' + printExpression(expr))
					case Const(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + e.name + '_$' + name + '_;\n')
						// out.push(' = ' + printExpression(expr))
				} }

				// for (v in e.staticMethods) switch v {
				// case Function(name, expr, args, defaults, funcType):
				// types.push('\n\tstatic ')
				// types.push(printFunctionReturnType(funcType))
				// types.push(' ' + name + '_')
				// types.push(printFunctionArguments(args, funcType, true))
				// types.push(';')
				// }
			types.push('\n\};\n')

			for v in e.staticMethods { switch v {
					case Function(name, expr, args, defaults, funcType, _, isAsync):
						forwardFunctions.push(printFunctionReturnType(funcType))
						forwardFunctions.push(' ' + e.name + '_$' + name + '_')
						forwardFunctions.push(printFunctionArguments(args, funcType))
						forwardFunctions.push(';\n')

						// TODO cache `printFunctionReturnType` here etc to not print twice
						out.push(printFunctionReturnType(funcType))
						out.push(' ' + e.name + '_$' + name + '_')
						out.push(printFunctionArguments(args, funcType))
						let _currentReturnType = currentReturnType
						currentReturnType = getFunctionReturnType(funcType)
						out.push(' ' + printBlock(expr) + ';\n\n')
						// out.push(' {};\n')
						currentReturnType = _currentReturnType
				} }
		}

		for e in project.enumsComplex {
			forward.push('struct ' + e.name + '_;')
			types.push(e.name + '_ : Unknown_ \{\n\t')
			types.push('\n\tAny_** enum_;') // Enum.Name(enum_...)
			types.push('\n\tuint16_t is_;')
			types.push('\n\tuint8_t length_;') // Amount of enum_[] to dealloc

			var i = 0

			for name in e.names {
				if e.constructors[i] != null {
					// types.push('\n\tstatic ' + e.name + '_* ' + name + '_(')
					////types.push([for (c in e.constructors[i]) 'Any_* ' + c + '_'].join(', '))
					// types.push([for (c in e.constructors[i].length)
					// stringifyType(e.constructorsTypes[i][c]) + ' ' + e.constructors[i][c] + '_'
					// ].join(', '))
					// types.push(');')

					out.push(e.name + '_* ' + e.name + '_$' + name + '_(')
					// out.push([for (c in e.constructors[i]) 'Any_* ' + c + '_'].join(', '))
					out.push([for c in e.constructors[i].length
							stringifyType(e.constructorsTypes[i][c]) + ' ' + e.constructors[i][c] + '_'
						].join(', '))
					out.push(') \{\n')
					// out.push('\tprintf("\(e.name).\(name)_()\\n");fflush(stdout);\n')
					out.push('\t' + e.name + '_* _ = (' + e.name + '_*)(HEXA_NEW(sizeof(' + e.name + '_)));\n')
					out.push('\t_->length_ = \(e.constructors[i].length);\n')
					out.push('\t_->enum_ = (Any_**)(HEXA_NEW(sizeof(Any_*) * \(e.constructors[i].length)));\n')
					out.push('\t_->is_ = \(i);\n')

					for c in e.constructors[i].length {
						// out.push('\t_->enum_[\(c)] = \(e.constructors[i][c])_;\n')
						out.push('\t_->enum_[\(c)] = ')
						// out.push(printTypeConverter(e.constructors[i][c] + '_', e.constructorsTypes[i][c], project.typer.typeAny))
						out.push(printToAnyConverter(e.constructors[i][c] + '_', e.constructorsTypes[i][c]))
						out.push(';\n')
					}
					out.push('\treturn _;\n')
					out.push('\};\n')
				} else {
					// types.push('\n\tstatic ' + e.name + '_* ' + name + '_();')

					out.push(e.name + '_* ' + e.name + '_$' + name + '_() \{\n')
					// out.push('\tprintf("\(e.name).\(name)_()\\n");fflush(stdout);\n')
					out.push('\t' + e.name + '_* _ = (' + e.name + '_*)(HEXA_NEW(sizeof(' + e.name + '_)));\n')
					out.push('\t_->length_ = 0;\n')
					out.push('\t_->is_ = \(i);\n')
					out.push('\treturn _;\n')
					out.push('\};\n')
				}
				i++
			}

			// Static vars before static functions
			// TODO is = printed?
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + e.name + '_$' + name + '_;\n')
						// if (expr != null) out.push(' = ' + printExpression(expr))
					case Const(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + e.name + '_$' + name + '_;\n')
						// out.push(' = ' + printExpression(expr))
				} }

			for v in e.staticMethods { switch v {
						// types.push('\n\tstatic ')
					case Function(name, expr, args, defaults, funcType, _, isAsync):
						// types.push(printFunctionReturnType(funcType))
						// types.push(' ' + name + '_')
						// types.push(printFunctionArguments(args, funcType, true))
						// types.push(';')

						forwardFunctions.push(printFunctionReturnType(funcType))
						forwardFunctions.push(' ' + e.name + '_$' + name + '_')
						forwardFunctions.push(printFunctionArguments(args, funcType))
						forwardFunctions.push(';\n')

						out.push(printFunctionReturnType(funcType))
						out.push(' ' + e.name + '_$' + name + '_')
						out.push(printFunctionArguments(args, funcType))

						let _currentReturnType = currentReturnType
						currentReturnType = getFunctionReturnType(funcType)
						// out.push(' {};\n')
						out.push(' ' + printBlock(expr) + ';\n\n')
						currentReturnType = _currentReturnType
				} }
			types.push('\n\};\n')
		}

		// TODO get rid of this workaround
		let duplicates: [String] = []
		// TODO this syntax `let duplicates = String []`
		for c in project.classes {
			// `super(...)` resolves to the currently-printed class' parent
			currentSuperType = c.extend

			if c.external {
				// TODO rename to just 'require'
				if c.jsRequire != null {
					// `@require('#include <...>')`
					forward.push(c.jsRequire)
				}
				// TODO rename to just 'rename'
				if let jsNative = c.jsNative, jsNative != c.name {
					forward.push('#define ' + c.name + ' ' + jsNative)
				}

				// Host/FFI-mapped externals are done here — everything else is
				// a plain Hexa-shaped data type (`declare class` with fields,
				// e.g. the tool argument records) and falls through to NORMAL
				// emission: its fields get accessed and C needs the definition.
				// Builtin-mapped shapes (`ByValue<Int>` → `int32_t`,
				// `ArrayByValue<T, N>` → `T[N]`) name real C types already
				if c.jsRequire != null or c.jsNative != null {
					continue
				}

				if not stringifyType(c.classType).endsWith('_*') {
					continue
				}
			}
			// if (c.name == 'String') {
			// continue
			// }
			// `Any` maps onto the runtime `struct Any_` and `Bool` onto the
			// `Bool_` macro — matched by TYPE name so a scope-unique rename
			// of the nice class name cannot miss them
			var builtinName = c.name

			switch c.classType {
				case Class(kind):
					builtinName = kind.name
				case _:
			}

			if builtinName == 'Any' {
				// forward.push('#define Any_ Unknown_')
				continue
			}
			// TODO better idea
			if builtinName == 'Bool' {
				continue
			}

			if c.useless {
				// console.log('useless', c.name)
				// TODO continue
			}

			if c.template {
				//
				console.log('template', c.name)

				// Template classes keep only their static members, emitted
				// under the template name: generic class STATIC calls print
				// as `Promise_$resolve_` and static signatures erase generic
				// stubs to `Any_*` (see `stringifyType` `Generic` case)
				for v in c.staticVars { switch v {
						case Var(name, expr, dataType):
							globalVariables.push('\(stringifyType(dataType)) ' + c.name + '_$' + name + '_;\n')
						case Const(name, expr, dataType):
							globalVariables.push('\(stringifyType(dataType)) ' + c.name + '_$' + name + '_;\n')
					} }

				for v in c.staticMethods { switch v {
						case Function(name, expr, args, defaults, funcType, variadic, isAsync):
							forwardFunctions.push(linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
							forwardFunctions.push(' ' + c.name + '_$' + name + '_')
							forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
							forwardFunctions.push(';\n')

							out.push(linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
							out.push(' ' + c.name + '_$' + name + '_')
							out.push(printFunctionArguments(args, funcType, variadic))
							let _currentReturnType = currentReturnType
							currentReturnType = getFunctionReturnType(funcType)
							let _insideAsyncFunction = insideAsyncFunction
							insideAsyncFunction = isAsync
							out.push(' ' + (isAsync? printFunctionBody(expr, printFunctionReturnType(funcType)) : printBlock(expr)) + ';\n\n')
							insideAsyncFunction = _insideAsyncFunction
							currentReturnType = _currentReturnType
					} }

				continue
			}

			let n = c.name + '_*'
			// TODO better way
			c.name = stringifyType(c.classType).replace('_*', '')
			// NOTE class NAMES come from the class type itself —
			// `stringifyType` erases bare generic classes to `Any_*` which
			// must not become the emitted struct name
			var cName = ''

			switch c.classType {
				case Class(kind):
					cName = kind.name
				case _:
					cName = stringifyType(c.classType).replace('_*', '')
			}

			c.name = cName

			if c.name == 'Array' {
				// console.log(c.dataType)
			}

			if c.name.startsWith('IMAGE_THUNK_DATA')
			{
				// console.log('###', c)
				// console.log(c.name, type.parent, atts)
			}

			if c.name.startsWith('IMAGE_IMPORT_BY_NAME')
			{
				// console.log(c)
				// console.log(c)
				// console.log(c.name, type.parent, atts)
			}

			var isStruct = false
			var isUnion = false
			var isPacked = false
			switch c.classType {
				// TODO `case Class(type) or ClassInstance(type): {`
				case Class(kind): {
						let atts = project.mapDecorators.get(kind.parent)
						// if kind.name == 'IMAGE_THUNK_DATA'

						/*if c.name.startsWith('IMAGE_THUNK_DATA')
						{
							console.log('$$$', c.name, kind.parent, atts)
						}*/
						isStruct = Decorator.getDecorator(atts, 'struct') != null
						isUnion = Decorator.getDecorator(atts, 'union') != null
						isPacked = Decorator.getDecorator(atts, 'packed') != null
					}
					// TODO should be a Class, not Instance
				case ClassInstance(kind): {
						let atts = project.mapDecorators.get(kind.parent)
						// if kind.name == 'IMAGE_THUNK_DATA'

						/*if c.name.startsWith('IMAGE_THUNK_DATA')
						{
							console.log('$$$', c.name, kind.parent, atts)
						}*/
						isStruct = Decorator.getDecorator(atts, 'struct') != null
						isUnion = Decorator.getDecorator(atts, 'union') != null
						isPacked = Decorator.getDecorator(atts, 'packed') != null
					}
			}

			let nativeKind = isUnion? 'union ' : 'struct '

			let forwardedAs = nativeKind + c.name + '_;'

			if duplicates.includes(forwardedAs) {
				console.log('duplicate', forwardedAs)
				continue
			}
			duplicates.push(forwardedAs)

			forward.push(forwardedAs)
			// console.log('@@@ struct ' + c.name + '_;')
			forward.push('typedef \(nativeKind)\(c.name)_ \(c.name)_;')

			if isPacked {
				types.push('#pragma pack(1)\n')
			}

			types.push(nativeKind + c.name + '_ \{\n\t')
			let vtable = ['struct ' + c.name + '__ \{\n\t']
			// TODO const pointer to const struct
			if isStruct or c.api == ClassBinaryInterface.StructureNoVirtual {
				// Ok
			} else {
				types.push('\n\tconst struct ' + c.name + '__ * const _;')
				// ARC header (D6): every vtable-managed instance starts with
				// `(_, rc)`. Structs keep their exact C ABI (no header).
				types.push('\n\tint32_t rc_;')
			}
			let vtableValue = ['const struct ' + c.name + '__ ' + c.name + '__$ = \{\n\t']
			let vtableBind = []
			// ARC destroy-table row (F11 sweep reads it): vtable identity,
			// destroy fn (the `@destructor` method), instance size.
			if let dd = c.destructor {
				let openBrace = String.fromCharCode(123)
				let closeBrace = String.fromCharCode(125)
				destroyTable.push(openBrace + ' (const void*)&' + c.name + '__$, (void(*)(void*))' + c.name + '_$' + dd + '_, sizeof(' + c.name + '_)' + closeBrace)
			}

					// Synthesized container destroys (F11.2, ARC-marked): see
					// NiceClass.destroyKind. Skipped when a user @destructor
					// owns the slot. Additive dead code until the sweep lands.
					if c.destructor == null {
						if c.destroyKind == 1 {
							let dn = c.name + '_$destroyARC_'
							forwardFunctions.push('void ' + dn + '(void*)')
							forwardFunctions.push(';\n')
							out.push('void ' + dn + '(void* p_) \{\n')
							out.push('\t' + c.name + '_* a_ = (' + c.name + '_*)p_;\n')
						out.push('\tfor (int32_t i_ = 0; i_ < a_->length_; i_++) hexaUnref(a_->data_[i_]);\n')
						out.push('\tHEXA_FREE(a_->data_, sizeof(void*) * (size_t)a_->capacity_);\n')
						out.push('\};\n\n')
						let ob = String.fromCharCode(123)
						let cb = String.fromCharCode(125)
						destroyTable.push(ob + ' (const void*)&' + c.name + '__$, (void(*)(void*))' + dn + ', sizeof(' + c.name + '_)' + cb)
						arrayDestroyTags.push(c.name)
						}
						if c.destroyKind == 2 {
							let dn = c.name + '_$destroyARC_'
							forwardFunctions.push('void ' + dn + '(void*)')
							forwardFunctions.push(';\n')
							out.push('void ' + dn + '(void* p_) \{\n')
						out.push('\t' + c.name + '_* a_ = (' + c.name + '_*)p_;\n')
						out.push('\tHEXA_FREE(a_->data_, sizeof(void*) * (size_t)a_->capacity_);\n')
						out.push('\};\n\n')
						let ob = String.fromCharCode(123)
						let cb = String.fromCharCode(125)
						destroyTable.push(ob + ' (const void*)&' + c.name + '__$, (void(*)(void*))' + dn + ', sizeof(' + c.name + '_)' + cb)
						arrayDestroyTags.push(c.name)
						}
						if c.destroyKind == 3 {
							let dn = c.name + '_$destroyARC_'
							forwardFunctions.push('void ' + dn + '(void*)')
							forwardFunctions.push(';\n')
							out.push('void ' + dn + '(void* p_) \{\n')
							out.push('\t' + c.name + '_* m_ = (' + c.name + '_*)p_;\n')
							out.push('\thexaUnref(m_->key_);\n')
							out.push('\thexaUnref(m_->value_);\n')
							out.push('\};\n\n')
							let ob = String.fromCharCode(123)
							let cb = String.fromCharCode(125)
							destroyTable.push(ob + ' (const void*)&' + c.name + '__$, (void(*)(void*))' + dn + ', sizeof(' + c.name + '_)' + cb)
						}
					}

			// TODO `for i : v in`
			var vi = -1

			for v in c.vars {
				vi++

				switch v {
					case Var(name, expr, dataType):
						if let bits = c.varBits[vi] {
							types.push('\n\t\(stringifyType(dataType)) ' + name + '_')
							types.push(' : ' + bits)
							types.push(';') // TODO probably must be a single `types.push` if bit-arrays-by-value are supported in C
						} else if isFatValueType(dataType) {
							// S3b F1.6: function-typed fields double up
							// (`name$f_` + `void* name$e_`, D1) from the type alone.
							types.push('\n\t\(stringifyType(dataType)) ' + name + '$f_;')
							types.push('\n\tvoid* ' + name + '$e_;')
						} else {
							types.push('\n\t\(stringifyType(dataType)) ' + name + '_;')
						}

						switch dataType {
							case ClassInstance(kind, generics): {
									if kind.name == 'ArrayByValue' {
										var arraySize = ''

										if let count = generics[1] {
											arraySize = '[' + Type.stringify(count) + ']'
										} else {
											arraySize = '[]'
										}

										types.pop() // TODO better idea
										types.push('\n\t\(stringifyType(generics[0])) ' + name + '_' + arraySize + ';')
									}
								}
						}
						// else
						// types.push('\n\tAny_* ' + name + '_;')
						// if (expr != null)
						// out.push('\n\t\t\tthis.' + name + ' = ' + printExpression(expr) + '')
					case Const(name, expr, dataType):
						// S3b F1.6: `let`-bound function-typed fields double up too.
						if isFatValueType(dataType) {
							types.push('\n\t\(stringifyType(dataType)) ' + name + '$f_;')
							types.push('\n\tvoid* ' + name + '$e_;')
						} else {
							types.push('\n\t\(stringifyType(dataType)) ' + name + '_;')
						}

						/*let name = switch c.dataType {
							case ClassInstance(c):
								//c.fieldRenames.includes(name)? name : name + '_'
								let rename = c.fieldRenames[c.fieldNames.indexOf(name)]
								if rename != null {
									if name == 'key' {
										console.log('~~~~~', name, rename)
									}
									rename
								}

								name
							case _: name
												}*/
						// (S3b: the single push moved into the if/else above.)
						// else
						// types.push('\n\tAny_* ' + name + '_;')
						// if (expr != null) // null if property
						// out.push('\n\t\t\tthis.' + name + ' = ' + printExpression(expr) + '')
				}
			}

			// if c.vars.length == 0 {
			//
			// // TODO remove
			// types.push('\n\t\(stringifyType(type)) ' + name + '_;')
			// }

			// if (c.name == 'String') types.push('String_op')
			// Empty struct has size 0 in C, size 1 in C++
			var nonEmptyTable = false
			var hasToString = false

			for v in c.methods { switch v {
					case Function(name, expr, args, defaults, funcType, variadic, isAsync):
						hasToString = hasToString or name == 'toString'

						if (name == null or name == 'new') {
							// types.push('\n\t' + c.name + '_() {};') // For placement new
							// types.push('\n\tvoid this_')
							// types.push(printFunctionArguments(args, funcType, true))
							// types.push(';')
							// //types.push('\n\tstatic ' + c.name + '_* new_();')
							// forward.push('\n\tstatic ' + c.name + '_* new_')
							// forward.push(printFunctionArguments(args, funcType))
							// forward.push(';')
							forwardFunctions.push(c.name + '_* ' + c.name + '_$new_')
							forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
							forwardFunctions.push(';\n')
							// TODO cache printFunctionArguments to local var here

							// Init
							// out.push('void ' + c.name + '_::this_() \{\n')
							out.push(c.name + '_* ' + c.name + '_$this_')
							thisArgument = c.name + '_* $this'
							out.push(printFunctionArguments(args, funcType, variadic))
							thisArgument = null
							out.push(' \{\n')
							// TODO cache own vtable on function enter
							// out.push('\t$this->_ = &' + c.name + '__$;\n')

							// Init fields
							customThis = '$this'

							for v in c.vars { switch v {
									case Var(name, expr, dataType):
										if expr != null {
											// TODO `isArrayByValue` helper
											var isArrayByValue = false
											switch dataType {
												case ClassInstance(kind):
													if kind.name == 'ArrayByValue' {
														// TODO support `array = [...]` assignments everywhere cause C doesn't
														isArrayByValue = true
													}
											}

											if not isArrayByValue {
												// S3b F1.6: function-typed fields init BOTH halves.
												// `Any` sources bridge via `fatPtrAs` (M1 compiles).
												if isFatValueType(dataType) {
													out.push('\t$this->' + name + '$f_ = ' + fatPtrAs(expr, dataType) + ';' + '
')
													out.push('\t$this->' + name + '$e_ = ' + fatEnvStr(expr) + ';' + '
')
												} else {
													out.push('\t$this->' + name + '_ = ' + printInitializer(dataType, expr) + ';' + '
')
												}
											} else {
												// TODO
											}
										}
									case Const(name, expr, dataType):
										if expr != null {
											// S3b F1.6: `let`-bound function-typed fields init BOTH halves.
											// `Any` sources bridge via `fatPtrAs` (M1 compiles).
											if isFatValueType(dataType) {
												out.push('\t$this->' + name + '$f_ = ' + fatPtrAs(expr, dataType) + ';' + '
')
												out.push('\t$this->' + name + '$e_ = ' + fatEnvStr(expr) + ';' + '
')
											} else {
												out.push('\t$this->' + name + '_ = ' + printInitializer(dataType, expr) + ';' + '
')
											}
										}
								} }
							pushTab()

							switch expr {
								// TODO pattern match as `[...head]` or `[head, ...tail]`
								// ^ and optimize to no-saving-to-bind cause bound var not used later
								case Block(el): if el.length > 0 {
										out.push('\t' + printBlock(expr) + ';\n')
									}
								case null:
									// Body-less constructor (`declare class`) —
									// fields stay zeroed by `HEXA_NEW`
								case _:
									out.push('\t' + printBlock(expr) + ';\n')
							}
							popTab()
							customThis = null
							out.push('\n\treturn $this;\n')
							out.push('\};\n\n')

							// Alloc
							// out.push(c.name + '_* ' + c.name + '_$new_() \{\n')
							out.push(c.name + '_* ' + c.name + '_$new_')
							out.push(printFunctionArguments(args, funcType, variadic))
							out.push(' \{\n')
							// out.push('\tprintf("\(c.name).new_()\\n");fflush(stdout);\n')
							out.push('\tvoid** $_ = (void**)(HEXA_NEW(sizeof(' + c.name + '_)));\n')
							// TODO why so complicated? Just assign `_` v table pointer, makes also type-safer
							if c.api == ClassBinaryInterface.StructureNoVirtual {
							} else {
								out.push('\t$_[0] = (void *)&' + c.name + '__$;\n')
							}
							out.push('\t' + c.name + '_* _ = (' + c.name + '_*)($_);\n')
							// ARC birth count (D6: +1 return): matches the vtable-gated
							// `rc_` slot above — structs/native layouts stay untouched.
							if isStruct or c.api == ClassBinaryInterface.StructureNoVirtual {
								// Ok
							} else {
								out.push('\t_->rc_ = 1;\n')
							}

							// out.push('\tvoid* buffer_ = (struct ' + c.name + '_*)(HEXA_NEW(sizeof(struct ' + c.name + '_)));\n')
							// out.push('\tstruct ' + c.name + '_* _ = new (buffer_) ' + c.name + '_();\n')
							// out.push('\tstruct ' + c.name + '_* _ = new (buffer_) ' + c.name + '_();\n')
							// out.push('\t_->this_();\n')
							// out.push('\t_->this_(')
							out.push('\t' + c.name + '_$this_(')
							// out.push([for (a in args) a + '_'].join(', '))
							let arg = [for a in args a + '_']
							arg.unshift('_')
							out.push(arg.join(', '))
							out.push(');\n')
							out.push('\treturn _;\n')
							out.push('\};\n\n')
						} else {
							thisArgument = c.name + '_* $this'
							vtable.push('\n\t')
							vtable.push(printFunctionReturnType(funcType))
							vtable.push(' (*const ' + name + '_) ')
							vtable.push(printFunctionArguments(args, funcType, variadic))
							vtable.push(';')
							nonEmptyTable = true

							forwardFunctions.push(printFunctionReturnType(funcType))
							forwardFunctions.push(' ' + c.name + '_$' + name + '_')
							forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
							forwardFunctions.push(';\n')

							let vbind = '&' + c.name + '_$' + name + '_'
							vtableBind.push(vbind)

							out.push(printFunctionReturnType(funcType))
							out.push(' ' + c.name + '_$' + name + '_')
							out.push(printFunctionArguments(args, funcType, variadic))
							let _currentReturnType = currentReturnType
							currentReturnType = getFunctionReturnType(funcType)
							customThis = '$this'
							thisArgument = null
							// TODO cache own vtable on function enter
							// out.push(' \{\n\tprintf("\(c.name).\(name)()\\n");fflush(stdout);\n')
							let _insideAsyncFunction = insideAsyncFunction
							insideAsyncFunction = isAsync

							if let expr = expr {
								out.push(' ' + printBlock(expr) + ';\n\n')
							} else {
								let temp = tempId++
								// TODO proper `nullptr` kind
								out.push(' \{\n\tHEXA_UNREACHABLE(\(temp));\n\treturn nullptr;\n\};\n\n')
							}
							insideAsyncFunction = _insideAsyncFunction
							// out.push('\}\n')
							customThis = null
							currentReturnType = _currentReturnType

							if false {
								out.push(printFunctionReturnType(funcType))
								out.push(' ' + c.name + '_::' + name + '_')
								out.push(printFunctionArguments(args, funcType))
								let _currentReturnType = currentReturnType
								currentReturnType = getFunctionReturnType(funcType)
								// out.push(' {};\n')
								// out.push(' ' + printBlock(expr) + ';\n')
								// thisArgument = 'this'
								// let arg = args.slice()
								let arg = [for a in args a + '_']
								arg.unshift('this')
								// console.log('slice', arg == args, arg, args)
								// out.push(" \{ return ' + c.name + '_$' + name + '_(' + arg.join(', ') + '); \};\n')
								out.push(' \{ return this->_->' + name + '_(' + arg.join(', ') + '); \};\n')
								// out.push(" \{ return ' + c.name + '_$' + name + '_' + printFunctionArguments(args) + '; \};\n')
								// thisArgument = null
							}
							currentReturnType = _currentReturnType
						}
				} }

			if nonEmptyTable == false {
				vtable.push('uint8_t padding_;')
			}

			if not hasToString {
				out.push('String_* ' + c.name + '_$toString_(\(c.name)_* this_) \{ return ')
				out.push(printExpression(Expression.String('[object Object]')))
				out.push('; \};\n\n')
			}

			// Static vars before static functions
			for v in c.staticVars { switch v {
					case Var(name, expr, dataType):
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + c.name + '_$' + name + '_;\n')
						// types.push('\n\tstatic void* ' + name + '_;')
						// if (expr != null) out.push(' = ' + printExpression(expr))
					case Const(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + c.name + '_$' + name + '_;\n')
						// out.push(' = ' + printExpression(expr))
				} }

				// for (v in c.staticMethods) switch v {
				// case Function(name, expr, args, defaults, funcType):
				// types.push('\n\tstatic ')
				// types.push(printFunctionReturnType(funcType))
				// types.push(' ' + name + '_')
				// types.push(printFunctionArguments(args, funcType))
				// types.push(';')
				// }

			types.push('\n\};\n')

			if isPacked {
				types.push('#pragma pack()\n')
			}
			vtable.push('\n\};\n')
			vtableValue.push(vtableBind.join(',\n\t'))
			vtable.push(vtableValue.join('') + '\n\};\n')
			types.unshift(vtable.join(''))
			vtableClasses.push(c.name)

			for v in c.staticMethods { switch v {
					case Function(name, expr, args, defaults, funcType, _, isAsync):
						forwardFunctions.push(printFunctionReturnType(funcType))
						forwardFunctions.push(' ' + c.name + '_$' + name + '_')
						forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
						forwardFunctions.push(';\n')

						out.push(printFunctionReturnType(funcType))
						out.push(' ' + c.name + '_$' + name + '_')
						out.push(printFunctionArguments(args, funcType, variadic))

						let _currentReturnType = currentReturnType
						currentReturnType = getFunctionReturnType(funcType)
						let _insideAsyncFunction = insideAsyncFunction
						insideAsyncFunction = isAsync
						// out.push('\t{printf(\"\(c.name).\(name)()\\n\");\n\t')
						// out.push('\\{\\};\\n')
						if let e = expr {
							out.push(' ' + (isAsync? printFunctionBody(e, printFunctionReturnType(funcType)) : printBlock(e)) + ';\n\n')
						} else {
							// Body-less declare static — abstract stub with
							// matching return, mirrors instance-method stubs.
							// Built without brace escapes via fromCharCode.
							let temp = tempId++
							let returns = printFunctionReturnType(funcType)
							let openBrace = String.fromCharCode(123)
							let closeBrace = String.fromCharCode(125)

							if returns == 'void' {
								out.push(' ' + openBrace + ' HEXA_UNREACHABLE(' + temp + '); ' + closeBrace)
							} else {
								out.push(' ' + openBrace + ' HEXA_UNREACHABLE(' + temp + '); return (' + returns + ')0; ' + closeBrace)
							}
						}
						insideAsyncFunction = _insideAsyncFunction
						// out.push('\\t};\\n')
						currentReturnType = _currentReturnType
						// out.push(printFunctionArguments(args, defaults) + ' => \{ ' + printStatement(expr) + ' \}')
				} }
		}

		/*for g in project.globalFuncs {
				g.switch {
					case 123: 345
					case 123 { 345 }
					case 123 {
						345
					}
				}.switch {
					case 345:
				}

				var a = null
				b = a.unsafe(1,2,3)
				b = a.unsafe
				b = a.unsafe.xyz
			}*/
		for g in project.globalFuncs { switch g {
				case Function(name, expr, args, defaults, funcType, variadic, isAsync):
					let link = project.globalLink.get(g) // TODO null guard
					var shouldEmitHeader = false
					var customHeader: String? = null
					var spec = ''
					var name = name + '_'
					var exports = false

					if let link = link {
						// if link.convention == CallingConvention.FastCall {
						// types.push('__attribute__((fastcall)) ')
						// }
						switch link.convention {
							case FastCall:
								// types.push('__attribute__((fastcall)) ')
								// NOTE `__attribute__((fastcall))` is not supported by MSVC and Clang on Windows
								// spec += '__attribute__((fastcall)) '
								spec += '__fastcall '
							case Default:
								spec += defaultCallingConvention
								// types.push(defaultCallingConvention+'$'+name)
							case CDecl:
								spec += '__cdecl '
							case StdCall:
								spec += '__stdcall '
							case _:
								// TODO more

						}

						if link.dllImport {
							spec += '__declspec(dllimport) '
							// types.push('__declspec(dllimport) ')
							shouldEmitHeader = true
						}

						// if let aligned = link.aligned {
						// spec += '__attribute__((aligned(\(aligned)))) '
						// // TODO sublime bad hl for \()
						// }

						if link.emitHeader {
							// TODO seems like it doesn't respects `@rename`
							shouldEmitHeader = true
						}

						if link.customHeader != null {
							customHeader = link.customHeader
						}

						// NOTE before `dllExports.push`
						if let rename = link.rename {
							name = rename
						}

						if link.dllExport {
							spec += '__declspec(dllexport) '
							// types.push('__declspec(dllexport) ')
							exports = true
							dllExports.push(link.linkName ?? name)
						}
					} else {
						// types.push(defaultCallingConvention)
						spec += defaultCallingConvention
					}

					if let customHeader = customHeader {
						// TODO error that dllexport/etc incompatible with customHeader
						types.push(customHeader)
						types.push('\n')
					} else if expr != null or shouldEmitHeader {
						types.push(spec)
						types.push(printFunctionReturnType(funcType))
						types.push(' ' + name)
						types.push(printFunctionArguments(args, funcType, variadic))

						if let link = link, let linkName = link.linkName {
							// let linkName = exports and linkName.startsWith('__')? '_' + linkName : linkName
							if exports and extraUnderscore and linkName.startsWith('_') {
								types.push(' HEXA_LINK(\"_')
							} else {
								types.push(' HEXA_LINK(\"')
							}

							types.push(linkName)
							types.push('\")')
						}
						types.push(';\n')

						// MSVC has no asm() link-names (HEXA_LINK is empty there):
						// alias the suffixed Hexa-side C name to the real DLL
						// export at link time (FFI pivot, no SDK headers needed).
						// Guarded out on GNU/Clang (they keep using HEXA_LINK).
						if let link = link, let linkName = link.linkName {
							if link.dllImport, linkName != name {
								types.push('#ifdef _MSC_VER\n')
								types.push('#pragma comment(linker, \"/alternatename:__imp_' + name + '=__imp_' + linkName + '\")\n')
								types.push('#endif\n')
							}
						}
					}

					if let expr = expr {
						// if link == null {
						// We have `link.convention = Default` if `link` is present
						// out. types.push(defaultCallingConvention)
						// }
						let returns = printFunctionReturnType(funcType)
						out.push(returns)
						out.push(' ' + name)
						out.push(printFunctionArguments(args, funcType, variadic))

						let _currentReturnType = currentReturnType
						currentReturnType = getFunctionReturnType(funcType)
						out.push(' ' + printFunctionBody(expr, returns) + ';\n\n')
						currentReturnType = _currentReturnType
					}
					// out.push(printFunctionArguments(args, defaults) + ' ' + printBlock(expr) + ';')
			} }

			// Init
		out.push('int HEXA_MAIN(int argc, char **argv) \{\n')
		// out.push('\tprintf("Starting...\\n");fflush(stdout);\n')
		out.push('%%%HEXA_STRINGS@@@\n')
		// out.push('\tString_Strings = (String_**)HEXA_NEW(HEXA_STRINGS * sizeof(String_*));\n')
		pushTab()

		for e in project.enumsSimple {
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						if (expr != null) {
							out.push('\t' + e.name + '_$' + name + '_ = ' + printExpression(expr) + ';\n')
						}
					case Const(name, expr, dataType):
						if (expr != null) {
							out.push('\t' + e.name + '_$' + name + '_ = ' + printExpression(expr) + ';\n')
						}
				} }
		}

		for e in project.enumsComplex {
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						if expr != null {
							out.push('\t' + e.name + '_$' + name + '_ = ' + printExpression(expr) + ';\n')
						}
					case Const(name, expr, dataType):
						if expr != null {
							out.push('\t' + e.name + '_$' + name + '_ = ' + printExpression(expr) + ';\n')
						}
				} }
		}

		for e in project.classes {
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						if expr != null {
							out.push('\t' + e.name + '_$' + name + '_ = ' + printExpression(expr) + ';\n')
						}
					case Const(name, expr, dataType):
						if expr != null {
							out.push('\t' + e.name + '_$' + name + '_ = ' + printExpression(expr) + ';\n')
						}
				} }
		}

		// D2 fat-null env sentinel (S3b, M2+): addressable 4096-byte store so ARC
		// over a null env is a safe no-op (raw zero would break future `dec`
		// without branches). `== null` tests the code-ptr half only; `==`
		// tests both halves. F2 unifies this with the full sentinel family.
		globalVariables.push('alignas(4096) static uint8_t hexaSentinelEnvStore_[4096];\n')
		globalVariables.push('void* hexaSentinelEnv_ = (void*)hexaSentinelEnvStore_;\n')

		for g in project.globalVars {
			var defaults = true
			// TODO rename 'default' in JS gen `var default = true`
			switch g {
				// TODO maybe use "var"
				case Var(name, expr, dataType):
					let link = project.globalLink.get(g)
					var exports = false

					if let link = link {
						if let aligned = link.aligned {
							globalVariables.push('__attribute__((aligned(\(aligned)))) ')
							// TODO sublime bad hl for \()
						}

						if link.dllExport {
							globalVariables.push('__declspec(dllexport) ')
							exports = true
							dllExports.push(link.linkName ?? name)
						}
					}

					switch dataType {

						// TODO same for const
						case ClassInstance(classType, generics): {
								if classType.name == 'ArrayByValue' {
									var arraySize = ''

									if let count = generics[1] {
										arraySize = '[' + Type.stringify(count) + ']'
									} else {
										arraySize = '[]'
									}

									globalVariables.push('\(stringifyType(generics[0])) ' + name + '_' + arraySize)

									if let link = link, let linkName = link.linkName {
										if exports and extraUnderscore and linkName.startsWith('_') {
											globalVariables.push(' HEXA_LINK("_')
										} else {
											globalVariables.push(' HEXA_LINK("')
										}

										globalVariables.push(linkName)
										globalVariables.push('")')
									}

									if let expr = expr {
										switch expr {
											case Array(el):
												let valueType = generics[0]
												// TODO reuse same initializer as in expression and use meta-blocks
												globalVariables.push(' = \{' + [for a in el printTypeConverter(printExpression(a), getType(a), valueType)].join(', ') + '\}')
											case _:
												// TODO more
												globalVariables.push(" = \{0\}")
										}
									}
									globalVariables.push(';\n')

									defaults = false
								} else if classType.name == 'ByValue' {
									globalVariables.push(stringifyType(dataType))
									globalVariables.push(' ' + name + '_')
									globalVariables.push(';\n')
									defaults = false
								}
							}
					}

					if defaults {
						// S3b F1.6: function-typed globals double up (`name$ptr_` +
						// `void* name$env_`). Linkage suffixes ride the ptr half only.
						if isFatValueType(dataType) {
							let ptrType = stringifyType(dataType)
							globalVariables.push(ptrType)
							globalVariables.push(' ' + name + '$ptr_')

							if let link = link, let linkName = link.linkName {
								if exports and extraUnderscore and linkName.startsWith('_') {
									globalVariables.push(' HEXA_LINK(\"_')
								} else {
									globalVariables.push(' HEXA_LINK(\"')
								}

								globalVariables.push(linkName)
								globalVariables.push('\")')
							}

							globalVariables.push(';\n')
							globalVariables.push('void* ' + name + '$env_;\n')

							if expr != null {
								out.push('\t' + name + '$ptr_ = ' + fatPtrAs(expr, dataType) + ';\n')
								out.push('\t' + name + '$env_ = ' + fatEnvStr(expr) + ';\n')
							}

							defaults = false
						} else {
							// types.push('void* ' + name + '_;\n')
							globalVariables.push(stringifyType(dataType))
							globalVariables.push(' ' + name + '_') // TODO respect `@rename`

							if let link = link, let linkName = link.linkName {
								if exports and extraUnderscore and linkName.startsWith('_') {
									globalVariables.push(' HEXA_LINK("_')
								} else {
									globalVariables.push(' HEXA_LINK("')
								}

								globalVariables.push(linkName)
								globalVariables.push('")')
							}

							globalVariables.push(';\n')

						if expr != null {
							let value String = printExpression(expr)

							// Printing zero global integers causes bug in Hexa runtime code
							// due to assignment of heap offset of zero after strings allocation
							// Also in C global values are guaranteed to be initialized to 0
							// TODO check for `project.typer.typeInt` and other integer types
							if value != '(int32_t)0' {
								out.push('\t' + name + '_ = ' + value + ';\n')
								// TODO init them at declaration! int a = 123;
							}
						}
					}
					// out.push('\n\tvar ' + name)
					// if (expr != null) out.push(' = ' + printExpression(expr))
					// TODO maybe not useful
					// else out.push(' = null')
				case Const(name, expr, dataType):
					globalVariables.push(stringifyType(dataType))
					globalVariables.push(' ' + name + '_;\n')

					if expr != null {
						out.push('\t' + name + '_ = ' + printExpression(expr) + ';\n')
					}
					// types.push('void* ' + name + '_;\n')
					// out.push('\n\tvar ' + name + ' = ' + printExpression(expr))
			} }

		if project.init.length > 1 {
			throw 'project.init.length > 1'
		}
		let init = printStatement(project.init[0])

		// NOTE strings should be gathered after ALL expressions printed
		// TODO may be [] length == 0
		// let strings = ['String_Strings = (struct String_**)HEXA_NEW(HEXA_STRINGS * sizeof(struct String_*));\n']
		let strings: [String] = ['\tString_$root_ = String_$new_();\n']

		for id in declarationsOfStrings.length {
			// NOTE `const char[]` causes compiler to make a copy of the entire string on every usage
			// TODO set ref counting
			// strings.push('\tString_Strings[\(id)] = String_fromUTF8z("\(declarationsOfStrings[id])");\n')
			// strings.push('\tString_Strings[\(id)] = String_$fromUTF16z_((const uint16_t*)L"\(declarationsOfStrings[id])");\n')
			strings.push('\tString_\(id) = String_$fromUTF16z_((const uint16_t*)String_\(id)_);\n')
			// TODO ^ add predefined known bytes length? like sizeof
			forward.push('String_* String_\(id); static const wchar_t *String_\(id)_ = L"\(declarationsOfStrings[id])";')
			// strings.push('\twprintf(L"\(declarationsOfStrings[id])");\n')
		}
		out.push('\t')
		out.push(init)
		popTab()
		// for (init in project.init) {
		// // TODO custom entry
		// // TODO globalVars
		// out.push('\t')
		// out.push(printStatement(init))
		// popTab()
		// }
		// out.push('\tprintf("Exiting...\\n");\n')
		out.push('\tfflush(stdout);\n')
		out.push('\treturn 0;\n\}\n')

		out.push('#ifdef __cplusplus\n')
		out.push('\}\n')
		out.push('#endif\n')

		// forward.push('#define HEXA_STRINGS \(declarationsOfStrings.length)')
		// TODO all those to [ ].join('\n') instead of `+`

		if dllExports.length > 0 {
			Fs.writeFileSync(target + '.dllExport.txt', dllExports.join(' '))
		}

		// TODO instead of + + + use [String].join() as a rope
		// ^ also header/etc concat to others instead of .join('\n')
		// ^ \n can be placed at the header.push() lines or all.push('\n')
		// ^ allocate `all [String]` with known capacity to avoid relocations

		// Minted inline-structure forwards (created during expression
		// printing — `stringifyType` cannot see the local `forward` list)
		for d in structDefsForward {
			forward.push(d)
		}

		// F9: Promise struct forwards (generic instantiations have no other
		// forward; function forwards returning `Promise_X_*` precede Types).
		for s in promiseStructs {
			forward.push('struct ' + s + ';')
		}

		// Minted inline-structure BODIES — one block before Types (never
		// interleaved into the class being printed; see the field comment)
		let structBodies = structDefs.join('')

		return (
			header.join('\n')
			+ '\n// Forward\n' +
			forward.join('\n')

			+ '\n// Typedef functions\n' +
			typedefFunctions.join('')

			+ '\n// Forward functions\n' +
			// TODO forwardStructs.join('\nstruct '), forwardTypes
			forwardFunctions.join('')

			// Doc `///` comments cannot appear in between of bin-ops
			// + '\n\n// Strings\nString_* String_Strings[\(declarationsOfStrings.length)] = {nullptr};\n'
			// + '\n\n// Strings\nstruct String_** String_Strings;\n'
			+ '\n// Types\n' +
			structBodies +
			types.join('')

			+ '\n// Live registry (F11 side-table of live heap objects, no layout change)\n' +
			printLiveRegistry()

			+ '\n// Coroutines (F9: per-Promise co_await + promise_type, after structs)\n' +
			printCoroutines()

			+ '\n// Fat pairs (F10.3: pair-boxing runtime + thunk registry)\n' +
			printFatPairs()

			+ '\n// Scalar boxing (D7: real `Any` payloads for ints/floats)\n' +
			printScalarBoxing()

			+ '\n// Destroy table (ARC: tag -> destructor for the F11 sweep)\n' +
			printDestroyTable()

			+ '\n// Global variables\n' +
			printAnyObject() + globalVariables.join('')

			+ '\n// Sweep (F11: deferred free of rc==0 live entries, D6)\n' +
			printTagNames() +
			printSweep()

			+ '\n// Global functions\n' +
			globalFunctions.join('')

			+ '\n// Defaults\n' +
			Fs.readFileSync(__dirname + '/library/c/hexa.c').toString('utf8').split('\r\n').join('\n')

			+ '// Statements\n' +
			// TODO Boi, dat weird
			// ^ can be a call into `static void hexaInitStrings()` which also calls runtime string-init fun if required
			out.join('').split('%%%HEXA_STRINGS@@@').join(strings.join(''))
		).split('\n').join('\r\n')

		// DEAD CODE

		var out = ''

		// Types
		for e in project.enumsSimple {
			// No need to output simple enum values
			// out += '\n' + 'struct _x' + e.name + ' {};'
			// out += '\n' + 'uint32_t _x' + e.name + ';'
			declarationsOfOpaqueTypes.push('typedef uint16_t _x' + e.name)
			// TODO typedef, renamed
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						out += '\n' + stringifyType(dataType) + ' _x' + e.name + '_' + name

						if (expr != null) {
							out += ' = ' + printExpression(expr) + ';' // !to constructor
						}
						// += ;
					case Const(name, expr, dataType):
						out += '\n' + stringifyType(dataType) + ' _x' + e.name + '_' + name
						out += ' = ' + printExpression(expr) + ';'
				} }

			for v in e.staticMethods { switch v { // TODO forward, auto args
					// case Function(name, expr, args, defaults, types, returns):
					// out += '\n' + printType(returns) + ' _x' + e.name + '_' + name
					// out += printFunctionArguments(args, defaults, types) + " \{ ' + printStatement(expr) + ' \};'
				} }
		}

		for c in project.classes {
			if c.external {
				if c.jsRequire != null {
					// todo MAKE IT possible to use plain-c include's!
					// like "declare" vs "deep extern declare"
					out += '\n ' + '/*var ' + c.name + ' = require("' + c.jsRequire + '")*/'
					continue
				}
				// declarationsOfOpaqueTypes.push('#define _x' + c.name + ' ' + (c.jsNative ?? c.name))
				// Avoid adding of `;`
				// header.push('#define _x' + c.name + ' ' + (c.jsNative ?? c.name))
				header.push('typedef ' + (c.jsNative ?? c.name) + ' _x' + c.name + ';')
				continue
			}

			let renamed = '_x' + c.name
			let t = ['struct ', renamed, ' \{'] // t should be used instead of out???
			// out += '\n ' + 'struct ' + c.name + ' {'
			// maybe use as struct* not just `struct`?
			declarationsOfOpaqueTypes.push('typedef struct \(renamed)* \(renamed)')
			t.push('\n _xclass _xclass;') // Reference counting and metatable
			for v in c.vars { switch v {
					case Var(name, expr, dataType):
						t.push('\n ' + stringifyType(dataType) + ' _x' + name + ';')
						// if (expr != null) out += ' = ' + printExpression(expr)
						// t.push(';')
					case Const(name, expr, dataType):
						// t.push('\n ' + printType(type) + ' = ' + printExpression(expr) + ';')
						t.push('\n ' + stringifyType(dataType) + ' _x' + name + ';')
				} }

			for v in c.methods { switch v {
					case Function(name, expr, args, defaults): // Class method
						let types = null
						let returns = null
						var declaration = printType(returns) + ' '
						let constructor = (name == null or name == 'new')
						// TODO finally decide on 'new'
						if constructor {
							declaration = renamed + ' '
						}
						declaration += renamed + '_' + name

						if constructor {
							if args.length > 0 {
								declaration += '(void* _x' + args.join(', void* _x') + ')'
							} else {
								declaration += '()'
							}
						} else {
							if args.length > 0 {
								declaration += '(\(renamed) _xthis, void* _x' + args.join(', void* _x') + ')'
							} else {
								declaration += '(\(renamed) _xthis)'
							}
						}

						declarationsOfFunctions.push(declaration)
						// if (name == null || name == 'new') declaration = '\(renamed) \(renamed)_new'
						// if (name == null || name == 'new') out += '\n\(renamed)* constructor_\(renamed)'
						// else out += '\nauto ' + name
						out += '\n' + declaration
						// out += '(' + args.join(', ') + ') \{ '
						out += " \{ "

						if constructor {
							out += '\n \(renamed) _xthis = (\(renamed))HEXA_NEW(sizeof(struct \(renamed)));'
							// Init fields
							for v in c.vars { switch v {
									case Var(name, expr, dataType):
										if expr != null {
											out += '\n _xthis->_x' + name + ' = ' + printExpression(expr) + ';'
										}
									case Const(name, expr, dataType):
										out += '\n _xthis->_x' + name + ' = ' + printExpression(expr) + ';'
								} }
							out += '\n '
							out += printStatement(expr) + '\n return _xthis;\n\};'
						} else {
							out += printStatement(expr) + '\n\};'
						}
				} }
			t.push('\n\}')
			declarationsOfFullTypes.push(t.join(''))

			for v in c.staticVars { switch v {
					case Var(name, expr, dataType):
						out += '\n ' + stringifyType(dataType) + ' ' + renamed + '_' + name
						// t.push('\n ' + c.name + '.' + name)
						// TODO to main()
						// if (expr != null) out += ' = ' + printExpression(expr)
						out += ';'
						// if (expr != null) t.push(' = ' + printExpression(expr))
				} }
		}
	}

	var tabs = ''

	@inline fun pushTab() {
		tabs += '\t'
	}

	@inline fun popTab() {
		tabs = tabs.substring(0, tabs.length - 1)
	}

	// All names are prefixed with `_x`, so reserved words are not required
	var reserved = []

	// For `return value` conversions (like Bool to Any)
	var currentReturnType: Type? = null
	/// Set while printing an `async fun` body — makes `return` print as the
	/// C++ coroutine keyword `co_return` (see `printFunctionBody`)
	var insideAsyncFunction = false
	/// Set while printing a `catch` body — C++ forbids `co_await` inside a
	/// handler (C2304), so `await` there falls back to the settled `.value`
	/// read (no suspension, M1-safe; full catch suspension is later work).
	var insideCatch = false
	/// Extended class name in scope for `super(...)` → `Parent_$this_(...)`
	var currentSuperType: String? = null
	/// Asks Main to run the ARC inserter between normalize and codegen
	var arcEnabled = true
	/// Closure capture-lifting pass (F1 lite) — see `normalizing/closures.hexa`
	var closuresEnabled = true
	/// Reflect pre-lowering pass (dynamics to explicit reflection calls) —
	/// see `normalizing/reflect.hexa`. Runs before ClosureLifter.
	var reflectEnabled = true

	// Surrounds with { brackets } single statement
	// TODO rename to printAsBlock
	fun printBlock(s: Statement): String {
		// return printStatement(s)
		switch s {
			case Block(el):
				return printStatement(s)
				// if (el.length == 1) return '\{ ' + printStatement(el[0]) + '; \}'
				if el.length == 1 { switch (el[0]) {
						case Block(_): return printBlock(el[0])
						case _: return '\{ ' + printStatement(el[0]) + '; \}'
					} }

				if el.length == 0 {
					return '\{\}'
				}
				return printStatement(s)
			case _: // return '\{ ' + printStatement(s) + '; \}'
				return printStatement(Statement.Block([s]))
		}
	}

	// Add extra `return 0` to avoid stack corruption
	fun printFunctionBody(s: Statement, returns: String): String {
		// `async fun` (C++ coroutine): ALWAYS append a tail return — it is
		// `co_return` so the compiler recognises the function as async, and it
		// still avoids UB from a missing return value
		if insideAsyncFunction {
			switch s {
				case Block(el):
					let block = el.clone()

					if returns == 'void' {
						block.push(Statement.Return(null))
					} else {
						block.push(Statement.Return(Expression.Int(0)))
					}

					return printBlock(Statement.Block(block))
			}
		}

		if returns != 'void', returns.endsWith('*') or [
			'float', 'int',
			'uint8_t', 'uint16_t', 'uint32_t', 'uint64_t',
			'int8_t', 'int16_t', 'int32_t', 'int64_t'
		].includes(returns) {
			switch s {
				case Block(el):
					let block = el.clone()
					block.push(Statement.Return(Expression.Int(0)))
					return printBlock(Statement.Block(block))
			}
		}

		return printBlock(s)
	}

	/// Real C/C++ `switch` labels only accept integral conditions — string,
	/// pointer and enum-object scrutinees must use the if-else chain instead
	fun isIntegralSwitch(t: Type?): Bool {
		if let t = t {
			switch Type.unwrapNullable(t) {
				case ClassInstance(c, _): return [
						'Bool', 'Int', 'Int8', 'Int16', 'Int32', 'Int64',
						'UInt8', 'UInt16', 'UInt32', 'UInt64',
						'SizeOfPointer', 'SignedSizeOfPointer', 'ClangChar'
					].includes(c.name)
				case _: return false
			}
		}

		return false
	}

	/// One `switch_ == value` comparison for the if-else chain (null → `-1` tag)
	fun switchValueOf(cc: Expression): String {
		switch cc {
			case Null:
				// TODO == nullptr for non-tagged enums
				// switch expr EnumTag
				return 'switch_ == -1'
			case _:
				return 'switch_ == ' + printExpression(cc)
		}
	}

	var metaBlock: [String] = []
	var tempId = 0
	/// S3b: Nice base name (`closure$N`) of the fat impl currently being
	/// printed (for self-recursion via `$env`) — set around global-func
	/// emission, cleared after (like `currentReturnType`).
	var currentFatFn: String? = null

	var last: Statement = '' as!Statement // TODO remove
	fun printStatement(s: Statement) {
		last = s ?? last // TODO should error! cause String!
		switch s {
			case Statements(els):
				var r = ''

				for s in els {
					if s != null {
						r += '\n' + tabs + printStatement(s) + ';'
					}
				}
				return r

			case Break:
				return 'break'

			case Continue:
				return 'continue'

			case Block(el):
				if el.length == 0 {
					return '\{\}'
				}
				pushTab()

				fun printMetaBlock(e: Statement) {
					let kind = metaBlock
					metaBlock = []

					var ss = printStatement(e)
					var r = []

					for line in metaBlock {
						// r.unshift(line)
						r.push(line)
					}
					r.push(ss)

					metaBlock = kind
					return r.join(';\n' + tabs)
				}

				var r = '\{'

				for e in el { switch e {
						case null:
						case Statements(els):
							for s in els {
								if s != null {
									r += '\n' + tabs + printMetaBlock(s) + ';'
								}
							}
						case _:
							// TODO r could be a rope/join
							// ^ interesting idea is rope-promotion,
							// cause r never leaves owning block (in js too)
							r += '\n' + tabs + printMetaBlock(e) + ';'
					} }

				popTab()
				return r + '\n' + tabs + '\}'

				// TODO case New(e, args): return '' + printExpression(e) + '$new_' + printCallArguments(args)

			case Const(name, expr, dataType):
				// DROP THAT FREAKING Const ALREADY
				return printStatement(Statement.Var(name, expr, dataType))
				return stringifyType(dataType) + ' ' + name + '_' + (expr == null? '' : ' = ' + printTypeConverter(printExpression(expr), getType(expr), dataType))

			case Var(name, expr, dataType):
				// Declare for `cShape` — use nodes may lie about the C type
				localDecls.set(name, dataType)

				// `Void`-typed temp (expression-statement) — `void x = ...` is
				// not valid C, the call prints alone
				if stringifyType(dataType) == 'void' {
					if expr == null {
						return ''
					}

					return printExpression(expr)
				}

				// S3b F1.6: function-typed bindings double up (`name$ptr_` +
				// `void* name$env_`) from the type alone. Single Nice binding
				// stays one `localDecls` entry (for fat detection); init
				// assembles the pair (`fatPtrAs` bridges `Any` sources).
				// `Const` delegates here automatically.
				if isFatValueType(dataType) {
					let ptrType = stringifyType(dataType)
					var r = ptrType + ' ' + name + '$ptr_; void* ' + name + '$env_'

					if expr != null {
						r += '; ' + name + '$ptr_ = ' + fatPtrAs(expr, dataType) + '; ' + name + '$env_ = ' + fatEnvStr(expr)
					}
					return r
				}

				switch dataType {
					case ClassInstance(typeClass, generics):
						var arraySize = ''
						var arrayLength = 0x7FFFFFFF

						if typeClass.name == 'ArrayByValue' {
							if let count = generics[1] {
								arraySize = '[' + Type.stringify(count) + ']'

								switch count {
									case Constant(value): {
											arrayLength = parseInt(value)
										}
								}
							} else {
								arraySize = '[]'
							}

							switch expr {
								case Array(el):
									let valueType = generics[0]
									// TODO typer check: 1 or N elements and type of elements
									// TODO use meta-blocks for non-constant values and strings
									return stringifyType(valueType) + ' ' + name + '_' + arraySize + ' = \{' + [for a in el printTypeConverter(printExpression(a), getType(a), valueType)].join(', ') + '\}'
								case String(string):
									if arrayLength <= string.length {
										throw 'String initializer is of length `\(string.length + 1)` including null terminator'
									}

									let valueType = generics[0]

									if generics[0] == project.typer.typeUInt8 {
										return stringifyType(valueType) + ' ' + name + '_' + arraySize + ' = "' + string + '"'
									}

									if generics[0] == project.typer.typeUInt16 {
										return stringifyType(valueType) + ' ' + name + '_' + arraySize + ' = L"' + string + '"'
									}

									let valueTypeString = stringifyType(valueType)
									// TODO project.typer.typeClangWideChar
									if valueTypeString == 'wchar_t' {
										return stringifyType(valueType) + ' ' + name + '_' + arraySize + ' = L"' + string + '"'
									}

									// TODO position, and in other exceptions too
									throw 'String initializer is incompatible: ' + valueTypeString
								case null:
									// TODO check this in typer
									throw 'Array initializer required ' + name
							}
						} else if typeClass.name == 'ByValue' {
							switch expr {
								case null:
								case New(e, args, result):
									// Just print out `T varName; init(&varName);`
									return stringifyType(dataType) + ' ' + name + '_; ' // + stringifyType(dataType) + '$this_(&' + name + '_);'
							}
						}
				}

				return stringifyType(dataType) + ' ' + name + '_' + (expr == null? '' : ' = ' + printTypeConverter(printExpression(expr), getType(expr), dataType))

				// case Function(name, expr, args, defaults, types, returns):
				// return printType(returns) + ' _x' + name + printFunctionArguments(args, defaults, types) + ' ' + printBlock(expr)
				// //return 'const void* _x' + name + ' = ' + ((async==true)?'async ':'') + printFunctionArguments(args, defaults) + ' => ' + printBlock(expr)
			case Function(name, expr, args, defaults, funcType, _, isAsync):
				let _currentReturnType = currentReturnType
				currentReturnType = getFunctionReturnType(funcType)

				let temp = tempId++
				let rt = printFunctionReturnType(funcType)
				forwardFunctions.push(rt)
				forwardFunctions.push(' _$\(temp)')
				forwardFunctions.push(printFunctionArguments(args, funcType))
				forwardFunctions.push(';\n')
				//
				//
				// rt::forwardFunctions.push
				//
				// rt::forwardFunctions.push()
				//
				// rt |> forwardFunctions.push |> sort
				//
				// rt.(forwardFunctions.push).(sort)
				//
				// ...(rt, forwardFunctions.push, sort)
				//
				//
				// printFunctionArguments(args, funcType, true) |> globalFunctions.push()
				//
				// printFunctionArguments(args, funcType, true) |> globalFunctions.push
				//
				// printFunctionArguments(args, funcType, true) :: globalFunctions.push
				//
				// printFunctionArguments(args, funcType, true)::globalFunctions.push
				//
				//

				let tab = tabs
				tabs = ''
				globalFunctions.push(rt)
				globalFunctions.push(' _$\(temp)')
				globalFunctions.push(printFunctionArguments(args, funcType))
				globalFunctions.push(' ')
				globalFunctions.push(printBlock(expr))
				tabs = tab

				currentReturnType = _currentReturnType
				return stringifyType(funcType) + ' \(name)_ = _$\(temp)'

			case Return(e):
				// F9: inside `async fun`, `return` is `co_return` (C++ coroutine).
				// Values box to `Any_*` (`promise_type::return_value(Any_*)`);
				// bare `return;` becomes `co_return (Any_*)nullptr` (settles
				// null via `return_value`; single `return_value` only —
				// C3782 forbids `return_value` + `return_void` together).
				// Outside async, plain `return` (unchanged).
				if insideAsyncFunction {
					if e == null {
						return 'co_return (Any_*)nullptr'
					}
					// Struct-typed literal: construct, then box the pointer.
					if let s = printObjectAs(currentReturnType, e) {
						return 'co_return ' + printToAnyConverter(s, currentReturnType)
					}
					return 'co_return ' + printToAnyConverter(printExpression(e), valueType(e))
				}
				let keyword = 'return'

				if e == null {
					return 'return'
				}
				// let type = getType(e)
				// if (type != currentReturnType) {
				// if (type == project.typer.typeBool) return 'return Any_fromBool(' + printExpression(e) + ')'
				// if (currentReturnType == project.typer.typeBool) return 'return (' + printExpression(e) + ')->_toBool()'
				// return 'return (' + stringifyType(currentReturnType) + ')(' + printExpression(e) + ')'
				// }
				return 'return ' + printTypeConverter(printExpression(e), getType(e), currentReturnType)

			case If(econd, eif, eelse):
				var r = '\n\(tabs)if (' + printExpression(econd) + ') ' + printBlock(eif)

				if eelse != null {
					r += ' else ' + printStatement(eelse)
				}
				return r

			case Call(e, args, expects, kind):
				///let type = getType(e)
				// switch type {
				// case ClassInstance(_, _): return 'virtual'
				// case Class(_, _): return 'static'
				// }
				switch kind {
					// TODO error on (_,_) if simple enum case CallKind.VirtualMethod(_, _): return '*.virtual'
					case VirtualMethod:
						switch e {
							case Dot(expr, name, result):
					// Dynamic receivers (`Any`/erased) have no
						// vtable — the Dot path prints the reflection
						// stub call instead (F10). F10.2: route through the
						// dynamic call slot (bags may hold the method as a
						// pair; otherwise the legacy proxy no-ops as before).
						// A raw `Any_dynGet_(...)(args)` call would not even
						// compile (`Any_*` is not callable, C2064).
						if isDynamic(valueType(expr)) {
							return printDynamicCall(e, args, expectsOrDerived(expects, e))
						}

							// Scalar receivers (`x.toString()` on `Int`) have
							// no vtable either — same helper as expressions
							if name == 'toString' {
								if let helper = scalarToString(printExpression(expr), cShape(expr)) {
									return helper
								}
							}

								let temp = tempId++

								let exprType = getType(expr)
								let typeString = stringifyType(exprType)
								let kindVar = typeString + ' _$\(temp) = ' + printExpression(expr)

								var isStruct = false
								switch exprType {
									case ClassInstance(kind, params): {
											let atts = project.mapDecorators.get(kind.parent)
											isStruct = Decorator.getDecorator(atts, 'struct') != null
										}
								}

								metaBlock.push(typeString + ' _$\(temp) = ' + printExpression(expr))

								if isStruct {
									// TODO add `, expects` to other `printCallArgumentsVirtual` calls
									return omitPointer(typeString) + '$' + name + '_' + printCallArgumentsVirtual('_$\(temp)', args, expects)
								}

								return '_$\(temp)->_->' + name + '_' + printCallArgumentsVirtual('_$\(temp)', args, expects)
								// return
								// '\{\n' + tabs +
								// '\t' + stringifyType(getType(expr)) + ' _$\(temp) = ' + printExpression(expr) + ';\n' + tabs +
								// '_$\(temp)->_->' + name + '_' + printCallArgumentsVirtual('_$\(temp)', args, expects)// + ';\n' + tabs// +
								// '\}'
						}
						// case CallKind.Static: return '*.static'
						// case CallKind.Function: return '*.function'
						// case _: return '*.???' + kind
				}
				// '/*Statement.Call*/' + Type.stringify(type)
				return printExpression(e) + printCallArguments(args, expects)

			case Try(expr, t, v, catches):
				pushTab()
				var r = '_try \{\n' + tabs
				// TODO transfer &$try as function argument
				r += 'struct Any_* $try = (struct Any_*)0;' + '\n' + tabs
				r += printStatement(expr)
				popTab()
				// TODO test $try for null at each functions calls and goto $catch
				// TODO test $try for null and do ARC
				r += '\n' + tabs + '$catch: ; \} _catch(' + printType(t[0]) + ' _x' + v[0] + ') \{\n' + tabs + ' '
				pushTab()
				r += printStatement(catches[0])
				popTab()
				return r + '\n' + tabs + '\}'

			case Assign(a, v):
				// S3b F1.6: fat targets assign BOTH halves (ptr + env, no
				// conversion — shapes uniform). Value halves via shared
				// helpers (closure impl+local/sentinel, pair halves, plain
				// wrappers+sentinel, null pair, Dot `$f_`/`$e_`).
				// `Any` sources bridge via `fatPtrAs` (M1 compiles).
				// TODO kinds like `static`
				if isFatValueType(valueType(a)) { switch a {
						case Ident(aname, _):
							return aname + '$ptr_ = ' + fatPtrAs(v, valueType(a)) + '; ' + aname + '$env_ = ' + fatEnvStr(v)
						case Dot(expr, dname, _):
							// Only Variable fields of real classes carry pairs —
							// methods/statics/dynamics/structs fall through to the
							// generic single-slot handling below.
							if isFatFieldDot(expr, dname, getType(a)) {
								let base = printExpression(expr)
								return base + '->' + dname + '$f_ = ' + fatPtrAs(v, getType(a)) + '; ' + base + '->' + dname + '$e_ = ' + fatEnvStr(v)
							}
						case _:
							return '/*UNPAIRED-ASSIGN*/' + printExpression(a) + ' = ' + printExpression(v)
					} }
					// TODO kinds like `static`
				switch a {
					case Dot(expr, name):
						// Dynamic
						let dataType = getType(expr)

						if ((dataType == project.typer.typeAny) or (dataType == null)) {
							// console.log('eeeeee', expr)
							// `static var` TODO describe logic more obviously
							switch expr {
								case Ident(named): {
										if DataHelper.isTitleCase(named) {
											// TODO proper conversion type in `printTypeConverter` of assigned field
											return printExpression(expr) + '$' + name + '_ = ' + printInitializer(getType(a), v)
											// printExpression(v)
										}
									}
							}

							return printExpression(expr) +
							'->$set(String_$fromUTF16z_(L"' + name + '"), ' + printToAnyConverter(printExpression(v), getType(v)) + ')'
						}
					case Index(expr, index):
						switch getType(expr) {
							case ClassInstance(kind, generic):
								if kind.name != 'Array' {
									return printExpression(expr) + '[' + printTypeConverter(printExpression(index), getType(index), project.typer.typeInt) + ']'
									+ ' = ' + printExpression(v)
								}
								// TODO meta block
								return printExpression(Expression.Call(
										Expression.Dot(expr, 'set', null /*TODO*/),
										[index, v],
										project.typer.typeVoid,
										// [project.typer.typeInt, generic[0] /*TODO is this correct way to pass `T`*/],
										CallKind.VirtualMethod
									))
						}
				}
				return printExpression(a) + ' = ' + printInitializer(getType(a), v)
				// printExpression(v)
				// return printExpression(a) + ' = ' + printTypeConverter(printExpression(v), getType(v), getType(a))

			case Throw(e):
				// C++ mode: real `throw` (exceptions are on by default on MSVC/clang-cl)
				if cpp {
					return 'throw ' + printExpression(e)
				}

				return '_throw(' + printExpression(e) + ')'

			case For(name, over, by, reverse):
				return 'for (FIXME TODO struct Any_* ' + name + '_; ' + printExpression(over) + ';) ' + printStatement(by)

			case Increment(e):
				return printExpression(e) + '++'

			case Decrement(e):
				return printExpression(e) + '--'

			case While(econd, e, pre):
				// TODO ^ separate WhileDo DoWhile
				if pre {
					return '\n\(tabs)while (' + printExpression(econd) + ') ' + printStatement(e)
				}
				return '\n\(tabs)do \{' + printStatement(e) /*block*/ + '\} while (' + printExpression(econd) + ')'

			case Assignop(a, op, value):
				// TODO rename to AssignOp
				// F10.2: `x.y op= z` on a dynamic base has no addressable C
				// lvalue (`Any_dynGet_` returns a value) and the old
				// `AnyValue_` proxy was a silent no-op — preserve that
				// (read the field back so the value is unchanged) while
				// still evaluating the RHS once for effects. The base
				// hoists to a temp (single eval). Real dynamic arithmetic
				// lands with F10 content reflection.
				switch a {
					case Dot(base, name):
						var dynOpBase = false
						switch base {
							case Ident(id, _):
								if id.charAt(0) != id.charAt(0).toUpperCase() or id.startsWith('_') or id.startsWith('$') {
									if isDynamic(valueType(base)) {
										dynOpBase = true
									}
								}
							case _:
								if isDynamic(valueType(base)) {
									dynOpBase = true
								}
						}

						if dynOpBase {
							let bt = tempId++
							let btmp = '_$bt' + bt
							metaBlock.push('Any_* ' + btmp + ' = ' + printExpression(base))
							metaBlock.push('(void)(' + printExpression(value) + ')')
							return anyDynSetStr(btmp, name, anyDynGetStr(btmp, name))
						}
					case _:
				}

				if getType(a) == project.typer.typeString, op == Token.Add {
					switch a {
						case Index(expr, index): {
								// Cache `index` to not re-evaluate twice
								let tempIndex = tempId++
								{
									let indexType = getType(index)
									let indexString = stringifyType(indexType)
									// TODO should be converted to valid index type
									let metaIndex = indexString + ' _$\(tempIndex) = ' + printExpression(index)
									metaBlock.push(metaIndex)
								}

								// Cache storage to not re-evaluate twice
								let tempStorage = tempId++
								{
									let indexType = getType(expr)
									let indexString = stringifyType(indexType)
									let metaIndex = indexString + ' _$\(tempStorage) = ' + printExpression(expr)
									metaBlock.push(metaIndex)
								}

								// `storage[index] += string`
								return '_$\(tempStorage)->_->set_(_$\(tempStorage), _$\(tempIndex), String_$combine_(_$\(tempStorage)->_->get_(_$\(tempStorage), _$\(tempIndex)), '
								+ printTypeConverter(printExpression(value), valueType(value), project.typer.typeString) + '))'
							}
					}
					return printExpression(a) + ' = String_$combine_(' + printExpression(a) + ', ' + printTypeConverter(printExpression(value), valueType(value), project.typer.typeString) + ')'
				}
				return printExpression(a) + ' ' + Token.stringify(op) + '= ' + printExpression(value)

				/*case Dot(expr, name): switch expr {
					// TODO ^ replace to Statement.Expression
					// TODO use types in future, cause renames may make expr to be lower case
					// ^ DotStaticMethodCall DotStaticMethodAsValue
					case Ident(id):
						// Static
						if (id.charAt(0) == id.charAt(0).toUpperCase()) {
							return id + '_:?:' + name + '_'
						}
					}
					return printExpression(expr) + '->' + name*/
			case Switch(expr, cases, statements):
				// Convert to if-else because C is not fun
				// TODO do it in normalizer
				// TODO support normal switch when possible
				// + option to always emulate switches for specific target
				let value = printExpression(expr)
				let valueType = stringifyType(getType(expr))
				var r = '\{ \(valueType) switch_ = ' + value + ';'

				// case 1: case 2: case 3:
				var else_ = false
				for i in cases.length { if (cases[i].length > 1) {
						if else_ {
							r += ' else'
						}
						r += '\n' + tabs + 'if (' + '('
						let conds = []

						for cc in cases[i] { switch cc {
								case Null:
									// TODO == nullptr for non-tagged enums
									// switch expr EnumTag
									conds.push('switch_ == -1')
								case _:
									conds.push('switch_ == ' + printExpression(cc))
							} }
						r += conds.join(') || (') + ')) '
						pushTab()
						r += printBlock(statements[i])
						popTab()
						else_ = true
					} else if let cc = cases[i][0] {
						if else_ {
							r += ' else'
						}
						r += '\n' + tabs + 'if ('

						switch cc {
							case Null:
								r += 'switch_ == -1) '
							case _:
								r += 'switch_ == ' + printExpression(cc) + ') '
						}
						pushTab()
						r += printBlock(statements[i])
						popTab()
						else_ = true
					} }

					// default:
				for i in cases.length { if (cases[i].length == 0) {
						if else_ {
							r += ' else'
						}
						r += '\n' + tabs
						r += printBlock(statements[i])
					} }

				r += ';\n' + tabs
				return r + '\}'

				// TODO don't use "0" as tag, use 1+; use `switch (a? a->index : 0)` or
				// generate `if (a) switch () else null-case` in normalizer

				/*
						let temp = f()
						if temp != null {
							switch temp.index {
								// no null case
							}
						} else {
							null case
						}
						^ in normalizer
					*/
				var r = 'switch (' + printExpression(expr) + ') \{'

				// case 1: case 2: case 3:
				for i in cases.length { if (cases[i].length > 0) {
						r += '\n' + tabs

						for cc in cases[i] {
							r += 'case ' + printExpression(cc) + ': '
						}
						// pushTab()
						// r += '\{\n' + tabs
						// r += printStatement(statements[i])
						// popTab()
						// r += '\n' + tabs + '\} break;\n' + tabs

						pushTab()
						r += printBlock(statements[i])
						popTab()
						r += ' break;'
					} }

					// default:
				for i in cases.length { if (cases[i].length == 0) {
						r += '\n' + tabs + 'default:'
						r += '\n' + tabs
						r += printBlock(statements[i])
						// r += '\n' + tabs
					} }

				r += '\n' + tabs
				return r + '\}'

			case _: console.error("Unknown statement kind (GenCxx):", s)
				console.trace("Here I am!")
		}
	}

	fun hexaRestElement(exp: [Type]): Type? {
		if exp.length == 0 { return null }

		switch exp[exp.length - 1] {
			case Rest(element, native):
				if not native { return element }
			case _:
		}
		return null
	}

	fun isRestSpread(arg: Expression): Bool { switch arg {
			case Spread(inner):
				switch valueType(inner) {
					case Rest(_, _): return true
					case _:
				}
			case _:
		} return false }

	fun printHexaRestCall(args: [Expression], exp: [Type], restElem: Type, me: String?): String {
		// Hexa ABI `(fixed..., count, ptr)` — plain C stack array, no `Array` object.
		let fixedCount = exp.length - 1
		let prefix: [String] = []

		if let m = me { prefix.push(m) }

		// Spread forwarding `f(...r)` / `f(x, ...r)` — pass caller's count+ptr, no copy.
		for a in args { if isRestSpread(a) {
			for i in fixedCount {
				if stringifyType(exp[i]) == 'void' {
					continue
				}
				if i < args.length, not isRestSpread(args[i]) {
					// Fat fixed params (`setImmediate(cb, ...)` with `Any` cb)
					// expand to two C slots like `printCallArguments`.
					if isFatValueType(exp[i]), (isFatArg(args[i]) or isDynamic(valueType(args[i]))) {
						prefix.push(fatPtrAs(args[i], exp[i]))
						prefix.push(fatEnvStr(args[i]))
						continue
					}
					prefix.push(printTypeConverter(printExpression(args[i]), valueType(args[i]), exp[i]))
				} else if i >= args.length {
					if isFatValueType(exp[i]) {
						prefix.push('nullptr')
						prefix.push('hexaSentinelEnv_')
						continue
					}
					prefix.push(padValue(exp[i]))
				}
			}
			prefix.push('$nrest_')
			prefix.push('$rest_')
			if me != null { return '(' + prefix.join(', ') + ') ' }
			return '(' + prefix.join(', ') + ') '
		} }

		// Discrete args `f(a, b, c)` — pack rest extras into a stack array.
		var restCount = args.length - fixedCount

		if restCount < 0 { restCount = 0 }

		for i in fixedCount {
			if stringifyType(exp[i]) == 'void' {
				continue
			}

			if i < args.length {
				// Fat fixed params expand to two C slots (see above).
				if isFatValueType(exp[i]), (isFatArg(args[i]) or isDynamic(valueType(args[i]))) {
					prefix.push(fatPtrAs(args[i], exp[i]))
					prefix.push(fatEnvStr(args[i]))
					continue
				}
				prefix.push(printTypeConverter(printExpression(args[i]), valueType(args[i]), exp[i]))
			} else {
				if isFatValueType(exp[i]) {
					prefix.push('nullptr')
					prefix.push('hexaSentinelEnv_')
					continue
				}
				prefix.push(padValue(exp[i]))
			}
		}

		if restCount == 0 {
			prefix.push('0')
			prefix.push('nullptr')

			if me != null { return '(' + prefix.join(', ') + ') ' }
			return '(' + prefix.join(', ') + ') '
		}
		let elemC = stringifyType(restElem)
		let parts: [String] = []

		for k in restCount {
			let idx = fixedCount + k
			parts.push(printTypeConverter(printExpression(args[idx]), valueType(args[idx]), restElem))
		}
		let tmp = '_rest' + (tempId++)
		metaBlock.push(elemC + ' ' + tmp + '[' + ('' + restCount) + '] = \{' + parts.join(', ') + '\};')
		prefix.push('' + restCount)
		prefix.push(tmp)

		if me != null { return '(' + prefix.join(', ') + ') ' }
		return '(' + prefix.join(', ') + ') '
	}

	fun printCallArguments(args: [Expression], expects: [Type]? = null) {
		if let exp = expects {
			return '(' + [for i in args.length
				printTypeConverter(printExpression(args[i]), getType(args[i]), exp[i])
			].join(', ') + ')'
	/// Statement calls carry `expects` from the normalizer — an EMPTY list
	/// (callee type unknown at typing time) must fall back to the callee's
	/// function type or arguments never convert and optional ones never pad
	fun expectsOrDerived(expects: [Type]?, callee: Expression): [Type]? {
		if let exp = expects, exp.length > 0 {
			return exp
		}

		return callExpects(callee)
	}

	/// Body-less `declare fun` expects fallback (D8-style, small). `declareTypes`
	/// is filled at normalize time keyed by the renamed Nice name; body-less
	/// declares have no Nice `globalFuncs` entry to read from.
	fun declareExpects(name: String): [Type]? {
		if let dt = project.declareTypes.get(name) {
			switch dt {
				case Function(args, returns, variadic):
					let out: [Type] = []

					for a in args {
						out.push(a.dataType)
					}

					return out
				case _:
			}
		}

		return null
	}

	/// Expected argument types of a callee — expression-level `Call` nodes
	/// carry no `expects`, so derive them from the callee's function type
	fun callExpects(callee: Expression): [Type]? {
		switch getType(callee) {
			case Function(args, returns, variadic):
				let out: [Type] = []

				for a in args {
					out.push(a.dataType)
				}

				return out
			case _:
		}

		// NOTE module-level function idents carry NO type in Nice (the
		// normalizer passes `null` for globals) — resolve the signature from
		// the global function list or call arguments never get converted
		switch callee {
			case Ident(name):
				for g in project.globalFuncs {
					switch g {
						case Function(gname, _, _, _, funcType, _, _):
							if gname == name {
								switch funcType {
									case Function(args, returns, variadic):
										let out: [Type] = []

										for a in args {
											out.push(a.dataType)
										}

										return out
									case _:
								}
							}
					}
				}

				if let de = declareExpects(name) {
					return de
				}
			case Parenthesis(inner):
				return callExpects(inner)
			case _:
		}

		return null
	}

	/// Expression-Call expects from the Normalizer field (D8); falls back to
	/// `callExpects` derivation for desugared calls (empty field) and safety.
	fun exprCallExpects(fieldExpects: [Type], callee: Expression): [Type]? {
		if fieldExpects.length > 0 {
			return fieldExpects
		}

		return callExpects(callee)
	}

	/// Constructor parameter types of the emitted `Name_$new_` — looked up in
	/// the nice classes on demand (safe regardless of class processing order)
	fun constructorExpects(className: String): [Type]? {
		for c in project.classes {
			if omitPointer(stringifyType(c.classType)) == className {
				for m in c.methods {
					switch m {
						case Function(name, _, _, _, funcType, _, _):
							if name == null or name == 'new' {
								switch funcType {
									case Function(args, returns, variadic):
										let out: [Type] = []

										for a in args {
											out.push(a.dataType)
										}

										return out
									case _:
								}
							}
					}
				}
			}
		}

		return null
	}

	/// S3a dual-mode helpers: lifted `closure$N` have a FAT impl (`void* $env`
	/// first param) + a THIN wrapper (`closure$N$thin`, old signature, calls
	/// fat with the global/nullptr env) for stored/indirect single-var values
	/// until S3b pairs land. Direct `CallKind.Closure` calls go fat with the
	/// global env; stored `Ident(closure$N)` prints as the thin wrapper.
	/// Base fat name for a callee (unwraps IIFE `Parenthesis`; null unless the
	/// callee is a lifted closure impl, never a `$thin` wrapper).
	fun closureBaseName(e: Expression): String? { switch e {
			case Ident(name, _):
				if name.startsWith('closure$'), not name.endsWith('$thin') {
					return name
				}
				return null
			case Parenthesis(inner):
				return closureBaseName(inner)
			case _:
				return null
		} }

	/// S3b: does lifted `base` (`closure$N`) capture (has an `Env$N` helper)?
	/// Decided from `NiceClass`es (globals no longer consulted — S3b threads
	/// per-instance locals; the global slot remains only as the narrow
	/// fallback for obj-elem/array/Any/dynamic positions until F10 wiring).
	fun closureHasEnv(base: String): Bool {
		let suffix = base.substr(8, base.length - 8)
		let envClass = 'Env$' + suffix

		for c in project.classes {
			if c.name == envClass {
				return true
			}
		}
		return false
	}

	/// Instance type of `base`'s helper (`Env$N`), or null when empty/captureless.
	fun closureEnvType(base: String): Type? {
		let suffix = base.substr(8, base.length - 8)
		let envClass = 'Env$' + suffix

		for c in project.classes {
			if c.name == envClass {
				return c.classType
			}
		}
		return null
	}

	/// S3b F1.6: C ptr half of a fat Nice value (single string; env half is
	/// separate — pairs never collapse to one C value). Used by ALL binding
	/// sites (Var/Assign/arg/param/field/global/return-fallback) so they stay
	/// consistent. Missed kinds emit `/*UNPAIRED*/nullptr` (compiles; marker
	/// flags M2+ triage — zero hits expected in Perfide: no function returns,
	/// no closure arrays per trace).
	fun fatPtrStr(e: Expression): String { switch e {
		case Parenthesis(inner):
			return fatPtrStr(inner)
		case Ident(name, _):
			// Dropped creation (field/global/var initializers): the local twin
			// was never emitted — fall back to the thin wrapper (global env),
			// exactly S2-identical and always in scope.
			if let db0 = closureBaseName(e) {
				let ds0 = db0.substr(8, db0.length - 8)
				if project.droppedClosureEnvs.get('closureEnv$' + ds0) != null {
					return db0 + '$thin_'
				}
			}
			// Lifted closure value → fat impl directly (per-instance callers
			// use the local twin; fallback positions use the thin wrapper via
			// generic `printExpression`, never here).
			if closureBaseName(e) != null {
				return (closureBaseName(e) as!String) + '_'
			}
			// Pair var/param/global → its ptr half.
			if isFatValueType(valueType(e)) {
				return name + '$ptr_'
			}
			// Plain global function → on-demand thin wrapper (fat impl shape).
			if let gt = globalFuncType(name) {
				if isFatValueType(gt) {
					return thinWrapperFor(name)
				}
			}
			return printExpression(e) + '/*UNPAIRED-PTR*/'
		case Dot(expr, name, _):
			// Function-typed Variable field → double slot (`->$f_`). Methods,
			// statics, dynamic receivers and inline structs never split.
			if isFatFieldDot(expr, name, getType(e)) {
				return printExpression(expr) + '->' + name + '$f_'
			}
			return printExpression(e) + '/*UNPAIRED-DOTPTR*/'
		case Null(_):
			return 'nullptr'
		case _:
			return '/*UNPAIRED-PTR*/nullptr'
	} }

	/// S3b F1.6: C env half of a fat Nice value (uniform `void*`: local twin,
	/// pair half, sentinel, or plain-global wrapper env). See `fatPtrStr`.
	fun fatEnvStr(e: Expression): String { switch e {
		case Parenthesis(inner):
			return fatEnvStr(inner)
		case Ident(name, _):
			if let base = closureBaseName(e) {
				let ds = base.substr(8, base.length - 8)
				if project.droppedClosureEnvs.get('closureEnv$' + ds) != null {
					return 'closureEnv$' + ds + '_'
				}
				if closureHasEnv(base) {
					// S3b: the per-instance twin only dominates its own block
					// (the hoisted creation site) — cross-function/method-value
					// uses fall back to the global twin (S2 semantics, always
					// in scope).
					if localDecls.get('closureEnvL$' + ds) != null {
						return 'closureEnvL$' + ds + '_'
					}
					return 'closureEnv$' + ds + '_'
				}
				return 'hexaSentinelEnv_'
			}
		if isFatValueType(valueType(e)) {
			return name + '$env_'
		}
		// F10.3: a dynamic source holding a boxed fat pair unboxes its env
		// (exact). Bare function designators and effectful sources keep the
		// legacy sentinel (no worse than before; never a pair).
		if isDynamic(valueType(e)), isPureIsReceiver(e), not isBareFunctionDesignator(e) {
			let p = printExpression(e)
			return '(Any_isFatPair_(' + p + ') ? ((FatPair_*)(' + p + '))->env_ : hexaSentinelEnv_)'
		}
		// Plain global function → sentinel (pairs with the wrapper above).
			// S3b retirements: `hexaSentinelEnv_` replaces S3a `nullptr`.
			if let gt = globalFuncType(name) {
				if isFatValueType(gt) {
					return 'hexaSentinelEnv_'
				}
			}
			return 'hexaSentinelEnv_/*UNPAIRED-ENV*/'
		case Dot(expr, name, _):
			if isFatFieldDot(expr, name, getType(e)) {
				return printExpression(expr) + '->' + name + '$e_'
			}
			return 'hexaSentinelEnv_/*UNPAIRED-DOTENV*/'
		case Null(_):
			return 'hexaSentinelEnv_'
		case _:
			return 'hexaSentinelEnv_/*UNPAIRED-ENV*/'
	} }

	/// S3b: source function type behind a fat value (for call-site casts).
	/// `null` when there is no meaningful source (Null → nullptr needs none).
	fun fatValueType(e: Expression): Type? { switch e {
		case Ident(name, _):
			if closureBaseName(e) != null {
				return valueType(e)
			}
			if isFatValueType(valueType(e)) {
				return valueType(e)
			}
			return globalFuncType(name)
		case Dot(_, _, _):
			return getType(e)
		case Null(_):
			return null
		case _:
			return null
	} }

	/// F10.3: a bare function designator (`closure$N_` impl, plain global)
	/// is never a boxed pair — pair-unbox/dispatch sites must use the legacy
	/// path for these (the designator doesn't convert to `Any_*`).
	fun isBareFunctionDesignator(e: Expression): Bool {
		if closureBaseName(e) != null {
			return true
		}

		switch e {
			case Ident(name, _):
				return globalFuncType(name) != null
			case _:
				return false
		}
	}

	/// F10.3: leaf fat values whose pair storage is statically known
	/// (`Ident`/`Dot`/`Parenthesis` — vars, params, fields). Composite
	/// fat expressions (`If`/`Call`/...) have no addressable pair halves;
	/// boxing them would emit null pairs (worse than the legacy drop).
	/// Dynamic-based `Dot`s are excluded (the base may be a stub).
	fun isBoxableFat(e: Expression): Bool { switch e {
		case Ident(_, _):
			return isFatValueType(valueType(e))
		case Parenthesis(inner):
			return isBoxableFat(inner)
		case Dot(base, _, _):
			if isDynamic(valueType(base)) {
				return false
			}
			return isFatValueType(valueType(e))
		case _:
			return false
	} }

		}

		return '(' + [for a in args printExpression(a)].join(', ') + ')'
	/// S3b: on-demand thin wrapper for a PLAIN global function flowing to a
	/// fat position (`foo` → `foo_$thin_(void* env, args...)` ignoring env +
	/// sentinel env). One wrapper per function (F1-Q(a)); emitted into
	/// `globalFunctions`. Callers pass the wrapper ptr + sentinel (M2-safe:
	/// plain functions need no env; sentinel keeps ARC future-safe).
	var thinWrapperCache: [String : String] = [:]
	/// S3b: plain-global function type lookup (for wrapper pairs). Cached;
	/// null unless `name` is a module-level `globalFunc` (never a closure).
	var globalFuncTypeCache: [String : Type?] = [:]
	var globalFuncTypeCacheDone: [String : Bool] = [:]
	fun globalFuncType(name: String): Type? {
		if let done = globalFuncTypeCacheDone.get(name) {
			return globalFuncTypeCache.get(name)
		}
		globalFuncTypeCacheDone.set(name, true)

		for g in project.globalFuncs { switch g {
				case Function(gname, _, _, _, gfuncType, _, _):
					if gname == name {
						globalFuncTypeCache.set(name, gfuncType)
						return gfuncType
					}
			} }
		return null
	}
	/// S3b: true if a call ARG (or any value) flows to a fat position: typed
	/// function OR plain global function (wrapper pair). Centralizes the
	/// `printCallArguments`/`Virtual` expansion decision.
	fun isFatArg(e: Expression): Bool {
		if isFatValueType(valueType(e)) {
			return true
		}

		switch e {
			case Ident(name, _):
				if closureBaseName(e) != null {
					return true
				}

				if let gt = globalFuncType(name) {
					return isFatValueType(gt)
				}
			case Dot(base, name, _):
				return isFatFieldDot(base, name, getType(e))
				// S3b: an explicit `null` for a fat param splices to the null
				// pair (`nullptr` + sentinel) via `fatPtrStr`/`fatEnvStr`
				// (both have `Null` arms) — never a single cast.
			case Null(_):
				return true
			case _:
		}
		return false
	}
	fun thinWrapperFor(funcName: String): String {
		if let w = thinWrapperCache.get(funcName) {
			return w
		}
		// Look up the plain global's signature to mirror it (fat, env-first,
		// env ignored).
		var ftype: Type? = null
		for g in project.globalFuncs { switch g {
				case Function(gname, _, _, _, gfuncType, _, _):
					if gname == funcName {
						ftype = gfuncType
					}
			} }
		let ft = ftype as!Type
		var fargs: [FunctionArgument] = []
		var frets: Type = project.typer.typeAny

		switch ft {
			case Function(fa, fr, _):
				fargs = fa
				frets = fr
		}
		let retName = stringifyType(frets)
		let params: [String] = ['void* env_']
		let fwd: [String] = []

		for i in fargs.length {
			let ti = stringifyType(fargs[i].dataType)

			if ti == 'void' {
				continue
			}
			params.push(ti + ' arg' + i + '_')
			fwd.push('arg' + i + '_')
		}
		let wrapper = funcName + '$thin_'
		thinWrapperCache.set(funcName, wrapper)
		globalFunctions.push(retName + ' ' + wrapper + '(' + params.join(', ') + ') \{ return ' + funcName + '_(' + fwd.join(', ') + '); \}\n')
		return wrapper
	}

	/// S3b: fat Ident/Dot callees that are NOT lifted `closure$N` (those are
	/// handled above) — pair-held params/locals/globals and function-typed
	/// fields. Excludes `VirtualMethod` (vtable path owns method Dots).
	/// S3b: which member a Dot refers to (`Variable` field vs `Method` vs none).
	/// Centralizes the static/dynamic/struct exclusions so every Dot site
	/// agrees: only Variable fields of real classes carry fat pairs.
	fun dotFieldKind(base: Expression, name: String): ClassTypeField? {
		switch base {
			case Ident(id, _):
				if id.charAt(0) == id.charAt(0).toUpperCase(), not id.startsWith('_'), not id.startsWith('$') {
					return null
				}
			case _:
		}
		// NOTE declared types win over use-node types here: the typer coerces
		// `Any` uses to the expected type (the use node then lies about the C
		// value, which stays `Any_*`) — field lookup must key on what is
		// actually stored (see `cShape`/`valueType`).
		let bt = valueType(base)

		if bt == null {
			return null
		}
		let bt = getType(base)

		if bt == null {
			return null
		}
		// Dynamic (`Any`-shaped incl. Unknown/erased) receivers have no vtable
		// or pair slots — they route via reflection (F10). Key on the C shape:
		// `Any` is modeled as a ClassInstance whose fields map would otherwise
		// match, printing a bogus vtable/pair access on a dynamic value.
		if isDynamic(bt) {
			return null
		}
		// NOTE `kind.fields` misses `var` members the typer did not register
		// (e.g. HitBox handlers) — `fieldNames` is canonical for those.
		switch bt {
			case ClassInstance(kind, _):
				if kind.fields.get(name) == ClassTypeField.Method {
					return ClassTypeField.Method
				}

				if kind.fieldNames.includes(name) {
					return ClassTypeField.Variable
				}
				return null
			case Class(kind):
				if kind.fields.get(name) == ClassTypeField.Method {
					return ClassTypeField.Method
				}

				if kind.fieldNames.includes(name) {
					return ClassTypeField.Variable
				}
				return null
			case _:
				return null
		}
	}

	/// S3b: true if Dot(base, name) is a fat PAIR access (double slot).
	/// Methods live in the vtable (F6), statics stay thin, dynamic receivers
	/// route via reflection, and inline structs emit single members (their
	/// calls pass the env explicitly instead — see printStructDotCall).
	fun isFatFieldDot(base: Expression, name: String, memberType: Type?): Bool {
		if dotFieldKind(base, name) != ClassTypeField.Variable {
			return false
		}
		return isFatValueType(memberType)
	}

	/// S3b: true if Dot(base, name) is a method (vtable dispatch, never a pair).
	fun isMethodDot(base: Expression, name: String): Bool {
		return dotFieldKind(base, name) == ClassTypeField.Method
	}

	/// S3b: true if the callee is a call through an inline-struct
	/// function-typed field (`entry.isDirectory()` on an `interface {...}`
	/// shape). Structs emit SINGLE members, so these print thin-member +
	/// explicit env instead of pairs (until F10 pair-boxing).
	fun isStructDotCall(e: Expression): Bool { switch e {
			case Dot(base, _, _):
				switch getType(base) {
					case Struct(_, _):
						return isFatValueType(getType(e))
					case _:
				}
			case Parenthesis(inner):
				return isStructDotCall(inner)
			case _:
		}
		return false
	}

	/// S3b: struct-field call shape — thin member + explicit env first arg
	/// (`member_(env, args...)`). Env is the sentinel (struct-held closures
	/// are not pair-tracked until F10).
	fun printStructDotCall(callee: Expression, args: [Expression], derivedExpects: [Type]?): String {
		let envExpr = Expression.Ident('hexaSentinelEnv', project.typer.typeAny)
		var newExpects: [Type]? = null
		if let oe = derivedExpects {
			let ne: [Type] = [project.typer.typeAny]

			for t in oe {
				ne.push(t)
			}
			newExpects = ne
		}
		let newArgs: [Expression] = [envExpr]

		for a in args {
			newArgs.push(a)
		}
		return printExpression(callee) + printCallArguments(newArgs, newExpects)
	}

	/// S3b: effective call kind after the method redirect (unwraps Parenthesis
	/// like the callee classifiers do — IIFE-shaped callees hide the Dot).
	/// Methods typed as non-virtual still dispatch via the vtable.
	fun effCallKind(e: Expression, kind: CallKind): CallKind { switch e {
			case Parenthesis(inner):
				return effCallKind(inner, kind)
			case Dot(base, name, _):
				if kind != CallKind.VirtualMethod, isMethodDot(base, name) {
					return CallKind.VirtualMethod
				}
				return kind
			case _:
				return kind
		} }

	fun isFatCallee(e: Expression): Bool { switch e {
		case Ident(name, _):
			if closureBaseName(e) != null {
				return false
			}
			return isFatValueType(valueType(e))
		case Dot(base, name, _):
			return isFatFieldDot(base, name, getType(e))
		case Parenthesis(inner):
			return isFatCallee(inner)
		case _:
			return false
	} }

	/// S3b: pair call `ptr_(env_, args...)` reusing `printCallArguments` for
	/// the original args (markers/void-drop/pad/conversions intact) and
	/// splicing the env first. `ptr`/`env` are pre-printed C halves.
	fun printFatValueCall(callee: Expression, args: [Expression], expects: [Type]?): String {
		var ptr = ''
		var env = ''

		switch callee {
			case Ident(name, _):
				ptr = name + '$ptr_'
				env = name + '$env_'
			case Dot(expr, dname, _):
				// Function-typed field (Variable, not vtable Method — caller
				// excludes `VirtualMethod`): double slots `->$f_`/`->$e_`.
				// Base printed twice (bases are Ident/This in practice).
				let base = printExpression(expr)
				ptr = base + '->' + dname + '$f_'
				env = base + '->' + dname + '$e_'
			case Parenthesis(inner):
				return printFatValueCall(inner, args, expects)
			case _:
				return '/*UNPAIRED-CALLEE*/' + printExpression(callee) + printCallArguments(args, expects)
		}
		let tail = printCallArguments(args, expects)
		let inner = tail.substring(1, tail.length - 2)

		if inner == '' {
			return ptr + '(' + env + ') '
		}
		return ptr + '(' + env + ', ' + inner + ') '
	}
	fun printClosureFatCall(callee: Expression, args: [Expression], expects: [Type]?): String {
		let base = closureBaseName(callee) as!String
		let fatName = base + '_'
		let suffix = base.substr(8, base.length - 8)
		var envType: Type = project.typer.typeAny
		var envExpr: Expression = Expression.Ident('hexaSentinelEnv', project.typer.typeAny)

		if currentFatFn != null, currentFatFn == base {
			// Self-recursion: thread the current `$env`, not any slot.
			envExpr = Expression.Ident('$env', project.typer.typeAny)
		} else if closureHasEnv(base) {
			// Direct calls use the GLOBAL twin (always in scope; identical to
			// S2 semantics — sequential immediate use stays correct). Pair
			// bindings use the per-instance LOCAL twin where it dominates.
			let envGlobal = 'closureEnv$' + suffix

			if let gt = globalDecls.get(envGlobal) {
				envType = gt
			} else if let it = closureEnvType(base) {
				envType = it
			}
			envExpr = Expression.Ident(envGlobal, envType)
		}
		let origExpects = expectsOrDerived(expects, callee)
		var newExpects: [Type]? = null
		if let oe = origExpects {
			let ne: [Type] = [envType]

			for t in oe {
				ne.push(t)
			}
			newExpects = ne
		}
		let newArgs: [Expression] = [envExpr]

		for a in args {
			newArgs.push(a)
		}
		return fatName + printCallArguments(newArgs, newExpects)
	}

	/// S4 thunk (F10.3, additive dead code until dynamic calls wire it): fixed
	/// ABI `Any_*(void* env, Any** argv, int32 argc)` that unboxes argv with D7
	/// coercions, invokes the fat impl, boxes the result (ARC: args borrowed,
	/// return +1, env borrowed; missing->null-Any/0, extras ignored). Emitted
	/// for every lifted `closure$N` (even empty ones, env ignored) so every
	/// function-typed value is uniformly Any-callable.
	fun printClosureThunk(cName: String, funcType: Type): String {
		let base = cName.substr(0, cName.length - 1)
		let thunk = base + '$call_'
		var fargs: [FunctionArgument] = []
		var frets: Type = project.typer.typeAny

		switch funcType {
			case Function(fa, fr, _):
				fargs = fa
				frets = fr
		}
		let retName = stringifyType(frets)
		let unboxed: [String] = []
		var ai = 0

		for k in fargs.length {
			if k == 0 {
				continue
			}
			// Hexa rest (`...x: T`) is two C slots `(count, ptr)` — forward
			// the `argv_` tail zero-copy for pointer elems (all Perfide
			// rests are `Any`); scalars get `0, nullptr` (thunks are dead
			// code until F10.3 wires them — must compile, not run).
			switch fargs[k].dataType {
				case Rest(element, native):
					if native {
						continue
					}
					let elemC = stringifyType(element)

					if elemC.endsWith('*') {
						unboxed.push('((argc_ > ' + ai + ') ? (argc_ - ' + ai + ') : 0)')
						unboxed.push('((argc_ > ' + ai + ') ? (' + elemC + '*)(size_t)(argv_ + ' + ai + ') : nullptr)')
					} else {
						unboxed.push('0')
						unboxed.push('nullptr')
					}
					continue
				case _:
			}
			// Fat (function-typed) param = TWO C slots (ptr + env, static ABI).
		// Dynamic callers pass the pair as two consecutive argv entries.
		// Thunks are dead code until F10.3 wires them — must compile, not
		// run (same precedent as the Hexa-rest arm below).
		if isFatValueType(fargs[k].dataType) {
			let ptrT = stringifyType(fargs[k].dataType)
			unboxed.push('(' + ptrT + ')(size_t)(((argc_ > ' + ai + ') ? argv_[' + ai + '] : nullptr))')
			unboxed.push('((argc_ > ' + (ai + 1) + ') ? (void*)(size_t)(argv_[' + (ai + 1) + ']) : nullptr)')
			ai += 2
			continue
		}
		let ti = stringifyType(fargs[k].dataType)

			if ti == 'void' {
				continue
			}
			var u = ''

			if ti.endsWith('*') {
				u = '(' + ti + ')(size_t)(((argc_ > ' + ai + ') ? argv_[' + ai + '] : nullptr))'
			} else if ti == 'int32_t' {
				u = '((argc_ > ' + ai + ') ? Any_unboxInt_(argv_[' + ai + ']) : (int32_t)0)'
			} else if ti == 'double' or ti == 'float' {
				u = '((argc_ > ' + ai + ') ? Any_unboxFloat_(argv_[' + ai + ']) : (double)0.0)'
			} else if ti == 'Bool_' {
				u = '((argc_ > ' + ai + ') ? (argv_[' + ai + '] )->_toBool() : false_)'
			} else if ti.startsWith('_$') {
				u = '(' + ti + ')(size_t)(((argc_ > ' + ai + ') ? argv_[' + ai + '] : nullptr))'
			} else {
				u = '(' + ti + ')(((argc_ > ' + ai + ') ? Any_unboxInt_(argv_[' + ai + ']) : (' + ti + ')0))'
			}
			unboxed.push(u)
			ai++
		}
		let allArgs: [String] = ['env_']

		for u in unboxed {
			allArgs.push(u)
		}
		let call = cName + '(' + allArgs.join(', ') + ')'
		var r = 'Any_* ' + thunk + '(void* env_, Any_** argv_, int32_t argc_) \{\n'

		if retName == 'void' {
			r += call + ';\n'
			r += 'return nullptr;\n'
		} else if retName.endsWith('*') {
			r += 'return (Any_*)(size_t)(' + call + ');\n'
		} else if retName == 'int32_t' {
			r += 'return Any_boxInt_(' + call + ');\n'
		} else if retName == 'double' or retName == 'float' {
			r += 'return Any_boxFloat_(' + call + ');\n'
		} else if retName == 'Bool_' {
			r += 'return Any_fromBool(' + call + ');\n'
		} else if retName == 'int64_t' or retName == 'uint64_t' {
			r += 'return Any_boxInt_(' + call + ');\n'
		} else {
			r += 'return (Any_*)(size_t)(' + call + ');\n'
		}
		r += '\}\n\n'
		return r
	}

	/// F10.3 pair-boxing runtime + `{impl, call}` registry (emitted post-Types
	/// with the coroutines block — needs no bodies, just the thunk names
	/// collected above). A fat value boxed into `Any` becomes a heap record
	/// `{tag, impl, env}` (first word is the tag vtable, like every object);
	/// the dynamic call slot unpacks it. Scalar `Any`s stay untouched (D7
	/// real boxing later); unregistered impls (plain globals, thin wrappers)
	/// keep the legacy no-op proxy. ARC: pairs leak like every other Phase-1
	/// heap object (F11).
	fun printFatPairs(): String {
		var r = '// F10.3 fat-pair boxing (replaces env-dropping `Any` casts)\n'
		r += 'struct FatPair__ \{ uint8_t _x_; \};\n'
		r += 'const struct FatPair__ FatPair__$ = \{0\};\n'
		r += 'struct FatPair_ \{ const struct FatPair__* _; void (*impl_)(); void* env_; \};\n'
		r += 'Any_* Any_boxFatPair_(void (*impl)(), void* env) \{ FatPair_* p = (FatPair_*)(HEXA_NEW(sizeof(FatPair_))); p->_ = &FatPair__$; p->impl_ = impl; p->env_ = env; return (Any_*)(p); \}\n'
		r += 'uint8_t Any_isFatPair_(Any_* p) \{ if (p == nullptr) return (uint8_t)0; if ((int64_t)(p) >= -65535 && (int64_t)(p) <= 65535) return (uint8_t)0; return (uint8_t)(((const void**)(p))[0] == (const void*)(&FatPair__$)) ? 1 : 0; \}\n'
		r += 'struct FatPairCallEntry_ \{ void (*impl_)(); Any_* (*call_)(void*, Any_**, int32_t); \};\n'

		if fatPairImpls.length == 0 {
			r += 'static Any_* (*FatPair_lookupCall_(void)) (void*, Any_**, int32_t);\n'
			r += 'static Any_* (*FatPair_lookupCall_(void)) (void*, Any_**, int32_t) \{ return nullptr; \}\n'
			return r
		}

		for n in fatPairImpls {
			r += 'Any_* ' + n + '$call_(void*, Any_**, int32_t);\n'
		}
		var rows: [String] = []

		for n in fatPairImpls {
			rows.push('\{(void(*)())(' + n + '_), ' + n + '$call_\}')
		}

		if rows.length == 0 {
			rows.push('\{nullptr, nullptr\}')
		}
		r += 'static const struct FatPairCallEntry_ fatPairCalls_[] = \{' + rows.join(', ') + '\};\n'
		r += 'static Any_* (*FatPair_lookupCall_(void (*impl)()))(void*, Any_**, int32_t) \{ for (size_t i = 0; i < sizeof(fatPairCalls_)/sizeof(fatPairCalls_[0]); i++) \{ if (fatPairCalls_[i].impl_ != nullptr && fatPairCalls_[i].impl_ == impl) return fatPairCalls_[i].call_; \} return nullptr; \}\n'
		return r
	}

	/// D7 scalar boxing (real values replace the null stubs): heap boxes with
	/// tag vtables, first word like every object. All unboxers are total and
	/// never AV: null reads as default; small ints (incl. negatives — legacy
	/// int-as-pointer placeholders) read as values, so no deref; Bool
	/// singletons compare by identity (empty structs carry no tag); only
	/// valid heap objects reach the tag deref. FatPair_ reads as non-scalar
	/// default (pairs are functions, not numbers). `String__$` doubles as the
	/// string detector for `Any_unboxString_` (real strings pass through;
	/// scalars format; everything else keeps the `"null"` placeholder).
	fun printScalarBoxing(): String {
		var r = '// D7 scalar boxing (real `Any` payloads for ints/floats)\n'
		r += 'struct AnyInt__ \{ uint8_t _x_; \};\n'
		r += 'const struct AnyInt__ AnyInt__$ = \{0\};\n'
		r += 'struct AnyInt_ \{ const struct AnyInt__* _; int32_t rc_; int64_t v_; \};\n'
		r += 'struct AnyFloat__ \{ uint8_t _x_; \};\n'
		r += 'const struct AnyFloat__ AnyFloat__$ = \{0\};\n'
		r += 'struct AnyFloat_ \{ const struct AnyFloat__* _; double v_; \};\n'
		r += 'Any_* Any_boxInt_(int64_t v) \{ AnyInt_* b = (AnyInt_*)(HEXA_NEW(sizeof(AnyInt_))); b->_ = &AnyInt__$; b->v_ = v; return (Any_*)(b); \}\n'
		r += 'Any_* Any_boxFloat_(double v) \{ AnyFloat_* b = (AnyFloat_*)(HEXA_NEW(sizeof(AnyFloat_))); b->_ = &AnyFloat__$; b->v_ = v; return (Any_*)(b); \}\n'
		r += 'int32_t Any_unboxInt_(Any_* p) \{ if (p == nullptr) return (int32_t)0; if (p == (Any_*)(&_true)) return (int32_t)1; if (p == (Any_*)(&_false)) return (int32_t)0; if ((int64_t)(p) >= -65535 && (int64_t)(p) <= 65535) return (int32_t)(int64_t)(p); if (((const void**)(p))[0] == (const void*)(&AnyInt__$)) return (int32_t)(((AnyInt_*)(p))->v_); if (((const void**)(p))[0] == (const void*)(&AnyFloat__$)) return (int32_t)(((AnyFloat_*)(p))->v_); return (int32_t)0; \}\n'
		r += 'int64_t Any_unboxInt64_(Any_* p) \{ if (p == nullptr) return (int64_t)0; if (p == (Any_*)(&_true)) return (int64_t)1; if (p == (Any_*)(&_false)) return (int64_t)0; if ((int64_t)(p) >= -65535 && (int64_t)(p) <= 65535) return (int64_t)(p); if (((const void**)(p))[0] == (const void*)(&AnyInt__$)) return ((AnyInt_*)(p))->v_; if (((const void**)(p))[0] == (const void*)(&AnyFloat__$)) return (int64_t)(((AnyFloat_*)(p))->v_); return (int64_t)0; \}\n'
		r += 'double Any_unboxFloat_(Any_* p) \{ if (p == nullptr) return (double)0.0; if (p == (Any_*)(&_true)) return (double)1.0; if (p == (Any_*)(&_false)) return (double)0.0; if ((int64_t)(p) >= -65535 && (int64_t)(p) <= 65535) return (double)(int64_t)(p); if (((const void**)(p))[0] == (const void*)(&AnyFloat__$)) return ((AnyFloat_*)(p))->v_; if (((const void**)(p))[0] == (const void*)(&AnyInt__$)) return (double)(((AnyInt_*)(p))->v_); return (double)0.0; \}\n'
		r += 'String_* Any_$toString_(Any_*);\n'
		r += 'String_* String_$fromInt32_(int32_t);\n'
		r += 'String_* String_$fromFloat_(double);\n'
		r += 'String_* Any_unboxString_(Any_* p) \{ if (p == nullptr) return Any_$toString_(p); if (p == (Any_*)(&_true)) return Any_$toString_(p); if (p == (Any_*)(&_false)) return Any_$toString_(p); if ((int64_t)(p) >= -65535 && (int64_t)(p) <= 65535) return String_$fromInt32_((int32_t)(int64_t)(p)); if (((const void**)(p))[0] == (const void*)(&String__$)) return (String_*)(p); if (((const void**)(p))[0] == (const void*)(&AnyInt__$)) return String_$fromInt32_((int32_t)(((AnyInt_*)(p))->v_)); if (((const void**)(p))[0] == (const void*)(&AnyFloat__$)) return String_$fromFloat_((double)(((AnyFloat_*)(p))->v_)); return Any_$toString_(p); \}\n'
		return r
	}

	/// F10.2 plain-object bags: `AnyObject_` heap records (first word is the
	/// tag vtable, like every object) holding parallel key/value entries.
	/// Object literals into `Any` slots construct these via `printObjectAs`
	/// (no more `Object_from` null stubs); `Any_dynGet_`/`Any_dynSet_` route
	/// dynamic member access here, everything else keeps the legacy proxy.
	/// Key compare is content-based (length + UTF-16 units). Growth leaks the
	/// old buffer like every other Phase-1 heap object (F11).
	fun printAnyObject(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// F10.2 plain-object bags (AnyObject_ heap records)' + nl
		r += 'struct AnyObject__ ' + lb + ' uint8_t _x_; ' + rb + ';' + nl
		r += 'const struct AnyObject__ AnyObject__$ = ' + lb + '0' + rb + ';' + nl
		r += 'struct AnyObjectEntry_ ' + lb + ' String_* k_; Any_* v_; ' + rb + ';' + nl
		r += 'struct AnyObject_ ' + lb + ' const struct AnyObject__* _; int32_t count_; int32_t cap_; struct AnyObjectEntry_* entries_; ' + rb + ';' + nl
		r += 'Any_* Any_objectNew_() ' + lb + ' AnyObject_* o = (AnyObject_*)(HEXA_NEW(sizeof(AnyObject_))); o->_ = &AnyObject__$; o->count_ = (int32_t)0; o->cap_ = (int32_t)0; o->entries_ = nullptr; return (Any_*)(o); ' + rb + nl
		r += 'uint8_t Any_objectStringEquals_(String_* a, String_* b) ' + lb + ' if (a == b) return (uint8_t)1; if (a == nullptr || b == nullptr) return (uint8_t)0; if (a->length_ != b->length_) return (uint8_t)0; for (int32_t i = (int32_t)0; i < a->length_; i++) ' + lb + ' if (a->bytes_[i] != b->bytes_[i]) return (uint8_t)0; ' + rb + ' return (uint8_t)1; ' + rb + nl
		r += 'int32_t Any_objectFind_(AnyObject_* o, String_* k) ' + lb + ' if (o == nullptr || k == nullptr) return (int32_t)-1; for (int32_t i = (int32_t)0; i < o->count_; i++) ' + lb + ' if (Any_objectStringEquals_(o->entries_[i].k_, k)) return i; ' + rb + ' return (int32_t)-1; ' + rb + nl
		r += 'void Any_objectSet_(Any_* p, String_* k, Any_* v) ' + lb + ' if (p == nullptr || k == nullptr) return; if (((const void**)(p))[0] != (const void*)(&AnyObject__$)) return; AnyObject_* o = (AnyObject_*)(p); int32_t at = Any_objectFind_(o, k); if (at >= (int32_t)0) ' + lb + ' o->entries_[at].v_ = v; return; ' + rb + ' if (o->count_ >= o->cap_) ' + lb + ' int32_t ncap = o->cap_ <= (int32_t)0 ? (int32_t)4 : o->cap_ * (int32_t)2; struct AnyObjectEntry_* ne = (struct AnyObjectEntry_*)(HEXA_NEW(sizeof(struct AnyObjectEntry_) * ncap)); for (int32_t i = (int32_t)0; i < o->count_; i++) ' + lb + ' ne[i].k_ = o->entries_[i].k_; ne[i].v_ = o->entries_[i].v_; ' + rb + ' o->entries_ = ne; o->cap_ = ncap; ' + rb + ' o->entries_[o->count_].k_ = k; o->entries_[o->count_].v_ = v; o->count_++; ' + rb + nl
		r += 'Any_* Any_objectGet_(Any_* p, String_* k) ' + lb + ' if (p == nullptr || k == nullptr) return nullptr; if (((const void**)(p))[0] != (const void*)(&AnyObject__$)) return nullptr; AnyObject_* o = (AnyObject_*)(p); int32_t at = Any_objectFind_(o, k); if (at >= (int32_t)0) return o->entries_[at].v_; return nullptr; ' + rb + nl
		r += 'uint8_t Any_isObject_(Any_* p) ' + lb + ' if (p == nullptr) return (uint8_t)0; if ((int64_t)(p) >= (int64_t)-65535 && (int64_t)(p) <= (int64_t)65535) return (uint8_t)0; return (uint8_t)((((const void**)(p))[0] == (const void*)(&AnyObject__$)) ? 1 : 0); ' + rb + nl
		r += 'int32_t Any_objectCount_(Any_* p) ' + lb + ' if (Any_isObject_(p) == (uint8_t)0) return (int32_t)0; return ((AnyObject_*)(p))->count_; ' + rb + nl
		r += 'String_* Any_objectKeyAt_(Any_* p, int32_t i) ' + lb + ' if (Any_isObject_(p) == (uint8_t)0) return nullptr; AnyObject_* o = (AnyObject_*)(p); if (i < (int32_t)0 || i >= o->count_) return nullptr; return o->entries_[i].k_; ' + rb + nl
		r += 'Any_* Any_dynGet_(Any_* p, String_* k) ' + lb + ' if (p == nullptr) return nullptr; if (Any_isObject_(p)) return Any_objectGet_(p, k); return (Any_*)(((Any_*)(p))->let_(k)); ' + rb + nl
		r += 'void Any_dynSet_(Any_* p, String_* k, Any_* v) ' + lb + ' if (p == nullptr) return; if (Any_isObject_(p)) ' + lb + ' Any_objectSet_(p, k, v); return; ' + rb + ' ((Any_*)(p))->$set(k, v); ' + rb + nl
		return r
	}

	/// ARC destroy registry: one row per `@destructor` class (vtable tag,
	/// destroy fn, instance size) plus a tag lookup for the future F11 sweep.
	/// Always emitted (lone null row when empty) so the sweep links blindly.
	/// (Braces ride via fromCharCode like the neighboring runtime printers —
	/// never as escapes, which misparse in this position.)
	fun printDestroyTable(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// ARC destroy registry (tag -> destructor, F11 sweep reads it)' + nl
		r += 'struct HexaDestroyEntry_ ' + lb + ' const void* tag_; void (*destroy_)(void*); size_t size_; ' + rb + ';' + nl
		r += 'static const struct HexaDestroyEntry_ hexaDestroyTable_[] = ' + lb

		if destroyTable.length == 0 {
			r += lb + 'nullptr, nullptr, 0' + rb
		} else {
			r += destroyTable.join(', ')
		}
		r += rb + ';' + nl
		r += 'static void (*HexaDestroyLookup_(const void* tag))(void*) ' + lb + ' for (size_t i_ = 0; i_ < sizeof(hexaDestroyTable_)/sizeof(hexaDestroyTable_[0]); i_++) ' + lb + ' if (hexaDestroyTable_[i_].tag_ != nullptr && hexaDestroyTable_[i_].tag_ == tag) return hexaDestroyTable_[i_].destroy_; ' + rb + ' return nullptr; ' + rb + nl
		return r
	}

	/// F11 live-object registry (side table — the host mirrors Hexa layouts,
	/// so no intrusive link may be added to instance headers). `$new_`
	/// registers every vtable-managed birth after `$this_` completes (a
	/// registered object is always fully constructed); boxes register at
	/// creation. Nothing reads the table yet (sweep + census land next).
	fun printLiveRegistry(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// F11 live-object registry (side table, host-mirror safe)' + nl
		r += 'static void** hexaLiveList_ = nullptr;' + nl
		r += 'static size_t hexaLiveNum_ = 0;' + nl
		r += 'static size_t hexaLiveCap_ = 0;' + nl
		// F11 pressure trigger (alloc-path sweep): managed births drive the
		// sweep, so bursty allocators can't outrun the 600-pump cadence.
		// Prototype rides here (hexaSweep is defined later in this TU);
		// the sweep's own sweeping_ guard makes nested triggers (user
		// @destructors that allocate) safe no-ops. Mode 4 (off) still pays
		// a scan per interval — acceptable for a manual triage mode.
		r += 'void hexaSweep(void);' + nl
		r += 'static size_t hexaAllocSinceSweep_ = 0;' + nl
		r += 'void hexaRegisterLive_(void* p) ' + lb + ' if (p == nullptr) return; if (hexaLiveNum_ >= hexaLiveCap_) ' + lb + ' size_t ncap = hexaLiveCap_ == (size_t)0 ? (size_t)4096 : hexaLiveCap_ * (size_t)2; void** nn = (void**)(HEXA_NEW(sizeof(void*) * ncap)); for (size_t i = (size_t)0; i < hexaLiveNum_; i++) nn[i] = hexaLiveList_[i]; if (hexaLiveList_ != nullptr) HEXA_FREE(hexaLiveList_, sizeof(void*) * hexaLiveCap_); hexaLiveList_ = nn; hexaLiveCap_ = ncap; ' + rb + ' hexaLiveList_[hexaLiveNum_] = p; hexaLiveNum_++; if (++hexaAllocSinceSweep_ >= (size_t)8192) ' + lb + ' hexaAllocSinceSweep_ = 0; hexaSweep(); ' + rb + rb + nl
		r += 'size_t hexaLiveCount_(void) ' + lb + ' return hexaLiveNum_; ' + rb + nl
		r += 'void hexaSweepCensus(void) ' + lb + ' size_t live_ = hexaLiveNum_; size_t zero_ = (size_t)0; size_t null_ = (size_t)0; size_t stringLive_ = (size_t)0; size_t stringBytes_ = (size_t)0; for (size_t i_ = (size_t)0; i_ < hexaLiveNum_; i_++) ' + lb + ' void* p_ = hexaLiveList_[i_]; if (p_ == nullptr) continue; int64_t v_ = (int64_t)p_; if (v_ >= (int64_t)-65535 && v_ <= (int64_t)65535) continue; const void* tag_ = ((const void**)(p_))[0]; if (tag_ == nullptr) ' + lb + ' null_++; continue; ' + rb + ' if (tag_ == (const void*)(&String__$)) ' + lb + ' stringLive_++; stringBytes_ += (size_t)(((String_*)(p_))->bytesLength_); ' + rb + ' if (((const struct HexaHeader_*)(p_))->rc_ == (int32_t)0) zero_++; ' + rb + ' FILE* f_ = fopen("sweep-census.log", "a"); if (f_ != nullptr) ' + lb + ' fprintf(f_, "sweep-census live=%llu zero=%llu nullTag=%llu stringLive=%llu stringBytes=%llu", (unsigned long long)live_, (unsigned long long)zero_, (unsigned long long)null_, (unsigned long long)stringLive_, (unsigned long long)stringBytes_); fputc(10, f_); fclose(f_); ' + rb + rb + nl
		return r
	}

	/// Sweep victim-class names (diagnostic): one `if` per vtable-managed
	/// class so the sweep can log WHO it frees (first victims per sweep).
	/// Same vtable predicate as the class printer (structs/unions/native
	/// layouts have no `__$` tag global and are skipped).
	fun printTagNames(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// Sweep victim-class names (diagnostic, first freed per sweep)' + nl
		r += 'static const char* hexaTagName_(const void* tag_) ' + lb + nl

		for n in vtableClasses {
			r += 'if (tag_ == (const void*)(&' + n + '__$)) return "' + n + '";' + nl
		}
		r += 'return "?";' + nl
		r += rb + nl
		return r
	}

	/// F11 sweep v1 (deferred free, D6): scans the live side-table and frees
	/// every `rc == 0` entry (destroy via `HexaDestroyLookup_`, then `HEXA_FREE`;
	/// `AnyObject_` bags free their entry buffer inline — boxes have no table
	/// row and no other inner heap). Swap-remove compacts the list, so a second
	/// sweep never re-frees. Null/immediate/null-tag entries are compacted or
	/// skipped (leak, safe). Re-entrancy guard (destroys only `hexaUnref` + free,
	/// never allocate — belt-and-braces). Called from Hexa `timerPump()` next to
	/// the census — never from the alloc path, so no `HEXA_NEW` re-entry.
	/// Layout note: this section emits AFTER Global variables (`AnyObject_`
	/// must be a complete type for the inline entry-buffer free).
	/// `HEXA_SWEEP_MODE` bisect (diagnostic): 0 = DEFAULT, full incl. strings
	/// (previously menubar UAF — shared interned literals freed while
	/// referenced; ARC now pins every share: immortal globals/statics,
	/// constructor-lowered field defaults, guarded transfers — under test).
	/// 1 = retire `String` objects from the live set without
	/// destroying/freeing them (bucket stays valid for future interns, object
	/// stays mapped for any outstanding referrer — the D2 "interned globals
	/// are immortal" rule made operational; the old bisect mode, kept for
	/// triage). 2 = skip arrays, 3 =
	/// destroy-less only, 4 = off (log only). Latched once per process.
	/// Pressure trigger: every 8192nd managed birth also sweeps (alloc-path
	/// hook in `hexaRegisterLive_`, same TU) so bursty allocators can't
	/// outrun the 600-pump cadence.
	fun printSweep(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// F11 sweep (deferred free of rc==0 live entries, D6)' + nl
		// Per-sweep memory (taskmgr-comparable): WorkingSet + PagefileUsage via
		// K32 (kernel32, no psapi dep — same pattern as the prologue imports).
		// Logged on EVERY sweep so the file shows the reclaim timeline even
		// when the frame pump never runs (headless smoke). Layout is the
		// documented PROCESS_MEMORY_COUNTERS (64-bit): cb@0, faults@4,
		// peakWS@8, WS@16, quotaPeakPaged@24, quotaPaged@32, quotaPeakNonPaged
		// @40, quotaNonPaged@48, pagefile@56, peakPagefile@64 (72 bytes).
		r += 'struct HexaMemCounters_ ' + lb + ' unsigned long cb_; unsigned long pageFaults_; unsigned long long peakWs_; unsigned long long ws_; unsigned long long quotaPeakPaged_; unsigned long long quotaPaged_; unsigned long long quotaPeakNonPaged_; unsigned long long quotaNonPaged_; unsigned long long pagefile_; unsigned long long pagefilePeak_; ' + rb + ';' + nl
		r += '__declspec(dllimport) int K32GetProcessMemoryInfo(void* hProcess, void* ppsmemCounters, unsigned long cb);' + nl
		r += '__declspec(dllimport) void* GetCurrentProcess(void);' + nl
		r += 'static const void* hexaArrayTags_[] = ' + lb

		if arrayDestroyTags.length == 0 {
			r += 'nullptr'
		} else {
			var rows: [String] = []

			for n in arrayDestroyTags { rows.push('(const void*)&' + n + '__$') }
			r += rows.join(', ')
		}
		r += rb + ';' + nl
		r += 'static uint8_t hexaTagIsArray_(const void* tag_) ' + lb + ' for (size_t i_ = (size_t)0; i_ < sizeof(hexaArrayTags_)/sizeof(hexaArrayTags_[0]); i_++) ' + lb + ' if (hexaArrayTags_[i_] != nullptr && hexaArrayTags_[i_] == tag_) return (uint8_t)1; ' + rb + ' return (uint8_t)0; ' + rb + nl
		r += 'void hexaSweep(void) ' + lb + nl
		r += 'static uint8_t sweeping_ = 0;' + nl
		r += 'if (sweeping_ != (uint8_t)0) return;' + nl
		r += 'sweeping_ = 1;' + nl
		r += 'static int mode_ = -1;' + nl
		r += 'if (mode_ < 0) ' + lb + ' mode_ = 0; const char* e_ = getenv("HEXA_SWEEP_MODE"); if (e_ != nullptr) mode_ = atoi(e_); ' + rb + nl
		r += 'static int victims_ = 0; victims_ = 0;' + nl
		r += 'size_t freed_ = (size_t)0;' + nl
		r += 'size_t strLive_ = (size_t)0;' + nl
		r += 'size_t strBytes_ = (size_t)0;' + nl
		r += 'size_t strMax_ = (size_t)0;' + nl
		r += 'size_t strBig_ = (size_t)0;' + nl
		r += 'size_t i_ = (size_t)0;' + nl
		r += 'while (i_ < hexaLiveNum_) ' + lb + nl
		r += 'void* p_ = hexaLiveList_[i_];' + nl
		r += 'if (p_ == nullptr) ' + lb + ' hexaLiveNum_--; if (i_ < hexaLiveNum_) hexaLiveList_[i_] = hexaLiveList_[hexaLiveNum_]; continue; ' + rb + nl
		r += 'int64_t v_ = (int64_t)p_;' + nl
		r += 'if (v_ >= (int64_t)-65535 && v_ <= (int64_t)65535) ' + lb + ' hexaLiveNum_--; if (i_ < hexaLiveNum_) hexaLiveList_[i_] = hexaLiveList_[hexaLiveNum_]; continue; ' + rb + nl
		r += 'const void* tag_ = ((const void**)(p_))[0];' + nl
		r += 'if (tag_ == (const void*)(&String__$)) ' + lb + ' strLive_++; strBytes_ += (size_t)(((String_*)(p_))->bytesLength_); if ((size_t)(((String_*)(p_))->bytesLength_) > strMax_) strMax_ = (size_t)(((String_*)(p_))->bytesLength_); if ((size_t)(((String_*)(p_))->bytesLength_) >= (size_t)1048576) strBig_++; ' + rb + nl
		r += 'if (tag_ == nullptr) ' + lb + ' i_++; continue; ' + rb + nl
		r += 'if (((const struct HexaHeader_*)(p_))->rc_ != (int32_t)0) ' + lb + ' i_++; continue; ' + rb + nl
		r += 'if (mode_ == 4) ' + lb + ' i_++; continue; ' + rb + nl
		r += 'if (mode_ == 1 && tag_ == (const void*)(&String__$)) ' + lb + ' hexaLiveNum_--; if (i_ < hexaLiveNum_) hexaLiveList_[i_] = hexaLiveList_[hexaLiveNum_]; continue; ' + rb + nl
		r += 'if (mode_ == 2 && hexaTagIsArray_(tag_)) ' + lb + ' i_++; continue; ' + rb + nl
		r += 'if (mode_ == 3) ' + lb + ' void (*dd_)(void*) = HexaDestroyLookup_(tag_); if (dd_ != nullptr) ' + lb + ' i_++; continue; ' + rb + ' ' + rb + nl
		r += 'if (victims_ < 64) ' + lb + ' victims_++; FILE* vf_ = fopen("sweep-census.log", "a"); if (vf_ != nullptr) ' + lb + ' fprintf(vf_, "sweep-victim %s %p", hexaTagName_(tag_), p_); if (tag_ == (const void*)(&String__$)) ' + lb + ' String_* s_ = (String_*)(p_); fprintf(vf_, " len=%d head=", (int)s_->length_); int32_t n_ = s_->length_ < (int32_t)12 ? s_->length_ : (int32_t)12; for (int32_t k_ = (int32_t)0; k_ < n_; k_++) fprintf(vf_, "%04x ", (unsigned)(s_->bytes_[k_])); int32_t bi_ = (int32_t)(s_->bytesHash_ % 65536); if (bi_ < (int32_t)0) bi_ += (int32_t)65536; uint8_t inb_ = (uint8_t)0; uint8_t ishead_ = (uint8_t)0; String_* cur_ = stringBuckets_[bi_]; if (cur_ == s_) ishead_ = (uint8_t)1; int32_t guard_ = (int32_t)0; while (cur_ != nullptr && guard_ < (int32_t)1000000) ' + lb + ' if (cur_ == s_) ' + lb + ' inb_ = (uint8_t)1; break; ' + rb + ' cur_ = cur_->next_; guard_++; ' + rb + ' fprintf(vf_, " inbucket=%d ishead=%d", (int)inb_, (int)ishead_); ' + rb + ' fputc(10, vf_); fclose(vf_); ' + rb + ' ' + rb + nl
		r += 'if (tag_ == (const void*)(&AnyObject__$)) ' + lb + ' AnyObject_* o_ = (AnyObject_*)(p_); if (o_->entries_ != nullptr) ' + lb + ' for (size_t j_ = (size_t)0; j_ < (size_t)o_->count_; j_++) ' + lb + ' if (Any_isCounted_((Any_*)(o_->entries_[j_].k_))) hexaUnref((void*)(o_->entries_[j_].k_)); if (Any_isCounted_(o_->entries_[j_].v_)) hexaUnref((void*)(o_->entries_[j_].v_)); ' + rb + ' HEXA_FREE(o_->entries_, 0); ' + rb + ' ' + rb + ' else if (tag_ == (const void*)(&FatPair__$)) ' + lb + ' FatPair_* fp_ = (FatPair_*)(p_); if (fp_->env_ != nullptr && !((int64_t)(fp_->env_) >= (int64_t)-65535 && (int64_t)(fp_->env_) <= (int64_t)65535)) hexaUnref(fp_->env_); ' + rb + ' else ' + lb + ' void (*d_)(void*) = HexaDestroyLookup_(tag_); if (d_ != nullptr) d_(p_); ' + rb + nl
		r += 'HEXA_FREE(p_, 0);' + nl
		r += 'hexaLiveNum_--;' + nl
		r += 'if (i_ < hexaLiveNum_) hexaLiveList_[i_] = hexaLiveList_[hexaLiveNum_];' + nl
		r += 'freed_++;' + nl
		r += rb + nl
		r += 'FILE* f_ = fopen("sweep-census.log", "a");' + nl
		r += 'if (f_ != nullptr) ' + lb + ' struct HexaMemCounters_ mc_; mc_.cb_ = (unsigned long)sizeof(struct HexaMemCounters_); unsigned long long rssMB_ = (unsigned long long)0; unsigned long long comMB_ = (unsigned long long)0; if (K32GetProcessMemoryInfo(GetCurrentProcess(), (void*)&mc_, (unsigned long)sizeof(struct HexaMemCounters_))) ' + lb + ' rssMB_ = mc_.ws_ / ((unsigned long long)1048576); comMB_ = mc_.pagefile_ / ((unsigned long long)1048576); ' + rb + ' fprintf(f_, "sweep mode=%d freed=%llu live=%llu rssMB=%llu committedMB=%llu strLive=%llu strBytes=%llu strMax=%llu strBig=%llu", mode_, (unsigned long long)freed_, (unsigned long long)hexaLiveNum_, rssMB_, comMB_, (unsigned long long)strLive_, (unsigned long long)strBytes_, (unsigned long long)strMax_, (unsigned long long)strBig_); fputc(10, f_); fclose(f_); ' + rb + nl
		r += 'sweeping_ = (uint8_t)0;' + nl
		r += rb + nl
		return r
	}

	/// F10.3 dynamic call slot: replaces the `AnyValue_` no-op proxy when the
	/// callee carries a boxed fat pair. Boxed args evaluate once into a stack
	/// argv (scalars box via `Any_box*` — pointers pass through); pairs
	/// dispatch via the thunk registry, everything else keeps the legacy
	/// proxy (observably identical — the proxy ignores arguments).
	/// Temps hoist to the enclosing statement via metaBlock (Elvis pattern).
	fun printDynamicCall(callee: Expression, args: [Expression], expects: [Type]?): String {
		// Bare function designators are directly callable (plain globals by
		// name, lifted closures via their thin wrappers) — no `Any`
		// conversion involved, so keep the normal typed call (status quo).
		if isBareFunctionDesignator(callee) {
			return printExpression(callee) + printCallArguments(args, expects)
		}
		let t = tempId++
		let ftmp = '_$ft' + t
		let fargv = '_$fa' + t
		let fres = '_$fr' + t
		let fok = '_$fok' + t
		metaBlock.push('Any_* ' + ftmp + ' = ' + printExpression(callee))
		var boxes: [String] = []

		for a in args {
			// F10.2: object literals into `Any` build real bags (same as
			// every other `Any`-shaped binding site, see printObjectAs).
			if let objArg = printObjectAs(project.typer.typeAny, a) {
				boxes.push(objArg)
			} else if isBoxableFat(a) {
				boxes.push('Any_boxFatPair_((void(*)())(' + fatPtrStr(a) + '), ' + fatEnvStr(a) + ')')
			} else {
				boxes.push(printToAnyConverter(printExpression(a), valueType(a)))
			}
		}
		var argvUse = 'nullptr'

		if boxes.length > 0 {
			metaBlock.push('Any_* ' + fargv + '[] = \{' + boxes.join(', ') + '\}')
			argvUse = fargv
		}
		metaBlock.push('Any_* ' + fres + ' = nullptr')
		metaBlock.push('uint8_t ' + fok + ' = 0')
		metaBlock.push('if (Any_isFatPair_(' + ftmp + ')) \{ FatPair_* fp = (FatPair_*)(' + ftmp + '); Any_* (*fc)(void*, Any_**, int32_t) = FatPair_lookupCall_(fp->impl_); if (fc != nullptr) \{ ' + fres + ' = fc(fp->env_, ' + argvUse + ', ' + args.length + '); ' + fok + ' = 1; \} \}')
		var refs: [String] = []

		for i in args.length {
			refs.push(fargv + '[' + i + ']')
		}
		var legacy = 'AnyValue_\{' + ftmp + '\}(' + refs.join(', ') + ')'
		return '(' + fok + ' ? ' + fres + ' : ' + legacy + ')'
	}

	fun printCallArgumentsVirtual(me: String, args: [Expression], expects: [Type]? = null) {
		if args.length == 0 {
			return '(' + me + ')'
			if let exp = expects, let restElem = hexaRestElement(exp) {
				return printHexaRestCall(args, exp, restElem, me)
			}
		}

		if let exp = expects {
			return '(' + me + ', ' + [for i in args.length
				printTypeConverter(printExpression(args[i]), getType(args[i]), exp[i])
			].join(', ') + ')'
		}

		return '(' + me + ', ' + [for a in args printExpression(a)].join(', ') + ')'
	}

	fun getFunctionReturnType(funcType: Type): Type? { switch funcType {
			case Function(args, returns):
				return returns
			case _:
				return null
		} }

	fun printFunctionReturnType(funcType: Type): String { switch funcType {
			case Function(args, returns):
				return stringifyType(returns)
			case _:
				return 'void'
	/// F9 linkage: async funs are C++ (coroutines; `co_await`/`co_return`
	/// require C++ linkage — `extern "C"` coroutines are ill-formed), rest
	/// stay C (direct host links without pragma aliasing — pragma only covers
	/// `__imp_` DLL thunks). Outer `extern "C" {` wrapper is retained for
	/// variables/prototypes; functions carry explicit linkage (inner wins).
	/// Callers resolve via updated forwards (mangled→mangled match); C++ async
	/// calling C sync (via outer-C protos) and C calling C++ async (via C++
	/// forwards) are both legal. No host changes (host only calls C entry
	/// points: `HEXA_MAIN`, sync `__onNative*`).
	fun linkagePrefix(isAsync: Bool): String {
		if isAsync { return 'HEXA_CPP ' }
		return 'HEXA_C '
	}

	/// F9: `async fun f(): T` emits `Promise<T>* f()` (C++ coroutine returning
	/// a settled-or-pending `Promise*`; `await` co_awaits it). `T=Void` maps
	/// to `Promise<void>*` (`Promise_$void_*`, value still `Any?*`). Uses
	/// `typePromise` (set when `class Promise<T>` registers, before user code).
	/// Nullable unwraps to the inner layout (`Promise<Any?>` -> `Promise<Any>`,
	/// same `Any_*` pointer, js-identical) so no `Null$` Promise structs are
	/// minted (their generic instances never fill, hence C2027/C2065).
	/// Idempotent: already-`Promise` passes through (typer now wraps async
	/// returns, so `printAsyncReturnType` sees `Promise<T>` directly).
	fun promiseOf(t: Type): Type {
		switch t {
			case ClassInstance(c, g):
				if c.name == 'Promise', g != null, g.length == 1 {
					return t
				}
			case _:
		}

		switch t {
			case Nullable(inner):
				return Type.ClassInstance(project.typer.typePromise, [Type.unwrapNullable(inner)])
			case UnknownNullable(handle):
				if handle.value != null {
					return Type.ClassInstance(project.typer.typePromise, [Type.unwrapNullable(handle.value)])
				}
				return Type.ClassInstance(project.typer.typePromise, [project.typer.typeAny])
			case null:
				return Type.ClassInstance(project.typer.typePromise, [project.typer.typeAny])
			case _:
				return Type.ClassInstance(project.typer.typePromise, [t])
		}
	}
	fun printAsyncReturnType(funcType: Type): String { switch funcType {
			case Function(args, returns):
				return stringifyType(promiseOf(returns))
			case _:
				return stringifyType(promiseOf(project.typer.typeVoid))
		} }

	fun printToAnyConverter(string: String, fromType: Type): String {
		if fromType == project.typer.typeAny {
			return '/*Any*/' + string
	/// F9: one inner `extern "C++"` block after Types (structs complete for
	/// `sizeof`, before async funs needing traits). Per collected `Promise_X_`:
	/// global `operator co_await`, `HexaPromiseType_X` (vtable init, settled
	/// `return_value(Any_*)`/`return_void()`), `std::coroutine_traits` partial
	/// spec (any args: `this`, env-first closures, methods). `HEXA_CPP`
	/// linkage (C++), zero host edits (callers resolve via updated C++ forwards).
	fun printCoroutines(): String {
		if promiseStructs.length == 0 {
			return ''
		}
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '#ifdef __cplusplus' + nl
		r += 'extern "C++" ' + lb + nl

		for s in promiseStructs {
			r += 'HEXA_PROMISE_CORO(' + s + ')' + nl
		}
		r += rb + ' // extern "C++"' + nl
		r += '#endif' + nl
		return r
	}

	/// Scalar-receiver `toString` (e.g. `(n ?? 0).toString()` on `Int`): vtable
	/// dispatch (`int->_->toString_`) is invalid C — emit the matching
	/// `String_$from*` conversion helper instead (radix args are dropped:
	/// decimal only in Phase 1). Returns null for non-scalar receivers so
	/// the normal vtable path applies
	fun scalarToString(receiverPrinted: String, receiverShape: String): String? {
		if receiverShape == 'int32_t' {
			return 'String_$fromInt32_(' + receiverPrinted + ')'
		}

		if receiverShape == 'int64_t' {
			return 'String_$fromInt64_(' + receiverPrinted + ')'
		}

		if receiverShape == 'uint64_t' {
			return 'String_$fromUInt64_(' + receiverPrinted + ')'
		}

		if receiverShape == 'double', receiverShape == 'float' {
			return 'String_$fromFloat_(' + receiverPrinted + ')'
		}

		if receiverShape == 'Bool_' {
			return 'String_$fromBool_(' + receiverPrinted + ')'
		}

		// Narrow ints/floats widen to the helper widths
		if receiverShape == 'int8_t' or receiverShape == 'int16_t'
			or receiverShape == 'uint8_t' or receiverShape == 'uint16_t'
			or receiverShape == 'uint32_t' {
			return 'String_$fromInt32_((int32_t)(' + receiverPrinted + '))'
		}

		return null
	}

	/// Zero/null literal matching a C parameter type — for padded optional
	/// arguments (`HitBox(text, x, y)` against `new (…, w: Float = 0, …)`)
	fun padValue(to: Type): String { let name = stringifyType(to)

		if name == 'double' {
			return '(double)0.0'
		}

		if name == 'float' {
			return '(float)0.0'
		}

		return printTypeConverter('nullptr', Type.UnknownNullable({ value: null }), to)
	}

	/// Casts a dynamic (`Any_*`/proxy) operand to the peer operand's C type.
	/// Boxed payloads unbox through the D7 helpers (real values now that
	/// `Any` carries them); unknown shapes read zero (stub parity).
	fun castOperand(toName: String, string: String): String {
		if toName == 'double' or toName == 'float' {
			return '((' + toName + ')(Any_unboxFloat_(' + string + ')))'
		}

		if toName.endsWith('*') or toName.startsWith('_$') {
			return '(' + toName + ')(' + string + ')'
		}

		return '((' + toName + ')(Any_unboxInt64_(' + string + ')))'
	}

		}

		if fromType == project.typer.typeBool {
			return 'Any_fromBool(' + string + ')'
		}

		if fromType == project.typer.typeInt {
			return 'Any_fromInt(' + string + ')'
		}

		if string == 'nullptr' {
			return string // Workaround for cases when type of `null` cannot be inferred
		}
		return '(struct Any_*)(' + string + ')'
	}

	fun printValueToNullableConverter(string: String, fromValue: Type, to: Type): String {
		return '%printValueToNullableConverter%'
	}

	fun printNullableToValueConverter(string: String, fromValue: Type, to: Type): String {
		return '%printNullableToValueConverter%'
	}

	/// NOTE this is a strict `as!` kind of conversion
	fun printTypeConverter(string: String, fromValue: Type, to: Type): String {
		if fromValue == to {
			return string
		}

		// `Void`-typed values (fire-and-forget calls, `async` bodies without
		// `return`) carry no C value — sequence the call for its effects and
		// yield a typed null (placeholder until the async runtime lands, F9).
		// NOTE `to == Void` (e.g. `return;`) prints the bare call instead
		if fromValue == project.typer.typeVoid {
			if to == project.typer.typeVoid {
				return string
			}

			return '(' + string + ', (' + stringifyType(to) + ')0)'
		}

		// Dynamic `Any`-shaped sources (`Generic` stubs, erased generics)
		// convert through the same helpers as `Any` (D7). NOTE the `null`
		// literal is dynamic-shaped too but converts type-directed
		var dynamicSource = isDynamic(fromValue)

		switch fromValue {
			case UnknownNullable(handle):
				if handle.value == null {
					dynamicSource = false
				}
			case _:
		}

		if dynamicSource {
			if to == project.typer.typeBool {
				return '(' + string + ')->_toBool() '
			}

			if to == project.typer.typeInt {
				return 'Any_unboxInt_(' + string + ') '
			}

			if to == project.typer.typeFloat {
				return 'Any_unboxFloat_(' + string + ') '
			}

			if to == project.typer.typeNumber {
				return 'Any_unboxFloat_(' + string + ') '
			}

			if to == project.typer.typeFloat32 {
				return '((float)(Any_unboxFloat_(' + string + '))) '
			}

			if to == project.typer.typeInt64 {
				return 'Any_unboxInt64_(' + string + ') '
			}

			if to == project.typer.typeUInt64 {
				return '(uint64_t)(Any_unboxInt64_(' + string + ')) '
			}

			// S3b: `Any` to fat-typedef unboxes through a `size_t` bridge
			// (M1 compiles with sentinel env elsewhere; F10 makes it exact)
			if isFatValueType(to) {
				return '(' + stringifyType(to) + ')(size_t)(' + string + ') '
			}
		}

		// Integers
		if fromValue == project.typer.typeUInt16, to == project.typer.typeInt {
			return '(int32_t/*!*/)(' + string + ')'
		}

		// TODO combine all `== project.typer.typeAny` to single `if`
		if fromValue == project.typer.typeBool, to == project.typer.typeAny {
			return 'Any_fromBool(' + string + ')'
		}

		if fromValue == project.typer.typeAny, to == project.typer.typeBool {
			return '(' + string + ')->_toBool()'
		}
		// ^ TODO ((==null)?false:_toBool)
		// != null SHOULD BE DONE ONLY FOR NULLABLE AND Any
		if fromValue == project.typer.typeAny, to == project.typer.typeInt {
			return '(' + string + ')->_toInt()'
		}
		// ^ TODO ((==null)?0:_toInt) cause 1+null+2=3

		if fromValue == project.typer.typeAny, to == project.typer.typeFloat {
			return '(' + string + ')->_toFloat()'
		}
		// ^ TODO ((==null)?0.0:_to) cause 1+null+2=3

		if fromValue == project.typer.typeAny, to == project.typer.typeInt64 {
			return 'Any_unboxInt64_(' + string + ') '
		}

		if fromValue == project.typer.typeAny, to == project.typer.typeUInt64 {
			return '(uint64_t)(Any_unboxInt64_(' + string + ')) '
		}

		if fromValue == project.typer.typeAny, to == project.typer.typeFloat32 {
			return '((float)(Any_unboxFloat_(' + string + '))) '
		}

		if fromValue == project.typer.typeInt, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		if fromValue == project.typer.typeInt8, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		if fromValue == project.typer.typeUInt8, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		if fromValue == project.typer.typeInt16, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		if fromValue == project.typer.typeUInt16, to == project.typer.typeString {
			return 'String_$fromInt32_(' + string + ')'
		}

		// 64-bit
		if fromValue == project.typer.typeUInt32, to == project.typer.typeString {
			return 'String_$fromUInt64_(' + string + ')'
		}

		if fromValue == project.typer.typeInt64, to == project.typer.typeString {
			return 'String_$fromInt64_(' + string + ')'
		}

		if fromValue == project.typer.typeUInt64, to == project.typer.typeString {
			return 'String_$fromUInt64_(' + string + ')'
		}

		// TODO ^ from Float, etc
		if fromValue == project.typer.typeBool, to == project.typer.typeString {
			return 'String_$fromBool_(' + string + ')'
		}

		if fromValue == project.typer.typeFloat, to == project.typer.typeString {
			return 'String_$fromFloat_(' + string + ') '
		}

		if fromValue == project.typer.typeNumber, to == project.typer.typeString {
			return 'String_$fromFloat_(' + string + ') '
		}

		if fromValue == project.typer.typeFloat32, to == project.typer.typeString {
			return 'String_$fromFloat_(' + string + ') '
		}

		if fromValue == project.typer.typeString {
			switch to {
				case ClassInstance(classType, generic):
					// TODO for strict type check, store all strings like "ConstCharPointer" as constants
					if classType.name == 'ConstCharPointer' {

						return '(' + string + ')->bytes_'
					}

					if classType.name == 'ConstArrayPointer' {

						switch generic[0] {
							// TODO `case (project.typer.typeInt):`
							case ClassInstance(of): // TODO `instance as of`
								switch of.name {
									// NOTE `.bytes` is array of `UInt16` not `ClangWideChar`
									// to guarantee 16-bit even when `-fshort-wchar` is not set
									case 'ClangWideChar': return '(wchar_t *)((' + string + ')->bytes_)'
								}
						}
						return '(' + string + ')->bytes_'
					}
			}

			if string == 'String_199' {
			}
		}

		switch fromValue {
			case Nullable(_):
			case UnknownNullable(_):
			case _:
				if to == project.typer.typeString {
					let cleanedType = omitPointer(stringifyType(fromValue))
					// TODO use meta block
					if cleanedType != 'Any_' {
						// Direct `toString_` call — every class emits one (the
						// synthesized `[object Object]` fallback included)
						return cleanedType + '$toString_(' + string + ') '
					}

					// `Any` — unbox through the D7 helper: real strings pass
					// through, boxed scalars format, everything else keeps
					// the `"null"` placeholder (status quo ante).
					return 'Any_unboxString_((struct Any_ *)(size_t)(' + string + ')) '
				}
		}

		// console.log(to) // , (to as! Any). ConstCharPointer

		if to == project.typer.typeAny {
			return printToAnyConverter(string, fromValue)
		}

		// Erased-`Any` expectations that stringify to `Any_*` but are NOT the
		// typeAny object: a null slot (unbound signature element — the
		// Array<null>-receiver fallout) and `Any?` (rest-args like
		// `console.log(...Any?)`). Without these arms the converter fell
		// through to a RAW pass-through and MSVC reported C2664 (concrete
		// String_*/int32_t/Struct_* into an `Any_*` parameter).
		if to == null {
			return printToAnyConverter(string, fromValue)
		}

		switch to {
			case Nullable(toNull):
				if toNull == project.typer.typeAny {
					return printToAnyConverter(string, fromValue)
				}
			case _:
		}

		if fromValue != to {
			// TODO in future reformat into `case N(A),N(B)|A,B if (A==B):` etc complex nested combined patterns
			// TODO what if use `E.nullable` instead of `Null(E)`? meh than T1 != T2 would be broken?
			switch to {
				// `T? = _`
				case Nullable(toNull): switch fromValue {
						case Nullable(fromNull):
							// `var x: T? = T?`
							if toNull == fromNull {
								return string
							}

							if to == project.typer.typeNullUInt64 {
								return 'toNull$UInt64((uint64_t)(' + string + '))'
							}

							// `var x: A? = B?` unsafe conversion
							// TODO `(Int?) as! (Float?)` should not be bit-cast (how C does `(double)(int)123`?)
							return '(/*A? = B?*/' + stringifyType(to) + ')(' + string + ')'
						case _:
							// `var x: T? = T`
							// TODO do in normalizer ToNullable(v,t1,t2)
							if toNull == fromValue {
								if toNull == project.typer.typeInt {
									return '((int32_t$)(' + string + '))' // TODO
								}

								if toNull == project.typer.typeUInt64 {
									return '(Null$UInt64)\{' + string + ', 1\}'
								}

								if toNull == project.typer.typeInt64 {
									return '(Null$Int64)\{' + string + ', 1\}'
								}

								if toNull == project.typer.typeFloat {
									// TODO isn't it `Null$Float64`?
									return '(Null$Float)\{' + string + ', 1\}'
								}

								if toNull == project.typer.typeFloat32 {
									return '(Null$Float32)\{' + string + ', 1\}'
								}

								// TODO more (un)wrapping cases for basic types where needed
								return string
							}
							// `var x: A? = B` unsafe conversion
							// TODO `(Int?) as! (Float)` should not be bit-cast (how C does `(double)(int)123`?)

							switch fromValue {
								// Essentially just `null`
								case UnknownNullable(value): if value.value == null {
										if toNull == project.typer.typeInt or toNull == project.typer.typeInt32 {
											return 'int32_t$null'
										}
										// TODO null float etc as struct for now
										if toNull == project.typer.typeUInt32 {
											return 'uint32_t$null'
										}

										if toNull == project.typer.typeInt16 {
											return 'int16_t$null'
										}

										if toNull == project.typer.typeUInt16 {
											return 'uint16_t$null'
										}

										if toNull == project.typer.typeInt8 {
											return 'int8_t$null'
										}

										if toNull == project.typer.typeUInt8 {
											return 'uint8_t$null'
										}

										if toNull == project.typer.typeUInt64 {
											return '(Null$UInt64)\{0, 0\}'
										}

										if toNull == project.typer.typeInt64 {
											return '(Null$Int64)\{0, 0\}'
										}

										if toNull == project.typer.typeFloat {
											return '(Null$Float64)\{0.0, 0\}'
										}

										if toNull == project.typer.typeNumber {
										}

										if toNull == project.typer.typeFloat32 {
											return '(Null$Float32)\{0.0f, 0\}'
										}

										if toNull == project.typer.typeBool {
											return '/*Bool.null*/(uint8_t)2'
										}

										switch toNull {
											case ClassInstance(classType):
												if classType.name == 'ClangWideChar' {
													return '(wchar_t)0'
												}
										}

										if toNull == null {
											return string // TODO seems like unspecified generic type <T>
										}
										return '/*%T? = null%*/(' + string + ')'
									}
							}

							// return '(/*2 from=' + stringifyType(fromValue) + '*/' + stringifyType(to) + ')(' + string + ')
							return '(/*A? = B*/' + stringifyType(to) + ')(' + string + ')'
					}
					// `T = _`
				case _: switch fromValue {
						case Nullable(fromNull):
							// `var x: T = T?` used in `if let`
							if to == fromNull {
								if fromNull == project.typer.typeInt {
									return '(int32_t)(' + string + ')' // Should truncate
									// TODO Example `return string + '.value_'`
								}

								if
									(fromValue == project.typer.typeNullUInt64 and to == project.typer.typeUInt64)
									or
									(fromValue == project.typer.typeNullFloat and to == project.typer.typeFloat)
									or
									(fromValue == project.typer.typeNullNumber and to == project.typer.typeNumber)
									or
									(fromValue == project.typer.typeNullFloat32 and to == project.typer.typeFloat32)
								{
									return string + '.value_'
									// NOTE no need to validate `has_` cause `null => has_ == 0 and value == 0`
								}
								return string + '/*T = T?*/'
								return '%T = T?%'
							}

							if fromNull == project.typer.typeInt, to == project.typer.typeString {
								return 'String_$fromNullableInt32_(' + string + ')'
							}

							if fromNull == project.typer.typeBool, to == project.typer.typeString {
								return 'String_$fromBool_(' + string + ')'
							}

							if fromNull == project.typer.typeFloat, to == project.typer.typeString {
								return 'String_$fromFloat_(' + string + '.value_)'
							}

							if fromNull == project.typer.typeNumber, to == project.typer.typeString {
								return 'String_$fromFloat_(' + string + '.value_)'
							}

							if fromNull == project.typer.typeFloat32, to == project.typer.typeString {
								return 'String_$fromFloat_(' + string + '.value_)'
							}

							// `var x: A = B?` unsafe conversion
							// TODO `(Int?) as! (Float)` should not be bit-cast (how C does `(double)(int)123`?)
							return '(/*A = B? \(stringifyType(fromNull)) */' + stringifyType(to) + ')(' + string + ')'
						case _:
							// `var x: T = T`
							if to == fromValue {
								// No cast needed
								// TODO probably still generate a cast, maybe there's bindings use-case
								return string
							}

							// `var x: A = B` unsafe conversion
							switch fromValue {
								// Essentially just `null`, not `T?`!
								case UnknownNullable(value): if value.value == null {
										if to == project.typer.typeInt or to == project.typer.typeInt32 {
											return 'int32_t$null'
										}
										// TODO null float etc as struct for now
										if to == project.typer.typeUInt32 {
											return 'uint32_t$null'
										}

										if to == project.typer.typeInt16 {
											return 'int16_t$null'
										}

										if to == project.typer.typeUInt16 {
											return 'uint16_t$null'
										}

										if to == project.typer.typeInt8 {
											return 'int8_t$null'
										}

										if to == project.typer.typeUInt8 {
											return 'uint8_t$null'
										}
										// TODO this `if` should be detected as unreachable (if `to` is `let`)
										if to == project.typer.typeInt {
											return '(int32_t)0'
										}
										// '((Null$Int32)(' + string + ')).value_'
										if to == null {
											return string // TODO seems like unspecified generic type <T>
										}
										return '(/*T = null*/' + stringifyType(to) + ')(' + string + ')'
										return '%T = null%' //
									}
							}

							let tot = JSON.stringify('' + to) // ??!
							if to == null {
								return string
							}

							// TODO do in normalizer
							var fromStructByValue = false
							var fromBasicType = false
							switch fromValue {
								case ClassInstance(classType):
									let atts = project.mapDecorators.get(classType.parent)

									fromBasicType = Decorator.getDecorator(atts, 'nativeBasicType') != null

									fromStructByValue = Decorator.getDecorator(atts, 'byValue') != null
									fromStructByValue = fromStructByValue or classType.name == 'ByValue'
									// TODO
									// or classType.name == 'ArrayByValue'
							}
							var toStructByPointer = false
							var toStructByValue = false
							switch to {
								case ClassInstance(classType):
									let atts = project.mapDecorators.get(classType.parent)

									toStructByPointer = Decorator.getDecorator(atts, 'struct') != null

									toStructByValue = Decorator.getDecorator(atts, 'byValue') != null
									toStructByValue = toStructByValue or classType.name == 'ByValue'
									// TODO
									// or classType.name == 'ArrayByValue'
							}

							// if stringifyType(to) == stringifyType(fromValue) {
							// return string
							// }

							if fromStructByValue and toStructByPointer, not fromBasicType {
								return '(/*struct to pointer*/' + stringifyType(to) + ')&(' + string + ')'
							}

							if fromStructByValue and toStructByValue {
								return '*((/*struct to struct*/' + omitPointer(stringifyType(to)) + '*)&(' + string + '))'
							}

							// Special case in C++: cast from pointer to smaller type 'uint32_t'
							if to == project.typer.typeUInt32 {
								return '(uint32_t)(size_t)(' + string + ')'
							}

							return '(' + stringifyType(to) + ')(' + string + ')'
							return '(' + stringifyType(to) + '/*ff*/)(' + string + ')'
							return '(/*A = B*/' + '/*\(tot)*/' + stringifyType(to) + ')(' + string + ')' //
					}
			}
		}
		return string
		+ '/*TO*/'
		// TODO ANYTHING to string should be checked =null always
	}

	var thisArgument: String? = null
	fun printFunctionArguments(args: [String], funcType: Type, variadic: VariadicKind = VariadicKind.NotVariadic) {
		// New function scope: forget previous locals (params + locals below
		// register into `localDecls` so `cShape` sees the DECLARED C types)
		localDecls = [:]

		if args.length == 0, thisArgument != null {
			// TODO variadic
			return '(' + thisArgument + ')'
		}

		if args.length == 0 {
			// TODO variadic
			return '(void)' // Otherwise C function takes infinite number of arguments
		}

		switch funcType {
			case Function(types, _):
				let results: [String] = []

				if let thisArgument = thisArgument {
					results.push(thisArgument)
				}

				for a in args.length {
					var result = stringifyType(types[a].dataType) + ' ' + args[a] + '_'
					// if (defaults) { switch types[a] {
					// case Nullable(_): result += ' = ((Unknown_ *)0)'
					// case UnknownNullable(_): result += ' = ((Unknown_ *)0)'
					// }}
					results.push(result)
				}

				if let elem = hexaRestElement {
					// Hexa ABI: `(fixed..., int32_t $nrest_, Elem* $rest_)`.
					// Stack-allocated plain C array at the call site, no `Array` object.
					let elemC = stringifyType(elem)
					localDecls.set('$nrest', project.typer.typeInt)
					localDecls.set('$rest', Type.Rest(elem, false))
					results.push('int32_t $nrest_')
					results.push(elemC + '* $rest_')
				}

				if variadic == VariadicKind.NativeVariadic {
					results.pop() // Last argument is unused
					results.push('...')
				}

				if results.length == 0 {
					return '(void)' // Otherwise C function takes infinite number of arguments
				}

				return '(' + results.join(', ') + ')'

				// TODO Incompatible types `String` and value of `Array<String?>`
				// var thisArgument: String? = null
				// let results: String = (thisArgument != null)? [thisArgument] : []
				// lol result [String] no String

				// TODO seems like dead code
				// return '(' + [for a in args.length {
				// var result = stringifyType(types[a]) + ' ' + args[a] + '_'
				// if (defaults) { switch types[a] {
				// case Nullable(_): result += ' = ((Unknown_ *)0)'
				// case UnknownNullable(_): result += ' = ((Unknown_ *)0)'
				// }}
				// result
				// }].join(', ') + ')'
		}

		// TODO seems like dead code
		return '(' + [for a in args.length
			'Any_* ' + args[a] + '_'
		].join(', ') + ')'
		// TODO defaults
		// 'void* ' + args[a] + ((defaults != null && defaults[a] != null)? ' = ' + printExpression(defaults[a]) : '')
	}

	fun stringType(t: NodeType, prefix: String) {
		// let prefix = prefix? '' : ''
		if (t == null) {
			return 'void*'
		}
		// if (t == null) return prefix + 'void*'
		switch t {
			case ParametricType(name, params):
				// if (name == 'Buffer') return prefix + name
				// return prefix + name + '<' + [for (param in params) stringType(param, false)].join(', ') + '>'
				return '_x' + name
			case Type(name):
				// if (name == 'Any') return prefix + 'void*'
				return '_x' + name
			case Object(_):
				// return prefix + '\{\}'
			case Optional(t):
				// return prefix + 'Null<' + stringType(t, false) + '>'
				return stringType(t, '')
		}

		return prefix + 'void*'
	}

	fun printType(t: NodeType) {
		let typeName = stringType(t, '')
		return typeName
	}

	fun stringifyType(t: Type, prefixNull: Bool = false): String {
		switch t {
			case Generic(index, name):
				return 'Any_*'
				return 'Any_*/*Generic*/' // TODO + '/*Generic<\(name)>*/'
			case Nullable(t):
				let name = stringifyType(t)

				if name == 'int32_t' {
					return 'int32_t$'
				}

				if name == 'int16_t' {
					return 'int16_t$'
				}

				if name == 'int8_t' {
					return 'int8_t$'
				}

				if name == 'Bool' {
					return 'Bool_'
				}

				if name == 'double' {
					return 'Null$Float64'
				}

				if name == 'float' {
					return 'Null$Float32'
				}

				if name == 'uint64_t' {
					return 'Null$UInt64'
				}

				if name == 'int64_t' {
					return 'Null$Int64'
				}

				if prefixNull == true {
					return 'Null$' + name
				}

				return name
			case Unknown(handle):
				return stringifyType(handle.value, prefixNull)
			case UnknownNullable(handle):
				// if let value = handle.value {
				// return 'Null$' + stringifyType(handle.value, prefixNull)
				// }
				// return 'Null$Unknown_*'
				// return 'Null$' + stringifyType(handle.value, prefixNull)
				return stringifyType(handle.value, prefixNull)
			case ClassInstance(classType, generics):
				// TODO generic params < T > !!!!! just output into C++  templates
				// TODO type == typer.typeX

				if classType.name == 'ByValue' {
					return omitPointer(stringifyType(generics[0], prefixNull))
				}

				if classType.name == 'Int' {
					return 'int32_t'
				}

				if classType.name == 'Int8' {
					return 'int8_t'
				}

				if classType.name == 'Int16' {
					return 'int16_t'
				}

				if classType.name == 'Int32' {
					return 'int32_t'
				}

				if classType.name == 'Int64' {
					return 'int64_t'
				}

				if classType.name == 'UInt8' {
					return 'uint8_t'
				}

				if classType.name == 'UInt16' {
					return 'uint16_t'
				}

				if classType.name == 'UInt32' {
					return 'uint32_t'
				}

				if classType.name == 'UInt64' {
					return 'uint64_t'
				}

				// Useful for `sizeof`
				if classType.name == 'ArrayByValue' {
					return stringifyType(generics[0]) + '[' + stringifyType(generics[1]) + ']'
				}

				let atts = project.mapDecorators.get(classType.parent)
				// TODO refactor
				var renamed = ''

				if let rename = Decorator.getDecorator(atts, 'rename') {
					renamed = DataHelper.asStringAttValue(rename, 0)
					//

					/*console.log('renamed -->', renamed)
						if generics == null {
							if Decorator.getDecorator(atts, 'byValue') != null {
								return renamed
							}
							return renamed + '*'
						}*/
				}

				if let generic = generics, renamed == 'ConstArrayPointer' {
					return 'const ' + stringifyType(generic[0]) + '*'
				}

				if let generic = generics, renamed == 'ArrayPointer' {
					return stringifyType(generic[0]) + '*'
				}

				if let generic = generics, renamed == 'ArrayByValue' {
					// if let count = generic[1] {
					// return stringifyType(generic[0]) + '[' + Type.stringify(count) + ']'
					// }
					// return stringifyType(generic[0]) + '[]'
					return stringifyType(generic[0])
				}

				// Keeps three states: 1 = true, 0 = false, 2 = null
				if classType.name == 'Bool' {
					return 'Bool_'
				}

				// WinDef.h `typedef int BOOL;`
				// TODO should be just simple `enum Bool32 : Int32 { True False }`
				// TODO error if `Enum.V == xx` if Enum != simple enum (i.e. creates new instance so always false)
				// TODO allow short syntax `x == True` & `x != True` if enum's simple type is known
				if classType.name == 'Bool32' {
					return 'int32_t'
				}

				// WinDef.h `typedef BYTE BOOLEAN; typedef unsigned char BYTE;`
				// TODO UBool8?
				if classType.name == 'Bool8' {
					return 'uint8_t'
				}

				// TODO apparently should be just `@rename('void')`
				if classType.name == 'Void' {
					return 'void'
				}

				if classType.name == 'Float' {
					return 'double'
				}

				if classType.name == 'Number' {
					return 'double'
				}

				// if (let jsNative = classType.jsNative) return jsNative

				let atts = project.mapDecorators.get(classType.parent)

				let struct = Decorator.getDecorator(atts, 'struct') != null
				let byValue = Decorator.getDecorator(atts, 'byValue') != null

				if byValue and not struct {
					throw 'Must be @struct to be @byValue'
				}

				let native = Decorator.getDecorator(atts, 'rename')

				if let native = native { switch (native.values[0]) {
						case String(s):
							if struct and byValue {
								return s
							}

							if struct {
								return s + '*'
							}
							return s
					} }

				if let generic = generics, generic.length > 0 {
					var name = classType.name

					if let instanceOf = classType.instanceOf {
						name = instanceOf.name
					}

					name += '_$' + [for param in generic {
							omitPointer(stringifyType(param, prefixNull: true))
						}].join('$')
						// + '*'

						// name = name.replace('_*_', '_*')

					// F9: record every `Promise_X` instantiation for the
					// post-Types `operator co_await` + `promise_type` block
					// (struct forwards flushed separately in `stringify`,
					// since `stringifyType` cannot see local `forward`).
					if name == 'Promise' or name.startsWith('Promise_$') or name.startsWith('Promise_$_') {
						var structName = name + '_'

						if name.endsWith('_') {
							structName = name
						}

						if not promiseStructs.includes(structName) {
							promiseStructs.push(structName)
						}
					}

					if name.endsWith('_') {
						return name + '*'
					}

					return name + '_*'
				}

				// Generic class without instance params — erases to `Any_*`
				// (`Array_*` etc are not emitted C types)
				if classType.genericParams.length > 0 {
					return 'Any_*'
				}

				return classType.name + '_*'
			case Class(classType):
				// return stringifyType(Type.ClassInstance(classType, null))
				// A bare generic CLASS value (no instance params) erases to
				// `Any_*` — `Array_*` is not an emitted C type
				if classType.genericParams.length > 0 {
					return 'Any_*'
				}

				return classType.name + '_*'
				// TODO ^ probably requires rename basic types too?
			case Enum(enumType):
				if let sub = enumType.fieldsTypeSimple {
					let atts = project.mapDecorators.get(enumType.parent)

					if let rename = Decorator.getDecorator(atts, 'castTo') {
						return DataHelper.asStringAttValue(rename, 0)
					}

					return stringifyType(sub)
				}

				return enumType.name + '_*'
			case EnumInstance(enumType):
				return stringifyType(Type.Enum(enumType))
				// if let sub = enumType.fieldsTypeSimple {
				// return stringifyType(sub)
				// }
				// return enumType.name + '_*/*EnumInstance*/'
			case Struct(names, fieldTypes):
				// Inline structural type (`interface { ... }`) — mint a real C
				// struct with the named fields so member accesses compile
				// (one definition per distinct shape; F10 reflection later)
				let fields: [String] = []

				for i in names.length {
					fields.push(stringifyType(fieldTypes[i]) + ' ' + names[i] + '_')
				}

				let signature = fields.join(';')

				if let existing = structDefsMap.get(signature) {
					return existing
				}

				let structName = 'Struct_' + (tempId++)
				structDefsMap.set(signature, structName + '_*')
				structDefsForward.push('struct ' + structName + '_;')
				structDefsForward.push('typedef struct ' + structName + '_ ' + structName + '_;')
				structDefs.push('struct ' + structName + '_ \{\n\t' + fields.join(';\n\t') + ';\n\};\n')
				return structName + '_*'
			case Function(args, returns):
				// NOTE nested function types emit their own typedefs, so all
				// names must be resolved BEFORE this declaration is assembled
				// or their `typedef ...` text interleaves into the middle of it
				let returnName = stringifyType(returns)
				let a: [String] = []

				for arg in args {
					switch arg.dataType {
						case Rest(element, native):
							if not native {
								// Hexa rest is `(count, ptr)` — two C slots.
								a.push('int32_t')
								a.push(stringifyType(element) + '*')
								continue
							}
							// Native `...` has no typedef slot (raw C variadic).
							continue
					}
					let argName = stringifyType(arg.dataType)

					// `Void` parameters carry no value — drop them (both at
					// the typedef and at the emitted functions/call sites) or
					// `Promise<Void>` produces `void value_` parameters
					if argName == 'void' {
						continue
					}

					a.push(argName)

					// S3b fix: nested fat params double up (mirror
					// `printFunctionArguments` — one Nice function-typed
					// param is TWO C slots `ptr, env`)
					if isFatValueType(arg.dataType) {
						a.push('void*')
					}
				}

				// Same signature = same typedef name (stable for mangling)
				// S3b: every function typedef is fat (env-first `void*`) so all
				// function-typed values share one shape (`f$ptr(f$env, ...)`).
				// Thin direct globals never use typedefs (called by name).
				let fatA = ['void*']

				for x in a {
					fatA.push(x)
				}
				let signature = returnName + ' (' + defaultCallingConvention + ')(' + fatA.join(', ') + ')'

				if let existing = typedefFunctionsMap.get(signature) {
					return existing
				}

				let temp = tempId++
				typedefFunctions.push('typedef ')
				typedefFunctions.push(stringifyType(returns))
				// TODO use better name like _fun_123_
				// TODO de-dup all function types in normalizer, expressions to use funcTypes[id]
				// typedefFunctions.push(' (*_$\(temp))(')
				typedefFunctions.push(' (')
				// TODO respect `link.convention`
				typedefFunctions.push(defaultCallingConvention)
				typedefFunctions.push('*_$')
				typedefFunctions.push('' + temp)
				typedefFunctions.push(')(')

				let a: [String] = []

				for arg in args {
					a.push(stringifyType(arg.dataType))
				}

				typedefFunctions.push(a.join(', '))
				typedefFunctions.push(');\n')
				return '_$\(temp)'
				// return 'Any_* /*Function* /'
			case Rest(element, _):
				// Hexa rest lowers to `(count, ptr)` — the ptr alone is `Elem*`.
				return stringifyType(element) + '*'
			case Constant(value): return value
			case null:
				return 'Any_*'
				return 'Any_*/*null*/' // TODO
			case _:
				console.log(t)
				throw 'stringifyType ' + t
		}
	}

	// TODO move to Expression static fun
	fun getType(e: Expression): Type { switch e {
			case Int(_): return project.typer.typeInt
			case MetaInt(_, kind):
				switch kind {
					case Int8: return project.typer.typeInt8
					case Int16: return project.typer.typeInt16
					case Int32: return project.typer.typeInt32
					case Int64: return project.typer.typeInt64

					case UInt8: return project.typer.typeUInt8
					case UInt16: return project.typer.typeUInt16
					case UInt32: return project.typer.typeUInt32
					case UInt64: return project.typer.typeUInt64
				}

			case Float(_): return project.typer.typeFloat
			case String(_): return project.typer.typeString
			case True: return project.typer.typeBool
			case False: return project.typer.typeBool
			case Ident(_, dataType): return dataType
			case Parenthesis(expr): return getType(expr)
			case Call(_, _, dataType): return dataType
				// case If(_): return project.typer.typeAny
			case Binop(_, _, _, dataType): return dataType
			case NativeOperator(_, _, _, _, dataType): return dataType
			case Dot(_, _, dataType): return dataType
			case This(dataType): return dataType
			case Null: return Type.UnknownNullable({ value: null })
			case UnsafeBitCast(_, to): return to
			case Index(_, _, result): return result
			case New(_, _, result): return result
			case Array(_, result): return result
			case Map(keys, values, keyType, valueType, mapType): return mapType
			case Unop(op, postfix, e): return getType(e) // TODO `-N` should convert `UInt` to `Int` in typer
			case If(econd, eif, eelse): return getType(eif)
			case Enum(dataType, tagName, tag, args):
				// TODO
				return project.typer.typeAny
			case EnumTag(expr):
				// TODO
				return project.typer.typeAny
			case Function(_):
				// TODO
				return project.typer.typeAny
			case Arrow(_):
				// TODO
				return project.typer.typeAny
			case Object(_):
				// TODO
				return project.typer.typeAny
				// `await e` — Promise<T> unwraps to T, plain values pass through
			case Await(e): {
					let inner = getType(e)

					switch inner {
						case ClassInstance(classType, generic):
							if classType.name == 'Promise', generic != null, generic.length == 1 {
								return generic[0]
							}
					}
					return inner
				}
				// `a ?? b` — same as the typer: type of the fallback
			case Elvis(_, otherwise): return getType(otherwise)
				// `x !.` — type of the unwrapped value
			case RemoveNullability(_, result): return result
				// `"str"[i]`
			case StringIndex(_, _, result): return result
				// `x is T`
			case Is(_, _): return project.typer.typeBool
				// `...value` — a runtime list cannot expand statically, neutral `Any`
			case Spread(_): return project.typer.typeAny
			case StringConcatenation(_, _): return project.typer.typeString
				// `a op= b` evaluates to the target's type
			case Assignop(a, _, _): return getType(a)
			case EnumParameter(_): return project.typer.typeAny
				// Unbound `_` must never reach codegen — it is a compilation error
			case Underscore:
				throw 'getType: expression `_` reached codegen'
			case _:
				// console.log(e, 'getType unknown case', project.expressionPosition.get(e))
				// TODO unknown kinds must not crash generation — report & continue
				// throw 'getType ' + e
				return project.typer.typeAny
		} }

	/// Returns type name without last `*` on the end
	fun omitPointer(typeName: String): String {
		if typeName.endsWith('*') {
			return typeName.substr(0, typeName.length - 1)
		}
		return typeName
	}

	/// Dynamic (`Any`-shaped) values — `Any`, untyped, `Generic` stubs and
	/// erased bare-generic classes all stringify to `Any_*` at the C level and
	/// must route member access through the reflection stub (F10)
	fun isDynamic(dataType: Type?): Bool {
		return stringifyType(dataType) == 'Any_*'
	}

	/// S3b: concrete function types (plus nullable-function, null → null pair)
	/// lower to TWO C vars from the type alone (no IR pairing node). `Any_*`
	/// (erased/Generic) stays dynamic (existing `Any` paths); method values
	/// stay thin (F6). Used by bindings, calls, fields, `==`, conversions.
	fun isFatValueType(dataType: Type?): Bool { switch dataType {
			case Function(_, _, _):
				return true
			case Nullable(inner):
				return isFatValueType(inner)
			case _:
				return false
		} }

	/// Any-shaped values that may hold managed payloads (exact `Any`, its
	/// nullables, erased generics): ARC retains/releases them through the
	/// `Any_isCounted_` runtime guard, never blind. Mirrors the ARC-pass
	/// `isAnyLike` predicate — both must agree.
	fun isAnyLikeValue(dataType: Type?): Bool {
		if dataType == null {
			return false
		}

		if dataType == project.typer.typeAny {
			return true
		}

		switch dataType {
			case Nullable(inner):
				return isAnyLikeValue(inner)
			case UnknownNullable(inner):
				return isAnyLikeValue(inner)
			case Unknown(inner):
				return isAnyLikeValue(inner.value)
			case _:
				return false
		}
	}

	/// Whether a call callee must go through the `AnyValue_` call proxy:
	/// an `Any_*`-SHAPED callee is a raw pointer and `ptr(args)` is not valid
	/// C++ even with `Any_::operator()`. DECLARED types win over use-node
	/// types here too: an untyped callback param (`onUpdate` in an `async fun`)
	/// carries a dynamic/function use type while its C parameter is `Any_*`.
	/// Module-level function idents (no declared entry) stay raw calls.
	fun isDynamicCallee(e: Expression): Bool {
		switch e {
			case Ident(name):
				if let t = localDecls.get(name) {
					return stringifyType(t) == 'Any_*'
				}

				if let t = globalDecls.get(name) {
					return stringifyType(t) == 'Any_*'
				}
				// F10.2: lowered dynamic calls (`a[i]` → `a.get(i)`) build
				// `Dot` nodes with a null result, so `getType` says nothing —
				// key on the DECLARED base type instead (declared types win).
				// Static/typed bases (`Math.floor`, `m.get` on a Map) stay
				// false here exactly as before. Static bases take the static
				// print path (TitleCase ident) — never dynamic, even though a
				// bare class ident is typeless (null stringifies to `Any_*`,
				// which `isDynamic` would otherwise accept). Mirrors
				// `dotFieldKind`.
			case Dot(base, _, _):
				var isStaticBase = false
				switch base {
					case Ident(id, _):
						if id.charAt(0) == id.charAt(0).toUpperCase(), not id.startsWith('_'), not id.startsWith('$') {
							isStaticBase = true
						}
					case _:
				}

				if not isStaticBase, isDynamic(valueType(base)) {
					return true
				}
			case _:
		}

		return getType(e) != null and isDynamic(getType(e))
	}

	/// The C shape of an expression's VALUE. For identifiers the DECLARED
	/// type wins over the Nice type of the use node: the typer may coerce an
	/// `Any` variable's use to `Int` (the use node then lies about the C
	/// value, which is still `Any_*`) — operand classification and conversion
	/// must key on what is actually printed
	fun cShape(e: Expression): String {
		return stringifyType(valueType(e))
	}

	/// F10.2: `==`/`!=` operand shape with dynamic roots corrected. The typer
	/// coerces `Any` uses to the expected type (use-node lies), but a `Dot`
	/// on a dynamic base prints `Any_*` (`Any_dynGet_`) no matter what the
	/// use node claims — keying on the lie emits raw cross-type compares
	/// (C2446). Static bases keep their real shape (mirrors `dotFieldKind`).
	fun binopShape(e: Expression): String {
		switch e {
			case Dot(base, _, _):
				var isStaticBase = false
				switch base {
					case Ident(id, _):
						if id.charAt(0) == id.charAt(0).toUpperCase(), not id.startsWith('_'), not id.startsWith('$') {
							isStaticBase = true
						}
					case _:
				}

				if not isStaticBase, isDynamic(valueType(base)) {
					return 'Any_*'
				}
			case _:
		}
		return cShape(e)
	}

	/// F10.2: conversion source type for `==`/`!=` box-both. A dynamic root
	/// prints `Any_*` even when the use node claims a concrete type (the
	/// lie) — boxing through the lie (`Any_boxInt_` of an `Any_*`, C2664)
	/// is wrong; bridge through `Any` instead. Agrees with `binopShape`.
	fun binopFromType(e: Expression): Type {
		if binopShape(e) == 'Any_*' {
			return project.typer.typeAny
		}
		return valueType(e)
	}

	/// C-shaped scalar classifiers for `==`/`!=` mismatched widths: pure
	/// scalar pairs compare by VALUE (int64, or double if a float is
	/// involved) so sentinel loops (`c != 0`) terminate after D7 boxing
	/// (heap boxes break per-value pointer identity); pointer-involved
	/// shapes keep the legacy box-both identity compare.
	fun isIntCTypeName(name: String): Bool {
		return name == 'int8_t' or name == 'int16_t' or name == 'int32_t' or name == 'int64_t' or name == 'uint8_t' or name == 'uint16_t' or name == 'uint32_t' or name == 'uint64_t'
	}
	fun isFloatCTypeName(name: String): Bool {
		return name == 'float' or name == 'double'
	}

	/// Pure `is` receivers (evaluating twice is harmless): plain idents and
	/// `Dot` chains over them (stub `let_` getters, no mutation). Calls and
	/// exotic shapes keep the legacy single-evaluation truthiness path.
	fun isPureIsReceiver(e: Expression): Bool { switch e {
			case Ident(_, _): return true
			case Dot(base, _, _): return isPureIsReceiver(base)
			case Parenthesis(inner): return isPureIsReceiver(inner)
			case _: return false
		} }

	/// F10.1 first consumer: `x is T` for `Any`-shaped receivers via vtable-tag
	/// comparison. Every vtable-bearing heap object stores its vtable first
	/// (`$_[0] = &X__$` at construction), so exact-type tests compare the first
	/// word (null-safe; scalar-boxed `Any`s are null by construction and read
	/// false). Returns null when the shape doesn't apply (non-`Any` receiver
	/// keeps the legacy truthiness path, like the other targets; scalar /
	/// Generic / bare / enum / `Any` targets; struct/union kinds whose first
	/// word is data; templates/externals with no instance vtable; interfaces
	/// whose literals never set `_->`). Exact-type only — subclass instances
	/// read false (documented narrow spot, same convention as RegExp).
	fun anyIsTagCheck(receiver: Expression, target: Type): String? {
		if cShape(receiver) != 'Any_*' {
			return null
		}

		if not isPureIsReceiver(receiver) {
			return null
		}
		var t = target

		switch t {
			case Nullable(inner): t = inner
			case UnknownNullable(handle):
				if handle.value != null { t = handle.value }
				else { return null }
			case _:
		}
		// Scalar targets have no heap vtable (scalars box to null `Any`).
		switch t {
			case ClassInstance(c, _):
				if ['Bool','Bool8','Bool32','Int','Int8','Int16','Int32','Int64','UInt8','UInt16','UInt32','UInt64','BigInt','Float','Float32','Number','SizeOfPointer','SignedSizeOfPointer','ClangChar'].includes(c.name) {
					return null
				}
			case Class(c):
				if ['Bool','Bool8','Bool32','Int','Int8','Int16','Int32','Int64','UInt8','UInt16','UInt32','UInt64','BigInt','Float','Float32','Number','SizeOfPointer','SignedSizeOfPointer','ClangChar'].includes(c.name) {
					return null
				}
			case _:
				return null
		}
		let structName = omitPointer(stringifyType(t))

		for c in project.classes {
			if c.name == structName or (c.name + '_') == structName {
				if c.template {
					return null
				}

				if c.jsRequire != null or c.jsNative != null {
					return null
				}

				if c.api == ClassBinaryInterface.StructureNoVirtual {
					return null
				}
				var kindOk = false
				var isStructOrUnion = false
				var isIface = false
				switch c.classType {
					case Class(kind):
						kindOk = true
						let atts = project.mapDecorators.get(kind.parent)
						isStructOrUnion = Decorator.getDecorator(atts, 'struct') != null or Decorator.getDecorator(atts, 'union') != null
						isIface = kind.kind == ClassKind.Interface
					case ClassInstance(kind):
						kindOk = true
						let atts = project.mapDecorators.get(kind.parent)
						isStructOrUnion = Decorator.getDecorator(atts, 'struct') != null or Decorator.getDecorator(atts, 'union') != null
						isIface = kind.kind == ClassKind.Interface
					case _:
				}

				if not kindOk or isStructOrUnion or isIface {
					return null
				}
				let recv = printExpression(receiver)
				return '(' + recv + ' != nullptr && ((const void**)(' + recv + '))[0] == (const void*)(&' + structName + '_$))'
			}
		}
		return null
	}

	/// Honest type behind a printed expression: declared type for identifiers
	/// (locals first, then globals), the recorded type otherwise. Void-C
	/// callees report `Void` (their true C shape) so value contexts bridge
	/// via the comma-sequence instead of emitting `void` where `T` is needed.
	/// `await voidFn()` is the same shape (async lowering is pass-through).
	fun valueType(e: Expression): Type {
		switch e {
			case Ident(name):
				if let t = localDecls.get(name) {
					return t
				}

				if let t = globalDecls.get(name) {
					return t
				}
			case Parenthesis(inner):
				return valueType(inner)
			case Call(callee, _, _, _):
				if isVoidCallee(callee) {
					return project.typer.typeVoid
				}
			case Await(inner):
				if isVoidValue(inner) {
					return project.typer.typeVoid
				}
			case _:
		}

		return getType(e)
	}
	/// True when the expression evaluates a C-void call (direct or awaited)
	fun isVoidValue(e: Expression): Bool { switch e {
			case Call(callee, _, _, _):
				return isVoidCallee(callee)
			case Parenthesis(inner):
				return isVoidValue(inner)
			case Await(inner):
				return isVoidValue(inner)
			case _:
				return false
		} }

	/// Sanitizes a type name into a valid C identifier segment for generic
	/// instantiation mangling: strips `/*...*/` annotation markers (they are
	/// C comments and must never leak inside an identifier), drops one
	/// trailing `*` (pointer-to), maps remaining `*` to `P` (nested pointers
	/// like `uint8_t**` stay distinguishable) and drops other
	/// non-identifier characters (`const uint8_t` -> `constuint8_t`)
	fun mangleTypeSegment(typeName: String): String {
		// Phase 1 — copy while skipping `/* ... */` marker regions
		var stripped = ''
		var i = 0

		while i < typeName.length {
			let ch = typeName.charAt(i)

			if ch == '/', i + 1 < typeName.length, typeName.charAt(i + 1) == '*' {
				i += 2

				while i < typeName.length {
					if typeName.charAt(i) == '*', i + 1 < typeName.length, typeName.charAt(i + 1) == '/' {
						i += 2
						break
					}

					i++
				}

				continue
			}

			stripped += ch
			i++
		}

		// Phase 2 — one trailing `*` is the "pointer to" of the named type
		stripped = omitPointer(stripped)

		// Phase 3 — keep identifier chars only, `*` becomes `P`
		var out = ''

		for i in stripped.length {
			let code = stripped.charCodeAt(i) ?? 0

			if code >= 97 and code <= 122 {
				out += stripped.charAt(i)
			} else if code >= 65 and code <= 90 {
				out += stripped.charAt(i)
			} else if code >= 48 and code <= 57 {
				out += stripped.charAt(i)
			} else if code == 95 or code == 36 {
				out += stripped.charAt(i)
			} else if code == 42 {
				out += 'P'
			}
		}

		return out
	}

	fun registerString(string: String): Int {
		declarationsOfStrings.push(string)
		return declarationsOfStrings.length - 1
	}

	/// NOTE forced C cast around a converted value: erased/unsubstituted
	/// generic types stringify EQUALLY (`Any_*`) while the actual C value
	/// carries the substituted pointer type — an explicit cast keeps the
	/// assignment well-formed either way (identity cast when types match).
	/// Pointer targets bridge through `size_t`: unrelated class pointers
	/// (e.g. `Any_*` → `FsSync_*`, `Map<K,A>` → `Map<K,B>`) have no C++
	/// conversion, but the round-trip is always well-formed (same address)
	fun forcedCast(to: Type, converted: String): String {
		let toName = stringifyType(to)

		if toName.endsWith('*') {
			return '(' + toName + ')(size_t)(' + converted + ')'
		}

		return '(' + toName + ')(' + converted + ')'
	}

	/// Struct-typed object literal → real heap construction, or null when the
	/// shape doesn't apply (non-struct target or non-literal value). Central
	/// decision point for every binding site that knows the target type
	/// (inits, assigns, call args, array/map elements, returns): `Object_from`
	/// is a null stub, so struct shapes must construct or every field deref
	/// AVs (M3 boot: `layout_->tabHeight_`). D8-future: annotate the Object
	/// node in a pre-generator pass and lower there; until expressions carry
	/// struct types, the binding sites below are the only place with both
	/// the shape (target type) and the values (literal).
	fun printObjectAs(toType: Type, e: Expression): String? {
		// Nullable interface/struct targets construct the same way (the C
		// struct has no null wrapper — null is a null pointer).
		var t = toType

		switch t {
			case Nullable(inner): t = inner
			case _:
		}
		// F9: async `co_return {…}` sees `Promise<Struct>` as the return
		// type — unwrap to the inner struct so object literals construct
		// (else `Object_from` null stub → field-deref AV on first paint).
		switch t {
			case ClassInstance(c, g):
				if c.name == 'Promise', g != null, g.length == 1 {
					t = g[0]

					switch t {
						case Nullable(inner): t = inner
						case _:
					}
				}
			case _:
		}
		// F10.2: plain-object literal into an `Any`-shaped slot builds a real
		// heap bag (AnyObject) instead of the `Object_from` null stub.
		if stringifyType(t) == 'Any_*' {
			switch e {
				case Object(onames, oels):
					return printAnyObjectLit(onames, oels)
				case _:
			}
		}

		switch t {
			case Struct(names, fieldTypes):
				switch e {
					case Object(onames, oels):
						return printStructObject(names, fieldTypes, onames, oels)
					case _:
				}
			case ClassInstance(kind, _):
				// Named interfaces mint real C structs but have no $new_ — an
				// object literal IS the construction (structural typing).
				// Same heap construction as anonymous structs, with field
				// types from the class declaration (matched by name).
				if kind.kind == ClassKind.Interface {
					switch e {
						case Object(onames, oels):
							return printInterfaceObject(kind.name, onames, oels)
						case _:
					}
				}
			case Class(kind):
				// Bare class-as-value type stringifies identically
				// (`Name_*`) — same interface-literal construction.
				if kind.kind == ClassKind.Interface {
					switch e {
						case Object(onames, oels):
							return printInterfaceObject(kind.name, onames, oels)
						case _:
					}
				}
			case _:
		}
		return null
	}

	/// Returns type name without last `*` on the end
	fun omitPointer(typeName: String): String {
		if typeName.endsWith('*') {
			return typeName.substr(0, typeName.length - 1)
		}
		return typeName
	}

	fun registerString(string: String): Int {
		declarationsOfStrings.push(string)
		return declarationsOfStrings.length - 1
	/// F10.2 dynamic member read: `AnyObject` bags read real fields, every
	/// other shape keeps the legacy `let_` proxy (observably identical).
	fun anyDynGetStr(recv: String, name: String): String {
		let q = String.fromCharCode(34)
		return 'Any_dynGet_((Any_*)(' + recv + '), String_$fromUTF16z_((const uint16_t*)L' + q + name + q + '))'
	}

	/// F10.2 dynamic member write: `AnyObject` bags store real fields, every
	/// other shape keeps the legacy `$set` stub.
	fun anyDynSetStr(recv: String, name: String, val: String): String {
		let q = String.fromCharCode(34)
		return 'Any_dynSet_((Any_*)(' + recv + '), String_$fromUTF16z_((const uint16_t*)L' + q + name + q + '), ' + val + ')'
	}

	/// Heap-construct a `Struct_N_*` from an object literal (see printObjectAs).
	/// Field values convert to their declared types; nested struct literals
	/// recurse (printTypeConverter only sees strings). Missing literal fields
	/// stay zero (`HEXA_NEW` zeroes). Emitted as a metaBlock temp + field
	/// stores (C-shaped, no lambdas) — callers flush metaBlock before the
	/// owning assignment (existing protocol, same as VirtualMethod spills).
	fun printStructObject(names: [String], fieldTypes: [Type], onames: [String], oels: [Expression]): String {
		let sname = omitPointer(stringifyType(Type.Struct(names, fieldTypes)))
		let tid = tempId++
		let tmp = '_$struct\(tid)'
		metaBlock.push(sname + '* ' + tmp + ' = (' + sname + '*)(HEXA_NEW(sizeof(' + sname + ')))')

		for i in names.length {
			for k in onames.length {
				if onames[k] == names[i] {
					metaBlock.push(tmp + '->' + names[i] + '_ = ' + printStructFieldValue(fieldTypes[i], oels[k]))
				}
			}
		}
		return tmp
	}

	/// Heap-construct a named interface `Name_*` from an object literal (see
	/// printObjectAs). Field order/types come from the class declaration
	/// (matched by name — literal order may differ); missing fields stay
	/// zero. The vtable slot stays null (interfaces carry no bodies) —
	/// virtual dispatch on such values is F10 territory.
	fun printInterfaceObject(className: String, onames: [String], oels: [Expression]): String {
		var names: [String] = []
		var ftypes: [Type] = []

		for c in project.classes {
			if c.name == className {
				for v in c.vars {
					switch v {
						case Var(n, _, t):
							names.push(n)
							ftypes.push(t)
						case Const(n, _, t):
							names.push(n)
							ftypes.push(t)
						case _:
							continue
					}
				}
			}
		}
		let sname = className + '_'
		let tid = tempId++
		let tmp = '_$iface' + tid
					metaBlock.push(sname + '* ' + tmp + ' = (' + sname + '*)(HEXA_NEW(sizeof(' + sname + ')))')
					// ARC birth count (interface literals are heap-managed like classes).
					metaBlock.push(tmp + '->rc_ = 1')
					metaBlock.push('hexaRegisterLive_((void*)' + tmp + ')')
		for i in names.length {
			for k in onames.length {
				if onames[k] == names[i] {
					if isFatValueType(ftypes[i]) {
						// Pair-held function field (D1 — mirrors the struct
						// body emission, which doubles fat fields into
						// `$f_`/`$e_`): ptr half is the fat impl (fatPtrStr)
						// with a reinterpret_cast (C-style casts are rejected
						// on arity mismatch, C2440); env half is the twin.
						metaBlock.push(tmp + '->' + names[i] + '$f_ = ' + 'reinterpret_cast<' + stringifyType(ftypes[i]) + '>(' + fatPtrStr(oels[k]) + ')')
						metaBlock.push(tmp + '->' + names[i] + '$e_ = ' + fatEnvStr(oels[k]))
					} else {
						metaBlock.push(tmp + '->' + names[i] + '_ = ' + printStructFieldValue(ftypes[i], oels[k]))
					}
				}
			}
		}
		return tmp
	}

	/// One struct field value, converted to its declared type (recursing into
	/// nested struct literals, which printTypeConverter cannot see as strings).
	fun printStructFieldValue(ftype: Type, val: Expression): String {
		if let s = printObjectAs(ftype, val) {
			let sname = omitPointer(stringifyType(ftype))
			return '(' + sname + '*)(' + s + ')'
		}

		if isFatValueType(ftype) {
			// Function-typed struct fields hold thin single values in Phase 1
			// (S2) while the typedef is fat (env-first) — arity and
			// convention can differ, so C-style casts are rejected (C2440)
			// and only reinterpret_cast compiles (x64: extra args ignored).
			return 'reinterpret_cast<' + stringifyType(ftype) + '>(' + printExpression(val) + ')'
		}
		let vt = valueType(val)

		if isDynamic(vt), vt != project.typer.typeAny {
			let want = stringifyType(ftype)

			if want.endsWith('*') {
				// Use-node type is unreliable (erased generics, unknown-null
				// payloads) but the C value is a real pointer: bridge through
				// size_t (null-safe, bit-preserving). Exact-Any sources keep
				// the converter's stub semantics (Phase-1 placeholder per F10);
				// without this the converter's passthrough arms emit the value
				// raw (C2440 on shape mismatch).
				return '(' + want + ')(size_t)(' + printExpression(val) + ')'
			}
		}
		return printTypeConverter(printExpression(val), valueType(val), ftype)
	}

	fun printInitializer(ofType: Type, v: Expression) {
		// F7: `var x Int = cond ? a : b` where a branch is `Int?` (nullable
		// int64 sentinel, e.g. `tc.index`) — convert each branch toward the
		// DECLARED type (not the If's own box-both `Any` result), else the
		// outer `forcedCast` truncates a pointer (C4311). Concrete branches
		// convert via the normal converter (`(int32_t)(int64)` narrows the
		// non-null small indices without warning; the `!= undefined` guard
		// keeps null out of the hot path). Only `Int` binds hit this today.
		if ofType == project.typer.typeInt {
			switch v {
				case If(econd, eif, eelse):
					var aStr = printExpression(eif)

					if cShape(eif) == 'Any_*' {
						aStr = 'Any_unboxInt_(' + aStr + ')'
					} else {
						aStr = printTypeConverter(aStr, valueType(eif), ofType)
					}
					var bStr = printExpression(eelse)

					if cShape(eelse) == 'Any_*' {
						bStr = 'Any_unboxInt_(' + bStr + ')'
					} else {
						bStr = printTypeConverter(bStr, valueType(eelse), ofType)
					}
					return forcedCast(ofType, '(' + printExpression(econd) + ')?(' + aStr + '):(' + bStr + ')')
				case _:
			}
		}
		// Struct-typed literal: real construction (see printObjectAs).
		if let s = printObjectAs(ofType, v) {
			return s
		}
		// F10.3: array literal into an `Any`-shaped slot builds `Array<Any>`
		// directly so fat elements box as pairs (the literal's inferred
		// `Array<Fn>` storage is single-slot and would drop envs).
		if stringifyType(ofType) == 'Array_$Any_*' or stringifyType(ofType) == 'Any_*' {
			switch v {
				case Array(el, _):
					if el.length == 0 {
						return forcedCast(ofType, 'Array_$Any_$new_(0)')
					}
					var parts: [String] = []
				for a in el {
					if isBoxableFat(a) {
						parts.push('Any_boxFatPair_((void(*)())(' + fatPtrStr(a) + '), ' + fatEnvStr(a) + ')')
					} else {
						parts.push(printTypeConverter(printExpression(a), valueType(a), project.typer.typeAny))
						}
					}
					return forcedCast(ofType, 'Array_$Any_$from_(Array_$Any_$new_(' + el.length + '), hexaItems<Any_*>(' + parts.join(', ') + '))')
				case _:
			}
		}
		// F10.3: fat value into an `Any`-shaped slot boxes a pair (impl +
		// env survive; the dynamic call slot unpacks it). Covers `var`/
		// `assign`/field/global inits (which all route here) — call args
		// have their own funnel in `printCallArguments`. Leaf shapes only
		// (composites have no addressable pair — see isBoxableFat).
		if isBoxableFat(v), stringifyType(ofType) == 'Any_*' {
			return 'Any_boxFatPair_((void(*)())(' + fatPtrStr(v) + '), ' + fatEnvStr(v) + ')'
		}

		switch ofType {
			case ClassInstance(c):
				if c.name == 'ArrayByValue' {
					switch v {
						case Array(el) if el.length == 1: {
								switch el[0] {
									case Int(val): {
											if val == 0 {
												// Print single-element (C-style) initializer for `ArrayByValue`
												return '\{0\}'
											}
											// TODO else what?
										}
								}
							}
					}
				}
		}

		let vType = getType(v)

		if vType == project.typer.typeAny, ofType != project.typer.typeAny {
			// Cast Any to expected type
			// return printTypeConverter(printExpression(v), vType, ofType)
		}

		return printTypeConverter(printExpression(v), vType, ofType)
		// return printExpression(v)
	}

	var customThis: String? = null
	fun printExpression(e: Expression) {
		switch e {
			case This: return customThis ?? 'this'
			case Ident(name):
				if project.native.get(e) == true {
					return name
				}
				// S3a dual-mode: stored `closure$N` values print as the THIN
				// wrapper (`closure$N$thin_`, old signature, calls fat with the
				// global env) until S3b pairs land. Callees never reach here
				// (Call handling emits fat/thin explicitly before generic print).
				if name.startsWith('closure$'), not name.endsWith('$thin') {
					return name + '$thin_'
				}
				// S3b: fat-typed locals/params/globals print as the PTR half
				// here; binding sites (Var/Assign/arg/field) assemble pairs
				// explicitly via `fatPtrStr`/`fatEnvStr` and never route through
				// here. Missed contexts (Any-boxing, ternaries) get a marker
				// for M2+ triage — F10 pair-boxing will replace the proxy.
				if isFatValueType(valueType(e)) {
					return name + '$ptr_/*UNPAIRED-FAT*/'
				}
				return '' + name + '_'
				// case Null: return '((Unknown_ *)0)'
				// case SizeOf(what):
				// fun omitPointer(type: String): String {
				// if type.endsWith('*') {
				// return type.substr(0, type.length - 1) + ' '
				// }
				// return type
				// }
				// return 'sizeof(' + omitPointer(stringifyType(what)) + ')'
				// //return 'sizeof(' + stringifyType(what) + ')'
			case Null(dataType):

				var actualType = dataType

				switch actualType {
					case UnknownNullable(handle): if let of = handle.value {
							actualType = of
						}
					case Nullable(of): actualType = of
				}

				if actualType == project.typer.typeInt {
					return 'int32_t$null'
				}

				if actualType == project.typer.typeUInt32 {
					return 'uint32_t$null'
				}

				if actualType == project.typer.typeInt16 {
					return 'int16_t$null'
				}

				if actualType == project.typer.typeUInt16 {
					return 'uint16_t$null'
				}

				if actualType == project.typer.typeInt8 {
					return 'int8_t$null'
				}

				if actualType == project.typer.typeUInt8 {
					return 'uint8_t$null'
				}

				if actualType == project.typer.typeBool {
					// NOTE `2` is chosen because `1 == 0b1` and `2 == 0b10`
					// thus bits are different: `2 & 1 == 0` and `2 | 1 == 3`
					// also it fits nicely into `uint8_t` and `int8_t` without ambiguity
					return '(uint8_t)2'
				}

				// TODO more types

				// TODO infer actual type of null in typer,
				// to print type conversion `((T*)0)`
				return 'nullptr'
				return 'nullptr/*yup*/'
				return '((Unknown_ *)0)'

				/*
					void f(int*) { /*...*/ }
					void f(double*) { /*...*/ }
					void g()
					{
					    f(nullptr); // compilation error, ambiguous call!
					    f(static_cast<int*>(nullptr)); // now compiler knows...
					}
					*/
			case Int(v): return '(int32_t)' + v
			case MetaInt(v, kind, _): {
					switch kind {
						case Int32: return '(int32_t)' + v
						case Int64: return '(int64_t)' + v
						case Int16: return '(int16_t)' + v
						case Int8: return '(int8_t)' + v

						case UInt32: return '(uint32_t)' + v
						case UInt64: return '(uint64_t)' + v
						case UInt16: return '(uint16_t)' + v
						case UInt8: return '(uint8_t)' + v
					}

					// TODO more kinds
				}
			case Float(v):
				let v = '' + v

				if v.indexOf('.') == -1 {
					return '(double)' + v + '.0'
				}
				return '(double)' + v
			case String(string):
				if let id = declarationsOfStringsMap.get(string) {
					return 'String_\(id)'
					// + `/*has:` + string.split('*').join('#') + `*/`
				}

				let s = string.split('')
				let charsOut = []

				while s.length > 0 {
					switch s[0] {
						case "'":
							charsOut.push("\\'")
							s.shift()
						case '"':
							charsOut.push('\\"')
							s.shift()
						case "\n":
							charsOut.push("\\n")
							s.shift()
						case "\r":
							charsOut.push("\\r")
							s.shift()
						case "\\":
							s.shift()

							if s[0] == "'" {
								charsOut.push("\\'")
								s.shift()
							} else if s[0] == '"' {
								charsOut.push('\\"')
								s.shift()
							} else if s[0] == '\\' {
								charsOut.push("\\\\")
								s.shift()
							} else if s[0] == 'u' {
								// `\uXXXX` — surrogate pairs must merge
								// into ONE `\UXXXXXXXX` escape: MSVC
								// rejects lone surrogates in universal
								// character names (C3850)
								var handled = false

								if s.length >= 11, s[5] == '\\', s[6] == 'u' {
									let hi = parseInt(s[1] + s[2] + s[3] + s[4], 16)
									let lo = parseInt(s[7] + s[8] + s[9] + s[10], 16)

									if hi >= 0xD800 and hi <= 0xDBFF, lo >= 0xDC00 and lo <= 0xDFFF {
										let point = 0x10000 + ((hi - 0xD800) * 0x400) + (lo - 0xDC00)
										var hex = point.toString(16)

										while hex.length < 8 {
											hex = '0' + hex
										}

										charsOut.push('\\U' + hex)

										for k in 11 {
											s.shift()
										}

										handled = true
									}
								}

								if not handled {
									charsOut.push('\\')
								}
							} else {
								charsOut.push('\\')
							}
						case _:
							charsOut.push(s[0])
							s.shift()
					}
				}

				let id = registerString(charsOut.join(""))
				declarationsOfStringsMap.set(string, id)
				return 'String_\(id)'
				// return 'String_fromUTF8z("' + charsOut.join('') + '")'
			case True: return 'true_'
			case False: return 'false_'
			case Dot(expr, name):
				// S3b: fat-typed field reads print the PTR half here (static
				// bases excluded — they stay on the existing static path);
				// binding sites and fat callees assemble pairs explicitly and
				// never route through here. Missed contexts get a marker.
				if isFatCallee(e) {
					return printExpression(expr) + '->' + name + '$f_/*UNPAIRED-FATDOT*/'
				}
		// S3b: method values read the vtable slot (never a pair half).
		if isMethodDot(expr, name) {
			return printExpression(expr) + '->_->' + name + '_'
		}

				if name == 'toZeroOrOne' {
					let dataType = getType(expr)

					if dataType == project.typer.typeBool {
						return printExpression(expr)
					}
				}

				if name == 'ref' or name == 'address' or name == 'pointer' or name == 'pointerToSelf' {
					let dataType = getType(expr)

					switch dataType {
						case ClassInstance(c):
							if c.name == 'ByValue', name == 'ref' {
								return '(&' + printExpression(expr) + ')'
							}

							if c.name == 'ByValue', name == 'pointer' {
								return '(&' + printExpression(expr) + ')'
							}

							if c.name == 'ArrayByValue', name == 'ref' {
								return '(&' + printExpression(expr) + '[0])'
							}

							if c.name == 'ArrayByValue' and name == 'address' {
								return '(size_t)&(' + printExpression(expr) + ')'
							}

							if c.name == 'ArrayPointer' and name == 'address' {
								return '(size_t)(' + printExpression(expr) + ')'
							}

							if c.name == 'ArrayPointer' and name == 'pointerToSelf' {
								return '(&' + printExpression(expr) + ')'
							}

							if c.name == 'ConstArrayPointer' and name == 'address' {
								return '(size_t)(' + printExpression(expr) + ')'
							}
					}
				}

				switch expr {
					case This: return (customThis ?? 'this') + '->' + name + '_'
					case Ident(id, typed):
						// Static
						// TODO better detect
						if id.charAt(0) == id.charAt(0).toUpperCase(), not id.startsWith('_') {
							return id + '_$' + name + '_'
						}
						// Dynamic
						let dataType = getType(expr)

						if ((dataType == project.typer.typeAny) or (dataType == null)) {
							// TODO leaky!!
							return printExpression(expr) + '->let_(String_$fromUTF16z_(L"' + name + '"))'
						}

						switch typed {
							case ClassInstance(c):
								// if let rename = c.fieldRenames[c.fieldNames.indexOf(name)] { TODO
								if c.fieldRenames.includes(name) {
									return printExpression(expr) + '->' + name
								}
						}

						// NOTE instance members keep their STABLE `name_` C
						// field (the struct declaration always appends `_`,
						// even for `@asIs`); the typer `fieldRenames` hit means
						// nothing here — a bare rename would desync from the
						// declaration (`Set.size` printed `->size` vs `size_`)
						return printExpression(expr) + '->' + name + '_'
					case _:
						switch getType(expr) {
							case ClassInstance(c):
								if c.fieldRenames.includes(name) {
									return printExpression(expr) + '->' + name
								}
						}

						// NOTE same as above: STABLE `name_` fields, no
						// `fieldRenames` shortcut (see `Set.size` fix)
						return printExpression(expr) + '->' + name + '_'
				}

				// TODO to keep local var caches, use something like block.push()
				// into current scope
				switch kind {
					case Static:
						return printExpression(e) + printCallArguments(args)
			case Call(e, args, dataType, kind, callExpectsField):
					case VirtualMethod:
						switch e {
							case Dot(expr, name, result):
							// Dynamic receivers (`Any`/erased) have no
							// vtable — the Dot path prints the reflection
							// stub call instead (F10). F10.2: route through the
							// dynamic call slot (bags may hold the method as a
							// pair; otherwise the legacy proxy no-ops as before).
							// A raw `Any_dynGet_(...)(args)` call would not even
							// compile (`Any_*` is not callable, C2064).
							if isDynamic(valueType(expr)) {
								return printDynamicCall(e, args, exprCallExpects(callExpectsField, e))
							}

							// Scalar receivers (`(n ?? 0).toString()` on `Int`)
							// have no vtable — `int->_->toString_` is invalid C
							// (C2227/C2660). Emit the conversion helper instead
							if name == 'toString' {
								if let helper = scalarToString(printExpression(expr), cShape(expr)) {
									return helper
								}
							}

								let temp = tempId++
								let temp1 = tempId++
								let mb = metaBlock
								metaBlock = []
								let exprType = getType(expr)
								let typeString = stringifyType(exprType)
								let kind = typeString + ' _$\(temp) = ' + printExpression(expr)

								if name == 'offsetItems' or name == 'offsetItemsBack' {
									switch exprType {
										case ClassInstance(c):
											if
												c.name == 'ConstArrayPointer' or c.name == 'ArrayPointer',
												name == 'offsetItems' or name == 'offsetItemsBack'
											{
												return '((' + printExpression(expr) + ') + (' + printExpression(args[0]) + '))'
											}
									}
								}

								var isStruct = false
								switch exprType {
									case ClassInstance(classType, params): {
											let atts = project.mapDecorators.get(classType.parent)
											isStruct = Decorator.getDecorator(atts, 'struct') != null
										}
										// TODO `case ClassInstance(type, _) | Class(type)`
										// TODO same for statement
										// TODO this should be a NiceClass actually
										// TODO seems like `this` gets type of `Class` instead of instance somewhere
									case Class(classType): {
											let atts = project.mapDecorators.get(classType.parent)
											isStruct = Decorator.getDecorator(atts, 'struct') != null
										}
									case _:
								}

								let result = if isStruct {
									omitPointer(typeString) + '$' + name + '_' + printCallArgumentsVirtual('_$\(temp)', args)
								} else {
									'_$\(temp)->_->' + name + '_' + printCallArgumentsVirtual('_$\(temp)', args)
								}

								for b in metaBlock {
									mb.push(b)
								}
								mb.push(kind)
								// mb.push('/*result*/auto _$\(temp1) = ' + result)
								metaBlock = mb
								// return '_$\(temp1)'//result
								return result

								// return // + ';\n' + tabs// +
								// return printExpression(expr) + '/*virtual*/' + printCallArguments(args)
						}
				}

				// switch e {
				// // TODO better way
				// case SizeOf: return printExpression(e)
				// }
				return printExpression(e) + printCallArguments(args)

			case Arrow(expr, args, defaults, types, returns, funcType, isAsync): {
					return printExpression(
						// TODO temp names '$arrow'
						Expression.Function(null, expr: Statement.Return(expr), args, defaults, funcType, isAsync: isAsync)
					)
				}

			case Function(name, expr, args, defaults, funcType, isAsync):
				// TODO this should generate arguments from caller side, ie:
				// `f A -> B` `((a IA)=>IB)` => generate `((a A)=>B)`
				// ^ should be done at normalizer
				let _currentReturnType = currentReturnType
				currentReturnType = getFunctionReturnType(funcType)

				let temp = tempId++
				let rt = printFunctionReturnType(funcType)
				forwardFunctions.push(rt)
				// TODO This must be re-think-ed
				if defaultCallingConvention != '' {
					forwardFunctions.push(' ')
					forwardFunctions.push(defaultCallingConvention)
				}
				forwardFunctions.push(' _$\(temp)')
				forwardFunctions.push(printFunctionArguments(args, funcType))
				forwardFunctions.push(';\n')

				let tab = tabs
				tabs = ''
				globalFunctions.push(rt)
				// TODO This must be re-think-ed
				if defaultCallingConvention != '' {
					globalFunctions.push(' ')
					globalFunctions.push(defaultCallingConvention)
				}
				globalFunctions.push(' _$\(temp)')
				globalFunctions.push(printFunctionArguments(args, funcType))
				globalFunctions.push(' ')
				globalFunctions.push(printBlock(expr))
				globalFunctions.push('\n\n')
				tabs = tab

				currentReturnType = _currentReturnType
				return '_$\(temp)'

			case New(e, args, result):
				// TODO probably just `omitPointer(stringifyType(result))`
				// var name = printExpression(e) // TODO redesign, just string from normalizer
				var name = omitPointer(stringifyType(result)) // TODO redesign, just string from normalizer
				switch result {
					case ClassInstance(classType, params): {
							let atts = project.mapDecorators.get(classType.parent)
							let isStruct = Decorator.getDecorator(atts, 'struct') != null
							// TODO Only *external* `C++` and non-external Hexa structs have constructors
							// TODO check arguments count to be zero
							if isStruct {
								let shouldInit = not classType.external

								if shouldInit {
									if args.length > 0 {
										// TODO should not wrap into ( )
										return name + '$this_((\(name)*)HEXA_NEW(sizeof(\(name))), ' + printCallArguments(args) + ')'
									}
									return name + '$this_((\(name)*)HEXA_NEW(sizeof(\(name))))'
								}
								return '(\(name)*)HEXA_NEW(sizeof(\(name)))'
							}
							// if let params = params, params.length == 1 {
							// switch params[0] {
							// case Class(type): name += '$' + type.name + '_' // TODO redesign, should support renaming
							// case ClassInstance(type): name += '$' + type.name + '_' // TODO redesign, should support renaming
							// case Generic(_): name += '$Any_' // TODO should be resolved in normalizer
							// case _: console.log('New', params[0])
							// }
							// }
						}
				}
				return name + '$new_' + printCallArguments(args, constructorExpects(name))

			case Array(el, arrayType):
				var typeName = stringifyType(arrayType)

				// Erased/unknown array types still allocate a real container
				if typeName == 'Any_*' {
					typeName = 'Array_$Any_*'
				}

				if el.length == 0 {
					return '\(omitPointer(typeName))$new_(0)'
				}

				switch arrayType {
					case ClassInstance(_, generic):
						let elType: String = stringifyType(generic[0])
						return '\(omitPointer(typeName))$from_(\(omitPointer(typeName))$new_(\(el.length)), (\(elType)[])\{' + [for a in el printExpression(a)].join(', ') + '\})'
				}

				return '\(omitPointer(typeName))$from_(\(omitPointer(typeName))$new_(\(el.length)), \{' + [for a in el printExpression(a)].join(', ') + '\})'

			case Unop(op, postfix, e):
				if postfix {
					return printExpression(e) + Token.stringify(op)
				}

				// Hexa's word-operator `not` → C's `!` (a word would glue to the operand)
				if op == Token.KNot or op == Token.Exclamation {
					// Dynamic operands print as the `AnyValue_` proxy — `!`
					// on it resolves through the conversion operator, so keep
					// it parenthesized (precedence) and let `getType` report
					// `Bool` so no outer `->_toBool()` is appended (C2227)
					if cShape(e) == 'Any_*' {
						return '!(' + printExpression(e) + ')'
					}

					return '!' + printExpression(e)
				}

				return Token.stringify(op) + printExpression(e)

			case Elvis(nullable, othewise):
				return '((' + printExpression(nullable) + ')||(' + printExpression(othewise) + '))'

			case Parenthesis(e):
				return '(' + printExpression(e) + ')'

			case Binop(a, op, b):
				if op == Token.Equal or op == Token.Unequal {
					// S3b: fat `==`/`!=` compare BOTH halves (ptr+env);
					// `== null`/`!= null` test the code-ptr half only (fast path,
					// per F1-Q). `getType` lies for `Any`-coerced uses, so key on
					// `valueType` (declared types win).
					if isFatValueType(valueType(a)) or isFatValueType(valueType(b)) {
						var aNull = false
						var bNull = false
						switch a {
							case Null(_):
								aNull = true
							case _:
						}

						switch b {
							case Null(_):
								bNull = true
							case _:
						}
						let op2 = op == Token.Unequal? '!=' : '=='

						if aNull or bNull {
							let p = aNull? fatPtrStr(b) : fatPtrStr(a)
							return '(' + p + ' ' + op2 + ' nullptr)'
						}
						let pa = fatPtrStr(a)
						let pb = fatPtrStr(b)
						let ea = fatEnvStr(a)
						let eb = fatEnvStr(b)

						if op == Token.Unequal {
							return '!((' + pa + ') == (' + pb + ') && (' + ea + ') == (' + eb + '))'
						}
						return '((' + pa + ') == (' + pb + ') && (' + ea + ') == (' + eb + '))'
					}
					// TODO commutative
					if let aType = getType(a), aType == project.typer.typeNullUInt64 {
						return (op == Token.Unequal? '!' : '') + 'equalNull$UInt64(' + printExpression(a) + ', ' + printTypeConverter(printExpression(b), getType(b), aType) + ')'
					}

					if let aType = getType(a), aType == project.typer.typeNullFloat32 {
						return (op == Token.Unequal? '!' : '') + 'equalNull$Float32(' + printExpression(a) + ', ' + printTypeConverter(printExpression(b), getType(b), aType) + ')'
					}

					// Mismatched operand shapes — scalar-vs-scalar compares by
					// VALUE (int64, or double if a float is involved) so
					// sentinel loops (`c != 0`) terminate after D7 boxing
					// (heap boxes break per-value pointer identity); every
					// pointer-involved shape keeps the legacy box-both
					// identity compare, observably unchanged.
					// NOTE shapes via `binopShape` — use-node types can lie,
					// and a `Dot` on a dynamic base prints `Any_*`
					// (`Any_dynGet_`) no matter what the use node claims
					// (raw cross-type compares are C2446)
					let aName = binopShape(a)
					let bName = binopShape(b)

					if aName != bName {
						let op2 = op == Token.Unequal? '!=' : '=='

						if isIntCTypeName(aName), isIntCTypeName(bName) {
							return '((int64_t)(' + printExpression(a) + ') ' + op2 + ' (int64_t)(' + printExpression(b) + '))'
						}

						if isFloatCTypeName(aName) {
							if isIntCTypeName(bName) or isFloatCTypeName(bName) {
								return '((double)(' + printExpression(a) + ') ' + op2 + ' (double)(' + printExpression(b) + '))'
							}
						}

						if isFloatCTypeName(bName) {
							if isIntCTypeName(aName) or isFloatCTypeName(aName) {
								return '((double)(' + printExpression(a) + ') ' + op2 + ' (double)(' + printExpression(b) + '))'
							}
						}
						return printToAnyConverter(printExpression(a), binopFromType(a)) + ' ' + op2 + ' ' + printToAnyConverter(printExpression(b), binopFromType(b))
					}
				}

				if op == Token.Add {
					if getType(a) == project.typer.typeString {
						return 'String_$combine_(' + printExpression(a) + ', ' + printTypeConverter(printExpression(b), getType(b), project.typer.typeString) + ')'
					}

					if getType(b) == project.typer.typeString {
						return 'String_$combine_(' + printTypeConverter(printExpression(a), getType(a), project.typer.typeString) + ', ' + printExpression(b) + ')'
					}
				}

				let token = op == Token.IntegerDivide? '/' : Token.stringify(op)
				return printExpression(a) + ' ' + token + ' ' + printExpression(b)

			case Index(expr, index):
				switch getType(expr) {
					case ClassInstance(classType, generic):
						if classType.name != 'Array' {
							return printExpression(expr) + '[' + printTypeConverter(printExpression(index), getType(index), project.typer.typeInt) + ']'
						}
				}

				// TODO meta block
				// let expr = printExpression(expr)
				// let index = printTypeConverter(printExpression(index), getType(index), project.typer.typeInt)
				return printExpression(Expression.Call(
						// TODO `set`
						Expression.Dot(expr, 'get', null /*TODO*/),
						[index],
						project.typer.typeAny, // TODO this is a reflection access
						CallKind.VirtualMethod
					))

			case If(econd, eif, eelse):
				var r = ''

				try {
						// F10.3: ternary with a fat branch boxes the pair per
						// side (statement-style if/else into a hoisted temp —
						// a riding ternary would drop one side's env, and the
						// two sides may be different impls). The temp is
						// `Any_*`; outer contexts convert as usual (fat
						// outers unbox pairs exactly). Fat-RESULT ternaries
						// stay S3c (need pair temps).
						var anyFatBranch = isBoxableFat(eif)
						if not anyFatBranch {
							anyFatBranch = isBoxableFat(eelse)
						}
						if anyFatBranch {
						let t = tempId++
						let tmp = '_$ftn' + t
						metaBlock.push('Any_* ' + tmp + ' = nullptr')
						var ba = printTypeConverter(printExpression(eif), valueType(eif), project.typer.typeAny)
						var bb = printTypeConverter(printExpression(eelse), valueType(eelse), project.typer.typeAny)

						if isBoxableFat(eif) {
							ba = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(eif) + '), ' + fatEnvStr(eif) + ')'
						}

						if isBoxableFat(eelse) {
							bb = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(eelse) + '), ' + fatEnvStr(eelse) + ')'
						}
						metaBlock.push('if (' + printExpression(econd) + ') ' + tmp + ' = ' + ba + '; else ' + tmp + ' = ' + bb)
						return tmp
					}
					// Mismatched branch shapes have no common C type — prefer
					// the TYPED side, but ONLY when the If RESULT is typed too
					// (a lone dynamic branch converts toward it). A dynamic
					// RESULT keeps box-both: the outer context converts the
					// Any value itself (`->_toInt()` etc.), and a pre-converted
					// typed ternary would break that outer conversion (C2227)
					let aName = cShape(eif)
					let bName = cShape(eelse)
					let resultTyped = stringifyType(getType(e)) != 'Any_*'

					if aName != bName, resultTyped {
						if aName == 'Any_*', bName != 'Any_*', bName != 'void' {
							return '(' + printExpression(econd) + ')?(' + printTypeConverter(printExpression(eif), valueType(eif), valueType(eelse)) + '):(' + printExpression(eelse) + ')'
						}

						if bName == 'Any_*', aName != 'Any_*', aName != 'void' {
							return '(' + printExpression(econd) + ')?(' + printExpression(eif) + '):(' + printTypeConverter(printExpression(eelse), valueType(eelse), valueType(eif)) + ')'
						}
					}

					if aName != bName {
						// F10.3: fat branches into the `Any` box pair (leaf
						// shapes only — composites keep the legacy drop).
						var boxA = printToAnyConverter(printExpression(eif), valueType(eif))
						var boxB = printToAnyConverter(printExpression(eelse), valueType(eelse))

						if isBoxableFat(eif) {
							boxA = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(eif) + '), ' + fatEnvStr(eif) + ')'
						}

						if isBoxableFat(eelse) {
							boxB = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(eelse) + '), ' + fatEnvStr(eelse) + ')'
						}
						return '(' + printExpression(econd) + ')?(' + boxA + '):(' + boxB + ')'
					}

					r += '(' + printExpression(econd) + ')?'
					r += '(' + printExpression(eif) + ')'
					r += ':' + printExpression(eelse)
					return r
				} catch error: Any {
					console.log('If =>', e, error)
					// TODO eliminate this "debug"
					return r + '<!--If => error-->'
				}

			case EnumTag(expr):
				let e = printExpression(expr)
				return '(' + e + ' == ((Unknown_ *)0)? -1 : ' + e + '->is_)'

			case Object(names, el):
				// Keys are JS property names — print them as Hexa String literals
				// (the first key also lands in `Object_from`'s `stub` parameter)
				if el.length == 0 {
					// The `stub` parameter must still be passed
					return 'Object_from(nullptr)'
				}

				return 'Object_from(' + [for i in el.length {
						((names[i]) + ', ' + printExpression(el[i]))
					}].join(', ') + ')'

			case Map(keys, values, keyType, valueType, mapType):
				let typeName = omitPointer(stringifyType(mapType))

				if keys.length == 0 {
					return '\(typeName)$new_()'
				}

				let kType: String = stringifyType(keyType)
				let vType: String = stringifyType(valueType)
				let keyItems = [for el in keys printExpression(el)].join(', ')
				// Struct-typed values: real construction (see printObjectAs).
				let valStrs: [String] = []

				for el in values {
					if let s = printObjectAs(valueType, el) { valStrs.push(s) }
					// F10.3: fat values into `Any` slots box pairs (leaf
					// shapes only — composites have no addressable pair).
					else if isBoxableFat(el), stringifyType(valueType) == 'Any_*' { valStrs.push('Any_boxFatPair_((void(*)())(' + fatPtrStr(el) + '), ' + fatEnvStr(el) + ')') }
					else { valStrs.push(printExpression(el)) }
				}
				let valueItems = valStrs.join(', ')

				// C++ has no compound literals (C4576) — `hexaItems` instead
				if cpp {
					return '\(typeName)$from_(\(typeName)$new_(), \(keys.length), hexaItems<\(kType)>(\(keyItems)), hexaItems<\(vType)>(\(valueItems)))'
				}

				return '\(typeName)$from_(\(typeName)$new_(), \(keys.length), (\(kType)[])\{' +
				[for el in keys printExpression(el)].join(', ')
				+ '\}, (\(vType)[])\{' +
				[for el in values printExpression(el)].join(', ')
				// TODO keep order with meta blocks `[for i in keys.length '' + printExpression(keys[i]) + ', ' + printExpression(values[i]) + ''].join(', ')`
				+ '\})'

				// TODO rename to `AssignOp`
			case Assignop(a, op, value):
				return printExpression(a) + ' ' + Token.stringify(op) + '= ' + printExpression(value)

			case NativeOperator(kind, args, s, params, result): switch kind {
					case Infix:
						return '((' + printExpression(args[0]) + ')' + s + '(' + printExpression(args[1]) + '))'
					case Function:
						if let params = params, s == '*sizeof' {
							return 'sizeof(' + omitPointer(stringifyType(params[0])) + ')'
						}

						if let params = params, s == '&sizeof' {
							return 'sizeof(' + stringifyType(params[0]) + ')'
						}
						return s + printCallArguments(args)
					case Prefix:
						return '(' + s + '(' + printExpression(args[0]) + '))'
					case Postfix:
						return '((' + printExpression(args[1]) + ')' + s + ')'
				}

			case UnsafeBitCast(e, to):
				// switch e {
				// case Null: return '(/*UnsafeBitCast*/(Unknown_ *)0)'
				// // TODO maybe use `0` value? or static_cast?
				// }
				return printTypeConverter(printExpression(e), getType(e), to)
				// return 'reinterpret_cast<' + stringifyType(to) + '>(' + printExpression(e) + '))'
				// return '(*reinterpret_cast<' + stringifyType(to) + ' *>(&' + printExpression(e) + '))'

			case Enum(typeName, tagName, tag, args):
				return '' + typeName + '_$' + tagName + '_(' + [for a in args printExpression(a)].join(', ') + ')'

			case EnumParameter(expr, index):
				return printExpression(expr) + '->enum_[' + index + ']'

				// Unbound `_` must never reach codegen — it is a compilation error
			case Underscore:
				throw 'Expression `_` reached codegen — normalizer must bind it first'

				// F9: inside `async fun`, `await p` (Promise) suspends via `co_await`.
				// `co_await (*p)` (deref: operator takes `S&`) yields `Any_*`
				// (`await_resume`), then unboxes to `T` (same bridges as the
				// settled `.value` read it replaces). Settled promises skip
				// suspension via `await_ready` (Phase-1 fast path preserved);
				// pending ones suspend and resume on the frame pump
				// (`hexaPumpResumes`, zero host edits). Outside async (or
				// non-Promise) keeps the pass-through (M1 safe).
					// C++ forbids `co_await` inside `catch` (C2304) — fall back
					// to the settled `.value` read below (no suspension).
					if insideAsyncFunction, not insideCatch {
						var awaitedAsync = getType(e)
						var promiseT: Type? = null
						switch awaitedAsync {
							case ClassInstance(classType, generic):
								if classType.name == 'Promise', generic != null, generic.length == 1 {
									promiseT = generic[0]
								}
							case _:
						}
						if let t = promiseT {
							if t == project.typer.typeVoid {
								return '(co_await (*' + printExpression(e) + '), (void)0)'
			case Await(e):
							}
						let base = '(co_await (*' + printExpression(e) + '))'

						if t == project.typer.typeInt {
							return 'Any_unboxInt_(' + base + ')'
						}

						if t == project.typer.typeFloat or t == project.typer.typeNumber {
							return 'Any_unboxFloat_(' + base + ')'
						}

						if t == project.typer.typeInt64 or t == project.typer.typeUInt64 {
							return 'Any_unboxInt64_(' + base + ')'
						}

						if t == project.typer.typeBool {
							return '(' + base + ')->_toBool()'
						}
							return '((' + stringifyType(t) + ')(size_t)(' + base + '))'
						}
					}
					// The C value is still the PROMISE pointer while `getType`
					// reports the awaited result type — cast to it so
					// `let x: T = await p` compiles (no-op until F9).
					// Void-C callees (`async fun` without `return`) carry no C
					// value — sequence for effects, yield typed null instead
					// of casting `void` (C2440).
					if isVoidValue(e) {
						var awaitedVoid = getType(e)

						switch awaitedVoid {
							case ClassInstance(classType, generic):
								if classType.name == 'Promise', generic != null, generic.length == 1 {
									awaitedVoid = generic[0]
								}
							case _:
						}

						return '(' + printExpression(e) + ', (' + stringifyType(awaitedVoid) + ')0)'
					}
					var awaited = getType(e)

					var settled = false
					switch awaited {
						case ClassInstance(classType, generic):
							if classType.name == 'Promise', generic != null, generic.length == 1 {
								// Phase-1 native await (F9 lands real suspension):
								// promises settle synchronously (resolve() stores
								// .value at construction; executor promises never
								// settle) and there is no event loop to suspend
								// on — so read the settled value instead of
								// reinterpreting the promise object (which jumps
								// into garbage via vtable mismatch, M3 boot).
								if generic[0] != project.typer.typeVoid {
									awaited = generic[0]
									settled = true
								}
							}
						case _:
					}

					if settled {
						let base = '(' + printExpression(e) + ')->value_'
						// Scalar Ts unbox through the conversion helpers
						// (null-safe: unsettled promises read defaults
						// instead of crashing).
						if awaited == project.typer.typeInt {
							return 'Any_unboxInt_(' + base + ')'
						}
						if awaited == project.typer.typeFloat or awaited == project.typer.typeNumber {
							return 'Any_unboxFloat_(' + base + ')'
						}
						if awaited == project.typer.typeInt64 or awaited == project.typer.typeUInt64 {
							return 'Any_unboxInt64_(' + base + ')'
						}
						if awaited == project.typer.typeBool {
							return '(' + base + ')->_toBool()'
						}
						return '((' + stringifyType(awaited) + ')(size_t)(' + base + '))'
					}

				return '((' + stringifyType(awaited) + ')(' + printExpression(e) + '))'

				// `x !.` force-unwrap — nullability checks are elided for now (stub)
			case RemoveNullability(expr, _):
				return printExpression(expr)

				// `"str"[i]` — `String?` per element: the ADDRESS of the
				// character slot stands in for the one-char string (F7)
			case StringIndex(expr, index, _):
				return '(&' + printExpression(expr) + '[' + printTypeConverter(printExpression(index), getType(index), project.typer.typeInt) + '])'

				// `x is T` — vtable-tag check for `Any` receivers (F10.1 first
				// consumer: exact-type, null-safe); everything else keeps the
				// legacy truthiness path (other targets emit it too).
			case Is(e, t):
				if let tag = anyIsTagCheck(e, t) {
					return tag
				}
				return '((bool)(' + printExpression(e) + '))'

				// `...value` — a runtime list cannot expand statically (stub: pass as-is)
			case Spread(expr):
				return printExpression(expr)

			case StringConcatenation(leftString, rightString):
				return 'String_$combine_(' + printExpression(leftString) + ', ' + printExpression(rightString) + ')'

			case _:
				console.error("Unknown expression kind:", e)
				return '<!--' + ((e as!Any)??[])[0] + '-->'
		}
	}
}
