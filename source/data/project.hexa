/// `module.hexa`
class Module {
	var file: String = '.hexa'
	var path: String = 'module'
	var nodes: [Node] = []
	let exported: [String : Node] = [:]
	let imported: [String : Node] = [:]
	// TODO private exports

	new () {
	}
}

/// Global data container
class Project {
	let mapDecorators: [Node : [Decorator]] = [:]
	let typeDecorators: [NodeType : [Decorator]] = [:]
	let mapNames: [Node : Node] = [:]
	let mapModules: [Node : Module] = [:]
	// TODO rename to spans or at or span
	let data: [Node : NodeData] = [:]
	let hints: [Hint] = []
	// TODO Defines to Map Enums Bool String Int Float in the Project
	var defines: Any = { }
	var name: String = 'Hexa Project'
	var json: String = 'hexa.json'
	var roots: [String] = []

	let globals: [String : Node] = [:]
	// Auto-require tracking: names of top-level `declare` bindings annotated
	// with @require('mod') that were actually referenced (filled by the typer
	// Ident hook; read by the normalizer, which records only these into
	// NiceProject.globalRequires — unused modules emit nothing).
	var usedRequires [String] = []
	// @lazy tracking: names of top-level `let x X = X()` bindings annotated
	// with @lazy that were actually referenced (filled by the typer Ident
	// hook, same as usedRequires; read by the normalizer, which skips the
	// whole let — initializer included — when unused, so the `X()` startup
	// instantiation and the class never reach the IR).
	var usedLazy [String] = []
	let moduleName: [String] = []
	let moduleInfo: [Module] = []

	// TODO remove this hack
	let mapFuncParams: [Node : [NodeType]] = [:]

	/// Readonly flags for nodes
	// TODO better name + Node.dup code update + server pretty-print + prettify + etc
	let mapReadonly: [Node : Bool] = [:]

	/// Readonly flags for node types
	let typeReadonly: [NodeType : Bool] = [:]

	/// Static flags for nodes (class/enum fields)
	let mapStatic: [Node : Bool] = [:]

	/// Private flags for nodes (class/enum fields and module declarations)
	let mapPrivate: [Node : Bool] = [:]

	/// Async flags for nodes
	let mapAsync: [Node : Bool] = [:]

	/// `async` field or `async(mode)` field
	/// mode is an optional expression like `async(isAsync) fun ...`
	let mapAsyncMode: [Node : Node?] = [:]

	/// Decorator comments
	// let decoratorComments: [Decorator : [Comment]] = [:]

	/// Map of node to array of comments that appear before the node
	// TODO better name + Node.dup code update + server pretty-print + prettify + etc
	let leadingComments: [Node : [Comment]] = [:]

	/// Map of node to array of comments that appear after the node
	// let trailingComments: [Node : [Comment]] = [:]

	/// Map of node to array of comments that appear between the node tokens
	// let infixComments: [Node : [Comment]] = [:]

	/// Whether to collect and store comments during parsing
	// TODO configurable? only docs?
	/// var collectComments: Bool = true

	new () {
	}
}
