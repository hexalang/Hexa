declare fun require(package: String): Any
declare let __dirname: String
declare let __filename: String

// TODO reqire(Buffer)? node:Buffer `require('node:buffer').Buffer`
@rename("Buffer")
@native("Buffer")
declare class Buffer {
	static fun alloc(size: Int): Buffer
	let length: Int
	let buffer: ArrayBuffer
	let byteOffset: Int
	fun slice(offset: Int = 0): Buffer
	fun copy(to: Buffer, offset: Int): Void // TODO returns Int?
	// Read methods
	fun readUInt8(offset: Int): Int
	fun readUInt16LE(offset: Int): Int
	fun readUInt16BE(offset: Int): Int
	fun readUInt32LE(offset: Int): Int
	fun readUInt32BE(offset: Int): Int
	fun readInt8(offset: Int): Int
	fun readInt16LE(offset: Int): Int
	fun readInt16BE(offset: Int): Int
	fun readInt32LE(offset: Int): Int
	fun readInt32BE(offset: Int): Int
	fun readFloatLE(offset: Int): Float
	fun readFloatBE(offset: Int): Float
	fun readDoubleLE(offset: Int): Float
	fun readDoubleBE(offset: Int): Float
	fun readBigInt64LE(offset: Int): BigInt
	fun readBigInt64BE(offset: Int): BigInt
	fun readBigUInt64LE(offset: Int): BigInt
	fun readBigUInt64BE(offset: Int): BigInt
	// Write methods
	fun writeUInt8(value: Int, offset: Int): Int
	fun writeUInt16LE(value: Int, offset: Int): Int
	fun writeUInt16BE(value: Int, offset: Int): Int
	fun writeUInt32LE(value: Int, offset: Int): Int
	fun writeUInt32BE(value: Int, offset: Int): Int
	fun writeInt8(value: Int, offset: Int): Int
	fun writeInt16LE(value: Int, offset: Int): Int
	fun writeInt16BE(value: Int, offset: Int): Int
	fun writeInt32LE(value: Int, offset: Int): Int
	fun writeInt32BE(value: Int, offset: Int): Int
	fun writeFloatLE(value: Float, offset: Int): Int
	fun writeFloatBE(value: Float, offset: Int): Int
	fun writeDoubleLE(value: Float, offset: Int): Int
	fun write(string: String, offset: Int, encoding: String): Int
	fun toString(encoding: String = 'utf8', start: Int = 0, end: Int = 1073741824): String
	static fun from(string: String, encoding: String = 'utf8'): Buffer
	static fun concat(buffers: [Buffer]): Buffer
	fun writeDoubleBE(value: Float, offset: Int): Int
	fun writeBigInt64LE(value: BigInt, offset: Int): Int
	fun writeBigInt64BE(value: BigInt, offset: Int): Int
	fun writeBigUInt64LE(value: BigInt, offset: Int): Int
	fun writeBigUInt64BE(value: BigInt, offset: Int): Int
}

declare class ProcessStd {
	fun write(text: String): Void
	fun once(name: String, callback: () => Void): Void
	fun on(name: String, callback: (data: Any) => Void): Void
	fun setEncoding(encoding: String): Void
	let fd: Any
}

// TODO drop this class
@rename("process")
@native("process")
declare class Process {
	static let stdin: ProcessStd
	static let stdout: ProcessStd
	static let stderr: ProcessStd
	static let argv: [String]
	static fun exit(errorCode: Int): Void
	static let versions: { node: String }
	fun cwd(): String
	let env: Any
}

@require("process")
declare class ProcessModule {
	let stdin: ProcessStd
	let stdout: ProcessStd
	let stderr: ProcessStd
	let argv: [String]
	let arch: String
	let title: String
	let pid: Int
	let ppid: Int
	let platform: String
	var exitCode: Int
	let features: Any
	let release: Any
	fun exit(errorCode: Int): Void
	fun cwd(): String
	let versions: { node: String } // todo not require value = for lets in declare
	let env: Any // todo not require value = for lets in declare
	fun memoryUsage(): { rss: Int, heapTotal: Int, heapUsed: Int }
	fun chdir(directory: String): Void
	fun uptime(): Float
	fun hrtime(): [Int: Int]
	fun nextTick(callback: () => Void): Void
}

// TODO @require("process")
declare let process: ProcessModule

declare class ParsedPath {
	var root: String
	var dir: String
	var base: String
	var ext: String
	var name: String
}

// TODO drop this class
@require("path")
declare class Path {
	static let sep: String
	static let delimiter: String
	static fun basename(path: String, ext: String? = null): String
	static fun dirname(path: String): String
	static fun extname(path: String): String
	static fun normalize(path: String): String
	static fun resolve(...path: String): String
	static fun isAbsolute(path: String): Bool
	static fun relative(from: String, to: String): String
	static fun format(pathObject: ParsedPath): String
	static fun parse(path: String): ParsedPath
	static fun join(...path: String): String
}

// TODO drop this class
@require("fs")
declare class Fs {
	static fun writeFileSync(path: String, data: String): Void
	static fun readdirSync(path: String): [String]
	static fun readFileSync(path: String): Buffer
	static fun appendFileSync(path: String, data: Any, options: Any? = null): Void
	static fun rmdirSync(path: String, options: Any? = null): Void
	static fun unlinkSync(path: String): Void
	static fun rmSync(path: String, options: Any? = null): Void
	static fun renameSync(oldPath: String, newPath: String): Void
	static fun statSync(path: String): Any
	static fun lstatSync(path: String): Any
	static fun existsSync(path: String): Bool
	static fun mkdirSync(path: String): Void
	static fun readSync(fd: Int, buffer: Buffer, offset: Int, length: Int, position: Int = 0): Int
	static fun openSync(path: String, flags: String): Int
	static fun realpathSync(path: String, options: Any? = null): String
	static fun closeSync(fd: Int): Void
	static fun writeSync(fd: Int, buffer: Buffer, offset: Int? = null, length: Int? = null, position: Int? = null): Int
	static fun fstatSync(fd: Int): Any
	static fun ftruncateSync(fd: Int, len: Int? = null): Void
	static fun chmodSync(path: String, mode: Int): Void
	static fun chownSync(path: String, uid: Int, gid: Int): Void
	static fun symlinkSync(target: String, path: String, typed: String? = null): Void
	static fun linkSync(existingPath: String, newPath: String): Void
}

fun btoa(text: String) {
	return Buffer.from(text, 'binary').toString('base64')
}

fun atob(base64: String) {
	return Buffer.from(base64, 'base64').toString('binary')
}

declare fun setImmediate(callback: () => Void,...args: Any): Int
declare fun clearImmediate(id: Int): Void
declare fun queueMicrotask(callback: () => Void): Void

@require("os")
declare class Os {
	static fun platform(): String
	@rename('type') static fun typed(): String
	static fun release(): String
	static fun arch(): String
	static fun homedir(): String
	static fun tmpdir(): String
	static fun hostname(): String
	static fun uptime(): Float
	static fun totalmem(): Float
	static fun freemem(): Float
	static fun cpus(): [Any]
	static fun networkInterfaces(): Any
	static fun endianness(): String
	@rename('EOL') static let eol: String
	static fun userInfo(options: Any? = null): Any
}

// ─── Node-idiomatic module singletons (lowercase, auto-required) ────────────
// `declare let fs: FsModule` + `@require("fs")` ⇒ genJs emits
// `const fs = require("fs")` on first use and omits it when unused.
declare class FsPromises {
	fun readFile(path: String, encoding: Any): Promise<Any>
	fun writeFile(path: String, data: Any, encoding: Any): Promise<Void>
	fun rename(oldPath: String, newPath: String): Promise<Void>
	fun readdir(path: String, options: Any? = null): Promise<[Any]>
	fun mkdir(path: String, options: Any? = null): Promise<Void>
	fun stat(path: String): Promise<Any>
}

declare class FsModule {
	let promises: FsPromises
	fun writeFileSync(path: String, data: Any, options: Any? = null): Void
	fun appendFileSync(path: String, data: Any, options: Any? = null): Void
	// Any: text encoding → String, else Buffer (Node overloads — unbox with `as`)
	fun readFileSync(path: String, options: Any? = null): Any
	fun readdirSync(path: String, options: Any? = null): [Any]
	// Callback-form readdir (err-first) — used by the icons loader.
	fun readdir(path: String, options: Any? = null, callback: Any? = null): Any
	fun mkdirSync(path: String, options: Any? = null): Void
	fun rmdirSync(path: String, options: Any? = null): Void
	fun unlinkSync(path: String): Void
	fun rmSync(path: String, options: Any? = null): Void
	fun renameSync(oldPath: String, newPath: String): Void
	fun statSync(path: String): Any
	fun lstatSync(path: String): Any
	fun existsSync(path: String): Bool
	fun realpathSync(path: String, options: Any? = null): String
	fun openSync(path: String, flags: String, mode: Int? = null): Int
	fun closeSync(fd: Int): Void
	fun readSync(fd: Int, buffer: Any, offset: Int, length: Int, position: Int? = null): Int
	fun writeSync(fd: Int, buffer: Any, offset: Int? = null, length: Int? = null, position: Int? = null): Int
	fun fstatSync(fd: Int): Any
	fun createReadStream(path: String, options: Any? = null): Any
}

@require("fs")
declare let fs: FsModule

declare class PathModule {
	let sep: String
	let delimiter: String
	fun basename(path: String, ext: String? = null): String
	fun dirname(path: String): String
	fun extname(path: String): String
	fun normalize(path: String): String
	fun resolve(...path: String): String
	fun isAbsolute(path: String): Bool
	fun relative(from: String, to: String): String
	fun format(pathObject: Any): String
	fun parse(path: String): Any
	fun join(...path: String): String
}

@require("path")
declare let path: PathModule

declare class ChildProcessModule {
	fun spawn(command: String, args: Any? = null, options: Any? = null): Any
	fun spawnSync(command: String, args: Any? = null, options: Any? = null): Any
	fun exec(command: String, options: Any? = null, callback: Any? = null): Any
	fun execFile(file: String, args: Any? = null, options: Any? = null, callback: Any? = null): Any
	fun fork(modulePath: String, args: Any? = null, options: Any? = null): Any
}

@require("child_process")
declare let child_process: ChildProcessModule

declare class CryptoModule {
	fun randomUUID(): String
}

@require("crypto")
declare let crypto: CryptoModule

declare class ReadlineModule {
	fun createInterface(options: Any): Any
}

@require("readline")
declare let readline: ReadlineModule

declare class HttpsModule {
	fun get(url: String, callback: Any): Any
	fun request(url: String, options: Any? = null, callback: Any? = null): Any
}

@require("https")
declare let https: HttpsModule

declare class HttpModule {
	fun get(url: String, callback: Any): Any
	fun request(url: String, options: Any? = null, callback: Any? = null): Any
}

@require("http")
declare let http: HttpModule

interface FsDirent {
	fun isFile() Bool
	fun isDirectory() Bool
	let name String
}

// Interface for Node.js fs.Stats - file metadata
interface FsStats {
	let size Int
	fun isFile() Bool
	fun isDirectory() Bool
}

// Interface for Node.js fs module - Synchronous file operations
interface FsSync {
	let promises Any
	fun mkdirSync(path String, options Any? = null) Void
	fun appendFileSync(path String, data String, encoding String?) Void
	fun writeFileSync(path String, data String, encoding String?) Void
	fun readFileSync(path String, encoding String? = null) String
	fun statSync(path String) FsStats
	fun createReadStream(path String, options Any? = null) Any
	fun existsSync(path String) Bool
	fun readdir(path String, options Any? = null, callback Any? = null) Array<FsDirent>
	fun renameSync(oldPath String, newPath String) Void
	fun rmSync(path String, options Any? = null) Void
}
