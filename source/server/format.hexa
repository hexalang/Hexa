/// Formatting preserves user personal style to some degree
// TODO hexa format cli .hexa .json
// TODO cover in testFormat.hexa
fun autoFormatWholeFile(file: String): String {
	let content = Buffer.from(file)
	try {
		// TODO range formatter
		let tokens = Lexer.tokenize(content, 'hexa.hexa', format: true)
		let count = tokens.line.length - 1
		let result = ['']
		var lastLine = 1
		var lastToken = Token.Eof
		var lastLastToken = Token.Eof
		var lastLastGeneric = false

		var tabs = ''
		var tabStack = ['']
		var tabCase = [false]
		var depth = 0
		let assignOp = [Token.Add, Token.Multiply, Token.Subtract, Token.BitwiseAnd, Token.BitwiseOr]
		var parenthesis = -1000000

		fun updateTab() {
			tabs = tabStack.slice(0, depth + 1).join('')
		}

		fun pushTab() {
			depth++
			tabStack[depth] = '\t'
			updateTab()
		}

		fun popTab() {
			depth--
			if depth < 0 {
				depth = 0
			}
			updateTab()
		}

		fun appendTab() {
			// TODO array[]op= should work at least for strings (and Numbers?)
			tabStack[depth] += '\t'
			updateTab()
		}

		fun resetTab() {
			tabStack[depth] = '\t'
			updateTab()
		}

		fun getToken(i) Token {
			if let token = tokens.token[i] {
				return token as! Token
			}
			return Token.Eof
		}

		fun getTokenLength(i) Int {
			return Token.stringify(getToken(i), tokens.value[i], tokens.meta[i]).length
		}

		for i in count {
			let token = tokens.token[i] as! Token

			if lastToken == Token.Sharp {
				result.push(Token.stringify(token, tokens.value[i], tokens.meta[i]))
				lastToken = token
				continue
			}

			if
				token == Token.BlockClose or
				token == Token.CallClose or
				(token == Token.Sharp and getToken(i + 1) != Token.KIf) or
				token == Token.IndexClose
			{
				parenthesis--
				popTab()
			}

			if token == Token.BlockOpen and parenthesis == 0 {
				parenthesis = -1000000
				popTab()
			}

			if token == Token.KCase {
				resetTab()
			}

			var shouldSpace = true
			let line = tokens.line[i]
			if line != lastLine {
				result.push('\n')
				// Handle double \n\n
				let lineDiff = line - lastLine
				if lineDiff > 1 {
					result.push('\n')
				}

				// TODO if bool? of array[i] not valid `if tabCase[depth] {}`, require == true
				result.push(tabs)

				// `=\nvalue`
				if lastToken == Token.Assign {
					result.push('\t')
				}

				shouldSpace = false
			}

			// When evaluated to `true` it means `shouldSpace = false`
			if
				// `#if`
				lastToken == Token.Sharp or

				// TODO if\nconds\n{}
				lastToken == Token.Eof or
				lastToken == Token.Dot or
				token == Token.Dot or

				// `+=`
				(token == Token.Assign and assignOp.includes(lastToken)) or

				// `~123`
				lastToken == Token.BitwiseNot or

				// `(something`
				lastToken == Token.CallOpen or
				// `(`
				(
					token == Token.CallOpen and
					(
						// Keywords
						lastToken != Token.KIn and
						lastToken != Token.KReturn and
						lastToken != Token.KIf and
						lastToken != Token.KFun and
						lastToken != Token.KNew and
						lastToken != Token.KNot and
						lastToken != Token.KSwitch and
						lastToken != Token.KWhile and
						lastToken != Token.KDo and
						lastToken != Token.KFor and
						lastToken != Token.LogicalAnd and
						lastToken != Token.LogicalOr and

						// Operators
						lastToken != Token.Assign and
						lastToken != Token.Add and
						lastToken != Token.Subtract and
						lastToken != Token.Multiply and
						lastToken != Token.Divide and
						lastToken != Token.Remainder and
						lastToken != Token.BitwiseAnd and
						lastToken != Token.BitwiseOr and
						lastToken != Token.Comma and
						lastToken != Token.Equal and
						lastToken != Token.Unequal and
						lastToken != Token.Less and

						// Preserve cause `Class<T>()` and `a > (b)`
						not (
							(
								lastToken == Token.Greater
							) and (
								tokens.column[i] != 1 + (tokens.column[i - 1] ?? 0)
							)
						) and

						lastToken != Token.LessOrEqual and
						lastToken != Token.GreaterOrEqual and
						lastToken != Token.BitwiseLeftShift and
						lastToken != Token.BitwiseRightShift and
						lastToken != Token.UnsignedRightShift and
						lastToken != Token.Interval and
						lastToken != Token.Colon and
						// Includes `??`
						lastToken != Token.Question and
						// `)(`
						lastToken != Token.CallClose and

						// `@demo()` but not `@demo ()`
						not (
							(
								lastToken == Token.Identifier
							) and (
								(lastLastToken == Token.At and tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0))
							)
						)
					)
				) or
				// @sds() TODO error () no args not allowed
				token == Token.CallClose or

				// `[`
				lastToken == Token.IndexOpen or
				(
					token == Token.IndexOpen and
					(
						// Preserve cause `value[index]` and `value [T]`
						not (
							tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)

					/*
					(
						lastToken == Token.Identifier or
						lastToken == Token.IndexClose
					) and (
						(
							// TODO same for ()=>
							lastLastToken != Token.KVar and
							lastLastToken != Token.CallOpen and // TODO use isFunctionArgument
							lastLastToken != Token.Comma and // TODO use isFunctionArgument
							lastLastToken != Token.KLet
						) or line != lastLastLine
					)
					*/
				) or
				token == Token.IndexClose or
				// `@at`
				(token == Token.Identifier and lastToken == Token.At) or
				// `...arg`
				(
					token == Token.Identifier and lastToken == Token.Interval and
					(
						// `, ...arg`
						lastLastToken == Token.Comma or
						// `(...arg`
						lastLastToken == Token.CallOpen
						// TODO conflicts with `(value) ... range`
						// `@dec ...let`
						// lastLastToken == Token.Identifier
						// `@dec() ...let`
						// lastLastToken == Token.CallClose
					)
				) or

				(
					token == Token.Question and
					(
						// `??`
						lastToken == Token.Question or
						// `Type?`
						// lastToken == Token.Title

						// Preserve cause `a ? b : c` and `T?`
						not (
							tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)
				) or

				// `as!`
				(lastToken == Token.KAs and token == Token.KNot) or

				// `++`
				token == Token.Increment or

				// `--`
				token == Token.Decrement or

				// `-123`
				(
					(
						token == Token.FloatingPoint or
						token == Token.Integer or
						token == Token.Identifier
					) and
					lastToken == Token.Subtract and
					(
						lastLastToken == Token.IndexOpen or
						lastLastToken == Token.BlockOpen or
						lastLastToken == Token.Comma or
						lastLastToken == Token.Colon or
						lastLastToken == Token.CallOpen or
						lastLastToken == Token.Question or
						lastLastToken == Token.Assign or
						lastLastToken == Token.Equal or
						lastLastToken == Token.Greater or
						lastLastToken == Token.GreaterOrEqual or
						lastLastToken == Token.Less or
						lastLastToken == Token.LessOrEqual or
						lastLastToken == Token.Unequal
					)
				) or

				// `demo<T>` but not `demo <T>`
				(
					token == Token.Less and (
						(
							lastToken == Token.Identifier or lastToken == Token.Title
						) and (
							tokens.column[i] == getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)
				) or
				lastLastGeneric or
				// `T>`
				// `T>>`
				(
					(token == Token.Greater or token == Token.BitwiseRightShift) and (
						(
							lastToken == Token.Identifier or lastToken == Token.Title
						) and (
							tokens.column[i] == getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)
				) or

				token == Token.Comma or
				(
					token == Token.Colon and
					(
						// Preserve cause `a ? b : c` and `(name: value)`
						not (
							tokens.column[i] != getTokenLength(i - 1) + (tokens.column[i - 1] ?? 0)
						)
					)
				)
			{
				shouldSpace = false
			}

			lastLastGeneric = token == Token.Less and not shouldSpace

			if shouldSpace {
				result.push(' ')
			}

			switch token {
				case Comment: result.push(`/*` + tokens.value[i] + `*/`)
				case CommentLine:
					// TODO Doc comments parse separately in tokens
					result.push(((tokens.value[i].startsWith('/') ? '//': '// ') + tokens.value[i].trim()).trim())
				case LogicalAnd: result.push('and')
				case LogicalOr: result.push('or')
				case KNot:
					// TODO Separate exclamation mark
					if lastToken == Token.KAs {
						result.push('!')
					} else {
						result.push('not')
					}
				case QuotedString: switch tokens.meta[i] {
						// TODO FORMAT: should be here 1-tab less
						case SingleQuote: result.push(`'` + tokens.value[i] + `'`)
						case DoubleQuote: result.push(`"` + tokens.value[i] + `"`)
					}
				case _: result.push(Token.stringify(token, tokens.value[i], tokens.meta[i]))
			}

			// Ignore comments
			// TODO same value and meta same way into variables
			if token != Token.CommentLine {
				lastLastToken = lastToken
				lastToken = token
			}

			switch token {
				case BlockOpen:
					pushTab()
					if parenthesis > 0 {
						parenthesis++
					}
				case CallOpen:
					pushTab()
					parenthesis++
				case IndexOpen:
					pushTab()
					parenthesis++
				case Sharp:
					// `#if` `#else`
					if tokens.value[i + 1] == null {
						pushTab()
						parenthesis++
					}
				case KCase:
					appendTab()
				case KIf:
					// TODO appendTab()
					pushTab()
					parenthesis = 0
			}

			lastLine = line

			// TODO not typed if let value = tokens.value[i], value.assaDADADADncludes('\n') {
			if let value = tokens.value[i], value.includes('\n') {
				// TODO String.count('\n')
				lastLine += value.split('\n').length - 1
			}
		}

		// TODO (when) use CRLF? or it seems vscode fixes it on its own
		return result.join('') + '\n'
	} catch e: CompilerErrors {
		return file
	}

	return file
}
