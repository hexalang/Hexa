// TODO some C++
// TODO rename reserved keywords like `fun`
// TODO header-only mode to produce .hexa bindings
/// Actual code generator used by toHexa/Clang
class ClangGenerator {
	new (project ClangProject) {
		Lexer.init()

		for key in Reflect.ownKeys(project.typeReplace) {
			desugarQualType.set(key, project.typeReplace[key])
		}

		for keyType in Reflect.ownKeys(project.literalsMapping) {
			let ofType [String: [String: String]] = [:]
			literalsMapping.set(keyType, ofType)
			for keyField in Reflect.ownKeys(project.literalsMapping[keyType]) {
				let ofField [String: String] = [:]
				ofType.set(keyField, ofField)
				for keyValue in Reflect.ownKeys(project.literalsMapping[keyType][keyField]) {
					ofField.set(keyValue, project.literalsMapping[keyType][keyField][keyValue])
				}
			}
		}

		for file in project.files {
			if not file.generate {
				continue
			}

			let node ClangNode = JSON.parse(Fs.readFileSync(file.input).toString())
			console.log('Found ' + node.inner.length + ' root syntax nodes.')

			let result [Node] = node.inner.filter(root => root.kind != null).map(root => nodeToNode(root)).filter(node => node != null)

			// TODO Would be much better just be allowed to `node.stringify()` static call where `fun stringify(node /*infer*/ = this)` thus allowing non-vTable @struct methods too!
			let string = result.map(node => stringify(node)).join('\n\n')
			// Run autoformat over the result
			let good = autoFormatWholeFile(string)
			// TODO comment header
			Fs.writeFileSync(file.output, good)
		}
	}

	let literalsMapping [String: [String: [String: String]]] = [
		:
	]

	let desugarQualType [String: String] = [:]

	fun toCamelCase(text: String): String {
		if text.length == 1 {
			return text.toLowerCase()
		}

		// `XXXyyy` to `xxxyyy`
		let split = text.split('')
		var at = 0
		for char in split {
			let lower = char.toLowerCase()
			if lower != char {
				at++
			} else {
				break
			}
		}

		let final = text.substr(0, at).toLowerCase() + text.substr(at)

		return reserved.includes(final) ? final + 'Ref': final
	}

	fun toPascalCase(text: String): String {
		if text.length == 1 {
			return text.toUpperCase()
		}

		return text.substr(0, 1).toUpperCase() + text.substr(1)
	}

	fun typeAsType(of String) ClangType {
		return {
			qualType: of
		}
	}

	fun typeOfReturn(of ClangType) ClangType {
		return typeAsType(of.qualType.split('(') [0].trim())
	}

	static let primitive = [
		'Int8',
		'Int16',
		'Int32',
		'Int64',

		'UInt8',
		'UInt16',
		'UInt32',
		'UInt64',

		'Void'
		// TODO
	]

	static let reserved = [
		'class',
		'not',
		'and',
		'or',
		'null',
		'new',
		'interface',
		'type',
		'var',
		'let',
		'fun'
	]

	fun desugarKnownType(qualType String) String {
		let qualType = desugarQualType.get(qualType) ?? qualType
		let qualType = qualTypeToHexaType.get(qualType) ?? qualType
		return qualType
	}

	fun typeToNodeType(qualType String) NodeType {
		let qualType = desugarKnownType(qualType)

		// Function calling convention
		if qualType.endsWith(' __attribute__((stdcall))') {
			let clear = qualType.substr(0, qualType.length - ' __attribute__((stdcall))'.length).trim()

			let type = typeToNodeType(clear)
			typeDecorators.get(type).push(new Decorator('stdcall', []))
			return type
		}

		// Function pointer type
		if qualType.includes('(*)') {
			let parts = qualType.split('(*)')
			let returns = typeToNodeType(parts [0].trim())

			// Now remove ( )
			let clear = parts[1].substr(1, parts[1].length - 2).split(', ')
			// TODO Hexa: syntax like `let args = NodeType []`
			let args = clear.map(part => typeToNodeType(part))
			let result = NodeType.Function(args, returns)
			typeDecorators.set(result, [new Decorator('noCapture', [])])

			return result
		}

		if qualType.startsWith('const ') and qualType.endsWith(' *') {
			let clear = qualType.substring('const '.length, qualType.length - 1).trim()
			let clear = desugarKnownType(clear)

			if not primitive.includes(clear) {
				return NodeType.Type(toPascalCase(clear), null)
			}

			return NodeType.ParametricType('ConstArrayPointer', [typeToNodeType(clear)], null)
		}

		if qualType.startsWith('struct ') and qualType.endsWith(' *') {
			let clear = qualType.substring('struct '.length, qualType.length - 1).trim()
			let clear = desugarKnownType(clear)
			return NodeType.Type(toPascalCase(clear), null)
		}

		if qualType.endsWith(' *') {
			let clear = qualType.substring(0, qualType.length - 1).trim()
			let clear = desugarKnownType(clear)

			if not primitive.includes(clear) {
				return NodeType.Type(toPascalCase(clear), null)
			}

			return NodeType.ParametricType('ArrayPointer', [typeToNodeType(clear)], null)
		}

		if qualType.startsWith('const enum ') {
			let clear = qualType.substring('const enum '.length, qualType.length - 0).trim()
			return typeToNodeType(clear)
		}

		if qualType.startsWith('struct ') {
			let clear = qualType.substring('struct '.length, qualType.length - 0).trim()
			return NodeType.ParametricType('ByValue', [typeToNodeType(clear)], null)
		}

		return NodeType.Type(toPascalCase(qualType), null)
	}

	fun desugarType(of ClangType) String {
		let name = desugarQualType.get(of.qualType) ?? of.desugaredQualType ?? of.qualType

		if name.endsWith('const') {
			return name.substr(0, name.length - 'const'.length)
		}

		return name
	}

	fun typeToType(of ClangType) NodeType {
		return typeToNodeType(desugarType(of))
	}

	var previousRecordDecl ClangNode? = null
	let mapDecorators: [Node: [Decorator]] = [:]
	let typeDecorators: [NodeType: [Decorator]] = [:]

	fun wrapToBlockIfNone(node Node?) Node {
		switch node {
			case null: return Node.Block([])
			case Block: return node
		}

		return Node.Block([node])
	}

	fun unwrapParenthesis(node Node?) Node? {
		switch node {
			case null: return null
			case Parenthesis(node): return unwrapParenthesis(node)
		}

		return node
	}

	fun nodeToStatementNode(node ClangNode) Node? {
		switch node.kind {
			case ParenExpr:
				return Node.Block([nodeToNode(node.inner[0])])
		}
		return nodeToNode(node)
	}

	let zeroInitialize = [
		'Int',

		'UInt32',
		'Int32',
		'UInt32',
		'Int32',
		'UInt16',
		'UInt32',
		'UInt32',
		'UInt16',
		'UInt8',
		'Int8',
		'Int8'
	]

	fun zeroValue(varType NodeType) Node {
		let str = NodeType.stringify(varType)

		if str.startsWith('ByValue<') {
			return Node.Call(Node.NodeTypeValue(varType), [], [])
		}

		if not zeroInitialize.includes(str) {
			return Node.Null
		}

		return Node.Int(0)
	}

	fun getAssumedValueType(node ClangNode) String? {
		switch node.kind {
			// TODO bug `case ImplicitCastExpr: return getAssumedValueType` fun type accepted as String!
			case ImplicitCastExpr: return getAssumedValueType(node.inner[0])
			case MemberExpr: return getAssumedValueType(node.inner[0])
			case DeclRefExpr: return node.type.qualType
		}

		return null
	}

	fun getAssumedField(node ClangNode) String? {
		switch node.kind {
			case ImplicitCastExpr: return getAssumedField(node.inner[0])
			case MemberExpr: return node.name
		}

		return null
	}

	fun nodeToNode(node ClangNode) Node? {
		switch node.kind {
			// Roots
			case VarDecl: {
					let name = toCamelCase(node.name)
					// TODO let readonly = node.type!.qualType.endsWith('const')
					let readonly = node.type.qualType.endsWith('const')
					let varType = typeToType(node.type)
					var initializer Node? = null

					if let inner = node.inner, let value = inner[0] {
						initializer = nodeToNode(value)
					} else {
						initializer = zeroValue(varType)
					}

					return Node.Var(name, varType, initializer, readonly, false)
				}
			case RecordDecl:
				previousRecordDecl = node
				return null
			case TypedefDecl:
				if let decl = previousRecordDecl {
					previousRecordDecl = null

					let className = NodeType.Type(node.name, null)
					let extend NodeType? = null
					let implement [NodeType] = []
					let kind = ClassKind.Class
					let fields [Node] = []

					let result = Node.Class(className, extend, implement, fields, external: false, kind)

					for field in decl.inner {
						switch field.kind {
							case FieldDecl:
								fields.push(Node.Var(toCamelCase(field.name), typeToType(field.type), null /*TODO*/, false, false))
						}
					}

					if decl.tagUsed == 'struct' {
						mapDecorators.set(result, [new Decorator('struct', [])])
					}

					return result
				}
			case FunctionDecl: {
					let name = toCamelCase(node.name)
					let args [Node] = []
					var returnType NodeType = [] // TODO why [] is okay here
					var returnType NodeType = typeToType(typeOfReturn(node.type))
					var body Node? = null
					// TODO FORMAT
					let nodes = node.inner ??([] as! [ClangNode] /*TODO*/)

					for functionDecl in nodes {
						switch functionDecl.kind {
							case ParmVarDecl:
								args.push(Node.Var(toCamelCase(functionDecl.name), typeToType(functionDecl.type), null /*TODO*/, false, false))
						}
					}

					for functionDecl in nodes {
						switch functionDecl.kind {
							case CompoundStmt:
								body = nodeToNode(functionDecl)
								// TODO CompoundStmt happens once?
							case ParmVarDecl: // Ok
							case _: // TODO
						}
					}

					return Node.Function(name, body, args, returnType, false /*TODO*/, false /*TODO*/)
				}
			case CompoundStmt:
				let statements [ClangNode] = node.inner ?? []
				// TODO `.map(nodeToNode)` loses `this`, should .bind
				// return Node.Block(statements.map(nodeToNode).filter(s => s != null))
				let result [Node] = []

				// TODO add Node.InlineStatements([])
				for node in statements {
					switch node.kind {
						case LabelStmt:
							result.push(nodeToNode(node))
							result.push(nodeToNode(node.inner[0]))
						case _:
							result.push(nodeToStatementNode(node))
					}
				}

				// TODO .filterNonNull/.filterNulls -> makes [T?] into [T]
				return Node.Block(result.filter(s => s != null))
				// return Node.Block(statements.map(node => nodeToNode(node)).filter(s => s != null))
			case ConditionalOperator:
				// TODO int != 0
				return Node.If([nodeToNode(node.inner[0])], nodeToNode(node.inner[1]), nodeToNode(node.inner[2]), true)
			case IfStmt:
				let hasElse = node.hasElse
				var value = nodeToNode(node.inner[0])
				let body [Node] = []
				// var elseClause Node? = [] // TODO wtf
				var elseClause Node? = null

				var i = 1
				// TODO FORMAT `while(i`
				while i < node.inner.length - (hasElse ? 1: 0) {
					let ex = node.inner[i++]
					body.push(nodeToStatementNode(ex))
				}

				if hasElse {
					let ex = node.inner[node.inner.length - 1]
					elseClause = wrapToBlockIfNone(nodeToNode(ex))
				}

				let block = body.length > 1 ? Node.Block(body): switch body[0] {
					case Block(_): body[0]
					case _: Node.Block(body)
				}

				elseClause = switch elseClause {
					case Block(_): elseClause
					case null: null
					case _: Node.Block([elseClause])
				}

				value = switch value {
					case Parenthesis(v): v
					case _: value
				}

				return Node.If([value], block, elseClause, false)
			case DeclStmt:
				var results [Node] = []
				for decl in node.inner {
					switch decl.kind {
						case VarDecl:
							// TODO isUsed
							let name = toCamelCase(decl.name)
							let varType = typeToType(decl.type)
							var initializer Node? = null

							if let inner = decl.inner, let value = inner[0] {
								initializer = unwrapParenthesis(nodeToNode(value))
							} else {
								initializer = zeroValue(varType)
							}

							results.push(Node.Var(name, varType, initializer, false, false))
					}
				}
				return Node.InlineStatements(results)
			case FieldDecl:
				// TODO
			case BinaryOperator:
				// TODO better idea
				let op = Lexer.tokenize(Buffer.from(node.opcode), "CLANG").token[0] as! Token
				// TODO if (s.opcode == '&&') s.opcode = 'and'
				// TODO if (s.opcode == '||') s.opcode = 'or'
				let left = nodeToNode(node.inner[0])
				var right = nodeToNode(node.inner[1])

				if op == Token.Equal or op == Token.Assign {
					// Restore constants into literals
					// TODO same for `(argHere)` calls
					// TODO same for `case here:` switches

					{
						// TODO cover with tests
						// [123] = [123]
					}

					if
						let ofType = getAssumedValueType(node.inner[0]),
						let ofField = getAssumedField(node.inner[0]),
						let ofReplacedType = literalsMapping.get(ofType),
						let ofReplacedField = ofReplacedType.get(ofField),
						let ofReplacedValue = ofReplacedField.get(Node.stringify(right))
					{
						if ofReplacedValue.includes('.') {
							// Assume enum
							let parts = ofReplacedValue.split('.')
							right = Node.DotUpper(
								Node.NodeTypeValue(NodeType.Type(parts [0], null)),
								parts[1]
							)
						}
					}
				}

				return Node.Binop(left, op, right)
			case CompoundAssignOperator:
				var op = Lexer.tokenize(Buffer.from(node.opcode), "CLANG").token[0] as! Token
				return Node.AssignOp(nodeToNode(node.inner[0]), op, nodeToNode(node.inner[1]))
			case IntegerLiteral:
				// TODO type
				return Node.Int(parseInt(node.value))
			case WhileStmt:
				return Node.While(nodeToNode(node.inner[0]), wrapToBlockIfNone(nodeToNode(node.inner[1])), false)
			case DoStmt:
				let condition = nodeToNode(node.inner[1])

				switch condition {
					case Int(value): if value == 0 {
						return Node.Block([])
					}
				}

				return Node.While(condition, wrapToBlockIfNone(nodeToNode(node.inner[0])), true)
				// TODO bug `= return` no error
				// let condition =
				// return Node.While(nodeToNode(node.inner[1]), wrapToBlockIfNone(nodeToNode(node.inner[0])), true)
			case ForStmt:
				if node.inner[0].kind == null {
					let block = [nodeToNode(node.inner[4])]

					if let counting = node.inner[3], counting.kind != null {
						block.push(nodeToNode(counting))
					}

					return Node.While(Node.Bool(true), Node.Block(block), false)
				}

				// TODO inner[1]
				if
					let counting = node.inner[3], counting.kind != null,
					let body = node.inner[4], body.kind != null,
					let counter = node.inner[0], counter.kind != null,
					let condition = node.inner[2], condition.kind != null
				{
					return Node.InlineStatements([
							nodeToNode(counter),
							Node.While(nodeToNode(condition), Node.Block([nodeToNode(body), nodeToNode(counting)]), false)
						])
				}
			case SwitchStmt:
				var lastWasCase = false
				let inputs [Node] = [unwrapParenthesis(nodeToNode(node.inner[0]))]
				let expressions [Node] = []
				let guards [Node] = [] // Always empty
				let patterns [Node] = []
				var currentBlock [Node] = []
				var i = -1

				for inner in node.inner[1].inner {
					switch inner.kind {
						case CaseStmt | DefaultStmt:
							i++
							currentBlock = []
							patterns[i] = Node.InlineStatements(currentBlock)
							var expression = Node.Underscore

							// TODO short syntax `.CaseStmt` absolutely needed for sure
							if inner.kind == ClangKind.CaseStmt {
								expression = nodeToNode(inner.inner.shift())
							}

							fun nestedCases(inner ClangNode) {
								for node in inner.inner {
									switch node.kind {
										case CaseStmt:
											expression = Node.Binop(expression, Token.BitwiseOr, nodeToNode(node.inner.shift()))
											nestedCases(node)
										case _:
											currentBlock.push(nodeToNode(node))
									}
								}
							}

							nestedCases(inner)
							expressions[i] = expression
						case BreakStmt:
						case _:
							// TODO early-break on BreakStmt or something
							currentBlock.push(nodeToNode(inner))
					}

				}

				// TODO `case a:` right after `case b:` should become `case a or b:`
				return Node.Switch(inputs, expressions, guards, patterns)
			case CaseStmt: // Never happens
			case DefaultStmt: // Never happens
			case BreakStmt:
				return Node.Break
			case GCCAsmStmt:
			case NullStmt:
				return Node.Block([])
			case ContinueStmt:
				return Node.Continue
			case UnaryOperator:
				// TODO "isPostfix": false
				// TODO no need for & for @struct
				// TODO detect !=0 and !=null and !!
				let expr = nodeToNode(node.inner[0])
				switch node.opcode {
					case '~': return Node.Unop(Token.BitwiseNot, postfix: false, expr)
					case '-': return Node.Unop(Token.Subtract, postfix: false, expr)
					case '++': return Node.Unop(Token.Increment, postfix: true, expr)
					case '--': return Node.Unop(Token.Decrement, postfix: true, expr)
					case '*': return Node.Index(expr, Node.Int(0))
					case '!': return Node.Unop(Token.KNot, postfix: false, expr)
					case '&': return expr
				}
			case ReturnStmt:
				if let inner = node.inner, let value = inner[0] {
					return Node.Return(unwrapParenthesis(nodeToNode(value)))
				}
				return Node.Return(null)
			case CallExpr:
				// TODO Hexa: for () @isFirst {} also case CallExpr [value, ...arguments]
				// result.push(tabs + resolve(CompoundStmt.inner.shift()) + '(' + (CompoundStmt.inner.map(resolve).join(', ')) + ')\n')
				let value = node.inner.shift()
				return Node.Call(nodeToNode(value), node.inner.map(node => unwrapParenthesis(nodeToNode(node))), [])
			case ArraySubscriptExpr:
				return Node.Index(nodeToNode(node.inner[0]), nodeToNode(node.inner[1]))
			case UnaryExprOrTypeTraitExpr:
				switch node.name {
					case 'sizeof':
						return Node.Call(Node.Ident('sizeOf', [
									typeToType(node.type)
								]), [], [])
						// TODO FORMAT could "cut" a tab from already printed line
				}
			case CharacterLiteral:
				// TODO meta
				// const value = s.value as unknown as number // TODO
				// const char = JSON.stringify(String.fromCharCode(value))
				// return s.value + '/* ' + char + ' */'
				return Node.Int(parseInt(node.value))
			case OffsetOfExpr:
			case AtomicExpr:
			case VAArgExpr:
			case InitListExpr:
				// TODO cast
				// TODO arr = @byValue []
				return Node.Array(node.inner.map(node => nodeToNode(node)))
			case CompoundLiteralExpr:
				// TODO cast
				return nodeToNode(node.inner[0])
			case ImplicitCastExpr:
				// TODO cast
				return nodeToNode(node.inner[0])
			case StringLiteral:
				// TODO "castKind": "ArrayToPointerDecay"
				if node.value.startsWith('L"') {
					return Node.String(node.value.substr(2, node.value.length - 3))
				}
				return Node.String(node.value.substr(1, node.value.length - 2))
			case ConstantExpr:
				// TODO cast
				return nodeToNode(node.inner[0])
			case CStyleCastExpr:
				// TODO "castKind": "BitCast"
				return Node.Parenthesis(Node.As(nodeToNode(node.inner[0]), Token.KNot, typeToType(node.type)))
			case DeclRefExpr:
				if let referencedDecl = node.referencedDecl {
					return Node.Ident(toCamelCase(referencedDecl.name), null)
				}
			case ParenExpr:
				return Node.Parenthesis(nodeToNode(node.inner[0]))
			case FloatingLiteral:
				// TODO type
				return Node.Float(parseFloat(node.value), Meta.Default)
			case MemberExpr:
				// TODO `let { name } = node`
				let name = toCamelCase(node.name)
				if name == "" {
					return nodeToNode(node.inner[0])
				}

				if let referencedDecl = node.inner[0].referencedDecl {
					// TODO return Node.Dot(referencedDecl.name, name)
				}

				return Node.Dot(nodeToNode(node.inner[0]), name)
			case ParmVarDecl:
				// TODO
			case TextComment:
				// TODO
			case ParagraphComment:
				// TODO
			case BlockCommandComment:
				// TODO
			case ParamCommandComment:
				// TODO
			case FullComment:
				// TODO
			case BuiltinType:
				// TODO
			case SEHExceptStmt:
				// TODO
			case SEHTryStmt:
				// TODO
			case EnumDecl:
				// TODO
			case EmptyDecl:
				return null // Extra `;` like `hello;;`
			case GotoStmt:
				// TODO undefined
				// const namedAs = labels.get(CompoundStmt.targetLabelDeclId)
				return Node.String("@goto " + node.targetLabelDeclId)
			case LabelStmt:
				// TODO convert to defer when possible?
				return Node.String("@label " + node.name + " " + node.declId)
			case PredefinedExpr:
				return Node.Dot(Node.Ident('meta', null), node.name)
			case null:
				return null // Never happens
		}

		return Node.String("// Unknown Clang node kind: " + node.kind)
	}

	fun stringify(node Node?) String {
		// TODO bug: mapDecorators was available from `static fun` and crashed
		if let decs = mapDecorators.get(node) {
			// TODO @(params)
			return decs.map(dec => '@' + dec.name).join('\n') + '\n' + stringifyWithoutDecorators(node)
		}

		return stringifyWithoutDecorators(node)
	}

	fun stringifyType(nodeType NodeType) String {
		var result = NodeType.stringify(nodeType)

		if let decorators = typeDecorators.get(nodeType) {
			result = decorators.map(dec => '@' + dec.name + ' ').join('') + result
		}

		return result
	}

	fun stringifyWithoutDecorators(node Node?) String {
		switch node {
			case Bool(b): return b? "true" : "false"
			case String(s): return JSON.stringify(s)
			case Ident(name, params):
				// TODO generate in parser `if let x {}` form bruh
				if let params = params {
					return name + '<' + params.map(t => stringifyType(t)) + '>'
				}
				return name
			case Int(s):
				if s > 2147483647 {
					return s.toString() + 'u32'
				}
				return s.toString()
			case Float(s): return s.toString()
			case As(expr, kind, toType):
				return stringify(expr) + ` as` + Token.stringify(kind) + ` ` + stringifyType(toType)
			case Null: return "null"
			case This: return "this"
			case Continue: return "continue"
			case Break: return "break"
			case Underscore: return "_"
			case Unop(op, postfix, e):
				if postfix {
					return stringify(e) + Token.stringify(op)
				}
				return Token.stringify(op) + stringify(e)
			case Parenthesis(expr):
				switch expr {
					case Parenthesis(expr): return "(" + stringify(expr) + ")"
				}

				return "(" + stringify(expr) + ")"
			case Index(expr, index): return stringify(expr) + '[' + stringify(index) + ']'
			case Dot(expr, name): return stringify(expr) + '.' + name
			case DotUpper(expr, name): return stringify(expr) + '.' + name
			case While(reason, e, pre):
				if pre {
					return 'do ' + stringify(e) + ' while ' + stringify(reason)
				} else {
					return 'while ' + stringify(reason) + ' ' + stringify(e)
				}
			case InlineStatements(e):
				return e.map(el => stringify(el)).join('\n\t')
			case Block(e):
				if e.length == 1 {
					switch e[0] {
						case Block(_): return stringify(e [0])
					}
				}

				// TODO `case`-body still contains empty blocks
				fun noEmptyBlocks(expr Node) Bool {
					switch expr {
						case Block(e) if e.length == 0: return false
					}

					return true
				}

				var prev = ''
				return '{\n\t' + e.filter(noEmptyBlocks).map(fun (expr Node, index Int) {
						var extra = ''
						switch expr {
							case If(_): if index > 0 { extra = '\n\t' }
							case While(_): if index > 0 { extra = '\n\t' }
								// TODO case _ if prev.endsWith('}'): extra = '\n\t'
							case _: if prev.endsWith('}') { extra = '\n\t' }
						}

						prev = stringify(expr)
						return extra + prev
					}
				).join('\n\t') + '\n}'
			case Call(e, args, argNames):
				let arg = []
				for i in args {
					switch i {
						case Parenthesis(expr): arg.push(stringify(expr))
						case _: arg.push(stringify(i))
					}
				}
				return stringify(e) + '(' + arg.join(', ') + ')'
			case Array(elements): return '[' + [for el in elements stringify(el)].join(', ') + ']'
			case Binop(a, op, b):
				let right = switch b {
					case Parenthesis(expr): if op == Token.Assign {
							stringify(expr)
						} else {
							stringify(b)
						}
					case _: stringify(b)
				}
				return stringify(a) + ' ' + Token.stringify(op) + ' ' + right
			case AssignOp(a, op, b): return stringify(a) + ' ' + Token.stringify(op) + '= ' + stringify(b)
			case Object(names, el):
				return '{' + [for i in el.length names[i] + ': ' + stringify(el[i])].join(', ') + '}'
			case NodeTypeValue(t):
				return NodeType.stringify(t)
			case Static(f): return 'static ' + stringify(f)
			case Var(name, t, expr, const, external): {
					var body = ''
					if let expr = expr {
						body = ' = ' + stringify(expr)
					}
					return
					(external ? 'declare ': '') +
					(const ? 'let ': 'var ') + name + ' ' + stringifyType(t) + body
				}
			case If(value, body, elseClause, infix):
				if infix {
					return `( ` + stringify(value [0]) + ' ) ? ' + stringify(body) + ' : ' + stringify(elseClause)
				}
				// TODO FORMAT
				return `if ` + stringify(value [0]) + stringify(body) + (elseClause != null ? ' else ': '') + stringify(elseClause)
			case Switch(inputs, expressions, guards, patterns):
				var body = ''
				for i in expressions.length {
					body += '\n\tcase ' + stringify(expressions [i]) + ':\n\t'
					body += stringify(patterns [i])
				}

				return `switch ` + stringify(inputs [0]) + ' {' + body + '\n}'
			case Function(name, body, vars, returnType, external, variadic):
				if name == null {
					// TODO `// Anonymous`
					return `fun`
				}

				let separator = vars.length > 3 ? ',\n\t': ', '
				let begin = vars.length > 3 ? '(\n\t': '('
				let end = vars.length > 3 ? '\n) ': ') '

				return 'fun ' + name + begin + vars.map(v => switch v {
						case Var(name, t, expr, const, external):
							name + ' ' + stringifyType(t)
					}).join(separator) + end + stringifyType(returnType) + ' ' + stringify(body)
			case Return(value):
				return 'return ' + stringify(value)
			case Class(className, extend, implement, fields, external, kind):
				return 'class ' + NodeType.stringify(className) + '{\n\t' + fields.map(f => stringify(f)).join('\n\t') + '\n}'
			case null:
				return ''
			case _:
				// TODO exhaustive
				console.error('Cannot stringify', node)
				return "..."
		}
	}
}
