		r += 'const struct AnyFloat_vt AnyFloat_vt$ = ' + lb + ' ' + lb + 'nullptr, &AnyFloat_hiddenToBool_, &Hexa_GenericToString_, &AnyFloat_hiddenClassName_, &AnyFloat_hiddenDynGet_, &AnyFloat_hiddenDynSet_, &AnyFloat_hiddenHas_, &AnyFloat_hiddenDelete_, &AnyFloat_hiddenKeyAt_, &AnyFloat_hiddenKeyCount_, &AnyFloat_hiddenIndexGet_, &AnyFloat_hiddenIndexSet_, &AnyFloat_hiddenIndexCount_, &AnyFloat_hiddenReflect_' + rb + ', ' + lb + '&Hexa_QI_, &Hexa_AddRef_, &Hexa_Release_' + rb + ' ' + rb + ';' + nl
