/// Generates C with C++ compatibility
/// Some features require C11
// TODO extends Generator .features(): GeneratorFeatures
class GenCxx {
	static fun spawn() {
		return new GenCxx()
	}

	static fun spawnCpp() {
		let result = new GenCxx()
		result.cpp = true
		return result
	}

	new () {
		// Fields are initialized at declarations
	}

	// TODO !!! to speed up C++ compile do `typedef hexa<SomeType> $SomeType;`

	// TODO no name no error: fun (){}
	// TODO no body no error: fun x()
	// fun()

	fun perform(normalizer, target: String, options: [String]): String {
		project = normalizer
		extraUnderscore = options.includes('extraUnderscore')
		// TODO report unsupported options
		return stringify(target)
	}

	/// On x64 it is always fast call,
	/// but on Win32 i686 we should use std call
	var defaultCallingConvention = '__conventionName '
	/// C++ generator
	var cpp Bool = false
	/// Quick access
	var memory64 = true
	let nativeIterators = false
	let globalAccessor = '' // TODO no name no error: fun x()
	var project: NiceProject
	var declarationsOfFunctions: [String] = []
	var declarationsOfOpaqueTypes: [String] = []
	var declarationsOfFullTypes: [String] = []
	/// Mapping of original strings (optimization)
	var declarationsOfStringsMap: [String : Int] = [:]
	var declarationsOfStrings: [String] = []
	// F10: inline STRUCT <-> Any bridges — registered on demand by
	// `anyToStructStr`, emitted once by `printAnyToStruct` (bag -> fields).
	// DIRECTION MAP (#6 — read this before touching either side):
	// - struct→bag (VALUE LOSES static shape): `printToAnyConverter` Struct arm
	// + `printAnyObjectLit`, now owned in Nice by `reflectPost`
	// (`tryLowerStructValue`: Var/Const/Assign/Return/call-arg/If `Any`
	// positions → explicit `Any_objectNew_` + `Any_objectSet_` builds).
	// - Any→struct (DYNAMIC REGAINS static shape): below — a runtime `Any`
	// payload (bag, legacy pointer, null) reconstructs a typed inline
	// struct through the generated `Any_toStruct_Struct_N_*` helpers.
	// Still genC-owned (no Nice lowering yet). FUTURE (Nice classes for Any
	// stuff): represent `Any`/bags as Nice classes so BOTH directions lower
	// in `reflectPost` (bag reads become field reads, helpers disappear).
	var anyToStructNames: [String : [String]] = [:]
	var anyToStructTypes: [String : [Type]] = [:]
	/// Function-type signature -> typedef name (`_$N`) so repeated
	/// `stringifyType` calls return STABLE names (mangled generic names like
	/// `Array<_$N>` depend on it) and identical types emit one typedef
	var typedefFunctionsMap: [String : String] = [:]
	/// Inline-structure signature -> minted `Struct_N_*` name (see
	/// `stringifyType` `Struct` case)
	var structDefsMap: [String : String] = [:]
	/// Minted inline-structure BODIES (`struct Struct_N_ { ... };` — must be
	/// emitted as one block BEFORE the Types section: minting happens lazily
	/// during `stringifyType`, so pushing bodies into `types` interleaves them
	/// INTO the class currently being printed (nested `Outer_::Struct_N_`,
	/// C2027 at use sites). Forwards live in `structDefsForward`
	let structDefs: [String] = []
	/// Declared type per GLOBAL base name — the Nice type of a USE node can
	/// lie about the C value (the typer coerces `Any` uses to `Int` etc), so
	/// operand classification and conversions key on the DECLARED type of
	/// what is actually printed (see `cShape`/`valueType`)
	var globalDecls: [String : Type] = [:]
	/// F9: mangled `Promise_X_` struct names seen via `stringifyType`
	/// (deduped) — after Types, emit per-`X` `operator co_await` + `promise_type`
	/// + `coroutine_traits` in one inner `extern "C++"` block (needs complete
	/// structs for `sizeof`, and must precede async funs using them).
	/// REDESIGN NOTE (#7, as-is for now): the whole `co_await`/`co_return` /
	/// `promise_type` machinery is C++ coroutines. The planned redesign drops
	/// C++ coroutines entirely (explicit state machines / frame-pump resumes
	/// in lowering instead) — until then this block stays untouched.
	var promiseStructs: [String] = []
	/// F10.3: Nice names (`closure$N`) of lifted closures whose `$call_`
	/// thunks were emitted (dead code until dynamic calls wire them) — after
	/// Types, emit the `{impl, call}` registry the pair dispatch looks up.
	var fatPairImpls: [String] = []
	// F10.3: bare GLOBAL functions boxed into `Any` (see `anyBox`) — name
	// (mangled, no trailing `_`) + signature, so `printFatPairs` can emit a
	// no-env thunk for each. Filled lazily while the bodies print, exactly
	// like `fatPairImpls`.
	var fatPairGlobalNames: [String] = []
	var fatPairGlobalTypes: [Type] = []
	/// F10.4: instance METHODS boxed as callable `Any` values — a dynamic
	/// read of a method name (`anyString.split`, `anyArray.forEach`) returns
	/// the boxed `{impl, self}` pair the F10.3 dispatch already understands.
	/// Filled while the per-class hidden `dyn_get` bodies print; the thunk
	/// bodies (env-first, so the receiver rides in `env_`) are emitted next
	/// to the global ones, and the impl names join `fatPairImpls` so the
	/// registry lookup finds them.
	var fatPairMethodNames: [String] = []
	var fatPairMethodTypes: [Type] = []
	/// F10.4: C receiver type per boxed method (`Name_`), so the thunk casts
	/// the `void* env_` back to the typed `$this` slot.
	var fatPairMethodSelf: [String] = []
	/// Declared type per LOCAL/param base name of the function being printed
	/// (cleared at each function signature — see `printFunctionArguments`)
	var localDecls: [String : Type] = [:]
	/// C-void callees (Nice claims non-void like `Promise`/`Any` while the
	/// emitted C returns `void` — `async fun` without `return`). Pre-scanned
	/// from declared returns; `valueType(Call)` reports these as `Void` so
	/// the existing `Void → T` comma-sequence bridge fires in every value
	/// context (Var/Assign/Return/args) with no Call-site duplication.
	var voidFuncs: [String : Bool] = [:]
	var voidFuncsBuilt Bool = false
	/// True when the declared C return is `void`
	fun isVoidReturnType(funcType: Type): Bool { switch funcType {
			case Function(_, returns):
				return stringifyType(returns) == 'void'
			case _:
				return false
		} }

	/// F10.4: the F10.3 thunk ABI can unbox pointers, plain scalars and `Any`
	/// out of `argv_` — anything else (a foreign `@rename`d pointer typedef
	/// such as `HANDLE`, a bitfield) has no argv form, so such a method stays
	/// unboxed and a dynamic read keeps returning null exactly as before.
	fun isThunkSafeType(t: Type): Bool {
		switch t {
			case Nullable(inner):
				return isThunkSafeType(inner)
			case Function(_, _):
				// Fat callback param: the thunk unpacks the boxed pair.
				return true
			case _:
		}
		let s = stringifyType(t)

		if s == 'void' {
			return true
		}

		if s.endsWith('*') {
			return true
		}

		if s == 'int32_t' or s == 'int64_t' or s == 'uint32_t' or s == 'uint64_t' {
			return true
		}

		if s == 'int16_t' or s == 'int8_t' or s == 'uint16_t' or s == 'uint8_t' {
			return true
		}

		if s == 'double' or s == 'float' or s == 'Bool_' {
			return true
		}

		return false
	}

	/// F10.4: can this instance method be boxed as a callable `Any` value?
	/// Constructors (`new`) have no `self` slot to ride in `env_`; `async`
	/// methods return a coroutine promise the thunk ABI cannot carry; and a
	/// signature with a non-argv-mappable type would not compile. Everything
	/// else is a normal env-first fat value, so the existing F10.3 thunk
	/// dispatcher handles it.
	fun isBoxableMethod(mname: String?, funcType: Type, isAsync: Bool): Bool {
		if mname == null {
			return false
		}

		if mname == 'new' {
			return false
		}

		if isAsync {
			return false
		}

		switch funcType {
			case Function(args, returns):
				// A fat (function-typed) return uses the out-param ABI the
				// thunk does not model — leave those unboxed.
				if isFatValueType(returns) {
					return false
				}
				// The receiver is not part of `funcType` — the C signature
				// prepends it (see `skipFirst`), so any arity binds.
				for a in args {
					if not isThunkSafeType(a.dataType) {
						return false
					}
				}
				return isThunkSafeType(returns)
			case _:
				return false
		}
	}
	/// Fill `voidFuncs` once per emit (globals + methods, bare + qualified)
	fun buildVoidFuncs() {
		if voidFuncsBuilt {
			return
		}
		voidFuncsBuilt = true
		for g in project.globalFuncs { switch g {
				case Function(gname, _, _, _, funcType, _, _):
					if isVoidReturnType(funcType) {
						voidFuncs.set(gname, true)
					}
				case _:
			} }

		for c in project.classes {
			// Templates emit no C functions (only their instances do) and
			// their returns are still unresolved generics — `stringifyType`
			// cannot classify those, so a template's method never
			// contributes to `voidFuncs`.
			if c.template {
				continue
			}

			for m in c.methods { switch m {
					case Function(mname, _, _, _, funcType, _, _):
						if isVoidReturnType(funcType) {
							voidFuncs.set(mname, true)
							voidFuncs.set(c.name + '_$' + mname, true)
						}
					case _:
				} }

			for m in c.staticMethods { switch m {
					case Function(mname, _, _, _, funcType, _, _):
						if isVoidReturnType(funcType) {
							voidFuncs.set(mname, true)
							voidFuncs.set(c.name + '_$' + mname, true)
						}
					case _:
				} }
		}

		// Pass 2 — BARE method names. `isVoidCallee` only sees `Dot(_, name)`
		// (the receiver's static class is not resolved there), so a bare entry
		// is consulted for EVERY `x.name(...)`. Recording one unconditionally
		// let a single void method poison same-named value-returning ones:
		// `Array.pop` (generic `T?`) came out `void`, so every `.pop()` call
		// site discarded its result through the `Void → T` comma bridge and
		// Perfide's icon scan read a null extension for every PNG (0 icons).
		// Only names that are void in EVERY declaring class stay bare.
		var nonVoidNames: [String : Bool] = [:]

		for c in project.classes {
			if c.template {
				continue
			}

			for m in c.methods { switch m {
					case Function(mname, _, _, _, funcType, _, _):
						if not isVoidReturnType(funcType) {
							nonVoidNames.set(mname, true)
						}
					case _:
				} }

			for m in c.staticMethods { switch m {
					case Function(mname, _, _, _, funcType, _, _):
						if not isVoidReturnType(funcType) {
							nonVoidNames.set(mname, true)
						}
					case _:
				} }
		}

		for c in project.classes {
			if c.template {
				continue
			}

			for m in c.methods { switch m {
					case Function(mname, _, _, _, funcType, _, _):
						if isVoidReturnType(funcType), nonVoidNames.get(mname) == null {
							voidFuncs.set(mname, true)
						}
					case _:
				} }

			for m in c.staticMethods { switch m {
					case Function(mname, _, _, _, funcType, _, _):
						if isVoidReturnType(funcType), nonVoidNames.get(mname) == null {
							voidFuncs.set(mname, true)
						}
					case _:
				} }
		}
	}
	/// True when the callee emits C `void` (declared return, not Nice result)
	fun isVoidCallee(e: Expression): Bool { switch e {
			case Ident(name, _):
				return voidFuncs.get(name) == true
			case Dot(_, name, _):
				return voidFuncs.get(name) == true
			case Parenthesis(inner):
				return isVoidCallee(inner)
			case _:
				return false
		} }
	/// Forward declarations for the minted inline structures (`forward` is
	/// local to `stringify` and flushes these before assembly)
	let structDefsForward: [String] = []
	let forwardFunctions: [String] = []
	let typedefFunctions: [String] = []
	let globalVariables: [String] = []
	let globalFunctions: [String] = []
	// ARC destroy registry rows (tag + destroy fn + size), one per class
	// declaring `@destructor`. Read by the future F11 sweep via the lookup
	// below; backends never consult it today.
	let destroyTable: [String] = []
	// Vtable-managed class names (every class that actually emits a `__$`
	// tag global), for the sweep victim-name table. Collected at vtable
	// emission so the table can only reference symbols that exist.
	let vtableClasses: [String] = []
	// Vtable-managed container class names (classes whose `@destructor`
	// releases owned storage — Array/Map slots, String bytes) for the
	// sweep bisect: `hexaArrayTags_` lets `HEXA_SWEEP_MODE=2` skip exactly
	// the storage-release cascade while freeing everything else.
	let arrayDestroyTags: [String] = []
	// D2: `ArrayByValue<T?, N>` globals whose BSS zero-fill is not `null` —
	// each entry is one `hexaFillNone_` statement for the boot prologue.
	let noneSlotInitLines: [String] = []
	let types: [String] = []
	let dllExports: [String] = []
	// TODO Docs
	/// Sets `__link` prefix for `_link` names
	/// Workaround for LLVM 32-bit linker
	var extraUnderscore = false

	fun stringify(target: String) {
		// Configure
		if project.memory == Memory.Modern64 {
			// No space
			defaultCallingConvention = ''
		} else {
			// With space
			// TODO probably should be only on Win32 platform
			// Note this is used for all of Win32 API and COM interfaces anyway
			// thus we default to this calling convention
			defaultCallingConvention = '__stdcall '
			memory64 = false
		}

		// Contains forward declarations
		let header = ['// Generated by Hexa \(version) https://hexalang.github.io']

		if project.package.addLicenseNoticeToOutput {
			// rename `addLicenseNoticeToOutput` TODO what this comment means?
			header.push('// Project: \(project.package.name)')
			header.push('// LICENSE \(project.package.license)')
		} else {
			header.push('// The generated code is subject to the original license')
		}

		header.push(Fs.readFileSync(__dirname + '/library/cxx/hexa.c').toString('utf8').split('\r\n').join('\n'))
		header.push('#ifdef __cplusplus')
		header.push('extern "C" \{')
		header.push('#endif')
		// virtual abstract $unref();
		// virtual abstract $ref();

		// TODO copy hexa.cpp to output folder if not exists (updates??)
		// create hexa.cpp in library/cpp ^
		// ^ just copy into output file
		// header.push('#include "hexa.cpp"')

		let out: [String] = []
		// out.push(header.join('\n'))
		// TODO how to parse without double dots? String[] like dlang/ts V[K]
		let forward: [String] = []

		// Strings
		registerString('') // id == 0
		declarationsOfStringsMap.set('', 0)
		registerString('null') // id == 1
		declarationsOfStringsMap.set('null', 1)

		// Register declared types of globals upfront — expression printing
		// (class methods etc.) may reference them before the GlobalVariables
		// section is assembled, and `cShape` needs the DECLARED C shape
		for g in project.globalVars {
			switch g {
				case Var(name, expr, dataType):
					globalDecls.set(name, dataType)
				case Const(name, expr, dataType):
					globalDecls.set(name, dataType)
			}
		}

		// D2 sentinel env for null-fat values (see Global variables section).
		// Typed `Any` so pair assembly bridges via `(size_t)` (void* value).
		globalDecls.set('hexaSentinelEnv', project.typer.typeAny)
		// Emit-time class renames FIRST (see `renameClassNamesEmit`): every
		// name-keyed lookup done while printing must see the EMITTED names,
		// not the pre-rename Nice ones.
		renameClassNamesEmit()
		buildVoidFuncs()
		forward.push(printReflectABI())
		forward.push(printNullSentinel())

		// Types
		// TODO use _HEX16GUID_ClassName_ instead of _mangledNameSpace_ClassName_!
		// ^ and save this String to class definition for cache in normalizer
		// cause JS will use it too for now
		for e in project.enumsSimple {
			// No need to output simple enum values
			// TODO proper base type
			forward.push('struct ' + e.name + '_;')

			if e.staticVars.length + e.staticMethods.length == 0 {
				continue
			}

			// TODO tdef C* C
			// TODO this seem to be a leftover from C++
			types.push('struct ' + e.name + '_ \{\n\t')

			// Static vars before static functions
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + e.name + '_$' + name + '_;\n')
						// if (expr != null) out.push(' = ' + printExpression(expr))
					case Const(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + e.name + '_$' + name + '_;\n')
						// out.push(' = ' + printExpression(expr))
				} }

				// for (v in e.staticMethods) switch v {
				// case Function(name, expr, args, defaults, funcType):
				// types.push('\n\tstatic ')
				// types.push(printFunctionReturnType(funcType))
				// types.push(' ' + name + '_')
				// types.push(printFunctionArguments(args, funcType, true))
				// types.push(';')
				// }
			types.push('\n\};\n')

			for v in e.staticMethods { switch v {
					case Function(name, expr, args, defaults, funcType, variadic, isAsync):
						forwardFunctions.push(linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
						forwardFunctions.push(' ' + e.name + '_$' + name + '_')
						forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
						forwardFunctions.push(';\n')

						// TODO cache `printFunctionReturnType` here etc to not print twice
						out.push(linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
						out.push(' ' + e.name + '_$' + name + '_')
						out.push(printFunctionArguments(args, funcType, variadic))
						let _currentReturnType = currentReturnType
						currentReturnType = getFunctionReturnType(funcType)
						let _insideAsyncFunction = insideAsyncFunction
						insideAsyncFunction = isAsync
						out.push(' ' + (isAsync? printFunctionBody(expr, printFunctionReturnType(funcType)) : printBlock(expr)) + ';\n\n')
						insideAsyncFunction = _insideAsyncFunction
						// out.push(' {};\n')
						currentReturnType = _currentReturnType
				} }
		}

		for e in project.enumsComplex {
			forward.push('struct ' + e.name + '_;')
			types.push(e.name + '_ : Unknown_ \{\n\t')
			types.push('\n\tAny_** enum_;') // Enum.Name(enum_...)
			types.push('\n\tuint16_t is_;')
			types.push('\n\tuint8_t length_;') // Amount of enum_[] to dealloc

			var i = 0

			for name in e.names {
				if e.constructors[i] != null {
					// types.push('\n\tstatic ' + e.name + '_* ' + name + '_(')
					////types.push([for (c in e.constructors[i]) 'Any_* ' + c + '_'].join(', '))
					// types.push([for (c in e.constructors[i].length)
					// stringifyType(e.constructorsTypes[i][c]) + ' ' + e.constructors[i][c] + '_'
					// ].join(', '))
					// types.push(');')

					out.push(e.name + '_* ' + e.name + '_$' + name + '_(')
					// out.push([for (c in e.constructors[i]) 'Any_* ' + c + '_'].join(', '))
					out.push([for c in e.constructors[i].length
							stringifyType(e.constructorsTypes[i][c]) + ' ' + e.constructors[i][c] + '_'
						].join(', '))
					out.push(') \{\n')
					// out.push('\tprintf("\(e.name).\(name)_()\\n");fflush(stdout);\n')
					out.push('\t' + e.name + '_* _ = (' + e.name + '_*)(HEXA_NEW(sizeof(' + e.name + '_)));\n')
					out.push('\t_->length_ = \(e.constructors[i].length);\n')
					out.push('\t_->enum_ = (Any_**)(HEXA_NEW(sizeof(Any_*) * \(e.constructors[i].length)));\n')
					out.push('\t_->is_ = \(i);\n')

					for c in e.constructors[i].length {
						// out.push('\t_->enum_[\(c)] = \(e.constructors[i][c])_;\n')
						out.push('\t_->enum_[\(c)] = ')
						// out.push(printTypeConverter(e.constructors[i][c] + '_', e.constructorsTypes[i][c], project.typer.typeAny))
						out.push(printToAnyConverter(e.constructors[i][c] + '_', e.constructorsTypes[i][c]))
						out.push(';\n')
					}
					out.push('\treturn _;\n')
					out.push('\};\n')
				} else {
					// types.push('\n\tstatic ' + e.name + '_* ' + name + '_();')

					out.push(e.name + '_* ' + e.name + '_$' + name + '_() \{\n')
					// out.push('\tprintf("\(e.name).\(name)_()\\n");fflush(stdout);\n')
					out.push('\t' + e.name + '_* _ = (' + e.name + '_*)(HEXA_NEW(sizeof(' + e.name + '_)));\n')
					out.push('\t_->length_ = 0;\n')
					out.push('\t_->is_ = \(i);\n')
					out.push('\treturn _;\n')
					out.push('\};\n')
				}
				i++
			}

			// Static vars before static functions
			// TODO is = printed?
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + e.name + '_$' + name + '_;\n')
						// if (expr != null) out.push(' = ' + printExpression(expr))
					case Const(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + e.name + '_$' + name + '_;\n')
						// out.push(' = ' + printExpression(expr))
				} }

			for v in e.staticMethods { switch v {
					case Function(name, expr, args, defaults, funcType, variadic, isAsync):
						// types.push('\\n\\tstatic ')
						// types.push(printFunctionReturnType(funcType))
						// types.push(' ' + name + '_')
						// types.push(printFunctionArguments(args, funcType, true))
						// types.push(';')

						forwardFunctions.push(linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
						forwardFunctions.push(' ' + e.name + '_$' + name + '_')
						forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
						forwardFunctions.push(';\n')

						out.push(linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
						out.push(' ' + e.name + '_$' + name + '_')
						out.push(printFunctionArguments(args, funcType, variadic))

						let _currentReturnType = currentReturnType
						currentReturnType = getFunctionReturnType(funcType)
						let _insideAsyncFunction = insideAsyncFunction
						insideAsyncFunction = isAsync
						// out.push(' \{\};\n')
						out.push(' ' + (isAsync? printFunctionBody(expr, printFunctionReturnType(funcType)) : printBlock(expr)) + ';\n\n')
						insideAsyncFunction = _insideAsyncFunction
						currentReturnType = _currentReturnType
				} }
			types.push('\n\};\n')
		}

		// TODO get rid of this workaround
		let duplicates: [String] = []
		// TODO this syntax `let duplicates = String []`
		for c in project.classes {
			// `super(...)` resolves to the currently-printed class' parent
			currentSuperType = c.extend

			if c.external {
				// TODO rename to just 'require'
				if c.jsRequire != null {
					// `@require('#include <...>')`
					forward.push(c.jsRequire)
				}
				// TODO rename to just 'rename'
				if let jsNative = c.jsNative, jsNative != c.name {
					forward.push('#define ' + c.name + ' ' + jsNative)
				}

				// Host/FFI-mapped externals are done here — everything else is
				// a plain Hexa-shaped data type (`declare class` with fields,
				// e.g. the tool argument records) and falls through to NORMAL
				// emission: its fields get accessed and C needs the definition.
				// Builtin-mapped shapes (`ByValue<Int>` → `int32_t`,
				// `ArrayByValue<T, N>` → `T[N]`) name real C types already
				if c.jsRequire != null or c.jsNative != null {
					continue
				}

				if not stringifyType(c.classType).endsWith('_*') {
					continue
				}
			}
			// if (c.name == 'String') {
			// continue
			// }
			// `Any` maps onto the runtime `struct Any_` and `Bool` onto the
			// `Bool_` macro — matched by TYPE name so a scope-unique rename
			// of the nice class name cannot miss them
			var builtinName = c.name

			switch c.classType {
				case Class(kind):
					builtinName = kind.name
				case _:
			}

			if builtinName == 'Any' {
				// forward.push('#define Any_ Unknown_')
				continue
			}
			// TODO better idea
			if builtinName == 'Bool' {
				continue
			}

			if c.useless {
				// console.log('useless', c.name)
				// TODO continue
			}

			if c.template {
				//
				console.log('template', c.name)

				// Template classes keep only their static members, emitted
				// under the template name: generic class STATIC calls print
				// as `Promise_$resolve_` and static signatures erase generic
				// stubs to `Any_*` (see `stringifyType` `Generic` case)
				for v in c.staticVars { switch v {
						case Var(name, expr, dataType):
							globalVariables.push('\(stringifyType(dataType)) ' + c.name + '_$' + name + '_;\n')
						case Const(name, expr, dataType):
							globalVariables.push('\(stringifyType(dataType)) ' + c.name + '_$' + name + '_;\n')
					} }

				for v in c.staticMethods { switch v {
						case Function(name, expr, args, defaults, funcType, variadic, isAsync):
							forwardFunctions.push(linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
							forwardFunctions.push(' ' + c.name + '_$' + name + '_')
							forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
							forwardFunctions.push(';\n')

							out.push(linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
							out.push(' ' + c.name + '_$' + name + '_')
							out.push(printFunctionArguments(args, funcType, variadic))
							let _currentReturnType = currentReturnType
							currentReturnType = getFunctionReturnType(funcType)
							let _insideAsyncFunction = insideAsyncFunction
							insideAsyncFunction = isAsync
							out.push(' ' + (isAsync? printFunctionBody(expr, printFunctionReturnType(funcType)) : printBlock(expr)) + ';\n\n')
							insideAsyncFunction = _insideAsyncFunction
							currentReturnType = _currentReturnType
					} }

				continue
			}

			let n = c.name + '_*'
			// TODO better way
			c.name = stringifyType(c.classType).replace('_*', '')
			// NOTE class NAMES come from the class type itself —
			// `stringifyType` erases bare generic classes to `Any_*` which
			// must not become the emitted struct name
			var cName = ''

			switch c.classType {
				case Class(kind):
					cName = kind.name
				case _:
					cName = stringifyType(c.classType).replace('_*', '')
			}

			c.name = cName

			if c.name == 'Array' {
				// console.log(c.dataType)
			}

			if c.name.startsWith('IMAGE_THUNK_DATA')
			{
				// console.log('###', c)
				// console.log(c.name, type.parent, atts)
			}

			if c.name.startsWith('IMAGE_IMPORT_BY_NAME')
			{
				// console.log(c)
				// console.log(c)
				// console.log(c.name, type.parent, atts)
			}

			var isStruct = false
			var isUnion = false
			var isPacked = false
			switch c.classType {
				// TODO `case Class(type) or ClassInstance(type): {`
				case Class(kind): {
						let atts = project.mapDecorators.get(kind.parent)
						// if kind.name == 'IMAGE_THUNK_DATA'

						/*if c.name.startsWith('IMAGE_THUNK_DATA')
						{
							console.log('$$$', c.name, kind.parent, atts)
						}*/
						isStruct = Decorator.getDecorator(atts, 'struct') != null
						isUnion = Decorator.getDecorator(atts, 'union') != null
						isPacked = Decorator.getDecorator(atts, 'packed') != null
					}
					// TODO should be a Class, not Instance
				case ClassInstance(kind): {
						let atts = project.mapDecorators.get(kind.parent)
						// if kind.name == 'IMAGE_THUNK_DATA'

						/*if c.name.startsWith('IMAGE_THUNK_DATA')
						{
							console.log('$$$', c.name, kind.parent, atts)
						}*/
						isStruct = Decorator.getDecorator(atts, 'struct') != null
						isUnion = Decorator.getDecorator(atts, 'union') != null
						isPacked = Decorator.getDecorator(atts, 'packed') != null
					}
			}

			let nativeKind = isUnion? 'union ' : 'struct '

			let forwardedAs = nativeKind + c.name + '_;'

			if duplicates.includes(forwardedAs) {
				console.log('duplicate', forwardedAs)
				continue
			}
			duplicates.push(forwardedAs)

			forward.push(forwardedAs)
			// console.log('@@@ struct ' + c.name + '_;')
			forward.push('typedef \(nativeKind)\(c.name)_ \(c.name)_;')

			if isPacked {
				types.push('#pragma pack(1)\n')
			}

			types.push(nativeKind + c.name + '_ \{\n\t')
			let vtable = ['struct ' + c.name + '__ \{\n\t']
			// TODO const pointer to const struct
			if isStruct or c.api == ClassBinaryInterface.StructureNoVirtual {
				// Ok
			} else {
				types.push('\n\tconst struct ' + c.name + '__ * const _;')
				// ARC header (D6): every vtable-managed instance starts with
				// `(_, rc)`. Structs keep their exact C ABI (no header).
				types.push('\n\tint32_t rc_;')
			}
			let vtableValue = ['const struct ' + c.name + '__ ' + c.name + '__$ = \{\n\t']
			let vtableBind = []

			if not isStruct, c.api != ClassBinaryInterface.StructureNoVirtual {
				vtable.push('int32_t (*QueryInterface_)(void*, void*, void**);')
				vtable.push('\n\t')
				vtable.push('uint32_t (*AddRef_)(void*);')
				vtable.push('\n\t')
				vtable.push('uint32_t (*Release_)(void*);')
				vtable.push('\n\t')
				vtableBind.push('&Hexa_QI_')
				vtableBind.push('&Hexa_AddRef_')
				vtableBind.push('&Hexa_Release_')
			}
			// ARC destroy-table row (F11 sweep reads it): vtable identity,
			// destroy fn (the `@destructor` method), instance size.
			if let dd = c.destructor {
				let openBrace = String.fromCharCode(123)
				let closeBrace = String.fromCharCode(125)
				destroyTable.push(openBrace + ' (const void*)&' + c.name + '__$, (void(*)(void*))' + c.name + '_$' + dd + '_, sizeof(' + c.name + '_)' + closeBrace)
			}

			// Synthesized container destroys (F11.2, ARC-marked): see
			// NiceClass.destroyKind. Skipped when a user @destructor
			// owns the slot. Additive dead code until the sweep lands.
			if c.destructor == null {
				if c.destroyKind == 1 {
					let dn = c.name + '_$destroyARC_'
					forwardFunctions.push('void ' + dn + '(void*)')
					forwardFunctions.push(';\n')
					out.push('void ' + dn + '(void* p_) \{\n')
					out.push('\t' + c.name + '_* a_ = (' + c.name + '_*)p_;\n')
					out.push('\tfor (int32_t i_ = 0; i_ < a_->length_; i_++) hexaUnref(a_->data_[i_]);\n')
					out.push('\tHEXA_FREE(a_->data_, sizeof(void*) * (size_t)a_->capacity_);\n')
					out.push('\};\n\n')
					let ob = String.fromCharCode(123)
					let cb = String.fromCharCode(125)
					destroyTable.push(ob + ' (const void*)&' + c.name + '__$, (void(*)(void*))' + dn + ', sizeof(' + c.name + '_)' + cb)
					arrayDestroyTags.push(c.name)
				}

				if c.destroyKind == 2 {
					let dn = c.name + '_$destroyARC_'
					forwardFunctions.push('void ' + dn + '(void*)')
					forwardFunctions.push(';\n')
					out.push('void ' + dn + '(void* p_) \{\n')
					out.push('\t' + c.name + '_* a_ = (' + c.name + '_*)p_;\n')
					out.push('\tHEXA_FREE(a_->data_, sizeof(void*) * (size_t)a_->capacity_);\n')
					out.push('\};\n\n')
					let ob = String.fromCharCode(123)
					let cb = String.fromCharCode(125)
					destroyTable.push(ob + ' (const void*)&' + c.name + '__$, (void(*)(void*))' + dn + ', sizeof(' + c.name + '_)' + cb)
					arrayDestroyTags.push(c.name)
				}

				if c.destroyKind == 3 {
					let dn = c.name + '_$destroyARC_'
					forwardFunctions.push('void ' + dn + '(void*)')
					forwardFunctions.push(';\n')
					out.push('void ' + dn + '(void* p_) \{\n')
					out.push('\t' + c.name + '_* m_ = (' + c.name + '_*)p_;\n')
					out.push('\thexaUnref(m_->key_);\n')
					out.push('\thexaUnref(m_->value_);\n')
					out.push('\};\n\n')
					let ob = String.fromCharCode(123)
					let cb = String.fromCharCode(125)
					destroyTable.push(ob + ' (const void*)&' + c.name + '__$, (void(*)(void*))' + dn + ', sizeof(' + c.name + '_)' + cb)
				}
			}

			// TODO `for i : v in`
			var vi = -1

			for v in c.vars {
				vi++

				switch v {
					case Var(name, expr, dataType):
						if let bits = c.varBits[vi] {
							types.push('\n\t\(stringifyType(dataType)) ' + name + '_')
							types.push(' : ' + bits)
							types.push(';') // TODO probably must be a single `types.push` if bit-arrays-by-value are supported in C
						} else if isFatValueType(dataType) {
							// S3b F1.6: function-typed fields double up
							// (`name$f_` + `void* name$e_`, D1) from the type alone.
							types.push('\n\t\(stringifyType(dataType)) ' + name + '$f_;')
							types.push('\n\tvoid* ' + name + '$e_;')
						} else {
							types.push('\n\t\(stringifyType(dataType)) ' + name + '_;')
						}

						switch dataType {
							case ClassInstance(kind, generics): {
									if kind.name == 'ArrayByValue' {
										var arraySize = ''

										if let count = generics[1] {
											arraySize = '[' + Type.stringify(count) + ']'
										} else {
											arraySize = '[]'
										}

										types.pop() // TODO better idea
										types.push('\n\t\(stringifyType(generics[0])) ' + name + '_' + arraySize + ';')
									}
								}
						}
						// else
						// types.push('\n\tAny_* ' + name + '_;')
						// if (expr != null)
						// out.push('\n\t\t\tthis.' + name + ' = ' + printExpression(expr) + '')
					case Const(name, expr, dataType):
						// S3b F1.6: `let`-bound function-typed fields double up too.
						if isFatValueType(dataType) {
							types.push('\n\t\(stringifyType(dataType)) ' + name + '$f_;')
							types.push('\n\tvoid* ' + name + '$e_;')
						} else {
							types.push('\n\t\(stringifyType(dataType)) ' + name + '_;')
						}

						/*let name = switch c.dataType {
							case ClassInstance(c):
								//c.fieldRenames.includes(name)? name : name + '_'
								let rename = c.fieldRenames[c.fieldNames.indexOf(name)]
								if rename != null {
									if name == 'key' {
										console.log('~~~~~', name, rename)
									}
									rename
								}

								name
							case _: name
												}*/
						// (S3b: the single push moved into the if/else above.)
						// else
						// types.push('\n\tAny_* ' + name + '_;')
						// if (expr != null) // null if property
						// out.push('\n\t\t\tthis.' + name + ' = ' + printExpression(expr) + '')
				}
			}

			// if c.vars.length == 0 {
			//
			// // TODO remove
			// types.push('\n\t\(stringifyType(type)) ' + name + '_;')
			// }

			// if (c.name == 'String') types.push('String_op')
			// Empty struct has size 0 in C, size 1 in C++
			var nonEmptyTable = false
			var hasToString = false

			for v in c.methods { switch v {
					case Function(name, expr, args, defaults, funcType, variadic, isAsync):
						hasToString = hasToString or name == 'toString'

						if (name == null or name == 'new') {
							// types.push('\n\t' + c.name + '_() {};') // For placement new
							// types.push('\n\tvoid this_')
							// types.push(printFunctionArguments(args, funcType, true))
							// types.push(';')
							// //types.push('\n\tstatic ' + c.name + '_* new_();')
							// forward.push('\n\tstatic ' + c.name + '_* new_')
							// forward.push(printFunctionArguments(args, funcType))
							// forward.push(';')
							forwardFunctions.push(c.name + '_* ' + c.name + '_$new_')
							forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
							forwardFunctions.push(';\n')
							// TODO cache printFunctionArguments to local var here

							// Init
							// out.push('void ' + c.name + '_::this_() \{\n')
							out.push(c.name + '_* ' + c.name + '_$this_')
							thisArgument = c.name + '_* $this'
							out.push(printFunctionArguments(args, funcType, variadic))
							thisArgument = null
							out.push(' \{\n')
							// TODO cache own vtable on function enter
							// out.push('\t$this->_ = &' + c.name + '__$;\n')

							// Init fields
							customThis = '$this'

							for v in c.vars { switch v {
									case Var(name, expr, dataType):
										if expr != null {
											// TODO `isArrayByValue` helper
											var isArrayByValue = false
											switch dataType {
												case ClassInstance(kind):
													if kind.name == 'ArrayByValue' {
														// TODO support `array = [...]` assignments everywhere cause C doesn't
														isArrayByValue = true
													}
											}

											if not isArrayByValue {
												// S3b F1.6: function-typed fields init BOTH halves.
												// `Any` sources bridge via `fatPtrAs` (M1 compiles).
												if isFatValueType(dataType) {
													out.push('\t$this->' + name + '$f_ = ' + fatPtrAs(expr, dataType) + ';' + '
')
													out.push('\t$this->' + name + '$e_ = ' + fatEnvStr(expr) + ';' + '
')
													out.push('\t$this->' + name + '$f_ = ' + fatPtrAs(expr, dataType) + ';' + '\n')
													out.push('\t$this->' + name + '$e_ = ' + fatEnvStr(expr) + ';' + '\n')
												} else {
													out.push('\t$this->' + name + '_ = ' + printInitializer(dataType, expr) + ';' + '
')
													out.push('\t$this->' + name + '_ = ' + printInitializer(dataType, expr) + ';' + '\n')
												}
											} else {
												// TODO
											}
										}
									case Const(name, expr, dataType):
										if expr != null {
											// S3b F1.6: `let`-bound function-typed fields init BOTH halves.
											// `Any` sources bridge via `fatPtrAs` (M1 compiles).
											if isFatValueType(dataType) {
												out.push('\t$this->' + name + '$f_ = ' + fatPtrAs(expr, dataType) + ';' + '
')
												out.push('\t$this->' + name + '$e_ = ' + fatEnvStr(expr) + ';' + '
')
												out.push('\t$this->' + name + '$f_ = ' + fatPtrAs(expr, dataType) + ';' + '\n')
												out.push('\t$this->' + name + '$e_ = ' + fatEnvStr(expr) + ';' + '\n')
											} else {
												out.push('\t$this->' + name + '_ = ' + printInitializer(dataType, expr) + ';' + '
')
												out.push('\t$this->' + name + '_ = ' + printInitializer(dataType, expr) + ';' + '\n')
											}
										}
								} }
							pushTab()

							switch expr {
								// TODO pattern match as `[...head]` or `[head, ...tail]`
								// ^ and optimize to no-saving-to-bind cause bound var not used later
								case Block(el): if el.length > 0 {
										out.push('\t' + printBlock(expr) + ';\n')
									}
								case null:
									// Body-less constructor (`declare class`) —
									// fields stay zeroed by `HEXA_NEW`
								case _:
									out.push('\t' + printBlock(expr) + ';\n')
							}
							popTab()
							customThis = null
							out.push('\n\treturn $this;\n')
							out.push('\};\n\n')

							// Alloc
							// out.push(c.name + '_* ' + c.name + '_$new_() \{\n')
							out.push(c.name + '_* ' + c.name + '_$new_')
							out.push(printFunctionArguments(args, funcType, variadic))
							out.push(' \{\n')
							// out.push('\tprintf("\(c.name).new_()\\n");fflush(stdout);\n')
							out.push('\tvoid** $_ = (void**)(HEXA_NEW(sizeof(' + c.name + '_)));\n')
							// TODO why so complicated? Just assign `_` v table pointer, makes also type-safer
							if c.api == ClassBinaryInterface.StructureNoVirtual {
							} else {
								out.push('\t$_[0] = (void *)&' + c.name + '__$;\n')
							}
							out.push('\t' + c.name + '_* _ = (' + c.name + '_*)($_);\n')
							// ARC birth count (D6: +1 return): matches the vtable-gated
							// `rc_` slot above — structs/native layouts stay untouched.
							if isStruct or c.api == ClassBinaryInterface.StructureNoVirtual {
								// Ok
							} else {
								out.push('\t_->rc_ = 1;\n')
							}

							// out.push('\tvoid* buffer_ = (struct ' + c.name + '_*)(HEXA_NEW(sizeof(struct ' + c.name + '_)));\n')
							// out.push('\tstruct ' + c.name + '_* _ = new (buffer_) ' + c.name + '_();\n')
							// out.push('\tstruct ' + c.name + '_* _ = new (buffer_) ' + c.name + '_();\n')
							// out.push('\t_->this_();\n')
							// out.push('\t_->this_(')
							out.push('\t' + c.name + '_$this_(')
							// out.push([for (a in args) a + '_'].join(', '))
							// S3b: fat ctor params forward BOTH halves to `$this_`
							// (plain `a_` names would not match the split signature).
							let arg: [String] = ['_']

							for i in args.length {
								var split = false
								switch funcType {
									case Function(fargs, _, _):
										if i < fargs.length, isFatValueType(fargs[i].dataType) {
											arg.push(args[i] + '$ptr_')
											arg.push(args[i] + '$env_')
											split = true
										}
									case _:
								}

								if not split {
									arg.push(args[i] + '_')
								}
							}
							out.push(arg.join(', '))
							out.push(');
')
							// F11 live registry: register AFTER $this_ completes (a
							// registered object is always fully constructed; an
							// unregistered-but-live one merely leaks). Skipped for
							// headerless layouts (structs/native) — nothing to count.
							if isStruct or c.api == ClassBinaryInterface.StructureNoVirtual {
								// Ok
							} else {
								out.push('	hexaRegisterLive_((void*)_);
')
							}
							out.push('	return _;
')
							out.push('\};\n\n')
						} else {
							thisArgument = c.name + '_* $this'
							vtable.push('\n\t')
							vtable.push((isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
							vtable.push(' (*const ' + name + '_) ')
							vtable.push(printFunctionArguments(args, funcType, variadic))
							vtable.push(';')
							nonEmptyTable = true

							forwardFunctions.push(linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
							forwardFunctions.push(' ' + c.name + '_$' + name + '_')
							forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
							forwardFunctions.push(';\n')

							let vbind = '&' + c.name + '_$' + name + '_'
							vtableBind.push(vbind)

							out.push(linkagePrefixFor(isAsync, c.name + '_$' + name + '_') + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
							out.push(' ' + c.name + '_$' + name + '_')
							out.push(printFunctionArguments(args, funcType, variadic))
							let _currentReturnType = currentReturnType
							currentReturnType = getFunctionReturnType(funcType)
							customThis = '$this'
							thisArgument = null
							// TODO cache own vtable on function enter
							// out.push(' \{\n\tprintf("\(c.name).\(name)()\\n");fflush(stdout);\n')
							let _insideAsyncFunction = insideAsyncFunction
							insideAsyncFunction = isAsync

							if let expr = expr {
								out.push(' ' + (isAsync? printFunctionBody(expr, printFunctionReturnType(funcType)) : printBlock(expr)) + ';\n\n')
							} else {
								let temp = tempId++
								let returns = printFunctionReturnType(funcType)

								// NOTE the abstract stub must return a value
								// matching the C return type (`void` functions
								// return nothing, scalars cannot take nullptr)
								if returns == 'void' {
									out.push(' \{\n\tHEXA_UNREACHABLE(\(temp));\n\};\n\n')
								} else {
									out.push(' \{\n\tHEXA_UNREACHABLE(\(temp));\n\treturn (' + returns + ')0;\n\};\n\n')
								}
							}
							insideAsyncFunction = _insideAsyncFunction
							// out.push('\}\n')
							customThis = null
							currentReturnType = _currentReturnType

							if false {
								out.push(printFunctionReturnType(funcType))
								out.push(' ' + c.name + '_::' + name + '_')
								out.push(printFunctionArguments(args, funcType))
								let _currentReturnType = currentReturnType
								currentReturnType = getFunctionReturnType(funcType)
								// out.push(' {};\n')
								// out.push(' ' + printBlock(expr) + ';\n')
								// thisArgument = 'this'
								// let arg = args.slice()
								let arg = [for a in args a + '_']
								arg.unshift('this')
								// console.log('slice', arg == args, arg, args)
								// out.push(" \{ return ' + c.name + '_$' + name + '_(' + arg.join(', ') + '); \};\n')
								out.push(' \{ return this->_->' + name + '_(' + arg.join(', ') + '); \};\n')
								// out.push(" \{ return ' + c.name + '_$' + name + '_' + printFunctionArguments(args) + '; \};\n')
								// thisArgument = null
							}
							currentReturnType = _currentReturnType
						}
				} }

			if nonEmptyTable == false {
				vtable.push('uint8_t padding_;')
			}

			if not hasToString {
				out.push('String_* ' + c.name + '_$toString_(\(c.name)_* this_) \{ return ')
				out.push(printExpression(Expression.String('[object Object]')))
				out.push('; \};\n\n')
			}

			// Static vars before static functions
			for v in c.staticVars { switch v {
					case Var(name, expr, dataType):
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + c.name + '_$' + name + '_;\n')
						// types.push('\n\tstatic void* ' + name + '_;')
						// if (expr != null) out.push(' = ' + printExpression(expr))
					case Const(name, expr, dataType):
						// types.push('\n\tstatic void* ' + name + '_;')
						// types.push('\n\tstatic \(stringifyType(dataType)) ' + name + '_;')
						globalVariables.push('\(stringifyType(dataType)) ' + c.name + '_$' + name + '_;\n')
						// out.push(' = ' + printExpression(expr))
				} }

				// for (v in c.staticMethods) switch v {
				// case Function(name, expr, args, defaults, funcType):
				// types.push('\n\tstatic ')
				// types.push(printFunctionReturnType(funcType))
				// types.push(' ' + name + '_')
				// types.push(printFunctionArguments(args, funcType))
				// types.push(';')
				// }

			types.push('\n\};\n')

			if isPacked {
				types.push('#pragma pack()\n')
			}
			vtable.push('\n\};\n')

			if isStruct or c.api == ClassBinaryInterface.StructureNoVirtual {
				vtableValue.push(vtableBind.join(',\n\t'))
				vtable.push(vtableValue.join('') + '\n\};\n')
				types.unshift(vtable.join(''))
			} else {
				var hnames: [String] = []
				var htypes: [Type] = []

				for v in c.vars { switch v {
						case Var(n, _, t):
							hnames.push(n)
							htypes.push(t)
						case Const(n, _, t):
							hnames.push(n)
							htypes.push(t)
						case _:
					} }
				let hlb = String.fromCharCode(123)
				let hrb = String.fromCharCode(125)
				let hnl = String.fromCharCode(10)
				let hq = String.fromCharCode(34)
				var hiddenDestroy = 'nullptr'

				if let dd = c.destructor {
					hiddenDestroy = '(void(*)(void*))&' + c.name + '_$' + dd + '_'
				} else {
					if c.destroyKind == 1 or c.destroyKind == 2 or c.destroyKind == 3 {
						hiddenDestroy = '(void(*)(void*))&' + c.name + '_$destroyARC_'
					} else {
						if c.extend != null {
							// F6: inheritance has NO layout yet — `IntArray_` is
							// `{ vtable, rc }`, it does not inline the `Array`
							// fields. Chaining the parent's destructor here would
							// run a parent-shaped free on a child-shaped object
							// (corruption). Keep nullptr — the sweep then SKIPS
							// (leak, safe) — and mark the site so the inheritance
							// pass can fill it in one place.
							hiddenDestroy = 'nullptr /*INHERIT-DESTROY*/'
						}
					}
				}
				// Per-class `toBool`: `String` is falsy when empty (JS), everything
				// else is always truthy (objects/arrays — `[]`/`{}` are truthy).
				var hiddenToBool = '&Hexa_ToBoolTrue_'

				if c.name == 'String' {
					hiddenToBool = '&String_hiddenToBool_'
					forwardFunctions.push('uint8_t String_hiddenToBool_(void*)')
					forwardFunctions.push(';\n')
					out.push('uint8_t String_hiddenToBool_(void* self_) ' + hlb + hnl)
					out.push('\tif (self_ == nullptr) return (uint8_t)0;' + hnl)
					out.push('\treturn (uint8_t)(((String_*)(self_))->length_ != (int32_t)0);' + hnl)
					out.push(hrb + '\n\n')
				}
				forwardFunctions.push('const char* ' + c.name + '_hiddenClassName_(void)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('Any_* ' + c.name + '_hiddenDynGet_(void*, String_*)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('void ' + c.name + '_hiddenDynSet_(void*, String_*, Any_*)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('uint8_t ' + c.name + '_hiddenHas_(void*, String_*)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('void ' + c.name + '_hiddenDelete_(void*, String_*)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('String_* ' + c.name + '_hiddenKeyAt_(void*, int32_t)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('int32_t ' + c.name + '_hiddenKeyCount_(void*)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('Any_* ' + c.name + '_hiddenIndexGet_(void*, int32_t)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('void ' + c.name + '_hiddenIndexSet_(void*, int32_t, Any_*)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('int32_t ' + c.name + '_hiddenIndexCount_(void*)')
				forwardFunctions.push(';\n')
				forwardFunctions.push('void ' + c.name + '_hiddenReflect_(void*, HexaReflectOp_*)')
				forwardFunctions.push(';\n')
				out.push('const char* ' + c.name + '_hiddenClassName_(void) ' + hlb + hnl)
				out.push('\treturn "' + c.name + '";' + hnl)
				out.push(hrb + '\n\n')
				out.push('Any_* ' + c.name + '_hiddenDynGet_(void* self_, String_* k_) ' + hlb + hnl)
				out.push('\t' + c.name + '_* self = (' + c.name + '_*)self_;' + hnl)
				out.push('\tif (self == nullptr || k_ == nullptr) return nullptr;' + hnl)
				// D2: an unknown field / null receiver is `null` = the sentinel
				// OBJECT, never a raw `nullptr` (a raw zero reads as "present"
				// at every `!= null` / `if let` / `??` test in the emitted code).
				out.push('\tif (self == nullptr || k_ == nullptr) return (Any_*)(size_t)(&HexaNone_);' + hnl)

				for i in hnames.length {
					let fn = hnames[i]
					let ft = htypes[i]
					var boxed = ''
					let mb0 = metaBlock.length

					if isFatValueType(ft) {
						boxed = 'Any_boxFatPair_((void(*)())(self->' + fn + '$f_), self->' + fn + '$e_)'
						var thunk = 'nullptr'

						if let n = argvApplyName(ft) {
							thunk = n
						}
						boxed = 'Any_boxFatPair_((void(*)())(self->' + fn + '$f_), self->' + fn + '$e_, ' + thunk + ')'
					} else {
						boxed = printToAnyConverter('self->' + fn + '_', ft)
					}

					if metaBlock.length != mb0 {
						while metaBlock.length > mb0 {
							metaBlock.pop()
						}
						continue
					}
					out.push('\tif (Any_objectStringEquals_(k_, ' + printExpression(Expression.String(fn)) + ')) ' + hlb + ' return ' + boxed + '; ' + hrb + hnl)
				}

				// F10.4: bound METHOD values. The whole Perfide UI is
				// `Any`-typed (`let state Any = targetWindow.state`), so
				// `af.content.split('\n')`, `lines.forEach(fn)`,
				// `someArray.push(x)` etc. are DYNAMIC calls: the callee is
				// read out of the receiver with `dyn_get` and dispatched by
				// the F10.3 pair registry. Without these branches the read
				// returns null and the legacy proxy swallows the call —
				// which is why the editor body, minimap and file tree drew
				// nothing. `env_` carries the receiver (a method thunk is
				// `withEnv` = true, so param 0 is the hidden `self`).
				for v in c.methods { switch v {
						case Function(mname, _, _, _, funcType, _, isAsync):
							if isBoxableMethod(mname, funcType, isAsync) {
								let implName = c.name + '_$' + mname
								out.push('\tif (Any_objectStringEquals_(k_, ' + printExpression(Expression.String(mname)) + ')) ' + hlb + ' return Any_boxFatPair_((void(*)())(&' + implName + '_), self, ' + implName + '$call_); ' + hrb + hnl)

								if not fatPairMethodNames.includes(implName) {
									fatPairMethodNames.push(implName)
									fatPairMethodTypes.push(funcType)
									fatPairMethodSelf.push(c.name + '_')
								}

								if not fatPairImpls.includes(implName) {
									fatPairImpls.push(implName)
								}
							}
						case _:
					} }

				if let parent = c.extend {
					out.push('\treturn ' + parent + '_hiddenDynGet_(self_, k_);' + hnl)
				} else {
					out.push('\treturn (Any_*)(size_t)(&HexaNone_);' + hnl)
				}
				out.push(hrb + '\n\n')
				out.push('void ' + c.name + '_hiddenDynSet_(void* self_, String_* k_, Any_* v_) ' + hlb + hnl)
				out.push('\t' + c.name + '_* self = (' + c.name + '_*)self_;' + hnl)
				out.push('\tif (self == nullptr || k_ == nullptr) return;' + hnl)

				for i in hnames.length {
					let fn = hnames[i]
					let ft = htypes[i]

					if isFatValueType(ft) {
						out.push('\tif (Any_objectStringEquals_(k_, String_$fromUTF16z_((const uint16_t*)L' + hq + fn + hq + '))) ' + hlb + ' if (v_ == nullptr) return; FatPair_* fp = (FatPair_*)v_; self->' + fn + '$f_ = reinterpret_cast<' + stringifyType(ft) + '>((size_t)(fp->impl_)); self->' + fn + '$e_ = fp->env_; return; ' + hrb + hnl)
					} else {
						let mb1 = metaBlock.length
						let conv = printTypeConverter('v_', project.typer.typeAny, ft)
						var conv = printTypeConverter('v_', project.typer.typeAny, ft)
						// C-shape fallback: generic/inferred fields (e.g. Map's
						// `nullValue = null`, later holding `V`) don't match a
						// typer arm exactly — but their C slot is scalar. A raw
						// `(int32_t)(Any_*)` is C4311 truncation (garbage int);
						// route by the emitted C type instead.
						let cShape = stringifyType(ft)

						if cShape == 'Bool_' or cShape == 'uint8_t' {
							conv = 'Any_toBool_(v_)'
						} else if cShape == 'int32_t' or cShape == 'int64_t' or cShape == 'int16_t' or cShape == 'int8_t' or cShape == 'uint32_t' or cShape == 'uint64_t' or cShape == 'uint16_t' or cShape == 'uint8_t' {
							conv = 'Any_unboxInt_(v_)'
						} else if cShape == 'float' or cShape == 'double' {
							conv = 'Any_unboxFloat_(v_)'
						}

						if metaBlock.length != mb1 {
							while metaBlock.length > mb1 {
								metaBlock.pop()
							}
							continue
						}
						out.push('\tif (Any_objectStringEquals_(k_, ' + printExpression(Expression.String(fn)) + ')) ' + hlb + ' self->' + fn + '_ = ' + conv + '; return; ' + hrb + hnl)
					}
				}

				if let parent = c.extend {
					out.push('\t' + parent + '_hiddenDynSet_(self_, k_, v_);' + hnl)
				}
				out.push(hrb + '\n\n')
				out.push('uint8_t ' + c.name + '_hiddenHas_(void* self_, String_* k_) ' + hlb + hnl)
				out.push('\t(void)self_;' + hnl)
				out.push('\tif (k_ == nullptr) return (uint8_t)0;' + hnl)

				for i in hnames.length {
					let fn = hnames[i]
					out.push('\tif (Any_objectStringEquals_(k_, ' + printExpression(Expression.String(fn)) + ')) return (uint8_t)1;' + hnl)
				}

				if let parent = c.extend {
					out.push('\treturn ' + parent + '_hiddenHas_(self_, k_);' + hnl)
				} else {
					out.push('\treturn (uint8_t)0;' + hnl)
				}
				out.push(hrb + '\n\n')
				out.push('void ' + c.name + '_hiddenDelete_(void* self_, String_* k_) ' + hlb + hnl)
				out.push('\t(void)self_; (void)k_;' + hnl)

				if let parent = c.extend {
					out.push('\t' + parent + '_hiddenDelete_(self_, k_);' + hnl)
				}
				out.push(hrb + '\n\n')
				out.push('String_* ' + c.name + '_hiddenKeyAt_(void* self_, int32_t i_) ' + hlb + hnl)
				out.push('\t(void)self_;' + hnl)
				out.push('\tif (i_ < (int32_t)0) return nullptr;' + hnl)

				for i in hnames.length {
					let fn = hnames[i]
					out.push('\tif (i_ == (int32_t)' + i + ') return ' + printExpression(Expression.String(fn)) + ';' + hnl)
				}

				if let parent = c.extend {
					out.push('\tif (i_ >= (int32_t)' + hnames.length + ') return ' + parent + '_hiddenKeyAt_(self_, i_ - (int32_t)' + hnames.length + ');' + hnl)
				}
				out.push('\treturn nullptr;' + hnl)
				out.push(hrb + '\n\n')
				out.push('int32_t ' + c.name + '_hiddenKeyCount_(void* self_) ' + hlb + hnl)
				out.push('\t(void)self_;' + hnl)

				if let parent = c.extend {
					out.push('\treturn (int32_t)' + hnames.length + ' + ' + parent + '_hiddenKeyCount_(self_);' + hnl)
				} else {
					out.push('\treturn (int32_t)' + hnames.length + ';' + hnl)
				}

				out.push(hrb + '\n\n')

				// F10 index ops (`obj[i]`, `obj[i] = v`, `obj.length` with Int
				// keys): the container contract is the class's own 1-arg `get` /
				// 2-arg `set` (first param a C `int32_t`) plus its `length`
				// field. Anything else chains to the parent, then no-ops. Bags
				// never get here (no vtable) — `Any_indexGet_` checks them first.
				var idxGetBody = ''
				var idxSetBody = ''
				var idxCountBody = ''

				for v in c.methods { switch v {
						case Function(mn, _, margs, _, mfType, _, _):
							let mt = mfType

							switch mt {
								case Function(fargs, mret, _):
									if mn == 'get', margs.length == 1, fargs.length == 1, idxGetBody == '' {
										if stringifyType(fargs[0].dataType) == 'int32_t', not isFatValueType(mret) {
											let mbGet = metaBlock.length
											let boxed = printToAnyConverter('self->_->get_(self, i_)', mret)

											if metaBlock.length == mbGet, boxed.indexOf('%') < 0 {
												idxGetBody = boxed
											}

											while metaBlock.length > mbGet {
												metaBlock.pop()
											}
										}
									}

									if mn == 'set', margs.length == 2, fargs.length == 2, idxSetBody == '' {
										if stringifyType(fargs[0].dataType) == 'int32_t', not isFatValueType(fargs[1].dataType) {
											let mbSet = metaBlock.length
											let conv = printTypeConverter('v_', project.typer.typeAny, fargs[1].dataType)

											if metaBlock.length == mbSet, conv.indexOf('%') < 0 {
												idxSetBody = 'self->_->set_(self, i_, ' + conv + ')'
											}

											while metaBlock.length > mbSet {
												metaBlock.pop()
											}
										}
									}
								case _:
							}
						case _:
					} }

				for v in c.vars { switch v {
						case Var(fn, _, ft):
							if fn == 'length', idxCountBody == '' {
								if stringifyType(ft) == 'int32_t' {
									idxCountBody = '(int32_t)(self->length_)'
								}
							}
						case _:
					} }

				out.push('Any_* ' + c.name + '_hiddenIndexGet_(void* self_, int32_t i_) ' + hlb + hnl)
				out.push('\t' + c.name + '_* self = (' + c.name + '_*)self_;' + hnl)
				out.push('\t(void)self_; (void)i_;' + hnl)

				if idxGetBody != '' {
					out.push('\treturn (Any_*)(' + idxGetBody + ');' + hnl)
				} else {
					if let parent = c.extend {
						out.push('\treturn ' + parent + '_hiddenIndexGet_(self_, i_);' + hnl)
					} else {
						out.push('\treturn nullptr;' + hnl)
					}
				}
				out.push(hrb + '\n\n')
				out.push('void ' + c.name + '_hiddenIndexSet_(void* self_, int32_t i_, Any_* v_) ' + hlb + hnl)
				out.push('\t' + c.name + '_* self = (' + c.name + '_*)self_;' + hnl)
				out.push('\t(void)self_; (void)i_; (void)v_;' + hnl)

				if idxSetBody != '' {
					out.push('\t' + idxSetBody + ';' + hnl)
					out.push('\treturn;' + hnl)
				} else {
					if let parent = c.extend {
						out.push('\t' + parent + '_hiddenIndexSet_(self_, i_, v_);' + hnl)
					}
				}
				out.push(hrb + '\n\n')
				out.push('int32_t ' + c.name + '_hiddenIndexCount_(void* self_) ' + hlb + hnl)
				out.push('\t' + c.name + '_* self = (' + c.name + '_*)self_;' + hnl)
				out.push('\t(void)self_;' + hnl)

				if idxCountBody != '' {
					out.push('\treturn ' + idxCountBody + ';' + hnl)
				} else {
					if let parent = c.extend {
						out.push('\treturn ' + parent + '_hiddenIndexCount_(self_);' + hnl)
					} else {
						out.push('\treturn (int32_t)0;' + hnl)
					}
				}
				out.push(hrb + '\n\n')

				// One `reflect_` slot per class: a universal `code_`-dispatched
				// op table (no layout change when new ops land — only new codes).
				out.push('void ' + c.name + '_hiddenReflect_(void* self_, HexaReflectOp_* op_) ' + hlb + hnl)
				out.push('\tif (self_ == nullptr || op_ == nullptr) return;' + hnl)
				out.push('\tswitch (op_->code_) ' + hlb + hnl)
				out.push('\tcase (int32_t)1: op_->resultInt_ = (int32_t)Hexa_ToBoolTrue_(self_); break;' + hnl)
				var hiddenToBoolCall = 'Hexa_ToBoolTrue_'

				if c.name == 'String' {
					hiddenToBoolCall = 'String_hiddenToBool_'
				}

				out.push('\tcase (int32_t)1: op_->resultInt_ = (int32_t)' + hiddenToBoolCall + '(self_); break;' + hnl)
				out.push('\tcase (int32_t)2: op_->resultStr_ = Hexa_GenericToString_(self_); break;' + hnl)
				out.push('\tcase (int32_t)3: op_->resultCStr_ = ' + c.name + '_hiddenClassName_(); break;' + hnl)
				out.push('\tcase (int32_t)4: op_->result_ = ' + c.name + '_hiddenDynGet_(self_, op_->key_); break;' + hnl)
				out.push('\tcase (int32_t)5: ' + c.name + '_hiddenDynSet_(self_, op_->key_, op_->value_); break;' + hnl)
				out.push('\tcase (int32_t)6: op_->resultInt_ = (int32_t)' + c.name + '_hiddenHas_(self_, op_->key_); break;' + hnl)
				out.push('\tcase (int32_t)7: ' + c.name + '_hiddenDelete_(self_, op_->key_); break;' + hnl)
				out.push('\tcase (int32_t)8: op_->resultStr_ = ' + c.name + '_hiddenKeyAt_(self_, op_->index_); break;' + hnl)
				out.push('\tcase (int32_t)9: op_->resultInt_ = (int32_t)' + c.name + '_hiddenKeyCount_(self_); break;' + hnl)
				out.push('\tcase (int32_t)10: op_->result_ = ' + c.name + '_hiddenIndexGet_(self_, op_->index_); break;' + hnl)
				out.push('\tcase (int32_t)11: ' + c.name + '_hiddenIndexSet_(self_, op_->index_, op_->value_); break;' + hnl)
				out.push('\tcase (int32_t)12: op_->resultInt_ = (int32_t)' + c.name + '_hiddenIndexCount_(self_); break;' + hnl)
				out.push('\tdefault: break;' + hnl)
				out.push('\t' + hrb + hnl)
				out.push(hrb + '\n\n')
				let vtHiddenInit = '\{' + hiddenDestroy + ', ' + hiddenToBool + ', &Hexa_GenericToString_, &' + c.name + '_hiddenClassName_, &' + c.name + '_hiddenDynGet_, &' + c.name + '_hiddenDynSet_, &' + c.name + '_hiddenHas_, &' + c.name + '_hiddenDelete_, &' + c.name + '_hiddenKeyAt_, &' + c.name + '_hiddenKeyCount_, &' + c.name + '_hiddenIndexGet_, &' + c.name + '_hiddenIndexSet_, &' + c.name + '_hiddenIndexCount_, &' + c.name + '_hiddenReflect_\}'
				let vtPublicInit = vtableBind.join(',\n\t')
				let vtDef = 'struct ' + c.name + '_vt \{ struct HexaReflect_ hidden; struct ' + c.name + '__ public_; \};\n'
				let vtVal = 'const struct ' + c.name + '_vt ' + c.name + '_vt$ = \{' + vtHiddenInit + ', \{' + vtPublicInit + '\}\};\n'
				let vtMacro = '#define ' + c.name + '__$ (' + c.name + '_vt$.public_)\n'
				let vtAssert = '_Static_assert(offsetof(struct ' + c.name + '_vt, public_) == sizeof(struct HexaReflect_), "reflect: public must follow hidden");\n'
				types.unshift(vtable.join('') + vtDef + vtVal + vtMacro + vtAssert)
			}
			vtableClasses.push(c.name)

			for v in c.staticMethods { switch v {
					case Function(name, expr, args, defaults, funcType, variadic, isAsync):
						forwardFunctions.push(linkagePrefixFor(isAsync, c.name + '_$' + name + '_') + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
						forwardFunctions.push(' ' + c.name + '_$' + name + '_')
						forwardFunctions.push(printFunctionArguments(args, funcType, variadic))
						forwardFunctions.push(';\n')

						out.push(linkagePrefixFor(isAsync, c.name + '_$' + name + '_') + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
						out.push(' ' + c.name + '_$' + name + '_')
						out.push(printFunctionArguments(args, funcType, variadic))

						let _currentReturnType = currentReturnType
						currentReturnType = getFunctionReturnType(funcType)
						let _insideAsyncFunction = insideAsyncFunction
						insideAsyncFunction = isAsync
						// out.push('\t{printf("\{c.name}.\{name}()\\n");\n\t')
						// out.push('\\{\\};\\n')
						if let e = expr {
							out.push(' ' + (isAsync? printFunctionBody(e, printFunctionReturnType(funcType)) : printBlock(e)) + ';\n\n')
						} else {
							// Body-less declare static — abstract stub with
							// matching return, mirrors instance-method stubs.
							// Built without brace escapes via fromCharCode.
							let temp = tempId++
							let returns = printFunctionReturnType(funcType)
							let openBrace = String.fromCharCode(123)
							let closeBrace = String.fromCharCode(125)

							if returns == 'void' {
								out.push(' ' + openBrace + ' HEXA_UNREACHABLE(' + temp + '); ' + closeBrace)
							} else {
								out.push(' ' + openBrace + ' HEXA_UNREACHABLE(' + temp + '); return (' + returns + ')0; ' + closeBrace)
							}
						}
						insideAsyncFunction = _insideAsyncFunction
						// out.push('\\t};\\n')
						currentReturnType = _currentReturnType
						// out.push(printFunctionArguments(args, defaults) + ' => \{ ' + printStatement(expr) + ' \}')
				} }
		}

		/*for g in project.globalFuncs {
				g.switch {
					case 123: 345
					case 123 { 345 }
					case 123 {
						345
					}
				}.switch {
					case 345:
				}

				var a = null
				b = a.unsafe(1,2,3)
				b = a.unsafe
				b = a.unsafe.xyz
			}*/
		for g in project.globalFuncs { switch g {
				case Function(name, expr, args, defaults, funcType, variadic, isAsync):
					// S3b: track the fat impl being printed (self-recursion
					// threads `$env`, not any slot).
					currentFatFn = name
					let link = project.globalLink.get(g) // TODO null guard
					var shouldEmitHeader = false
					var customHeader: String? = null
					var spec = ''
					var name = name + '_'
					var exports = false

					if let link = link {
						// if link.convention == CallingConvention.FastCall {
						// types.push('__attribute__((fastcall)) ')
						// }
						switch link.convention {
							case FastCall:
								// types.push('__attribute__((fastcall)) ')
								// NOTE `__attribute__((fastcall))` is not supported by MSVC and Clang on Windows
								// spec += '__attribute__((fastcall)) '
								spec += '__fastcall '
							case Default:
								spec += defaultCallingConvention
								// types.push(defaultCallingConvention+'$'+name)
							case CDecl:
								spec += '__cdecl '
							case StdCall:
								spec += '__stdcall '
							case _:
								// TODO more

						}

						if link.dllImport {
							spec += '__declspec(dllimport) '
							// types.push('__declspec(dllimport) ')
							shouldEmitHeader = true
						}

						// if let aligned = link.aligned {
						// spec += '__attribute__((aligned(\(aligned)))) '
						// // TODO sublime bad hl for \()
						// }

						if link.emitHeader {
							// TODO seems like it doesn't respects `@rename`
							shouldEmitHeader = true
						}

						if link.customHeader != null {
							customHeader = link.customHeader
						}

						// NOTE before `dllExports.push`
						if let rename = link.rename {
							name = rename
						}

						if link.dllExport {
							spec += '__declspec(dllexport) '
							// types.push('__declspec(dllexport) ')
							exports = true
							dllExports.push(link.linkName ?? name)
						}
					} else {
						// types.push(defaultCallingConvention)
						spec += defaultCallingConvention
					}

					if let customHeader = customHeader {
						// TODO error that dllexport/etc incompatible with customHeader
						types.push(customHeader)
						types.push('\n')
					} else if expr != null or shouldEmitHeader {
						types.push(linkagePrefixFor(isAsync, name) + spec)
						types.push((isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType)))
						types.push(' ' + name)
						types.push(printFunctionArguments(args, funcType, variadic))

						if let link = link, let linkName = link.linkName {
							// let linkName = exports and linkName.startsWith('__')? '_' + linkName : linkName
							if exports and extraUnderscore and linkName.startsWith('_') {
								types.push(' HEXA_LINK(\"_')
							} else {
								types.push(' HEXA_LINK(\"')
							}

							types.push(linkName)
							types.push('\")')
						}
						types.push(';\n')

						// MSVC has no asm() link-names (HEXA_LINK is empty there):
						// alias the suffixed Hexa-side C name to the real DLL
						// export at link time (FFI pivot, no SDK headers needed).
						// Guarded out on GNU/Clang (they keep using HEXA_LINK).
						if let link = link, let linkName = link.linkName {
							if link.dllImport, linkName != name {
								types.push('#ifdef _MSC_VER\n')
								types.push('#pragma comment(linker, \"/alternatename:__imp_' + name + '=__imp_' + linkName + '\")\n')
								types.push('#endif\n')
							}
						}
					}

					if let expr = expr {
						// if link == null {
						// We have `link.convention = Default` if `link` is present
						// out. types.push(defaultCallingConvention)
						// }
						let returns = linkagePrefixFor(isAsync, name) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType))
						out.push(returns)
						out.push(' ' + name)
						out.push(printFunctionArguments(args, funcType, variadic))

						let _currentReturnType = currentReturnType
						currentReturnType = getFunctionReturnType(funcType)
						let _insideAsyncFunction = insideAsyncFunction
						insideAsyncFunction = isAsync
						out.push(' ' + printFunctionBody(expr, printFunctionReturnType(funcType)) + ';\n\n')
						// S4: Any-callable thunk for every fat closure impl (even
						// empty ones) — additive dead code until dynamic calls
						// wire it (F10.3 replaces the `AnyValue_` proxy).
						if name.startsWith('closure$'), not name.endsWith('$thin_') {
							out.push(printClosureThunk(name, funcType))
							// F10.3 registry: impl + thunk names for the pair
							// dispatch table (emitted post-Types with the
							// coroutines block — needs no bodies, just names).
							// `name` here already carries the trailing `_`
							// (impl); the thunk swaps it for `$call_`.
							let implBase = name.substr(0, name.length - 1)

							if not fatPairImpls.includes(implBase) {
								fatPairImpls.push(implBase)
							}
						}
						insideAsyncFunction = _insideAsyncFunction
						currentReturnType = _currentReturnType
						currentFatFn = null
					}
					// out.push(printFunctionArguments(args, defaults) + ' ' + printBlock(expr) + ';')
			} }

			// Init
			// NOTE locals of the last printed function must not leak into
			// global/static initializers below (`cShape` keys on them)
		localDecls = [:]
		out.push('int HEXA_MAIN(int argc, char **argv) \{\n')
		// out.push('\tprintf("Starting...\\n");fflush(stdout);\n')
		// D2: install the `null` sentinel tag and sentinel-fill every
		// `ArrayByValue<T?, N>` (the intern table) BEFORE any string is
		// interned — `String_$fromUTF16_` retains a bucket head unconditionally.
		out.push('\thexaInstallNone_();\n')
		out.push('\thexaInitNoneSlots_();\n')
		out.push('%%%HEXA_STRINGS@@@\n')
		// out.push('\tString_Strings = (String_**)HEXA_NEW(HEXA_STRINGS * sizeof(String_*));\n')
		pushTab()

		for e in project.enumsSimple {
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						if (expr != null) {
							// Flush metaBlock temps (Elvis hoist, struct
							// temps) before the assignment — same protocol
							// as global inits (C2065 otherwise)
							let savedMbSimple = metaBlock
							metaBlock = []
							let initStrSimple = printInitializer(dataType, expr)

							for line in metaBlock {
								out.push('\t' + line + ';\n')
							}
							metaBlock = savedMbSimple
							out.push('\t' + e.name + '_$' + name + '_ = ' + initStrSimple + ';\n')
						}
					case Const(name, expr, dataType):
						if (expr != null) {
							let savedMbSimpleC = metaBlock
							metaBlock = []
							let initStrSimpleC = printInitializer(dataType, expr)

							for line in metaBlock {
								out.push('\t' + line + ';\n')
							}
							metaBlock = savedMbSimpleC
							out.push('\t' + e.name + '_$' + name + '_ = ' + initStrSimpleC + ';\n')
						}
				} }
		}

		for e in project.enumsComplex {
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						if expr != null {
							let savedMbComplex = metaBlock
							metaBlock = []
							let initStrComplex = printInitializer(dataType, expr)

							for line in metaBlock {
								out.push('\t' + line + ';\n')
							}
							metaBlock = savedMbComplex
							out.push('\t' + e.name + '_$' + name + '_ = ' + initStrComplex + ';\n')
						}
					case Const(name, expr, dataType):
						if expr != null {
							let savedMbComplexC = metaBlock
							metaBlock = []
							let initStrComplexC = printInitializer(dataType, expr)

							for line in metaBlock {
								out.push('\t' + line + ';\n')
							}
							metaBlock = savedMbComplexC
							out.push('\t' + e.name + '_$' + name + '_ = ' + initStrComplexC + ';\n')
						}
				} }
		}

		for e in project.classes {
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						if expr != null {
							let savedMbClass = metaBlock
							metaBlock = []
							let initStrClass = printInitializer(dataType, expr)

							for line in metaBlock {
								out.push('\t' + line + ';\n')
							}
							metaBlock = savedMbClass
							out.push('\t' + e.name + '_$' + name + '_ = ' + initStrClass + ';\n')
						}
					case Const(name, expr, dataType):
						if expr != null {
							let savedMbClassC = metaBlock
							metaBlock = []
							let initStrClassC = printInitializer(dataType, expr)

							for line in metaBlock {
								out.push('\t' + line + ';\n')
							}
							metaBlock = savedMbClassC
							out.push('\t' + e.name + '_$' + name + '_ = ' + initStrClassC + ';\n')
						}
				} }
		}

		// D2 fat-null env sentinel (S3b, M2+): addressable 4096-byte store so ARC
		// over a null env is a safe no-op (raw zero would break future `dec`
		// without branches). `== null` tests the code-ptr half only; `==`
		// tests both halves. F2 unifies this with the full sentinel family.
		globalVariables.push('alignas(4096) static uint8_t hexaSentinelEnvStore_[4096];\n')
		globalVariables.push('void* hexaSentinelEnv_ = (void*)hexaSentinelEnvStore_;\n')

		for g in project.globalVars {
			var defaults = true
			// TODO rename 'default' in JS gen `var default = true`
			switch g {
				// TODO maybe use "var"
				case Var(name, expr, dataType):
					let link = project.globalLink.get(g)
					var exports = false

					if let link = link {
						if let aligned = link.aligned {
							globalVariables.push('__attribute__((aligned(\(aligned)))) ')
							// TODO sublime bad hl for \()
						}

						if link.dllExport {
							globalVariables.push('__declspec(dllexport) ')
							exports = true
							dllExports.push(link.linkName ?? name)
						}
					}

					switch dataType {

						// TODO same for const
						case ClassInstance(classType, generics): {
								if classType.name == 'ArrayByValue' {
									var arraySize = ''

									if let count = generics[1] {
										arraySize = '[' + Type.stringify(count) + ']'
									} else {
										arraySize = '[]'
									}

									// D2: nullable managed slots must read as the `null`
									// sentinel OBJECT, not as a zero word (BSS `{0}`) —
									// `stringBuckets` is exactly this case: the intern
									// walk retains a bucket head before any string is
									// interned. Fill at boot from `hexaInitNoneSlots_`.
									if isNullSentinelType(generics[0]) {
										if let count = generics[1] {
											noneSlotInitLines.push('hexaFillNone_((void**)(&' + name + '_), (size_t)' + Type.stringify(count) + ');')
										}
									}

									globalVariables.push('\(stringifyType(generics[0])) ' + name + '_' + arraySize)

									if let link = link, let linkName = link.linkName {
										if exports and extraUnderscore and linkName.startsWith('_') {
											globalVariables.push(' HEXA_LINK("_')
										} else {
											globalVariables.push(' HEXA_LINK("')
										}

										globalVariables.push(linkName)
										globalVariables.push('")')
									}

									if let expr = expr {
										switch expr {
											case Array(el):
												let valueType = generics[0]
												// TODO reuse same initializer as in expression and use meta-blocks
												globalVariables.push(' = \{' + [for a in el printTypeConverter(printExpression(a), getType(a), valueType)].join(', ') + '\}')
											case _:
												// TODO more
												globalVariables.push(" = \{0\}")
										}
									}
									globalVariables.push(';\n')

									defaults = false
								} else if classType.name == 'ByValue' {
									globalVariables.push(stringifyType(dataType))
									globalVariables.push(' ' + name + '_')
									globalVariables.push(';\n')
									defaults = false
								}
							}
					}

					if defaults {
						// S3b F1.6: function-typed globals double up (`name$ptr_` +
						// `void* name$env_`). Linkage suffixes ride the ptr half only.
						if isFatValueType(dataType) {
							let ptrType = stringifyType(dataType)
							globalVariables.push(ptrType)
							globalVariables.push(' ' + name + '$ptr_')

							if let link = link, let linkName = link.linkName {
								if exports and extraUnderscore and linkName.startsWith('_') {
									globalVariables.push(' HEXA_LINK(\"_')
								} else {
									globalVariables.push(' HEXA_LINK(\"')
								}

								globalVariables.push(linkName)
								globalVariables.push('\")')
							}

							globalVariables.push(';\n')
							globalVariables.push('void* ' + name + '$env_;\n')

							if expr != null {
								out.push('\t' + name + '$ptr_ = ' + fatPtrAs(expr, dataType) + ';\n')
								out.push('\t' + name + '$env_ = ' + fatEnvStr(expr) + ';\n')
							}

							defaults = false
						} else {
							// types.push('void* ' + name + '_;\n')
							globalVariables.push(stringifyType(dataType))
							globalVariables.push(' ' + name + '_') // TODO respect `@rename`

							if let link = link, let linkName = link.linkName {
								if exports and extraUnderscore and linkName.startsWith('_') {
									globalVariables.push(' HEXA_LINK("_')
								} else {
									globalVariables.push(' HEXA_LINK("')
								}

								globalVariables.push(linkName)
								globalVariables.push('")')
							}

							// D2: a managed global WITHOUT an explicit initializer must
							// start as the `null` sentinel OBJECT, not as C's zero word
							// (`toolNameAliasMap_`, `reasoningEfforts_`, …): a raw zero
							// reads as "present" at every `!= null` / `if let` / `??` test
							// and is dereferenced by `hexaRef`/`hexaUnref` (which are
							// literally `rc_++`/`rc_--`). An address constant is a valid
							// static initializer, so no boot-time fill is needed.
							if expr == null {
								let globalShape = stringifyType(dataType)

								if globalShape.endsWith('_*') {
									globalVariables.push(' = (' + globalShape + ')(&HexaNone_)')
								}
							}

							globalVariables.push(';\n')

							if expr != null {
								let value String = printExpression(expr)

								// Printing zero global integers causes bug in Hexa runtime code
								// due to assignment of heap offset of zero after strings allocation
								// Also in C global values are guaranteed to be initialized to 0
								// TODO check for `project.typer.typeInt` and other integer types
								if value != '(int32_t)0' {
									// NOTE initializers convert like everywhere else
									// (unrelated pointers bridge through `size_t`).
									// Flush `metaBlock` temps (e.g. VirtualMethod
									// receiver spill) before the assignment —
									// otherwise the temp is used undeclared (C2065).
									let savedMb = metaBlock
									metaBlock = []
									let initStr = printInitializer(dataType, expr)

									for line in metaBlock {
										out.push('\t' + line + ';\n')
									}
									metaBlock = savedMb
									out.push('\t' + name + '_ = ' + initStr + ';\n')
								}
								// TODO init them at declaration! int a = 123;
							}
						}
					}
					// out.push('\n\tvar ' + name)
					// if (expr != null) out.push(' = ' + printExpression(expr))
					// TODO maybe not useful
					// else out.push(' = null')
				case Const(name, expr, dataType):
					// S3b F1.6: `let`-bound function-typed globals double up too.
					if isFatValueType(dataType) {
						let ptrType = stringifyType(dataType)
						globalVariables.push(ptrType)
						globalVariables.push(' ' + name + '$ptr_;\\n')
						globalVariables.push('void* ' + name + '$env_;\\n')

						if expr != null {
							out.push('\t' + name + '$ptr_ = ' + fatPtrAs(expr, dataType) + ';\n')
							out.push('\t' + name + '$env_ = ' + fatEnvStr(expr) + ';\n')
						}
					} else {
						globalVariables.push(stringifyType(dataType))
						globalVariables.push(' ' + name + '_;\n')

						if expr != null {
							let savedMbConst = metaBlock
							metaBlock = []
							let initStrConst = printInitializer(dataType, expr)

							for line in metaBlock {
								out.push('\t' + line + ';\n')
							}
							metaBlock = savedMbConst
							out.push('\t' + name + '_ = ' + initStrConst + ';\n')
						}
					}
					// types.push('void* ' + name + '_;\n')
					// out.push('\n\tvar ' + name + ' = ' + printExpression(expr))
			} }

		if project.init.length > 1 {
			throw 'project.init.length > 1'
		}
		let init = printStatement(project.init[0])

		// NOTE strings should be gathered after ALL expressions printed
		// TODO may be [] length == 0
		// let strings = ['String_Strings = (struct String_**)HEXA_NEW(HEXA_STRINGS * sizeof(struct String_*));\n']
		let strings: [String] = ['\tString_$root_ = String_$new_();\n']

		for id in declarationsOfStrings.length {
			// NOTE `const char[]` causes compiler to make a copy of the entire string on every usage
			// TODO set ref counting
			// strings.push('\tString_Strings[\(id)] = String_fromUTF8z("\(declarationsOfStrings[id])");\n')
			// strings.push('\tString_Strings[\(id)] = String_$fromUTF16z_((const uint16_t*)L"\(declarationsOfStrings[id])");\n')
			strings.push('\tString_\(id) = String_$fromUTF16z_((const uint16_t*)String_\(id)_);\n')
			// TODO ^ add predefined known bytes length? like sizeof
			forward.push('String_* String_\(id); static const wchar_t *String_\(id)_ = L"\(declarationsOfStrings[id])";')
			// strings.push('\twprintf(L"\(declarationsOfStrings[id])");\n')
		}
		out.push('\t')
		out.push(init)
		popTab()
		// for (init in project.init) {
		// // TODO custom entry
		// // TODO globalVars
		// out.push('\t')
		// out.push(printStatement(init))
		// popTab()
		// }
		// out.push('\tprintf("Exiting...\\n");\n')
		out.push('\tfflush(stdout);\n')
		out.push('\treturn 0;\n\}\n')

		out.push('#ifdef __cplusplus\n')
		out.push('\}\n')
		out.push('#endif\n')

		// forward.push('#define HEXA_STRINGS \(declarationsOfStrings.length)')
		// TODO all those to [ ].join('\n') instead of `+`

		if dllExports.length > 0 {
			Fs.writeFileSync(target + '.dllExport.txt', dllExports.join(' '))
		}

		// TODO instead of + + + use [String].join() as a rope
		// ^ also header/etc concat to others instead of .join('\n')
		// ^ \n can be placed at the header.push() lines or all.push('\n')
		// ^ allocate `all [String]` with known capacity to avoid relocations

		// Minted inline-structure forwards (created during expression
		// printing — `stringifyType` cannot see the local `forward` list)
		for d in structDefsForward {
			forward.push(d)
		}

		// F9: Promise struct forwards (generic instantiations have no other
		// forward; function forwards returning `Promise_X_*` precede Types).
		for s in promiseStructs {
			forward.push('struct ' + s + ';')
		}

		// Minted inline-structure BODIES — one block before Types (never
		// interleaved into the class being printed; see the field comment)
		let structBodies = structDefs.join('')

		return (
			header.join('\n')
			+ '\n// Forward\n' +
			forward.join('\n')

			+ '\n// Typedef functions\n' +
			typedefFunctions.join('')

			+ '\n// Forward functions\n' +
			// TODO forwardStructs.join('\nstruct '), forwardTypes
			forwardFunctions.join('')

			// Doc `///` comments cannot appear in between of bin-ops
			// + '\n\n// Strings\nString_* String_Strings[\(declarationsOfStrings.length)] = {nullptr};\n'
			// + '\n\n// Strings\nstruct String_** String_Strings;\n'
			+ '\n// Types\n' +
			structBodies +
			types.join('')

			+ '\n// Live registry (F11 side-table of live heap objects, no layout change)\n' +
			printLiveRegistry()

			+ '\n// Coroutines (F9: per-Promise co_await + promise_type, after structs)\n' +
			printCoroutines()

			+ '\n// Fat pairs (F10.3: pair-boxing runtime + thunk registry)\n' +
			printFatPairs()

			+ '\n// Scalar boxing (D7: real `Any` payloads for ints/floats)\n' +
			printScalarBoxing()

			+ '\n// Fat-pair thunks for bare global functions (F10.3, needs the unboxers)\n' +
			printFatPairGlobalThunks()

			+ '\n// Destroy table (ARC: tag -> destructor for the F11 sweep)\n' +
			printDestroyTable()

			+ '\n// Global variables\n' +
			printAnyObject() + globalVariables.join('')

			+ '\n// Sweep (F11: deferred free of rc==0 live entries, D6)\n' +
			printNullVtable() +
			printNoneSlotInit() +
			printTagNames() +
			printSweep()

			+ '\n// Any -> struct helpers (F10 dynamic shape, registered on demand)\n' +
			printAnyToStruct()

			+ '\n// F10.5 fat-value adapters (per-signature argv <-> typed bridges)\n' +
			printDynFatAdapters()

			+ '\n// Global functions\n' +
			globalFunctions.join('')

			+ '\n// Defaults\n' +
			Fs.readFileSync(__dirname + '/library/c/hexa.c').toString('utf8').split('\r\n').join('\n')

			+ '// Statements\n' +
			// TODO Boi, dat weird
			// ^ can be a call into `static void hexaInitStrings()` which also calls runtime string-init fun if required
			out.join('').split('%%%HEXA_STRINGS@@@').join(strings.join(''))
		).split('\n').join('\r\n')

		// DEAD CODE

		var out = ''

		// Types
		for e in project.enumsSimple {
			// No need to output simple enum values
			// out += '\n' + 'struct _x' + e.name + ' {};'
			// out += '\n' + 'uint32_t _x' + e.name + ';'
			declarationsOfOpaqueTypes.push('typedef uint16_t _x' + e.name)
			// TODO typedef, renamed
			for v in e.staticVars { switch v {
					case Var(name, expr, dataType):
						out += '\n' + stringifyType(dataType) + ' _x' + e.name + '_' + name

						if (expr != null) {
							out += ' = ' + printExpression(expr) + ';' // !to constructor
						}
						// += ;
					case Const(name, expr, dataType):
						out += '\n' + stringifyType(dataType) + ' _x' + e.name + '_' + name
						out += ' = ' + printExpression(expr) + ';'
				} }

			for v in e.staticMethods { switch v { // TODO forward, auto args
					// case Function(name, expr, args, defaults, types, returns):
					// out += '\n' + printType(returns) + ' _x' + e.name + '_' + name
					// out += printFunctionArguments(args, defaults, types) + " \{ ' + printStatement(expr) + ' \};'
				} }
		}

		for c in project.classes {
			if c.external {
				if c.jsRequire != null {
					// todo MAKE IT possible to use plain-c include's!
					// like "declare" vs "deep extern declare"
					out += '\n ' + '/*var ' + c.name + ' = require("' + c.jsRequire + '")*/'
					continue
				}
				// declarationsOfOpaqueTypes.push('#define _x' + c.name + ' ' + (c.jsNative ?? c.name))
				// Avoid adding of `;`
				// header.push('#define _x' + c.name + ' ' + (c.jsNative ?? c.name))
				header.push('typedef ' + (c.jsNative ?? c.name) + ' _x' + c.name + ';')
				continue
			}

			let renamed = '_x' + c.name
			let t = ['struct ', renamed, ' \{'] // t should be used instead of out???
			// out += '\n ' + 'struct ' + c.name + ' {'
			// maybe use as struct* not just `struct`?
			declarationsOfOpaqueTypes.push('typedef struct \(renamed)* \(renamed)')
			t.push('\n _xclass _xclass;') // Reference counting and metatable
			for v in c.vars { switch v {
					case Var(name, expr, dataType):
						t.push('\n ' + stringifyType(dataType) + ' _x' + name + ';')
						// if (expr != null) out += ' = ' + printExpression(expr)
						// t.push(';')
					case Const(name, expr, dataType):
						// t.push('\n ' + printType(type) + ' = ' + printExpression(expr) + ';')
						t.push('\n ' + stringifyType(dataType) + ' _x' + name + ';')
				} }

			for v in c.methods { switch v {
					case Function(name, expr, args, defaults): // Class method
						let types = null
						let returns = null
						var declaration = printType(returns) + ' '
						let constructor = (name == null or name == 'new')
						// TODO finally decide on 'new'
						if constructor {
							declaration = renamed + ' '
						}
						declaration += renamed + '_' + name

						if constructor {
							if args.length > 0 {
								declaration += '(void* _x' + args.join(', void* _x') + ')'
							} else {
								declaration += '()'
							}
						} else {
							if args.length > 0 {
								declaration += '(\(renamed) _xthis, void* _x' + args.join(', void* _x') + ')'
							} else {
								declaration += '(\(renamed) _xthis)'
							}
						}

						declarationsOfFunctions.push(declaration)
						// if (name == null || name == 'new') declaration = '\(renamed) \(renamed)_new'
						// if (name == null || name == 'new') out += '\n\(renamed)* constructor_\(renamed)'
						// else out += '\nauto ' + name
						out += '\n' + declaration
						// out += '(' + args.join(', ') + ') \{ '
						out += " \{ "

						if constructor {
							out += '\n \(renamed) _xthis = (\(renamed))HEXA_NEW(sizeof(struct \(renamed)));'
							// Init fields
							for v in c.vars { switch v {
									case Var(name, expr, dataType):
										if expr != null {
											out += '\n _xthis->_x' + name + ' = ' + printExpression(expr) + ';'
										}
									case Const(name, expr, dataType):
										out += '\n _xthis->_x' + name + ' = ' + printExpression(expr) + ';'
								} }
							out += '\n '
							out += printStatement(expr) + '\n return _xthis;\n\};'
						} else {
							out += printStatement(expr) + '\n\};'
						}
				} }
			t.push('\n\}')
			declarationsOfFullTypes.push(t.join(''))

			for v in c.staticVars { switch v {
					case Var(name, expr, dataType):
						out += '\n ' + stringifyType(dataType) + ' ' + renamed + '_' + name
						// t.push('\n ' + c.name + '.' + name)
						// TODO to main()
						// if (expr != null) out += ' = ' + printExpression(expr)
						out += ';'
						// if (expr != null) t.push(' = ' + printExpression(expr))
				} }
		}
	}

	var tabs = ''

	@inline fun pushTab() {
		tabs += '\t'
	}

	@inline fun popTab() {
		tabs = tabs.substring(0, tabs.length - 1)
	}

	// All names are prefixed with `_x`, so reserved words are not required
	var reserved = []

	// For `return value` conversions (like Bool to Any)
	var currentReturnType: Type? = null
	/// Set while printing an `async fun` body — makes `return` print as the
	/// C++ coroutine keyword `co_return` (see `printFunctionBody`).
	/// REDESIGN NOTE (#7, as-is for now): slated for removal with the C++
	/// coroutine redesign (explicit state machines instead of `co_*`).
	var insideAsyncFunction = false
	/// Set while printing a `catch` body — C++ forbids `co_await` inside a
	/// handler (C2304), so `await` there falls back to the settled `.value`
	/// read (no suspension, M1-safe; full catch suspension is later work).
	var insideCatch = false
	/// Extended class name in scope for `super(...)` → `Parent_$this_(...)`
	var currentSuperType: String? = null
	/// Asks Main to run the ARC inserter between normalize and codegen
	var arcEnabled = true
	/// Closure capture-lifting pass (F1 lite) — see `normalizing/closures.hexa`
	var closuresEnabled = true
	/// Reflect pre-lowering pass (dynamics to explicit reflection calls) —
	/// see `normalizing/reflect.hexa`. Runs before ClosureLifter.
	var reflectEnabled = true
	/// Reflect post-lowering pass (genC hacks to plain static calls) —
	/// see `normalizing/reflectPost.hexa`. Runs after ClosureLifter,
	/// before ArcInserter.
	var reflectPostEnabled = true

	// Surrounds with { brackets } single statement
	// TODO rename to printAsBlock
	fun printBlock(s: Statement): String {
		// return printStatement(s)
		switch s {
			case Block(el):
				return printStatement(s)
				// if (el.length == 1) return '\{ ' + printStatement(el[0]) + '; \}'
				if el.length == 1 { switch (el[0]) {
						case Block(_): return printBlock(el[0])
						case _: return '\{ ' + printStatement(el[0]) + '; \}'
					} }

				if el.length == 0 {
					return '\{\}'
				}
				return printStatement(s)
			case _: // return '\{ ' + printStatement(s) + '; \}'
				return printStatement(Statement.Block([s]))
		}
	}

	// Add extra `return 0` to avoid stack corruption
	fun printFunctionBody(s: Statement, returns: String): String {
		// `async fun` (C++ coroutine): ALWAYS append a tail return — it is
		// `co_return` so the compiler recognises the function as async, and it
		// still avoids UB from a missing return value
		if insideAsyncFunction {
			switch s {
				case Block(el):
					let block = el.clone()

					if returns == 'void' {
						block.push(Statement.Return(null))
					} else {
						block.push(Statement.Return(Expression.Int(0)))
					}

					return printBlock(Statement.Block(block))
			}
		}

		if returns != 'void', returns.endsWith('*') or [
			'float', 'int',
			'uint8_t', 'uint16_t', 'uint32_t', 'uint64_t',
			'int8_t', 'int16_t', 'int32_t', 'int64_t'
		].includes(returns) {
			switch s {
				case Block(el):
					let block = el.clone()
					block.push(Statement.Return(Expression.Int(0)))
					return printBlock(Statement.Block(block))
			}
		}

		return printBlock(s)
	}

	/// Real C/C++ `switch` labels only accept integral conditions — string,
	/// pointer and enum-object scrutinees must use the if-else chain instead
	fun isIntegralSwitch(t: Type?): Bool {
		if let t = t {
			switch Type.unwrapNullable(t) {
				case ClassInstance(c, _): return [
						'Bool', 'Int', 'Int8', 'Int16', 'Int32', 'Int64',
						'UInt8', 'UInt16', 'UInt32', 'UInt64',
						'SizeOfPointer', 'SignedSizeOfPointer', 'ClangChar'
					].includes(c.name)
				case _: return false
			}
		}

		return false
	}

	/// One `switch_ == value` comparison for the if-else chain (null → `-1` tag)
	fun switchValueOf(cc: Expression): String {
		switch cc {
			case Null:
				// TODO == nullptr for non-tagged enums
				// switch expr EnumTag
				return 'switch_ == -1'
			case _:
				return 'switch_ == ' + printExpression(cc)
		}
	}

	var metaBlock: [String] = []
	var tempId = 0
	/// S3b: Nice base name (`closure$N`) of the fat impl currently being
	/// printed (for self-recursion via `$env`) — set around global-func
	/// emission, cleared after (like `currentReturnType`).
	var currentFatFn: String? = null

	var last: Statement = '' as!Statement // TODO remove
	fun printStatement(s: Statement) {
		last = s ?? last // TODO should error! cause String!
		switch s {
			case Statements(els):
				var r = ''

				for s in els {
					if s != null {
						r += '\n' + tabs + printStatement(s) + ';'
					}
				}
				return r

			case Break:
				return 'break'

			case Continue:
				return 'continue'

			case Block(el):
				if el.length == 0 {
					return '\{\}'
				}
				pushTab()

				fun printMetaBlock(e: Statement) {
					let kind = metaBlock
					metaBlock = []

					var ss = printStatement(e)
					var r = []

					for line in metaBlock {
						// r.unshift(line)
						r.push(line)
					}
					r.push(ss)

					metaBlock = kind
					return r.join(';\n' + tabs)
				}

				var r = '\{'

				for e in el { switch e {
						case null:
						case Statements(els):
							for s in els {
								if s != null {
									r += '\n' + tabs + printMetaBlock(s) + ';'
								}
							}
						case _:
							// TODO r could be a rope/join
							// ^ interesting idea is rope-promotion,
							// cause r never leaves owning block (in js too)
							r += '\n' + tabs + printMetaBlock(e) + ';'
					} }

				popTab()
				return r + '\n' + tabs + '\}'

				// TODO case New(e, args): return '' + printExpression(e) + '$new_' + printCallArguments(args)

			case Const(name, expr, dataType):
				// DROP THAT FREAKING Const ALREADY
				return printStatement(Statement.Var(name, expr, dataType))
				return stringifyType(dataType) + ' ' + name + '_' + (expr == null? '' : ' = ' + printTypeConverter(printExpression(expr), getType(expr), dataType))

			case Var(name, expr, dataType):
				// Declare for `cShape` — use nodes may lie about the C type
				localDecls.set(name, dataType)

				// `Void`-typed temp (expression-statement) — `void x = ...` is
				// not valid C, the call prints alone
				if stringifyType(dataType) == 'void' {
					if expr == null {
						return ''
					}

					return printExpression(expr)
				}

				// S3b F1.6: function-typed bindings double up (`name$ptr_` +
				// `void* name$env_`) from the type alone. Single Nice binding
				// stays one `localDecls` entry (for fat detection); init
				// assembles the pair (`fatPtrAs` bridges `Any` sources).
				// `Const` delegates here automatically.
				if isFatValueType(dataType) {
					let ptrType = stringifyType(dataType)
					var r = ptrType + ' ' + name + '$ptr_; void* ' + name + '$env_'

					if expr != null {
						r += '; ' + name + '$ptr_ = ' + fatPtrAs(expr, dataType) + '; ' + name + '$env_ = ' + fatEnvStr(expr)
					}
					return r
				}

				switch dataType {
					case ClassInstance(typeClass, generics):
						var arraySize = ''
						var arrayLength = 0x7FFFFFFF

						if typeClass.name == 'ArrayByValue' {
							if let count = generics[1] {
								arraySize = '[' + Type.stringify(count) + ']'

								switch count {
									case Constant(value): {
											arrayLength = parseInt(value)
										}
								}
							} else {
								arraySize = '[]'
							}

							switch expr {
								case Array(el):
									let valueType = generics[0]
									// TODO typer check: 1 or N elements and type of elements
									// TODO use meta-blocks for non-constant values and strings
									return stringifyType(valueType) + ' ' + name + '_' + arraySize + ' = \{' + [for a in el printTypeConverter(printExpression(a), getType(a), valueType)].join(', ') + '\}'
								case String(string):
									if arrayLength <= string.length {
										throw 'String initializer is of length `\(string.length + 1)` including null terminator'
									}

									let valueType = generics[0]

									if generics[0] == project.typer.typeUInt8 {
										return stringifyType(valueType) + ' ' + name + '_' + arraySize + ' = "' + string + '"'
									}

									if generics[0] == project.typer.typeUInt16 {
										return stringifyType(valueType) + ' ' + name + '_' + arraySize + ' = L"' + string + '"'
									}

									let valueTypeString = stringifyType(valueType)
									// TODO project.typer.typeClangWideChar
									if valueTypeString == 'wchar_t' {
										return stringifyType(valueType) + ' ' + name + '_' + arraySize + ' = L"' + string + '"'
									}

									// TODO position, and in other exceptions too
									throw 'String initializer is incompatible: ' + valueTypeString
								case null:
									// TODO check this in typer
									throw 'Array initializer required ' + name
							}
						} else if typeClass.name == 'ByValue' {
							switch expr {
								case null:
								case New(e, args, result):
									// Just print out `T varName; init(&varName);`
									return stringifyType(dataType) + ' ' + name + '_; ' // + stringifyType(dataType) + '$this_(&' + name + '_);'
							}
						}
				}

				return stringifyType(dataType) + ' ' + name + '_' + (expr == null? '' : ' = ' + printInitializer(dataType, expr))

				// case Function(name, expr, args, defaults, types, returns):
				// return printType(returns) + ' _x' + name + printFunctionArguments(args, defaults, types) + ' ' + printBlock(expr)
				// //return 'const void* _x' + name + ' = ' + ((async==true)?'async ':'') + printFunctionArguments(args, defaults) + ' => ' + printBlock(expr)
			case Function(name, expr, args, defaults, funcType, _, isAsync):
				let _currentReturnType = currentReturnType
				currentReturnType = getFunctionReturnType(funcType)

				let temp = tempId++
				let rt = linkagePrefix(isAsync) + (isAsync? printAsyncReturnType(funcType) : printFunctionReturnType(funcType))
				forwardFunctions.push(rt)
				forwardFunctions.push(' _$\(temp)')
				forwardFunctions.push(printFunctionArguments(args, funcType))
				forwardFunctions.push(';\n')
				//
				//
				// rt::forwardFunctions.push
				//
				// rt::forwardFunctions.push()
				//
				// rt |> forwardFunctions.push |> sort
				//
				// rt.(forwardFunctions.push).(sort)
				//
				// ...(rt, forwardFunctions.push, sort)
				//
				//
				// printFunctionArguments(args, funcType, true) |> globalFunctions.push()
				//
				// printFunctionArguments(args, funcType, true) |> globalFunctions.push
				//
				// printFunctionArguments(args, funcType, true) :: globalFunctions.push
				//
				// printFunctionArguments(args, funcType, true)::globalFunctions.push
				//
				//

				let tab = tabs
				tabs = ''
				globalFunctions.push(rt)
				globalFunctions.push(' _$\(temp)')
				globalFunctions.push(printFunctionArguments(args, funcType))
				globalFunctions.push(' ')
				let _insideAsyncFunction = insideAsyncFunction
				insideAsyncFunction = isAsync
				globalFunctions.push(isAsync? printFunctionBody(expr, printFunctionReturnType(funcType)) : printBlock(expr))
				insideAsyncFunction = _insideAsyncFunction
				tabs = tab

				currentReturnType = _currentReturnType
				return stringifyType(funcType) + ' \(name)_ = _$\(temp)'

			case Return(e):
				// F9: inside `async fun`, `return` is `co_return` (C++ coroutine).
				// Values box to `Any_*` (`promise_type::return_value(Any_*)`);
				// bare `return;` becomes `co_return (Any_*)nullptr` (settles
				// null via `return_value`; single `return_value` only —
				// C3782 forbids `return_value` + `return_void` together).
				// Outside async, plain `return` (unchanged).
				// REDESIGN NOTE (#7, as-is for now): `co_return` goes away
				// with C++ coroutines (explicit settle + state return).
				if insideAsyncFunction {
					if e == null {
						return 'co_return (Any_*)nullptr'
					}
					// Struct-typed literal: construct, then box the pointer.
					if let s = printObjectAs(currentReturnType, e) {
						return 'co_return ' + printToAnyConverter(s, currentReturnType)
					}
					return 'co_return ' + printToAnyConverter(printExpression(e), valueType(e))
				}
				let keyword = 'return'

				if e == null {
					return keyword
				}

				// Struct-typed literal: real construction (see printObjectAs).
				if let s = printObjectAs(currentReturnType, e) {
					return keyword + ' ' + s
				}

				return keyword + ' ' + forcedCast(currentReturnType, printTypeConverter(printExpression(e), valueType(e), currentReturnType))

			case If(econd, eif, eelse):
				var r = '\n\(tabs)if (' + printCondition(econd) + ') ' + printBlock(eif)

				if eelse != null {
					r += ' else ' + printStatement(eelse)
				}
				return r

			case Call(e, args, expects, kind):
				///let type = getType(e)
				// switch type {
				// case ClassInstance(_, _): return 'virtual'
				// case Class(_, _): return 'static'
				// }
				// S3a dual-mode TOP (before kind-switch: Static early-returns
				// would bypass the fat logic below). `Closure` → fat impl +
				// global/nullptr env; untagged fat-impl calls (thin-wrapper
				// inners carry explicit env) print fat with explicit args.
				if kind == CallKind.Closure {
					if closureBaseName(e) != null {
						return printClosureFatCall(e, args, expects)
					}
				}

				if closureBaseName(e) != null {
					return (closureBaseName(e) as!String) + '_' + printCallArguments(args, expectsOrDerived(expects, e))
				}
				// S3b: calls through inline-struct fields print thin-member +
				// explicit env (structs emit single members, no pairs).
				if isStructDotCall(e) {
					return printStructDotCall(e, args, expectsOrDerived(expects, e))
				}
				// S3b: method Dots typed as non-virtual still dispatch via the
				// vtable (the typer only marks some sites VirtualMethod).
				var effKind = effCallKind(e, kind)
				// F10: interface-typed callees dispatch dynamically — the
				// value may be a bag whose function fields are boxed pairs
				// (the fat path would read struct slots off it).
				if isInterfaceBase(e) {
					return printDynamicCall(e, args, expectsOrDerived(expects, e))
				}
				// S3b F1.6: fat pair-held callees (params/locals/globals, field
				// Dots) call `ptr_(env_, args...)`. Methods stay on the vtable
				// path (`VirtualMethod` excluded).
				if effKind != CallKind.VirtualMethod, isFatCallee(e) {
					return printFatValueCall(e, args, expectsOrDerived(expects, e))
				}

				switch effKind {
					// TODO error on (_,_) if simple enum case CallKind.VirtualMethod(_, _): return '*.virtual'
					case VirtualMethod:
						switch e {
							case Dot(expr, name, result):
								// Dynamic receivers (`Any`/erased) have no
								// vtable — the Dot path prints the reflection
								// stub call instead (F10). F10.2: route through the
								// dynamic call slot (bags may hold the method as a
								// pair; otherwise the legacy proxy no-ops as before).
								// A raw `Any_dynGet_(...)(args)` call would not even
								// compile (`Any_*` is not callable, C2064).
								if isDynamic(valueType(expr)) {
									return printDynamicCall(e, args, expectsOrDerived(expects, e))
								}

								// Scalar receivers (`x.toString()` on `Int`) have
								// no vtable either — same helper as expressions
								if name == 'toString' {
									if let helper = scalarToString(printExpression(expr), cShape(expr)) {
										return helper
									}
								}

								let temp = tempId++

								let exprType = getType(expr)
								let typeString = stringifyType(exprType)
								let kindVar = typeString + ' _$\(temp) = ' + printExpression(expr)

								var isStruct = false
								switch exprType {
									case ClassInstance(kind, params): {
											let atts = project.mapDecorators.get(kind.parent)
											isStruct = Decorator.getDecorator(atts, 'struct') != null
										}
								}

								metaBlock.push(typeString + ' _$\(temp) = ' + printExpression(expr))

								if isStruct {
									// TODO add `, expects` to other `printCallArgumentsVirtual` calls
									return omitPointer(typeString) + '$' + name + '_' + printCallArgumentsVirtual('_$\(temp)', args, expectsOrDerived(expects, e))
								}

								// `@final` class: direct call, no vtable hop
								if let direct = finalMethodName(exprType, name, 'stmt', exprPos(expr)) {
									return direct + printCallArgumentsVirtual('_$\(temp)', args, expectsOrDerived(expects, e))
								}

								return '_$\(temp)->_->' + name + '_' + printCallArgumentsVirtual('_$\(temp)', args, expectsOrDerived(expects, e))
								// return
								// '\{\n' + tabs +
								// '\t' + stringifyType(getType(expr)) + ' _$\(temp) = ' + printExpression(expr) + ';\n' + tabs +
								// '_$\(temp)->_->' + name + '_' + printCallArgumentsVirtual('_$\(temp)', args, expects)// + ';\n' + tabs// +
								// '\}'
						}
						// case CallKind.Static: return '*.static'
						// case CallKind.Function: return '*.function'
						// case _: return '*.???' + kind
				}
				// '/*Statement.Call*/' + Type.stringify(type)
				// S3a dual-mode: `CallKind.Closure` → fat impl + global/nullptr env
				// (direct calls); untagged direct calls to a fat impl (thin-
				// wrapper inners carry an explicit env) print fat with explicit
				// args and NO auto-env. Stored values print as thin wrappers
				// via `printExpression Ident` and never reach here as callees.
				if kind == CallKind.Closure {
					if closureBaseName(e) != null {
						return printClosureFatCall(e, args, expects)
					}
				}

				if closureBaseName(e) != null {
					return (closureBaseName(e) as!String) + '_' + printCallArguments(args, expectsOrDerived(expects, e))
				}
				// NOTE an `Any_*`-shaped callee is a raw pointer — `ptr(args)`
				// is not valid C++ even with `Any_::operator()`, so it wraps
				// in the call proxy (declared types decide, see helper)
				if isDynamicCallee(e) {
					return printDynamicCall(e, args, expectsOrDerived(expects, e))
				}

				return '/*DYNRAW*/' + printExpression(e) + printCallArguments(args, expectsOrDerived(expects, e))

			case Try(expr, t, v, catches):
				// C++ mode: native `try`/`catch` with typed handlers — unmatched
				// exception types propagate automatically, no rethrow chain needed
				if cpp {
					pushTab()
					var rc = 'try \{\n' + tabs
					rc += printStatement(expr)
					popTab()

					for i in catches.length {
						// Typed handler: matches `throw`ed values of the declared type
						rc += '\n' + tabs + '\} catch (' + stringifyType(t[i]) + ' ' + v[i] + '_) \{ '
						pushTab()
						let _insideCatch = insideCatch
						insideCatch = true
						rc += printStatement(catches[i])
						insideCatch = _insideCatch
						popTab()
					}

					return rc + '\n' + tabs + '\}'
				}

				pushTab()
				var r = '_try \{\n' + tabs
				// TODO transfer &$try as function argument
				r += 'struct Any_* $try = (struct Any_*)0;' + '\n' + tabs
				r += printStatement(expr)
				popTab()
				// TODO test $try for null at each functions calls and goto $catch
				// TODO test $try for null and do ARC
				// NOTE param must print like `Ident` does (`e` → `e_`)
				r += '\n' + tabs + '$catch: ; \} _catch(' + printType(t[0]) + ' ' + v[0] + '_) \{\n' + tabs + ' '
				pushTab()
				r += printStatement(catches[0])
				popTab()
				return r + '\n' + tabs + '\}'

			case Assign(a, v):
				// F10 interface member write FIRST (fat and plain members
				// share it): the read-ternary can never be an lvalue, so
				// writes go through bag-set / struct-slot store.
				if isInterfaceBase(a) {
					switch a {
						case Dot(expr, name):
							return printIfaceAssign(expr, name, getType(a), v)
						case _:
					}
				}
				// S3b F1.6: fat targets assign BOTH halves (ptr + env, no
				// conversion — shapes uniform). Value halves via shared
				// helpers (closure impl+local/sentinel, pair halves, plain
				// wrappers+sentinel, null pair, Dot `$f_`/`$e_`).
				// `Any` sources bridge via `fatPtrAs` (M1 compiles).
				// TODO kinds like `static`
				if isFatValueType(valueType(a)) { switch a {
						case Ident(aname, _):
							return aname + '$ptr_ = ' + fatPtrAs(v, valueType(a)) + '; ' + aname + '$env_ = ' + fatEnvStr(v)
						case Dot(expr, dname, _):
							// Only Variable fields of real classes carry pairs —
							// methods/statics/dynamics/structs fall through to the
							// generic single-slot handling below.
							if isFatFieldDot(expr, dname, getType(a)) {
								let base = printExpression(expr)
								return base + '->' + dname + '$f_ = ' + fatPtrAs(v, getType(a)) + '; ' + base + '->' + dname + '$e_ = ' + fatEnvStr(v)
							}
						case _:
							return '/*UNPAIRED-ASSIGN*/' + printExpression(a) + ' = ' + printExpression(v)
					} }
					// TODO kinds like `static`
				switch a {
					case Dot(expr, name):
						// Dynamic
						let dataType = getType(expr)

						if ((dataType == project.typer.typeAny) or (dataType == null)) {
							// console.log('eeeeee', expr)
							// `static var` TODO describe logic more obviously
							switch expr {
								case Ident(named): {
										if DataHelper.isTitleCase(named) {
											// TODO proper conversion type in `printTypeConverter` of assigned field
											return printExpression(expr) + '$' + name + '_ = ' + printInitializer(getType(a), v)
											// printExpression(v)
										}
									}
							}

							// F10.2: fat values stored into bags box as pairs (impl + env
							// survive for the dynamic call slot); object literals
							// construct real bags (no `Object_from` null stubs);
							// other values use the plain `Any` conversion as before.
							var dynVal = printToAnyConverter(printExpression(v), getType(v))

							if let objLit = printObjectAs(project.typer.typeAny, v) {
								dynVal = objLit
							} else if isBoxableFat(v) {
								dynVal = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(v) + '), ' + fatEnvStr(v) + ', ' + fatThunkStr(v) + ')'
							}
							return anyDynSetStr(printExpression(expr), name, dynVal)
						}

						// F10 interface member write: bags store through the
						// linear string-keyed set; interface structs store the
						// DECL-order slot (an lvalue the read-ternary form can
						// never be). Base and value hoist once each (same
						// pattern as the dynamic Assignop arm below).
						if isInterfaceType(dataType) {
							let ibt = tempId++
							let btmp = '_$ib' + ibt
							let vtmp = '_$iv' + ibt
							let rT = stringifyType(dataType)
							let cb = String.fromCharCode(123)
							let cc = String.fromCharCode(125)
							var ifaceVal = printToAnyConverter(printExpression(v), getType(v))

							if let objLit = printObjectAs(project.typer.typeAny, v) {
								ifaceVal = objLit
							} else if isBoxableFat(v) {
								ifaceVal = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(v) + '), ' + fatEnvStr(v) + ', ' + fatThunkStr(v) + ')'
							}
							metaBlock.push(rT + ' ' + btmp + ' = ' + printExpression(expr))
							metaBlock.push('Any_* ' + vtmp + ' = ' + ifaceVal)
							metaBlock.push('if (' + btmp + ' != nullptr && ((const void**)(' + btmp + '))[0] == (const void*)(&AnyObject__$)) ' + cb + ' ' + anyDynSetStr('(Any_*)(' + btmp + ')', name, vtmp) + '; ' + cc + ' else ' + cb + ' ((' + rT + ')(' + btmp + '))->' + name + '_ = ' + printTypeConverter(vtmp, project.typer.typeAny, getType(a)) + '; ' + cc)
							return '(void)0'
						}
					case Index(expr, index):
						// `Any` (or untyped) receivers index DYNAMICALLY —
						// String keys on bags are FIELD stores (Any_objectSet),
						// not `Map.set` method calls — bags have no `set`.
						// Any-typed keys (e.g. `vscKey: Any` holding String)
						// discriminate at runtime via `Any_isObject_`.
						let exprType = getType(expr)

						if isDynamic(exprType) {
							let idxT = getType(index)
							var isStrKey = false
							if idxT == project.typer.typeString {
								isStrKey = true
							} else {
								if Type.unwrapNullable(idxT) == project.typer.typeString {
									isStrKey = true
								}
							}

							if isStrKey {
								var dynVal = printToAnyConverter(printExpression(v), getType(v))

								if let objLit = printObjectAs(project.typer.typeAny, v) {
									dynVal = objLit
								} else if isBoxableFat(v) {
									dynVal = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(v) + '), ' + fatEnvStr(v) + ', ' + fatThunkStr(v) + ')'
								}
								return 'Any_dynSet_((Any_*)(' + printExpression(expr) + '), ' + printExpression(index) + ', ' + dynVal + ')'
							}

							if isPureIsReceiver(expr) {
								var dynVal2 = printToAnyConverter(printExpression(v), getType(v))
							var dynVal2 = printToAnyConverter(printExpression(v), getType(v))

								if let objLit2 = printObjectAs(project.typer.typeAny, v) {
									dynVal2 = objLit2
								} else if isBoxableFat(v) {
									dynVal2 = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(v) + '), ' + fatEnvStr(v) + ')'
								}
								let recvS = printExpression(expr)
								let idxS = printExpression(index)
								let directW = 'Any_dynSet_((Any_*)(' + recvS + '), (String_*)(' + idxS + '), ' + dynVal2 + ')'
								let legacyW = printExpression(Expression.Call(
										Expression.Dot(expr, 'set', null),
										[index, v],
										project.typer.typeVoid,
										CallKind.Function,
										[]
									))
								let cb2 = String.fromCharCode(123)
								let cc2 = String.fromCharCode(125)
								metaBlock.push('if (Any_isObject_((Any_*)(' + recvS + ')) ' + cb2 + ' ' + directW + '; ' + cc2 + ' else ' + cb2 + ' ' + legacyW + '; ' + cc2)
								return '(void)0'
							if let objLit2 = printObjectAs(project.typer.typeAny, v) {
								dynVal2 = objLit2
							} else if isBoxableFat(v) {
								dynVal2 = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(v) + '), ' + fatEnvStr(v) + ', ' + fatThunkStr(v) + ')'
							}
							return printExpression(Expression.Call(
									Expression.Dot(expr, 'set', null /*TODO*/),
									[index, v],
									project.typer.typeVoid,
									CallKind.Function,
									[]
								))
							return 'Any_indexSet_((Any_*)(' + printExpression(expr) + '), (Any_*)(' + printExpression(index) + '), ' + dynVal2 + ')'
							return 'Any_indexSet_((Any_*)(' + printExpression(expr) + '), ' + printToAnyConverter(printExpression(index), idxT) + ', ' + dynVal2 + ')'
						}

						switch Type.unwrapNullable(exprType) {
							case ClassInstance(kind, generic):
								// Containers with a `set` method (Array, Map)
								// write through it — raw `expr[i] = v` is only
								// for pointer shaped storage
								if kind.fields.get('set') == ClassTypeField.Method {
									var keyType = project.typer.typeInt
									var valueType: Type? = null

									if kind.name != 'Array' {
										if let g = generic, g.length > 1 {
											keyType = g[0]
											valueType = g[1]
										}
									} else {
										if let g = generic, g.length > 0 {
											valueType = g[0]
										}
									}

									// NOTE the arguments are pre-converted
									// (`UnsafeBitCast` no-ops on matching
									// types) — the rebuilt `Call` node carries
									// no `expects`
									let key = Expression.UnsafeBitCast(index, keyType)
									var value = v

									if let to = valueType {
										value = Expression.UnsafeBitCast(v, to)
									}

									return printExpression(Expression.Call(
											Expression.Dot(expr, 'set', null /*TODO*/),
											[key, value],
											project.typer.typeVoid,
											CallKind.VirtualMethod,
											[]
										))
								}

								return printExpression(expr) + '[' + printTypeConverter(printExpression(index), getType(index), project.typer.typeInt) + ']'
								+ ' = ' + printExpression(v)
							case _:
						}

						return printExpression(expr) + '[' + printTypeConverter(printExpression(index), getType(index), project.typer.typeInt) + ']'
						+ ' = ' + printExpression(v)
				}
				return printExpression(a) + ' = ' + printInitializer(getType(a), v)
				// printExpression(v)
				// return printExpression(a) + ' = ' + printTypeConverter(printExpression(v), getType(v), getType(a))

			case Throw(e):
				// C++ mode: real `throw` (exceptions are on by default on MSVC/clang-cl)
				if cpp {
					return 'throw ' + printExpression(e)
				}

				return '_throw(' + printExpression(e) + ')'

			case For(name, over, by, reverse):
				return 'for (FIXME TODO struct Any_* ' + name + '_; ' + printExpression(over) + ';) ' + printStatement(by)
				// `for-in` must be lowered to `while` by the normalizer
				throw 'For statement reached codegen — normalizer must lower it first'

			case Increment(e):
				if isInterfaceBase(e) {
					return printIfaceIncDec(e, '++')
				}
				return printExpression(e) + '++'

			case Decrement(e):
				if isInterfaceBase(e) {
					return printIfaceIncDec(e, '--')
				}
				return printExpression(e) + '--'

			case While(econd, e, pre):
				// TODO ^ separate WhileDo DoWhile
				if pre {
					return '\n\(tabs)while (' + printCondition(econd) + ') ' + printStatement(e)
				}
				return '\n\(tabs)do \{' + printStatement(e) /*block*/ + '\} while (' + printCondition(econd) + ')'

			case Assignop(a, op, value):
				// TODO rename to AssignOp
				// F10.2: `x.y op= z` on a dynamic base has no addressable C
				// lvalue (`Any_dynGet_` returns a value) and the old
				// `AnyValue_` proxy was a silent no-op — preserve that
				// (read the field back so the value is unchanged) while
				// still evaluating the RHS once for effects. The base
				// hoists to a temp (single eval). Real dynamic arithmetic
				// lands with F10 content reflection.
				switch a {
					case Dot(base, name):
						var dynOpBase = false
						switch base {
							case Ident(id, _):
								if id.charAt(0) != id.charAt(0).toUpperCase() or id.startsWith('_') or id.startsWith('$') {
									if isDynamic(valueType(base)) {
										dynOpBase = true
									}
								}
							case _:
								if isDynamic(valueType(base)) {
									dynOpBase = true
								}
						}

						if dynOpBase {
							let bt = tempId++
							let btmp = '_$bt' + bt
							metaBlock.push('Any_* ' + btmp + ' = ' + printExpression(base))
							metaBlock.push('(void)(' + printExpression(value) + ')')
							return anyDynSetStr(btmp, name, anyDynGetStr(btmp, name))
						}

						// F10 interface receiver: bags keep the documented
						// dynamic no-op (read back — real arithmetic is F10
						// content reflection); interface structs do the REAL
						// op on their slot (an lvalue). Base + value hoist
						// once each.
						if isInterfaceType(valueType(base)) {
							let rT = stringifyType(valueType(base))
							let iot = tempId++
							let btmp = '_$io' + iot
							let vtmp = '_$iov' + iot
							let cb = String.fromCharCode(123)
							let cc = String.fromCharCode(125)
							metaBlock.push(rT + ' ' + btmp + ' = ' + printExpression(base))
							metaBlock.push('Any_* ' + vtmp + ' = ' + printToAnyConverter(printExpression(value), valueType(value)))
							return 'if (' + btmp + ' != nullptr && ((const void**)(' + btmp + '))[0] == (const void*)(&AnyObject__$)) ' + cb + ' ' + anyDynSetStr('(Any_*)(' + btmp + ')', name, anyDynGetStr('(Any_*)(' + btmp + ')', name)) + '; ' + cc + ' else ' + cb + ' ((((' + rT + ')(' + btmp + '))->' + name + '_ ' + Token.stringify(op) + '= ' + printTypeConverter(vtmp, project.typer.typeAny, getType(a)) + '); ' + cc
						}
					case _:
				}

				if getType(a) == project.typer.typeString, op == Token.Add {
					switch a {
						case Index(expr, index): {
								// Cache `index` to not re-evaluate twice
								let tempIndex = tempId++
								{
									let indexType = getType(index)
									let indexString = stringifyType(indexType)
									// TODO should be converted to valid index type
									let metaIndex = indexString + ' _$\(tempIndex) = ' + printExpression(index)
									metaBlock.push(metaIndex)
								}

								// Cache storage to not re-evaluate twice
								let tempStorage = tempId++
								{
									let indexType = getType(expr)
									let indexString = stringifyType(indexType)
									let metaIndex = indexString + ' _$\(tempStorage) = ' + printExpression(expr)
									metaBlock.push(metaIndex)
								}

								// `storage[index] += string`
								return '_$\(tempStorage)->_->set_(_$\(tempStorage), _$\(tempIndex), String_$combine_(_$\(tempStorage)->_->get_(_$\(tempStorage), _$\(tempIndex)), '
								+ printTypeConverter(printExpression(value), valueType(value), project.typer.typeString) + '))'
							}
					}
					return printExpression(a) + ' = String_$combine_(' + printExpression(a) + ', ' + printTypeConverter(printExpression(value), valueType(value), project.typer.typeString) + ')'
				}
				return printExpression(a) + ' ' + Token.stringify(op) + '= ' + printExpression(value)

				/*case Dot(expr, name): switch expr {
					// TODO ^ replace to Statement.Expression
					// TODO use types in future, cause renames may make expr to be lower case
					// ^ DotStaticMethodCall DotStaticMethodAsValue
					case Ident(id):
						// Static
						if (id.charAt(0) == id.charAt(0).toUpperCase()) {
							return id + '_:?:' + name + '_'
						}
					}
					return printExpression(expr) + '->' + name*/
			case Switch(expr, cases, statements):
				// Convert to if-else because C is not fun
				// TODO do it in normalizer
				// TODO support normal switch when possible
				// + option to always emulate switches for specific target
			case PlainSwitch(expr, cases, statements):
				// Real C `switch` for integral conditions, with grouped labels:
				// `case 1: case 2: { … } break;`
				if isIntegralSwitch(getType(expr)) {
					let sv = printExpression(expr)
					let svt = stringifyType(getType(expr))
					var ri = '\{ \(svt) switch_ = ' + sv + ';'
					ri += '\n' + tabs + 'switch (switch_) \{'

					for i in cases.length {
						pushTab()
						ri += '\n' + tabs

						if cases[i].length == 0 {
							ri += 'default:'
						} else {
							for cc in cases[i] {
								ri += ' case ' + printExpression(cc) + ':'
							}
						}

						ri += ' ' + printBlock(statements[i]) + ' break;'
						popTab()
					}

					ri += '\n' + tabs + '\}'
					return ri + '\n' + tabs + '\}'
				}

				// String/pointer/enum-object scrutinees cannot be C `switch`
				// labels — compare with a grouped if-else chain instead
				let value = printExpression(expr)
				let valueType = stringifyType(getType(expr))
				var r = '\{ \(valueType) switch_ = ' + value + ';'

				// case 1: case 2: case 3:
				var else_ = false
				for i in cases.length { if (cases[i].length > 1) {
						if else_ {
							r += ' else'
						}
						r += '\n' + tabs + 'if (' + '('
						let conds = []

						for cc in cases[i] { switch cc {
								case Null:
									// TODO == nullptr for non-tagged enums
									// switch expr EnumTag
									conds.push('switch_ == -1')
								case _:
									conds.push('switch_ == ' + printExpression(cc))
							} }
						r += conds.join(') || (') + ')) '
						pushTab()
						r += printBlock(statements[i])
						popTab()
						else_ = true
					} else if let cc = cases[i][0] {
						if else_ {
							r += ' else'
						}
						r += '\n' + tabs + 'if (' + switchValueOf(cc) + ') '

						switch cc {
							case Null:
								r += 'switch_ == -1) '
							case _:
								r += 'switch_ == ' + printExpression(cc) + ') '
						}
						pushTab()
						r += printBlock(statements[i])
						popTab()
						else_ = true
					} }

					// default:
				for i in cases.length { if (cases[i].length == 0) {
						if else_ {
							r += ' else'
						}
						r += '\n' + tabs
						r += printBlock(statements[i])
					} }

				r += ';\n' + tabs
				return r + '\}'

				// TODO don't use "0" as tag, use 1+; use `switch (a? a->index : 0)` or
				// generate `if (a) switch () else null-case` in normalizer
			case PatternSwitch(_):
				// TODO lower guards/binds to PlainSwitch/if-else in the normalizer
				throw 'PatternSwitch must be lowered by the normalizer first'

				// ARC retain/release (D3+D4): `RefInc` inlines the `rc++` now;
				// `DeferRefDec` below constructs a scope guard whose C++
				// destructor runs the `rc--` at block exit on every path
				// (normal returns AND unwinding, D5). S3b: fat values
				// retain/release the ENV half only (the code ptr is never
				// heap memory).
			case RefInc(name):
				let incParts: [String] = []

				for e in name {
					if isFatValueType(valueType(e)) {
						incParts.push('hexaRef(' + fatEnvStr(e) + ')')
					} else if isAnyLikeValue(valueType(e)) {
						// Any-shaped slots may hold managed payloads (or
						// immediates/singletons): count through the runtime
						// guard, never blind. One call, ONE evaluation of the
						// operand — the old inline form printed the expression
						// twice at every one of these sites.
						incParts.push('Any_refCounted_((Any_*)(' + printExpression(e) + '))')
					} else {
						incParts.push('hexaRef(' + printExpression(e) + ')')
					}
				}
				return incParts.join('; ')

				/*
						let temp = f()
						if temp != null {
							switch temp.index {
								// no null case
							}
				// D4: scope-exit guard. Constructed here, the destructor runs the
				// `rc--` at block exit on every path — the `defer rc--` half
				// of the pair (an exception between `RefInc` and here cannot
				// skip what was never retained, and can never double-free
				// per D6). One shared `void*` instantiation; pure-C targets
				// keep the inline best-effort form (F4.4).
			case DeferRefDec(name):
				if cpp {
					let decParts: [String] = []

					for e in name {
						let tid = tempId++
						var target = printExpression(e)

						if isFatValueType(valueType(e)) {
							target = fatEnvStr(e)
						}

						// Plain Ident slot (incl. its `$env_` twin): release
						// the VARIABLE's live value at scope exit — ARC's
						// per-assignment temp guards release rebinding olds,
						// so a construction snapshot would double-release the
						// FIRST value (rc drain → sweep frees live) and leak
						// the last. Ternary/comment targets stay snapshots.
						var isVarSlot = false

						switch e {
							case Ident(_, _): isVarSlot = true
							case _:
						}

						if isVarSlot {
							var plain = true
							var ci = 0

							while ci < target.length {
								let ch = target.charCodeAt(ci) ?? -1

								if ch == 63, ch == 40 { plain = false }
								ci++
							}

							isVarSlot = plain
						}

						if isAnyLikeValue(valueType(e)) and not isFatValueType(valueType(e)) {
							// Any-shaped slots: the counted guard checks the
							// payload shape at scope exit (immediates and
							// Bool singletons skip the release).
							if isVarSlot {
								decParts.push('HexaDeferCountedDecPtr_ _$defer' + tid + '_((void**)&(' + target + '));')
							} else {
								decParts.push('HexaDeferCountedDec_ _$defer' + tid + '_(' + target + ');')
							}
						} else {
							null case
							if isVarSlot {
								decParts.push('HexaDeferDecPtr_ _$defer' + tid + '_((void**)&(' + target + '));')
							} else {
								decParts.push('HexaDeferDec_ _$defer' + tid + '_(' + target + ');')
							}
						}
						^ in normalizer
					*/
				var r = 'switch (' + printExpression(expr) + ') \{'
					}

				// case 1: case 2: case 3:
				for i in cases.length { if (cases[i].length > 0) {
						r += '\n' + tabs
					return decParts.join(' ')
				}

						for cc in cases[i] {
							r += 'case ' + printExpression(cc) + ': '
						}
						// pushTab()
						// r += '\{\n' + tabs
						// r += printStatement(statements[i])
						// popTab()
						// r += '\n' + tabs + '\} break;\n' + tabs
				let legacyParts: [String] = []

						pushTab()
						r += printBlock(statements[i])
						popTab()
						r += ' break;'
					} }
				for e in name {
					if isFatValueType(valueType(e)) {
						legacyParts.push('hexaUnref(' + fatEnvStr(e) + ')')
					} else if isAnyLikeValue(valueType(e)) {
						legacyParts.push('Any_unrefCounted_((Any_*)(' + printExpression(e) + '))')
					} else {
						legacyParts.push('hexaUnref(' + printExpression(e) + ')')
					}
				}

					// default:
				for i in cases.length { if (cases[i].length == 0) {
						r += '\n' + tabs + 'default:'
						r += '\n' + tabs
						r += printBlock(statements[i])
						// r += '\n' + tabs
					} }
				return legacyParts.join('; ')

				r += '\n' + tabs
				return r + '\}'
				// `super(...)` → parent constructor (`this` reinterpreted as parent type)
			case SuperConstructor(args):
				if let superName = currentSuperType {
					let me = customThis ?? '$this'
					var callArgs = ''

					if args.length > 0 {
						callArgs = ', ' + [for a in args printExpression(a)].join(', ')
					}

					return superName + ' _ $ this_((' + superName + ' *) ' + me + callArgs + ') '
				}

				throw ' SuperConstructor outside of an extended class '

			case _: console.error("Unknown statement kind (GenCxx):", s)
				console.trace("Here I am!")
		}
	}

	fun hexaRestElement(exp: [Type]): Type? {
		if exp.length == 0 { return null }

		switch exp[exp.length - 1] {
			case Rest(element, native):
				if not native { return element }
			case _:
		}
		return null
	}

	fun isRestSpread(arg: Expression): Bool { switch arg {
			case Spread(inner):
				switch valueType(inner) {
					case Rest(_, _): return true
					case _:
				}
			case _:
		} return false }

	fun printHexaRestCall(args: [Expression], exp: [Type], restElem: Type, me: String?): String {
		// Hexa ABI `(fixed..., count, ptr)` — plain C stack array, no `Array` object.
		let fixedCount = exp.length - 1
		let prefix: [String] = []

		if let m = me { prefix.push(m) }

		// Spread forwarding `f(...r)` / `f(x, ...r)` — pass caller's count+ptr, no copy.
		for a in args { if isRestSpread(a) {
				for i in fixedCount {
					if stringifyType(exp[i]) == 'void' {
						continue
					}

					if i < args.length, not isRestSpread(args[i]) {
						// Fat fixed params (`setImmediate(cb, ...)` with `Any` cb)
						// expand to two C slots like `printCallArguments`.
						if isFatValueType(exp[i]), (isFatArg(args[i]) or isDynamic(valueType(args[i]))) {
							prefix.push(fatPtrAs(args[i], exp[i]))
							prefix.push(fatEnvStr(args[i]))
							continue
						}
						prefix.push(printTypeConverter(printExpression(args[i]), valueType(args[i]), exp[i]))
					} else if i >= args.length {
						if isFatValueType(exp[i]) {
							prefix.push('nullptr')
							prefix.push('hexaSentinelEnv_')
							continue
						}
						prefix.push(padValue(exp[i]))
					}
				}
				prefix.push('$nrest_')
				prefix.push('$rest_')

				if me != null { return '(' + prefix.join(', ') + ') ' }
				return '(' + prefix.join(', ') + ') '
			} }

			// Discrete args `f(a, b, c)` — pack rest extras into a stack array.
		var restCount = args.length - fixedCount

		if restCount < 0 { restCount = 0 }

		for i in fixedCount {
			if stringifyType(exp[i]) == 'void' {
				continue
			}

			if i < args.length {
				// Fat fixed params expand to two C slots (see above).
				if isFatValueType(exp[i]), (isFatArg(args[i]) or isDynamic(valueType(args[i]))) {
					prefix.push(fatPtrAs(args[i], exp[i]))
					prefix.push(fatEnvStr(args[i]))
					continue
				}
				prefix.push(printTypeConverter(printExpression(args[i]), valueType(args[i]), exp[i]))
			} else {
				if isFatValueType(exp[i]) {
					prefix.push('nullptr')
					prefix.push('hexaSentinelEnv_')
					continue
				}
				prefix.push(padValue(exp[i]))
			}
		}

		if restCount == 0 {
			prefix.push('0')
			prefix.push('nullptr')

			if me != null { return '(' + prefix.join(', ') + ') ' }
			return '(' + prefix.join(', ') + ') '
		}
		let elemC = stringifyType(restElem)
		let parts: [String] = []

		for k in restCount {
			let idx = fixedCount + k
			parts.push(printTypeConverter(printExpression(args[idx]), valueType(args[idx]), restElem))
		}
		let tmp = '_rest' + (tempId++)
		metaBlock.push(elemC + ' ' + tmp + '[' + ('' + restCount) + '] = \{' + parts.join(', ') + '\};')
		prefix.push('' + restCount)
		prefix.push(tmp)

		if me != null { return '(' + prefix.join(', ') + ') ' }
		return '(' + prefix.join(', ') + ') '
	}

	fun printCallArguments(args: [Expression], expects: [Type]? = null) {
		if let exp = expects {
			// Hexa rest `...x: T` (no @nativeVariadic) is `(count, ptr)` — stack array.
			if let restElem = hexaRestElement(exp) {
				return printHexaRestCall(args, exp, restElem, null)
			}
			// NOTE `Void`-typed arguments are dropped together with their
			// parameters (see `printFunctionArguments`)
			let results: [String] = []

			for i in args.length {
				if i < exp.length, stringifyType(exp[i]) == 'void' {
					continue
				}

				// S3b F1.6: one Nice function-typed arg → TWO C slots, BUT only
				// when the callee actually takes a fat value here. `Any`-typed
				// sources unbox via bridge + sentinel (M1 compiles) — e.g.
				// `Any`-boxed callbacks flow to fat params.
				// (or otherwise non-fat) params keep the S2 single thin wrapper
				// (global fallback) — e.g. `Any`-boxed callbacks in JS-shim
				// helpers like `canvasDefineProperty_`.
				if i < exp.length, isFatValueType(exp[i]), (isFatArg(args[i]) or isDynamic(valueType(args[i]))) {
					// S3b: cast the ptr half when the value's signature differs
					// from the expected one (restores the pre-S3b mismatched
					// fn-ptr cast, e.g. 1-arg executor vs 2-arg Promise slot).
					let ptrC = fatPtrAs(args[i], exp[i])
					let envC = fatEnvStr(args[i])
					results.push(ptrC)
					results.push(envC)
					continue
				}

				// NOTE: the pre-existing duplicate of this arm was removed
				// (#5 dedup — the second copy could never fire).
				if i < exp.length, isFatValueType(exp[i]), (isFatArg(args[i]) or isDynamic(valueType(args[i]))) {
					// S3b: cast the ptr half when the value's signature differs
					// from the expected one (restores the pre-S3b mismatched
					// fn-ptr cast, e.g. 1-arg executor vs 2-arg Promise slot).
					let ptrC = fatPtrAs(args[i], exp[i])
					let envC = fatEnvStr(args[i])
					results.push(ptrC)
					results.push(envC)
					continue
				}

				if i >= exp.length, isFatArg(args[i]) {
					let ptrC = fatPtrStr(args[i])
					let envC = fatEnvStr(args[i])
					results.push(ptrC)
					results.push(envC)
					continue
				}

				// Struct-typed literal: real construction (see printObjectAs).
				if i < exp.length, let s = printObjectAs(exp[i], args[i]) {
					results.push(s)
					continue
				}

				// F10.3: fat value into an `Any`-shaped slot boxes a pair
				// (impl + env survive; the dynamic call slot unpacks it).
				// Previously only the ptr half survived. Leaf shapes only
				// (composites have no addressable pair — see isBoxableFat).
				// Single funnel: `boxFatPair` (see #5).
				if i < exp.length, isBoxableFat(args[i]), stringifyType(exp[i]) == 'Any_*' {
					results.push('Any_boxFatPair_((void(*)())(' + fatPtrStr(args[i]) + '), ' + fatEnvStr(args[i]) + ')')
					results.push(boxFatPair(args[i]))
					continue
				}

				let printedArg = printTypeConverter(printExpression(args[i]), valueType(args[i]), exp[i])
				results.push(printedArg)
			}

			// Omitted OPTIONAL trailing arguments (`flags: String?` with no
			// explicit default) — Hexa call sites may pass fewer arguments,
			// C call sites must match the declared arity, so pad typed nulls.
			// S3b: omitted fat params pad a null pair (nullptr + sentinel).
			for i in exp.length {
				if i < args.length {
					continue
				}

				if stringifyType(exp[i]) == 'void' {
					continue
				}

				if isFatValueType(exp[i]) {
					results.push('nullptr')
					results.push('hexaSentinelEnv_')
					continue
				}

				results.push(padValue(exp[i]))
			}

			return '(' + results.join(', ') + ') '
		}

		return '(' + [for a in args printExpression(a)].join(', ') + ') '
	}

	/// Statement calls carry `expects` from the normalizer — an EMPTY list
	/// (callee type unknown at typing time) must fall back to the callee's
	/// function type or arguments never convert and optional ones never pad
	fun expectsOrDerived(expects: [Type]?, callee: Expression): [Type]? {
		if let exp = expects, exp.length > 0 {
			return exp
		}

		return callExpects(callee)
	}

	/// Body-less `declare fun` expects fallback (D8-style, small). `declareTypes`
	/// is filled at normalize time keyed by the renamed Nice name; body-less
	/// declares have no Nice `globalFuncs` entry to read from.
	fun declareExpects(name: String): [Type]? {
		if let dt = project.declareTypes.get(name) {
			switch dt {
				case Function(args, returns, variadic):
					let out: [Type] = []

					for a in args {
						out.push(a.dataType)
					}

					return out
				case _:
			}
		}

		return null
	}

	/// Expected argument types of a callee — expression-level `Call` nodes
	/// carry no `expects`, so derive them from the callee's function type
	fun callExpects(callee: Expression): [Type]? {
		switch getType(callee) {
			case Function(args, returns, variadic):
				let out: [Type] = []

				for a in args {
					out.push(a.dataType)
				}

				return out
			case _:
		}

		// NOTE module-level function idents carry NO type in Nice (the
		// normalizer passes `null` for globals) — resolve the signature from
		// the global function list or call arguments never get converted
		switch callee {
			case Ident(name):
				for g in project.globalFuncs {
					switch g {
						case Function(gname, _, _, _, funcType, _, _):
							if gname == name {
								switch funcType {
									case Function(args, returns, variadic):
										let out: [Type] = []

										for a in args {
											out.push(a.dataType)
										}

										return out
									case _:
								}
							}
					}
				}

				if let de = declareExpects(name) {
					return de
				}
			case Parenthesis(inner):
				return callExpects(inner)
			case _:
		}

		return null
	}

	/// Expression-Call expects from the Normalizer field (D8); falls back to
	/// `callExpects` derivation for desugared calls (empty field) and safety.
	fun exprCallExpects(fieldExpects: [Type], callee: Expression): [Type]? {
		if fieldExpects.length > 0 {
			return fieldExpects
		}

		return callExpects(callee)
	}

	/// Constructor parameter types of the emitted `Name_$new_` — looked up in
	/// the nice classes on demand (safe regardless of class processing order)
	fun constructorExpects(className: String): [Type]? {
		for c in project.classes {
			if omitPointer(stringifyType(c.classType)) == className {
				for m in c.methods {
					switch m {
						case Function(name, _, _, _, funcType, _, _):
							if name == null or name == 'new' {
								switch funcType {
									case Function(args, returns, variadic):
										let out: [Type] = []

										for a in args {
											out.push(a.dataType)
										}

										return out
									case _:
								}
							}
					}
				}
			}
		}

		return null
	}

	/// S3a dual-mode helpers: lifted `closure$N` have a FAT impl (`void* $env`
	/// first param) + a THIN wrapper (`closure$N$thin`, old signature, calls
	/// fat with the global/nullptr env) for stored/indirect single-var values
	/// until S3b pairs land. Direct `CallKind.Closure` calls go fat with the
	/// global env; stored `Ident(closure$N)` prints as the thin wrapper.
	/// Base fat name for a callee (unwraps IIFE `Parenthesis`; null unless the
	/// callee is a lifted closure impl, never a `$thin` wrapper).
	fun closureBaseName(e: Expression): String? { switch e {
			case Ident(name, _):
				if name.startsWith('closure$'), not name.endsWith('$thin') {
					return name
				}
				return null
			case Parenthesis(inner):
				return closureBaseName(inner)
			case _:
				return null
		} }

	/// S3b: does lifted `base` (`closure$N`) capture (has an `Env$N` helper)?
	/// Decided from `NiceClass`es (globals no longer consulted — S3b threads
	/// per-instance locals; the global slot remains only as the narrow
	/// fallback for obj-elem/array/Any/dynamic positions until F10 wiring).
	fun closureHasEnv(base: String): Bool {
		let suffix = base.substr(8, base.length - 8)
		let envClass = 'Env$' + suffix

		for c in project.classes {
			if c.name == envClass {
				return true
			}
		}
		return false
	}

	/// Instance type of `base`'s helper (`Env$N`), or null when empty/captureless.
	fun closureEnvType(base: String): Type? {
		let suffix = base.substr(8, base.length - 8)
		let envClass = 'Env$' + suffix

		for c in project.classes {
			if c.name == envClass {
				return c.classType
			}
		}
		return null
	}

	/// S3b F1.6: C ptr half of a fat Nice value (single string; env half is
	/// separate — pairs never collapse to one C value). Used by ALL binding
	/// sites (Var/Assign/arg/param/field/global/return-fallback) so they stay
	/// consistent. Missed kinds emit `/*UNPAIRED*/nullptr` (compiles; marker
	/// flags M2+ triage — zero hits expected in Perfide: no function returns,
	/// no closure arrays per trace).
	fun fatPtrStr(e: Expression): String { switch e {
			case Parenthesis(inner):
				return fatPtrStr(inner)
			case Ident(name, _):
				// Dropped creation (field/global/var initializers): the local twin
				// was never emitted — fall back to the thin wrapper (global env),
				// exactly S2-identical and always in scope.
				if let db0 = closureBaseName(e) {
					let ds0 = db0.substr(8, db0.length - 8)

					if project.droppedClosureEnvs.get('closureEnv$' + ds0) != null {
						return db0 + '$thin_'
					}
				}
				// Lifted closure value → fat impl directly (per-instance callers
				// use the local twin; fallback positions use the thin wrapper via
				// generic `printExpression`, never here).
				if closureBaseName(e) != null {
					return (closureBaseName(e) as!String) + '_'
				}
				// Pair var/param/global → its ptr half.
				if isFatValueType(valueType(e)) {
					return name + '$ptr_'
				}
				// Plain global function → on-demand thin wrapper (fat impl shape).
				if let gt = globalFuncType(name) {
					if isFatValueType(gt) {
						return thinWrapperFor(name)
					}
				}
				return printExpression(e) + '/*UNPAIRED-PTR*/'
			case Dot(expr, name, _):
				// F10 interface members: pair halves live inside the boxed
				// pair (bag value or struct `$f_`/`$e_` box), never as raw
				// struct slots on a possibly-bag receiver.
				if isInterfaceType(valueType(expr)) {
					return '((FatPair_*)(' + printIfaceField(expr, name, getType(e)) + '))->impl_'
				}
				// Function-typed Variable field → double slot (`->$f_`). Methods,
				// statics, dynamic receivers and inline structs never split.
				if isFatFieldDot(expr, name, getType(e)) {
					return printExpression(expr) + '->' + name + '$f_'
				}
				return printExpression(e) + '/*UNPAIRED-DOTPTR*/'
			case Null(_):
				return 'nullptr'
			case Call(_, _, _, _, _):
				// Function-typed RETURN ABI: the callee returns the CODE pointer
				// directly (its env half travels through the callee's closure
				// globals — see `makeAdder_`: `return (_$0)(closure$9$thin_)`),
				// so the call expression IS this half. Without this arm a binding
				// initialised from a call (`let add5 = makeAdder(5)`) emitted
				// `/*UNPAIRED-PTR*/nullptr` and the first call through it jumped
				// to 0 ("execute of 0"). `fatEnvStr` keeps its sentinel for calls
				// (it never re-evaluates the call, so no double side effect).
				return printExpression(e)
			case _:
				return '/*UNPAIRED-PTR*/nullptr'
		} }

	/// S3b F1.6: C env half of a fat Nice value (uniform `void*`: local twin,
	/// pair half, sentinel, or plain-global wrapper env). See `fatPtrStr`.
	fun fatEnvStr(e: Expression): String { switch e {
			case Parenthesis(inner):
				return fatEnvStr(inner)
			case Ident(name, _):
				if let base = closureBaseName(e) {
					let ds = base.substr(8, base.length - 8)

					if project.droppedClosureEnvs.get('closureEnv$' + ds) != null {
						return 'closureEnv$' + ds + '_'
					}

					if closureHasEnv(base) {
						// S3b: the per-instance twin only dominates its own block
						// (the hoisted creation site) — cross-function/method-value
						// uses fall back to the global twin (S2 semantics, always
						// in scope).
						if localDecls.get('closureEnvL$' + ds) != null {
							return 'closureEnvL$' + ds + '_'
						}
						return 'closureEnv$' + ds + '_'
					}
					return 'hexaSentinelEnv_'
				}

				if isFatValueType(valueType(e)) {
					return name + '$env_'
				}
				// F10.3: a dynamic source holding a boxed fat pair unboxes its env
				// (exact). Bare function designators and effectful sources keep the
				// legacy sentinel (no worse than before; never a pair).
				if isDynamic(valueType(e)), isPureIsReceiver(e), not isBareFunctionDesignator(e) {
					let p = printExpression(e)
					return '(Any_isFatPair_(' + p + ') ? ((FatPair_*)(' + p + '))->env_ : hexaSentinelEnv_)'
				}
				// Plain global function → sentinel (pairs with the wrapper above).
				// S3b retirements: `hexaSentinelEnv_` replaces S3a `nullptr`.
				if let gt = globalFuncType(name) {
					if isFatValueType(gt) {
						return 'hexaSentinelEnv_'
					}
				}
				return 'hexaSentinelEnv_/*UNPAIRED-ENV*/'
			case Dot(expr, name, _):
				// F10 interface members — env half of the boxed pair (see
				// fatPtrStr).
				if isInterfaceType(valueType(expr)) {
					return '((FatPair_*)(' + printIfaceField(expr, name, getType(e)) + '))->env_'
				}

				if isFatFieldDot(expr, name, getType(e)) {
					return printExpression(expr) + '->' + name + '$e_'
				}
				return 'hexaSentinelEnv_/*UNPAIRED-DOTENV*/'
			case Null(_):
				return 'hexaSentinelEnv_'
			case _:
				return 'hexaSentinelEnv_/*UNPAIRED-ENV*/'
		} }

	/// F10.5: argv-ABI thunk (`FatPair_.call_`) for a fat value being boxed into
	/// `Any`. A lifted closure carries its own `$call_` (emitted next to the impl
	/// by `printClosureThunk`). Everything else is a value whose impl only exists
	/// at runtime (a stored pair var/param, a fat field, a thin wrapper for a
	/// plain global) — those get `argvapply$N_`, the inverse adapter that reads
	/// both halves back out of the pair. Only shapes with no reconstructible
	/// signature keep `nullptr` (see the thin single-word struct field arm in
	/// `printToAnyConverter`).
	fun fatThunkStr(e: Expression): String { switch e {
			case Parenthesis(inner):
				return fatThunkStr(inner)
			case Ident(_, _):
				if let base = closureBaseName(e) {
					let ds = base.substr(8, base.length - 8)

					// A dropped creation has no per-instance env slot: the box
					// carries the thin wrapper, so adapt through argv instead of
					// the closure's own thunk.
					if project.droppedClosureEnvs.get('closureEnv$' + ds) == null {
						// `closure$178_` -> `closure$178$call_` (printClosureThunk)
						return base + '$call_'
					}
				}
			case _:
		}

		// Stored pair var/param, fat field, interface member, thin wrapper for a
		// plain global: the impl exists only at runtime, so `argvapply$T` reads
		// both halves back out of the pair it is handed.
		if let vt = fatValueType(e) {
			if let n = argvApplyName(vt) {
				return n
			}
		}
		return 'nullptr'
	}

	/// S3b: source function type behind a fat value (for call-site casts).
	/// `null` when there is no meaningful source (Null → nullptr needs none).
	fun fatValueType(e: Expression): Type? { switch e {
			case Ident(name, _):
				if closureBaseName(e) != null {
					return valueType(e)
				}

				if isFatValueType(valueType(e)) {
					return valueType(e)
				}
				return globalFuncType(name)
			case Dot(_, _, _):
				return getType(e)
			case Null(_):
				return null
			case _:
				return null
		} }

	/// F10.3: a bare function designator (`closure$N_` impl, plain global)
	/// is never a boxed pair — pair-unbox/dispatch sites must use the legacy
	/// path for these (the designator doesn't convert to `Any_*`).
	fun isBareFunctionDesignator(e: Expression): Bool {
		if closureBaseName(e) != null {
			return true
		}

		switch e {
			case Ident(name, _):
				return globalFuncType(name) != null
			case _:
				return false
		}
	}

	/// F10.3: leaf fat values whose pair storage is statically known
	/// (`Ident`/`Dot`/`Parenthesis` — vars, params, fields). Composite
	/// fat expressions (`If`/`Call`/...) have no addressable pair halves;
	/// boxing them would emit null pairs (worse than the legacy drop).
	/// Dynamic-based `Dot`s are excluded (the base may be a stub).
	fun isBoxableFat(e: Expression): Bool { switch e {
			case Ident(_, _):
				return isFatValueType(valueType(e))
			case Parenthesis(inner):
				return isBoxableFat(inner)
			case Dot(base, _, _):
				if isDynamic(valueType(base)) {
					return false
				}

				// F10: interface receivers may be bags — pair halves are
				// not struct slots there (the boxed pair comes from the
				// reflection read, see printIfaceField).
				if isInterfaceType(valueType(base)) {
					return false
				}
				return isFatValueType(valueType(e))
			case _:
				return false
		} }

	/// #5 single funnel for leaf fat values into `Any` slots (impl + env
	/// survive; the dynamic call slot unpacks the pair). All `Any`-boxing
	/// sites (object-lit fields, array elements, inits, call args) route
	/// here so pair shape never diverges. Composites have no addressable
	/// halves and keep the legacy drop (see `isBoxableFat`).
	fun boxFatPair(e: Expression): String {
		return 'Any_boxFatPair_((void(*)())(' + fatPtrStr(e) + '), ' + fatEnvStr(e) + ', ' + fatThunkStr(e) + ')'
	}

	/// #5 `Any` boxing for one element/value: pair when the leaf fat shape
	/// applies, otherwise the standard `Any` conversion. Replaces the four
	/// inline `isBoxableFat ? pair : converter` copies.
	fun anyBox(e: Expression): String {
		if isBoxableFat(e) {
			return boxFatPair(e)
		}

		// F10.3: a BARE global function designator (`drawRect`) stored into an
		// `Any` slot must become a PAIR as well. A raw code pointer is not
		// `Any_isFatPair_`, so every dynamic call through the slot fell into the
		// `AnyValue_` no-op proxy — Perfide's agent harness bag
		// (`{drawRect: drawRect, drawText: drawText, …}`) silently drew NOTHING:
		// the whole agent panel (background, title, toggles, bubbles) is `h.draw*(…)`.
		// The thunk for these is emitted by `printFatPairs` (no env slot).
		switch e {
			case Ident(name, _):
				if let ft = globalFuncType(name) {
					let cname = printExpression(e)

					if cname.endsWith('_') {
						let base = cname.substr(0, cname.length - 1)

						if not fatPairGlobalNames.includes(base) {
							fatPairGlobalNames.push(base)
							fatPairGlobalTypes.push(ft)
						}
						return 'Any_boxFatPair_((void(*)())(' + cname + '), nullptr, ' + base + '$call_)'
					}
				}
			case _:
		}

		return printToAnyConverter(printExpression(e), valueType(e))
	}

	/// F10 (target-c.md): TypeScript-like interface semantics — the value
	/// behind an interface-typed expression may be an `AnyObject` bag
	/// (Any-typed literals, JSON.parse materialization) OR a DECL-ordered
	/// interface struct, so member access must discriminate at runtime.
	fun isInterfaceType(t: Type?): Bool {
		if t == null {
			return false
		}

		switch Type.unwrapNullable(t) {
			case Class(kind):
				return kind.kind == ClassKind.Interface
			case ClassInstance(kind, _):
				return kind.kind == ClassKind.Interface
			case _:
				return false
		}
	}

	/// `isInterfaceType` on a Dot's base receiver.
	fun isInterfaceBase(e: Expression): Bool { switch e {
			case Dot(base, _, _):
				return isInterfaceType(valueType(base))
			case Parenthesis(inner):
				return isInterfaceBase(inner)
			case _:
				return false
		} }

	/// F10 interface field read: first-word tag discriminates the shape —
	/// bag → linear reflection by interned-string key (pointer identity
	/// first, no hashing); interface struct → DECL-order slot boxed to Any
	/// (the accessor's "read by known offset, convert" half). The Any
	/// result converts to the static member type. Fat members stay as the
	/// boxed pair (F10.3 dynamic slot / fatPtrStr+fatEnvStr unbox it).
	/// The receiver hoists once — chains would otherwise multiply-emit the
	/// whole discrimination (4 reads per level).
	fun printIfaceField(base: Expression, name: String, memberT: Type?): String {
		let rT = stringifyType(valueType(base))
		let iht = tempId++
		let itmp = '_$ib' + iht
		metaBlock.push(rT + ' ' + itmp + ' = ' + printExpression(base))
		return printIfaceFieldOn(itmp, name, memberT)
	}

	/// `printIfaceField` on an ALREADY-HOISTED receiver temp (an ident —
	/// re-printing it is free, re-printing the base expression is not).
	fun printIfaceFieldOn(recv: String, name: String, memberT: Type?): String {
		let bag = anyDynGetStr(recv, name)
		let q = String.fromCharCode(34)
		let hiddenGet = 'HexaReflectFor_(((const void**)(' + recv + '))[0])->dyn_get_((void*)(' + recv + '), ' + printExpression(Expression.String(name)) + ')'
		var oldSlot = '(((' + recv + '))->' + name + '_)'

		if isFatValueType(memberT) {
			let oldPair = 'Any_boxFatPair_((void(*)())((' + recv + ')->' + name + '$f_), ((' + recv + ')->' + name + '$e_))'
			var thunk = 'nullptr'

			if memberT != null {
				if let n = argvApplyName(memberT) {
					thunk = n
				}
			}
			let oldPair = 'Any_boxFatPair_((void(*)())((' + recv + ')->' + name + '$f_), ((' + recv + ')->' + name + '$e_), ' + thunk + ')'
			let structChoice = '(HexaHasReflect_(((const void**)(' + recv + '))[0]) ? ' + hiddenGet + ' : ' + oldPair + ')'
			let pairExpr = '((' + recv + ') != nullptr && ((const void**)(' + recv + '))[0] == (const void*)(&AnyObject__$) ? ' + bag + ' : ' + structChoice + ')'
			return '(' + pairExpr + ')'
		}
		let oldBoxed = printToAnyConverter(oldSlot, memberT)
		let structChoice = '(HexaHasReflect_(((const void**)(' + recv + '))[0]) ? ' + hiddenGet + ' : ' + oldBoxed + ')'
		let anyExpr = '((' + recv + ') != nullptr && ((const void**)(' + recv + '))[0] == (const void*)(&AnyObject__$) ? ' + bag + ' : ' + structChoice + ')'

		// Outer parens: the result is spliced into `(...) ->field` /
		// `(...) = v` contexts — without them the postfix/cast precedence
		// parses the TERNARY as the object (C2039/C2106).
		if memberT == null {
			return '(' + anyExpr + ')'
		}
		return '(' + printTypeConverter(anyExpr, project.typer.typeAny, memberT) + ')'
	}

	/// F10 interface member WRITE (statement): base + value hoist once
	/// each; bag → linear string-keyed set, interface struct → DECL-order
	/// slot store (fat members write the `$f_`/`$e_` halves from the boxed
	/// pair). Returns a `(void)0` statement — the metaBlock carries the
	/// real work (Assignop dynamic-arm pattern).
	fun printIfaceAssign(expr: Expression, name: String, memberT: Type?, v: Expression): String {
		let rT = stringifyType(valueType(expr))
		let iat = tempId++
		let btmp = '_$ia' + iat
		let vtmp = '_$iv' + iat
		let cb = String.fromCharCode(123)
		let cc = String.fromCharCode(125)
		let q = String.fromCharCode(34)
		var ifaceVal = printToAnyConverter(printExpression(v), getType(v))

		if let objLit = printObjectAs(project.typer.typeAny, v) {
			ifaceVal = objLit
		} else if isBoxableFat(v) {
			ifaceVal = 'Any_boxFatPair_((void(*)())(' + fatPtrStr(v) + '), ' + fatEnvStr(v) + ', ' + fatThunkStr(v) + ')'
		}
		metaBlock.push(rT + ' ' + btmp + ' = ' + printExpression(expr))
		metaBlock.push('Any_* ' + vtmp + ' = ' + ifaceVal)
		let hiddenSet = 'HexaReflectFor_(((const void**)(' + btmp + '))[0])->dyn_set_((void*)(' + btmp + '), ' + printExpression(Expression.String(name)) + ', ' + vtmp + ')'
		var oldStore = ''

		if isFatValueType(memberT) {
			let ftmp = '_$if' + iat
			metaBlock.push('FatPair_* ' + ftmp + ' = (FatPair_*)(' + vtmp + ')')
			oldStore = '(((' + rT + ')(' + btmp + '))->' + name + '$f_ = ' + ftmp + '->impl_)' + '; ' + '(((' + rT + ')(' + btmp + '))->' + name + '$e_ = ' + ftmp + '->env_)'
		} else {
			oldStore = '(((' + rT + ')(' + btmp + '))->' + name + '_ = ' + printTypeConverter(vtmp, project.typer.typeAny, memberT) + ')'
		}
		let structElse = 'if (HexaHasReflect_(((const void**)(' + btmp + '))[0])) ' + cb + ' ' + hiddenSet + '; ' + cc + ' else ' + cb + ' ' + oldStore + '; ' + cc
		metaBlock.push('if (' + btmp + ' != nullptr && ((const void**)(' + btmp + '))[0] == (const void*)(&AnyObject__$)) ' + cb + ' ' + anyDynSetStr('(Any_*)(' + btmp + ')', name, vtmp) + '; ' + cc + ' else ' + cb + ' ' + structElse + ' ' + cc)
		return '(void)0'
	}

	/// F10 interface receiver `x++`/`x--` (statement): bags keep the
	/// documented dynamic no-op (read back — real arithmetic is F10 content
	/// reflection); interface structs increment the slot (an lvalue).
	fun printIfaceIncDec(e: Expression, sym: String): String {
		switch e {
			case Dot(base, name):
				let rT = stringifyType(valueType(base))
				let ict = tempId++
				let btmp = '_$ix' + ict
				let cb = String.fromCharCode(123)
				let cc = String.fromCharCode(125)
				metaBlock.push(rT + ' ' + btmp + ' = ' + printExpression(base))
				metaBlock.push('if (' + btmp + ' != nullptr && ((const void**)(' + btmp + '))[0] == (const void*)(&AnyObject__$)) ' + cb + ' (void)(' + anyDynGetStr('(Any_*)(' + btmp + ')', name) + '); ' + cc + ' else ' + cb + ' ((((' + rT + ')(' + btmp + '))->' + name + '_)' + sym + '); ' + cc)
			case _:
		}
		return '(void)0'
	}

	/// S3b: pair-ptr with a call-site cast when the value's typedef differs
	/// from the expected one (restores the pre-S3b mismatched-fn-ptr cast,
	/// e.g. generic executors vs `Promise_$new_` params). No-op on match.
	/// `Any`-shaped sources holding boxed fat pairs unbox exactly (impl from
	/// the pair; F10.3); other dynamics bridge through `size_t` with sentinel
	/// env (M1: compiles). Pure receivers evaluate inline (3 harmless pure
	/// reads); effectful ones hoist to a metaBlock temp (single eval).
	fun fatPtrAs(e: Expression, toT: Type): String {
		let p = fatPtrStr(e)

		// S3b: dynamic (`Any`) to fat-typedef needs an explicit bridge —
		// bare `Any_*` never converts to a fn-ptr typedef (`C2440`).
		// Bare function designators are never pairs (no `Any_*` conversion).
		if isDynamic(valueType(e)), not isBareFunctionDesignator(e) {
			switch e {
				case Null(_):
					return p
				case _:
					if not isPureIsReceiver(e) {
						let t = tempId++
						metaBlock.push('Any_* _$fpu' + t + ' = (Any_*)(' + p + ')')
						let q = '_$fpu' + t
						return '(Any_isFatPair_(' + q + ') ? (' + stringifyType(toT) + ')(((FatPair_*)(' + q + '))->impl_) : (' + stringifyType(toT) + ')(size_t)(' + q + '))'
					}
					return '(Any_isFatPair_(' + p + ') ? (' + stringifyType(toT) + ')(((FatPair_*)(' + p + '))->impl_) : (' + stringifyType(toT) + ')(size_t)(' + p + '))'
			}
		}

		if let f = fatValueType(e) {
			if stringifyType(f) == stringifyType(toT) {
				return p
			}

			// F10.4: adapt instead of blindly re-casting when only the
			// parameter widths differ (`Any` params vs concrete callback
			// type) — see `fatBridgeFor`.
			if let br = fatBridgeFor(e, toT) {
				return '&' + br + '_'
			}

			return '(' + stringifyType(toT) + ')(' + p + ')'
		}

		return p
	}

	/// S3b/F10.4: a lifted closure flowing into a DIFFERENT fat signature (the
	/// js target adapts silently, C cannot). Emits a typed BRIDGE that
	/// converts each argument at the boundary and forwards to the closure:
	/// the case that matters today is a callback declaring `Any` params where
	/// the collection's callback type is concrete (`[Struct_N_]` elements
	/// into `fun (mode Any, i Int)`), so without a bridge the callee receives
	/// a raw headerless struct as `Any` and every dynamic read returns null
	/// (Perfide's Chat/Edit mode buttons drew no labels and never matched
	/// `state.agentMode`). Returns the bridge name (no trailing `_`) or null
	/// when the shapes do not line up — the caller then keeps the plain cast.
	/// Conversions reuse `printToAnyConverter` (struct → `AnyObject_` bag,
	/// scalar → box), hoisted out of the enclosing body via a metaBlock swap.
	var fatBridgeCache: [String : String] = [:]
	var fatBridgeCount Int = 0

	fun fatBridgeFor(e: Expression, toT: Type): String? {
		if closureBaseName(e) == null {
			return null
		}
		let eName = closureBaseName(e) as!String
		var fargs: [FunctionArgument] = []
		var targs: [FunctionArgument] = []
		var fret: Type = project.typer.typeAny
		var tret: Type = project.typer.typeAny
		var okFrom = false
		var okTo = false

		switch valueType(e) {
			case Function(a, r):
				fargs = a
				fret = r
				okFrom = true
			case _:
		}

		switch toT {
			case Function(a, r):
				targs = a
				tret = r
				okTo = true
			case _:
		}

		if not okFrom or not okTo {
			return null
		}

		if fargs.length != targs.length {
			return null
		}

		// Only "more dynamic callee" adapts (target concrete → closure `Any`),
		// and only for plain data parameters — fat/`void` slots have their own
		// ABI halves and keep the cast.
		var needed = false

		for i in fargs.length {
			let fS = stringifyType(fargs[i].dataType)
			let tS = stringifyType(targs[i].dataType)

			if fS == 'void' or tS == 'void' {
				return null
			}

			if isFatValueType(fargs[i].dataType) or isFatValueType(targs[i].dataType) {
				return null
			}

			if fS == tS {
				continue
			}

			if fS != 'Any_*' {
				return null
			}
			needed = true
		}

		if not needed {
			return null
		}

		if isFatValueType(fret) or isFatValueType(tret) {
			return null
		}

		if stringifyType(fret) != stringifyType(tret) {
			return null
		}
		let key = eName + '|' + stringifyType(toT)

		if let cached = fatBridgeCache.get(key) {
			return cached
		}
		// Build the forwarded args first (this is what pushes the box/bag
		// statements), then move those statements into the bridge body.
		let mb0 = metaBlock.length
		var args2: [String] = []

		for i in fargs.length {
			let fS = stringifyType(fargs[i].dataType)
			let tS = stringifyType(targs[i].dataType)

			if fS == tS {
				args2.push('a' + i)
			} else {
				args2.push(printToAnyConverter('a' + i, targs[i].dataType))
			}
		}
		let setup = metaBlock.slice(mb0, metaBlock.length)

		while metaBlock.length > mb0 {
			metaBlock.pop()
		}
		let bid = eName + '$bx' + fatBridgeCount
		fatBridgeCount++
		let retS = stringifyType(tret)
		var sig: [String] = ['void* env_']

		for i in targs.length {
			sig.push(stringifyType(targs[i].dataType) + ' a' + i)
		}
		var callArgs: [String] = ['env_']

		for a in args2 {
			callArgs.push(a)
		}
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var body = 'HEXA_C ' + retS + ' ' + bid + '_(' + sig.join(', ') + ') ' + lb + nl

		for s in setup {
			body += ' ' + s + ';' + nl
		}

		if retS == 'void' {
			body += ' ' + eName + '_(' + callArgs.join(', ') + ');' + nl
		} else {
			body += ' return ' + eName + '_(' + callArgs.join(', ') + ');' + nl
		}
		body += rb + nl + nl
		globalFunctions.push(body)
		fatBridgeCache.set(key, bid)
		return bid
	}

	/// S3b: on-demand thin wrapper for a PLAIN global function flowing to a
	/// fat position (`foo` → `foo_$thin_(void* env, args...)` ignoring env +
	/// sentinel env). One wrapper per function (F1-Q(a)); emitted into
	/// `globalFunctions`. Callers pass the wrapper ptr + sentinel (M2-safe:
	/// plain functions need no env; sentinel keeps ARC future-safe).
	var thinWrapperCache: [String : String] = [:]
	/// S3b: plain-global function type lookup (for wrapper pairs). Cached;
	/// null unless `name` is a module-level `globalFunc` (never a closure).
	var globalFuncTypeCache: [String : Type?] = [:]
	var globalFuncTypeCacheDone: [String : Bool] = [:]
	fun globalFuncType(name: String): Type? {
		if let done = globalFuncTypeCacheDone.get(name) {
			return globalFuncTypeCache.get(name)
		}
		globalFuncTypeCacheDone.set(name, true)

		for g in project.globalFuncs { switch g {
				case Function(gname, _, _, _, gfuncType, _, _):
					if gname == name {
						globalFuncTypeCache.set(name, gfuncType)
						return gfuncType
					}
			} }
		return null
	}
	/// S3b: true if a call ARG (or any value) flows to a fat position: typed
	/// function OR plain global function (wrapper pair). Centralizes the
	/// `printCallArguments`/`Virtual` expansion decision.
	fun isFatArg(e: Expression): Bool {
		if isFatValueType(valueType(e)) {
			return true
		}

		switch e {
			case Ident(name, _):
				if closureBaseName(e) != null {
					return true
				}

				if let gt = globalFuncType(name) {
					return isFatValueType(gt)
				}
			case Dot(base, name, _):
				return isFatFieldDot(base, name, getType(e))
				// S3b: an explicit `null` for a fat param splices to the null
				// pair (`nullptr` + sentinel) via `fatPtrStr`/`fatEnvStr`
				// (both have `Null` arms) — never a single cast.
			case Null(_):
				return true
			case _:
		}
		return false
	}
	fun thinWrapperFor(funcName: String): String {
		if let w = thinWrapperCache.get(funcName) {
			return w
		}
		// Look up the plain global's signature to mirror it (fat, env-first,
		// env ignored).
		var ftype: Type? = null
		for g in project.globalFuncs { switch g {
				case Function(gname, _, _, _, gfuncType, _, _):
					if gname == funcName {
						ftype = gfuncType
					}
			} }
		let ft = ftype as!Type
		var fargs: [FunctionArgument] = []
		var frets: Type = project.typer.typeAny

		switch ft {
			case Function(fa, fr, _):
				fargs = fa
				frets = fr
		}
		let retName = stringifyType(frets)
		let params: [String] = ['void* env_']
		let fwd: [String] = []

		for i in fargs.length {
			let ti = stringifyType(fargs[i].dataType)

			if ti == 'void' {
				continue
			}
			params.push(ti + ' arg' + i + '_')
			fwd.push('arg' + i + '_')
		}
		let wrapper = funcName + '$thin_'
		thinWrapperCache.set(funcName, wrapper)
		globalFunctions.push(retName + ' ' + wrapper + '(' + params.join(', ') + ') \{ return ' + funcName + '_(' + fwd.join(', ') + '); \}\n')
		return wrapper
	}

	/// S3b: fat Ident/Dot callees that are NOT lifted `closure$N` (those are
	/// handled above) — pair-held params/locals/globals and function-typed
	/// fields. Excludes `VirtualMethod` (vtable path owns method Dots).
	/// S3b: which member a Dot refers to (`Variable` field vs `Method` vs none).
	/// Centralizes the static/dynamic/struct exclusions so every Dot site
	/// agrees: only Variable fields of real classes carry fat pairs.
	fun dotFieldKind(base: Expression, name: String): ClassTypeField? {
		switch base {
			case Ident(id, _):
				if id.charAt(0) == id.charAt(0).toUpperCase(), not id.startsWith('_'), not id.startsWith('$') {
					return null
				}
			case _:
		}
		// NOTE declared types win over use-node types here: the typer coerces
		// `Any` uses to the expected type (the use node then lies about the C
		// value, which stays `Any_*`) — field lookup must key on what is
		// actually stored (see `cShape`/`valueType`).
		let bt = valueType(base)

		if bt == null {
			return null
		}
		let bt = getType(base)

		if bt == null {
			return null
		}
		// Dynamic (`Any`-shaped incl. Unknown/erased) receivers have no vtable
		// or pair slots — they route via reflection (F10). Key on the C shape:
		// `Any` is modeled as a ClassInstance whose fields map would otherwise
		// match, printing a bogus vtable/pair access on a dynamic value.
		if isDynamic(bt) {
			return null
		}
		// NOTE `kind.fields` misses `var` members the typer did not register
		// (e.g. HitBox handlers) — `fieldNames` is canonical for those.
		switch bt {
			case ClassInstance(kind, _):
				if kind.fields.get(name) == ClassTypeField.Method {
					return ClassTypeField.Method
				}

				if kind.fieldNames.includes(name) {
					return ClassTypeField.Variable
				}
				return null
			case Class(kind):
				if kind.fields.get(name) == ClassTypeField.Method {
					return ClassTypeField.Method
				}

				if kind.fieldNames.includes(name) {
					return ClassTypeField.Variable
				}
				return null
			case _:
				return null
		}
	}

	/// S3b: true if Dot(base, name) is a fat PAIR access (double slot).
	/// Methods live in the vtable (F6), statics stay thin, dynamic receivers
	/// route via reflection, and inline structs emit single members (their
	/// calls pass the env explicitly instead — see printStructDotCall).
	fun isFatFieldDot(base: Expression, name: String, memberType: Type?): Bool {
		if dotFieldKind(base, name) != ClassTypeField.Variable {
			return false
		}
		return isFatValueType(memberType)
	}

	/// S3b: true if Dot(base, name) is a method (vtable dispatch, never a pair).
	fun isMethodDot(base: Expression, name: String): Bool {
		return dotFieldKind(base, name) == ClassTypeField.Method
	}

	/// S3b: true if the callee is a call through an inline-struct
	/// function-typed field (`entry.isDirectory()` on an `interface {...}`
	/// shape). Structs emit SINGLE members, so these print thin-member +
	/// explicit env instead of pairs (until F10 pair-boxing).
	fun isStructDotCall(e: Expression): Bool { switch e {
			case Dot(base, _, _):
				switch getType(base) {
					case Struct(_, _):
						return isFatValueType(getType(e))
					case _:
				}
			case Parenthesis(inner):
				return isStructDotCall(inner)
			case _:
		}
		return false
	}

	/// S3b: struct-field call shape — thin member + explicit env first arg
	/// (`member_(env, args...)`). Env is the sentinel (struct-held closures
	/// are not pair-tracked until F10).
	fun printStructDotCall(callee: Expression, args: [Expression], derivedExpects: [Type]?): String {
		let envExpr = Expression.Ident('hexaSentinelEnv', project.typer.typeAny)
		var newExpects: [Type]? = null
		if let oe = derivedExpects {
			let ne: [Type] = [project.typer.typeAny]

			for t in oe {
				ne.push(t)
			}
			newExpects = ne
		}
		let newArgs: [Expression] = [envExpr]

		for a in args {
			newArgs.push(a)
		}
		return printExpression(callee) + printCallArguments(newArgs, newExpects)
	}

	/// S3b: effective call kind after the method redirect (unwraps Parenthesis
	/// like the callee classifiers do — IIFE-shaped callees hide the Dot).
	/// Methods typed as non-virtual still dispatch via the vtable.
	fun effCallKind(e: Expression, kind: CallKind): CallKind { switch e {
			case Parenthesis(inner):
				return effCallKind(inner, kind)
			case Dot(base, name, _):
				if kind != CallKind.VirtualMethod, isMethodDot(base, name) {
					return CallKind.VirtualMethod
				}
				return kind
			case _:
				return kind
		} }

	fun isFatCallee(e: Expression): Bool { switch e {
			case Ident(name, _):
				if closureBaseName(e) != null {
					return false
				}
				return isFatValueType(valueType(e))
			case Dot(base, name, _):
				return isFatFieldDot(base, name, getType(e))
			case Parenthesis(inner):
				return isFatCallee(inner)
			case _:
				return false
		} }

	/// S3b: pair call `ptr_(env_, args...)` reusing `printCallArguments` for
	/// the original args (markers/void-drop/pad/conversions intact) and
	/// splicing the env first. `ptr`/`env` are pre-printed C halves.
	fun printFatValueCall(callee: Expression, args: [Expression], expects: [Type]?): String {
		var ptr = ''
		var env = ''

		switch callee {
			case Ident(name, _):
				ptr = name + '$ptr_'
				env = name + '$env_'
			case Dot(expr, dname, _):
				// Function-typed field (Variable, not vtable Method — caller
				// excludes `VirtualMethod`): double slots `->$f_`/`->$e_`.
				// Base printed twice (bases are Ident/This in practice).
				let base = printExpression(expr)
				ptr = base + '->' + dname + '$f_'
				env = base + '->' + dname + '$e_'
			case Parenthesis(inner):
				return printFatValueCall(inner, args, expects)
			case _:
				return '/*UNPAIRED-CALLEE*/' + printExpression(callee) + printCallArguments(args, expects)
		}
		let tail = printCallArguments(args, expects)
		let inner = tail.substring(1, tail.length - 2)

		if inner == '' {
			return ptr + '(' + env + ') '
		}
		return ptr + '(' + env + ', ' + inner + ') '
	}
	fun printClosureFatCall(callee: Expression, args: [Expression], expects: [Type]?): String {
		let base = closureBaseName(callee) as!String
		let fatName = base + '_'
		let suffix = base.substr(8, base.length - 8)
		var envType: Type = project.typer.typeAny
		var envExpr: Expression = Expression.Ident('hexaSentinelEnv', project.typer.typeAny)

		if currentFatFn != null, currentFatFn == base {
			// Self-recursion: thread the current `$env`, not any slot.
			envExpr = Expression.Ident('$env', project.typer.typeAny)
		} else if closureHasEnv(base) {
			// Direct calls use the GLOBAL twin (always in scope; identical to
			// S2 semantics — sequential immediate use stays correct). Pair
			// bindings use the per-instance LOCAL twin where it dominates.
			let envGlobal = 'closureEnv$' + suffix

			if let gt = globalDecls.get(envGlobal) {
				envType = gt
			} else if let it = closureEnvType(base) {
				envType = it
			}
			envExpr = Expression.Ident(envGlobal, envType)
		}
		let origExpects = expectsOrDerived(expects, callee)
		var newExpects: [Type]? = null
		if let oe = origExpects {
			let ne: [Type] = [envType]

			for t in oe {
				ne.push(t)
			}
			newExpects = ne
		}
		let newArgs: [Expression] = [envExpr]

		for a in args {
			newArgs.push(a)
		}
		return fatName + printCallArguments(newArgs, newExpects)
	}

	/// S4 thunk (F10.3, additive dead code until dynamic calls wire it): fixed
	/// ABI `Any_*(void* env, Any** argv, int32 argc)` that unboxes argv with D7
	/// coercions, invokes the fat impl, boxes the result (ARC: args borrowed,
	/// return +1, env borrowed; missing->null-Any/0, extras ignored). Emitted
	/// for every lifted `closure$N` (even empty ones, env ignored) so every
	/// function-typed value is uniformly Any-callable.
	fun printClosureThunk(cName: String, funcType: Type, withEnv: Bool = true, envCast: String = '', skipFirst: Bool = true): String {
		let base = cName.substr(0, cName.length - 1)
		let thunk = base + '$call_'
		var fargs: [FunctionArgument] = []
		var frets: Type = project.typer.typeAny

		switch funcType {
			case Function(fa, fr, _):
				fargs = fa
				frets = fr
		}
		let retName = stringifyType(frets)
		let unboxed: [String] = []
		var ai = 0

		for k in fargs.length {
			// Closures: param 0 is the hidden `env_` the dispatcher supplies.
			// Bare globals have no env param — shift nothing. F10.4 methods:
			// the receiver is NOT part of `funcType` (the C signature
			// prepends it from `thisArgument`), so `skipFirst` is false and
			// every declared arg maps to argv[0..].
			if withEnv and skipFirst and k == 0 {
				continue
			}
			// Hexa rest (`...x: T`) is two C slots `(count, ptr)` — forward
			// the `argv_` tail zero-copy for pointer elems (all Perfide
			// rests are `Any`); scalars get `0, nullptr` (thunks are dead
			// code until F10.3 wires them — must compile, not run).
			switch fargs[k].dataType {
				case Rest(element, native):
					if native {
						continue
					}
					let elemC = stringifyType(element)

					if elemC.endsWith('*') {
						unboxed.push('((argc_ > ' + ai + ') ? (argc_ - ' + ai + ') : 0)')
						unboxed.push('((argc_ > ' + ai + ') ? (' + elemC + '*)(size_t)(argv_ + ' + ai + ') : nullptr)')
					} else {
						unboxed.push('0')
						unboxed.push('nullptr')
					}
					continue
				case _:
			}
			// Fat (function-typed) param = TWO C slots (ptr + env, static ABI).
			// A DYNAMIC caller (the F10.3 pair dispatch) boxes the callback as
			// ONE `FatPair_` argv entry, so both halves are unpacked from it —
			// reading `argv_[ai]` as the code pointer would jump into the pair
			// object. Non-pair payloads degrade to a null callback.
			//
			// F10.5: NEVER raw-cast the pair's impl into the callee's static
			// signature. The boxed closure's own param types are erased to
			// `Any` at the box site, so the callee's typed call would hand it
			// UNBOXED C values (index 0 -> nullptr, doubles -> pointer bits,
			// `Bool_` -> 0/1) and a boxed return would be read as the caller's
			// scalar type. A `dynfat$N_` adapter (one per signature, generated
			// at compile time) boxes the typed args back into the argv ABI and
			// dispatches through `FatPair_.call_` instead.
			if isFatValueType(fargs[k].dataType) {
				let ptrT = stringifyType(fargs[k].dataType)
				let has = '(argc_ > ' + ai + ' && Any_isFatPair_(argv_[' + ai + ']))'
				let adapt = dynFatAdapterName(fargs[k].dataType)

				if adapt != null {
					unboxed.push('(' + ptrT + ')(size_t)(' + has + ' ? (void(*)())(' + (adapt as!String) + ') : (void(*)())nullptr)')
					unboxed.push('(' + has + ' ? (void*)(argv_[' + ai + ']) : (void*)nullptr)')
				} else {
					unboxed.push('(' + ptrT + ')(size_t)(' + has + ' ? ((FatPair_*)(argv_[' + ai + ']))->impl_ : nullptr)')
					unboxed.push('(' + has + ' ? ((FatPair_*)(argv_[' + ai + ']))->env_ : nullptr)')
				}
				ai += 1
				continue
			}
			let ti = stringifyType(fargs[k].dataType)

			if ti == 'void' {
				continue
			}
			var u = ''

			if ti.endsWith('*') {
				u = '(' + ti + ')(size_t)(((argc_ > ' + ai + ') ? argv_[' + ai + '] : nullptr))'
			} else if ti == 'int32_t' {
				u = '((argc_ > ' + ai + ') ? Any_unboxInt_(argv_[' + ai + ']) : (int32_t)0)'
			} else if ti == 'double' or ti == 'float' {
				u = '((argc_ > ' + ai + ') ? Any_unboxFloat_(argv_[' + ai + ']) : (double)0.0)'
			} else if ti == 'Bool_' {
				u = '((argc_ > ' + ai + ') ? (argv_[' + ai + '] )->_toBool() : false_)'
			} else if ti.startsWith('_$') {
				u = '(' + ti + ')(size_t)(((argc_ > ' + ai + ') ? argv_[' + ai + '] : nullptr))'
			} else {
				u = '(' + ti + ')(((argc_ > ' + ai + ') ? Any_unboxInt_(argv_[' + ai + ']) : (' + ti + ')0))'
			}
			unboxed.push(u)
			ai++
		}
		let allArgs: [String] = []

		// Closures take the captured env as their FIRST C parameter; a bare
		// global function takes none (same thunk ABI either way — the
		// dispatcher always passes `env_`, which globals simply ignore).
		// F10.4: a bound METHOD's first C parameter is the typed receiver
		// (`Name_* $this`), not `void*` — C++ has no implicit void*→T*, so
		// the caller names the class in `envCast` and the slot is cast.
		if withEnv {
			if envCast.length > 0 {
				allArgs.push('(' + envCast + '*)self_->env_')
			} else {
				allArgs.push('self_->env_')
			}
		}

		for u in unboxed {
			allArgs.push(u)
		}
		let call = cName + '(' + allArgs.join(', ') + ')'
		// F10.5: the dispatcher passes the PAIR, not the bare env — the
		// `argvapply$N_` adapter needs both halves (`impl_` + `env_`) to
		// reconstruct the statically typed fat value it is adapting.
		var r = 'Any_* ' + thunk + '(struct FatPair_* self_, Any_** argv_, int32_t argc_) \{\n'

		if retName == 'void' {
			r += call + ';\n'
			r += 'return nullptr;\n'
		} else if retName.endsWith('*') {
			r += 'return (Any_*)(size_t)(' + call + ');\n'
		} else if retName == 'int32_t' {
			r += 'return Any_boxInt_(' + call + ');\n'
		} else if retName == 'double' or retName == 'float' {
			r += 'return Any_boxFloat_(' + call + ');\n'
		} else if retName == 'Bool_' {
			r += 'return Any_fromBool(' + call + ');\n'
		} else if retName == 'int64_t' or retName == 'uint64_t' {
			r += 'return Any_boxInt_(' + call + ');\n'
		} else {
			r += 'return (Any_*)(size_t)(' + call + ');\n'
		}
		r += '\}\n\n'
		return r
	}

	/// F10.5: a `FatPair_` carries the argv-ABI thunk of its own impl
	/// (`call_`, chosen at COMPILE time by the box site), so the dynamic-call
	/// slot and the fat-argument unboxing are O(1): dispatch is a single
	/// indirect call through the field, and there is no impl→thunk registry.
	///
	/// `dynfat$N_` is the per-SIGNATURE adapter for the case a raw cast gets
	/// wrong: a DYNAMICALLY boxed pair flowing into a STATICALLY typed fat
	/// slot. The callee calls `impl(env, typed args...)`, so the adapter boxes
	/// those typed args back into the argv ABI and dispatches through
	/// `FatPair_.call_`. Without it the pair's raw impl is cast to the
	/// callee's signature — an ABI lie that delivers UNBOXED values to a
	/// closure whose params stayed `Any` (index 0 arrives as `nullptr`,
	/// floats as pointer bits, `Bool_` as 0/1).
	var dynFatKeys: [String] = []
	var dynFatTypes: [Type] = []

	/// Does one C value of type `t` have a total `Any` box/unbox (the D7 set)?
	/// Nested fat params and `void` do not — they keep the legacy raw cast.
	fun isDynFatSafe(t: Type): Bool {
		switch t {
			case Nullable(inner):
				return isDynFatSafe(inner)
			case Function(_, _):
				return false
			case _:
		}
		let s = stringifyType(t)

		if s == 'Any_*' {
			return true
		}

		if s.endsWith('*') {
			return true
		}

		if s == 'int32_t' or s == 'int64_t' or s == 'uint32_t' or s == 'uint64_t' {
			return true
		}

		if s == 'int16_t' or s == 'int8_t' or s == 'uint16_t' or s == 'uint8_t' {
			return true
		}

		if s == 'double' or s == 'float' or s == 'Bool_' {
			return true
		}

		return false
	}

	/// Whole-signature gate for `dynfat$N_` (params AND return must cross).
	fun isDynFatSignature(t: Type): Bool {
		switch t {
			case Function(args, returns):
				for a in args {
					switch a.dataType {
						case Rest(_, _):
							return false
						case _:
					}

					if not isDynFatSafe(a.dataType) {
						return false
					}
				}
				let rs = stringifyType(returns)

				if rs == 'void' {
					return true
				}
				return isDynFatSafe(returns)
			case _:
				return false
		}
	}

	/// Cache key: the C shapes (never the minted `_$N` typedef — it may not
	/// exist yet when the adapter is requested).
	fun dynFatKey(t: Type): String {
		switch t {
			case Function(args, returns):
				let parts: [String] = []

				for a in args {
					parts.push(stringifyType(a.dataType))
				}
				return parts.join('|') + '->' + stringifyType(returns)
			case _:
				return ''
		}
	}

	/// Name of the adapter for fat type `t` (registers it for emission), or
	/// null when the signature cannot cross the argv ABI.
	fun dynFatAdapterName(t: Type): String? {
		if not isDynFatSignature(t) {
			return null
		}
		let key = dynFatKey(t)

		for i in dynFatKeys.length {
			if dynFatKeys[i] == key {
				return 'dynfat$' + i + '_'
			}
		}
		dynFatKeys.push(key)
		dynFatTypes.push(t)
		return 'dynfat$' + (dynFatKeys.length - 1) + '_'
	}

	/// Register the adapters the thunk bodies printed right after the adapter
	/// section need (`printFatPairGlobalThunks` cannot register its own).
	fun seedDynFat(t: Type) {
		switch t {
			case Function(args, _):
				for a in args {
					if isFatValueType(a.dataType) {
						dynFatAdapterName(a.dataType)
					}
				}
			case _:
		}
	}

	/// Emitted BEFORE the thunk bodies that call the adapters.
	fun printDynFatAdapterDecls(): String {
		for t in fatPairGlobalTypes {
			seedDynFat(t)
		}

		for t in fatPairMethodTypes {
			seedDynFat(t)
		}
		let nl = String.fromCharCode(10)
		var r = ''

		for i in dynFatTypes.length {
			r += 'HEXA_C ' + dynFatSignatureStr(i) + ';' + nl
		}

		for i in argvApplyTypes.length {
			r += 'HEXA_C ' + argvApplySignatureStr(i) + ';' + nl
		}
		return r
	}

	/// Emitted after `printAnyObject` (the adapters need `Any_toBool_`,
	/// `Any_unboxInt_`'s siblings and the counted-defer guards).
	fun printDynFatAdapters(): String {
		var r = ''

		for i in dynFatTypes.length {
			r += printDynFatAdapter(i, dynFatTypes[i])
		}

		for i in argvApplyTypes.length {
			r += printArgvApplyAdapter(i, argvApplyTypes[i])
		}
		return r
	}

	/// C signature of adapter `idx` (shared by the declaration and the body).
	fun dynFatSignatureStr(idx: Int): String {
		var fargs: [FunctionArgument] = []
		var frets: Type = project.typer.typeAny

		switch dynFatTypes[idx] {
			case Function(fa, fr, _):
				fargs = fa
				frets = fr
		}
		var params = 'void* env_'

		for k in fargs.length {
			params += ', ' + stringifyType(fargs[k].dataType) + ' a' + k + '_'
		}
		return stringifyType(frets) + ' dynfat$' + idx + '_(' + params + ')'
	}

	/// Did `printToAnyConverter` mint a fresh box we own (release at exit) or
	/// pass a borrowed pointer/`Any` through (never release)?
	fun isDynFatOwnedBox(t: Type): Bool {
		if t == project.typer.typeAny {
			return false
		}
		let s = stringifyType(t)

		if s.endsWith('*') {
			return false
		}
		return true
	}

	fun printDynFatAdapter(idx: Int, t: Type): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var fargs: [FunctionArgument] = []
		var frets: Type = project.typer.typeAny

		switch t {
			case Function(fa, fr, _):
				fargs = fa
				frets = fr
		}
		let retT = stringifyType(frets)
		var r = 'HEXA_C ' + dynFatSignatureStr(idx) + ' ' + lb + nl
		r += '\tFatPair_* fp_ = (FatPair_*)env_;' + nl
		// No registry: the box site named this pair's `call_` at compile time.
		r += '\tAny_* (*fc_)(struct FatPair_*, Any_**, int32_t) = (fp_ != nullptr) ? fp_->call_ : nullptr;' + nl
		r += '\tHEXA_ASSERT(fp_ == nullptr || fc_ != nullptr, "dynfat: fat pair without a call thunk")' + ';' + nl
		// Box the typed args back into the argv ABI (same hoisting protocol as
		// `printDynamicCall`: struct->bag statements flush first).
		let mb0 = metaBlock.length
		let boxes: [String] = []
		let owned: [Bool] = []

		for k in fargs.length {
			boxes.push(printToAnyConverter('a' + k + '_', fargs[k].dataType))
			owned.push(isDynFatOwnedBox(fargs[k].dataType))
		}
		let setup = metaBlock.slice(mb0, metaBlock.length)

		while metaBlock.length > mb0 {
			metaBlock.pop()
		}

		for s in setup {
			r += '\t' + s + ';' + nl
		}

		var argvUse = 'nullptr'

		if boxes.length > 0 {
			r += '\tAny_* argv_[] = ' + lb + ' ' + boxes.join(', ') + ' ' + rb + ';' + nl
			argvUse = 'argv_'

			for k in boxes.length {
				if owned[k] {
					// We minted the box (index 0 is a HEAP box — `Any_boxInt_`
					// keeps only non-zero small ints as immediates) — release
					// our ownership at exit; borrowed pointers pass through.
					r += '\tHexaDeferCountedDecPtr_ _$dfd' + idx + '_' + k + '((void**)&(argv_[' + k + ']));' + nl
				}
			}
		}

		if retT == 'void' {
			r += '\tif (fc_ != nullptr) fc_(fp_, ' + argvUse + ', ' + fargs.length + ');' + nl
		} else {
			r += '\tAny_* res_ = (fc_ != nullptr) ? fc_(fp_, ' + argvUse + ', ' + fargs.length + ') : nullptr;' + nl
			r += '\treturn ' + printTypeConverter('res_', project.typer.typeAny, frets) + ';' + nl
		}
		r += rb + nl + nl
		return r
	}

	/// F10.5b: the INVERSE adapter. A *stored* fat value (pair var/param, fat
	/// field, interface member, thin wrapper) being boxed into `Any` cannot name
	/// its `$call_` thunk at compile time, so the pair carries this argv-ABI
	/// `self_` is the `FatPair_*` whose `impl_`/`env_` are the
	/// real halves. With one emitted per signature, every box site supplies a
	/// `call_` and the per-signature adapted dispatch needs no impl registry.
	var argvApplyKeys: [String] = []
	var argvApplyTypes: [Type] = []

	fun argvApplyName(t: Type): String? {
		if not isDynFatSignature(t) {
			return null
		}
		let key = dynFatKey(t)

		for i in argvApplyKeys.length {
			if argvApplyKeys[i] == key {
				return 'argvapply$' + i + '_'
			}
		}
		argvApplyKeys.push(key)
		argvApplyTypes.push(t)
		return 'argvapply$' + (argvApplyKeys.length - 1) + '_'
	}

	/// `call_`-shaped signature: no fat typedef involved, so nothing has to be
	/// minted at assembly time (typedefs are printed earlier).
	fun argvApplySignatureStr(idx: Int): String {
		return 'Any_* argvapply$' + idx + '_(struct FatPair_* self_, Any_** argv_, int32_t argc_)'
	}

	/// `Any` -> one C value of type `t` (inverse of `printToAnyConverter`).
	fun unboxAnyToStr(x: String, t: Type): String {
		let s = stringifyType(t)

		if s.endsWith('*') {
			return '(' + s + ')(size_t)(' + x + ')'
		}

		if s == 'Bool_' {
			return 'Any_toBool_(' + x + ')'
		}

		if s == 'int32_t' {
			return 'Any_unboxInt_(' + x + ')'
		}

		if s == 'int64_t' {
			return 'Any_unboxInt64_(' + x + ')'
		}

		if s == 'uint64_t' {
			return '(uint64_t)(Any_unboxInt64_(' + x + '))'
		}

		if s == 'uint32_t' {
			return '((uint32_t)(Any_unboxInt_(' + x + ')))'
		}

		if s == 'int16_t' or s == 'int8_t' or s == 'uint16_t' or s == 'uint8_t' {
			return '((' + s + ')(Any_unboxInt_(' + x + ')))'
		}

		if s == 'float' {
			return '((float)(Any_unboxFloat_(' + x + ')))'
		}
		return 'Any_unboxFloat_(' + x + ')'
	}

	/// Static fat type of `t` as a C function-pointer type (env-first, the
	/// closure ABI), built from parts — never `stringifyType(Function)`.
	fun fatFnTypeStr(t: Type): String {
		var fargs: [FunctionArgument] = []
		var frets: Type = project.typer.typeAny

		switch t {
			case Function(fa, fr, _):
				fargs = fa
				frets = fr
		}
		var params = 'void*'

		for k in fargs.length {
			params += ', ' + stringifyType(fargs[k].dataType)
		}
		return '(' + stringifyType(frets) + ' (' + defaultCallingConvention + '*)(' + params + '))'
	}

	fun printArgvApplyAdapter(idx: Int, t: Type): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var fargs: [FunctionArgument] = []
		var frets: Type = project.typer.typeAny

		switch t {
			case Function(fa, fr, _):
				fargs = fa
				frets = fr
		}
		let retT = stringifyType(frets)
		let callArgs: [String] = ['fp_->env_']

		for k in fargs.length {
			callArgs.push(unboxAnyToStr('((argc_ > ' + k + ') ? argv_[' + k + '] : nullptr)', fargs[k].dataType))
		}
		let call = '(' + fatFnTypeStr(t) + '(size_t)(fp_->impl_))(' + callArgs.join(', ') + ')'
		var r = 'HEXA_C ' + argvApplySignatureStr(idx) + ' ' + lb + nl
		r += '\tFatPair_* fp_ = (FatPair_*)self_;' + nl
		r += '\tif (fp_ == nullptr) return nullptr;' + nl

		if retT == 'void' {
			r += '\t(' + call + ');' + nl
			r += '\treturn nullptr;' + nl
		} else {
			r += '\treturn ' + printToAnyConverter('(' + call + ')', frets) + ';' + nl
		}
		r += rb + nl + nl
		return r
	}

	/// F10.3 fat-pair runtime: a fat value boxed into `Any` becomes a heap
	/// record `{tag, impl, env, call}` (first word is the tag vtable, like
	/// every object). `call_` is the argv-ABI thunk of that exact impl, chosen
	/// at COMPILE time by the box site (`<name>$call_` for a lifted closure /
	/// bound method / bare global, `argvapply$N_` for a stored fat value), so
	/// the dynamic-call slot needs no lookup table at all. ARC: pairs leak like
	/// every other Phase-1 heap object (F11).
	fun printFatPairs(): String {
		let lb = String.fromCharCode(123)
		let rb = String.fromCharCode(125)
		let nl = String.fromCharCode(10)
		var r = '// F10.3 fat-pair boxing (replaces env-dropping `Any` casts)' + nl
		// Structs first (hidden bodies deref them), then hidden impls, then vt.
		r += 'struct FatPair__ ' + lb + ' int32_t (*QueryInterface_)(void*, void*, void**); uint32_t (*AddRef_)(void*); uint32_t (*Release_)(void*); ' + rb + ';' + nl
		r += 'struct FatPair_ ' + lb + ' const struct FatPair__* _; int32_t rc_; void (*impl_)(); void* env_; Any_* (*call_)(struct FatPair_*, Any_**, int32_t); ' + rb + ';' + nl
		r += 'const char* FatPair_hiddenClassName_(void);' + nl
		r += 'Any_* FatPair_hiddenDynGet_(void*, struct String_*);' + nl
		r += 'void FatPair_hiddenDynSet_(void*, struct String_*, Any_*);' + nl
		r += 'uint8_t FatPair_hiddenHas_(void*, struct String_*);' + nl
		r += 'void FatPair_hiddenDelete_(void*, struct String_*);' + nl
		r += 'struct String_* FatPair_hiddenKeyAt_(void*, int32_t);' + nl
		r += 'int32_t FatPair_hiddenKeyCount_(void*);' + nl
		r += 'Any_* FatPair_hiddenIndexGet_(void*, int32_t);' + nl
		r += 'void FatPair_hiddenIndexSet_(void*, int32_t, Any_*);' + nl
		r += 'int32_t FatPair_hiddenIndexCount_(void*);' + nl
		r += 'void FatPair_hiddenReflect_(void*, HexaReflectOp_*);' + nl
		r += 'const char* FatPair_hiddenClassName_(void) ' + lb + ' return "FatPair"; ' + rb + nl
