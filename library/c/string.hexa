	}

	/// Byte size of `chars` units + the terminator (the exact capacity every
	/// interned string owns; `fromUTF16Own` requires it).
	@inline static fun bytesFor(chars: Int): Int { return chars * 2 + 2 }
	// TODO `@inline`

	@inline static fun ptrAdd(ptr: ConstArrayPointer<UInt16>, units: Int): ConstArrayPointer<UInt16> {
		return ((ptr as!UInt64) + ((units * 2) as!UInt64)) as!ConstArrayPointer<UInt16>
	}

	/// Fresh `chars`-unit storage (exactly `bytesFor(chars)`), for
	/// `fromUTF16Own` adoption.
	static fun bufferAlloc(chars: Int): ArrayPointer<UInt16> {
		return malloc(bytesFor(chars) as!UInt64) as!ArrayPointer<UInt16>
	}

	/// Copy `chars` units of `src` into `buf + at`; returns the new offset.
	/// Raw-pointer form on purpose: builders append 3..8 parts without ARC
	/// traffic or temporary arrays.
	static fun appendBytes(buf: ArrayPointer<UInt16>, at: Int, src: ConstArrayPointer<UInt16>, chars: Int): Int {
		if chars <= 0 { return at }
		memcpy(
			(((buf as!UInt64) + ((at * 2) as!UInt64)) as!ArrayPointer<UInt8>),
			src as!ConstArrayPointer<UInt8>,
			chars * 2
		)
		return at + chars
	}

	static fun hashSeed(): UInt64 { return 2166136261u64 }
	// TODO `static let` or just use the pointer to self as a seed

	@inline static fun hashUpdate(h0: UInt64, string: ConstArrayPointer<UInt16>, chars: Int): UInt64 {
		var h: UInt64 = h0

		for i in chars {
			h = (h * 16777619u64) + (string[i] as!UInt64)
		}

		return h
	}

	@inline static fun hashFinish(h: UInt64): Int {
		let folded = h ^ (h >> 16)
		return (folded & 2147483647u64) as!Int
	}

	@inline static fun hashOf(string: ConstArrayPointer<UInt16>, offset: Int, chars: Int): Int {
		return hashFinish(hashUpdate(hashSeed(), ptrAdd(string, offset), chars))
	}

	/// Intern-walk lookup only: the canonical entry for `chars` units at
	/// `src + offset`, or null. No allocation, no linking.
	static fun internLookup(hash: Int, bytesSize: Int, src: ConstArrayPointer<UInt16>, offset: Int, chars: Int): String? {
		let bucket = hash & 65535
		@weak var cursor: String? = stringBuckets[bucket]

		while cursor != null {
			@weak let now = cursor !

			if now.bytesHash == hash and now.bytesLength == bytesSize {
				if memcmp(
					(((src as!UInt64) + ((offset * 2) as!UInt64)) as!ArrayPointer<UInt8>),
					now.bytes as!ConstArrayPointer<UInt8>,
					(chars * 2) as!SizeOfPointer
				) == 0 { return now }
			}

			cursor = now.next
		}
		return null
	}

	static fun internLink(hash: Int, entry: String) {
		let bucket = hash & 65535
		entry.next = stringBuckets[bucket]
		stringBuckets[bucket] = entry
	}

	static fun countUTF8zUpTo(string: ConstArrayPointer<UInt8>, limit: Int): Int {
		// TODO stop at UINT32_MAX or define MAX_STRING_LENGTH
		// var size = 1u32 // TODO starts from 1? Nope, fromUTF16 adds own `\0`
		var i = 0
		// TODO scan 8 bytes at a time
		// NOTE bound BEFORE the load: `string[i] != 0 and i < limit` read one
		// unit past `limit` (the load was evaluated first)
		while i < limit and string[i] != 0 {
			i++
		}
		return i
	}

	// TODO rename z to zero or something or null
	// TODO ConstArrayPointer<UInt8> not same as ConstArrayPointer<UInt8>? ie nullable
	static fun countUTF8z(string: ConstArrayPointer<UInt8>): Int {
		return countUTF8zUpTo(string, defaultLimit)
	}

	static fun fromUTF8z(string: ConstArrayPointer<UInt8>): String {
		// NOTE must use own string length implementation cause incompatible with freestanding targets
		let size: Int = countUTF8z(string)
		// TODO test type check that constructor is private
		// TODO use stack allocated array for small strings or .bss 64k one if size < 64k
		// TODO alloc on stack if size is not that large (64k?)
		// TODO proper UTF convert
		// TODO copy 8 bytes at a time
		let bytes = bufferAlloc(size)
		// TODO proper UTF-8 decode (BMP multi-byte) — this widens Latin-1 only
		for i in size {
			bytes[i] = string[i]
		}
		// TODO transfer size
		// TODO no as!
		free(bytes as!RuntimeAllocated)
		bytes[size] = 0
		return fromUTF16Own(bytes, size)
	}

	static fun countUTF16zUpTo(string: ConstArrayPointer<UInt16>, limit: Int): Int {
		// TODO stop at UINT32_MAX or define MAX_STRING_LENGTH
		// var size = 1u32 // TODO starts from 1? Nope, fromUTF16 adds own `\0`
		var i = 0
		// TODO scan 8 bytes at a time
		while i < limit and string[i] != 0 {
			i++
		}
		return i
	}

	static fun countUTF16z(string: ConstArrayPointer<UInt16>): Int {
		return countUTF16zUpTo(string, defaultLimit)
	}

	// TODO chars: UInt32
	static fun fromUTF16(string: ConstArrayPointer<UInt16>, offset: UInt32, chars: Int): String {
		// TODO replace call `strlen` with `countUTF16z` oh wait it's *8*-bit!
		var hash: Int = 0x1e2caa1f // Just a random number
	/// Interned `String` from `chars` units at `string + offset`. `offset` is
	/// honoured now: slices intern straight out of their parent's storage
	/// (`fromUTF16Slice`) instead of copying through a temp buffer first.
	static fun fromUTF16(string: ConstArrayPointer<UInt16>, offset: Int, chars: Int): String {
		return fromUTF16H(string, offset, chars, hashOf(string, offset, chars))
	}

	/// Same, with the hash supplied by the caller (concat/slice compose the
	/// hash while they already touch the bytes — no second pass over the copy).
	static fun fromUTF16H(string: ConstArrayPointer<UInt16>, offset: Int, chars: Int, hash: Int): String {
		let bytesSize = bytesFor(chars)

		if let found = internLookup(hash, bytesSize, string, offset, chars) { return found }
		let result = new String()
		let storage = malloc(bytesSize as!UInt64) as!ArrayPointer<UInt16>

		if chars > 0 {
			memcpy(
				storage as!ArrayPointer<UInt8>,
				(((string as!UInt64) + ((offset * 2) as!UInt64)) as!ConstArrayPointer<UInt8>),
				chars * 2
			)
		}
		var tail: String? = null
		var cursor: String? = stringBuckets[bucket]

				//if now.bytesHash != hash or now.bytesLength != bytesSize {
				if now.bytesHash != hash, now.bytesLength != bytesSize {
		while true {
			if let now = cursor {
				tail = now
				cursor = now.next
				// Either mismatch short-circuits the bucket slot (hash OR length).
				if now.bytesHash != hash or now.bytesLength != bytesSize {
					continue
				}

				var i = 0
				// TODO scan 8 bytes at a time
				while string[i] == now.bytes[i] and i < chars {
				// Bounds first: content compare must not read past the slice.
				while i < chars and string[i] == now.bytes[i] {
					// TODO syntax `while string[i] == now.bytes[i], i < chars {` + `while let`
					i++
				}

				// TODO type check fails `if not i == chars {`
				if not (i == chars) {
					continue
				}

		storage[chars] = 0
		result.bytes = storage as!ConstArrayPointer<UInt16>
		result.length = chars
		result.bytesLength = bytesSize
		result.bytesHash = hash
		internLink(hash, result)
		return result
	}

		// TODO test type check that constructor is private
		// Produce new string
		var message ArrayByValue<ClangWideChar, 23> = "fromUTF16 new String()"
		// tofitaDebugLog(message.ref, 0, 0) TODO unused `message` must be omitted by normalizer
	/// Zero-copy slice of an interned parent (the `substring`/`slice`/`substr`
	/// workhorse): hashes the parent range and interns from it. Miss → the one
	/// unavoidable copy.
	static fun fromUTF16Slice(parent: String, start: Int, chars: Int): String {
		if chars <= 0 { return '' }

		if start == 0 and chars == parent.length { return parent }
		return fromUTF16(parent.bytes, start, chars)
	}

		// TODO use hexa allocator instead of malloc
		// TODO allocate as `malloc(sizeof String + bytes)` to avoid pointer indirection
		// TODO allocate 8-byte aligned for 8-byte comparison steps
		let bytesStorage = malloc(bytesSize as!UInt64) as!ConstArrayPointer<UInt16>
	/// Takes OWNERSHIP of `buf` (allocated with `bytesFor(chars)`): adopted on
	/// a miss (zero copies — the concat/replace/pad builders write straight
	/// into internable storage), freed on a hit. Saves the second malloc +
	/// memcpy + free that every builder used to pay.
	static fun fromUTF16Own(buf: ArrayPointer<UInt16>, chars: Int): String {
		return fromUTF16OwnH(buf, chars, hashFinish(hashUpdate(hashSeed(), buf as!ConstArrayPointer<UInt16>, chars)))
	}

	// TODO rename H to Hashed
	static fun fromUTF16OwnH(buf: ArrayPointer<UInt16>, chars: Int, hash: Int): String {
		let bytesSize = bytesFor(chars)

		if chars > 0 {
			// TODO respect `offset` !!!
			// TODO copy 4/8 bytes at a time manually
			memcpy(bytes as!ArrayPointer<UInt8>, string as!ConstArrayPointer<UInt8>, chars * 2)
		if let found = internLookup(hash, bytesSize, buf as!ConstArrayPointer<UInt16>, 0, chars) {
			// NOTE owned buffer dealloced when unneeded
			free(buf as!RuntimeAllocated)
			return found
		}
		buf[chars] = 0
		let result = new String()
		result.bytes = buf as!ConstArrayPointer<UInt16>
		result.length = chars
		result.bytesLength = bytesSize
		result.bytesHash = hash
		internLink(hash, result)
		return result
	}

	static fun fromUTF16zUpTo(string: ConstArrayPointer<UInt16>, limit: Int): String {
		// TODO another version that does not require scanning twice
		return fromUTF16(string: string, offset: 0, chars: countUTF16zUpTo(string, limit))
	}

	static fun fromUTF16z(string: ConstArrayPointer<UInt16>): String {
		// TODO another version that does not require scanning twice
		return fromUTF16(string: string, offset: 0, chars: countUTF16z(string))
	}

	// TODO disallow String? + String (i.e. left/this cannot be null)
	// TODO with may be null
	// TODO also add variadic version - do this one variadic (same as JS), and introduce concat2 instead
	fun concat(with: String): String {
		if this.length == 0 { return with }

		if with.length == 0 { return this }
		let length = with.length + this.length
		// FNV is sequential: hashing the two sources in order == hashing the
		// joined result, so the copy never has to be re-scanned.
		let hash = hashFinish(hashUpdate(hashUpdate(hashSeed(), this.bytes, this.length), with.bytes, with.length))

		if length <= 255 {
			var scratch: ArrayByValue<UInt16, 256> = [0]
			let buf = scratch.address as!ArrayPointer<UInt16>
			var o = appendBytes(buf, 0, this.bytes, this.length)
			o = appendBytes(buf, o, with.bytes, with.length)
			return fromUTF16H(buf as!ConstArrayPointer<UInt16>, 0, length, hash)
		}

		let buf = bufferAlloc(length)
		var o = appendBytes(buf, 0, this.bytes, this.length)
		o = appendBytes(buf, o, with.bytes, with.length)
		return fromUTF16OwnH(buf, length, hash)
	}

	// N-ary concat: genC flattens `a + b + c + …` (statically-`String` chains)
	// into ONE call — one allocation, one intern instead of N-1 nested
	// `concat`s where each step copied the whole prefix again.
	// TODO ^ should be done in the proper pass
	static fun concat3(a: String, b: String, c: String): String {
		if a.length == 0 { return b.concat(c) }

		if b.length == 0 { return a.concat(c) }

		if c.length == 0 { return a.concat(b) }
		let total = a.length + b.length + c.length
		let hash = hashFinish(hashUpdate(hashUpdate(hashUpdate(hashSeed(), a.bytes, a.length), b.bytes, b.length), c.bytes, c.length))
		let buf = bufferAlloc(total)
		var o = appendBytes(buf, 0, a.bytes, a.length)
		o = appendBytes(buf, o, b.bytes, b.length)
		o = appendBytes(buf, o, c.bytes, c.length)
		return fromUTF16OwnH(buf, total, hash)
	}

	static fun concat4(a: String, b: String, c: String, d: String): String {
		if a.length == 0 { return concat3(b, c, d) }
		let total = a.length + b.length + c.length + d.length
		let hash = hashFinish(
			hashUpdate(
				hashUpdate(hashUpdate(hashUpdate(hashSeed(), a.bytes, a.length), b.bytes, b.length), c.bytes, c.length),
				d.bytes,
				d.length
			)
		)
		let buf = bufferAlloc(total)
		var o = appendBytes(buf, 0, a.bytes, a.length)
		o = appendBytes(buf, o, b.bytes, b.length)
		o = appendBytes(buf, o, c.bytes, c.length)
		o = appendBytes(buf, o, d.bytes, d.length)
		return fromUTF16OwnH(buf, total, hash)
	}

	static fun concat5(a: String, b: String, c: String, d: String, e: String): String {
		if a.length == 0 { return concat4(b, c, d, e) }
		let total = a.length + b.length + c.length + d.length + e.length
		let hash = hashFinish(
			hashUpdate(
				hashUpdate(
					hashUpdate(hashUpdate(hashUpdate(hashSeed(), a.bytes, a.length), b.bytes, b.length), c.bytes, c.length),
					d.bytes,
					d.length
				),
				e.bytes,
				e.length
			)
		)
		let buf = bufferAlloc(total)
		var o = appendBytes(buf, 0, a.bytes, a.length)
		o = appendBytes(buf, o, b.bytes, b.length)
		o = appendBytes(buf, o, c.bytes, c.length)
		o = appendBytes(buf, o, d.bytes, d.length)
		o = appendBytes(buf, o, e.bytes, e.length)
		return fromUTF16OwnH(buf, total, hash)
	}

	static fun concat6(a: String, b: String, c: String, d: String, e: String, f: String): String {
		if a.length == 0 { return concat5(b, c, d, e, f) }
		let total = a.length + b.length + c.length + d.length + e.length + f.length
		let hash = hashFinish(
			hashUpdate(
				hashUpdate(
					hashUpdate(
						hashUpdate(hashUpdate(hashUpdate(hashSeed(), a.bytes, a.length), b.bytes, b.length), c.bytes, c.length),
						d.bytes,
						d.length
					),
					e.bytes,
					e.length
				),
				f.bytes,
				f.length
			)
		)
		let buf = bufferAlloc(total)
		var o = appendBytes(buf, 0, a.bytes, a.length)
		o = appendBytes(buf, o, b.bytes, b.length)
		o = appendBytes(buf, o, c.bytes, c.length)
		o = appendBytes(buf, o, d.bytes, d.length)
		o = appendBytes(buf, o, e.bytes, e.length)
		o = appendBytes(buf, o, f.bytes, f.length)
		return fromUTF16OwnH(buf, total, hash)
	}

	static fun concat7(a: String, b: String, c: String, d: String, e: String, f: String, g: String): String {
		if a.length == 0 { return concat6(b, c, d, e, f, g) }
		let total = a.length + b.length + c.length + d.length + e.length + f.length + g.length
		let hash = hashFinish(
			hashUpdate(
				hashUpdate(
					hashUpdate(
						hashUpdate(
							hashUpdate(hashUpdate(hashUpdate(hashSeed(), a.bytes, a.length), b.bytes, b.length), c.bytes, c.length),
							d.bytes,
							d.length
						),
						e.bytes,
						e.length
					),
					f.bytes,
					f.length
				),
				g.bytes,
				g.length
			)
		)
		let buf = bufferAlloc(total)
		var o = appendBytes(buf, 0, a.bytes, a.length)
		o = appendBytes(buf, o, b.bytes, b.length)
		o = appendBytes(buf, o, c.bytes, c.length)
		o = appendBytes(buf, o, d.bytes, d.length)
		o = appendBytes(buf, o, e.bytes, e.length)
		o = appendBytes(buf, o, f.bytes, f.length)
		o = appendBytes(buf, o, g.bytes, g.length)
		return fromUTF16OwnH(buf, total, hash)
	}

	static fun concat8(a: String, b: String, c: String, d: String, e: String, f: String, g: String, h: String): String {
		if a.length == 0 { return concat7(b, c, d, e, f, g, h) }
		let total = a.length + b.length + c.length + d.length + e.length + f.length + g.length + h.length
		let hash = hashFinish(
			hashUpdate(
				hashUpdate(
					hashUpdate(
						hashUpdate(
							hashUpdate(
								hashUpdate(hashUpdate(hashUpdate(hashSeed(), a.bytes, a.length), b.bytes, b.length), c.bytes, c.length),
								d.bytes,
								d.length
							),
							e.bytes,
							e.length
						),
						f.bytes,
						f.length
					),
					g.bytes,
					g.length
				),
				h.bytes,
				h.length
			)
		)
		let buf = bufferAlloc(total)
		var o = appendBytes(buf, 0, a.bytes, a.length)
		o = appendBytes(buf, o, b.bytes, b.length)
		o = appendBytes(buf, o, c.bytes, c.length)
		o = appendBytes(buf, o, d.bytes, d.length)
		o = appendBytes(buf, o, e.bytes, e.length)
		o = appendBytes(buf, o, f.bytes, f.length)
		o = appendBytes(buf, o, g.bytes, g.length)
		o = appendBytes(buf, o, h.bytes, h.length)
		return fromUTF16OwnH(buf, total, hash)
	}

	/// Concatenates strings safely
	// TODO gen c simply .concat for known non-null
	// TODO version that supports ArrayPointer<String> for multi-combine
	static fun combine(a: String?, b: String?): String {
		if let a = a, let b = b {
			return a.concat(b)
		}

		if let a = a {
			return a.concat("null")
		}

		if let b = b {
			return "null".concat(b)
		}

		return "null" + "null"
	}

	static fun fromInt32(value: Int): String {
		// TODO just [0, ..., 0] N times
		// NOTE reserves 2 bytes for null-terminator
		// ^ for some reason required despite being UInt16-array
		// TODO ^ test it more, comment/overwrite `bytes[i] = 0` etc
		var bytes: ArrayByValue<UInt16, 12> = [0]
		if value >= 0 and value < 4096 {
			let hit: String? = intCache[value]

		// TODO error on out of bounds limit like `for i in 22` of `bytes`
		// ^ maybe a possibility to runtime check these aka sanitize
		for i in 12 {
			// TODO `for i in bytes.itemsCount` of ArrayByValue
			bytes[i] = 0
			if not (hit == null) { return hit ! }
		}
		// NOTE reserves 2 bytes for null-terminator
		var bytes: ArrayByValue<UInt16, 12> = [0]
		var v = value
		let negative = v < 0

		if negative { v = -v }
		var pos = 11

		while value >= 10 {
			// TODO optimize if non-null value in normalizer? wrap to return 0?
			bytes[pos] = '0'.charCodeAt(0) + (value % 10)
			value = value \ 10
		while v >= 10 {
			pos--
			bytes[pos] = (48 + (v % 10)) as!UInt16
			v = v \ 10
		}

		bytes[pos] = '0'.charCodeAt(0) + (value % 10)
		pos--
		bytes[pos] = (48 + (v % 10)) as!UInt16

		if negative {
			bytes[pos] = '-'.charCodeAt(0)
			pos--
			bytes[pos] = 45
		}
		let chars = 11 - pos
		// Length known — no `countUTF16z` rescan of the digit buffer.
		let result = fromUTF16(bytes.address as!ConstArrayPointer<UInt16>, pos, chars)

		if value >= 0 and value < 4096 { intCache[value] = result }
		return result
	}

	static fun fromInt64(value: Int64): String {
		// TODO reserve 2 bytes for null-terminator? test with non-zero-filled memory
		var bytes: ArrayByValue<UInt16, 21> = [0]

		for i in 21 {
			bytes[i] = 0
		}

		var value = value
		var pos = 20
		let negative = value < 0

		if negative {
			value = -value
		}

		while value >= 10 {
			// TODO optimize if non-null value in normalizer? wrap to return 0?
			bytes[pos] = '0'.charCodeAt(0) + (value % 10)
			value = value \ 10
			pos--
		}

		bytes[pos] = '0'.charCodeAt(0) + (value % 10)
		pos--

		if negative {
			bytes[pos] = '-'.charCodeAt(0)
		} else {
			pos++
		}

		return fromUTF16(bytes.address as!ConstArrayPointer<UInt16>, pos, 21 - pos)
	}

	static fun fromUInt64(value: UInt64): String {
		// Reserve 2 bytes for null-terminator, cause using `fromUTF16z`
		// TODO produces ` = {(uint16_t)((int32_t)0)};` but better just produce `= {0}`
		var bytes: ArrayByValue<UInt16, 22> = [0]

		// TODO This zero-fill is redundant
		for i in 22 {
			bytes[i] = 0
		}

		var value = value
		var pos = 20 // TODO `pos = bytes.length - 1` cause `length` here is compile time known
		let negative = value < 0 // TODO optimize to `true` cause `U` integer

		if negative {
			value = -value
		}

		while value >= 10 {
			// TODO optimize if non-null value in normalizer? wrap to return 0?
			bytes[pos] = '0'.charCodeAt(0) + (value % 10u64)
			value = value \ 10u64
			pos--
		}

		// TODO `% 10` produces `% (int32_t)10` which causes truncation
		bytes[pos] = '0'.charCodeAt(0) + (value % 10u64)
		pos--

		if negative {
			bytes[pos] = '-'.charCodeAt(0)
		} else {
			pos++
		}

		// tofitaDebugLog('fromUInt64 "%S"'.utf16(), bytes.address as! UInt64)
		return fromUTF16(bytes.address as!ConstArrayPointer<UInt16>, pos, 21 - pos)
	}

	static fun fromUInt64n(value: UInt64): String {
		// Reserve 22 elements, including null terminator
		var bytes: ArrayByValue<UInt16, 22> = [0]

		// TODO This zero-fill is redundant
		for i in 22 {
			bytes[i] = 0
		}

		var value = value
		var pos = 20

		// Handle zero explicitly
		if value == 0 {
			bytes[20] = '0'.charCodeAt(0)
			pos = 20
		} else {
			// Convert digits from right to left
			while value > 0 {
				bytes[pos] = '0'.charCodeAt(0) + (value % 10)
				value = value \ 10
				pos--
			}
			pos++ // Point to the first digit
		}

		// Ensure null terminator
		bytes[21] = 0

		return fromUTF16(bytes.address as!ConstArrayPointer<UInt16>, pos, 21 - pos)
	}

	// Decimal form: specials, plain notation in [1e-6, 2e9), exponent otherwise
	// (shortest-round-trip digits land with the formatting runtime — later)
	static fun fromFloat(value: Float): String {
		if value != value { return 'NaN' }

		if value == infinity { return 'Infinity' }

		if value == 0.0 - infinity { return '-Infinity' }

		if value == 0.0 { return '0' }
		var v = value
		var out = ''

		if v < 0.0 {
			out = '-'
			v = 0.0 - v
		}

		// Range select with nested ifs only (no `and`/`or` combinators).
		var useExp = false

		if v >= 2000000000.0 {
			useExp = true
		} else {
			if v < 0.000001 {
				if v > 0.0 { useExp = true }
			}
		}

		if useExp {
			var exp = 0

			while v >= 10.0 {
				v = v / 10.0
				exp++
			}

			while v < 1.0 {
				v = v * 10.0
				exp--
			}
			// 6 significant digits via single rounding (JS-style within this
			// precision; no endsWith trim anywhere in this function).
			let d0 = Math.floor(v)
			var rest = Math.floor((v - d0) * 100000.0 + 0.5)
			var dd = d0

			if rest >= 100000 {
				dd = dd + 1
				rest = 0

				if dd >= 10 {
					dd = 1
					exp++
				}
			}
			var expSign = ''
			var expAbs = exp

			if exp < 0 {
				expSign = '-'
				expAbs = 0 - exp
			}

			if rest == 0 {
				return out + String.fromInt32(dd) + 'e' + expSign + String.fromInt32(expAbs)
			}
			var rwidth = 5

			while rest % 10 == 0 {
				rest = rest \ 10
				rwidth--
			}
			var rdigits = String.fromInt32(rest)

			while rdigits.length < rwidth { rdigits = '0' + rdigits }
			return out + String.fromInt32(dd) + '.' + rdigits + 'e' + expSign + String.fromInt32(expAbs)
		}
		let ip = Math.floor(v)
		// Single rounding to 6 fractional digits, trim done arithmetically.
		// The old per-digit loop plus endsWith string trim turned 0.05 into
		// "0.0" on the C target (fBg/f05 probes); this path avoids endsWith,
		// `and`/`or` and byte indexing entirely.
		var scaled = Math.floor((v - ip) * 1000000.0 + 0.5)

		if scaled >= 1000000 {
			return out + String.fromInt32(ip + 1)
		}

		if scaled == 0 {
			return out + String.fromInt32(ip)
		}
		var width = 6

		while scaled % 10 == 0 {
			scaled = scaled \ 10
			width--
		}
		// Exactly `width` digits, leading zeros kept via explicit pad.
		var rev = ''
		var tmp = scaled

		for k in width {
			rev = rev + String.fromInt32(tmp % 10)
			tmp = tmp \ 10
		}
		var digits = ''

		for k in rev.length {
			digits = digits + rev.substring(rev.length - 1 - k, rev.length - k)
		}
		return out + String.fromInt32(ip) + '.' + digits
	}

	static fun fromNullableInt32(value: Int?): String {
		if let value = value {
			return fromInt32(value)
		}

		return 'null'
	}

	// NOTE `Bool?` nullable wrapping is zero-cost in Hexa, no boxing happens, boolean is tri-state plain integer
	static fun fromBool(value: Bool?): String {
		if value == false {
			return 'false'
		}

		if value == true {
			return 'true'
		}

		return 'null'
	}

	// ARC destructor (called by the sweep before freeing): unlinks this entry
	// from the intern bucket and frees the copied bytes. Unlinks by buffer
	// identity (every String owns its bytes buffer exclusively), never by
	// content: a content match on a different object must not unlink a live
	// interned twin while this entry leaks. Unmapped entries simply free
	// their own bytes and leave buckets untouched (leak-safe).
	@destructor fun destroy() {
		// TODO is `%` operation too slow? use first 16 bits?
		let bucket = bytesHash & 65535
		let selfAddr = bytes as!UInt64
		var prev: String? = null
		var cursor: String? = stringBuckets[bucket]

		// NOTE the depth of the buckets is genrally is very low so this traversal is not perf issue
		while true {
			// TODO @weak?
			if let now = cursor {
				if now.bytes as!UInt64 == selfAddr {
					if let p = prev {
						p.next = now.next
					} else {
						stringBuckets[bucket] = now.next
					}
					free(bytes as!RuntimeAllocated)
					return
				}
				prev = now
				cursor = now.next
			} else {
				free(bytes as!RuntimeAllocated)
				return
			}
		}
	}
}
