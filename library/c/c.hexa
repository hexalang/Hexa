// C math (math.h ships with the native prologue) — thin scalar declares
@rename('sin') declare fun cSin(v: Float): Float
@rename('cos') declare fun cCos(v: Float): Float
@rename('tan') declare fun cTan(v: Float): Float
@rename('asin') declare fun cAsin(v: Float): Float
@rename('acos') declare fun cAcos(v: Float): Float
@rename('atan') declare fun cAtan(v: Float): Float
@rename('atan2') declare fun cAtan2(y: Float, x: Float): Float
@rename('exp') declare fun cExp(v: Float): Float
@rename('log') declare fun cLog(v: Float): Float
@rename('pow') declare fun cPow(base: Float, exp: Float): Float
@rename('sqrt') declare fun cSqrt(v: Float): Float
@rename('floor') declare fun cFloor(v: Float): Float
@rename('ceil') declare fun cCeil(v: Float): Float
@rename('fabs') declare fun cFabs(v: Float): Float
@rename('fmod') declare fun cFmod(a: Float, b: Float): Float
@rename('rand') declare fun cRand(): Int
@rename('srand') declare fun cSrand(seed: UInt32): Void
// CRT-rand seed flag (module state for Math.random) — declared before the
// class: static method bodies are typed at class registration, ahead of
// later module-level vars.
var mathRandSeeded Bool = false
class Math {
	static fun abs(v: Float): Float {
		if v < 0.0 { return 0.0 - v }
		return v
	}
	static fun acos(v: Float): Float { return cAcos(v) }
	static fun asin(v: Float): Float { return cAsin(v) }
	static fun atan(v: Float): Float { return cAtan(v) }
	static fun atan2(y: Float, x: Float): Float { return cAtan2(y, x) }
	static fun ceil(v: Float): Int { return cCeil(v) as!Int }
	static fun cos(v: Float): Float { return cCos(v) }
	static fun exp(v: Float): Float { return cExp(v) }
	static fun floor(v: Float): Int { return cFloor(v) as!Int }
	static fun log(v: Float): Float { return cLog(v) }
	static fun max(a: Float, b: Float): Float {
		return a > b ? a : b
	}
	static fun min(a: Float, b: Float): Float {
		return a < b ? a : b
	}
	static fun pow(v: Float, exp: Float): Float { return cPow(v, exp) }
	// rand()/srand() from the CRT, seeded once off the tick clock
	static fun random(): Float {
		if not mathRandSeeded {
			mathRandSeeded = true
			cSrand(hexaTickMs() as!UInt32)
		}
		return (cRand() as!Float) / 32767.0
	}

	static fun round(value: Float): Int {
		return (value >= 0) ? ((value) + 0.5) as!Int : ((value) - 0.5) as!Int
	}

	static fun sin(v: Float): Float { return 0 }

	static fun sqrt(value: Float): Float {
		let number: Float32 = value as!Float32 // TODO `Float` version
		let threeHalfs: Float32 = 1.55555f32
		let threeHalfs: Float32 = 1.5f32

		var x2: Float32 = number * 0.5f32
		var y: Float32 = number

		var y: ArrayByValue<Float32, 1> = [y]

		// Floating point bit level hacking [sic]
		var i: Int32 = (y as!ArrayPointer<Int32>)[0]
		i = 0x5f3759df - (i >> 1) // Newton's approximation

		var i: ArrayByValue<Int32, 1> = [i]

		var y = (i as!ArrayPointer<Float32>)[0]
		y = y * (threeHalfs - (x2 * y * y)) // 1st iteration
		y = y * (threeHalfs - (x2 * y * y)) // 2nd iteration
		y = y * (threeHalfs - (x2 * y * y)) // 3rd iteration

		return 1.0f32 / y
	}

	static fun tan(v: Float): Float { return 0 }
// Lenient recursive-descent JSON (single-pass reader; malformed input bails
// with the value parsed so far instead of throwing — recovery lands later)
class JsonReader {
	var s: String
	var pos: Int
	new (text: String) {
		this.s = text
		this.pos = 0
	}
	fun skipWs(): Void {
		while pos < s.length {
			if let c = s.charCodeAt(pos) {
				if c == 32 or c == 9 or c == 10 or c == 13 { pos++ } else { break }
			} else { break }
		}
	}
	fun parseValue(): Any {
		skipWs()
		if let c = s.charCodeAt(pos) {
			if c == 123 { return parseObject() }
			if c == 91 { return parseArray() }
			if c == 34 { return parseString() }
			if c == 116 { return parseLiteral('true', true) }
			if c == 102 { return parseLiteral('false', false) }
			if c == 110 { return parseLiteral('null', null) }
			return parseNumber()
		}
		return null
	}
	fun parseObject(): Any {
		// F10.2: objects parse to plain bags (AnyObject), matching the JS
		// `JSON.parse` shape (plain objects, not Maps) so `parsed.field`
		// reads work through the same dynamic path as object literals.
		let obj Any = anyObjectNew()
		pos++
		skipWs()
		if let c = s.charCodeAt(pos) {
			if c == 125 {
				pos++
				return obj
			}
		}
		while true {
			skipWs()
			if let c = s.charCodeAt(pos) {
				if c != 34 { break }
			} else { break }
			let key = parseString()
			skipWs()
			if let c = s.charCodeAt(pos) {
				if c == 58 { pos++ }
			}
			anyObjectSet(obj, key, parseValue())
			skipWs()
			if let c = s.charCodeAt(pos) {
				if c == 44 {
					pos++
					continue
				}
				if c == 125 {
					pos++
					break
				}
				break
			} else { break }
		}
		return obj
	}
	fun parseArray(): Any {
		let arr [Any] = []
		pos++
		skipWs()
		if let c = s.charCodeAt(pos) {
			if c == 93 {
				pos++
				return arr
			}
		}
		while true {
			arr.push(parseValue())
			skipWs()
			if let c = s.charCodeAt(pos) {
				if c == 44 {
					pos++
					continue
				}
				if c == 93 {
					pos++
					break
				}
				break
			} else { break }
		}
		return arr
	}
	fun parseHex4(at: Int): Int {
		var v = 0
		for k in 4 {
			if let c = s.charCodeAt(at + k) {
				let d = hexValueOf(c)
				if d < 0 { return 0 - 1 }
				v = v * 16 + d
			} else { return 0 - 1 }
		}
		return v
	}
	fun parseString(): String {
		pos++
		var out = ''
		while pos < s.length {
			if let c = s.charCodeAt(pos) {
				if c == 34 {
					pos++
					break
				}
				if c == 92 {
					pos++
					if let e = s.charCodeAt(pos) {
						if e == 34 {
							out = out + '"'
							pos++
						} else if e == 92 {
							out = out + '\\'
							pos++
						} else if e == 47 {
							out = out + '/'
							pos++
						} else if e == 98 {
							out = out + String.fromCharCode(8)
							pos++
						} else if e == 102 {
							out = out + String.fromCharCode(12)
							pos++
						} else if e == 110 {
							out = out + String.fromCharCode(10)
							pos++
						} else if e == 114 {
							out = out + String.fromCharCode(13)
							pos++
						} else if e == 116 {
							out = out + String.fromCharCode(9)
							pos++
						} else if e == 117 {
							let h = parseHex4(pos + 1)
							if h < 0 {
								out = out + 'u'
								pos++
							} else {
								pos = pos + 5
								if h >= 55296 and h <= 56319 {
									if let b1 = s.charCodeAt(pos) {
										if b1 == 92 {
											if let b2 = s.charCodeAt(pos + 1) {
												if b2 == 117 {
													let lo = parseHex4(pos + 2)
													if lo >= 56320 and lo <= 57343 {
														out = out + String.fromCharCode(h) + String.fromCharCode(lo)
														pos = pos + 6
													} else { out = out + String.fromCharCode(h) }
												} else { out = out + String.fromCharCode(h) }
											} else { out = out + String.fromCharCode(h) }
										} else { out = out + String.fromCharCode(h) }
									} else { out = out + String.fromCharCode(h) }
								} else { out = out + String.fromCharCode(h) }
							}
						} else {
							out = out + String.fromCharCode(e)
							pos++
						}
					} else { break }
				} else {
					out = out + String.fromCharCode(c)
					pos++
				}
			} else { break }
		}
		return out
	}
	fun parseLiteral(word: String, value: Any): Any {
		if s.substring(pos, pos + word.length) == word { pos = pos + word.length }
		return value
	}
	fun parseNumber(): Any {
		var neg = false
		if let c = s.charCodeAt(pos) {
			if c == 45 {
				neg = true
				pos++
			}
		}
		var v = 0.0
		while pos < s.length {
			if let c = s.charCodeAt(pos) {
				if c >= 48 and c <= 57 {
					v = v * 10.0 + (c - 48)
					pos++
				} else { break }
			} else { break }
		}
		if let c = s.charCodeAt(pos) {
			if c == 46 {
				pos++
				var scale = 1.0
				while pos < s.length {
					if let d = s.charCodeAt(pos) {
						if d >= 48 and d <= 57 {
							v = v * 10.0 + (d - 48)
							scale = scale * 10.0
							pos++
						} else { break }
					} else { break }
				}
				v = v / scale
			}
		}
		if let c = s.charCodeAt(pos) {
			if c == 69 or c == 101 {
				pos++
				var expSign = 1
				if let q = s.charCodeAt(pos) {
					if q == 43 { pos++ } else if q == 45 {
						expSign = 0 - 1
						pos++
					}
				}
				var expVal = 0
				var expAny = false
				while pos < s.length {
					if let d = s.charCodeAt(pos) {
						if d >= 48 and d <= 57 {
							expVal = expVal * 10 + (d - 48)
							expAny = true
							pos++
						} else { break }
					} else { break }
				}
				if expAny {
					let mag = cPow(10.0, expVal as!Float)
					if expSign > 0 { v = v * mag } else { v = v / mag }
				}
			}
		}
		if neg { v = 0.0 - v }
		return v
	}
}
// JSON string escaping (control chars → short or \u00XX forms)
fun jsonEscape(s: String): String {
	var out = '"'
	for i in s.length {
		if let c = s.charCodeAt(i) {
			if c == 34 { out = out + '"' } else if c == 92 { out = out + '\\\\' } else if c == 10 { out = out + '\\n' } else if c == 13 { out = out + '\\r' } else if c == 9 { out = out + '\\	' } else if c == 8 { out = out + '\\b' } else if c == 12 { out = out + '\\f' } else if c < 32 { out = out + '\\u00' + hexDigitUpper(c \ 16) + hexDigitUpper(c % 16) } else { out = out + String.fromCharCode(c) }
		}
	}
	return out + '"'
}
// Gap repeated per depth (pretty indent unit)
fun jsonIndent(gap: String, depth: Int): String {
	var out = ''
	for k in depth { out = out + gap }
	return out
}
// F10.2: enumerate an AnyObject bag's keys (insertion order) for JSON.
fun anyObjectKeys(v: Any): [String] {
	var out [String] = []
	var n Int = anyObjectCount(v)
	for i in n { out.push(anyObjectKeyAt(v, i)) }
	return out
}
fun stringifyInner(value: Any, replacer: (Any, Any) => Any?, gap: String, depth: Int, key: String): String {
	var v Any = value
	if replacer != null {
		if let rep = replacer { v = rep(key, value) }
	}
	if v == null { return 'null' }
	if v is Bool {
		if let b = v as!Bool { return String.fromBool(b) }
		return 'null'
	}
	if v is Int {
		if let n = v as!Int { return String.fromInt32(n) }
		return 'null'
	}
	if v is Float {
		if let f = v as!Float { return String.fromFloat(f) }
		return 'null'
	}
	if v is String {
		if let st = v as!String { return jsonEscape(st) }
		return 'null'
	}
	// Depth guard against circular graphs (real cycle errors land later)
	if depth > 100 { return 'null' }
	if v is Array<Any> {
		if let arr = v as!Array<Any> {
			if arr.length == 0 { return '[]' }
			if gap.length == 0 {
				var out = '['
				for i in arr.length {
					if i > 0 { out = out + ',' }
					out = out + stringifyInner(arr[i], replacer, gap, depth + 1, String.fromInt32(i))
				}
				return out + ']'
			}
			let pad = jsonIndent(gap, depth + 1)
			let close = jsonIndent(gap, depth)
			var out = '[\n' + pad
			for i in arr.length {
				if i > 0 { out = out + ',\n' + pad }
				out = out + stringifyInner(arr[i], replacer, gap, depth + 1, String.fromInt32(i))
			}
			return out + '\n' + close + ']'
		}
		return '[]'
	}
	if v is Map<String, Any> {
		if let obj = v as!Map<String, Any> {
			let keys = obj.keys()
			if keys.length == 0 { return '\{\}' }
			if gap.length == 0 {
				var out = '\{'
				var first = true
				for i in keys.length {
					let k = keys[i]
					if let prop = obj.get(k) {
						if not first { out = out + ',' }
						first = false
						out = out + jsonEscape(k) + ':' + stringifyInner(prop, replacer, gap, depth + 1, k)
					}
				}
				return out + '\}'
			}
			let pad = jsonIndent(gap, depth + 1)
			let close = jsonIndent(gap, depth)
			var out = '\{\n' + pad
			var first = true
			for i in keys.length {
				let k = keys[i]
				if let prop = obj.get(k) {
					if not first { out = out + ',\n' + pad }
					first = false
					out = out + jsonEscape(k) + ': ' + stringifyInner(prop, replacer, gap, depth + 1, k)
				}
			}
			return out + '\n' + close + '\}'
		}
		return '\{\}'
	}
	// Class instances / externals: placeholder (shape reflection lands in F10)
	// F10.2: plain-object bags (AnyObject) stringify like JS objects. Null
	// values read back as missing (same as the Map branch above — matches
	// the `if let` filter there; explicit-null preservation is queued).
	if anyIsObject(v) {
		let keys = anyObjectKeys(v)
		if keys.length == 0 { return String.fromCharCode(123) + String.fromCharCode(125) }
		if gap.length == 0 {
			var out = String.fromCharCode(123)
			var first = true
			for i in keys.length {
				let k = keys[i]
				if let prop = anyObjectGet(v, k) {
					if not first { out = out + ',' }
					first = false
					out = out + jsonEscape(k) + ':' + stringifyInner(prop, replacer, gap, depth + 1, k)
				}
			}
			return out + String.fromCharCode(125)
		}
		let pad = jsonIndent(gap, depth + 1)
		let close = jsonIndent(gap, depth)
		var out = String.fromCharCode(123) + String.fromCharCode(10) + pad
		var first = true
		for i in keys.length {
			let k = keys[i]
			if let prop = anyObjectGet(v, k) {
				if not first { out = out + ',' + String.fromCharCode(10) + pad }
				first = false
				out = out + jsonEscape(k) + ': ' + stringifyInner(prop, replacer, gap, depth + 1, k)
			}
		}
		return out + String.fromCharCode(10) + close + String.fromCharCode(125)
	}
	return '\{\}'
}

class JSON {
	static fun parse(text: String): Any { return null }
	static fun stringify(value: Any, replacer: (Any, Any) => Any?, space: String?): String { return '' }
	static fun parse(text: String): Any {
		let r = JsonReader(text)
		return r.parseValue()
	}
	static fun stringify(value: Any, replacer: (Any, Any) => Any? = null, space: String? = null): String {
		var gap = ''
		if let sp = space { gap = sp }
		return stringifyInner(value, replacer, gap, 0, '')
	}
}

@rename('FILE *')
declare
class FILE { }
@rename('stdin') declare let stdin: FILE
@rename('stdout') declare let stdout: FILE
@rename('fflush') declare fun fflush(port: FILE): Void
@rename('printf') declare fun printf(text: ConstArrayPointer<ClangChar>): Void
@rename('wprintf') declare fun wprintf(text: ConstArrayPointer<ClangWideChar>,...data: Any): Void
@rename('HEXA_TRACE') declare fun trace(text: ConstArrayPointer<ClangWideChar>): Void
@rename('HEXA_TRACE') declare fun traceLine(text: ConstArrayPointer<ClangWideChar>): Void
@rename('putchar') declare fun putchar(char: Int): Void
@dllImport('RtlZeroMemory') declare fun zeroMemory(destination: ArrayPointer<UInt8>, bytes: UInt32): Void
// @rename('wprintf') declare fun wprintf(text: ConstArrayPointer<UInt8>): Void

/*
	#if linux
	@include('#include <stdio.h>', '#include <stdlib.h>')
	@link('-lc')
	#elseif windows
	@importDLL('ntdll.dll')
	#end
	module stdio {

	}

	or...

	/linux/stdio.hexa
	module stdio {}
*/
@final
// TODO ^ make `.log` calls non-virtual
class Console {
	new () { }

	@nativeVariadic
	// fun log(str: Any): Void {
	fun log(any: Any,...args): Void {
	}

	fun trace(message: String): Void {
		// logString(message)
		// TODO trace lines of Hexa code, not only generated
		// TODO lmao how to access module-level `trace` here?
		// ^ at the module level add `private let module = this`
		// `this.class.module.trace` and `class.module.trace`
		traceLine(message.utf16())
	}

	fun logString(str: String): Void {
		wprintf("%s\r\n".utf16(), str.bytes)
		// TODO test in POSIX example var buffer: ArrayByValue<UInt8, 6> = [
		// '%'.charCodeAt(0), 'l'.charCodeAt(0), 's'.charCodeAt(0), 13, 10, 0
		// ]
		// printf(buffer as! ConstArrayPointer<ClangChar>, str.bytes)
		// putchar(13)
		fflush(stdout)
	}
	fun error(data: Any, message: Any?): Void { }
	// Hexa rest (count+ptr) — body iterates, so NOT @nativeVariadic.
	fun error(...message: Any?): Void {
		var out = ''
		for m in message { out = out + anyToString(m) + ' ' }
		logString(out.trim())
	}
	// Hexa rest (count+ptr) — body iterates, so NOT @nativeVariadic.
	fun warn(...message: Any?): Void {
		var out = ''
		for m in message { out = out + anyToString(m) + ' ' }
		logString(out.trim())
	}
	// Hexa rest (count+ptr) — body iterates, so NOT @nativeVariadic.
	fun info(...message: Any?): Void {
		var out = ''
		for m in message { out = out + anyToString(m) + ' ' }
		logString(out.trim())
	}
	fun dir(value: Any?): Void { logString(stringifyInner(value, null, '', 0, '')) }
	fun time(label: String? = 'default'): Void {
		var key = 'default'
		if let l = label { key = l }
		// Explicit box: vtable `set_` calls skip expects-conversion (genC gap).
		consoleTimers.set(key, hexaWallMs() as!Any)
	}
	fun timeEnd(label: String? = 'default'): Void {
		var key = 'default'
		if let l = label { key = l }
		let start = consoleTimers.get(key)
		if start == null {
			logString('Timer "' + key + '" does not exist')
			return
		}
		if let s = start {
			// `start` is boxed Any (scalar-V Maps don't compile on native) —
			// unbox to Float for the arithmetic (js-identical, dynamic there).
			// `+`-combine (not `.toString()` on the Binop) so the scalar
			// converts via String_$fromFloat_ (genC gap on Binop receivers).
			logString(key + ': ' + (hexaWallMs() - (s as!Float)) + 'ms')
		}
		consoleTimers.delete(key)
	}
	fun table(value: Any?): Void { logString(stringifyInner(value, null, '', 0, '')) }
	fun count(label: String? = 'default'): Void {
		var key = 'default'
		if let l = label { key = l }
		var n = 1
		let cur = consoleCounters.get(key)
		if cur != null {
			if let c = cur { n = c + 1 }
		}
		consoleCounters.set(key, n)
		logString(key + ': ' + n.toString())
	}
	// Hexa rest (count+ptr) — body iterates, so NOT @nativeVariadic.
	fun group(...label: Any?): Void {
		var out = ''
		for m in label { out = out + anyToString(m) + ' ' }
		if out.length > 0 { logString(out.trim()) }
		consoleGroupDepth = consoleGroupDepth + 1
	}
	fun groupEnd(): Void {
		if consoleGroupDepth > 0 { consoleGroupDepth = consoleGroupDepth - 1 }
	}
	// Hexa rest (count+ptr) — body iterates, so NOT @nativeVariadic.
	fun assert(condition: Bool,...message: Any?): Void {
		if condition { return }
		var out = 'Assertion failed'
		var extra = ''
		for m in message { extra = extra + anyToString(m) + ' ' }
		if extra.length > 0 { out = out + ': ' + extra.trim() }
		logString(out)
		throw Error(out)
	}
	fun clear(): Void { }
}

// Timestamps box as Any — `Map<String, Float>` would instantiate a scalar-V
// template that native codegen can't compile (F2 debt); Any is js-identical.
var consoleTimers Map<String, Any> = Map<String, Any>()
var consoleCounters Map<String, Int> = Map<String, Int>()
var consoleGroupDepth Int = 0

let console: Console = new Console()

class InternalArray { }
class IntArray extends InternalArray { }
class StringArray extends InternalArray { }
class FloatArray extends InternalArray { }
class ObjectArray<T> extends InternalArray { }
// TODO declare Array<T> = arrayType(T)

// Date — real proleptic-Gregorian calendar math over the Win32 wall clock.
// Howard Hinnant's days_from_civil / civil_from_days (overflow-normalizing,
// so setDate(32)/setHours(25) roll over exactly like Node).
fun floorDivNum(a: Int, b: Int): Int {
	return Math.floor((a as!Float) / (b as!Float))
}
// Day algebra over Float epoch-ms (`%` on Floats is unverified — floor only).
fun daysOf(ms: Float): Int { return Math.floor(ms / 86400000.0) }
fun dayMsOf(ms: Float): Int {
	let d = Math.floor(ms / 86400000.0)
	return (ms - (d as!Float) * 86400000.0) as!Int
}
fun dateDaysFromCivil(y: Int, m: Int, d: Int): Int {
	var yy = y + floorDivNum(m - 1, 12)
	let mm = ((m - 1) % 12 + 12) % 12 + 1
	if mm <= 2 { yy = yy - 1 }
	let era = yy >= 0 ? yy \ 400 : floorDivNum(yy - 399, 400)
	let yoe = yy - era * 400
	let mp = (mm + 9) % 12
	let doy = (153 * mp + 2) \ 5 + d - 1
	let doe = yoe * 365 + yoe \ 4 - yoe \ 100 + doy
	return era * 146097 + doe - 719468
}
class DateParts {
	var y: Int = 1970
	var m: Int = 1
	var d: Int = 1
	new (y: Int, m: Int, d: Int) {
		this.y = y
		this.m = m
		this.d = d
	}
}
fun datePartsFromDays(z: Int): DateParts {
	let zz = z + 719468
	let era = floorDivNum(zz, 146097)
	let doe = zz - era * 146097
	let yoe = (doe - doe \ 1460 + doe \ 36524 - doe \ 146096) \ 365
	var y = yoe + era * 400
	let doy = doe - (365 * yoe + yoe \ 4 - yoe \ 100)
	let mp = (5 * doy + 2) \ 5
	let d = doy - (153 * mp + 2) \ 5 + 1
	var m = mp + 3
	if mp >= 10 { m = mp - 9 y = y + 1 }
	return DateParts(y, m, d)
}
fun datePad2(n: Int): String {
	if n < 0 or n > 99 { return n.toString() }
	if n < 10 { return '0' + n.toString() }
	return n.toString()
}
fun datePad3(n: Int): String {
	if n < 0 or n > 999 { return n.toString() }
	if n < 10 { return '00' + n.toString() }
	if n < 100 { return '0' + n.toString() }
	return n.toString()
}
fun dateWeekdayName(dow: Int): String {
	if dow == 0 { return 'Sun' }
	if dow == 1 { return 'Mon' }
	if dow == 2 { return 'Tue' }
	if dow == 3 { return 'Wed' }
	if dow == 4 { return 'Thu' }
	if dow == 5 { return 'Fri' }
	return 'Sat'
}
fun dateMonthName(mo: Int): String {
	if mo == 1 { return 'Jan' }
	if mo == 2 { return 'Feb' }
	if mo == 3 { return 'Mar' }
	if mo == 4 { return 'Apr' }
	if mo == 5 { return 'May' }
	if mo == 6 { return 'Jun' }
	if mo == 7 { return 'Jul' }
	if mo == 8 { return 'Aug' }
	if mo == 9 { return 'Sep' }
	if mo == 10 { return 'Oct' }
	if mo == 11 { return 'Nov' }
	return 'Dec'
}
class Date {
	var timeMs: Float = 0
	new (time: Float? = null) {
		if let t = time {
			timeMs = t
		} else {
			timeMs = hexaWallMs()
		}
	}
	// Unix-epoch ms (FILETIME math in the win32 shim)
	static fun now(): Float { return hexaWallMs() }
	static fun parse(dateString: String): Float { return dateParseIso(dateString) }
	static fun utc(year: Int, monthIndex: Int, day: Int? = 1, hours: Int? = 0, minutes: Int? = 0, seconds: Int? = 0, milliseconds: Int? = 0): Float {
		return dateMakeMs(year, monthIndex + 1, day ?? 1, hours ?? 0, minutes ?? 0, seconds ?? 0, milliseconds ?? 0, true)
	}
	fun getTime(): Float { return timeMs }
	fun valueOf(): Float { return timeMs }
	// Bias minutes to add to local wall time to get UTC (see win32.hexa).
	fun getTimezoneOffset(): Int { return winTimezoneBiasMinutes() }
	fun localMs(): Float { return timeMs - (getTimezoneOffset() as!Float) * 60000.0 }
	fun partsLocal(): DateParts { return datePartsFromDays(daysOf(localMs())) }
	fun partsUtc(): DateParts { return datePartsFromDays(daysOf(timeMs)) }
	fun clockLocal(): [Int] {
		let dayMs = dayMsOf(localMs())
		return [dayMs \ 3600000, (dayMs \ 60000) % 60, (dayMs \ 1000) % 60, dayMs % 1000]
	}
	fun clockUtc(): [Int] {
		let dayMs = dayMsOf(timeMs)
		return [dayMs \ 3600000, (dayMs \ 60000) % 60, (dayMs \ 1000) % 60, dayMs % 1000]
	}
	fun weekdayLocal(): Int {
		return ((daysOf(localMs()) + 4) % 7 + 7) % 7
	}
	fun getFullYear(): Int { return partsLocal().y }
	fun getMonth(): Int { return partsLocal().m - 1 }
	fun getDate(): Int { return partsLocal().d }
	fun getDay(): Int { return weekdayLocal() }
	fun getHours(): Int { return clockLocal()[0] }
	fun getMinutes(): Int { return clockLocal()[1] }
	fun getSeconds(): Int { return clockLocal()[2] }
	fun getMilliseconds(): Int { return clockLocal()[3] }
	fun getUTCFullYear(): Int { return partsUtc().y }
	fun getUTCMonth(): Int { return partsUtc().m - 1 }
	fun getUTCDate(): Int { return partsUtc().d }
	fun getUTCDay(): Int {
		return ((daysOf(timeMs) + 4) % 7 + 7) % 7
	}
	fun getUTCHours(): Int { return clockUtc()[0] }
	fun getUTCMinutes(): Int { return clockUtc()[1] }
	fun getUTCSeconds(): Int { return clockUtc()[2] }
	fun getUTCMilliseconds(): Int { return clockUtc()[3] }
	fun setFullYear(year: Int, month: Int? = 1073741824, day: Int? = 1073741824): Float {
		var mo = getMonth()
		var d = getDate()
		if month != null {
			if let m = month { mo = m }
		}
		if day != null {
			if let dd = day { d = dd }
		}
		let c = clockLocal()
		timeMs = dateMakeMs(year, mo + 1, d, c[0], c[1], c[2], c[3], false)
		return timeMs
	}
	fun setMonth(month: Int, day: Int? = 1073741824): Float {
		var d = getDate()
		if day != null {
			if let dd = day { d = dd }
		}
		let c = clockLocal()
		timeMs = dateMakeMs(getFullYear(), month + 1, d, c[0], c[1], c[2], c[3], false)
		return timeMs
	}
	fun setDate(day: Int): Float {
		let c = clockLocal()
		let p = partsLocal()
		timeMs = dateMakeMs(p.y, p.m, day, c[0], c[1], c[2], c[3], false)
		return timeMs
	}
	fun setHours(hours: Int, minutes: Int? = 1073741824, seconds: Int? = 1073741824, milliseconds: Int? = 1073741824): Float {
		return setClock(hours, minutes, seconds, milliseconds, 0)
	}
	fun setMinutes(minutes: Int, seconds: Int? = 1073741824, milliseconds: Int? = 1073741824): Float {
		return setClock(getHours(), minutes, seconds, milliseconds, 1)
	}
	fun setSeconds(seconds: Int, milliseconds: Int? = 1073741824): Float {
		return setClock(getHours(), getMinutes(), seconds, milliseconds, 2)
	}
	fun setMilliseconds(milliseconds: Int): Float {
		return setClock(getHours(), getMinutes(), getSeconds(), milliseconds, 3)
	}
	fun setClock(h: Int, mi: Int?, s: Int?, ms: Int?, keep: Int): Float {
		let c = clockLocal()
		var hh = h
		var mm = c[1]
		var ss = c[2]
		var mss = c[3]
		if keep <= 0 {
			mm = 0
			ss = 0
			mss = 0
		}
		if mi != null {
			if let v = mi { mm = v }
		}
		if keep <= 1 {
			if mi == null { mm = 0 }
			ss = 0
			mss = 0
		}
		if s != null {
			if let v = s { ss = v }
		}
		if keep <= 2 {
			if s == null { ss = 0 }
			mss = 0
		}
		if ms != null {
			if let v = ms { mss = v }
		}
		if keep <= 3 {
			if ms == null { mss = 0 }
		}
		let p = partsLocal()
		timeMs = dateMakeMs(p.y, p.m, p.d, hh, mm, ss, mss, false)
		return timeMs
	}
	fun setTime(time: Float): Float {
		timeMs = time
		return timeMs
	}
	fun toISOString(): String {
		let p = partsUtc()
		let c = clockUtc()
		return p.y.toString() + '-' + datePad2(p.m) + '-' + datePad2(p.d) + 'T' + datePad2(c[0]) + ':' + datePad2(c[1]) + ':' + datePad2(c[2]) + '.' + datePad3(c[3]) + 'Z'
	}
	fun toUTCString(): String {
		let p = partsUtc()
		let c = clockUtc()
		return dateWeekdayName(getUTCDay()) + ', ' + datePad2(p.d) + ' ' + dateMonthName(p.m) + ' ' + p.y.toString() + ' ' + datePad2(c[0]) + ':' + datePad2(c[1]) + ':' + datePad2(c[2]) + ' GMT'
	}
	fun toDateString(): String {
		let p = partsLocal()
		return dateWeekdayName(weekdayLocal()) + ' ' + dateMonthName(p.m) + ' ' + datePad2(p.d) + ' ' + p.y.toString()
	}
	fun toTimeString(): String {
		let c = clockLocal()
		let off = getTimezoneOffset()
		let sign = off <= 0 ? '+' : '-'
		var aoff = off
		if aoff < 0 { aoff = 0 - aoff }
		return datePad2(c[0]) + ':' + datePad2(c[1]) + ':' + datePad2(c[2]) + ' GMT' + sign + datePad2(aoff \ 60) + datePad2(aoff % 60)
	}
	fun toString(): String { return toDateString() + ' ' + toTimeString() }
	fun toJSON(): String { return toISOString() }
	fun toLocaleDateString(locales: Any? = null, options: Any? = null): String { return toDateString() }
	fun toLocaleString(locales: Any? = null, options: Any? = null): String { return toString() }
	fun toLocaleTimeString(locales: Any? = null, options: Any? = null): String { return toTimeString() }
}

fun dateMakeMs(y: Int, m: Int, d: Int, h: Int, mi: Int, s: Int, ms: Int, utc: Bool): Float {
	// Overflow-normalizing: hours 25 or day 32 roll into the next unit.
	var total = (dateDaysFromCivil(y, m, d) as!Float) * 86400000.0 + (h as!Float) * 3600000.0 + (mi as!Float) * 60000.0 + (s as!Float) * 1000.0 + (ms as!Float)
	if not utc { total = total + (winTimezoneBiasMinutes() as!Float) * 60000.0 }
	return total
}
fun dateDigitsOnly(text: String): Bool {
	if text.length == 0 { return false }
	for i in text.length {
		if let c = text.charCodeAt(i) {
			if c < 48 or c > 57 { return false }
		}
	}
	return true
}
// ISO-8601 subset: YYYY-MM-DD['T'|HH:mm[:ss[.sss]][Z|±HH:mm]] (also slashes).
// 'T'-separated without zone reads as UTC (Node), space-separated as local.
fun dateParseIso(s: String): Float {
	var text = s.trim()
	var datePart = text
	var timePart: String? = null
	var tSep = false
	let ti = text.indexOf('T')
	if ti >= 0 {
		datePart = text.substring(0, ti)
		timePart = text.substring(ti + 1)
		tSep = true
	} else {
		let sp = text.indexOf(' ')
		if sp >= 0 {
			datePart = text.substring(0, sp)
			timePart = text.substring(sp + 1)
		}
	}
	let dp = datePart.replaceAll('/', '-').split('-')
	if dp.length != 3 { return nan }
	if not dateDigitsOnly(dp[0]) or not dateDigitsOnly(dp[1]) or not dateDigitsOnly(dp[2]) { return nan }
	let year = parseInt(dp[0], 10)
	let month = parseInt(dp[1], 10)
	let day = parseInt(dp[2], 10)
	if month < 1 or month > 12 or day < 1 or day > 31 { return nan }
	var hh = 0
	var mm = 0
	var ss = 0
	var mss = 0
	var isUtc = tSep
	if timePart != null {
		if let tp0 = timePart {
			var tp = tp0
			if tp.endsWith('Z') or tp.endsWith('z') {
				isUtc = true
				tp = tp.substring(0, tp.length - 1)
			} else {
				// Trailing ±HH:mm / ±HHmm / ±HH zone (applies to the wall time).
				var zi = tp.lastIndexOf('+')
				let zmi = tp.lastIndexOf('-')
				if zmi > zi { zi = zmi }
				if zi > 0 {
					let zone = tp.substring(zi).replaceAll(':', '')
					if (zone.length == 3 or zone.length == 5) and dateDigitsOnly(zone.substring(1)) {
						isUtc = true
						let zh = parseInt(zone.substring(1, 3), 10)
						var zm = 0
						if zone.length == 5 { zm = parseInt(zone.substring(3, 5), 10) }
						var off = zh * 60 + zm
						if zone.substring(0, 1) == '-' { off = 0 - off }
						tp = tp.substring(0, zi)
						tp = tp.substring(0, zi)
						// Re-parse the wall time below, then shift by the zone.
						let wall = dateParseWallTime(tp)
						if wall == null { return nan }
						if let w = wall {
							return dateMakeMs(year, month, day, w.h, w.mi, w.s, w.ms, true) - (off as!Float) * 60000.0
						}
						return nan
					}
				}
			}
			let wall = dateParseWallTime(tp)
			if wall == null { return nan }
			if let w = wall {
				hh = w.h
				mm = w.mi
				ss = w.s
				mss = w.ms
			} else {
				return nan
			}
		}
	}
	return dateMakeMs(year, month, day, hh, mm, ss, mss, isUtc)
}
class DateHMS {
	var h: Int = 0
	var mi: Int = 0
	var s: Int = 0
	var ms: Int = 0
	new (h: Int, mi: Int, s: Int, ms: Int) {
		this.h = h
		this.mi = mi
		this.s = s
		this.ms = ms
	}
}
fun dateParseWallTime(tp: String): DateHMS? {
	let parts = tp.split(':')
	if parts.length < 2 or parts.length > 3 { return null }
	if not dateDigitsOnly(parts[0]) or not dateDigitsOnly(parts[1]) { return null }
	let h = parseInt(parts[0], 10)
	let mi = parseInt(parts[1], 10)
	var sec = 0
	var ms = 0
	if parts.length == 3 {
		var spart = parts[2]
		let dot = spart.indexOf('.')
		if dot >= 0 {
			let frac = spart.substring(dot + 1)
			spart = spart.substring(0, dot)
			if not dateDigitsOnly(spart) { return null }
			sec = parseInt(spart, 10)
			if frac.length > 0 {
				if not dateDigitsOnly(frac) { return null }
				var f = frac
				if f.length > 3 { f = f.substring(0, 3) }
				ms = parseInt(f, 10)
				if f.length == 1 { ms = ms * 100 }
				if f.length == 2 { ms = ms * 10 }
			}
		} else {
			if not dateDigitsOnly(spart) { return null }
			sec = parseInt(spart, 10)
		}
		if h > 23 or mi > 59 or sec > 59 { return null }
		return DateHMS(h, mi, sec, ms)
	}
	if h > 23 or mi > 59 { return null }
	return DateHMS(h, mi, 0, 0)
}

