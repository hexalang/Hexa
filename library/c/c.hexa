// Timers — Hexa-side registry over the monotonic tick clock. The host loop
// pumps due callbacks via timerPump() (one-line hookup in main-hexa.cpp lands
// with the event-loop pass); until then callbacks queue but never fire.
class TimerEntry {
	var id: Int
	var due: Float
	var interval: Float
	var repeat: Bool
	var callback: () => Void
	new (id: Int, due: Float, interval: Float, repeat: Bool, callback: () => Void) {
		this.id = id
		this.due = due
		this.interval = interval
		this.repeat = repeat
		this.callback = callback
	}
}
var activeTimers [TimerEntry] = []
var nextTimerId Int = 1
fun armTimer(callback: () => Void, delayMs: Int, repeat: Bool): Int {
	let id = nextTimerId
	nextTimerId = id + 1
	activeTimers.push(TimerEntry(id, hexaTickMs() + delayMs, delayMs as!Float, repeat, callback))
	return id
}
fun disarmTimer(id: Int): Void {
	for i in activeTimers.length {
		if activeTimers[i].id == id {
			activeTimers.splice(i, 1)
			return
		}
	}
}
// Fire due one-shots, reschedule intervals (host calls this each loop)
@rename('hexaPumpResumes') declare fun hexaPumpResumes(): Void
@rename('hexaSweepCensus') declare fun hexaSweepCensus(): Void
@rename('hexaSweep') declare fun hexaSweep(): Void
var sweepCensusTick Int = 0
fun timerPump(): Void {
	let now = hexaTickMs()
	var i = 0
	while i < activeTimers.length {
		let t = activeTimers[i]
		if now >= t.due {
			if t.repeat {
				t.due = now + t.interval
				i++
			} else {
				activeTimers.splice(i, 1)
			}
			t.callback()
		} else { i++ }
	}
	// Native I/O pumps (defined in process.hexa / fs.hexa / below): poll child
	// pipes, stream slices, HTTP deliveries and websocket frames.
	pumpChildProcs()
	pumpStreams()
	pumpHttpDeliveries()
	pumpWebSockets()
	// F9 resume driver (no-op until `co_await` suspends): resume settled
	// awaiters. Runs on the frame pump (zero host edits); resuming happens
	// synchronously here (frame-granular, like the `.then` 0ms re-arm).
	hexaPumpResumes()
	// F11 sweep (deferred free) + census. First pump always runs (so every
	// run leaves a trace), then every 600th pump. The sweep runs before the
	// census so the log line shows the post-sweep state (`freed=` shows the
	// delta). `HEXA_SWEEP_MODE` env selects the subset (0 = full incl.
	// strings, the default: shared interned literals are pinned by ARC
	// entry/immortal/field retains; 1 = retire strings without freeing,
	// the old bisect mode — see `printSweep` for why).
	sweepCensusTick++
	if sweepCensusTick % 100 == 0 {
		// Reclaim timeline (taskmgr-comparable): proves each sweep actually
		// returns memory instead of leaking. Persists to mem-watch.log AND
		// stdout (the build log truncates, the file does not).
		process.logMemWatch('watch')
	}
	if sweepCensusTick == 1 or sweepCensusTick >= 600 {
		hexaSweep()
		hexaSweepCensus()
		process.logMemWatch('sweep')
		if sweepCensusTick >= 600 {
			sweepCensusTick = 0
		}
	}
}
fun setTimeout(callback: () => Void, timeout: Int): Int { return armTimer(callback, timeout, false) }
fun setInterval(callback: () => Void, timeout: Int): Int { return armTimer(callback, timeout, true) }
fun clearTimeout(id: Int): Void { disarmTimer(id) }
fun clearInterval(id: Int): Void { disarmTimer(id) }
fun requestAnimationFrame(callback: () => Void): Int { return armTimer(callback, 16, false) }
fun cancelAnimationFrame(id: Int): Void { disarmTimer(id) }
fun setImmediate(callback: () => Void,...args: Any): Int { return armTimer(callback, 0, false) }
fun clearImmediate(id: Int): Void { disarmTimer(id) }
fun queueMicrotask(callback: () => Void): Void { armTimer(callback, 0, false) }

// Async, Phase 1 (no suspension until F9 — `async fun` runs its body now,
// `await` reads the settled `.value` inline): the executor runs IMMEDIATELY
// and synchronously (JS constructor semantics), so sync-backed factories
// (`Promise.resolve`, fs.promises reads, font/image loaders) settle before
// the awaiting continuation, which runs right away. Deferred settlement
// (LSP answers, `setTimeout(resolve, …)` gates, stored resolvers like
// init.hexa's rootResolve) lands through the per-frame `timerPump()` (wired
// in perfide/native_bridge.hexa `nativeOnDraw`) + `.then` polling below;
// true suspension waits for F9.
class Promise<T> {
	// 0 = pending, 1 = fulfilled, 2 = rejected
	var state: Int = 0
	// NOTE deliberately `Any?`, not `T`: `Promise<Void>` must not emit a
	// `void value_` field (the method's own `<T>` below covers typed use)
	var value: Any? = null
	var reason: Any? = null

	new (executor: (resolve: (value: Any?) => Void, reject: (reason: Any) => Void) => Void) {
		// Runs now (never deferred): sync producers settle before we return.
		// Resolve/reject take `Any?` (not `T`) on purpose — a `Void`
		// closure param would have no C value to reference (C2065).
		try {
			executor(fun (v) Void { settleResolve(v) }, fun (e) Void { settleReject(e) })
		} catch err Error {
			settleReject(err)
		}
	}

	fun settleResolve(v: Any?): Void {
		if state != 0 { return }
		state = 1
		value = v
	}

	fun settleReject(e: Any?): Void {
		if state != 0 { return }
		state = 2
		reason = e
	}

	// Generic `then<U>` (F7 step 1 offset): `U` lives at METHOD-BASE so `Dot`
	// preserves it; anonymous lambdas stay `Any`-bound (skipped) so native
	// emits erased `Promise<Any>` (M1 green, like `Array.map`); named fns bind
	// precisely. Param is `Any?`, not `T` (`Void` has no C value).
	fun then<U>(onFulfilled: (value: Any?) => Any?, onRejected: (reason: Any) => Any? = null): Promise<U> {
		let next = new Promise<U>(fun (resolve, reject) { })
		if state == 1 {
			if let f = onFulfilled {
				try {
					next.settleResolve(f(value))
				} catch e Error {
					next.settleReject(e)
				}
			} else {
				next.settleResolve(value)
			}
		} else if state == 2 {
			if let r = onRejected {
				try {
					next.settleResolve(r(reason))
				} catch e Error {
					next.settleReject(e)
				}
			} else {
				next.settleReject(reason)
			}
		} else {
			// Still pending (deferred producer): poll through the timer
			// queue with typed captures — no function arrays (closures in
			// arrays stay F10 territory). Same re-arm shape as
			// pumpStreams' queueMicrotask loop.
			fun pollThen() Void {
				if state == 1 {
					if let f = onFulfilled {
						try {
							next.settleResolve(f(value))
						} catch e Error {
							next.settleReject(e)
						}
					} else {
						next.settleResolve(value)
					}
				} else if state == 2 {
					if let r = onRejected {
						try {
							next.settleResolve(r(reason))
						} catch e Error {
							next.settleReject(e)
						}
					} else {
						next.settleReject(reason)
					}
				} else {
					setTimeout(pollThen, 0)
				}
			}
			setTimeout(pollThen, 0)
		}
		return next
	}

	fun except(onRejected: (reason: Any) => Any?): Promise<T> {
		// Direct (not via `then<U>`): `then` erases to `Promise<Any>` for
		// anonymous lambdas, but `except` must preserve `T` (identity
		// pass-through on fulfill). Duplicates the poll shape with `T`.
		let next = new Promise<T>(fun (resolve, reject) { })
		if state == 1 {
			next.settleResolve(value)
		} else if state == 2 {
			if let r = onRejected {
				try {
					next.settleResolve(r(reason))
				} catch e Error {
					next.settleReject(e)
				}
			} else {
				next.settleReject(reason)
			}
		} else {
			fun pollExcept() Void {
				if state == 1 {
					next.settleResolve(value)
				} else if state == 2 {
					if let r = onRejected {
						try {
							next.settleResolve(r(reason))
						} catch e Error {
							next.settleReject(e)
						}
					} else {
						next.settleReject(reason)
					}
				} else {
					setTimeout(pollExcept, 0)
				}
			}
			setTimeout(pollExcept, 0)
		}
		return next
	}

	fun finally(onFinally: () => Void): Promise<T> {
		return this
	}

	// Own generic param (mini-template): `Promise.resolve(x)` derives its
	// type from `x` and is independent of the class's `<T>` — `resolve()` on
	// `Promise<Void>` must not require a `Void` argument
	static fun resolve<T>(value: T): Promise<T> {
		let result = new Promise<T>(fun (resolve) { })
		result.state = 1
		result.value = value
		return result
	}

	static fun all(promises: [Promise<Any>]): Promise<[Any]> {
		let result = new Promise<[Any]>(fun (resolve, reject) { })
		// Poll-based (no suspension until F9): sync-settled batches
		// resolve on the spot; deferred members re-arm a 0ms timer and
		// land on a later pump. Rejects short-circuit like JS.
		fun checkAll() Void {
			var results [Any?] = []
			for i in promises.length {
				let p = promises[i]
				if p.state == 0 {
					setTimeout(checkAll, 0)
					return
				}
				if p.state == 2 {
					result.settleReject(p.reason)
					return
				}
				results.push(p.value)
			}
			result.settleResolve(results)
		}
		checkAll()
		return result
	}
}

// Web-ish APIs used by the shared GUI code (fetch + WebSocket are real;
// Object reflection typeof/eval stay F10 stubs — see target-c.md).
// AbortSignal is a real class: fetch checks `aborted` synchronously, so the
// 30s stall guards in the harness keep working without an async runtime.
class AbortSignal {
	var aborted: Bool = false
	var listeners [Any] = []
	new () { }
	fun addEventListener(kind: String, callback: Any): Void {
		if kind == 'abort' { listeners.push(callback) }
	}
}
class AbortController {
	var signal: AbortSignal = AbortSignal()
	new () { }
	fun abort(): Void {
		if signal.aborted { return }
		signal.aborted = true
		for l in signal.listeners { l() }
	}
}

class FetchReadResult {
	var done: Bool = false
	var value: Any = null
	new (done: Bool, value: Any) {
		this.done = done
		this.value = value
	}
}
class FetchBodyReader {
	var chunks [Buffer] = []
	var idx: Int = 0
	new (body: Buffer) {
		var at = 0
		while at < body.length {
			var n = body.length - at
			if n > 32768 { n = 32768 }
			chunks.push(body.subarray(at, at + n))
			at = at + n
		}
	}
	// Already-resolved promises (F9 settles .then; `await` passes values
	// through, so `await reader.read()` works in every Perfide call site).
	fun read(): Promise<FetchReadResult> {
		if idx >= chunks.length { return Promise.resolve(FetchReadResult(true, null)) }
		let piece = chunks[idx]
		idx++
		return Promise.resolve(FetchReadResult(false, piece))
	}
}
class FetchBody {
	var reader: FetchBodyReader
	new (body: Buffer) { reader = FetchBodyReader(body) }
	fun getReader(): FetchBodyReader { return reader }
}
class FetchResponse {
	var status: Int = 0
	var ok: Bool = false
	var headersText: String = ''
	var bodyBytes: Buffer = Buffer.alloc(0)
	var body: FetchBody
	new (status: Int, headersText: String, bodyBytes: Buffer) {
		this.status = status
		this.ok = status >= 200 and status < 300
		this.headersText = headersText
		this.bodyBytes = bodyBytes
		this.body = FetchBody(bodyBytes)
	}
	fun text(): String { return bodyBytes.toString('utf8', 0, bodyBytes.length) }
	fun json(): Any { return JSON.parse(text()) }
	fun headersGet(name: String): String {
		for line in headersText.split('\r\n') {
			let idx = line.indexOf(':')
			if idx > 0 {
				if line.substring(0, idx).trim().toLowerCase() == name.toLowerCase() {
					return line.substring(idx + 1).trim()
				}
			}
		}
		return ''
	}
}
// Sync-under-the-hood fetch (WinHTTP core in process.hexa). Returns the
// response directly — `await` passes it through, matching every call site.
// Failures come back as status-0 responses carrying the message as text
// (throwing would abort the process pre-F5; callers check response.ok).
fun fetch(url: String, options: Any? = null): Any {
	var method = 'GET'
	var headers: Any? = null
	var bodyBuf: Buffer? = null
	var signal: AbortSignal? = null
	try {
		if options != null {
			let m = (options as Any)['method']
			if m != null { method = m as String }
			let h = (options as Any)['headers']
			if h != null { headers = h }
			let b = (options as Any)['body']
			if b != null {
				if b is String {
					if let s = b as!String { bodyBuf = Buffer.from(s, 'utf8') }
				}
			}
			let s = (options as Any)['signal']
			if s != null and s is AbortSignal {
				if let sig = s as!AbortSignal { signal = sig }
			}
		}
	} catch e Error { }
	if signal != null {
		if let sig = signal {
			if sig.aborted { return FetchResponse(0, '', Buffer.from('The operation was aborted', 'utf8')) }
		}
	}
	let result = httpRequestRaw(method, url, headers, bodyBuf, 30000)
	if signal != null {
		if let sig = signal {
			if sig.aborted { return FetchResponse(0, '', Buffer.from('The operation was aborted', 'utf8')) }
		}
	}
	if result.error != null or result.status == 0 {
		var msg = 'fetch failed: ' + url
		if let e = result.error { msg = e }
		return FetchResponse(0, '', Buffer.from(msg, 'utf8'))
	}
	return FetchResponse(result.status, result.headersText, result.body)
}

class TextDecoder {
	var encoding: String = 'utf-8'
	// Streaming state: trailing bytes of an incomplete sequence are held back
	// until the next decode() (the harness passes { stream: true } per chunk).
	var pending: [Int] = []
	new (encoding: String = 'utf-8') { this.encoding = encoding }
	// Decodes Buffer/bytes as encoding (utf8 default); strings pass through
	fun decode(buffer: Any?, options: Any?): String {
		if buffer == null { return '' }
		let enc = encoding.toLowerCase()
		if buffer is Buffer {
			if let b = buffer as!Buffer { return decodeBytes(b) }
			return ''
		}
		if buffer is String {
			if let s = buffer as!String { return s }
		}
		return ''
	}
	fun decodeBytes(b: Buffer): String {
		var bytes [Int] = []
		for p in pending { bytes.push(p) }
		for i in b.length { bytes.push(b.bytes[i] as!Int) }
		pending = []
		// Hold back a trailing incomplete sequence for the next chunk.
		var cut = bytes.length
		if cut > 4 {
			for tail in 4 {
				let k = bytes.length - 1 - tail
				if k < 0 { break }
				let lead = bytes[k]
				if lead < 128 { break }
				if lead >= 194 and lead < 224 {
					if tail < 1 { cut = k }
					break
				} else if lead >= 224 and lead < 240 {
					if tail < 2 { cut = k }
					break
				} else if lead >= 240 and lead < 245 {
					if tail < 3 { cut = k }
					break
				}
				break
			}
		}
		var head [Int] = []
		for i in cut { head.push(bytes[i]) }
		for i in bytes.length - cut { pending.push(bytes[cut + i]) }
		return utf8DecodeBytes(head)
	}
}

class WebSocket {
	var url: String = ''
	// 0 CONNECTING, 1 OPEN, 2 CLOSING, 3 CLOSED (same numbers as browsers).
	var readyState: Int = 0
	var onopen: Any? = null
	var onmessage: Any? = null
	var onclose: Any? = null
	var onerror: Any? = null
	var socket: TcpSocket? = null
	var stash: Buffer = Buffer.alloc(0)
	var stashOff: Int = 0
	var fragOpcode: Int = -1
	var fragText: String = ''
	var failText: String? = null
	new (url: String) {
		this.url = url
		liveSockets.push(this)
	}
	fun send(text: String): Void {
		if readyState != 1 { return }
		if let s = socket { s.sendText(text) }
	}
	fun close(): Void {
		if readyState == 3 { return }
		if readyState == 1 {
			if let s = socket { s.sendClose() }
		}
		readyState = 2
	}
}
// Blocking TCP connect + framed I/O over Winsock (debug CDP is ws:// only;
// wss:// needs SChannel — clear error, M8).
class TcpSocket {
	var sock: Int64 = 0
	var ioBuf: Buffer = Buffer.alloc(65536)
	var ioLen: Int = 0
	new () { }
	fun isOpen(): Bool { return sock != (0 as!Int64) }
	fun connectTcp(host: String, port: Int): Bool {
		if not wsSocketsReady {
			let blob = Buffer.alloc(400)
			if wsaStartupWin(514 as!UInt16, blob.bytes) != 0 { return false }
			wsSocketsReady = true
		}
		// Numeric IPv4 fast path (no DNS round trip for 127.0.0.1).
		let numeric = parseIPv4(host)
		if numeric != null {
			if let ip = numeric {
				let s = socketWin(afInet, sockStream, ipprotoTcp)
				if s < (0 as!Int64) { return false }
				var sa = Buffer.alloc(16)
				writeU16LE(sa.bytes, 0, 2)
				writeU16LE(sa.bytes, 2, wsFlip16(port))
				writeU32LE(sa.bytes, 4, ip)
				for i in 8 { sa.bytes[8 + i] = 0 }
				if connectWin(s, sa.bytes, 16) != 0 {
					closeSocketWin(s)
					return false
				}
				sock = s
				return true
			}
		}
		var hints = Buffer.alloc(48)
		writeU32LE(hints.bytes, 4, 2u32)
		writeU32LE(hints.bytes, 8, 1u32)
		writeU32LE(hints.bytes, 12, 6u32)
		var outBox ArrayByValue<UInt64, 1> = [0]
		if getAddrInfoWin(host.utf16(), port.toString().utf16(), hints.bytes, outBox as!ArrayPointer<UInt64>) != 0 { return false }
		let first = (outBox as!ArrayPointer<UInt64>)[0]
		if first == 0u64 { return false }
		var ok = false
		var cursor = first
		while cursor != 0u64 {
			let base = cursor as!ArrayPointer<UInt8>
			let fam = readU16LE(base, 0)
			let addrLen = readU32LE(base, 16) as!Int
			let aiAddr = readU64LE(base, 32)
			if fam == 2 and addrLen >= 16 {
				let s = socketWin(afInet, sockStream, ipprotoTcp)
				if s >= (0 as!Int64) {
					if connectWin(s, aiAddr as!ArrayPointer<UInt8>, addrLen as!Int32) == 0 {
						sock = s
						ok = true
						break
					} else {
						closeSocketWin(s)
					}
				}
			}
			cursor = readU64LE(base, 40)
		}
		freeAddrInfoWin(first as!ArrayPointer<UInt8>)
		return ok
	}
	fun sendAll(data: Buffer): Bool {
		var at = 0
		while at < data.length {
			var n = data.length - at
			if n > 65536 { n = 65536 }
		var piece = data.subarray(at, at + n)
		let sent = sendWin(sock, piece.bytes, n as!Int32, 0) as!Int
			if sent <= 0 { return false }
			at = at + sent
		}
		return true
	}
	// >0 bytes in ioBuf, 0 = nothing yet, -1 = orderly close or fatal error.
	fun recvChunk(): Int {
		let n = recvWin(sock, ioBuf.bytes, 65536, 0) as!Int
		if n == 0 { return -1 }
		if n < 0 {
			if wsaGetLastErrorWin() == wsaWouldBlock { return 0 }
			return -1
		}
		ioLen = n
		return n
	}
	fun sendText(text: String): Void {
		let bytes = Buffer.from(text, 'utf8')
		var header [Int] = [129]
		let n = bytes.length
		if n < 126 {
			header.push(128 + n)
		} else if n < 65536 {
			header.push(254)
			header.push(n \ 256)
			header.push(n % 256)
		} else {
			header.push(255)
			header.push(0)
			header.push(0)
			header.push(0)
			header.push(0)
			header.push((n \ 16777216) % 256)
			header.push((n \ 65536) % 256)
			header.push((n \ 256) % 256)
			header.push(n % 256)
		}
		var mask [Int] = [wsNextRand() % 256, wsNextRand() % 256, wsNextRand() % 256, wsNextRand() % 256]
		for m in mask { header.push(m) }
		var frame = Buffer.alloc(header.length + n)
		for i in header.length { frame.bytes[i] = header[i] as!UInt8 }
		for i in n { frame.bytes[header.length + i] = iXor(bytes.bytes[i] as!Int, mask[i % 4]) as!UInt8 }
		sendAll(frame)
	}
	fun sendClose(): Void {
		var frame = Buffer.alloc(6)
		frame.bytes[0] = 136
		frame.bytes[1] = 128
		for i in 4 { frame.bytes[2 + i] = wsNextRand() as!UInt8 }
		sendAll(frame)
	}
	fun sendPong(payload: Buffer): Void {
		var frame = Buffer.alloc(2 + payload.length)
		frame.bytes[0] = 138
		frame.bytes[1] = payload.length as!UInt8
		for i in payload.length { frame.bytes[2 + i] = payload.bytes[i] }
		sendAll(frame)
	}
	fun closeTcp(): Void {
		if sock != (0 as!Int64) {
			closeSocketWin(sock)
			sock = 0 as!Int64
		}
	}
}
var wsSocketsReady Bool = false
var wsRand UInt32 = 0x12345678u32
var liveSockets [WebSocket] = []
fun wsNextRand(): Int {
	wsRand = (hexaTickMs() as!UInt32) + wsRand * 1664525u32 + 1013904223u32
	return (wsRand % 256u32) as!Int
}
fun wsFlip16(v: Int): Int { return ((v % 256) * 256) + (v \ 256) }
fun parseIPv4(text: String): UInt32? {
	var parts [UInt32] = []
	var cur = ''
	for i in text.length {
		if let c = text.charCodeAt(i) {
			if c == 46 {
				if cur.length == 0 { return null }
				parts.push(parseInt(cur, 10) as!UInt32)
				cur = ''
			} else if c >= 48 and c <= 57 {
				cur = cur + String.fromCharCode(c)
			} else {
				return null
			}
		}
	}
	if cur.length == 0 { return null }
	parts.push(parseInt(cur, 10) as!UInt32)
	if parts.length != 4 { return null }
	for p in parts {
		if p > 255u32 { return null }
	}
	return parts[0] * 16777216u32 + parts[1] * 65536u32 + parts[2] * 256u32 + parts[3]
}
// FIPS 180-4, byte-oriented, pure Hexa (frame masking + ws-accept need it).
fun sha1Bytes(data: [Int]): [Int] {
	var h0 = 0x67452301u32
	var h1 = 0xEFCDAB89u32
	var h2 = 0x98BADCFEu32
	var h3 = 0x10325476u32
	var h4 = 0xC3D2E1F0u32
	var msg [Int] = []
	for b in data { msg.push(b) }
	let bitLen = data.length * 8
	msg.push(128)
	while msg.length % 64 != 56 { msg.push(0) }
	for i in 8 { msg.push(0) }
	var hi = 0u32
	var lo = bitLen as!UInt32
	msg[msg.length - 8] = ((hi \ 16777216u32) % 256u32) as!Int
	msg[msg.length - 7] = ((hi \ 65536u32) % 256u32) as!Int
	msg[msg.length - 6] = ((hi \ 256u32) % 256u32) as!Int
	msg[msg.length - 5] = (hi % 256u32) as!Int
	msg[msg.length - 4] = ((lo \ 16777216u32) % 256u32) as!Int
	msg[msg.length - 3] = ((lo \ 65536u32) % 256u32) as!Int
	msg[msg.length - 2] = ((lo \ 256u32) % 256u32) as!Int
	msg[msg.length - 1] = (lo % 256u32) as!Int
	var off = 0
	while off < msg.length {
		var w [UInt32] = []
		for i in 16 {
			w.push((msg[off + i * 4] as!UInt32) * 16777216u32 + (msg[off + i * 4 + 1] as!UInt32) * 65536u32 + (msg[off + i * 4 + 2] as!UInt32) * 256u32 + (msg[off + i * 4 + 3] as!UInt32))
		}
		for i in 64 {
			w.push(wsRotl(uXor32(uXor32(w[i], w[i + 8]), uXor32(w[i + 2], w[i + 13])), 1u32))
		}
		var a = h0
		var b = h1
		var c = h2
		var d = h3
		var e = h4
		for i in 80 {
			var f = 0u32
			var k = 0u32
			if i < 20 {
				f = uOr32(b and c, uAndNot(b, d))
				k = 0x5A827999u32
			} else if i < 40 {
				f = uXor32(uXor32(b, c), d)
				k = 0x6ED9EBA1u32
			} else if i < 60 {
				f = uOr32(uOr32(b and c, b and d), c and d)
				k = 0x8F1BBCDCu32
			} else {
				f = uXor32(uXor32(b, c), d)
				k = 0xCA62C1D6u32
			}
			let tmp = wsRotl(a, 5u32) + f + e + k + w[i]
			e = d
			d = c
			c = wsRotl(b, 30u32)
			b = a
			a = tmp
		}
		h0 = h0 + a
		h1 = h1 + b
		h2 = h2 + c
		h3 = h3 + d
		h4 = h4 + e
		off = off + 64
	}
	var out [Int] = []
	for h in [h0, h1, h2, h3, h4] {
		out.push(((h \ 16777216u32) % 256u32) as!Int)
		out.push(((h \ 65536u32) % 256u32) as!Int)
		out.push(((h \ 256u32) % 256u32) as!Int)
		out.push((h % 256u32) as!Int)
	}
	return out
}
fun wsRotl(v: UInt32, n: UInt32): UInt32 {
	if n == 0u32 { return v }
	// Wrapping add (Hexa fixed-width arithmetic wraps like C++ unsigned).
	return v * wsPow2(n) + v \ wsPow2(32u32 - n)
}
// (x and ~y) without a `~` operator (unverified on ints — see win32.hexa).
fun uAndNot(x: UInt32, y: UInt32): UInt32 { return x and uNot32(y) }
fun wsPow2(n: UInt32): UInt32 {
	var r = 1u32
	var i = 0u32
	while i < n {
		r = r * 2u32
		i = i + 1u32
	}
	return r
}
// Pump all live sockets: finish CONNECTING handshakes, deliver frames.
fun pumpWebSockets(): Void {
	var i = 0
	while i < liveSockets.length {
		let ws = liveSockets[i]
		if ws.readyState == 3 {
			liveSockets.splice(i, 1)
			continue
		}
		if ws.readyState == 0 {
			if wsDoConnect(ws) {
				if let h = ws.onopen { h() }
			} else {
				wsFail(ws)
			continue
			}
		}
		if ws.readyState == 1 {
			if not wsDrainFrames(ws) {
				wsFail(ws)
				continue
			}
		}
		i++
	}
}
fun wsFail(ws: WebSocket): Void {
	if ws.readyState == 3 { return }
	ws.readyState = 3
	if let s = ws.socket { s.closeTcp() }
	ws.socket = null
	if ws.failText != null {
		if let t = ws.failText {
			if ws.onerror != null {
				if let h = ws.onerror { h(Error(t)) }
			}
		}
	}
	if ws.onclose != null {
		if let h = ws.onclose { h() }
	}
}
fun wsDoConnect(ws: WebSocket): Bool {
	let lower = ws.url.toLowerCase()
	if not lower.startsWith('ws://') {
		ws.failText = 'only ws:// URLs are supported natively (no wss/TLS yet): ' + ws.url
		return false
	}
	let rest = ws.url.substring(5)
	var hostPort = rest
	var path = '/'
	let slash = rest.indexOf('/')
	if slash >= 0 {
		hostPort = rest.substring(0, slash)
		path = rest.substring(slash)
	}
	var host = hostPort
	var port = 80
	let colon = hostPort.lastIndexOf(':')
	if colon >= 0 {
		host = hostPort.substring(0, colon)
		port = parseInt(hostPort.substring(colon + 1), 10)
		if port <= 0 or port > 65535 { port = 80 }
	}
	let sock = TcpSocket()
	if not sock.connectTcp(host, port) {
		ws.failText = 'connect failed: ' + host + ':' + port.toString()
		return false
	}
	ws.socket = sock
	// Random 16-byte key (LCG over the tick clock — handshake-grade only).
	var keyBytes [Int] = []
	for i in 16 { keyBytes.push(wsNextRand()) }
	let key = base64Encode(keyBytes)
	var req = 'GET ' + path + ' HTTP/1.1
'
	req = req + 'Host: ' + host + ':' + port.toString() + '
'
	req = req + 'Upgrade: websocket
Connection: Upgrade
'
	req = req + 'Sec-WebSocket-Key: ' + key + '
Sec-WebSocket-Version: 13

'
	let reqBuf = Buffer.from(req, 'utf8')
	if not sock.sendAll(reqBuf) {
		ws.failText = 'handshake send failed'
		return false
	}
	// Blocking header read (handshake is one round trip). Bytes accumulate raw —
	// the frame that follows the headers may be binary (no UTF-8 round trip).
	var rawHead [Int] = []
	var headEnd = -1
	var guardian = 0
	while guardian < 64 {
		let n = sock.recvChunk()
		if n < 0 {
			ws.failText = 'handshake closed by peer'
			return false
		}
		if n > 0 {
			for i in n { rawHead.push(sock.ioBuf.bytes[i] as!Int) }
			if rawHead.length > 65536 {
				ws.failText = 'handshake too large'
				return false
			}
			var k = 0
			if rawHead.length >= 4 { k = rawHead.length - n - 3 }
			if k < 0 { k = 0 }
			while k + 3 < rawHead.length {
				if rawHead[k] == 13 and rawHead[k + 1] == 10 and rawHead[k + 2] == 13 and rawHead[k + 3] == 10 {
					headEnd = k + 4
					break
				}
				k++
			}
			if headEnd >= 0 { break }
		}
		guardian++
	}
	if headEnd < 0 {
		ws.failText = 'handshake incomplete'
		return false
	}
	var headBytes [Int] = []
	for i in headEnd { headBytes.push(rawHead[i]) }
	let head = utf8DecodeBytes(headBytes)
	if head.indexOf(' 101 ') < 0 {
		ws.failText = 'bad handshake response'
		return false
	}
	let accept = 'Sec-WebSocket-Accept: '
	let ai = head.toLowerCase().indexOf(accept.toLowerCase())
	if ai < 0 {
		ws.failText = 'handshake missing accept key'
		return false
	}
	let lineEnd = head.indexOf('
', ai)
	var got = head.substring(ai + accept.length, lineEnd).trim()
	var keyBytes2 [Int] = []
	for i in key.length {
		if let c = key.charCodeAt(i) { keyBytes2.push(c) }
	}
	let guid = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'
	for i in guid.length {
		if let c = guid.charCodeAt(i) { keyBytes2.push(c) }
	}
	let want = base64Encode(sha1Bytes(keyBytes2))
	if got != want {
		ws.failText = 'handshake accept mismatch'
		return false
	}
	// Carried-over frame bytes (if any) seed the stash verbatim.
	var tailBytes [Int] = []
	for i in rawHead.length - headEnd { tailBytes.push(rawHead[headEnd + i]) }
	ws.stash = Buffer.alloc(tailBytes.length)
	for i in tailBytes.length { ws.stash.bytes[i] = tailBytes[i] as!UInt8 }
	ws.stashOff = 0
	// Nonblocking from here on; the pump drains frames.
	var nbBox ArrayByValue<UInt32, 1> = [1]
	ioctlSocketWin(sock.sock, fionbioCtl, nbBox as!ArrayPointer<ULong>)
	ws.readyState = 1
	return true
}
// Returns false on fatal transport error (caller fails the socket).
fun wsDrainFrames(ws: WebSocket): Bool {
	if ws.socket == null { return false }
	if let s = ws.socket {
		while true {
			let n = s.recvChunk()
			if n < 0 { return wsFinishClose(ws) }
			if n == 0 { break }
			// Append fresh bytes past the stash head.
			let tail = ws.stash.subarray(ws.stashOff, ws.stash.length)
			let fresh = s.ioBuf.subarray(0, n)
			ws.stash = Buffer.concat([tail, fresh])
			ws.stashOff = 0
			if not wsParseFrames(ws) { return false }
		}
		if ws.stashOff > 32768 {
			ws.stash = ws.stash.subarray(ws.stashOff, ws.stash.length)
			ws.stashOff = 0
		}
	}
	return true
}
// Orderly close frame from the peer: echo, then finish CLOSED.
fun wsFinishClose(ws: WebSocket): Bool {
	if let s = ws.socket { s.closeTcp() }
	ws.socket = null
	ws.readyState = 3
	if ws.onclose != null {
		if let h = ws.onclose { h() }
	}
	return false
}
fun wsParseFrames(ws: WebSocket): Bool {
	while true {
		let avail = ws.stash.length - ws.stashOff
		if avail < 2 { return true }
		let b0 = ws.stash.bytes[ws.stashOff] as!Int
		let b1 = ws.stash.bytes[ws.stashOff + 1] as!Int
		let fin = b0 >= 128
		let opcode = b0 % 16
		let masked = b1 >= 128
		var len = b1 % 128
		var headLen = 2
		if len == 126 {
			if avail < 4 { return true }
			len = (ws.stash.bytes[ws.stashOff + 2] as!Int) * 256 + (ws.stash.bytes[ws.stashOff + 3] as!Int)
			headLen = 4
		} else if len == 127 {
			if avail < 10 { return true }
			// Lengths past 2^31 are rejected (frames that big never occur here).
			let hi = (ws.stash.bytes[ws.stashOff + 2] as!Int) * 16777216 + (ws.stash.bytes[ws.stashOff + 3] as!Int) * 65536 + (ws.stash.bytes[ws.stashOff + 4] as!Int) * 256 + (ws.stash.bytes[ws.stashOff + 5] as!Int)
			if hi != 0 { return false }
			len = (ws.stash.bytes[ws.stashOff + 6] as!Int) * 16777216 + (ws.stash.bytes[ws.stashOff + 7] as!Int) * 65536 + (ws.stash.bytes[ws.stashOff + 8] as!Int) * 256 + (ws.stash.bytes[ws.stashOff + 9] as!Int)
			headLen = 10
		}
		if masked { headLen = headLen + 4 }
		if avail < headLen + len { return true }
		var payload = ws.stash.subarray(ws.stashOff, ws.stashOff + headLen + len)
		if masked {
			let m0 = ws.stash.bytes[ws.stashOff + headLen - 4] as!Int
			let m1 = ws.stash.bytes[ws.stashOff + headLen - 3] as!Int
			let m2 = ws.stash.bytes[ws.stashOff + headLen - 2] as!Int
			let m3 = ws.stash.bytes[ws.stashOff + headLen - 1] as!Int
			let masks [Int] = [m0, m1, m2, m3]
			for i in len { payload.bytes[i] = iXor(payload.bytes[i] as!Int, masks[i % 4]) as!UInt8 }
		}
		ws.stashOff = ws.stashOff + headLen + len
		if opcode == 8 {
			if ws.readyState == 1 and ws.socket != null {
				if let s = ws.socket { s.sendClose() }
			}
			wsFinishClose(ws)
			return false
		} else if opcode == 9 {
			if let s = ws.socket { s.sendPong(payload) }
		} else if opcode == 10 {
			// Pong — keep-alive only.
		} else if opcode == 0 {
			if ws.fragOpcode == 1 {
				var bytes [Int] = []
				for i in payload.length { bytes.push(payload.bytes[i] as!Int) }
				ws.fragText = ws.fragText + utf8DecodeBytes(bytes)
			}
			if fin {
				ws.fragOpcode = -1
				wsDeliverText(ws, ws.fragText)
				ws.fragText = ''
			}
		} else if opcode == 1 {
			if fin {
				var bytes [Int] = []
				for i in payload.length { bytes.push(payload.bytes[i] as!Int) }
				wsDeliverText(ws, utf8DecodeBytes(bytes))
			} else {
				ws.fragOpcode = 1
				ws.fragText = ''
				var bytes [Int] = []
				for i in payload.length { bytes.push(payload.bytes[i] as!Int) }
				ws.fragText = utf8DecodeBytes(bytes)
			}
		} else if opcode == 2 {
			if ws.onmessage != null {
				if let h = ws.onmessage { h({ data: payload }) }
			}
		}
		if ws.readyState == 3 { return false }
	}
}
fun wsDeliverText(ws: WebSocket, text: String): Void {
	if ws.onmessage != null {
		if let h = ws.onmessage { h({ data: text }) }
	}
}

class Performance {
	new () { }
	// Monotonic boot-relative ms (GetTickCount64 via the win32 shim)
	fun now(): Float { return hexaTickMs() }
}

let performance: Performance = new Performance()

// Object static helpers (stubbed; real enumeration over native objects later)
class Object {
	static fun keys(obj: Any): [String] { return [] }
	static fun values(obj: Any): [Any] { return [] }
	static fun assign(target: Any,...sources: Any): Any { return target }
	static fun freeze(obj: Any): Any { return obj }
	static fun seal(obj: Any): Any { return obj }
	static fun isSame(value1: Any, value2: Any): Bool { return value1 == value2 }
	static fun create(proto: Any?, propertiesObject: Any? = null): Any { return null }
	static fun defineProperty(obj: Any, prop: String, descriptor: Any): Any { return obj }
	static fun defineProperties(obj: Any, props: Any): Any { return obj }
	static fun getOwnPropertyNames(obj: Any): [String] { return [] }
	static fun getPrototypeOf(obj: Any): Any? { return null }
	static fun setPrototypeOf(obj: Any, proto: Any?): Any { return obj }
