class Buffer /*implements ArrayAccess<T>*/ {
	static fun alloc /*<T>*/(size: Int): Buffer {
		let result Buffer = new Buffer()
		result.length = size
		result.bytes = malloc(size + 0u64) as!ArrayPointer<UInt8>
		return result
	} // TODO handle `as!` in gen/typer
	// Real encoded byte count (LSP framing counts bytes, not UTF-16 units)
	static fun bytesLength(string: String, encoding: String? = 'utf8'): Int {
		var enc = 'utf8'
		if let e = encoding { enc = e }
		if enc == 'utf8' or enc == 'utf-8' or enc == 'UTF8' or enc == 'UTF-8' { return utf8EncodeString(string).length }
		if enc == 'base64' or enc == 'BASE64' { return base64Decode(string).length }
		return string.length
	}
	static fun allocUnsafe(size: Int): Buffer { return alloc(size) }
	static fun isBuffer(obj: Any): Bool { return obj is Buffer }
	static fun compare(a: Buffer, b: Buffer): Int {
		var n = a.length
		if b.length < n { n = b.length }
		for i in n {
			if a.bytes[i] != b.bytes[i] {
				if (a.bytes[i] as!Int) < (b.bytes[i] as!Int) { return 0 - 1 }
				return 1
			}
		}
		if a.length < b.length { return 0 - 1 }
		if a.length > b.length { return 1 }
		return 0
	}
	var length: Int
	var bytes: ArrayPointer<UInt8>
	// Byte-pattern or code-point needle (string needles encode as UTF-8)
	fun indexOf(value: Any, byteOffset: Int? = 0, encoding: String? = 'utf8'): Int {
		var start = 0
		if let o = byteOffset { start = o }
		if start < 0 { start = 0 }
		if value is Buffer {
			if let pat = value as!Buffer { return indexOfBuffer(pat, start) }
			return -1
		}
		if value is Int {
			if let b = value as!Int {
				var i = start
				while i < length {
					if (bytes[i] as!Int) == b { return i }
					i++
				}
			}
			return -1
		}
		if value is String {
			if let s = value as!String {
				return indexOfBuffer(Buffer.from(s, encoding), start)
			}
		}
		return -1
	}
	fun indexOfBuffer(pat: Buffer, start: Int): Int {
		var s = start
		if s < 0 { s = 0 }
		if pat.length == 0 { return s }
		var i = s
		while i + pat.length <= length {
			var match = true
			for j in pat.length {
				if bytes[i + j] != pat.bytes[j] { match = false }
			}
			if match { return i }
			i++
		}
		return -1
	}
	fun lastIndexOf(value: Any, byteOffset: Int? = 0, encoding: String? = 'utf8'): Int {
		var start = length - 1
		if let o = byteOffset { start = o }
		if start >= length { start = length - 1 }
		var pat = Buffer.alloc(0)
		var isPat = false
		if value is Buffer {
			if let p = value as!Buffer {
				pat = p
				isPat = true
			}
		} else if value is String {
			if let s = value as!String {
				pat = Buffer.from(s, encoding)
				isPat = true
			}
		}
		if isPat {
			if pat.length == 0 { return start }
			var i = start - pat.length + 1
			if i > length - pat.length { i = length - pat.length }
			while i >= 0 {
				var match = true
				for j in pat.length {
					if bytes[i + j] != pat.bytes[j] { match = false }
				}
				if match { return i }
				i--
			}
			return -1
		}
		if value is Int {
			if let b = value as!Int {
				var i = start
				while i >= 0 {
					if (bytes[i] as!Int) == b { return i }
					i--
				}
			}
		}
		return -1
	}
	fun includes(value: Any, byteOffset: Int? = 0, encoding: String? = 'utf8'): Bool { return indexOf(value, byteOffset, encoding) >= 0 }
	fun equals(other: Buffer): Bool {
		if length != other.length { return false }
		return compare(this, other) == 0
	}
	// Int byte, single-char String, or Buffer pattern fill
	fun fill(value: Any, offset: Int? = 0, end: Int? = 1073741824, encoding: String? = 'utf8'): Buffer {
		var s = 0
		if let o = offset { s = o }
		if s < 0 { s = 0 }
		var e = length
		if let q = end {
			e = q
			if e < 0 { e = 0 }
		}
		if s > length { s = length }
		if e > length { e = length }
		if e <= s { return this }
		var pat = Buffer.alloc(1)
		var patLen = 1
		if value is Int {
			if let b = value as!Int { pat.bytes[0] = (b % 256) as!UInt8 }
		} else if value is String {
			if let st = value as!String {
				pat = Buffer.from(st.length > 0 ? st.substring(0, 1) : st, encoding)
				patLen = pat.length
				if patLen == 0 {
					pat = Buffer.alloc(1)
					pat.bytes[0] = 0
					patLen = 1
				}
			}
		} else if value is Buffer {
			if let bp = value as!Buffer {
				if bp.length > 0 {
					pat = bp
					patLen = bp.length
				} else {
					pat.bytes[0] = 0
				}
			}
		}
		var i = s
		while i < e {
			bytes[i] = pat.bytes[(i - s) % patLen]
			i++
		}
		return this
	}
	// Overlap-safe via a temp copy (Node copy uses memmove semantics)
	fun copy(to: Buffer, offset: Int): Int {
		var dst = offset
		if dst < 0 { dst = 0 }
		var n = length
		if dst + n > to.length { n = to.length - dst }
		if n <= 0 { return 0 }
		let tmp = subarray(0, n)
		for i in n { to.bytes[dst + i] = tmp.bytes[i] }
		return n
	}
	fun subarray(start: Int? = 0, end: Int? = 1073741824): Buffer {
		var s = 0
		if let o = start { s = o }
		if s < 0 {
			s = length + s
			if s < 0 { s = 0 }
		}
		var e = length
		if let q = end {
			e = q
			if e < 0 {
				e = length + e
				if e < 0 { e = 0 }
			}
		}
		if s > length { s = length }
		if e > length { e = length }
		if e < s { e = s }
		let out = Buffer.alloc(e - s)
		for i in (e - s) { out.bytes[i] = bytes[s + i] }
		return out
	}
	private new (/*bufsize: Int*/) { } // {return null} // TODO `new` cannot return value
	fun readUInt16LE(offset: Int): Int { return 0 }
	fun writeUInt16LE(value: Int, offset: Int): Int { return 0 }
	fun readUInt32LE(offset: Int): Int { return 0 }
	fun readUInt8(offset: Int): UInt8 { return 0 }
	fun readInt8(offset: Int): Int8 { return 0 }
	fun slice(offset: Int): Buffer // {} // TODO class is abstract due to fields fun not have a body
	fun toString(encoding: String): String { return 'null' } // : String, start: Int?, end: Int?): String {}
	static fun fromBytes(data: ArrayPointer<UInt8>, length: Int): Buffer { return null as!Buffer }
	static fun from /*<T>*/(string: String, encoding: String?): Buffer { return null as!Buffer }
	static fun concat(buffers: [Buffer]): Buffer { return null as!Buffer }
}

