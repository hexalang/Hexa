			// TODO hint of unused function result, cause I made a bug here not doing `return`
			return fromUTF16zUpTo(bytes, len)
	// ASCII/JS whitespace trim (full Unicode White_Space lands with locale tables)
	fun trim(): String { return trimStart().trimEnd() }
	fun trimLeft(): String { return trimStart() }
	fun trimRight(): String { return trimEnd() }
	fun isTrimUnit(code: Int): Bool {
		return code == 32 or code == 9 or code == 10 or code == 13 or code == 12 or code == 11 or code == 160
	}
	fun trimStart(): String {
		var i = 0

		while i < length {
			let c: Int = bytes[i]

			if not isTrimUnit(c) { break }
			i++
		}

		if i == 0 { return this }

		if i >= length { return '' }
		return fromUTF16Slice(this, i, length - i)
	}
	fun trimEnd(): String {
		var end = length

		while end > 0 {
			let c: Int = bytes[end - 1]

			if not isTrimUnit(c) { break }
			end--
		}

	} // TODO full functionality and tests
		if end == length { return this }

		if end <= 0 { return '' }
		return fromUTF16Slice(this, 0, end)
	}
	fun padStart(targetLength: Int, padString: String = ' '): String {
		var pad = padString

		if pad.length == 0 { pad = ' ' }

		if length >= targetLength { return this }
		let need = targetLength - length
		let buf = bufferAlloc(targetLength)
		var i = 0

		while i < need {
			buf[i] = pad.bytes[i % pad.length]
			i++
		}

		if length > 0 {
			memcpy(
				(((buf as!UInt64) + ((need * 2) as!UInt64)) as!ArrayPointer<UInt8>),
				bytes as!ConstArrayPointer<UInt8>,
				length * 2
			)
		}
		return fromUTF16Own(buf, targetLength)
	}
	fun padEnd(targetLength: Int, padString: String = ' '): String {
		var pad = padString

		if pad.length == 0 { pad = ' ' }

		if length >= targetLength { return this }
		let need = targetLength - length
		let buf = bufferAlloc(targetLength)

		if length > 0 {
			memcpy(buf as!ArrayPointer<UInt8>, bytes as!ConstArrayPointer<UInt8>, length * 2)
		}
		var i = 0

		while i < need {
			buf[length + i] = pad.bytes[i % pad.length]
			i++
		}
		return fromUTF16Own(buf, targetLength)
	}
	fun repeat(count: Int): String {
		// TODO JS throws RangeError on negative; native keeps '' (no throw ABI yet)
		if count <= 0 or length == 0 { return '' }
		var out = ''

		for k in count { out = out + this }
		return out
		if count == 1 { return this }
		let n = length * count
		let buf = bufferAlloc(n)

		for k in count {
			// TODO not really best way to do it, esp. for smaller strings (use stack + ropes)
			memcpy(
				(((buf as!UInt64) + ((k * length * 2) as!UInt64)) as!ArrayPointer<UInt8>),
				bytes as!ConstArrayPointer<UInt8>,
				length * 2
			)
		}
		return fromUTF16Own(buf, n)
	}
	// BMP code point, or astral value assembled from a surrogate pair
	fun codePointAt(pos: Int): Int? {
		if let hi = charCodeAt(pos) {
			if hi >= 55296 and hi <= 56319 {
				if let lo = charCodeAt(pos + 1) {
					if lo >= 56320 and lo <= 57343 { return 65536 + (hi - 55296) * 1024 + (lo - 56320) }
				}
			}
			return hi
		}
		return null
	}
	// Code-unit order (locale-aware tailoring needs ICU tables — later)
	fun localeCompare(compareString: String, locales: Any? = 'en', options: Any? = { }): Int {
		var n = length

		if compareString.length < n { n = compareString.length }

		for i in n {
			let a: Int = bytes[i]
			let b: Int = compareString.bytes[i]

			if a < b { return -1 }

			if a > b { return 1 }
		}

		if length < compareString.length { return -1 }

		if length > compareString.length { return 1 }
		return 0
	}
	fun normalize(form: String? = 'NFC'): String { return '' } // TODO
	fun valueOf(): String { return this } // TODO
	static fun fromCodePoint(...codePoints: Int): String { return '' } // TODO

	fun endsWith(str: String): Bool {
		if this.length < str.length {
			return false
		}

		let begin = this.length - str.length

		for i in str.length {
			if not (this.bytes[begin + i] == str.bytes[i]) { return false }
		}

		return true
	}

	fun startsWith(str: String): Bool {
		if str.length > length { return false }

		for i in str.length {
			if not (bytes[i] == str.bytes[i]) { return false }
		}
		return true
	}
	// JS slice: no swap, negatives count from the end
	fun slice(pos: Int, len: Int? = 1073741824): String {
		var start = pos

		if start < 0 {
			start = length + start

			if start < 0 { start = 0 }
		}

		if start > length { start = length }
		var end = length

		if let e = len {
			end = e

			if end < 0 {
				end = length + end

				if end < 0 { end = 0 }
			}
		}

		if end > length { end = length }

		let n = end - start

		if n <= 0 { return '' }
		return fromUTF16Slice(this, start, n)
	}
	// Legacy substr(pos, len): length-based, negative pos counts from the end
	fun substr(pos: Int, len: Int = 1073741824): String {
		var start = pos

		if start < 0 { start = length + start }

		if start < 0 { start = 0 }

		if start >= length { return '' }
		var count = length - start

		if len <= 0 { return '' }

		if len < count { count = len }
		return fromUTF16Slice(this, start, count)
	}
	// at(): negative counts from the end, out-of-range → null
	fun at(index: Int): String? {
		var i = index

		if i < 0 { i = length + i }

		if i < 0 or i >= length { return null }
		return String.fromCharCode(bytes[i])
	}
	fun replace(what: String, with: String): String {
		// JS: empty needle anchors at the front
		if what.length == 0 { return with + this }
		let idx = indexOf(what)

		if idx < 0 { return this }
		return fromUTF16Slice(this, 0, idx) + with + fromUTF16Slice(this, idx + what.length, length - idx - what.length)
	}
	fun replaceAll(what: String, with: String): String {
		// JS: empty needle wraps every char plus both ends
		if what.length == 0 {
			if length == 0 { return with }
			let n = length + (length + 1) * with.length
			let buf = bufferAlloc(n)
			var o = 0
			var i = 0

			while i < length {
				var k = 0

				while k < with.length {
					buf[o] = with.bytes[k]
					o++
					k++
				}
				buf[o] = bytes[i]
				o++
				i++
			}
			var k = 0

			while k < with.length {
				buf[o] = with.bytes[k]
				o++
				k++
			}
			return fromUTF16Own(buf, n)
		}

		var hits = 0
		var scan = 0
		var idx = indexOf(what, scan)

		while idx >= 0 {
			hits++
			scan = idx + what.length
			idx = indexOf(what, scan)
		}

		if hits == 0 { return this }
		let n = length + (with.length - what.length) * hits
		let buf = bufferAlloc(n)
		var o = 0
		var start = 0
		idx = indexOf(what, start)

		while idx >= 0 {
			let seg = idx - start

			if seg > 0 {
				memcpy(
					(((buf as!UInt64) + ((o * 2) as!UInt64)) as!ArrayPointer<UInt8>),
					(((bytes as!UInt64) + ((start * 2) as!UInt64)) as!ConstArrayPointer<UInt8>),
					seg * 2
				)
				o += seg
			}

			if with.length > 0 {
				memcpy(
					(((buf as!UInt64) + ((o * 2) as!UInt64)) as!ArrayPointer<UInt8>),
					with.bytes as!ConstArrayPointer<UInt8>,
					with.length * 2
				)
				o += with.length
			}

			start = idx + what.length
			idx = indexOf(what, start)
		}

		let tail = length - start

		if tail > 0 {
			memcpy(
				(((buf as!UInt64) + ((o * 2) as!UInt64)) as!ArrayPointer<UInt8>),
				(((bytes as!UInt64) + ((start * 2) as!UInt64)) as!ConstArrayPointer<UInt8>),
				tail * 2
			)
			o += tail
		}
		return fromUTF16Own(buf, n)
	}
	// RegExp first-arg overloads (same JS `String.prototype.replace/all` behavior)
	fun replaceRegExp(what: RegExp, withString: String): String { return '' } // TODO
	fun replaceAllRegExp(what: RegExp, withString: String): String { return '' } // TODO
	fun match(regexp: RegExp): RegExpMatch? { return null } // TODO
	fun search(regexp: RegExp): Int { return -1 } // TODO
	// Real engine as of Batch 9 (library/c/regexp.hexa): replaces the stubs
	// that returned '' / null and silently broke the syntax tokenizer and the
	// Seti icon lookup (`replaceRegExp(/^\x5c+/, '')` + `parseInt(hex, 16)`).
	// `$&` = whole match, `$1`..`$9` = groups, `$$` = literal '$'.
	fun replaceRegExp(what: RegExp, withString: String): String {
		let m = what.exec(this)

		if m == null { return this }
		// `exec` advanced `lastIndex` for /g patterns — a single replace must
		// not leave the regex mid-scan for the next caller.
		what.lastIndex = 0
		return rxReplaceOne(this, m !, withString)
	}
	fun replaceAllRegExp(what: RegExp, withString: String): String {
		var out = ''
		var start = 0
		what.lastIndex = 0
		var m = what.exec(this)

		while m != null {
			let mm = m !
			// Zero-width match at the current cursor would loop forever.
			if mm.index < start or mm.index > this.length {
				what.lastIndex = start + 1

				if what.lastIndex > this.length { break }
				m = what.exec(this)
				continue
			}
			out = out + this.substring(start, mm.index) + rxExpandReplacement(mm, withString)
			start = mm.index + mm.get(0).length

			if mm.get(0).length == 0 {
				if start >= this.length {
					break
				}
				start++
				out = out + this.substring(start - 1, start)
			}
			what.lastIndex = start
			m = what.exec(this)
		}
		what.lastIndex = 0
		return out + this.substring(start, this.length)
	}
	fun match(regexp: RegExp): RegExpMatch? {
		regexp.lastIndex = 0
		let m = regexp.exec(this)
		regexp.lastIndex = 0
		return m
	}
	fun search(regexp: RegExp): Int {
		regexp.lastIndex = 0
		let m = regexp.exec(this)
		regexp.lastIndex = 0

		if m == null { return -1 }
		return (m !).index
	}
	// Split on a RegExp separator (JS `String.prototype.split(RegExp)`)
	fun splitRegExp(separator: RegExp): [String] {
		var out [String] = []
		var start = 0
		separator.lastIndex = 0
		var m = separator.exec(this)

		while m != null {
			let mm = m !
			out.push(this.substring(start, mm.index))
			start = mm.index + mm.get(0).length

			if mm.get(0).length == 0 { start++ }
			separator.lastIndex = start

			if start > this.length { break }
			m = separator.exec(this)
		}
		separator.lastIndex = 0
		out.push(this.substring(start, this.length))
		return out
	}

