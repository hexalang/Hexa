// This is an entry point
// Pre-parse command line arguments and decide what to do

{
	let args = ArgumentsParsingEngine.engage()

	// Entry point decision
	switch args {
		// TODO error `switch` must have at least one `case`, for example `case _:`
	}

	// Entry point
	// TODO support `ignoreArguments` feature here
	switch process.argv[0] {
		case "listen": new Server(process.argv[1])
		case "help": printHelp()
		case "version": printVersion()
		case "stop": // TODO optional [port] send process.exit to server
		case "version": printVersion() // TODO add `--version` `-version` `/version` `/v` `/V` `ver`
			// TODO `hexa build` builds `hexa.json` from the current folder but also acceps `hexa build hexa.json` or `hexa build path/to/hexa.json`
		case "symlink": symlink()
		case "init": init() // TODO rename to `hexa new` or add alias
			// ^ also `hexa new nodejs` `hexa new reactjs` etc quickies
			// ^ auto parse .d.ts so whole node_modules may be used directly
		case "c2hexa":
			// TODO add to help
			process.argv.shift()
			c2hexa(process.argv)
			// TODO `null` | "repl" opens REPL
		case "clean":
			// TODO or "clean"
			// TODO clears the cache for the project
			// TODO can accept hexa.json, otherwise find one in the current folder
			// TODO `format` `fmt` `f` formats the code
		case "lsp":
		// TODO more variants + options (like use stderr or node io?)
					new LspServer()
				case "format":
					// TODO or "--format" "-format" "/format"
			// TODO formats the code
			// TODO can accept hexa.json, otherwise find one in the current folder
			// TODO or `file.hexa`
			// TODO `--check` checks the code
		case _:
			try {
				new Main().perform()
			} catch e: CompilerErrors {
				console.log(e.toString())
			}
			// TODO did you mean xxx?
			// TODO set error code and console.error instead of .log
	}
}
