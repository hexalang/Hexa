// F10.2b intern table: 64k buckets (BSS-resident via ArrayByValue,
// zero-init = all empty, no init loop). Bucket index is the low 16 bits
// of the content hash (see fromUTF16). Replaces the single linked-list
// root (O(n) walk per intern); lookup walks one bucket only, new strings
// link at the walked tail.
var stringBuckets ArrayByValue<String?, 65536> = []
class String {
	// TODO `let length: Int` ?
	// var length: SizeOfPointer = 0 as! SizeOfPointer or `SizeOfPointer(n)` and `SizeOfPointer.zero`
	var length: Int = 0

	/// Approximately 2 gigabytes + `\0`, also fits into 31-bit (signed 32-bit) as a value
	static let defaultLimit: Int = 1073741824

	/// This is also initialized by code gen, thus `??`
	// Kept for genC's HEXA_MAIN prologue (`String_$root_ = String_$new_();`)
	// — harmless single empty string; the intern walk no longer uses it
	// (see stringBuckets + fromUTF16 below).
	@weak private static let root: String = root ?? new String()
	// TODO ^ this should not compile

	/// Used for runtime purposes
	// Weak link (never ARC-retained on store, never released on overwrite):
	// the intern bucket holds entries weakly by design — ownership lives
	// with the entry's real holders, and `destroy` unlinks before freeing.
	// Without this, every tail-appended interned string kept one unreleased
	// share and could never reach rc==0 (only bucket heads were sweepable).
	@keep @weak private var next: String? = null
	@keep private var bytesLength: Int = 0
	@keep private var bytesHash: Int = 0
	// TODO if bytes allocated next to String, it could be as `char bytes[]` in C thus not wasting space for separate field which is good for small strings (also less mallocs)
	@keep private var bytes: ConstArrayPointer<UInt16> = null as!ConstArrayPointer<UInt16>
	// TODO fun getBytesPointer(): Int {return 0}

